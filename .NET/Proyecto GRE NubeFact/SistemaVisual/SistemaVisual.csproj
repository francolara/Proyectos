<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SistemaVisual</AssemblyName>
    <RootNamespace>SistemaVisual</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Update="actualizador.config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="DOCUMENTACION_FUNCIONAL_SISTEMAVISUAL.md" />
    <None Include="GenerarInstalador.ps1" />
    <None Include="Instrucciones_Codex_SistemaVisual.txt" />
    <None Include="README_PUBLICACION.md" />
  </ItemGroup>

</Project>
