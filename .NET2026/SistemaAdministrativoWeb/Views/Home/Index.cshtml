@using Microsoft.Extensions.Options
@using SistemaAdministrativoWeb.Configuration
@inject IOptions<BusinessInformationOptions> BusinessInformationOptionsAccessor

@{
    ViewData["Title"] = "FralseCont";
    var business = BusinessInformationOptionsAccessor.Value;
    var whatsappUrl = string.IsNullOrWhiteSpace(business.WhatsAppNumber)
        ? string.Empty
        : $"https://wa.me/{business.WhatsAppNumber}";
    var sharedPaidBenefits = new[]
    {
        "Compras y ventas sin limite de registros.",
        "Asientos contables manuales y automaticos.",
        "Caja y Bancos.",
        "Cuentas corrientes.",
        "Transferencias entre cuentas.",
        "Aplicacion de notas de credito.",
        "Centros de costo y cuentas destino.",
        "Configuracion contable completa.",
        "Tipo de cambio oficial en linea.",
        "Sincronizacion mensual de tipos de cambio.",
        "Consulta de RUC y DNI en linea.",
        "Cierre y reapertura de periodos.",
        "Diferencia en cambio y ajuste de cuentas.",
        "Asientos de apertura y cierre.",
        "Periodos especiales 00, 13 y 14.",
        "Reportes contables completos.",
        "Libros electronicos PLE e historial de archivos."
    };
}
<!-- Firma: FRANCO LARA - 10/07/2026 | Reorganiza la portada publica para mostrar primero una landing SaaS de FralseCont con tres planes de suscripcion y accesos al registro por plan, ajusta el branding visible a Sistema Contable con Fralse y Cont en dos colores y elimina la tarjeta informativa redundante. -->
<!-- Firma: FRANCO LARA - 14/07/2026 | Resume la vista publica de planes para mostrar a primera vista los diferenciales clave de Gratis, Emprendedor y Contador, unifica beneficios base entre Emprendedor y Contador y deja la validacion CPE solo en Contador con un bloque expandible Ver detalle. -->
<!-- Firma: FRANCO LARA - 25/07/2026 | Cambia el nombre visible del plan Gratis a Prueba en la vista publica, conservando su vigencia de 30 dias. -->
<!-- Firma: FRANCO LARA - 22/08/2026 | Actualiza la portada al calendario contable vigente con periodos especiales 00, 13 y 14. -->
<!-- Firma: FRANCO LARA - 31/08/2026 | Incorpora la franja institucional y presenta dentro de cada lista principal de Emprendedor y Contador sus tres diferencias y 17 funciones comunes, para un total de 20 puntos por plan. -->
<!-- Firma: FRANCO LARA - 02/09/2026 | Actualiza el mensaje principal y las descripciones comerciales de los planes Emprendedor y Contador para enfocarlos en contadores. -->

<section class="nubecont-pricing-section" aria-labelledby="nubecont-pricing-title">
    <div class="nubecont-pricing-container">
        <header class="nubecont-pricing-header">
            <span class="nubecont-brand-kicker">Sistema Contable</span>
            <h1 id="nubecont-pricing-title" class="nubecont-brand-title"><span>Fralse</span><span class="nubecont-brand-accent">Cont</span></h1>
            <p class="nubecont-brand-subtitle">Sistema contable web</p>
            <p class="nubecont-brand-description">Powered by Fralse Tech S.A.C.</p>
        </header>

        <div class="nubecont-plans-grid">
            <article class="nubecont-plan-card nubecont-plan-card--free">
                <header class="nubecont-plan-top">
                    <h2 class="nubecont-plan-name">Prueba</h2>
                </header>

                <div class="nubecont-plan-price-block">
                    <div class="nubecont-plan-price-row">
                        <span class="nubecont-plan-currency">S/</span>
                        <span class="nubecont-plan-price">0</span>
                    </div>
                    <div class="nubecont-plan-period">por 30 dias</div>
                </div>

                <p class="nubecont-plan-description">
                    Prueba FralseCont y conoce las funciones esenciales de nuestra plataforma contable.
                </p>

                <a class="nubecont-plan-button nubecont-plan-button--free"
                   asp-area="Identity"
                   asp-page="/Account/Register"
                   asp-route-plan="GRATIS">
                    Comenzar gratis
                </a>

                <hr class="nubecont-plan-divider" />

                <ul class="nubecont-plan-features">
                    <li class="nubecont-plan-feature"><i class="bi bi-check2-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>1 empresa.</span></li>
                    <li class="nubecont-plan-feature"><i class="bi bi-check2-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>1 usuario.</span></li>
                    <li class="nubecont-plan-feature"><i class="bi bi-check2-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Vigencia de 30 dias.</span></li>
                    <li class="nubecont-plan-feature"><i class="bi bi-check2-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Compras y ventas.</span></li>
                    <li class="nubecont-plan-feature"><i class="bi bi-check2-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Registros limitados.</span></li>
                    <li class="nubecont-plan-feature"><i class="bi bi-check2-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Asientos contables limitados.</span></li>
                    <li class="nubecont-plan-feature"><i class="bi bi-check2-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Reportes contables base.</span></li>
                    <li class="nubecont-plan-feature nubecont-plan-feature--unavailable"><i class="bi bi-dash-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Sin consulta de RUC y DNI en linea.</span></li>
                    <li class="nubecont-plan-feature nubecont-plan-feature--unavailable"><i class="bi bi-dash-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Sin tipo de cambio en linea.</span></li>
                    <li class="nubecont-plan-feature nubecont-plan-feature--unavailable"><i class="bi bi-dash-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Sin validacion CPE.</span></li>
                    <li class="nubecont-plan-feature nubecont-plan-feature--unavailable"><i class="bi bi-dash-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Sin empresas adicionales.</span></li>
                </ul>
            </article>

            <article class="nubecont-plan-card nubecont-plan-card--entrepreneur">
                <header class="nubecont-plan-top">
                    <h2 class="nubecont-plan-name">Emprendedor</h2>
                    <span class="nubecont-plan-badge nubecont-plan-badge--soft">Mas elegido</span>
                </header>

                <div class="nubecont-plan-price-block">
                    <div class="nubecont-plan-price-row">
                        <span class="nubecont-plan-currency">S/</span>
                        <span class="nubecont-plan-price">39.90</span>
                    </div>
                    <div class="nubecont-plan-period">PEN / mes</div>
                </div>

                <p class="nubecont-plan-description">
                    La solución completa para contadores que empiezan a gestionar empresas.
                </p>

                <a class="nubecont-plan-button nubecont-plan-button--entrepreneur"
                   asp-area="Identity"
                   asp-page="/Account/Register"
                   asp-route-plan="EMPRENDEDOR">
                    Elegir Emprendedor
                </a>

                <hr class="nubecont-plan-divider" />

                <ul class="nubecont-plan-features">
                    <li class="nubecont-plan-feature"><i class="bi bi-check2-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Hasta 3 empresas.</span></li>
                    <li class="nubecont-plan-feature"><i class="bi bi-check2-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Hasta 2 usuarios.</span></li>
                    <li class="nubecont-plan-feature nubecont-plan-feature--unavailable"><i class="bi bi-dash-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Validacion de comprobantes CPE no incluida.</span></li>
                    @foreach (var benefit in sharedPaidBenefits)
                    {
                        <li class="nubecont-plan-feature"><i class="bi bi-check2-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>@benefit</span></li>
                    }
                </ul>
            </article>

            <article class="nubecont-plan-card nubecont-plan-card--recommended">
                <header class="nubecont-plan-top">
                    <h2 class="nubecont-plan-name">Contador</h2>
                    <span class="nubecont-plan-badge">Recomendado</span>
                </header>

                <div class="nubecont-plan-price-block">
                    <div class="nubecont-plan-price-row">
                        <span class="nubecont-plan-currency">S/</span>
                        <span class="nubecont-plan-price">89.90</span>
                    </div>
                    <div class="nubecont-plan-period">PEN / mes</div>
                </div>

                <p class="nubecont-plan-description">
                    Diseñado para contadores que administran múltiples empresas.
                </p>

                <a class="nubecont-plan-button nubecont-plan-button--recommended"
                   asp-area="Identity"
                   asp-page="/Account/Register"
                   asp-route-plan="CONTADOR">
                    Elegir Contador
                </a>

                <hr class="nubecont-plan-divider" />

                <ul class="nubecont-plan-features">
                    <li class="nubecont-plan-feature"><i class="bi bi-check2-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Hasta 10 empresas.</span></li>
                    <li class="nubecont-plan-feature"><i class="bi bi-check2-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Hasta 3 usuarios.</span></li>
                    <li class="nubecont-plan-feature"><i class="bi bi-check2-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Validacion de comprobantes CPE.</span></li>
                    @foreach (var benefit in sharedPaidBenefits)
                    {
                        <li class="nubecont-plan-feature"><i class="bi bi-check2-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>@benefit</span></li>
                    }
                </ul>
            </article>
        </div>
    </div>
</section>

<section class="hero-auth-landing">
    <div class="hero-auth-copy">
        <span class="hero-kicker">Sistema administrativo contable</span>
        <h2>Accede a tu empresa y centraliza contabilidad, compras y ventas en una sola plataforma.</h2>
        <p>
            SisAdm toma la base multiempresa del proyecto nuevo y la combina con un acceso web
            orientado a negocio, operacion contable y control comercial.
        </p>
        <div class="hero-auth-actions">
            <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Login">Iniciar sesion</a>
            <a class="btn btn-outline-primary btn-lg" asp-area="Identity" asp-page="/Account/Register">Registrar usuario</a>
        </div>
    </div>
</section>

<section class="nubecont-contact-band" aria-labelledby="nubecont-contact-title">
    <div class="nubecont-contact-identity">
        <span class="nubecont-contact-kicker">Informacion institucional</span>
        <h2 id="nubecont-contact-title">@business.LegalName</h2>
        <p>RUC @business.Ruc</p>
    </div>

    <div class="nubecont-contact-grid">
        <a class="nubecont-contact-item" href="mailto:@business.SupportEmail">
            <span class="nubecont-contact-icon" aria-hidden="true"><i class="bi bi-envelope"></i></span>
            <span>
                <small>Correo</small>
                <strong>@business.SupportEmail</strong>
            </span>
        </a>

        @if (!string.IsNullOrWhiteSpace(whatsappUrl))
        {
            <a class="nubecont-contact-item" href="@whatsappUrl" target="_blank" rel="noopener noreferrer">
                <span class="nubecont-contact-icon" aria-hidden="true"><i class="bi bi-whatsapp"></i></span>
                <span>
                    <small>WhatsApp</small>
                    <strong>@business.WhatsAppDisplay</strong>
                </span>
            </a>
        }

        <div class="nubecont-contact-item">
            <span class="nubecont-contact-icon" aria-hidden="true"><i class="bi bi-clock"></i></span>
            <span>
                <small>Horario de atencion</small>
                <strong>@business.SupportHours</strong>
            </span>
        </div>
    </div>
</section>
