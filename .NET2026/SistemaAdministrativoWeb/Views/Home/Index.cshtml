            <article class="nubecont-plan-card nubecont-plan-card--recommended">
                <header class="nubecont-plan-top">
                    <h2 class="nubecont-plan-name">Contador</h2>
                    <span class="nubecont-plan-badge">Recomendado</span>
                </header>

                <div class="nubecont-plan-price-block">
                    <div class="nubecont-plan-price-row">
                        <span class="nubecont-plan-currency">S/</span>
                        <span class="nubecont-plan-price">89.90</span>
                    </div>
                    <div class="nubecont-plan-period">PEN / mes</div>
                </div>

                <p class="nubecont-plan-description">
                    Disenado para contadores y estudios contables que administran multiples empresas.
                </p>

