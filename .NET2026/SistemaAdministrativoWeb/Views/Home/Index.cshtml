                <hr class="nubecont-plan-divider" />

                <ul class="nubecont-plan-features">
                    <li class="nubecont-plan-feature"><i class="bi bi-check2-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Hasta 3 empresas.</span></li>
                    <li class="nubecont-plan-feature"><i class="bi bi-check2-circle nubecont-plan-feature-icon" aria-hidden="true"></i><span>Hasta 2 usuarios.</span></li>
