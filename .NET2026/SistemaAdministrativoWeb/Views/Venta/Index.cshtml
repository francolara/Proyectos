@model SistemaAdministrativoWeb.ViewModels.Contabilidad.VentaIndexViewModel

@{
    ViewData["Title"] = "Ventas";
    ViewData["AdminShell"] = true;
    var paginaInicio = Math.Max(1, Model.Paginacion.PaginaActual - 2);
    var paginaFin = Math.Min(Model.Paginacion.TotalPaginas, Model.Paginacion.PaginaActual + 2);
    var textInfo = System.Globalization.CultureInfo.CurrentCulture.TextInfo;
}

<section class="dashboard-shell">
    <div class="dashboard-hero">
        <div>
            <span class="dashboard-kicker">Registro contable</span>
            <h1>Ventas</h1>
            <p>Consulta comprobantes de venta por cliente y controla el asiento automatico generado con la configuracion VEN.</p>
        </div>
        <div class="dashboard-status-card">
            <strong>@Model.EmpresaNombre</strong>
            <span>Contexto activo para ventas y asiento automatico.</span>
            <small>Total filtrado: @Model.Paginacion.TotalRegistros</small>
        </div>
    </div>

    <section class="dashboard-metrics">
        <article class="dashboard-metric-card">
            <span>Total ventas</span>
            <strong>@Model.TotalVentas</strong>
            <small>Registros visibles para la consulta actual.</small>
        </article>
        <article class="dashboard-metric-card">
            <span>Total vendido</span>
            <strong>@Model.TotalImportePeriodo.ToString("0.00")</strong>
            <small>Suma de ventas visibles en la pagina.</small>
        </article>
        <article class="dashboard-metric-card">
            <span>Configuraciones VEN</span>
            <strong>@Model.ConfiguracionesVenta.Count</strong>
            <small>Escenarios disponibles para asiento automatico.</small>
        </article>
    </section>

    <section class="workspace-window">
        <div class="workspace-window-head">
            <div>
                <span class="workspace-window-kicker">Consulta</span>
                <h1>Ventas del periodo</h1>
                <p>Consulta ventas registradas y reabre el documento para ajuste o revision.</p>
            </div>
            <div class="workspace-row-actions">
                <a asp-action="Registrar" asp-route-periodo="@Model.PeriodoConsulta" class="btn btn-light btn-sm">Registrar venta</a>
            </div>
        </div>
        <div class="workspace-window-body">
            @if (TempData["VentaOk"] is string ok)
            {
                <div class="alert alert-success">@ok</div>
            }

            <form asp-action="Index" method="get" class="workspace-filter-card">
                <div class="workspace-filter-grid">
                    <div class="workspace-field">
                        <label class="form-label" for="anio">Año</label>
                        <select id="anio" name="anio" class="form-select">
                            @foreach (var anio in Model.AniosDisponibles)
                            {
                                <option value="@anio" selected="@(anio == Model.AnioSeleccionado)">@anio</option>
                            }
                        </select>
                    </div>
                    <div class="workspace-field">
                        <label class="form-label" for="mes">Mes</label>
                        <select id="mes" name="mes" class="form-select">
                            @foreach (var mes in Model.MesesDisponibles)
                            {
                                <option value="@mes.Valor" selected="@(mes.Valor == Model.MesSeleccionado)">@textInfo.ToTitleCase(mes.Nombre)</option>
                            }
                        </select>
                    </div>
                    <div class="workspace-field workspace-field-span-2">
                        <label class="form-label" for="textoBusqueda">Buscar venta</label>
                        <input id="textoBusqueda" name="textoBusqueda" value="@Model.TextoBusqueda" class="form-control" placeholder="Cliente, documento, escenario u observacion" />
                    </div>
                </div>
                <div class="workspace-actions">
                    <button type="submit" class="btn btn-primary">Consultar</button>
                </div>
            </form>

            <div class="table-responsive workspace-table-wrap">
                <table class="table align-middle app-table workspace-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Documento</th>
                            <th>Escenario</th>
                            <th>Moneda</th>
                            <th>Total</th>
                            <th>Asiento</th>
                            <th>Estado</th>
                            <th class="text-end">Accion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Ventas.Count == 0)
                        {
                            <tr>
                                <td colspan="9">
                                    <div class="app-empty-state app-empty-state-inline">
                                        <i class="bi bi-cash-stack"></i>
                                        <div>
                                            <strong>No hay ventas para la consulta actual</strong>
                                            <p>Ajusta el periodo o registra la primera venta usando la configuracion contable.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var venta in Model.Ventas)
                            {
                                <tr class="workspace-clickable-row" data-edit-url="@Url.Action("Editar", new { periodo = Model.PeriodoConsulta, idVenta = venta.IdVenta })">
                                    <td>@venta.FechaContabilizacion.ToString("dd/MM/yyyy")</td>
                                    <td>@venta.NombreCliente</td>
                                    <td>@venta.Documento</td>
                                    <td>@venta.EscenarioOperacion</td>
                                    <td>@venta.CodigoMoneda</td>
                                    <td>@venta.ImporteTotal.ToString("0.00")</td>
                                    <td>@(venta.IdAsiento?.ToString() ?? "-")</td>
                                    <td><span class="workspace-status-badge is-active">@venta.Estado</span></td>
                                    <td class="text-end">
                                        <a asp-action="Editar" asp-route-periodo="@Model.PeriodoConsulta" asp-route-idVenta="@venta.IdVenta" class="workspace-row-link">Editar</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Paginacion.TotalPaginas > 1)
            {
                <nav class="workspace-pagination" aria-label="Paginacion ventas">
                    <a class="btn btn-outline-secondary @(Model.Paginacion.TienePaginaAnterior ? string.Empty : "disabled")"
                       asp-action="Index"
                       asp-route-anio="@Model.AnioSeleccionado"
                       asp-route-mes="@Model.MesSeleccionado"
                       asp-route-textoBusqueda="@Model.TextoBusqueda"
                       asp-route-pagina="@(Model.Paginacion.PaginaActual - 1)">Anterior</a>

                    @for (var pagina = paginaInicio; pagina <= paginaFin; pagina++)
                    {
                        <a class="btn @(pagina == Model.Paginacion.PaginaActual ? "btn-primary" : "btn-outline-secondary")"
                           asp-action="Index"
                           asp-route-anio="@Model.AnioSeleccionado"
                           asp-route-mes="@Model.MesSeleccionado"
                           asp-route-textoBusqueda="@Model.TextoBusqueda"
                           asp-route-pagina="@pagina">@pagina</a>
                    }

                    <a class="btn btn-outline-secondary @(Model.Paginacion.TienePaginaSiguiente ? string.Empty : "disabled")"
                       asp-action="Index"
                       asp-route-anio="@Model.AnioSeleccionado"
                       asp-route-mes="@Model.MesSeleccionado"
                       asp-route-textoBusqueda="@Model.TextoBusqueda"
                       asp-route-pagina="@(Model.Paginacion.PaginaActual + 1)">Siguiente</a>
                </nav>
            }
        </div>
    </section>
</section>
