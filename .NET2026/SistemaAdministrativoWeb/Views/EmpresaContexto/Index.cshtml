@model SistemaAdministrativoWeb.ViewModels.Empresas.SeleccionEmpresaViewModel

@* Firma: FRANCO LARA - 26/08/2026 | Oculta CodigoEmpresa, agrega edicion fiscal y reemplaza el combo por seleccion accesible de toda la fila. *@
@* Firma: FRANCO LARA - 29/08/2026 | Mantiene siempre disponible la seleccion de empresa y muestra alta o edicion solo cuando el permiso especifico lo permite. *@

@{
    ViewData["Title"] = "Seleccion de empresa";
    var puedeCrearEmpresa = ViewData["PuedeCrearEmpresa"] is bool crear && crear;
    var puedeEditarEmpresa = ViewData["PuedeEditarEmpresa"] is bool editar && editar;
}

<section class="workspace-window">
    <div class="workspace-window-head">
        <div>
            <span class="workspace-window-kicker">Contexto de trabajo</span>
            <h1>Seleccion de empresa</h1>
            <p>Define la empresa activa para abrir el panel contable con el contexto correcto de operacion.</p>
        </div>
        <div class="workspace-window-badge">
            <strong>@Model.Empresas.Count</strong>
            <span>empresa(s) vinculada(s)</span>
        </div>
    </div>

    <div class="workspace-window-body">
        <form asp-action="Seleccionar" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            @if (Model.Empresas.Count == 0)
            {
                <div class="app-empty-state">
                    <i class="bi bi-buildings"></i>
                    <div>
                        <strong>No hay empresas vinculadas</strong>
                        <p>Debes registrar la primera empresa antes de continuar con el panel operativo.</p>
                    </div>
                </div>
            }
            else
            {
                <p class="empresa-selection-help">Selecciona una empresa haciendo clic sobre cualquier parte de su fila.</p>

                <div class="table-responsive workspace-table-wrap empresa-selection-table-wrap">
                    <table class="table table-sm align-middle app-table workspace-table empresa-selection-table">
                        <thead>
                            <tr>
                                <th class="text-center"><span class="visually-hidden">Seleccionar</span></th>
                                <th>Razon social</th>
                                <th>Nombre comercial</th>
                                <th>RUC</th>
                                <th>Predeterminada</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var empresa in Model.Empresas)
                            {
                                var seleccionada = empresa.IdEmpresa == Model.IdEmpresaSeleccionada;
                                <tr class="empresa-selection-row @(seleccionada ? "is-selected" : string.Empty)"
                                    data-company-row
                                    tabindex="0">
                                    <td class="text-center empresa-selection-radio-cell">
                                        <input asp-for="IdEmpresaSeleccionada"
                                               type="radio"
                                               value="@empresa.IdEmpresa"
                                               id="empresa-@empresa.IdEmpresa"
                                               class="form-check-input empresa-selection-radio"
                                               aria-label="Seleccionar @empresa.RazonSocial" />
                                    </td>
                                    <td>@empresa.RazonSocial</td>
                                    <td>@empresa.NombreComercial</td>
                                    <td>@empresa.Ruc</td>
                                    <td>@(empresa.EsEmpresaPredeterminada ? "Si" : "No")</td>
                                    <td class="text-end">
                                        @if (puedeEditarEmpresa)
                                        {
                                            <a asp-action="Editar"
                                               asp-route-idEmpresa="@empresa.IdEmpresa"
                                               class="btn btn-sm btn-outline-primary">
                                                Editar
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <span asp-validation-for="IdEmpresaSeleccionada" class="text-danger d-block mt-2"></span>

                <div class="workspace-actions">
                    <button type="submit"
                            class="btn btn-primary"
                            id="continuar-panel"
                            disabled="@(Model.IdEmpresaSeleccionada <= 0 ? "disabled" : null)">
                        Continuar al panel
                    </button>
                    @if (puedeCrearEmpresa)
                    {
                        <a asp-action="RegistrarEmpresaInicial" class="btn btn-outline-secondary">Registrar otra empresa</a>
                    }
                </div>
            }
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const filas = Array.from(document.querySelectorAll("[data-company-row]"));
            const botonContinuar = document.getElementById("continuar-panel");

            const actualizarSeleccion = () => {
                const radioSeleccionado = document.querySelector(".empresa-selection-radio:checked");

                filas.forEach((fila) => {
                    const radio = fila.querySelector(".empresa-selection-radio");
                    fila.classList.toggle("is-selected", radio?.checked === true);
                });

                if (botonContinuar) {
                    botonContinuar.disabled = !radioSeleccionado;
                }
            };

            const seleccionarFila = (fila) => {
                const radio = fila.querySelector(".empresa-selection-radio");
                if (!radio || radio.checked) {
                    return;
                }

                radio.checked = true;
                radio.dispatchEvent(new Event("change", { bubbles: true }));
            };

            filas.forEach((fila) => {
                const radio = fila.querySelector(".empresa-selection-radio");
                radio?.addEventListener("change", actualizarSeleccion);

                fila.addEventListener("click", (event) => {
                    if (event.target.closest("a, button, input, select, textarea, label")) {
                        return;
                    }

                    seleccionarFila(fila);
                });

                fila.addEventListener("keydown", (event) => {
                    if (event.key !== "Enter" && event.key !== " ") {
                        return;
                    }

                    event.preventDefault();
                    seleccionarFila(fila);
                });
            });

            actualizarSeleccion();
        })();
    </script>
}
