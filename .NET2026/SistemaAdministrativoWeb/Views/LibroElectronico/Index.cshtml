@model SistemaAdministrativoWeb.ViewModels.Contabilidad.LibroElectronicoViewModel

@* Firma: FRANCO LARA - 07/07/2026 | Crea el modulo Libros Electronicos con filtros, previsualizacion paginada, validacion, generacion TXT, descarga temporal e historial para PLE 5.1, 5.2 y 6.1. *@
@* Firma: FRANCO LARA - 13/07/2026 | Fija Libros Electronicos a moneda PEN, retira el filtro visual de moneda y mantiene la previsualizacion/exportacion en soles. *@
@* Firma: FRANCO LARA - 03/08/2026 | Muestra documentos y comprobantes de los 21 campos base en la previsualizacion 5.1, 5.2 y 6.1, usando 00 cuando falta el tipo de comprobante. *@
@* Firma: FRANCO LARA - 04/08/2026 | Ordena la jerarquia visual, controla la presentacion mensual, unifica interruptores y simplifica consulta, generacion y descarga de los TXT con rotulos uniformes. *@

@{
    ViewData["Title"] = "Libros Electrónicos";
    ViewData["AdminShell"] = true;
    var libroNombre = SistemaAdministrativoWeb.Infrastructure.Contabilidad.PleLibroElectronicoCatalogo.ObtenerNombre(Model.LibroElectronicoSeleccionado);
}

<section class="dashboard-shell">
        <section class="dashboard-hero">
            <div>
                <span class="dashboard-kicker">PLE</span>
                <h1 class="app-page-title"><i class="bi bi-journal-text" aria-hidden="true"></i><span>Libros Electrónicos</span></h1>
                <p>Consulta, valida y genera los libros electrónicos del periodo seleccionado.</p>
            </div>
            <article class="dashboard-status-card">
                <strong>@Model.EmpresaNombre</strong>
                <span>@libroNombre</span>
            </article>
        </section>

            @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
            {
                <div class="alert alert-danger">@Model.MensajeError</div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.MensajeExito))
            {
                <div class="alert alert-success">@Model.MensajeExito</div>
            }

            <section class="workspace-section">
                <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
                    {
                        Id = "ple-parameters-title",
                        Category = "Periodo y formato",
                        Title = "Parámetros de generación",
                        Description = "Seleccione el periodo y el libro electrónico que desea procesar.",
                        IconClass = "bi bi-funnel"
                    })" />
            <form asp-action="Index" method="get" class="workspace-filter-card border-0">
                <div class="workspace-filter-grid">
                    <div class="workspace-field">
                        <label class="form-label" for="empresaNombre">Empresa</label>
                        <input id="empresaNombre" class="form-control" value="@($"{Model.EmpresaNombre} ({Model.EmpresaRuc})")" readonly />
                    </div>
                    <div class="workspace-field">
                        <label class="form-label" for="anio">Año</label>
                        <select id="anio" name="anio" class="form-select">
                            @foreach (var anio in Model.AniosDisponibles)
                            {
                                <option value="@anio" selected="@(anio == Model.AnioSeleccionado ? "selected" : null)">@anio</option>
                            }
                        </select>
                    </div>
                    <div class="workspace-field">
                        <label class="form-label" for="mes">Mes</label>
                        <select id="mes" name="mes" class="form-select">
                            @foreach (var mes in Model.MesesDisponibles)
                            {
                                <option value="@mes.Valor" selected="@(mes.Valor == Model.MesSeleccionado ? "selected" : null)">@System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(mes.Nombre)</option>
                            }
                        </select>
                    </div>
                    <div class="workspace-field">
                        <label class="form-label" for="libroElectronico">Libro electrónico</label>
                        <select id="libroElectronico" name="libroElectronico" class="form-select">
                            @foreach (var libro in Model.LibrosDisponibles)
                            {
                                <option value="@libro.Valor" selected="@(libro.Valor == Model.LibroElectronicoSeleccionado ? "selected" : null)">@libro.Texto</option>
                            }
                        </select>
                    </div>
                    <input type="hidden" name="paginaPreview" value="1" />
                    <input type="hidden" name="paginaHistorial" value="1" />
                </div>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button type="submit" name="operacion" value="consultar" class="btn btn-primary" @(Model.PuedeConsultar ? null : "disabled")>Consultar</button>
                </div>
            </form>

            <form asp-action="GenerarTxt" method="post" class="workspace-filter-card border-0 border-top rounded-0">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdEmpresa" />
                <input type="hidden" asp-for="AnioSeleccionado" />
                <input type="hidden" asp-for="MesSeleccionado" />
                <input type="hidden" asp-for="LibroElectronicoSeleccionado" />
                <input type="hidden" asp-for="MonedaSeleccionada" />
                <input type="hidden" asp-for="PaginaPreview" />
                <input type="hidden" asp-for="PaginaHistorial" />
                @if (Model.GeneraComplementoDiario)
                {
                    <div class="form-text mb-2">La primera presentación del ejercicio incluye el plan completo. Después, el TXT 5.3/5.4 contiene solo cuentas nuevas o modificadas desde el último periodo marcado como presentado.</div>
                }
                @if (Model.GeneracionBloqueada && !string.IsNullOrWhiteSpace(Model.MensajeBloqueoGeneracion))
                {
                    <div class="alert alert-warning py-2 mb-2" role="status">@Model.MensajeBloqueoGeneracion</div>
                }
                <div class="ple-file-actions">
                    <button type="submit" class="btn btn-primary ple-file-action" @(Model.PuedeGenerar && !Model.GeneracionBloqueada ? null : "disabled")>Generar TXT</button>
                    <a class="btn ple-file-action @(Model.PuedeDescargarTxt ? "btn-success" : "btn-outline-secondary disabled")" asp-action="DescargarTxt" asp-route-token="@Model.TokenDescarga">Descargar TXT @Model.LibroElectronicoSeleccionado</a>
                    @if (Model.GeneraComplementoDiario)
                    {
                        var formatoComplementario = Model.LibroElectronicoSeleccionado == SistemaAdministrativoWeb.Infrastructure.Contabilidad.PleLibroElectronicoCatalogo.LibroDiario51 ? "5.3" : "5.4";
                        <a class="btn ple-file-action @(Model.PuedeDescargarComplementario ? "btn-success" : "btn-outline-secondary disabled")" asp-action="DescargarTxt" asp-route-token="@Model.TokenDescargaComplementario">Descargar TXT @formatoComplementario</a>
                    }
                </div>
            </form>
            </section>

            @if (Model.ConsultaEjecutada)
            {
                <section class="workspace-section mt-4">
                    <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
                        {
                            Id = "ple-presentation-title",
                            Category = "Presentación",
                            Title = "Estado del periodo",
                            Description = "Confirme el periodo después de obtener la constancia de recepción.",
                            IconClass = "bi bi-patch-check"
                        })" />
                    <form asp-action="ActualizarPresentacion" method="post" class="workspace-filter-card border-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdEmpresa" />
                        <input type="hidden" asp-for="AnioSeleccionado" />
                        <input type="hidden" asp-for="MesSeleccionado" />
                        <input type="hidden" asp-for="LibroElectronicoSeleccionado" />
                        <input type="hidden" asp-for="MonedaSeleccionada" />
                        <input type="hidden" asp-for="Presentacion.IdGeneracionPeriodo" />
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div>
                                <strong>@(Model.Presentacion.Presentado ? "Periodo presentado" : "Pendiente de presentación")</strong>
                                <div class="form-text">
                                    @if (Model.Presentacion.Presentado)
                                    {
                                        <span>Registrado el @Model.Presentacion.FechaPresentacion?.ToString("dd/MM/yyyy HH:mm") por @Model.Presentacion.UsuarioPresentacion.</span>
                                    }
                                    else if (!Model.Presentacion.IdGeneracionPeriodo.HasValue)
                                    {
                                        <span>Primero genere los archivos del periodo para habilitar esta marca.</span>
                                    }
                                    else
                                    {
                                        <span>La generación existe, pero todavía no fue confirmada como presentada.</span>
                                    }
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <div class="ple-presentation-switch-wrap">
                                    <input class="ple-disclosure-input" type="checkbox" role="switch" id="presentado" name="presentado" value="true" checked="@(Model.Presentacion.Presentado ? "checked" : null)" @(!Model.Presentacion.IdGeneracionPeriodo.HasValue || !Model.PuedeGenerar || Model.Presentacion.ExistePresentacionPosterior ? "disabled" : null) />
                                    <label class="ple-disclosure-toggle ple-presentation-toggle" for="presentado">
                                        <span class="ple-disclosure-switch" aria-hidden="true"><span></span></span>
                                        <span class="ple-presentation-label">Marcar como presentado</span>
                                    </label>
                                    <input type="hidden" name="presentado" value="false" />
                                </div>
                                <button type="submit" class="btn btn-primary" @(!Model.Presentacion.IdGeneracionPeriodo.HasValue || !Model.PuedeGenerar || Model.Presentacion.ExistePresentacionPosterior ? "disabled" : null)>
                                    <i class="bi bi-save" aria-hidden="true"></i> Guardar estado
                                </button>
                            </div>
                        </div>
                    </form>
                </section>
            }

            @if (Model.ConsultaEjecutada)
            {
                <section class="workspace-section mt-4">
                    <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
                        {
                            Id = "ple-summary-title",
                            Category = "Resumen de generación",
                            Title = Model.Resumen.Libro,
                            Description = $"Archivo propuesto: {Model.Resumen.NombreArchivo}",
                            IconClass = "bi bi-file-earmark-text"
                        })" />

                    <div class="dashboard-metrics">
                        <article class="dashboard-metric-card dashboard-metric-card-text">
                            <span>Periodo</span>
                            <strong>@Model.Resumen.Periodo</strong>
                            <small>@Model.Resumen.Empresa</small>
                        </article>
                        <article class="dashboard-metric-card dashboard-metric-card-text">
                            <span>Asientos</span>
                            <strong>@Model.Resumen.CantidadAsientos</strong>
                            <small>Movimientos: @Model.Resumen.CantidadMovimientos</small>
                        </article>
                        <article class="dashboard-metric-card dashboard-metric-card-text">
                            <span>Totales</span>
                            <strong>@Model.Resumen.TotalDebe.ToString("N2") / @Model.Resumen.TotalHaber.ToString("N2")</strong>
                            <small>Debe / Haber</small>
                        </article>
                        <article class="dashboard-metric-card dashboard-metric-card-text">
                            <span>Validación</span>
                            <strong>@Model.Validacion.CantidadErrores err. / @Model.Validacion.CantidadAdvertencias adv.</strong>
                            <small>@Model.Resumen.Ruc</small>
                        </article>
                    </div>
                </section>

                <section class="workspace-section mt-4">
                    <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
                        {
                            Id = "ple-preview-title",
                            Category = "Previsualización",
                            Title = "Detalle exportable",
                            Description = "La tabla muestra la página solicitada del formato seleccionado.",
                            IconClass = "bi bi-table"
                        })" />

                    <div class="ple-disclosure-toggle-wrap">
                        <input type="checkbox" class="ple-disclosure-input" id="plePreviewToggle" data-ple-disclosure data-target="plePreviewDetail" aria-controls="plePreviewDetail" aria-expanded="false" />
                        <label class="ple-disclosure-toggle" for="plePreviewToggle">
                            <span class="ple-disclosure-copy">
                                <strong>Mostrar detalle exportable</strong>
                                <small>Despliega los movimientos que forman parte del archivo TXT.</small>
                            </span>
                            <span class="ple-disclosure-switch" aria-hidden="true"><span></span></span>
                        </label>
                    </div>

                    <div id="plePreviewDetail" class="ple-disclosure-detail d-none">
                    <div class="table-responsive">
                        <table class="table app-table">
                            <thead>
                                @if (Model.LibroElectronicoSeleccionado == SistemaAdministrativoWeb.Infrastructure.Contabilidad.PleLibroElectronicoCatalogo.LibroDiario52)
                                {
                                    <tr>
                                        <th>Fila</th>
                                        <th>Periodo</th>
                                        <th>CUO</th>
                                        <th>Correlativo</th>
                                        <th>Cuenta</th>
                                        <th>Doc Emisor</th>
                                        <th>Comprobante</th>
                                        <th>Fecha</th>
                                        <th>Glosa</th>
                                        <th>Debe</th>
                                        <th>Haber</th>
                                        <th>Estado</th>
                                    </tr>
                                }
                                else if (Model.LibroElectronicoSeleccionado == SistemaAdministrativoWeb.Infrastructure.Contabilidad.PleLibroElectronicoCatalogo.LibroMayor61)
                                {
                                    <tr>
                                        <th>Fila</th>
                                        <th>Periodo</th>
                                        <th>CUO</th>
                                        <th>Correlativo</th>
                                        <th>Cuenta</th>
                                        <th>Doc Emisor</th>
                                        <th>Comprobante</th>
                                        <th>Fecha</th>
                                        <th>Glosa</th>
                                        <th>Debe</th>
                                        <th>Haber</th>
                                        <th>Estado</th>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <th>Fila</th>
                                        <th>Periodo</th>
                                        <th>CUO</th>
                                        <th>Asiento</th>
                                        <th>Movimiento</th>
                                        <th>Cuenta</th>
                                        <th>Doc Emisor</th>
                                        <th>Comprobante</th>
                                        <th>Fecha</th>
                                        <th>Glosa</th>
                                        <th>Debe</th>
                                        <th>Haber</th>
                                        <th>Estado</th>
                                    </tr>
                                }
                            </thead>
                            <tbody>
                                @if (Model.LibroElectronicoSeleccionado == SistemaAdministrativoWeb.Infrastructure.Contabilidad.PleLibroElectronicoCatalogo.LibroDiario52)
                                {
                                    var fila = ((Model.PreviewPaginacion.PaginaActual - 1) * Model.PreviewPaginacion.TamanoPagina) + 1;
                                    foreach (var item in Model.LibroDiario52Items)
                                    {
                                        <tr>
                                            <td>@fila</td>
                                            <td>@item.PeriodoPle</td>
                                            <td>@item.Cuo</td>
                                            <td>@item.CorrelativoAsiento</td>
                                            <td>@item.CodigoCuentaContable</td>
                                            <td>@item.TipoDocumentoEmisor @item.NumeroDocumentoEmisor</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.TipoComprobante) ? "00" : item.TipoComprobante) @item.SerieComprobante-@item.NumeroComprobante</td>
                                            <td>@item.FechaOperacion.ToString("dd/MM/yyyy")</td>
                                            <td>@item.Glosa</td>
                                            <td class="workspace-money-cell">@item.Debe.ToString("N2")</td>
                                            <td class="workspace-money-cell">@item.Haber.ToString("N2")</td>
                                            <td>@item.EstadoOperacion</td>
                                        </tr>
                                        fila++;
                                    }
                                }
                                else if (Model.LibroElectronicoSeleccionado == SistemaAdministrativoWeb.Infrastructure.Contabilidad.PleLibroElectronicoCatalogo.LibroMayor61)
                                {
                                    var fila = ((Model.PreviewPaginacion.PaginaActual - 1) * Model.PreviewPaginacion.TamanoPagina) + 1;
                                    foreach (var item in Model.LibroMayor61Items)
                                    {
                                        <tr>
                                            <td>@fila</td>
                                            <td>@item.PeriodoPle</td>
                                            <td>@item.Cuo</td>
                                            <td>@item.CorrelativoMovimiento</td>
                                            <td>@item.CodigoCuentaContable</td>
                                            <td>@item.TipoDocumentoEmisor @item.NumeroDocumentoEmisor</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.TipoComprobante) ? "00" : item.TipoComprobante) @item.SerieComprobante-@item.NumeroComprobante</td>
                                            <td>@item.FechaOperacion.ToString("dd/MM/yyyy")</td>
                                            <td>@item.Glosa</td>
                                            <td class="workspace-money-cell">@item.Debe.ToString("N2")</td>
                                            <td class="workspace-money-cell">@item.Haber.ToString("N2")</td>
                                            <td>@item.EstadoOperacion</td>
                                        </tr>
                                        fila++;
                                    }
                                }
                                else
                                {
                                    var fila = ((Model.PreviewPaginacion.PaginaActual - 1) * Model.PreviewPaginacion.TamanoPagina) + 1;
                                    foreach (var item in Model.LibroDiario51Items)
                                    {
                                        <tr>
                                            <td>@fila</td>
                                            <td>@item.PeriodoPle</td>
                                            <td>@item.Cuo</td>
                                            <td>@item.CorrelativoAsiento</td>
                                            <td>@item.CorrelativoMovimiento</td>
                                            <td>@item.CodigoCuentaContable</td>
                                            <td>@item.TipoDocumentoEmisor @item.NumeroDocumentoEmisor</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.TipoComprobante) ? "00" : item.TipoComprobante) @item.SerieComprobante-@item.NumeroComprobante</td>
                                            <td>@item.FechaOperacion.ToString("dd/MM/yyyy")</td>
                                            <td>@item.Glosa</td>
                                            <td class="workspace-money-cell">@item.Debe.ToString("N2")</td>
                                            <td class="workspace-money-cell">@item.Haber.ToString("N2")</td>
                                            <td>@item.EstadoOperacion</td>
                                        </tr>
                                        fila++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.PreviewPaginacion.TotalPaginas > 1)
                    {
                        <nav class="workspace-pagination" aria-label="Paginacion previsualizacion PLE">
                            <a class="btn btn-outline-secondary @(Model.PreviewPaginacion.TienePaginaAnterior ? string.Empty : "disabled")"
                               asp-action="Index"
                               asp-route-idEmpresa="@Model.IdEmpresa"
                               asp-route-anio="@Model.AnioSeleccionado"
                               asp-route-mes="@Model.MesSeleccionado"
                               asp-route-libroElectronico="@Model.LibroElectronicoSeleccionado"
                               asp-route-operacion="@(Model.ValidacionEjecutada ? "validar" : "consultar")"
                               asp-route-paginaPreview="@(Model.PreviewPaginacion.PaginaActual - 1)"
                               asp-route-paginaHistorial="@Model.HistorialPaginacion.PaginaActual"
                               asp-route-tokenDescarga="@Model.TokenDescarga"
                               asp-route-tokenDescargaComplementario="@Model.TokenDescargaComplementario">Anterior</a>
                            <span>Pagina @Model.PreviewPaginacion.PaginaActual de @Model.PreviewPaginacion.TotalPaginas</span>
                            <a class="btn btn-outline-secondary @(Model.PreviewPaginacion.TienePaginaSiguiente ? string.Empty : "disabled")"
                               asp-action="Index"
                               asp-route-idEmpresa="@Model.IdEmpresa"
                               asp-route-anio="@Model.AnioSeleccionado"
                               asp-route-mes="@Model.MesSeleccionado"
                               asp-route-libroElectronico="@Model.LibroElectronicoSeleccionado"
                               asp-route-operacion="@(Model.ValidacionEjecutada ? "validar" : "consultar")"
                               asp-route-paginaPreview="@(Model.PreviewPaginacion.PaginaActual + 1)"
                               asp-route-paginaHistorial="@Model.HistorialPaginacion.PaginaActual"
                               asp-route-tokenDescarga="@Model.TokenDescarga"
                               asp-route-tokenDescargaComplementario="@Model.TokenDescargaComplementario">Siguiente</a>
                        </nav>
                    }
                    </div>
                </section>

                <section class="workspace-section mt-4" id="observaciones">
                        <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
                            {
                                Id = "ple-validation-title",
                                Category = "Validaciones",
                                Title = "Observaciones del PLE",
                                Description = "Los errores bloquean la generación; las advertencias requieren revisión.",
                                IconClass = "bi bi-exclamation-triangle"
                            })" />

                        <div class="ple-disclosure-toggle-wrap">
                            <input type="checkbox" class="ple-disclosure-input" id="pleValidationToggle" data-ple-disclosure data-target="pleValidationDetail" aria-controls="pleValidationDetail" aria-expanded="false" />
                            <label class="ple-disclosure-toggle" for="pleValidationToggle">
                                <span class="ple-disclosure-copy">
                                    <strong>Mostrar observaciones del PLE</strong>
                                    <small>Despliega errores, advertencias e información de la validación.</small>
                                </span>
                                <span class="ple-disclosure-switch" aria-hidden="true"><span></span></span>
                            </label>
                        </div>

                        <div id="pleValidationDetail" class="ple-disclosure-detail d-none">
                        <div class="table-responsive">
                            <table class="table app-table">
                                <thead>
                                    <tr>
                                        <th>Severidad</th>
                                        <th>Código</th>
                                        <th>Título</th>
                                        <th>Detalle</th>
                                        <th>CUO</th>
                                        <th>Asiento</th>
                                        <th>Fecha</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.ValidacionEjecutada)
                                    {
                                        <tr>
                                            <td colspan="7">Ejecute la opción Validar para consultar las observaciones del periodo.</td>
                                        </tr>
                                    }
                                    else if (Model.Validacion.Observaciones.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="7">La validación no generó observaciones.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var item in Model.Validacion.Observaciones)
                                        {
                                            <tr>
                                                <td>@item.Severidad</td>
                                                <td>@item.Codigo</td>
                                                <td>@item.Titulo</td>
                                                <td>@item.Detalle</td>
                                                <td>@item.Cuo</td>
                                                <td>@item.NumeroAsiento</td>
                                                <td>@item.FechaOperacion?.ToString("dd/MM/yyyy")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        </div>
                </section>

                @if (Model.PuedeVerHistorial)
                {
                    <section class="workspace-section mt-4">
                        <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
                            {
                                Id = "ple-history-title",
                                Category = "Historial",
                                Title = "Archivos generados",
                                Description = "Exportaciones y presentación del libro y periodo seleccionado.",
                                IconClass = "bi bi-clock-history"
                            })" />

                        <div class="ple-disclosure-toggle-wrap">
                            <input type="checkbox" class="ple-disclosure-input" id="pleHistoryToggle" data-ple-disclosure data-target="pleHistoryDetail" aria-controls="pleHistoryDetail" aria-expanded="false" />
                            <label class="ple-disclosure-toggle" for="pleHistoryToggle">
                                <span class="ple-disclosure-copy">
                                    <strong>Mostrar archivos generados</strong>
                                    <small>Despliega las exportaciones y su estado de presentación.</small>
                                </span>
                                <span class="ple-disclosure-switch" aria-hidden="true"><span></span></span>
                            </label>
                        </div>

                        <div id="pleHistoryDetail" class="ple-disclosure-detail d-none">
                        <div class="table-responsive">
                            <table class="table app-table">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Archivo</th>
                                        <th>Libro</th>
                                        <th>Registros</th>
                                        <th>Debe</th>
                                        <th>Haber</th>
                                        <th>Estado</th>
                                        <th>Presentación</th>
                                        <th>Usuario</th>
                                        <th>Observaciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.HistorialItems.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="10">No existen exportaciones registradas para el filtro actual.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var item in Model.HistorialItems)
                                        {
                                            <tr>
                                                <td>@item.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>@item.NombreArchivo</td>
                                                <td>@item.CodigoLibro</td>
                                                <td>@item.CantidadRegistros</td>
                                                <td class="workspace-money-cell">@item.TotalDebe.ToString("N2")</td>
                                                <td class="workspace-money-cell">@item.TotalHaber.ToString("N2")</td>
                                                <td>@item.Estado</td>
                                                <td>@(item.PlanPresentado ? $"Presentado {item.FechaPresentacion:dd/MM/yyyy HH:mm}" : "Pendiente")</td>
                                                <td>@item.UsuarioGeneracion</td>
                                                <td>@item.Observaciones</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (Model.HistorialPaginacion.TotalPaginas > 1)
                        {
                            <nav class="workspace-pagination" aria-label="Paginacion historial PLE">
                                <a class="btn btn-outline-secondary @(Model.HistorialPaginacion.TienePaginaAnterior ? string.Empty : "disabled")"
                                   asp-action="Index"
                                   asp-route-idEmpresa="@Model.IdEmpresa"
                                   asp-route-anio="@Model.AnioSeleccionado"
                                   asp-route-mes="@Model.MesSeleccionado"
                                   asp-route-libroElectronico="@Model.LibroElectronicoSeleccionado"
                                   asp-route-operacion="@(Model.ValidacionEjecutada ? "validar" : "consultar")"
                                   asp-route-paginaPreview="@Model.PreviewPaginacion.PaginaActual"
                                   asp-route-paginaHistorial="@(Model.HistorialPaginacion.PaginaActual - 1)"
                                   asp-route-tokenDescarga="@Model.TokenDescarga"
                                   asp-route-tokenDescargaComplementario="@Model.TokenDescargaComplementario">Anterior</a>
                                <span>Pagina @Model.HistorialPaginacion.PaginaActual de @Model.HistorialPaginacion.TotalPaginas</span>
                                <a class="btn btn-outline-secondary @(Model.HistorialPaginacion.TienePaginaSiguiente ? string.Empty : "disabled")"
                                   asp-action="Index"
                                   asp-route-idEmpresa="@Model.IdEmpresa"
                                   asp-route-anio="@Model.AnioSeleccionado"
                                   asp-route-mes="@Model.MesSeleccionado"
                                   asp-route-libroElectronico="@Model.LibroElectronicoSeleccionado"
                                   asp-route-operacion="@(Model.ValidacionEjecutada ? "validar" : "consultar")"
                                   asp-route-paginaPreview="@Model.PreviewPaginacion.PaginaActual"
                                   asp-route-paginaHistorial="@(Model.HistorialPaginacion.PaginaActual + 1)"
                                   asp-route-tokenDescarga="@Model.TokenDescarga"
                                   asp-route-tokenDescargaComplementario="@Model.TokenDescargaComplementario">Siguiente</a>
                            </nav>
                        }
                        </div>
                    </section>
                }
            }
</section>

<style>
    .ple-file-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.65rem;
    }

    .ple-file-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 11.5rem;
        min-height: 2.55rem;
    }

    .ple-disclosure-toggle-wrap {
        padding: 0.85rem 1rem;
    }

    .ple-disclosure-input {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .ple-disclosure-toggle {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.8rem 0.95rem;
        border: 1px solid rgba(93, 117, 158, 0.28);
        border-radius: 0.9rem;
        background: rgba(247, 250, 252, 0.92);
        cursor: pointer;
        transition: border-color 0.2s ease, background 0.2s ease;
    }

    .ple-disclosure-toggle:hover,
    .ple-disclosure-input:focus-visible + .ple-disclosure-toggle {
        border-color: rgba(31, 143, 105, 0.48);
    }

    .ple-disclosure-copy {
        display: flex;
        flex-direction: column;
        gap: 0.18rem;
        min-width: 0;
    }

    .ple-disclosure-copy strong {
        color: #153f35;
        font-size: 0.9rem;
    }

    .ple-disclosure-copy small {
        color: #667b75;
        font-size: 0.76rem;
    }

    .ple-disclosure-switch {
        position: relative;
        flex: 0 0 auto;
        width: 2.9rem;
        height: 1.65rem;
        padding: 0.18rem;
        border-radius: 999px;
        background: #b9c6ca;
        transition: background 0.2s ease;
    }

    .ple-disclosure-switch > span {
        display: block;
        width: 1.29rem;
        height: 1.29rem;
        border-radius: 50%;
        background: #ffffff;
        box-shadow: 0 3px 9px rgba(16, 24, 40, 0.22);
        transition: transform 0.2s ease;
    }

    .ple-disclosure-input:checked + .ple-disclosure-toggle {
        border-color: rgba(31, 143, 105, 0.4);
        background: rgba(232, 248, 241, 0.96);
    }

    .ple-disclosure-input:checked + .ple-disclosure-toggle .ple-disclosure-switch {
        background: linear-gradient(135deg, #177a5b, #43bc91);
    }

    .ple-disclosure-input:checked + .ple-disclosure-toggle .ple-disclosure-switch > span {
        transform: translateX(1.25rem);
    }

    .ple-presentation-switch-wrap {
        display: flex;
        align-items: center;
    }

    .ple-presentation-toggle {
        justify-content: flex-start;
        gap: 0.65rem;
        padding: 0.45rem 0.55rem;
        border-color: transparent;
        background: transparent;
    }

    .ple-presentation-label {
        color: inherit;
        font-weight: 600;
        white-space: nowrap;
    }

    .ple-disclosure-input:checked + .ple-presentation-toggle {
        border-color: transparent;
        background: rgba(31, 143, 105, 0.1);
    }

    .ple-disclosure-input:disabled + .ple-presentation-toggle {
        cursor: not-allowed;
        opacity: 0.55;
    }

    .ple-disclosure-detail {
        animation: ple-detail-reveal 0.18s ease-out;
    }

    html[data-theme="dark"] .ple-disclosure-toggle {
        border-color: rgba(93, 117, 158, 0.3);
        background: rgba(17, 27, 45, 0.96);
    }

    html[data-theme="dark"] .ple-disclosure-copy strong {
        color: #eef4ff;
    }

    html[data-theme="dark"] .ple-disclosure-copy small {
        color: #9cb0d1;
    }

    html[data-theme="dark"] .ple-disclosure-switch {
        background: #405068;
    }

    html[data-theme="dark"] .ple-disclosure-input:checked + .ple-disclosure-toggle {
        border-color: rgba(58, 159, 123, 0.42);
        background: rgba(12, 43, 35, 0.96);
    }

    html[data-theme="dark"] .ple-presentation-toggle {
        border-color: transparent;
        background: transparent;
    }

    html[data-theme="dark"] .ple-disclosure-input:checked + .ple-presentation-toggle {
        border-color: transparent;
        background: rgba(58, 159, 123, 0.12);
    }

    @@keyframes ple-detail-reveal {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@section Scripts {
    <script>
        (() => {
            document.querySelectorAll("[data-ple-disclosure]").forEach((toggle) => {
                const detail = document.getElementById(toggle.dataset.target);
                if (!detail) {
                    return;
                }

                const sync = () => {
                    detail.classList.toggle("d-none", !toggle.checked);
                    toggle.setAttribute("aria-expanded", toggle.checked ? "true" : "false");
                };

                toggle.addEventListener("change", sync);
                sync();
            });
        })();
    </script>
}
