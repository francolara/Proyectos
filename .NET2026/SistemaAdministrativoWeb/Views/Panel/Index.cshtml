@model SistemaAdministrativoWeb.ViewModels.Panel.PanelIndexViewModel
@* Firma: FRANCO LARA - 07/07/2026 | Integra el acceso rapido del panel para el nuevo modulo Libros Electronicos manteniendo la navegacion administrativa existente. *@
@* Firma: FRANCO LARA - 08/07/2026 | Reestructura el dashboard con KPIs reales del periodo, indicadores operativos, tendencias de compras y ventas y graficos CSS para distribucion de registros por modulo, movimientos bancarios y aplicaciones. *@
@* Firma: FRANCO LARA - 21/07/2026 | Agrega la impresion HTML del dashboard en formato ejecutivo A4 horizontal, con KPIs, indicadores, tendencias y distribucion del periodo. *@
@* Firma: FRANCO LARA - 31/07/2026 | Adopta el patron global de titulo y subtitulos administrativos con iconos y degradado verde, conservando la impresion ejecutiva. *@
@* Firma: FRANCO LARA - 05/08/2026 | Agrega el grafico historico bancario y diferencia semanticamente las torres: compras azules, ventas verdes y banca violeta. *@
@{
    ViewData["Title"] = "Panel administrativo";
    ViewData["AdminShell"] = true;

    var totalDistribucion = Model.DistribucionRegistros.Sum(x => x.Valor);
    var maximoCompras = Math.Max(1m, Model.ComprasPorPeriodo.Count == 0 ? 0m : Model.ComprasPorPeriodo.Max(x => Math.Max(x.ImporteTotalPen, x.ImporteTotalUsd)));
    var maximoVentas = Math.Max(1m, Model.VentasPorPeriodo.Count == 0 ? 0m : Model.VentasPorPeriodo.Max(x => Math.Max(x.ImporteTotalPen, x.ImporteTotalUsd)));
    var maximoMovimientosBancarios = Math.Max(1m, Model.MovimientosBancariosPorPeriodo.Count == 0 ? 0m : Model.MovimientosBancariosPorPeriodo.Max(x => Math.Max(x.ImporteTotalPen, x.ImporteTotalUsd)));
    var donutStops = new List<string>();
    decimal acumulado = 0m;

    foreach (var item in Model.DistribucionRegistros.Where(x => x.Porcentaje > 0))
    {
        var inicio = acumulado.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        acumulado += item.Porcentaje;
        var fin = Math.Min(100m, acumulado).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        donutStops.Add($"{item.Color} {inicio}% {fin}%");
    }

    var donutGradient = donutStops.Count == 0
        ? "#dbe6f7 0% 100%"
        : string.Join(", ", donutStops);
}

<section class="dashboard-shell dashboard-print-page">
    <header class="dashboard-print-header">
        <div>
            <span>Reporte ejecutivo</span>
            <strong>@Model.NombreEmpresa</strong>
            <small>Dashboard administrativo</small>
        </div>
        <div>
            <span>Periodo</span>
            <strong>@Model.PeriodoActual</strong>
            <small>@Model.EstadoPeriodo</small>
        </div>
    </header>

    <section class="dashboard-hero">
        <div>
            <span class="dashboard-kicker">Resumen ejecutivo</span>
            <h1 class="app-page-title"><i class="bi bi-speedometer2" aria-hidden="true"></i><span>@Model.NombreEmpresa</span></h1>
            <p>Vista central del periodo @Model.PeriodoActual con foco en compras, ventas, asientos e indicadores de registro para la empresa activa.</p>
            <div class="dashboard-print-actions no-print">
                <button type="button" class="btn btn-light" onclick="window.print()">
                    <i class="bi bi-printer"></i>
                    Imprimir dashboard
                </button>
            </div>
        </div>
        <article class="dashboard-status-card">
            <span>Estado del panel</span>
            <strong>@Model.EstadoPanel</strong>
            <small>@Model.ResumenVigencia</small>
            <small>Periodo: @Model.EstadoPeriodo</small>
        </article>
    </section>

    <section class="dashboard-metrics">
        <article class="dashboard-metric-card dashboard-metric-card-amount">
            <span>Compras del periodo</span>
            <div class="dashboard-metric-amounts">
                <div class="dashboard-metric-amount-line">
                    <label>Registros</label>
                    <strong>@Model.TotalComprasPeriodo</strong>
                </div>
                <div class="dashboard-metric-amount-line">
                    <label>Total PEN</label>
                    <strong>@Model.ImporteComprasPeriodoPen.ToString("0.00")</strong>
                </div>
                <div class="dashboard-metric-amount-line">
                    <label>Total USD</label>
                    <strong>@Model.ImporteComprasPeriodoUsd.ToString("0.00")</strong>
                </div>
            </div>
            <small>Movimientos de compras contabilizados en @Model.PeriodoActual.</small>
        </article>
        <article class="dashboard-metric-card dashboard-metric-card-amount">
            <span>Ventas del periodo</span>
            <div class="dashboard-metric-amounts">
                <div class="dashboard-metric-amount-line">
                    <label>Registros</label>
                    <strong>@Model.TotalVentasPeriodo</strong>
                </div>
                <div class="dashboard-metric-amount-line">
                    <label>Total PEN</label>
                    <strong>@Model.ImporteVentasPeriodoPen.ToString("0.00")</strong>
                </div>
                <div class="dashboard-metric-amount-line">
                    <label>Total USD</label>
                    <strong>@Model.ImporteVentasPeriodoUsd.ToString("0.00")</strong>
                </div>
            </div>
            <small>Documentos de ventas registrados en el mismo corte mensual.</small>
        </article>
        <article class="dashboard-metric-card dashboard-metric-card-amount">
            <span>Asientos del periodo</span>
            <div class="dashboard-metric-amounts">
                <div class="dashboard-metric-amount-line">
                    <label>Registros</label>
                    <strong>@Model.TotalAsientosPeriodo</strong>
                </div>
                <div class="dashboard-metric-amount-line">
                    <label>Importe PEN</label>
                    <strong>@Model.ImporteAsientosPeriodoPen.ToString("0.00")</strong>
                </div>
                <div class="dashboard-metric-amount-line">
                    <label>Importe USD</label>
                    <strong>@Model.ImporteAsientosPeriodoUsd.ToString("0.00")</strong>
                </div>
            </div>
            <small>Asientos emitidos para la empresa en el periodo activo.</small>
        </article>
        <article class="dashboard-metric-card dashboard-metric-card-count">
            <span>Cuentas corrientes activas</span>
            <strong>@Model.TotalCuentasCorrientesActivas</strong>
            <small>Base operativa disponible para caja, bancos y transferencias.</small>
        </article>
    </section>

    <section class="workspace-section" aria-labelledby="dashboard-record-control-title">
        <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
            {
                Id = "dashboard-record-control-title",
                Category = "Indicadores",
                Title = "Control de registros",
                Description = "Lectura rápida de pendientes y validaciones del periodo para detectar cuellos de botella operativos.",
                IconClass = "bi bi-clipboard-data"
            })" />

        <div class="dashboard-indicator-grid">
            @foreach (var indicador in Model.Indicadores)
            {
                <article class="dashboard-indicator-card">
                    <div class="dashboard-indicator-icon">
                        <i class="bi @indicador.Icono"></i>
                    </div>
                    <div class="dashboard-indicator-copy">
                        <span>@indicador.Titulo</span>
                        <strong>@indicador.Valor</strong>
                        <small>@indicador.Descripcion</small>
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="dashboard-analytics-grid">
        <div class="dashboard-analytics-stack">
            <article class="workspace-section dashboard-analytics-card" aria-labelledby="dashboard-purchases-title">
                <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
                    {
                        Id = "dashboard-purchases-title",
                        Category = "Gráfico de torres",
                        Title = "Movimientos de compras por periodo",
                        Description = "Comparativo de importes y cantidad de compras en los últimos seis periodos del sistema.",
                        IconClass = "bi bi-cart-check"
                    })" />

                <div class="dashboard-bar-chart">
                    @foreach (var item in Model.ComprasPorPeriodo)
                    {
                        var altura = maximoCompras <= 0m ? 0m : Math.Round(Math.Max(item.ImporteTotalPen, item.ImporteTotalUsd) * 100m / maximoCompras, 2);
                        <article class="dashboard-bar-item" style="--bar-height:@altura.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                            <span class="dashboard-bar-value">PEN @item.ImporteTotalPen.ToString("0.00") | USD @item.ImporteTotalUsd.ToString("0.00")</span>
                            <div class="dashboard-bar-column"></div>
                            <strong>@item.Periodo</strong>
                            <small>@item.Registros registro(s)</small>
                        </article>
                    }
                </div>
            </article>

            <article class="workspace-section dashboard-analytics-card" aria-labelledby="dashboard-sales-title">
                <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
                    {
                        Id = "dashboard-sales-title",
                        Category = "Gráfico de torres",
                        Title = "Movimientos de ventas por periodo",
                        Description = "Comparativo de importes y cantidad de ventas en los últimos seis periodos del sistema.",
                        IconClass = "bi bi-receipt"
                    })" />

                <div class="dashboard-bar-chart dashboard-sales-chart">
                    @foreach (var item in Model.VentasPorPeriodo)
                    {
                        var altura = maximoVentas <= 0m ? 0m : Math.Round(Math.Max(item.ImporteTotalPen, item.ImporteTotalUsd) * 100m / maximoVentas, 2);
                        <article class="dashboard-bar-item" style="--bar-height:@altura.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                            <span class="dashboard-bar-value">PEN @item.ImporteTotalPen.ToString("0.00") | USD @item.ImporteTotalUsd.ToString("0.00")</span>
                            <div class="dashboard-bar-column"></div>
                            <strong>@item.Periodo</strong>
                            <small>@item.Registros registro(s)</small>
                        </article>
                    }
                </div>
            </article>

            <article class="workspace-section dashboard-analytics-card" aria-labelledby="dashboard-bank-movements-title">
                <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
                    {
                        Id = "dashboard-bank-movements-title",
                        Category = "Gráfico de torres",
                        Title = "Movimientos bancarios por periodo",
                        Description = "Comparativo de importes y cantidad de movimientos bancarios en los últimos seis periodos del sistema.",
                        IconClass = "bi bi-bank"
                    })" />

                <div class="dashboard-bar-chart dashboard-bank-chart">
                    @foreach (var item in Model.MovimientosBancariosPorPeriodo)
                    {
                        var altura = maximoMovimientosBancarios <= 0m ? 0m : Math.Round(Math.Max(item.ImporteTotalPen, item.ImporteTotalUsd) * 100m / maximoMovimientosBancarios, 2);
                        <article class="dashboard-bar-item" style="--bar-height:@altura.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                            <span class="dashboard-bar-value">PEN @item.ImporteTotalPen.ToString("0.00") | USD @item.ImporteTotalUsd.ToString("0.00")</span>
                            <div class="dashboard-bar-column"></div>
                            <strong>@item.Periodo</strong>
                            <small>@item.Registros movimiento(s)</small>
                        </article>
                    }
                </div>
            </article>
        </div>

        <article class="workspace-section dashboard-analytics-card" aria-labelledby="dashboard-distribution-title">
            <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
                {
                    Id = "dashboard-distribution-title",
                    Category = "Gráfico de torta",
                    Title = "Distribución de registros del periodo",
                    Description = "Participación actual de compras, ventas, asientos, movimientos bancarios y aplicaciones dentro del volumen operativo del sistema.",
                    IconClass = "bi bi-pie-chart"
                })" />

            <div class="dashboard-donut-layout">
                <div class="dashboard-donut" style="--dashboard-donut:@donutGradient">
                    <div class="dashboard-donut-center">
                        <span>Total</span>
                        <strong>@totalDistribucion</strong>
                        <small>registros</small>
                    </div>
                </div>

                <div class="dashboard-donut-legend">
                    @foreach (var item in Model.DistribucionRegistros)
                    {
                        <article class="dashboard-donut-legend-item">
                            <span class="dashboard-donut-swatch" style="background:@item.Color"></span>
                            <div>
                                <strong>@item.Titulo</strong>
                                <small>@item.Descripcion</small>
                            </div>
                            <div class="dashboard-donut-metrics">
                                <strong>@item.Valor</strong>
                                <small>@item.Porcentaje.ToString("0.##")%</small>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </article>
    </section>

</section>
