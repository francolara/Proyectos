@model SistemaAdministrativoWeb.ViewModels.Contabilidad.ConfiguracionContabilizacionIndexViewModel

@* =============================================
   Author:        FRANCO LARA
   Create date:   22/06/2026
   Description:   Migra la seleccion de cuentas en configuracion contable a ayuda modal con carga Top 100, filtro remoto, permite consultar el plan completo para elegir cuentas como la 42 aunque no acepten movimiento y unifica los botones de ayuda con iconos de lupa.
   ============================================= *@
@* Firma: FRANCO LARA - 24/06/2026 | Restringe la ayuda popup de cuentas en configuracion contable a cuentas del ultimo nivel y muestra mensaje si se intenta elegir una cuenta intermedia. *@

@{
    ViewData["Title"] = Model.Formulario.IdConfiguracionContabilizacion.HasValue ? "Editar configuracion contable" : "Registrar configuracion contable";
    ViewData["AdminShell"] = true;
}

<section class="dashboard-shell">
    <section class="workspace-window">
        <div class="workspace-window-head">
            <div>
                <span class="workspace-window-kicker">Plantilla contable</span>
                <h1>@ViewData["Title"]</h1>
                <p>Configura modulo, escenario y componentes que participaran en el asiento automatico.</p>
            </div>
            <div class="workspace-window-badge">
                <strong>@Model.Formulario.ModuloOperacion</strong>
                <span>modulo en edicion</span>
            </div>
        </div>
        <div class="workspace-window-body">
            <form asp-action="Guardar" method="post" id="configuracion-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Formulario.IdConfiguracionContabilizacion" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="workspace-form-grid">
                    <div class="workspace-field">
                        <label asp-for="Formulario.ModuloOperacion" class="form-label">Modulo</label>
                        <select asp-for="Formulario.ModuloOperacion" class="form-select">
                            <option value="COM">Compras</option>
                            <option value="VEN">Ventas</option>
                        </select>
                        <span asp-validation-for="Formulario.ModuloOperacion" class="text-danger"></span>
                    </div>
                    <div class="workspace-field">
                        <label asp-for="Formulario.EscenarioOperacion" class="form-label">Escenario</label>
                        <select asp-for="Formulario.EscenarioOperacion" class="form-select">
                            <option value="MERCADERIA">Mercaderia</option>
                            <option value="GASTO">Gasto</option>
                            <option value="SERVICIO">Servicio</option>
                        </select>
                        <span asp-validation-for="Formulario.EscenarioOperacion" class="text-danger"></span>
                    </div>
                    <div class="workspace-field">
                        <label asp-for="Formulario.IdOrigen" class="form-label">Origen contable</label>
                        <select asp-for="Formulario.IdOrigen" class="form-select">
                            <option value="">Seleccione</option>
                            @foreach (var origen in Model.Origenes)
                            {
                                <option value="@origen.IdOrigen">@origen.CodigoOrigen - @origen.NombreOrigen</option>
                            }
                        </select>
                        <span asp-validation-for="Formulario.IdOrigen" class="text-danger"></span>
                    </div>
                    <div class="workspace-field workspace-field-span-2">
                        <label asp-for="Formulario.Descripcion" class="form-label">Descripcion</label>
                        <input asp-for="Formulario.Descripcion" class="form-control" />
                        <span asp-validation-for="Formulario.Descripcion" class="text-danger"></span>
                    </div>
                </div>

                <div class="workspace-check-grid">
                    <label class="workspace-check">
                        <input asp-for="Formulario.GeneraAsientoAutomatico" class="form-check-input" />
                        <span>Genera asiento automatico</span>
                    </label>
                    <label class="workspace-check">
                        <input asp-for="Formulario.UsaTipoCambio" class="form-check-input" />
                        <span>Usa tipo de cambio</span>
                    </label>
                    <label class="workspace-check">
                        <input asp-for="Formulario.Activo" class="form-check-input" />
                        <span>Configuracion activa</span>
                    </label>
                </div>

                <div class="workspace-section">
                    <div class="workspace-section-head">
                        <div>
                            <h2>Componentes del asiento</h2>
                            <p>Configura las cuentas para bruto, IGV, total, redondeo u otros componentes contables.</p>
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="agregar-componente">Agregar componente</button>
                    </div>

                    <div class="table-responsive workspace-table-wrap">
                        <table class="table align-middle app-table workspace-table" id="detalle-table">
                            <thead>
                                <tr>
                                    <th>Orden</th>
                                    <th>Componente</th>
                                    <th>Cuenta</th>
                                    <th>Naturaleza</th>
                                    <th>Activo</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Formulario.Detalles.Count; i++)
                                {
                                    <tr>
                                        <td class="detalle-orden-cell">
                                            <input asp-for="Formulario.Detalles[i].Orden" class="form-control" readonly />
                                            <span asp-validation-for="Formulario.Detalles[i].Orden" class="text-danger"></span>
                                        </td>
                                        <td>
                                            <select asp-for="Formulario.Detalles[i].ComponenteContable" class="form-select">
                                                <option value="BRUTO">Bruto</option>
                                                <option value="IGV">IGV</option>
                                                <option value="TOTAL">Total</option>
                                                <option value="REDONDEO">Redondeo</option>
                                                <option value="ISC">ISC</option>
                                                <option value="OTROS">Otros</option>
                                            </select>
                                            <span asp-validation-for="Formulario.Detalles[i].ComponenteContable" class="text-danger"></span>
                                        </td>
                                        <td>
                                            <input type="hidden" asp-for="Formulario.Detalles[i].IdPlanCuenta" class="js-cuenta-id" />
                                            <div class="workspace-lookup-control workspace-lookup-control-compact">
                                                <input class="form-control js-cuenta-texto" value="@(string.IsNullOrWhiteSpace(Model.Formulario.Detalles[i].CuentaTexto) ? "Seleccione cuenta" : Model.Formulario.Detalles[i].CuentaTexto)" readonly />
                                                <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-open-cuenta-modal" title="Buscar cuenta" aria-label="Buscar cuenta"><i class="bi bi-search"></i></button>
                                            </div>
                                            <span asp-validation-for="Formulario.Detalles[i].IdPlanCuenta" class="text-danger"></span>
                                        </td>
                                        <td>
                                            <select asp-for="Formulario.Detalles[i].NaturalezaMovimiento" class="form-select">
                                                <option value="D">Debe</option>
                                                <option value="H">Haber</option>
                                            </select>
                                            <span asp-validation-for="Formulario.Detalles[i].NaturalezaMovimiento" class="text-danger"></span>
                                        </td>
                                        <td class="text-center">
                                            <input asp-for="Formulario.Detalles[i].Activo" class="form-check-input" />
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-outline-secondary btn-sm js-remove-row">Quitar</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="workspace-actions">
                    <button type="submit" class="btn btn-primary">Guardar configuracion</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </section>
</section>

<template id="detalle-row-template">
    <tr>
        <td class="detalle-orden-cell">
            <input name="Formulario.Detalles[__index__].Orden" class="form-control" readonly value="0" />
        </td>
        <td>
            <select name="Formulario.Detalles[__index__].ComponenteContable" class="form-select">
                <option value="BRUTO">Bruto</option>
                <option value="IGV">IGV</option>
                <option value="TOTAL">Total</option>
                <option value="REDONDEO">Redondeo</option>
                <option value="ISC">ISC</option>
                <option value="OTROS">Otros</option>
            </select>
        </td>
        <td>
            <input type="hidden" name="Formulario.Detalles[__index__].IdPlanCuenta" class="js-cuenta-id" />
            <div class="workspace-lookup-control workspace-lookup-control-compact">
                <input class="form-control js-cuenta-texto" value="Seleccione cuenta" readonly />
                <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-open-cuenta-modal" title="Buscar cuenta" aria-label="Buscar cuenta"><i class="bi bi-search"></i></button>
            </div>
        </td>
        <td>
            <select name="Formulario.Detalles[__index__].NaturalezaMovimiento" class="form-select">
                <option value="D">Debe</option>
                <option value="H">Haber</option>
            </select>
        </td>
        <td class="text-center">
            <input name="Formulario.Detalles[__index__].Activo" class="form-check-input" type="checkbox" value="true" checked />
            <input name="Formulario.Detalles[__index__].Activo" type="hidden" value="false" />
        </td>
        <td class="text-end">
            <button type="button" class="btn btn-outline-secondary btn-sm js-remove-row">Quitar</button>
        </td>
    </tr>
</template>

<div class="modal fade workspace-modal" id="configuracionCuentaModal" tabindex="-1" aria-labelledby="configuracionCuentaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content workspace-modal-content">
            <div class="modal-header workspace-modal-header">
                <div>
                    <span class="workspace-window-kicker">Ayuda contable</span>
                    <h2 class="workspace-modal-title" id="configuracionCuentaModalLabel">Seleccionar cuenta contable</h2>
                    <p class="workspace-modal-subtitle">Se cargan hasta 100 cuentas. Si necesita una cuenta especifica, filtre por codigo o nombre.</p>
                </div>
                <button type="button" class="btn-close workspace-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body workspace-modal-body">
                <div class="workspace-filter-card mt-0">
                    <div class="workspace-filter-grid">
                        <div class="workspace-field workspace-field-span-2">
                            <label class="form-label" for="configuracionCuentaFiltro">Filtro</label>
                            <input id="configuracionCuentaFiltro" class="form-control" placeholder="Codigo o nombre de cuenta" autocomplete="off" />
                        </div>
                        <div class="workspace-field">
                            <label class="form-label" for="configuracionCuentaNivelFiltro">Nivel</label>
                            <select id="configuracionCuentaNivelFiltro" class="form-select">
                                <option value="">Todos</option>
                                @for (var nivel = 1; nivel <= 5; nivel++)
                                {
                                    <option value="@nivel">@nivel</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="table-responsive workspace-table-wrap">
                    <table class="table align-middle app-table workspace-table workspace-lookup-table">
                        <thead>
                            <tr>
                                <th class="workspace-lookup-select-cell">Sel.</th>
                                <th>Codigo</th>
                                <th>Cuenta</th>
                                <th>Nivel</th>
                                <th>Centro costo</th>
                            </tr>
                        </thead>
                        <tbody id="configuracionCuentaResultados">
                            <tr data-cuenta-empty-row="true" class="d-none">
                                <td colspan="5">
                                    <div class="app-empty-state app-empty-state-inline">
                                        <i class="bi bi-search"></i>
                                        <div>
                                            <strong>No hay cuentas con ese filtro</strong>
                                            <p>Ajusta el texto o nivel para ubicar la cuenta contable.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer workspace-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="aceptarCuentaConfiguracion">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const tableBody = document.querySelector("#detalle-table tbody");
            const template = document.getElementById("detalle-row-template");
            const addButton = document.getElementById("agregar-componente");
            const cuentaModalEl = document.getElementById("configuracionCuentaModal");
            const cuentaModal = cuentaModalEl && window.bootstrap ? bootstrap.Modal.getOrCreateInstance(cuentaModalEl) : null;
            const cuentaResultadosBodyEl = document.getElementById("configuracionCuentaResultados");
            const cuentaFiltro = document.getElementById("configuracionCuentaFiltro");
            const cuentaNivelFiltro = document.getElementById("configuracionCuentaNivelFiltro");
            const buscarCuentasUrl = '@Url.Action("BuscarAyuda", "PlanCuenta")';
            let cuentaSeleccion = null;
            let cuentaRowActiva = null;
            let cuentaBusquedaProgramada = null;

            if (!tableBody || !template || !addButton) {
                return;
            }

            const marcarSeleccionCuenta = () => {
                const rows = Array.from(cuentaResultadosBodyEl?.querySelectorAll("[data-cuenta-row='true']") || []);
                rows.forEach((row) => {
                    const seleccionado = cuentaSeleccion && row.dataset.id === String(cuentaSeleccion.idPlanCuenta);
                    row.classList.toggle("is-selected", seleccionado);
                    const radio = row.querySelector("input[type='radio']");
                    if (radio) {
                        radio.checked = Boolean(seleccionado);
                    }
                });
            };

            const renderCuentaResultados = (items) => {
                if (!cuentaResultadosBodyEl) {
                    return;
                }

                const emptyRow = cuentaResultadosBodyEl.querySelector("[data-cuenta-empty-row='true']");
                cuentaResultadosBodyEl.querySelectorAll("[data-cuenta-row='true']").forEach((row) => row.remove());
                emptyRow?.classList.toggle("d-none", items.length > 0);

                items.forEach((item) => {
                    const row = document.createElement("tr");
                    row.className = "workspace-lookup-row";
                    row.dataset.cuentaRow = "true";
                    row.dataset.id = String(item.idPlanCuenta || "");
                    row.dataset.codigo = String(item.codigoCuenta || "");
                    row.dataset.nombre = String(item.nombreCuenta || "");
                    row.innerHTML = `
                        <td class="workspace-lookup-select-cell"><input class="form-check-input" type="radio" name="cuentaConfiguracionSeleccion" value="${String(item.idPlanCuenta || "")}" /></td>
                        <td class="workspace-tree-code">${String(item.codigoCuenta || "")}</td>
                        <td>${String(item.nombreCuenta || "")}</td>
                        <td>${String(item.nivelCuenta || "")}</td>
                        <td>${item.requiereCentroCosto ? "Si" : "No"}</td>`;
                    row.addEventListener("click", () => {
                        cuentaSeleccion = item;
                        marcarSeleccionCuenta();
                    });
                    cuentaResultadosBodyEl.appendChild(row);
                });

                marcarSeleccionCuenta();
            };

            const cargarCuentasAyuda = async () => {
                const params = new URLSearchParams({ tamanoPagina: "100", soloMovimiento: "false" });
                const filtro = String(cuentaFiltro?.value || "").trim();
                const nivel = String(cuentaNivelFiltro?.value || "").trim();
                if (filtro.length >= 2) {
                    params.append("textoBusqueda", filtro);
                }
                if (nivel) {
                    params.append("nivelCuenta", nivel);
                }

                const response = await fetch(`${buscarCuentasUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    throw new Error(payload.mensaje || "No se pudo cargar el plan de cuentas.");
                }

                renderCuentaResultados(payload.items || []);
            };

            const programarBusquedaCuenta = () => {
                if (cuentaBusquedaProgramada) {
                    window.clearTimeout(cuentaBusquedaProgramada);
                }

                cuentaBusquedaProgramada = window.setTimeout(async () => {
                    try {
                        await cargarCuentasAyuda();
                    } catch (error) {
                        console.warn(error);
                        renderCuentaResultados([]);
                    }
                }, 250);
            };

            const bindRowActions = (row) => {
                row.querySelector(".js-remove-row")?.addEventListener("click", () => {
                    if (tableBody.querySelectorAll("tr").length === 1) {
                        return;
                    }

                    row.remove();
                    refreshRows();
                });

                row.querySelector(".js-open-cuenta-modal")?.addEventListener("click", async () => {
                    cuentaRowActiva = row;
                    const cuentaIdActual = row.querySelector(".js-cuenta-id")?.value || "";
                    cuentaSeleccion = cuentaIdActual ? { idPlanCuenta: cuentaIdActual } : null;
                    try {
                        await cargarCuentasAyuda();
                    } catch (error) {
                        console.warn(error);
                        renderCuentaResultados([]);
                    }
                    cuentaModal?.show();
                });
            };

            const refreshRows = () => {
                const rows = Array.from(tableBody.querySelectorAll("tr"));

                rows.forEach((row, index) => {
                    row.querySelectorAll("input, select, textarea, span").forEach((element) => {
                        ["name", "id", "for"].forEach((attribute) => {
                            const currentValue = element.getAttribute(attribute);
                            if (!currentValue) {
                                return;
                            }

                            const updatedValue = currentValue
                                .replaceAll("__index__", index)
                                .replace(/Formulario\.Detalles\[\d+\]/g, `Formulario.Detalles[${index}]`)
                                .replace(/Formulario_Detalles_\d+__/g, `Formulario_Detalles_${index}__`);

                            if (updatedValue !== currentValue) {
                                element.setAttribute(attribute, updatedValue);
                            }
                        });
                    });

                    const orderInput = row.querySelector('input[name$=".Orden"]');
                    if (orderInput) {
                        orderInput.value = (index + 1).toString();
                    }
                });
            };

            addButton.addEventListener("click", () => {
                const index = tableBody.querySelectorAll("tr").length;
                const html = template.innerHTML.replaceAll("__index__", index);
                tableBody.insertAdjacentHTML("beforeend", html);
                const row = tableBody.lastElementChild;
                if (row) {
                    bindRowActions(row);
                }
                refreshRows();
            });

            tableBody.querySelectorAll("tr").forEach(bindRowActions);
            cuentaFiltro?.addEventListener("input", programarBusquedaCuenta);
            cuentaNivelFiltro?.addEventListener("change", programarBusquedaCuenta);
            document.getElementById("aceptarCuentaConfiguracion")?.addEventListener("click", () => {
                if (String(cuentaSeleccion?.nivelCuenta || "") !== "5") {
                    window.alert("Seleccione una cuenta contable de nivel 5.");
                    return;
                }

                if (cuentaSeleccion && cuentaRowActiva) {
                    const cuentaIdInput = cuentaRowActiva.querySelector(".js-cuenta-id");
                    const cuentaTextoInput = cuentaRowActiva.querySelector(".js-cuenta-texto");
                    if (cuentaIdInput) {
                        cuentaIdInput.value = String(cuentaSeleccion.idPlanCuenta || "");
                    }
                    if (cuentaTextoInput) {
                        cuentaTextoInput.value = `${String(cuentaSeleccion.codigoCuenta || "")} - ${String(cuentaSeleccion.nombreCuenta || "")}`;
                    }
                }
                cuentaModal?.hide();
            });
            refreshRows();
        })();
    </script>
}
