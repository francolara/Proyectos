@model SistemaAdministrativoWeb.ViewModels.Contabilidad.ProcesoCerrarPeriodoViewModel

@* Firma: FRANCO LARA - 02/07/2026 | Corrige la seleccion visible de anio y mes en cierre de periodo para que el periodo mostrado respete el contexto devuelto por la opcion. *@

@* Firma: FRANCO LARA - 30/06/2026 | Crea la pantalla de Proceso > Cerrar Periodo para abrir o cerrar periodos contables y bloquear la operativa de compras, ventas, bancos, transferencias y aplicaciones. *@

@{
    ViewData["Title"] = "Cerrar Periodo";
    ViewData["AdminShell"] = true;
    var textInfo = System.Globalization.CultureInfo.CurrentCulture.TextInfo;
}

<section class="dashboard-shell">
    <section class="workspace-window">
        <div class="workspace-window-head">
            <div>
                <span class="workspace-window-kicker">Proceso</span>
                <h1>Cerrar Periodo</h1>
                <p>Controla si el periodo operativo queda abierto o cerrado para compras, ventas, bancos, transferencias y aplicaciones.</p>
            </div>
            <div class="workspace-window-badge">
                <strong>@(Model.Cerrado ? "Periodo cerrado" : "Periodo abierto")</strong>
                <span>Estado actual</span>
                <small>@Model.PeriodoConsulta</small>
            </div>
        </div>

        <div class="workspace-window-body">
            @if (TempData["ProcesoOk"] is string ok)
            {
                <div class="alert alert-success">@ok</div>
            }
            @if (TempData["ProcesoError"] is string error)
            {
                <div class="alert alert-danger">@error</div>
            }

            <form asp-action="CerrarPeriodo" method="get" class="workspace-filter-card">
                <div class="workspace-filter-grid">
                    <div class="workspace-field">
                        <label class="form-label" for="anio">Año</label>
                        <select id="anio" name="anio" class="form-select">
                            @foreach (var anio in Model.AniosDisponibles)
                            {
                                <option value="@anio" selected="@(anio == Model.AnioSeleccionado ? "selected" : null)">@anio</option>
                            }
                        </select>
                    </div>
                    <div class="workspace-field">
                        <label class="form-label" for="mes">Mes</label>
                        <select id="mes" name="mes" class="form-select">
                            @foreach (var mes in Model.MesesDisponibles)
                            {
                                <option value="@mes.Valor" selected="@(mes.Valor == Model.MesSeleccionado ? "selected" : null)">@textInfo.ToTitleCase(mes.Nombre)</option>
                            }
                        </select>
                    </div>
                    <div class="workspace-field d-flex align-items-end">
                        <button type="submit" class="btn btn-primary">Consultar periodo</button>
                    </div>
                </div>
            </form>

            <div class="workspace-balance-summary">
                <article class="workspace-balance-card">
                    <span>Periodo</span>
                    <strong>@($"{Model.MesSeleccionado:00}/{Model.AnioSeleccionado:0000}")</strong>
                    <small>Periodo operativo seleccionado.</small>
                </article>
                <article class="workspace-balance-card @(Model.Cerrado ? "workspace-balance-card-diff is-unbalanced" : "is-balanced")">
                    <span>Estado</span>
                    <strong>@Model.EstadoTexto</strong>
                    <small>@(Model.Cerrado ? "La operativa de registros esta bloqueada." : "La operativa de registros esta habilitada.")</small>
                </article>
                <article class="workspace-balance-card">
                    <span>Ultimo cambio</span>
                    <strong>@(Model.Cerrado ? (Model.FechaCierre?.ToString("dd/MM/yyyy HH:mm") ?? "-") : (Model.FechaApertura?.ToString("dd/MM/yyyy HH:mm") ?? "-"))</strong>
                    <small>@(Model.Cerrado ? (Model.UsuarioCierre ?? "Sin usuario") : (Model.UsuarioApertura ?? "Sin usuario"))</small>
                </article>
            </div>

            <div class="alert @(Model.Cerrado ? "alert-warning" : "alert-info") mt-4">
                <strong>Módulos afectados:</strong> Compras, Ventas, Caja y Bancos, Transferencias y Aplicaciones.
                <br />
                Los asientos manuales se mantienen operativos aun cuando el periodo este cerrado.
            </div>

            <form asp-action="GuardarCerrarPeriodo" method="post" class="workspace-actions">
                @Html.AntiForgeryToken()
                <input type="hidden" name="anio" value="@Model.AnioSeleccionado" />
                <input type="hidden" name="mes" value="@Model.MesSeleccionado" />
                <input type="hidden" name="cerrado" value="@((!Model.Cerrado).ToString().ToLowerInvariant())" />
                @if (Model.Cerrado)
                {
                    <button type="submit" class="btn btn-outline-secondary">Abrir periodo</button>
                }
                else
                {
                    <button type="submit" class="btn btn-danger">Cerrar periodo</button>
                }
            </form>
        </div>
    </section>
</section>
