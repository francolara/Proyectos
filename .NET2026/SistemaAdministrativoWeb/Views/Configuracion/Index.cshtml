@model SistemaAdministrativoWeb.ViewModels.Configuracion.ConfiguracionCuentaAdministradoraViewModel
@* Firma: FRANCO LARA - 10/07/2026 | Crea la vista General > Configuracion para editar datos de la cuenta administradora y completar la ficha de facturacion con consulta DNI/RUC via Migo. *@
@* Firma: FRANCO LARA - 11/07/2026 | Ajusta el formulario de configuracion para usar correo/telefono principal por defecto, renombra campos administrativos y simplifica los datos visibles del comprobante. *@
@* Firma: FRANCO LARA - 25/07/2026 | Limita el ancho, uniformiza controles y simplifica la cabecera del formulario de configuracion. *@
@* Firma: FRANCO LARA - 31/07/2026 | Adopta el patron global de titulo y subtitulo administrativo con iconos y degradado verde, incorpora selectores jerarquicos de ubicacion ocultando el codigo Ubigeo y alterna Nombre completo/Razon social segun el documento. *@
@{
    ViewData["Title"] = "Configuración";
    ViewData["AdminShell"] = true;
}

<section class="dashboard-shell subscription-shell dashboard-shell-contained dashboard-shell-contained-form">
    <section class="dashboard-hero">
        <div>
            <span class="dashboard-kicker">General</span>
            <h1 class="app-page-title"><i class="bi bi-gear" aria-hidden="true"></i><span>Configuración</span></h1>
            <p>Información de facturación que se reutilizará en boletas y facturas.</p>
        </div>
        <article class="dashboard-status-card">
            <span>Cuenta administradora</span>
            <strong>@Model.NombreCuenta</strong>
            <small>Contacto principal: @(Model.CorreoPrincipal ?? "No configurado")</small>
        </article>
    </section>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <form asp-action="Guardar"
          method="post"
          class="workspace-section workspace-account-form workspace-account-form-section"
          aria-labelledby="configuration-receipt-title"
          data-configuracion-ubigeo="true"
          data-provincias-url="@Url.Action("Provincias")"
          data-distritos-url="@Url.Action("Distritos")">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <input asp-for="NombreResponsablePrincipal" type="hidden" />
        <input asp-for="CorreoAdministrativo" type="hidden" />
        <input asp-for="TelefonoAdministrativo" type="hidden" />
        <input asp-for="IdEmpresaPredeterminada" type="hidden" />
        <input asp-for="ObservacionAdministrativa" type="hidden" />

        <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
            {
                Id = "configuration-receipt-title",
                Category = "Facturación",
                Title = "Datos del comprobante",
                Description = "Configura el documento, nombre fiscal y dirección que se usarán por defecto al emitir comprobantes comerciales.",
                IconClass = "bi bi-receipt-cutoff"
            })" />

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="TipoComprobantePreferido" class="form-label"></label>
                <select asp-for="TipoComprobantePreferido" class="form-select">
                    <option value="BOLETA">Boleta</option>
                    <option value="FACTURA">Factura</option>
                </select>
                <span asp-validation-for="TipoComprobantePreferido" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="TipoDocumentoFacturacion" class="form-label"></label>
                <select asp-for="TipoDocumentoFacturacion" class="form-select" id="tipoDocumentoFacturacion">
                    <option value="DNI">DNI</option>
                    <option value="RUC">RUC</option>
                    <option value="CE">Carnet de extranjeria</option>
                    <option value="PASAPORTE">Pasaporte</option>
                    <option value="OTRO">Otro</option>
                </select>
                <span asp-validation-for="TipoDocumentoFacturacion" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="NumeroDocumento" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="NumeroDocumento" class="form-control" id="numeroDocumentoFacturacion" />
                    <button type="button" class="btn btn-outline-secondary" id="btnConsultarPadron">Consultar</button>
                </div>
                <span asp-validation-for="NumeroDocumento" class="text-danger"></span>
                <small class="text-muted d-block mt-1" id="padronStatus">Consulta disponible para DNI y RUC.</small>
            </div>
            <div class="col-12 @(string.Equals(Model.TipoDocumentoFacturacion, "RUC", StringComparison.OrdinalIgnoreCase) ? "d-none" : string.Empty)" id="nombreFacturacionGroup">
                <label asp-for="NombreFacturacion" class="form-label"></label>
                <input asp-for="NombreFacturacion" class="form-control" id="nombreFacturacion" />
                <span asp-validation-for="NombreFacturacion" class="text-danger"></span>
            </div>
            <div class="col-12 @(string.Equals(Model.TipoDocumentoFacturacion, "RUC", StringComparison.OrdinalIgnoreCase) ? string.Empty : "d-none")" id="razonSocialFacturacionGroup">
                <label asp-for="RazonSocialFacturacion" class="form-label"></label>
                <input asp-for="RazonSocialFacturacion" class="form-control" id="razonSocialFacturacion" />
                <span asp-validation-for="RazonSocialFacturacion" class="text-danger"></span>
            </div>
            <input asp-for="CorreoFacturacion" type="hidden" />
            <input asp-for="TelefonoFacturacion" type="hidden" />
            <div class="col-md-12">
                <label asp-for="DireccionFiscal" class="form-label"></label>
                <input asp-for="DireccionFiscal" class="form-control" id="direccionFiscal" />
                <span asp-validation-for="DireccionFiscal" class="text-danger"></span>
            </div>
            <input asp-for="Ubigeo" type="hidden" id="ubigeoFacturacion" />
            <input asp-for="Distrito" type="hidden" id="distritoFacturacion" />
            <input asp-for="Provincia" type="hidden" id="provinciaFacturacion" />
            <input asp-for="Departamento" type="hidden" id="departamentoFacturacion" />
            <div class="col-md-4">
                <label asp-for="CodigoDepartamento" class="form-label">Departamento</label>
                <select asp-for="CodigoDepartamento" class="form-select" id="departamentoSelectorFacturacion">
                    <option value="">Seleccione</option>
                    @foreach (var item in Model.DepartamentosDisponibles)
                    {
                        <option value="@item.Valor">@item.Texto</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="CodigoProvincia" class="form-label">Provincia</label>
                <select asp-for="CodigoProvincia" class="form-select" id="provinciaSelectorFacturacion">
                    <option value="">Seleccione</option>
                    @foreach (var item in Model.ProvinciasDisponibles)
                    {
                        <option value="@item.Valor">@item.Texto</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label for="distritoSelectorFacturacion" class="form-label">Distrito</label>
                <select class="form-select" id="distritoSelectorFacturacion">
                    <option value="">Seleccione</option>
                    @foreach (var item in Model.DistritosDisponibles)
                    {
                        <option value="@item.Valor" selected="@(string.Equals(Model.Ubigeo, item.Valor, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@item.Texto</option>
                    }
                </select>
                <span asp-validation-for="Ubigeo" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="ObservacionFacturacion" class="form-label"></label>
                <textarea asp-for="ObservacionFacturacion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="ObservacionFacturacion" class="text-danger"></span>
            </div>
        </div>

        <div class="workspace-actions mt-4">
            <button type="submit" class="btn btn-primary">Guardar configuracion</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.querySelector("[data-configuracion-ubigeo='true']");
            const btn = document.getElementById("btnConsultarPadron");
            const tipo = document.getElementById("tipoDocumentoFacturacion");
            const numero = document.getElementById("numeroDocumentoFacturacion");
            const status = document.getElementById("padronStatus");
            const nombreGroup = document.getElementById("nombreFacturacionGroup");
            const razonGroup = document.getElementById("razonSocialFacturacionGroup");
            const departamentoSelector = document.getElementById("departamentoSelectorFacturacion");
            const provinciaSelector = document.getElementById("provinciaSelectorFacturacion");
            const distritoSelector = document.getElementById("distritoSelectorFacturacion");
            const ubigeo = document.getElementById("ubigeoFacturacion");
            const distrito = document.getElementById("distritoFacturacion");
            const provincia = document.getElementById("provinciaFacturacion");
            const departamento = document.getElementById("departamentoFacturacion");
            const provinciasUrl = form?.dataset.provinciasUrl;
            const distritosUrl = form?.dataset.distritosUrl;

            if (!form) {
                return;
            }

            const textoSeleccionado = (select) => {
                const option = select?.selectedOptions?.[0];
                return option && option.value ? option.textContent.trim() : "";
            };

            const poblarSelect = (select, items, selectedValue = "") => {
                if (!select) {
                    return;
                }

                select.innerHTML = "";
                const placeholder = document.createElement("option");
                placeholder.value = "";
                placeholder.textContent = "Seleccione";
                select.appendChild(placeholder);

                for (const item of items || []) {
                    const option = document.createElement("option");
                    option.value = item.value || "";
                    option.textContent = item.text || "";
                    select.appendChild(option);
                }

                select.value = selectedValue || "";
            };

            const cargarSelect = async (url, parametro, valor, select, selectedValue = "") => {
                if (!url || !valor || !select) {
                    poblarSelect(select, []);
                    return;
                }

                const response = await fetch(`${url}?${parametro}=${encodeURIComponent(valor)}`, {
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                if (!response.ok) {
                    throw new Error("No se pudo cargar la ubicacion seleccionada.");
                }

                poblarSelect(select, await response.json(), selectedValue);
            };

            const sincronizarNombresUbigeo = () => {
                if (departamento) departamento.value = textoSeleccionado(departamentoSelector);
                if (provincia) provincia.value = textoSeleccionado(provinciaSelector);
                if (distrito) distrito.value = textoSeleccionado(distritoSelector);
            };

            const limpiarUbigeo = () => {
                if (ubigeo) ubigeo.value = "";
                if (distrito) distrito.value = "";
            };

            const aplicarUbigeo = async (codigoUbigeo) => {
                const codigo = String(codigoUbigeo || "").trim();
                if (!codigo || codigo.length < 6) {
                    return;
                }

                const codigoDepartamento = codigo.slice(0, 2);
                const codigoProvincia = codigo.slice(0, 4);
                if (ubigeo) ubigeo.value = codigo;
                if (departamentoSelector) departamentoSelector.value = codigoDepartamento;
                await cargarSelect(provinciasUrl, "codigoDepartamento", codigoDepartamento, provinciaSelector, codigoProvincia);
                await cargarSelect(distritosUrl, "codigoProvincia", codigoProvincia, distritoSelector, codigo);
                sincronizarNombresUbigeo();
            };

            const alternarNombreFiscal = () => {
                const esRuc = String(tipo?.value || "").trim().toUpperCase() === "RUC";
                nombreGroup?.classList.toggle("d-none", esRuc);
                razonGroup?.classList.toggle("d-none", !esRuc);
            };

            tipo?.addEventListener("change", alternarNombreFiscal);
            alternarNombreFiscal();

            departamentoSelector?.addEventListener("change", async () => {
                try {
                    await cargarSelect(provinciasUrl, "codigoDepartamento", departamentoSelector.value, provinciaSelector);
                    poblarSelect(distritoSelector, []);
                    limpiarUbigeo();
                    sincronizarNombresUbigeo();
                } catch (error) {
                    if (status) {
                        status.textContent = error?.message || "No se pudieron cargar las provincias.";
                        status.className = "text-danger d-block mt-1";
                    }
                }
            });

            provinciaSelector?.addEventListener("change", async () => {
                try {
                    await cargarSelect(distritosUrl, "codigoProvincia", provinciaSelector.value, distritoSelector);
                    limpiarUbigeo();
                    sincronizarNombresUbigeo();
                } catch (error) {
                    if (status) {
                        status.textContent = error?.message || "No se pudieron cargar los distritos.";
                        status.className = "text-danger d-block mt-1";
                    }
                }
            });

            distritoSelector?.addEventListener("change", () => {
                if (ubigeo) ubigeo.value = distritoSelector.value || "";
                sincronizarNombresUbigeo();
            });

            sincronizarNombresUbigeo();

            btn?.addEventListener("click", async () => {
                const tipoValue = (tipo.value || "").trim();
                const numeroValue = (numero.value || "").trim();
                if (!numeroValue) {
                    status.textContent = "Ingrese un numero de documento antes de consultar.";
                    status.className = "text-danger d-block mt-1";
                    return;
                }

                status.textContent = "Consultando padron...";
                status.className = "text-muted d-block mt-1";

                const url = `@Url.Action("ConsultarPadron", "Configuracion")?tipoDocumento=${encodeURIComponent(tipoValue)}&numeroDocumento=${encodeURIComponent(numeroValue)}`;
                const response = await fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } });
                const data = await response.json();

                if (!data.encontrado) {
                    status.textContent = data.mensaje || "No se encontro informacion.";
                    status.className = "text-danger d-block mt-1";
                    return;
                }

                numero.value = data.numeroDocumento || numero.value;
                const nombre = document.getElementById("nombreFacturacion");
                const razon = document.getElementById("razonSocialFacturacion");
                const direccion = document.getElementById("direccionFiscal");

                if (nombre && data.nombreFacturacion) nombre.value = data.nombreFacturacion;
                if (razon && data.razonSocialFacturacion) razon.value = data.razonSocialFacturacion;
                if (direccion && data.direccionFiscal) direccion.value = data.direccionFiscal;
                if (data.ubigeo) {
                    await aplicarUbigeo(data.ubigeo);
                } else {
                    if (distrito && data.distrito) distrito.value = data.distrito;
                    if (provincia && data.provincia) provincia.value = data.provincia;
                    if (departamento && data.departamento) departamento.value = data.departamento;
                }

                status.textContent = data.mensaje || "Datos cargados correctamente.";
                status.className = "text-success d-block mt-1";
            });
        })();
    </script>
}
