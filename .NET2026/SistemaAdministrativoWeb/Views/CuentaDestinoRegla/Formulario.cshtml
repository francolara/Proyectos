@model SistemaAdministrativoWeb.ViewModels.Contabilidad.CuentaDestinoReglaIndexViewModel
@* Firma: FRANCO LARA - 29/08/2026 | Conserva el identificador de la regla para validar por separado permisos de alta y edicion al guardar. *@

@* =============================================
   Author:        FRANCO LARA
   Create date:   22/06/2026
   Description:   Migra la seleccion de cuentas en regla de cuenta destino a ayuda modal con carga Top 100 y filtro remoto, unificando los botones de ayuda con iconos de lupa y brocha.
   ============================================= *@
@* Firma: FRANCO LARA - 24/06/2026 | Restringe la ayuda popup de cuentas en regla de cuenta destino a cuentas del ultimo nivel y muestra mensaje si se intenta elegir una cuenta intermedia. *@
@* Firma: FRANCO LARA - 25/06/2026 | Renombra el mantenimiento a cuentas destino, elimina el ejercicio del formulario y conserva la configuracion unificada por cuenta origen. *@

@{
    ViewData["Title"] = "Registrar cuenta destino";
    ViewData["AdminShell"] = true;
}

<section class="dashboard-shell">
    <section class="workspace-window">
        <div class="workspace-window-head">
            <div>
                <span class="workspace-window-kicker">Formulario</span>
                <h1>@(Model.Formulario.IdPlanCuentaOrigen.HasValue ? "Editar cuenta destino" : "Registrar cuenta destino")</h1>
                <p>Configura la cuenta origen y sus tramos de distribucion contable para la empresa activa.</p>
            </div>
        </div>
        <div class="workspace-window-body">
            <form asp-action="Guardar" method="post" id="regla-form">
                @Html.AntiForgeryToken()
                <input asp-for="Formulario.IdCuentaDestinoRegla" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="workspace-form-grid">
                    <div class="workspace-field workspace-field-span-3">
                        <label asp-for="Formulario.IdPlanCuentaOrigen" class="form-label">Cuenta origen</label>
                        <input type="hidden" asp-for="Formulario.IdPlanCuentaOrigen" id="reglaCuentaOrigenId" />
                        <div class="workspace-lookup-control">
                            <input id="reglaCuentaOrigenTexto" class="form-control" value="@(string.IsNullOrWhiteSpace(Model.Formulario.CuentaOrigenTexto) ? "Seleccione cuenta" : Model.Formulario.CuentaOrigenTexto)" readonly />
                            <button type="button" class="btn btn-outline-secondary workspace-icon-button" id="abrirCuentaOrigenModal" title="Buscar cuenta origen" aria-label="Buscar cuenta origen"><i class="bi bi-search"></i></button>
                            <button type="button" class="btn btn-outline-secondary workspace-icon-button" id="limpiarCuentaOrigen" title="Limpiar cuenta origen" aria-label="Limpiar cuenta origen"><i class="bi bi-brush"></i></button>
                        </div>
                        <span asp-validation-for="Formulario.IdPlanCuentaOrigen" class="text-danger"></span>
                    </div>
                    <div class="workspace-field workspace-field-span-3">
                        <label asp-for="Formulario.Observacion" class="form-label">Observacion</label>
                        <textarea asp-for="Formulario.Observacion" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Formulario.Observacion" class="text-danger"></span>
                    </div>
                </div>

                <div class="workspace-check-grid">
                    <label class="workspace-check">
                        <input asp-for="Formulario.Activo" class="form-check-input" />
                        <span>Regla activa</span>
                    </label>
                </div>

                <div class="workspace-section">
                    <div class="workspace-section-head">
                        <div>
                            <h2>Tramos de destino</h2>
                            <p>La suma de los tramos activos debe ser exactamente 100.</p>
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="agregar-tramo">Agregar tramo</button>
                    </div>

                    <div class="table-responsive workspace-table-wrap">
                        <table class="table align-middle app-table workspace-table" id="detalle-table">
                            <thead>
                                <tr>
                                    <th>Orden</th>
                                    <th>Cuenta destino</th>
                                    <th>Contrapartida</th>
                                    <th>%</th>
                                    <th>Activo</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Formulario.Detalles.Count; i++)
                                {
                                    <tr>
                                        <td class="detalle-orden-cell">
                                            <input asp-for="Formulario.Detalles[i].Orden" class="form-control" readonly />
                                            <span asp-validation-for="Formulario.Detalles[i].Orden" class="text-danger"></span>
                                        </td>
                                        <td>
                                            <input type="hidden" asp-for="Formulario.Detalles[i].IdPlanCuentaDestinoCargo" class="js-cuenta-cargo-id" />
                                            <div class="workspace-lookup-control workspace-lookup-control-compact">
                                                <input class="form-control js-cuenta-cargo-texto" value="@(string.IsNullOrWhiteSpace(Model.Formulario.Detalles[i].CuentaDestinoCargoTexto) ? "Seleccione cuenta" : Model.Formulario.Detalles[i].CuentaDestinoCargoTexto)" readonly />
                                                <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-open-cuenta-cargo-modal" title="Buscar cuenta destino" aria-label="Buscar cuenta destino"><i class="bi bi-search"></i></button>
                                            </div>
                                            <span asp-validation-for="Formulario.Detalles[i].IdPlanCuentaDestinoCargo" class="text-danger"></span>
                                        </td>
                                        <td>
                                            <input type="hidden" asp-for="Formulario.Detalles[i].IdPlanCuentaDestinoAbono" class="js-cuenta-abono-id" />
                                            <div class="workspace-lookup-control workspace-lookup-control-compact">
                                                <input class="form-control js-cuenta-abono-texto" value="@(string.IsNullOrWhiteSpace(Model.Formulario.Detalles[i].CuentaDestinoAbonoTexto) ? "Seleccione cuenta" : Model.Formulario.Detalles[i].CuentaDestinoAbonoTexto)" readonly />
                                                <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-open-cuenta-abono-modal" title="Buscar contrapartida" aria-label="Buscar contrapartida"><i class="bi bi-search"></i></button>
                                            </div>
                                            <span asp-validation-for="Formulario.Detalles[i].IdPlanCuentaDestinoAbono" class="text-danger"></span>
                                        </td>
                                        <td class="detalle-porcentaje-cell">
                                            <input asp-for="Formulario.Detalles[i].Porcentaje" class="form-control js-porcentaje" />
                                            <span asp-validation-for="Formulario.Detalles[i].Porcentaje" class="text-danger"></span>
                                        </td>
                                        <td class="text-center">
                                            <input asp-for="Formulario.Detalles[i].Activo" class="form-check-input js-activo" />
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-outline-secondary btn-sm js-remove-row">Quitar</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="workspace-inline-note">
                        <strong>Total activo:</strong> <span id="porcentaje-total">0.0000</span>
                    </div>
                </div>

                <div class="workspace-actions">
                    <button type="submit" class="btn btn-primary">Guardar cuenta destino</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </section>
</section>

<template id="detalle-row-template">
    <tr>
        <td class="detalle-orden-cell">
            <input name="Formulario.Detalles[__index__].Orden" class="form-control" readonly value="0" />
        </td>
        <td>
            <input type="hidden" name="Formulario.Detalles[__index__].IdPlanCuentaDestinoCargo" class="js-cuenta-cargo-id" />
            <div class="workspace-lookup-control workspace-lookup-control-compact">
                <input class="form-control js-cuenta-cargo-texto" value="Seleccione cuenta" readonly />
                <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-open-cuenta-cargo-modal" title="Buscar cuenta destino" aria-label="Buscar cuenta destino"><i class="bi bi-search"></i></button>
            </div>
        </td>
        <td>
            <input type="hidden" name="Formulario.Detalles[__index__].IdPlanCuentaDestinoAbono" class="js-cuenta-abono-id" />
            <div class="workspace-lookup-control workspace-lookup-control-compact">
                <input class="form-control js-cuenta-abono-texto" value="Seleccione cuenta" readonly />
                <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-open-cuenta-abono-modal" title="Buscar contrapartida" aria-label="Buscar contrapartida"><i class="bi bi-search"></i></button>
            </div>
        </td>
        <td class="detalle-porcentaje-cell">
            <input name="Formulario.Detalles[__index__].Porcentaje" class="form-control js-porcentaje" value="0" />
        </td>
        <td class="text-center">
            <input name="Formulario.Detalles[__index__].Activo" class="form-check-input js-activo" type="checkbox" value="true" checked />
            <input name="Formulario.Detalles[__index__].Activo" type="hidden" value="false" />
        </td>
        <td class="text-end">
            <button type="button" class="btn btn-outline-secondary btn-sm js-remove-row">Quitar</button>
        </td>
    </tr>
</template>

<div class="modal fade workspace-modal" id="reglaCuentaModal" tabindex="-1" aria-labelledby="reglaCuentaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content workspace-modal-content">
            <div class="modal-header workspace-modal-header">
                <div>
                    <span class="workspace-window-kicker">Ayuda contable</span>
                    <h2 class="workspace-modal-title" id="reglaCuentaModalLabel">Seleccionar cuenta contable</h2>
                    <p class="workspace-modal-subtitle">Se cargan hasta 100 cuentas. Si necesita una cuenta especifica, filtre por codigo o nombre.</p>
                </div>
                <button type="button" class="btn-close workspace-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body workspace-modal-body">
                <div class="workspace-filter-card mt-0">
                    <div class="workspace-filter-grid">
                        <div class="workspace-field workspace-field-span-2">
                            <label class="form-label" for="reglaCuentaFiltro">Filtro</label>
                            <input id="reglaCuentaFiltro" class="form-control" placeholder="Codigo o nombre de cuenta" autocomplete="off" />
                        </div>
                        <div class="workspace-field">
                            <label class="form-label" for="reglaCuentaNivelFiltro">Nivel</label>
                            <select id="reglaCuentaNivelFiltro" class="form-select">
                                <option value="">Todos</option>
                                @for (var nivel = 1; nivel <= 5; nivel++)
                                {
                                    <option value="@nivel">@nivel</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="table-responsive workspace-table-wrap">
                    <table class="table align-middle app-table workspace-table workspace-lookup-table">
                        <thead>
                            <tr>
                                <th class="workspace-lookup-select-cell">Sel.</th>
                                <th>Codigo</th>
                                <th>Cuenta</th>
                                <th>Nivel</th>
                                <th>Centro costo</th>
                            </tr>
                        </thead>
                        <tbody id="reglaCuentaResultados">
                            <tr data-cuenta-empty-row="true" class="d-none">
                                <td colspan="5">
                                    <div class="app-empty-state app-empty-state-inline">
                                        <i class="bi bi-search"></i>
                                        <div>
                                            <strong>No hay cuentas con ese filtro</strong>
                                            <p>Ajusta el texto o nivel para ubicar la cuenta contable.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer workspace-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="aceptarCuentaRegla">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const tableBody = document.querySelector("#detalle-table tbody");
            const template = document.getElementById("detalle-row-template");
            const addButton = document.getElementById("agregar-tramo");
            const totalLabel = document.getElementById("porcentaje-total");
            const cuentaModalEl = document.getElementById("reglaCuentaModal");
            const cuentaModal = cuentaModalEl && window.bootstrap ? bootstrap.Modal.getOrCreateInstance(cuentaModalEl) : null;
            const cuentaResultadosBodyEl = document.getElementById("reglaCuentaResultados");
            const cuentaFiltro = document.getElementById("reglaCuentaFiltro");
            const cuentaNivelFiltro = document.getElementById("reglaCuentaNivelFiltro");
            const buscarCuentasUrl = '@Url.Action("BuscarAyuda", "PlanCuenta")';
            const cuentaOrigenIdEl = document.getElementById("reglaCuentaOrigenId");
            const cuentaOrigenTextoEl = document.getElementById("reglaCuentaOrigenTexto");
            let cuentaSeleccion = null;
            let cuentaTarget = null;
            let cuentaBusquedaProgramada = null;

            if (!tableBody || !template || !addButton || !totalLabel) {
                return;
            }

            const marcarSeleccionCuenta = () => {
                const rows = Array.from(cuentaResultadosBodyEl?.querySelectorAll("[data-cuenta-row='true']") || []);
                rows.forEach((row) => {
                    const seleccionado = cuentaSeleccion && row.dataset.id === String(cuentaSeleccion.idPlanCuenta);
                    row.classList.toggle("is-selected", seleccionado);
                    const radio = row.querySelector("input[type='radio']");
                    if (radio) {
                        radio.checked = Boolean(seleccionado);
                    }
                });
            };

            const renderCuentaResultados = (items) => {
                if (!cuentaResultadosBodyEl) {
                    return;
                }

                const emptyRow = cuentaResultadosBodyEl.querySelector("[data-cuenta-empty-row='true']");
                cuentaResultadosBodyEl.querySelectorAll("[data-cuenta-row='true']").forEach((row) => row.remove());
                emptyRow?.classList.toggle("d-none", items.length > 0);

                items.forEach((item) => {
                    const row = document.createElement("tr");
                    row.className = "workspace-lookup-row";
                    row.dataset.cuentaRow = "true";
                    row.dataset.id = String(item.idPlanCuenta || "");
                    row.dataset.codigo = String(item.codigoCuenta || "");
                    row.dataset.nombre = String(item.nombreCuenta || "");
                    row.innerHTML = `
                        <td class="workspace-lookup-select-cell"><input class="form-check-input" type="radio" name="cuentaReglaSeleccion" value="${String(item.idPlanCuenta || "")}" /></td>
                        <td class="workspace-tree-code">${String(item.codigoCuenta || "")}</td>
                        <td>${String(item.nombreCuenta || "")}</td>
                        <td>${String(item.nivelCuenta || "")}</td>
                        <td>${item.requiereCentroCosto ? "Si" : "No"}</td>`;
                    row.addEventListener("click", () => {
                        cuentaSeleccion = item;
                        marcarSeleccionCuenta();
                    });
                    cuentaResultadosBodyEl.appendChild(row);
                });

                marcarSeleccionCuenta();
            };

            const cargarCuentasAyuda = async () => {
                const params = new URLSearchParams({ tamanoPagina: "100" });
                const filtro = String(cuentaFiltro?.value || "").trim();
                const nivel = String(cuentaNivelFiltro?.value || "").trim();
                if (filtro.length >= 2) {
                    params.append("textoBusqueda", filtro);
                }
                if (nivel) {
                    params.append("nivelCuenta", nivel);
                }

                const response = await fetch(`${buscarCuentasUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    throw new Error(payload.mensaje || "No se pudo cargar el plan de cuentas.");
                }

                renderCuentaResultados(payload.items || []);
            };

            const programarBusquedaCuenta = () => {
                if (cuentaBusquedaProgramada) {
                    window.clearTimeout(cuentaBusquedaProgramada);
                }

                cuentaBusquedaProgramada = window.setTimeout(async () => {
                    try {
                        await cargarCuentasAyuda();
                    } catch (error) {
                        console.warn(error);
                        renderCuentaResultados([]);
                    }
                }, 250);
            };

            const bindRowActions = (row) => {
                row.querySelector(".js-remove-row")?.addEventListener("click", () => {
                    if (tableBody.querySelectorAll("tr").length === 1) {
                        return;
                    }

                    row.remove();
                    refreshRows();
                });

                row.querySelector(".js-open-cuenta-cargo-modal")?.addEventListener("click", async () => {
                    cuentaTarget = { tipo: "cargo", row };
                    const cuentaIdActual = row.querySelector(".js-cuenta-cargo-id")?.value || "";
                    cuentaSeleccion = cuentaIdActual ? { idPlanCuenta: cuentaIdActual } : null;
                    try {
                        await cargarCuentasAyuda();
                    } catch (error) {
                        console.warn(error);
                        renderCuentaResultados([]);
                    }
                    cuentaModal?.show();
                });

                row.querySelector(".js-open-cuenta-abono-modal")?.addEventListener("click", async () => {
                    cuentaTarget = { tipo: "abono", row };
                    const cuentaIdActual = row.querySelector(".js-cuenta-abono-id")?.value || "";
                    cuentaSeleccion = cuentaIdActual ? { idPlanCuenta: cuentaIdActual } : null;
                    try {
                        await cargarCuentasAyuda();
                    } catch (error) {
                        console.warn(error);
                        renderCuentaResultados([]);
                    }
                    cuentaModal?.show();
                });
            };

            const refreshRows = () => {
                const rows = Array.from(tableBody.querySelectorAll("tr"));
                let total = 0;

                rows.forEach((row, index) => {
                    row.querySelectorAll("input, select, textarea, span").forEach((element) => {
                        ["name", "id", "for"].forEach((attribute) => {
                            const currentValue = element.getAttribute(attribute);
                            if (!currentValue) {
                                return;
                            }

                            const updatedValue = currentValue
                                .replaceAll("__index__", index)
                                .replace(/Formulario\.Detalles\[\d+\]/g, `Formulario.Detalles[${index}]`)
                                .replace(/Formulario_Detalles_\d+__/g, `Formulario_Detalles_${index}__`);

                            if (updatedValue !== currentValue) {
                                element.setAttribute(attribute, updatedValue);
                            }
                        });
                    });

                    const orderInput = row.querySelector('input[name$=".Orden"]');
                    if (orderInput) {
                        orderInput.value = (index + 1).toString();
                    }

                    const activeInput = row.querySelector(".js-activo");
                    const percentageInput = row.querySelector(".js-porcentaje");
                    const percentageValue = parseFloat((percentageInput?.value ?? "0").replace(",", "."));
                    if (activeInput?.checked && !Number.isNaN(percentageValue)) {
                        total += percentageValue;
                    }
                });

                totalLabel.textContent = total.toFixed(4);
            };

            addButton.addEventListener("click", () => {
                const index = tableBody.querySelectorAll("tr").length;
                const html = template.innerHTML.replaceAll("__index__", index);
                tableBody.insertAdjacentHTML("beforeend", html);
                const row = tableBody.lastElementChild;
                if (row) {
                    bindRowActions(row);
                }
                refreshRows();
            });

            tableBody.querySelectorAll("tr").forEach(bindRowActions);
            tableBody.addEventListener("input", refreshRows);
            tableBody.addEventListener("change", refreshRows);
            document.getElementById("abrirCuentaOrigenModal")?.addEventListener("click", async () => {
                cuentaTarget = { tipo: "origen", row: null };
                const cuentaIdActual = cuentaOrigenIdEl?.value || "";
                cuentaSeleccion = cuentaIdActual ? { idPlanCuenta: cuentaIdActual } : null;
                try {
                    await cargarCuentasAyuda();
                } catch (error) {
                    console.warn(error);
                    renderCuentaResultados([]);
                }
                cuentaModal?.show();
            });
            document.getElementById("limpiarCuentaOrigen")?.addEventListener("click", () => {
                if (cuentaOrigenIdEl) {
                    cuentaOrigenIdEl.value = "";
                }
                if (cuentaOrigenTextoEl) {
                    cuentaOrigenTextoEl.value = "Seleccione cuenta";
                }
            });
            cuentaFiltro?.addEventListener("input", programarBusquedaCuenta);
            cuentaNivelFiltro?.addEventListener("change", programarBusquedaCuenta);
            document.getElementById("aceptarCuentaRegla")?.addEventListener("click", () => {
                if (String(cuentaSeleccion?.nivelCuenta || "") !== "5") {
                    window.alert("Seleccione una cuenta contable de nivel 5.");
                    return;
                }

                if (cuentaSeleccion && cuentaTarget) {
                    const cuentaTexto = `${String(cuentaSeleccion.codigoCuenta || "")} - ${String(cuentaSeleccion.nombreCuenta || "")}`;
                    if (cuentaTarget.tipo === "origen") {
                        if (cuentaOrigenIdEl) {
                            cuentaOrigenIdEl.value = String(cuentaSeleccion.idPlanCuenta || "");
                        }
                        if (cuentaOrigenTextoEl) {
                            cuentaOrigenTextoEl.value = cuentaTexto;
                        }
                    } else if (cuentaTarget.row) {
                        const idSelector = cuentaTarget.tipo === "cargo" ? ".js-cuenta-cargo-id" : ".js-cuenta-abono-id";
                        const textSelector = cuentaTarget.tipo === "cargo" ? ".js-cuenta-cargo-texto" : ".js-cuenta-abono-texto";
                        const idInput = cuentaTarget.row.querySelector(idSelector);
                        const textInput = cuentaTarget.row.querySelector(textSelector);
                        if (idInput) {
                            idInput.value = String(cuentaSeleccion.idPlanCuenta || "");
                        }
                        if (textInput) {
                            textInput.value = cuentaTexto;
                        }
                    }
                }
                cuentaModal?.hide();
            });
            refreshRows();
        })();
    </script>
}
