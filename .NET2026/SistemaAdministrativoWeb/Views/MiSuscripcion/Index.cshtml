@model SistemaAdministrativoWeb.ViewModels.Suscripciones.MiSuscripcionIndexViewModel
@* Firma: FRANCO LARA - 08/07/2026 | Agrega la vista Mi suscripcion al panel contable con resumen de vigencia, limites operativos y contexto de cuenta administradora. *@
@* Firma: FRANCO LARA - 25/07/2026 | Mantiene un ancho de lectura controlado, simplifica las tarjetas y muestra visualmente el plan y estado efectivo, incluyendo alertas de gracia o bloqueo por vencimiento. *@
@{
    ViewData["Title"] = "Mi suscripcion";
    ViewData["AdminShell"] = true;

    var estadoClase = Model.EstadoEfectivo switch
    {
        "ACTIVO" => "subscription-pill is-success",
        "EN_PRUEBA" => "subscription-pill is-warning",
        "EN_GRACIA" => "subscription-pill is-warning",
        "VENCIDO" => "subscription-pill is-danger",
        "SUSPENDIDO" => "subscription-pill is-danger",
        "BAJA" => "subscription-pill is-danger",
        _ => "subscription-pill"
    };

    var diasTexto = Model.DiasParaVencer switch
    {
        < 0 => $"Vencio hace {Math.Abs(Model.DiasParaVencer.Value)} dias",
        0 => "Vence hoy",
        > 0 => $"{Model.DiasParaVencer.Value} dias",
        _ => "Sin fecha"
    };
}

<section class="dashboard-shell subscription-shell dashboard-shell-contained dashboard-shell-contained-reading">
    <section class="dashboard-hero">
        <div>
            <span class="dashboard-kicker">General</span>
            <h1>Mi suscripcion</h1>
            <p>Consulta la vigencia de la cuenta administradora, los limites operativos y el contexto de servicio de la empresa activa.</p>
        </div>
        <article class="dashboard-status-card">
            <span>Cuenta administradora</span>
            <strong>@Model.NombreCuenta</strong>
        </article>
    </section>

    @if (Model.AccesoRestringido)
    {
        <div class="alert alert-danger subscription-access-alert" role="alert">
            <strong>Acceso operativo restringido.</strong>
            <span>@Model.ResumenVigencia</span>
            <span>Mientras regularizas la suscripcion puedes consultar esta pantalla, la ayuda y cerrar sesion.</span>
        </div>
    }
    else if (string.Equals(Model.EstadoEfectivo, "EN_GRACIA", StringComparison.OrdinalIgnoreCase))
    {
        <div class="alert alert-warning subscription-access-alert" role="status">
            <strong>Periodo de gracia activo.</strong>
            <span>@Model.ResumenVigencia</span>
        </div>
    }

    <section class="dashboard-metrics">
        <article class="dashboard-metric-card dashboard-metric-card-text">
            <span>Estado actual</span>
            <strong><span class="@estadoClase">@Model.EstadoSuscripcion</span></strong>
        </article>
        <article class="dashboard-metric-card dashboard-metric-card-text">
            <span>Plan</span>
            <strong>@Model.TipoPlan</strong>
        </article>
        <article class="dashboard-metric-card dashboard-metric-card-text">
            <span>Fecha de vencimiento</span>
            <strong>@(Model.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "Sin fecha")</strong>
        </article>
        <article class="dashboard-metric-card dashboard-metric-card-count">
            <span>Dias para vencer</span>
            <strong>@diasTexto</strong>
        </article>
    </section>

    <section class="workspace-section">
        <div class="workspace-section-head workspace-section-head-compact">
            <span class="workspace-section-kicker">Contexto</span>
            <h2>Datos de contacto de la cuenta</h2>
            <p>Correo y telefono principal registrados para la cuenta administradora.</p>
        </div>

        <div class="subscription-info-grid subscription-info-grid-compact">
            <article class="subscription-info-card">
                <span class="subscription-info-label">Correo principal</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.CorreoPrincipal) ? "No configurado" : Model.CorreoPrincipal)</strong>
            </article>
            <article class="subscription-info-card">
                <span class="subscription-info-label">Telefono principal</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.TelefonoPrincipal) ? "No configurado" : Model.TelefonoPrincipal)</strong>
            </article>
        </div>
    </section>

    <section class="workspace-section">
        <div class="workspace-section-head workspace-section-head-compact">
            <span class="workspace-section-kicker">Limites</span>
            <h2>Capacidad operativa</h2>
            <p>Referencia de crecimiento permitida para empresas y usuarios bajo la misma cuenta administradora.</p>
        </div>

        <div class="subscription-limit-grid subscription-limit-grid-compact">
            <article class="dashboard-indicator-card">
                <div class="dashboard-indicator-icon">
                    <i class="bi bi-buildings"></i>
                </div>
                <div class="dashboard-indicator-copy">
                    <span>Empresas permitidas</span>
                    <strong>@(Model.EmpresasPermitidas?.ToString() ?? "Ilimitado")</strong>
                </div>
            </article>
            <article class="dashboard-indicator-card">
                <div class="dashboard-indicator-icon">
                    <i class="bi bi-people"></i>
                </div>
                <div class="dashboard-indicator-copy">
                    <span>Usuarios permitidos</span>
                    <strong>@(Model.UsuariosPermitidos?.ToString() ?? "Ilimitado")</strong>
                </div>
            </article>
            <article class="dashboard-indicator-card">
                <div class="dashboard-indicator-icon">
                    <i class="bi bi-patch-check"></i>
                </div>
                <div class="dashboard-indicator-copy">
                    <span>Estado de cuenta</span>
                    <strong>@(Model.EstadoCuenta ? "Activa" : "Inactiva")</strong>
                    <small>Valida si la cuenta administradora sigue habilitada para operar.</small>
                </div>
            </article>
        </div>
    </section>

</section>
