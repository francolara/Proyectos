@model SistemaAdministrativoWeb.ViewModels.Suscripciones.MiSuscripcionIndexViewModel
@* Firma: FRANCO LARA - 08/07/2026 | Agrega la vista Mi suscripcion al panel contable con resumen de vigencia, limites operativos y contexto de cuenta administradora. *@
@{
    ViewData["Title"] = "Mi suscripcion";
    ViewData["AdminShell"] = true;

    var planTexto = Model.TipoPlan switch
    {
        "PRO" => "Plan orientado a operacion contable continua, multiempresa y mayor capacidad de usuarios.",
        "BASICO" => "Plan operativo para registrar, consultar y cerrar el circuito contable mensual.",
        _ => "Modalidad de prueba o configuracion inicial mientras se completa la suscripcion."
    };

    var estadoClase = Model.EstadoSuscripcion switch
    {
        "ACTIVO" => "subscription-pill is-success",
        "TRIAL" => "subscription-pill is-warning",
        "SUSPENDIDO" => "subscription-pill is-danger",
        "BAJA" => "subscription-pill is-danger",
        _ => "subscription-pill"
    };

    var diasTexto = Model.DiasParaVencer.HasValue
        ? Model.DiasParaVencer.Value.ToString("0")
        : "Sin fecha";
}

<section class="dashboard-shell subscription-shell">
    <section class="dashboard-hero">
        <div>
            <span class="dashboard-kicker">General</span>
            <h1>Mi suscripcion</h1>
            <p>Consulta la vigencia de la cuenta administradora, los limites operativos y el contexto de servicio de la empresa activa.</p>
        </div>
        <article class="dashboard-status-card">
            <span>Cuenta administradora</span>
            <strong>@Model.NombreCuenta</strong>
            <small>Codigo: @Model.CodigoCuenta</small>
            <small>@Model.ResumenVigencia</small>
        </article>
    </section>

    <section class="dashboard-metrics">
        <article class="dashboard-metric-card dashboard-metric-card-text">
            <span>Estado actual</span>
            <strong><span class="@estadoClase">@Model.EstadoSuscripcion</span></strong>
            <small>Estado de acceso de la suscripcion vinculada a la empresa activa.</small>
        </article>
        <article class="dashboard-metric-card dashboard-metric-card-text">
            <span>Plan</span>
            <strong>@Model.TipoPlan</strong>
            <small>@planTexto</small>
        </article>
        <article class="dashboard-metric-card dashboard-metric-card-text">
            <span>Fecha de vencimiento</span>
            <strong>@(Model.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "Sin fecha")</strong>
            <small>Si esta en prueba usa el fin de prueba; de lo contrario usa la fecha fin del plan.</small>
        </article>
        <article class="dashboard-metric-card dashboard-metric-card-count">
            <span>Dias para vencer</span>
            <strong>@diasTexto</strong>
            <small>Control preventivo para renovacion y continuidad operativa.</small>
        </article>
    </section>

    <section class="workspace-section">
        <div class="workspace-section-head workspace-section-head-compact">
            <span class="workspace-section-kicker">Contexto</span>
            <h2>Datos de la empresa y la cuenta</h2>
            <p>Informacion funcional usada por el sistema para validar vigencia, contacto y limites del servicio.</p>
        </div>

        <div class="subscription-info-grid">
            <article class="subscription-info-card">
                <span class="subscription-info-label">Empresa activa</span>
                <strong>@Model.NombreEmpresa</strong>
                <small>RUC: @(string.IsNullOrWhiteSpace(Model.Ruc) ? "No configurado" : Model.Ruc)</small>
            </article>
            <article class="subscription-info-card">
                <span class="subscription-info-label">Correo principal</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.CorreoPrincipal) ? "No configurado" : Model.CorreoPrincipal)</strong>
                <small>Canal principal asociado a la cuenta administradora.</small>
            </article>
            <article class="subscription-info-card">
                <span class="subscription-info-label">Telefono principal</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.TelefonoPrincipal) ? "No configurado" : Model.TelefonoPrincipal)</strong>
                <small>Telefono de contacto registrado para coordinacion operativa.</small>
            </article>
            <article class="subscription-info-card">
                <span class="subscription-info-label">Modalidad</span>
                <strong>@(Model.EsPrueba ? "Prueba" : "Plan contratado")</strong>
                <small>@(Model.EsPrueba ? $"Prueba: {(Model.FechaInicioPrueba?.ToString("dd/MM/yyyy") ?? "-")} al {(Model.FechaFinPrueba?.ToString("dd/MM/yyyy") ?? "-")}" : $"Plan: {(Model.FechaInicioPlan?.ToString("dd/MM/yyyy") ?? "-")} al {(Model.FechaFinPlan?.ToString("dd/MM/yyyy") ?? "-")}")</small>
            </article>
        </div>
    </section>

    <section class="workspace-section">
        <div class="workspace-section-head workspace-section-head-compact">
            <span class="workspace-section-kicker">Limites</span>
            <h2>Capacidad operativa</h2>
            <p>Referencia de crecimiento permitida para empresas y usuarios bajo la misma cuenta administradora.</p>
        </div>

        <div class="subscription-limit-grid">
            <article class="dashboard-indicator-card">
                <div class="dashboard-indicator-icon">
                    <i class="bi bi-buildings"></i>
                </div>
                <div class="dashboard-indicator-copy">
                    <span>Empresas permitidas</span>
                    <strong>@(Model.EmpresasPermitidas?.ToString() ?? "Ilimitado")</strong>
                    <small>Capacidad habilitada para vincular nuevas empresas a la cuenta administradora.</small>
                </div>
            </article>
            <article class="dashboard-indicator-card">
                <div class="dashboard-indicator-icon">
                    <i class="bi bi-people"></i>
                </div>
                <div class="dashboard-indicator-copy">
                    <span>Usuarios permitidos</span>
                    <strong>@(Model.UsuariosPermitidos?.ToString() ?? "Ilimitado")</strong>
                    <small>Numero de accesos operativos que puede sostener la cuenta administradora.</small>
                </div>
            </article>
            <article class="dashboard-indicator-card">
                <div class="dashboard-indicator-icon">
                    <i class="bi bi-patch-check"></i>
                </div>
                <div class="dashboard-indicator-copy">
                    <span>Estado de cuenta</span>
                    <strong>@(Model.EstadoCuenta ? "Activa" : "Inactiva")</strong>
                    <small>Valida si la cuenta administradora sigue habilitada para operar.</small>
                </div>
            </article>
            <article class="dashboard-indicator-card">
                <div class="dashboard-indicator-icon">
                    <i class="bi bi-building-check"></i>
                </div>
                <div class="dashboard-indicator-copy">
                    <span>Estado de empresa</span>
                    <strong>@(Model.EstadoEmpresa ? "Activa" : "Inactiva")</strong>
                    <small>Controla si la empresa actual mantiene acceso operativo dentro del panel.</small>
                </div>
            </article>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Observacion))
    {
        <section class="workspace-section subscription-note-card">
            <div class="workspace-section-head workspace-section-head-compact">
                <span class="workspace-section-kicker">Observacion</span>
                <h2>Notas del servicio</h2>
                <p>@Model.Observacion</p>
            </div>
        </section>
    }
</section>
