@model SistemaAdministrativoWeb.ViewModels.Usuarios.UsuarioPermisosViewModel
@* Firma: FRANCO LARA - 10/07/2026 | Crea la vista de detalle de permisos por cuenta y por empresa para usuarios de la cuenta administradora. *@
@* Firma: FRANCO LARA - 12/07/2026 | Retira la edicion de cuenta y empresa predeterminada del detalle de permisos para que la seleccion de empresa se haga siempre desde el panel correspondiente. *@
@* Firma: FRANCO LARA - 31/07/2026 | Adopta el patron global de titulo y subtitulos administrativos con iconos y degradado verde. *@
@* Firma: FRANCO LARA - 29/08/2026 | Reorganiza permisos en pestanas, grupos desplegables y controles de tres estados con guardado por lote; fija Empresas como acceso obligatorio y mantiene Crear y Editar configurables. *@
@{
    ViewData["Title"] = "Permisos de usuario";
    ViewData["AdminShell"] = true;
    var permisosCuenta = Model.PermisosCuenta.ToList();
    var permisosEmpresa = Model.PermisosEmpresa.ToList();
    var cuentaIndices = permisosCuenta.Select((permiso, indice) => new { permiso.IdModuloSistema, indice }).ToDictionary(x => x.IdModuloSistema, x => x.indice);
    var empresaIndices = permisosEmpresa.Select((permiso, indice) => new { permiso.IdModuloSistema, indice }).ToDictionary(x => x.IdModuloSistema, x => x.indice);
    string ValorOverride(bool? valor) => valor.HasValue ? (valor.Value ? "true" : "false") : string.Empty;
}

<section class="dashboard-shell subscription-shell permission-maintenance" data-permission-page data-active-tab="@Model.PestanaActiva">
    <section class="dashboard-hero">
        <div>
            <span class="dashboard-kicker">General / Usuarios</span>
            <h1 class="app-page-title"><i class="bi bi-shield-lock" aria-hidden="true"></i><span>@Model.NombreCompleto</span></h1>
            <p>@Model.CorreoUsuario</p>
        </div>
        <article class="dashboard-status-card">
            <span>Rol de cuenta</span>
            <strong>@Model.RolCuenta</strong>
            <small>Empresas asignadas: @Model.EmpresasSeleccionadas.Count</small>
            <small>@(Model.IdEmpresaSeleccionada.HasValue ? $"Empresa en revision: {Model.NombreEmpresaSeleccionada}" : "Sin empresa seleccionada")</small>
        </article>
    </section>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <section class="workspace-section" aria-labelledby="user-base-access-title">
        <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
            {
                Id = "user-base-access-title",
                Category = "Acceso base",
                Title = "Rol y empresas",
                Description = "Define el rol base y las empresas donde el usuario puede trabajar.",
                IconClass = "bi bi-person-check"
            })" />

        <form asp-action="ActualizarAcceso" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="IdCuentaAdministradora" type="hidden" />
            <input asp-for="IdUsuarioCuentaAdministradora" type="hidden" />
            <input asp-for="AspNetUserId" type="hidden" />
            <input asp-for="IdEmpresaSeleccionada" type="hidden" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="RolCuenta" class="form-label"></label>
                    <select asp-for="RolCuenta" asp-items="ViewBag.RoleOptions" class="form-select"></select>
                </div>
                <div class="col-md-6 d-flex align-items-end"><div class="form-text mb-2">La empresa activa se elige desde el selector general del sistema.</div></div>
            </div>
            <div class="mt-4">
                <label class="form-label">Empresas habilitadas</label>
                <div class="row g-2">
                    @foreach (var empresa in Model.EmpresasDisponibles)
                    {
                        <div class="col-md-6"><label class="border rounded p-3 d-flex gap-2 align-items-start w-100"><input type="checkbox" class="form-check-input mt-1" name="EmpresasSeleccionadas" value="@empresa.IdEmpresa" @(Model.EmpresasSeleccionadas.Contains(empresa.IdEmpresa) ? "checked" : null) /><span><strong>@empresa.CodigoEmpresa</strong><br /><small>@empresa.RazonSocial</small></span></label></div>
                    }
                </div>
            </div>
            <div class="workspace-actions mt-4"><button type="submit" class="btn btn-primary">Actualizar acceso</button><a asp-action="Index" class="btn btn-outline-secondary">Volver</a></div>
        </form>
    </section>

    <section class="workspace-section permission-workspace" aria-labelledby="permission-workspace-title">
        <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
            {
                Id = "permission-workspace-title",
                Category = "Excepciones de acceso",
                Title = "Permisos por opcion",
                Description = "Administra excepciones generales o por empresa. El estado Heredado conserva el permiso definido por el rol.",
                IconClass = "bi bi-ui-checks-grid"
            })" />

        <div class="permission-tabs" role="tablist" aria-label="Ambito de permisos">
            <button type="button" class="permission-tab" role="tab" data-permission-tab="general" aria-controls="permission-panel-general"><i class="bi bi-grid" aria-hidden="true"></i><span>Opciones generales</span><strong>@permisosCuenta.Count</strong></button>
            <button type="button" class="permission-tab" role="tab" data-permission-tab="contable" aria-controls="permission-panel-contable"><i class="bi bi-building-check" aria-hidden="true"></i><span>Modulo contable</span><strong>@permisosEmpresa.Count</strong></button>
        </div>

        <div id="permission-panel-general" class="permission-tab-panel" role="tabpanel" data-permission-panel="general">
            <form asp-action="GuardarPermisosCuenta" method="post" data-permission-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="AspNetUserId" value="@Model.AspNetUserId" />
                <input type="hidden" name="IdUsuarioCuentaAdministradora" value="@Model.IdUsuarioCuentaAdministradora" />
                <div class="permission-toolbar">
                    <div class="permission-search"><i class="bi bi-search" aria-hidden="true"></i><input type="search" class="form-control" placeholder="Buscar opcion general" aria-label="Buscar opcion general" data-permission-search /></div>
                    <button type="button" class="btn btn-outline-secondary" data-restore-all><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Restaurar todo al rol</button>
                </div>
                <div class="permission-tree" data-permission-tree>
                    @{ var grupoCuentaIndice = 0; }
                    @foreach (var grupo in permisosCuenta.GroupBy(x => string.IsNullOrWhiteSpace(x.GrupoMenu) ? "General" : x.GrupoMenu))
                    {
                        var grupoId = $"permission-account-group-{grupoCuentaIndice++}";
                        <details class="permission-group" open data-permission-group>
                            <summary><span class="permission-group-chevron"><i class="bi bi-chevron-right" aria-hidden="true"></i></span><span class="permission-check-proxy" role="checkbox" tabindex="0" data-group-access aria-label="Cambiar acceso de todo el grupo"><i class="bi bi-check" aria-hidden="true"></i></span><span><strong>@grupo.Key</strong><small>@grupo.Count() opciones</small></span></summary>
                            <div class="table-responsive">
                                <table class="table align-middle permission-table" aria-describedby="@grupoId">
                                    <caption id="@grupoId" class="visually-hidden">Permisos del grupo @grupo.Key</caption>
                                    <thead><tr><th class="permission-access-column">Acceso</th><th>Opcion</th><th><button type="button" class="permission-column-toggle" data-bulk-property="ver">Ver</button></th><th><button type="button" class="permission-column-toggle" data-bulk-property="crear">Crear</button></th><th><button type="button" class="permission-column-toggle" data-bulk-property="editar">Editar</button></th><th><button type="button" class="permission-column-toggle" data-bulk-property="eliminar">Eliminar</button></th><th class="permission-state-column">Estado</th><th class="permission-action-column"></th></tr></thead>
                                    <tbody>
                                        @foreach (var permiso in grupo)
                                        {
                                            var indice = cuentaIndices[permiso.IdModuloSistema];
                                            var esSeleccionEmpresas = string.Equals(permiso.CodigoModulo, "EMPRESAS", StringComparison.OrdinalIgnoreCase);
                                            var valorVer = esSeleccionEmpresas ? "true" : ValorOverride(permiso.PuedeVerOverride);
                                            <tr data-permission-row data-search-text="@($"{permiso.CodigoModulo} {permiso.NombreModulo} {permiso.GrupoMenu}".ToLowerInvariant())" @(esSeleccionEmpresas ? "data-permission-locked=\"true\"" : null)>
                                                <td class="permission-access-column"><button type="button" class="permission-check-proxy permission-row-access" role="checkbox" data-row-access aria-label="@(esSeleccionEmpresas ? "Acceso obligatorio para seleccionar empresa" : $"Cambiar acceso a {permiso.NombreModulo}")" @(esSeleccionEmpresas ? "disabled" : null)><i class="bi bi-check" aria-hidden="true"></i></button></td>
                                                <td><input type="hidden" name="Permisos[@indice].IdModuloSistema" value="@permiso.IdModuloSistema" /><strong>@permiso.NombreModulo</strong><small>@permiso.CodigoModulo</small></td>
                                                <td><input type="hidden" name="Permisos[@indice].PuedeVer" value="@valorVer" data-permission-value="ver" /><button type="button" class="permission-state-toggle" role="checkbox" data-permission-toggle="ver" data-role="@(esSeleccionEmpresas ? "true" : permiso.PuedeVerRol.ToString().ToLowerInvariant())" aria-label="@(esSeleccionEmpresas ? "Ver obligatorio para seleccionar empresa" : $"Permiso Ver de {permiso.NombreModulo}")" @(esSeleccionEmpresas ? "disabled" : null)><i aria-hidden="true"></i></button></td>
                                                <td><input type="hidden" name="Permisos[@indice].PuedeCrear" value="@ValorOverride(permiso.PuedeCrearOverride)" data-permission-value="crear" /><button type="button" class="permission-state-toggle" role="checkbox" data-permission-toggle="crear" data-role="@permiso.PuedeCrearRol.ToString().ToLowerInvariant()" aria-label="Permiso Crear de @permiso.NombreModulo"><i aria-hidden="true"></i></button></td>
                                                <td><input type="hidden" name="Permisos[@indice].PuedeEditar" value="@ValorOverride(permiso.PuedeEditarOverride)" data-permission-value="editar" /><button type="button" class="permission-state-toggle" role="checkbox" data-permission-toggle="editar" data-role="@permiso.PuedeEditarRol.ToString().ToLowerInvariant()" aria-label="Permiso Editar de @permiso.NombreModulo"><i aria-hidden="true"></i></button></td>
                                                <td><input type="hidden" name="Permisos[@indice].PuedeEliminar" value="@ValorOverride(permiso.PuedeEliminarOverride)" data-permission-value="eliminar" /><button type="button" class="permission-state-toggle" role="checkbox" data-permission-toggle="eliminar" data-role="@permiso.PuedeEliminarRol.ToString().ToLowerInvariant()" aria-label="Permiso Eliminar de @permiso.NombreModulo"><i aria-hidden="true"></i></button></td>
                                                <td class="permission-state-column"><span class="permission-effective" data-row-effective></span></td>
                                                <td class="permission-action-column"><button type="button" class="btn btn-sm btn-link" data-restore-row title="Restaurar esta opcion al rol"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i><span class="visually-hidden">Restaurar @permiso.NombreModulo</span></button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                </div>
                <div class="permission-save-footer"><div class="permission-legend"><span><i class="permission-dot is-inherited"></i>Heredado</span><span><i class="permission-dot is-allowed"></i>Permitido</span><span><i class="permission-dot is-denied"></i>Denegado</span></div><button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle" aria-hidden="true"></i> Guardar cambios</button></div>
            </form>
        </div>

        <div id="permission-panel-contable" class="permission-tab-panel" role="tabpanel" data-permission-panel="contable">
            <form method="get" asp-action="Permisos" class="permission-company-selector">
                <input type="hidden" name="aspNetUserId" value="@Model.AspNetUserId" /><input type="hidden" name="seccion" value="contable" />
                <div><label class="form-label" for="permission-company">Empresa</label><select id="permission-company" name="idEmpresa" asp-items="ViewBag.EmpresaFiltroOptions" class="form-select"></select></div>
                <button type="submit" class="btn btn-outline-primary">Cambiar empresa</button>
            </form>
            @if (!Model.IdUsuarioEmpresaSeleccionada.HasValue)
            {
                <div class="alert alert-warning mb-0">Asigna al menos una empresa al usuario para administrar sus permisos contables.</div>
            }
            else
            {
                <form asp-action="GuardarPermisosEmpresa" method="post" data-permission-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="AspNetUserId" value="@Model.AspNetUserId" /><input type="hidden" name="IdUsuarioEmpresa" value="@Model.IdUsuarioEmpresaSeleccionada" /><input type="hidden" name="IdEmpresa" value="@Model.IdEmpresaSeleccionada" />
                    <div class="permission-toolbar"><div class="permission-search"><i class="bi bi-search" aria-hidden="true"></i><input type="search" class="form-control" placeholder="Buscar opcion contable" aria-label="Buscar opcion contable" data-permission-search /></div><button type="button" class="btn btn-outline-secondary" data-restore-all><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Restaurar todo al rol</button></div>
                    <div class="permission-tree" data-permission-tree>
                        @{ var grupoEmpresaIndice = 0; }
                        @foreach (var grupo in permisosEmpresa.GroupBy(x => string.IsNullOrWhiteSpace(x.GrupoMenu) ? "Otros" : x.GrupoMenu))
                        {
                            var grupoId = $"permission-company-group-{grupoEmpresaIndice++}";
                            <details class="permission-group" open data-permission-group>
                                <summary><span class="permission-group-chevron"><i class="bi bi-chevron-right" aria-hidden="true"></i></span><span class="permission-check-proxy" role="checkbox" tabindex="0" data-group-access aria-label="Cambiar acceso de todo el grupo"><i class="bi bi-check" aria-hidden="true"></i></span><span><strong>@grupo.Key</strong><small>@grupo.Count() opciones</small></span></summary>
                                <div class="table-responsive">
                                    <table class="table align-middle permission-table" aria-describedby="@grupoId">
                                        <caption id="@grupoId" class="visually-hidden">Permisos del grupo @grupo.Key</caption>
                                        <thead><tr><th class="permission-access-column">Acceso</th><th>Opcion</th><th><button type="button" class="permission-column-toggle" data-bulk-property="ver">Ver</button></th><th><button type="button" class="permission-column-toggle" data-bulk-property="crear">Crear</button></th><th><button type="button" class="permission-column-toggle" data-bulk-property="editar">Editar</button></th><th><button type="button" class="permission-column-toggle" data-bulk-property="eliminar">Eliminar</button></th><th class="permission-state-column">Estado</th><th class="permission-action-column"></th></tr></thead>
                                        <tbody>
                                            @foreach (var permiso in grupo)
                                            {
                                                var indice = empresaIndices[permiso.IdModuloSistema];
                                                <tr data-permission-row data-search-text="@($"{permiso.CodigoModulo} {permiso.NombreModulo} {permiso.GrupoMenu}".ToLowerInvariant())">
                                                    <td class="permission-access-column"><button type="button" class="permission-check-proxy permission-row-access" role="checkbox" data-row-access aria-label="Cambiar acceso a @permiso.NombreModulo"><i class="bi bi-check" aria-hidden="true"></i></button></td>
                                                    <td><input type="hidden" name="Permisos[@indice].IdModuloSistema" value="@permiso.IdModuloSistema" /><strong>@permiso.NombreModulo</strong><small>@permiso.CodigoModulo</small></td>
                                                    <td><input type="hidden" name="Permisos[@indice].PuedeVer" value="@ValorOverride(permiso.PuedeVerOverride)" data-permission-value="ver" /><button type="button" class="permission-state-toggle" role="checkbox" data-permission-toggle="ver" data-role="@permiso.PuedeVerRol.ToString().ToLowerInvariant()" aria-label="Permiso Ver de @permiso.NombreModulo"><i aria-hidden="true"></i></button></td>
                                                    <td><input type="hidden" name="Permisos[@indice].PuedeCrear" value="@ValorOverride(permiso.PuedeCrearOverride)" data-permission-value="crear" /><button type="button" class="permission-state-toggle" role="checkbox" data-permission-toggle="crear" data-role="@permiso.PuedeCrearRol.ToString().ToLowerInvariant()" aria-label="Permiso Crear de @permiso.NombreModulo"><i aria-hidden="true"></i></button></td>
                                                    <td><input type="hidden" name="Permisos[@indice].PuedeEditar" value="@ValorOverride(permiso.PuedeEditarOverride)" data-permission-value="editar" /><button type="button" class="permission-state-toggle" role="checkbox" data-permission-toggle="editar" data-role="@permiso.PuedeEditarRol.ToString().ToLowerInvariant()" aria-label="Permiso Editar de @permiso.NombreModulo"><i aria-hidden="true"></i></button></td>
                                                    <td><input type="hidden" name="Permisos[@indice].PuedeEliminar" value="@ValorOverride(permiso.PuedeEliminarOverride)" data-permission-value="eliminar" /><button type="button" class="permission-state-toggle" role="checkbox" data-permission-toggle="eliminar" data-role="@permiso.PuedeEliminarRol.ToString().ToLowerInvariant()" aria-label="Permiso Eliminar de @permiso.NombreModulo"><i aria-hidden="true"></i></button></td>
                                                    <td class="permission-state-column"><span class="permission-effective" data-row-effective></span></td>
                                                    <td class="permission-action-column"><button type="button" class="btn btn-sm btn-link" data-restore-row title="Restaurar esta opcion al rol"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i><span class="visually-hidden">Restaurar @permiso.NombreModulo</span></button></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </details>
                        }
                    </div>
                    <div class="permission-save-footer"><div class="permission-legend"><span><i class="permission-dot is-inherited"></i>Heredado</span><span><i class="permission-dot is-allowed"></i>Permitido</span><span><i class="permission-dot is-denied"></i>Denegado</span></div><button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle" aria-hidden="true"></i> Guardar cambios</button></div>
                </form>
            }
        </div>
    </section>
</section>

@section Scripts {
    <script>
        (() => {
            const page = document.querySelector('[data-permission-page]');
            if (!page) return;
            const properties = ['ver', 'crear', 'editar', 'eliminar'];
            const normalize = value => value === 'true' || value === 'false' ? value : '';
            const inputFor = toggle => toggle.closest('td').querySelector(`[data-permission-value="${toggle.dataset.permissionToggle}"]`);
            const effective = toggle => {
                const state = normalize(inputFor(toggle).value);
                return state === '' ? toggle.dataset.role === 'true' : state === 'true';
            };
            function paintToggle(toggle) {
                const state = normalize(inputFor(toggle).value);
                const roleAllowed = toggle.dataset.role === 'true';
                toggle.dataset.state = state || 'inherited';
                toggle.classList.toggle('is-allowed', state === 'true');
                toggle.classList.toggle('is-denied', state === 'false');
                toggle.classList.toggle('is-inherited', state === '');
                toggle.setAttribute('aria-checked', state === '' ? 'mixed' : (state === 'true').toString());
                toggle.title = state === '' ? `Heredado del rol: ${roleAllowed ? 'Permitido' : 'Denegado'}` : (state === 'true' ? 'Permitido expresamente' : 'Denegado expresamente');
                toggle.querySelector('i').className = state === '' ? 'bi bi-dash' : (state === 'true' ? 'bi bi-check-lg' : 'bi bi-x-lg');
            }
            function updateGroup(group) {
                if (!group) return;
                const rows = [...group.querySelectorAll('[data-permission-row]')].filter(row => !row.hidden);
                const allowed = rows.filter(row => effective(row.querySelector('[data-permission-toggle="ver"]'))).length;
                const access = group.querySelector(':scope > summary [data-group-access]');
                access.classList.toggle('is-checked', rows.length > 0 && allowed === rows.length);
                access.classList.toggle('is-mixed', allowed > 0 && allowed < rows.length);
                access.setAttribute('aria-checked', allowed > 0 && allowed < rows.length ? 'mixed' : (rows.length > 0 && allowed === rows.length).toString());
            }
            function updateRow(row) {
                row.querySelectorAll('[data-permission-toggle]').forEach(paintToggle);
                const canView = effective(row.querySelector('[data-permission-toggle="ver"]'));
                const access = row.querySelector('[data-row-access]');
                access.classList.toggle('is-checked', canView);
                access.setAttribute('aria-checked', canView.toString());
                const status = row.querySelector('[data-row-effective]');
                status.textContent = canView ? 'Con acceso' : 'Sin acceso';
                status.classList.toggle('is-allowed', canView);
                status.classList.toggle('is-denied', !canView);
                updateGroup(row.closest('[data-permission-group]'));
            }
            function setState(row, property, state) {
                const toggle = row.querySelector(`[data-permission-toggle="${property}"]`);
                if (!toggle) return;
                if (row.dataset.permissionLocked === 'true' && property === 'ver') {
                    inputFor(toggle).value = 'true';
                    paintToggle(toggle);
                    updateRow(row);
                    return;
                }
                inputFor(toggle).value = normalize(state);
                paintToggle(toggle);
                if (property !== 'ver' && state === 'true') setState(row, 'ver', 'true');
                if (property === 'ver' && state === 'false') {
                    properties.filter(x => x !== 'ver').forEach(x => {
                        const child = row.querySelector(`[data-permission-toggle="${x}"]`);
                        if (child) { inputFor(child).value = 'false'; paintToggle(child); }
                    });
                }
                updateRow(row);
            }
            function activateTab(name) {
                page.querySelectorAll('[data-permission-tab]').forEach(tab => {
                    const active = tab.dataset.permissionTab === name;
                    tab.classList.toggle('is-active', active);
                    tab.setAttribute('aria-selected', active.toString());
                    tab.tabIndex = active ? 0 : -1;
                });
                page.querySelectorAll('[data-permission-panel]').forEach(panel => panel.hidden = panel.dataset.permissionPanel !== name);
            }
            page.querySelectorAll('[data-permission-tab]').forEach(tab => tab.addEventListener('click', () => activateTab(tab.dataset.permissionTab)));
            page.querySelectorAll('[data-permission-form]').forEach(form => {
                form.querySelectorAll('[data-permission-row]').forEach(updateRow);
                form.addEventListener('click', event => {
                    const toggle = event.target.closest('[data-permission-toggle]');
                    if (toggle) {
                        const state = normalize(inputFor(toggle).value);
                        setState(toggle.closest('[data-permission-row]'), toggle.dataset.permissionToggle, state === '' ? 'true' : (state === 'true' ? 'false' : ''));
                        return;
                    }
                    const rowAccess = event.target.closest('[data-row-access]');
                    if (rowAccess) {
                        const row = rowAccess.closest('[data-permission-row]');
                        setState(row, 'ver', effective(row.querySelector('[data-permission-toggle="ver"]')) ? 'false' : 'true');
                        return;
                    }
                    const groupAccess = event.target.closest('[data-group-access]');
                    if (groupAccess) {
                        event.preventDefault();
                        const group = groupAccess.closest('[data-permission-group]');
                        const rows = [...group.querySelectorAll('[data-permission-row]')].filter(row => !row.hidden);
                        const enable = !rows.every(row => effective(row.querySelector('[data-permission-toggle="ver"]')));
                        rows.forEach(row => setState(row, 'ver', enable ? 'true' : 'false'));
                        return;
                    }
                    const bulk = event.target.closest('[data-bulk-property]');
                    if (bulk) {
                        const rows = [...bulk.closest('[data-permission-group]').querySelectorAll('[data-permission-row]')].filter(row => !row.hidden);
                        const property = bulk.dataset.bulkProperty;
                        const enable = !rows.every(row => effective(row.querySelector(`[data-permission-toggle="${property}"]`)));
                        rows.forEach(row => setState(row, property, enable ? 'true' : 'false'));
                        return;
                    }
                    const restoreRow = event.target.closest('[data-restore-row]');
                    if (restoreRow) {
                        const row = restoreRow.closest('[data-permission-row]');
                        properties.forEach(property => setState(row, property, ''));
                        return;
                    }
                    if (event.target.closest('[data-restore-all]')) form.querySelectorAll('[data-permission-row]').forEach(row => properties.forEach(property => setState(row, property, '')));
                });
                form.querySelectorAll('[data-group-access]').forEach(control => control.addEventListener('keydown', event => {
                    if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); control.click(); }
                }));
                const search = form.querySelector('[data-permission-search]');
                search?.addEventListener('input', () => {
                    const term = search.value.trim().toLowerCase();
                    form.querySelectorAll('[data-permission-group]').forEach(group => {
                        const rows = [...group.querySelectorAll('[data-permission-row]')];
                        rows.forEach(row => row.hidden = term.length > 0 && !row.dataset.searchText.includes(term));
                        group.hidden = rows.every(row => row.hidden);
                        if (term && !group.hidden) group.open = true;
                        updateGroup(group);
                    });
                });
            });
            activateTab(page.dataset.activeTab === 'contable' ? 'contable' : 'general');
        })();
    </script>
}
