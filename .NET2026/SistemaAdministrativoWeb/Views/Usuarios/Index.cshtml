@model SistemaAdministrativoWeb.ViewModels.Usuarios.UsuariosIndexViewModel
@* Firma: FRANCO LARA - 10/07/2026 | Crea la vista General > Usuarios para registrar o vincular accesos a la cuenta administradora y asignarles empresas operativas. *@
@* Firma: FRANCO LARA - 12/07/2026 | Limpia telefono y contrasena temporal al abrir el formulario, agrega visor de contrasena y retira las opciones de cuenta o empresa predeterminada para forzar la seleccion posterior de empresa. *@
@* Firma: FRANCO LARA - 25/07/2026 | Limita el ancho, uniformiza controles y simplifica la cabecera de la gestion de usuarios. *@
@* Firma: FRANCO LARA - 31/07/2026 | Adopta el patron global de titulo y subtitulos administrativos con iconos y degradado verde. *@
@{
    ViewData["Title"] = "Usuarios";
    ViewData["AdminShell"] = true;
    var limpiarCamposIniciales = ViewData.ModelState.IsValid;
}

<section class="dashboard-shell subscription-shell dashboard-shell-contained dashboard-shell-contained-form">
    <section class="dashboard-hero">
        <div>
            <span class="dashboard-kicker">General</span>
            <h1 class="app-page-title"><i class="bi bi-people" aria-hidden="true"></i><span>Usuarios</span></h1>
            <p>Gestiona los accesos de la cuenta administradora, define el rol operativo y selecciona a que empresas podra entrar cada usuario.</p>
        </div>
        <article class="dashboard-status-card">
            <span>Cuenta administradora</span>
            <strong>@Model.NombreCuenta</strong>
            <small>Usuarios vinculados: @Model.Usuarios.Count</small>
        </article>
    </section>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <section class="workspace-section" aria-labelledby="users-registration-title">
        <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
            {
                Id = "users-registration-title",
                Category = "Alta de acceso",
                Title = "Registrar o vincular usuario",
                Description = "Si el correo aún no existe en Identity, el sistema crea el acceso con contraseña temporal y luego lo vincula a la cuenta administradora.",
                IconClass = "bi bi-person-plus"
            })" />

        <form asp-action="GuardarUsuario" method="post" class="workspace-account-form" autocomplete="off" data-clear-sensitive-fields="@limpiarCamposIniciales.ToString().ToLowerInvariant()">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Formulario.NombreCompleto" class="form-label"></label>
                    <input asp-for="Formulario.NombreCompleto" class="form-control" />
                    <span asp-validation-for="Formulario.NombreCompleto" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Formulario.Correo" class="form-label"></label>
                    <input asp-for="Formulario.Correo" class="form-control" />
                    <span asp-validation-for="Formulario.Correo" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Formulario.Telefono" class="form-label"></label>
                    <input asp-for="Formulario.Telefono" class="form-control" autocomplete="off" inputmode="tel" />
                    <span asp-validation-for="Formulario.Telefono" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Formulario.PasswordTemporal" class="form-label"></label>
                    <div class="auth-password-field">
                        <input asp-for="Formulario.PasswordTemporal" class="form-control pe-5" autocomplete="new-password" />
                        <button type="button"
                                class="auth-password-toggle"
                                data-password-toggle
                                data-password-target="Formulario_PasswordTemporal"
                                aria-label="Mostrar contrasena"
                                aria-pressed="false">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Formulario.PasswordTemporal" class="text-danger"></span>
                    <small class="text-muted">Solo se usa si el correo aun no tiene cuenta creada. Minimo 6 caracteres, con mayuscula, minuscula, numero y caracter especial.</small>
                </div>
                <div class="col-md-4">
                    <label asp-for="Formulario.RolCuenta" class="form-label"></label>
                    <select asp-for="Formulario.RolCuenta" asp-items="ViewBag.RoleOptions" class="form-select"></select>
                    <span asp-validation-for="Formulario.RolCuenta" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4">
                <label class="form-label">Empresas asignadas</label>
                <div class="row g-2">
                    @for (var i = 0; i < Model.EmpresasDisponibles.Count; i++)
                    {
                        var empresa = Model.EmpresasDisponibles.ElementAt(i);
                        <div class="col-md-6">
                            <label class="workspace-check workspace-account-option w-100">
                                <input type="checkbox" class="form-check-input mt-1" name="Formulario.EmpresasSeleccionadas" value="@empresa.IdEmpresa" @(Model.Formulario.EmpresasSeleccionadas.Contains(empresa.IdEmpresa) ? "checked" : null) />
                                <span>
                                    <strong>@empresa.CodigoEmpresa</strong><br />
                                    <small>@empresa.RazonSocial</small>
                                </span>
                            </label>
                        </div>
                    }
                </div>
            </div>

            <div class="workspace-actions mt-4">
                <button type="submit" class="btn btn-primary">Guardar usuario</button>
            </div>
        </form>
    </section>

    <section class="workspace-section" aria-labelledby="users-list-title">
        <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
            {
                Id = "users-list-title",
                Category = "Accesos vigentes",
                Title = "Usuarios de la cuenta",
                Description = "Desde la acción Permisos puedes ajustar las empresas asignadas y las excepciones por módulo.",
                IconClass = "bi bi-person-check"
            })" />

        <div class="table-responsive workspace-table-wrap">
            <table class="table table-sm align-middle app-table workspace-table">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Rol</th>
                        <th>Empresas</th>
                        <th>Cuenta predet.</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model.Usuarios)
                    {
                        <tr>
                            <td>
                                <strong>@usuario.NombreCompleto</strong><br />
                                <small>@usuario.CorreoUsuario</small>
                            </td>
                            <td>@usuario.RolCuenta</td>
                            <td>
                                <strong>@usuario.CantidadEmpresasAsignadas</strong><br />
                                <small>@usuario.EmpresasAsignadas</small>
                            </td>
                            <td>@(usuario.EsCuentaPredeterminada ? "Si" : "No")</td>
                            <td class="text-end">
                                <a asp-action="Permisos" asp-route-aspNetUserId="@usuario.AspNetUserId" class="btn btn-sm btn-outline-primary">Permisos</a>
                                <form asp-action="Desactivar" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="aspNetUserId" value="@usuario.AspNetUserId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.querySelector("form[data-clear-sensitive-fields]");
            if (!form) {
                return;
            }

            if (form.dataset.clearSensitiveFields === "true") {
                const clearFields = () => {
                    ["Formulario_Telefono", "Formulario_PasswordTemporal"].forEach((id) => {
                        const field = document.getElementById(id);
                        if (field) {
                            field.value = "";
                        }
                    });
                };

                window.addEventListener("pageshow", () => window.setTimeout(clearFields, 120), { once: true });
            }

            document.querySelectorAll("[data-password-toggle]").forEach((button) => {
                button.addEventListener("click", () => {
                    const targetId = button.getAttribute("data-password-target");
                    const field = targetId ? document.getElementById(targetId) : null;
                    const icon = button.querySelector("i");
                    if (!field || !icon) {
                        return;
                    }

                    const visible = field.type === "text";
                    field.type = visible ? "password" : "text";
                    icon.className = visible ? "bi bi-eye" : "bi bi-eye-slash";
                    button.setAttribute("aria-label", visible ? "Mostrar contrasena" : "Ocultar contrasena");
                    button.setAttribute("aria-pressed", String(!visible).toLowerCase());
                });
            });
        })();
    </script>
}
