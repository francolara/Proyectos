@model SistemaAdministrativoWeb.ViewModels.Contabilidad.ListadoImpresionViewModel
@* Firma: FRANCO LARA - 19/11/2026 | Comparte la vista imprimible de los listados de Registro y Mantenimiento. *@

@{
    Layout = "_ReporteImpresionLayout";
    ViewData["Title"] = Model.Titulo;
    ViewData["ReporteVertical"] = !Model.Horizontal;
    ViewData["MostrarAccionesReporte"] = Model.Filas.Count > 0;
}

<article class="balance-document" aria-labelledby="balance-document-title">
    @await Component.InvokeAsync("ReporteEmpresa", new { empresaNombre = Model.EmpresaNombre })

    <section class="balance-document-filters">
        <h1 id="balance-document-title">@Model.Titulo</h1>
        <dl data-report-csv-context>
            @foreach (var filtro in Model.Filtros)
            {
                <div><dt>@filtro.Etiqueta</dt><dd>@(string.IsNullOrWhiteSpace(filtro.Valor) ? "Todos" : filtro.Valor)</dd></div>
            }
            <div><dt>Registros</dt><dd>@Model.Filas.Count</dd></div>
        </dl>
    </section>

    @if (Model.Filas.Count == 0)
    {
        <p>No se encontraron registros para los filtros seleccionados.</p>
    }
    else
    {
        <div class="balance-document-scroll" tabindex="0" role="region" aria-label="@Model.Titulo">
            <table class="balance-document-table">
                <thead>
                    <tr>
                        @foreach (var columna in Model.Columnas)
                        {
                            <th scope="col">@columna</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in Model.Filas)
                    {
                        <tr>
                            @for (var i = 0; i < fila.Length; i++)
                            {
                                <td class="@(i >= Model.PrimeraColumnaImporte ? "balance-amount" : null)">@fila[i]</td>
                            }
                        </tr>
                    }
                </tbody>
                @if (Model.Totales is { Count: > 0 } totales)
                {
                    <tfoot>
                        @foreach (var total in totales)
                        {
                            <tr>
                                @for (var i = 0; i < total.Length; i++)
                                {
                                    <td class="@(i >= Model.PrimeraColumnaImporte ? "balance-amount" : null)">@total[i]</td>
                                }
                            </tr>
                        }
                    </tfoot>
                }
            </table>
        </div>
    }
</article>
