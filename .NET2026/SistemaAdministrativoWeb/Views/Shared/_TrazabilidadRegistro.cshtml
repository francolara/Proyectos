@model SistemaAdministrativoWeb.ViewModels.IRegistroTrazable
@* Firma: FRANCO LARA - 19/09/2026 | Componente reutilizable de trazabilidad para formularios de edición. *@

<aside class="workspace-trazabilidad-registro" aria-label="Trazabilidad del registro">
    <div class="workspace-trazabilidad-registro-title"><i class="bi bi-clock-history" aria-hidden="true"></i><span>Trazabilidad del registro</span></div>
    <div class="workspace-trazabilidad-registro-grid">
        <div><span>Usuario de registro</span><strong>@(Model.UsuarioCreacion ?? "Sin registro")</strong></div>
        <div><span>Fecha de registro</span><strong>@(Model.FechaRegistro?.ToString("dd/MM/yyyy HH:mm") ?? "Sin registro")</strong></div>
        <div><span>Usuario de actualización</span><strong>@(Model.UsuarioActualizacion ?? "Sin actualizaciones")</strong></div>
        <div><span>Fecha de actualización</span><strong>@(Model.FechaActualizacion?.ToString("dd/MM/yyyy HH:mm") ?? "Sin actualizaciones")</strong></div>
    </div>
</aside>
