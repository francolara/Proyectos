@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav align-items-lg-center gap-lg-2">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <span class="nav-link text-dark">@(User.Identity?.Name ?? "Usuario")</span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="btn btn-link nav-link text-dark p-0">Cerrar sesion</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="app-public-register-link" asp-area="Identity" asp-page="/Account/Register">Crear cuenta</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Login">Ingresar</a>
    </li>
}
</ul>
