@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@* Firma: FRANCO LARA - 31/08/2026 | Presenta la sesion publica como un bloque de cuenta con avatar, correo y salida diferenciada. *@
@* Firma: FRANCO LARA - 17/09/2026 | Uniformiza los accesos publicos de sesion y registro como botones con iconos, siguiendo la referencia visual indicada. *@

@{
    var correoSesion = User.Identity?.Name?.Trim() ?? "Usuario";
    var inicialSesion = string.IsNullOrWhiteSpace(correoSesion)
        ? "U"
        : correoSesion[..1].ToUpperInvariant();
}

@if (SignInManager.IsSignedIn(User))
{
    <div class="app-public-account" aria-label="Cuenta de usuario">
        <span class="app-public-account-avatar" aria-hidden="true">@inicialSesion</span>
        <span class="app-public-account-meta">
            <small>Sesion activa</small>
            <strong title="@correoSesion">@correoSesion</strong>
        </span>
        <form class="app-public-logout-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="app-public-logout" aria-label="Cerrar sesion">
                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                <span>Cerrar sesion</span>
            </button>
        </form>
    </div>
}
else
{
    <ul class="navbar-nav align-items-lg-center app-public-auth-actions">
        <li class="nav-item">
            <a class="app-public-auth-link app-public-login-link" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                <span>Iniciar sesion</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="app-public-auth-link app-public-register-cta" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus" aria-hidden="true"></i>
                <span>Registrarse</span>
            </a>
        </li>
    </ul>
}
