@using Microsoft.Extensions.Options
@using SistemaAdministrativoWeb.Configuration
@inject IOptions<BusinessInformationOptions> BusinessInformationOptionsAccessor
@{
    var business = BusinessInformationOptionsAccessor.Value;
    var whatsappUrl = string.IsNullOrWhiteSpace(business.WhatsAppNumber)
        ? string.Empty
        : $"https://wa.me/{business.WhatsAppNumber}";
}

<div class="fralsecont-legal-contact">
    <strong>@business.LegalName</strong>
    <span>RUC @business.Ruc</span>
    <span>
        Correo:
        <a href="mailto:@business.SupportEmail">@business.SupportEmail</a>
    </span>
    @if (!string.IsNullOrWhiteSpace(whatsappUrl))
    {
        <span>
            WhatsApp:
            <a href="@whatsappUrl" target="_blank" rel="noopener noreferrer">@business.WhatsAppDisplay</a>
        </span>
    }
    <span>Horario: @business.SupportHours</span>
</div>
