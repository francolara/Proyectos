@using Microsoft.AspNetCore.Identity
@using SistemaAdministrativoWeb.Infrastructure.Assets
@using SistemaAdministrativoWeb.Infrastructure.Empresas
@using SistemaAdministrativoWeb.Infrastructure.Security
@inject ICurrentCompanyAccessor CurrentCompanyAccessor
@inject IModulePermissionService ModulePermissionService
@inject UserManager<IdentityUser> UserManager
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@* Firma: FRANCO LARA - 07/07/2026 | Agrega y reordena el bloque Reportes del menu administrativo con Balance de comprobacion, Analisis de cuentas, Libro Diario, Libro Mayor, Registro de ventas, Registro de compras y Libros Electronicos. *@
@* Firma: FRANCO LARA - 08/07/2026 | Reemplaza la tarjeta redundante del panel por un selector persistente de modo oscuro, agrega Mi suscripcion y Ayuda al menu General e incorpora acceso contextual de ayuda por modulo. *@
@* Firma: FRANCO LARA - 10/07/2026 | Ajusta el branding publico para alinear portada, login y registro con la nueva presentacion comercial de FralseCont, separa Fralse y Cont en dos colores, agrega soporte para metadatos basicos, enlaces legales en el footer y la burbuja publica de WhatsApp, e incorpora Usuarios y Configuracion al bloque General del menu administrativo. *@
@* Firma: FRANCO LARA - 25/07/2026 | Integra el logo publico de Fralse Tech desde el bucket Cloudflare configurado en User Secrets, recorta su espacio blanco interno para mejorar su presencia y conserva el icono local como respaldo. *@
@* Firma: FRANCO LARA - 26/08/2026 | Reordena el menu Proceso segun la secuencia operativa solicitada y lee los recursos publicos desde la configuracion identificada con el prefijo FRALSECONT_. *@
@* Firma: FRANCO LARA - 27/08/2026 | Agrega al panel SuperAdmin el acceso y las pestañas laterales de Plan de cuentas, Cuentas destino, Asignaciones, Origenes y Configuracion de maestros contables. *@
@* Firma: FRANCO LARA - 31/08/2026 | Versiona el logotipo remoto con la clave global de recursos para evitar cache obsoleta. *@
<!DOCTYPE html>
@{
    var adminShell = ViewData["AdminShell"] as bool? ?? false;
    var platformShell = ViewData["PlatformShell"] as bool? ?? false;
    var pageTitle = ViewData["Title"]?.ToString() ?? "Sistema Administrativo";
    var fullTitle = pageTitle.Contains("FralseCont", StringComparison.OrdinalIgnoreCase)
        ? pageTitle
        : $"{pageTitle} - FralseCont";
    var metaDescription = ViewData["MetaDescription"]?.ToString() ?? "Sistema contable web para empresas y contadores.";
    var publicBrandLogoUrl = PublicAssetUrlBuilder.Build(Configuration, "Logo/LogoFralseTech.webp");
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    var userEmail = User.Identity?.Name ?? "usuario@sisadm.local";
    var userDisplayName = userEmail;
    if (User.Identity?.IsAuthenticated == true)
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (!string.IsNullOrWhiteSpace(currentUser?.Email))
        {
            userEmail = currentUser.Email!.Trim();
        }
    }

    bool IsActiveController(params string[] controllers) =>
        controllers.Any(x => string.Equals(x, currentController, StringComparison.OrdinalIgnoreCase));

    bool IsActivePath(params string[] segments) =>
        segments.Any(x => currentPath.StartsWith($"/{x}", StringComparison.OrdinalIgnoreCase));

    var maestroContableOpen = string.Equals(currentController, "MaestroContable", StringComparison.OrdinalIgnoreCase);

    bool IsMaestroContableAction(params string[] actions) =>
        maestroContableOpen && actions.Any(x => string.Equals(x, currentAction, StringComparison.OrdinalIgnoreCase));

    string ResolverModuloAyuda()
    {
        if (string.Equals(currentController, "Panel", StringComparison.OrdinalIgnoreCase))
        {
            return "DASHBOARD";
        }

        if (string.Equals(currentController, "EmpresaContexto", StringComparison.OrdinalIgnoreCase))
        {
            return "EMPRESAS";
        }

        if (string.Equals(currentController, "MiSuscripcion", StringComparison.OrdinalIgnoreCase))
        {
            return "MISUSCRIPCION";
        }

        if (string.Equals(currentController, "Usuarios", StringComparison.OrdinalIgnoreCase))
        {
            return "USUARIOS";
        }

        if (string.Equals(currentController, "Configuracion", StringComparison.OrdinalIgnoreCase))
        {
            return "CONFIGURACION";
        }

        if (string.Equals(currentController, "Ayuda", StringComparison.OrdinalIgnoreCase))
        {
            return "AYUDA";
        }

        if (string.Equals(currentController, "Proceso", StringComparison.OrdinalIgnoreCase))
        {
            return currentAction.ToUpperInvariant() switch
            {
                "DIFERENCIACAMBIO" => "DIFERENCIACAMBIO",
                "AJUSTECUENTA" => "AJUSTECUENTA",
                "ASIENTOAPERTURA" => "ASIENTOAPERTURA",
                "ASIENTOCIERRE" => "ASIENTOCIERRE",
                "CERRARPERIODO" => "CERRARPERIODO",
                _ => "DIFERENCIACAMBIO"
            };
        }

        if (string.Equals(currentController, "Reporte", StringComparison.OrdinalIgnoreCase))
        {
            return currentAction.ToUpperInvariant() switch
            {
                "ANALISISCUENTAS" => "ANALISISCUENTAS",
                "LIBRODIARIO" => "LIBRODIARIO",
                "LIBROMAYOR" => "LIBROMAYOR",
                "REGISTROVENTAS" => "REGISTROVENTAS",
                "REGISTROCOMPRAS" => "REGISTROCOMPRAS",
                "BALANCECOMPROBACION" => "BALANCECOMPROBACION",
                _ => "ANALISISCUENTAS"
            };
        }

        if (string.Equals(currentController, "LibroElectronico", StringComparison.OrdinalIgnoreCase))
        {
            return "LIBROELECTRONICO";
        }

        return currentController.Replace(" ", string.Empty, StringComparison.Ordinal).ToUpperInvariant();
    }

    var helpModuleKey = ResolverModuloAyuda();
    var canDashboard = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "DASHBOARD", Context.RequestAborted);
    var canEmpresas = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "EMPRESAS", Context.RequestAborted);
    var canUsuarios = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "USUARIOS", Context.RequestAborted);
    var canConfiguracion = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "CONFIGURACION", Context.RequestAborted);
    var canMiSuscripcion = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "MISUSCRIPCION", Context.RequestAborted);
    var canAyuda = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "AYUDA", Context.RequestAborted);
    var canPlanCuenta = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "PLANCUENTA", Context.RequestAborted);
    var canCentroCosto = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "CENTROCOSTO", Context.RequestAborted);
    var canCuentaCorriente = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "CUENTACORRIENTE", Context.RequestAborted);
    var canPersonas = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "PERSONAS", Context.RequestAborted);
    var canTipoCambio = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "TIPOCAMBIO", Context.RequestAborted);
    var canOrigenes = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "ORIGENES", Context.RequestAborted);
    var canCuentasDestino = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "CUENTASDESTINO", Context.RequestAborted);
    var canConfigContable = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "CONFIGCONTABLE", Context.RequestAborted);
    var canAsientos = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "ASIENTOS", Context.RequestAborted);
    var canCompras = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "COMPRAS", Context.RequestAborted);
    var canVentas = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "VENTAS", Context.RequestAborted);
    var canCajaBancos = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "CAJABANCOS", Context.RequestAborted);
    var canTransferencias = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "TRANSFERENCIAS", Context.RequestAborted);
    var canAplicaciones = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "APLICACIONES", Context.RequestAborted);
    var canProcesos = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "PROCESOS", Context.RequestAborted);
    var canReportes = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "REPORTES", Context.RequestAborted);
    var canLibroElectronico = adminShell && await ModulePermissionService.CanAccessModuleAsync(User, "LIBROELECTRONICO", Context.RequestAborted);
    var showContextHelp = adminShell && canAyuda && !string.Equals(currentController, "Ayuda", StringComparison.OrdinalIgnoreCase);

    var generalOpen = IsActiveController("Panel", "Usuarios", "Configuracion", "MiSuscripcion", "Ayuda");
    var mantenimientoOpen = IsActiveController("PlanCuenta", "CentroCosto", "CuentaCorriente", "Persona", "TipoCambio", "Origen", "CuentaDestinoRegla", "ConfiguracionContabilizacion")
        || IsActivePath("PlanCuenta", "CentroCosto", "CuentaCorriente", "Persona", "TipoCambio", "Origen", "CuentaDestinoRegla", "ConfiguracionContabilizacion");
    var registroOpen = IsActiveController("Asiento", "Compra", "Venta", "CajaBanco", "TransferenciaCuenta", "Aplicacion")
        || IsActivePath("Asiento", "Compra", "Venta", "CajaBanco", "TransferenciaCuenta", "Aplicacion");
    var procesoOpen = IsActiveController("Proceso") || IsActivePath("Proceso");
    var reportesOpen = IsActiveController("Reporte", "LibroElectronico") || IsActivePath("Reporte", "LibroElectronico");
    var showGeneralMenu = canDashboard || canUsuarios || canConfiguracion || canMiSuscripcion || canAyuda;
    var showMantenimientoMenu = canPlanCuenta || canCentroCosto || canCuentaCorriente || canPersonas || canTipoCambio || canOrigenes || canCuentasDestino || canConfigContable;
    var showRegistroMenu = canAsientos || canCompras || canVentas || canCajaBancos || canTransferencias || canAplicaciones;
    var showProcesoMenu = canProcesos;
    var showReportesMenu = canReportes || canLibroElectronico;
}
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    <meta name="description" content="@metaDescription" />
    <script>
        (() => {
            const allowStoredTheme = @((adminShell || platformShell).ToString().ToLowerInvariant());

            try {
                const theme = allowStoredTheme && localStorage.getItem("sisadm-theme") === "dark" ? "dark" : "light";
                document.documentElement.setAttribute("data-theme", theme);
                document.documentElement.setAttribute("data-bs-theme", theme);
            } catch {
                document.documentElement.setAttribute("data-theme", "light");
                document.documentElement.setAttribute("data-bs-theme", "light");
            }
        })();
    </script>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaAdministrativoWeb.styles.css" asp-append-version="true" />
</head>
<body class="app-body @(adminShell || platformShell ? "app-shell-body" : "app-public-body")">
    @if (!adminShell && !platformShell)
    {
        <header class="app-public-header">
            <nav class="navbar navbar-expand-lg navbar-light">
                <div class="container">
                    <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        @if (!string.IsNullOrWhiteSpace(publicBrandLogoUrl))
                        {
                            <span class="app-brand-logo-frame">
                                <img class="app-brand-logo" src="@publicBrandLogoUrl" alt="Fralse Tech S.A.C." />
                            </span>
                        }
                        else
                        {
                            <span class="app-brand-mark"><i class="bi bi-journal-text"></i></span>
                        }
                        <span>
                            <strong><span>Fralse</span><span class="app-brand-name-accent">Cont</span></strong>
                            <small>Sistema contable web para empresas y contadores</small>
                            <small>Powered by Fralse Tech S.A.C.</small>
                        </span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div id="mainNav" class="collapse navbar-collapse">
                        <div class="me-auto"></div>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>
    }

    @if (adminShell)
    {
        <div class="app-shell">
            <aside class="app-sidebar">
                <section class="app-sidebar-theme-card">
                    <div class="app-sidebar-theme-copy">
                        <span>Apariencia</span>
                        <strong class="app-theme-label" data-theme-label aria-live="polite"></strong>
                        <small>Cambia el tema del sistema y conserva la preferencia.</small>
                    </div>
                    <button type="button" class="app-theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Alternar modo oscuro">
                        <span class="app-theme-toggle-track">
                            <i class="bi bi-sun-fill app-theme-icon app-theme-icon-sun"></i>
                            <span class="app-theme-toggle-thumb"></span>
                            <i class="bi bi-moon-stars-fill app-theme-icon app-theme-icon-moon"></i>
                        </span>
                    </button>
                </section>
                <div class="app-sidebar-company-chip">
                    <span>Empresa activa</span>
                    <strong>@(CurrentCompanyAccessor.EmpresaNombre ?? "Seleccione empresa")</strong>
                    @if (canEmpresas)
                    {
                        <a class="app-sidebar-company-link @(IsActiveController("EmpresaContexto") ? "active" : string.Empty)" asp-controller="EmpresaContexto" asp-action="Index">
                            <i class="bi bi-buildings"></i>
                            <span>Empresas</span>
                        </a>
                    }
                </div>
                <nav class="app-sidebar-nav app-sidebar-nav-accordion">
                    @if (showGeneralMenu)
                    {
                    <section class="app-sidebar-group app-sidebar-group-accordion">
                        <button class="app-sidebar-group-toggle @(generalOpen ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-general" aria-expanded="@(generalOpen.ToString().ToLowerInvariant())" aria-controls="sidebar-general">
                            <span>General</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div id="sidebar-general" class="collapse @(generalOpen ? "show" : string.Empty)">
                            <div class="app-sidebar-group-body">
                                @if (canDashboard)
                                {
                                <a class="app-sidebar-link @(IsActiveController("Panel") ? "active" : string.Empty)" asp-controller="Panel" asp-action="Index"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                                }
                                @if (canUsuarios)
                                {
                                <a class="app-sidebar-link @(IsActiveController("Usuarios") ? "active" : string.Empty)" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-people"></i><span>Usuarios</span></a>
                                }
                                @if (canConfiguracion)
                                {
                                <a class="app-sidebar-link @(IsActiveController("Configuracion") ? "active" : string.Empty)" asp-controller="Configuracion" asp-action="Index"><i class="bi bi-gear"></i><span>Configuracion</span></a>
                                }
                                @if (canMiSuscripcion)
                                {
                                <a class="app-sidebar-link @(IsActiveController("MiSuscripcion") ? "active" : string.Empty)" asp-controller="MiSuscripcion" asp-action="Index"><i class="bi bi-credit-card-2-front"></i><span>Mi suscripcion</span></a>
                                }
                                @if (canAyuda)
                                {
                                <a class="app-sidebar-link @(IsActiveController("Ayuda") ? "active" : string.Empty)" asp-controller="Ayuda" asp-action="Index"><i class="bi bi-life-preserver"></i><span>Ayuda</span></a>
                                }
                            </div>
                        </div>
                    </section>
                    }
                    @if (showMantenimientoMenu)
                    {
                    <section class="app-sidebar-group app-sidebar-group-accordion">
                        <button class="app-sidebar-group-toggle @(mantenimientoOpen ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-mantenimiento" aria-expanded="@(mantenimientoOpen.ToString().ToLowerInvariant())" aria-controls="sidebar-mantenimiento">
                            <span>Mantenimiento</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div id="sidebar-mantenimiento" class="collapse @(mantenimientoOpen ? "show" : string.Empty)">
                            <div class="app-sidebar-group-body">
                                @if (canPlanCuenta)
                                {
                                <a class="app-sidebar-link @(IsActiveController("PlanCuenta") ? "active" : string.Empty)" asp-controller="PlanCuenta" asp-action="Index"><i class="bi bi-diagram-3"></i><span>Plan de cuentas</span></a>
                                }
                                @if (canCentroCosto)
                                {
                                <a class="app-sidebar-link @(IsActiveController("CentroCosto") ? "active" : string.Empty)" asp-controller="CentroCosto" asp-action="Index"><i class="bi bi-diagram-2"></i><span>Centros de costo</span></a>
                                }
                                @if (canCuentaCorriente)
                                {
                                <a class="app-sidebar-link @(IsActiveController("CuentaCorriente") ? "active" : string.Empty)" asp-controller="CuentaCorriente" asp-action="Index"><i class="bi bi-bank"></i><span>Cuentas corrientes</span></a>
                                }
                                @if (canPersonas)
                                {
                                <a class="app-sidebar-link @(IsActiveController("Persona") ? "active" : string.Empty)" asp-controller="Persona" asp-action="Index"><i class="bi bi-people"></i><span>Personas</span></a>
                                }
                                @if (canTipoCambio)
                                {
                                <a class="app-sidebar-link @(IsActiveController("TipoCambio") ? "active" : string.Empty)" asp-controller="TipoCambio" asp-action="Index"><i class="bi bi-currency-exchange"></i><span>Tipos de cambio</span></a>
                                }
                                @if (canOrigenes)
                                {
                                <a class="app-sidebar-link @(IsActiveController("Origen") ? "active" : string.Empty)" asp-controller="Origen" asp-action="Index"><i class="bi bi-journal-richtext"></i><span>Origenes</span></a>
                                }
                                @if (canCuentasDestino)
                                {
                                <a class="app-sidebar-link @(IsActiveController("CuentaDestinoRegla") ? "active" : string.Empty)" asp-controller="CuentaDestinoRegla" asp-action="Index"><i class="bi bi-sliders2"></i><span>Cuentas destino</span></a>
                                }
                                @if (canConfigContable)
                                {
                                <a class="app-sidebar-link @(IsActiveController("ConfiguracionContabilizacion") ? "active" : string.Empty)" asp-controller="ConfiguracionContabilizacion" asp-action="Index"><i class="bi bi-gear-wide-connected"></i><span>Configuracion contable</span></a>
                                }
                            </div>
                        </div>
                    </section>
                    }
                    @if (showRegistroMenu)
                    {
                    <section class="app-sidebar-group app-sidebar-group-accordion">
                        <button class="app-sidebar-group-toggle @(registroOpen ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-registro" aria-expanded="@(registroOpen.ToString().ToLowerInvariant())" aria-controls="sidebar-registro">
                            <span>Registro</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div id="sidebar-registro" class="collapse @(registroOpen ? "show" : string.Empty)">
                            <div class="app-sidebar-group-body">
                                @if (canAsientos)
                                {
                                <a class="app-sidebar-link @(IsActiveController("Asiento") ? "active" : string.Empty)" asp-controller="Asiento" asp-action="Index"><i class="bi bi-receipt"></i><span>Asientos</span></a>
                                }
                                @if (canCompras)
                                {
                                <a class="app-sidebar-link @(IsActiveController("Compra") ? "active" : string.Empty)" asp-controller="Compra" asp-action="Index"><i class="bi bi-cart-check"></i><span>Compras</span></a>
                                }
                                @if (canVentas)
                                {
                                <a class="app-sidebar-link @(IsActiveController("Venta") ? "active" : string.Empty)" asp-controller="Venta" asp-action="Index"><i class="bi bi-cash-stack"></i><span>Ventas</span></a>
                                }
                                @if (canCajaBancos)
                                {
                                <a class="app-sidebar-link @(IsActiveController("CajaBanco") ? "active" : string.Empty)" asp-controller="CajaBanco" asp-action="Index"><i class="bi bi-cash-coin"></i><span>Caja y Bancos</span></a>
                                }
                                @if (canTransferencias)
                                {
                                <a class="app-sidebar-link @(IsActiveController("TransferenciaCuenta") ? "active" : string.Empty)" asp-controller="TransferenciaCuenta" asp-action="Index"><i class="bi bi-arrow-left-right"></i><span>Transferencias</span></a>
                                }
                                @if (canAplicaciones)
                                {
                                <a class="app-sidebar-link @(IsActiveController("Aplicacion") ? "active" : string.Empty)" asp-controller="Aplicacion" asp-action="Index"><i class="bi bi-link-45deg"></i><span>Aplicaciones</span></a>
                                }
                            </div>
                        </div>
                    </section>
                    }
                    @if (showProcesoMenu)
                    {
                    <section class="app-sidebar-group app-sidebar-group-accordion">
                        <button class="app-sidebar-group-toggle @(procesoOpen ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-proceso" aria-expanded="@(procesoOpen.ToString().ToLowerInvariant())" aria-controls="sidebar-proceso">
                            <span>Proceso</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div id="sidebar-proceso" class="collapse @(procesoOpen ? "show" : string.Empty)">
                            <div class="app-sidebar-group-body">
                                <a class="app-sidebar-link @(IsActiveController("Proceso") && currentPath.StartsWith("/Proceso/DiferenciaCambio", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" asp-controller="Proceso" asp-action="DiferenciaCambio"><i class="bi bi-currency-exchange"></i><span>Diferencia en Cambio</span></a>
                                <a class="app-sidebar-link @(IsActiveController("Proceso") && currentPath.StartsWith("/Proceso/AjusteCuenta", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" asp-controller="Proceso" asp-action="AjusteCuenta"><i class="bi bi-sliders"></i><span>Ajuste de Cuentas</span></a>
                                <a class="app-sidebar-link @(IsActiveController("Proceso") && currentPath.StartsWith("/Proceso/CerrarPeriodo", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" asp-controller="Proceso" asp-action="CerrarPeriodo"><i class="bi bi-lock"></i><span>Cerrar Periodo</span></a>
                                <a class="app-sidebar-link @(IsActiveController("Proceso") && currentPath.StartsWith("/Proceso/AsientoCierre", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" asp-controller="Proceso" asp-action="AsientoCierre"><i class="bi bi-journal-x"></i><span>Asiento de cierre</span></a>
                                <a class="app-sidebar-link @(IsActiveController("Proceso") && currentPath.StartsWith("/Proceso/AsientoApertura", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" asp-controller="Proceso" asp-action="AsientoApertura"><i class="bi bi-journal-plus"></i><span>Asiento de apertura</span></a>
                            </div>
                        </div>
                    </section>
                    }
                    @if (showReportesMenu)
                    {
                    <section class="app-sidebar-group app-sidebar-group-accordion">
                        <button class="app-sidebar-group-toggle @(reportesOpen ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-reportes" aria-expanded="@(reportesOpen.ToString().ToLowerInvariant())" aria-controls="sidebar-reportes">
                            <span>Reportes</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div id="sidebar-reportes" class="collapse @(reportesOpen ? "show" : string.Empty)">
                            <div class="app-sidebar-group-body">
                                @if (canReportes)
                                {
                                <a class="app-sidebar-link @(IsActiveController("Reporte") && currentPath.StartsWith("/Reporte/AnalisisCuentas", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" asp-controller="Reporte" asp-action="AnalisisCuentas"><i class="bi bi-bar-chart"></i><span>Analisis de cuentas</span></a>
                                <a class="app-sidebar-link @(IsActiveController("Reporte") && currentPath.StartsWith("/Reporte/LibroDiario", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" asp-controller="Reporte" asp-action="LibroDiario"><i class="bi bi-journal-richtext"></i><span>Libro Diario</span></a>
                                <a class="app-sidebar-link @(IsActiveController("Reporte") && currentPath.StartsWith("/Reporte/LibroMayor", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" asp-controller="Reporte" asp-action="LibroMayor"><i class="bi bi-journals"></i><span>Libro Mayor</span></a>
                                <a class="app-sidebar-link @(IsActiveController("Reporte") && currentPath.StartsWith("/Reporte/RegistroVentas", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" asp-controller="Reporte" asp-action="RegistroVentas"><i class="bi bi-receipt-cutoff"></i><span>Registro de ventas</span></a>
                                <a class="app-sidebar-link @(IsActiveController("Reporte") && currentPath.StartsWith("/Reporte/RegistroCompras", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" asp-controller="Reporte" asp-action="RegistroCompras"><i class="bi bi-cart3"></i><span>Registro de compras</span></a>
                                <a class="app-sidebar-link @(IsActiveController("Reporte") && currentPath.StartsWith("/Reporte/BalanceComprobacion", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" asp-controller="Reporte" asp-action="BalanceComprobacion"><i class="bi bi-table"></i><span>Balance de comprobacion</span></a>
                                }
                                @if (canLibroElectronico)
                                {
                                <a class="app-sidebar-link @(IsActiveController("LibroElectronico") ? "active" : string.Empty)" asp-controller="LibroElectronico" asp-action="Index"><i class="bi bi-filetype-txt"></i><span>Libros Electronicos</span></a>
                                }
                            </div>
                        </div>
                    </section>
                    }
                </nav>
                <div class="app-sidebar-session">
                    <div class="app-sidebar-session-user">
                        <small>Usuario actual</small>
                        <strong>@userDisplayName</strong>
                        <span>@userEmail</span>
                    </div>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="btn btn-outline-secondary app-sidebar-logout">Cerrar sesion</button>
                    </form>
                </div>
            </aside>
            <div class="app-shell-main">
                @if (TempData["ErrorMessage"] is string layoutErrorMessage)
                {
                    <div class="container pt-3">
                        <div class="alert alert-danger mb-0">@layoutErrorMessage</div>
                    </div>
                }
                @if (showContextHelp)
                {
                    <div class="app-context-toolbar">
                        <a class="app-context-help-link" asp-controller="Ayuda" asp-action="Index" asp-route-modulo="@helpModuleKey">
                            <i class="bi bi-life-preserver"></i>
                            <span>Ayuda de este modulo</span>
                        </a>
                    </div>
                }
                <main role="main" class="app-shell-content">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else if (platformShell)
    {
        <div class="app-shell">
            <aside class="app-sidebar app-sidebar-platform">
                <section class="app-sidebar-theme-card">
                    <div class="app-sidebar-theme-copy">
                        <span>Apariencia</span>
                        <strong class="app-theme-label" data-theme-label aria-live="polite"></strong>
                        <small>Cambia el tema del sistema y conserva la preferencia.</small>
                    </div>
                    <button type="button" class="app-theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Alternar modo oscuro">
                        <span class="app-theme-toggle-track">
                            <i class="bi bi-sun-fill app-theme-icon app-theme-icon-sun"></i>
                            <span class="app-theme-toggle-thumb"></span>
                            <i class="bi bi-moon-stars-fill app-theme-icon app-theme-icon-moon"></i>
                        </span>
                    </button>
                </section>
                <nav class="app-sidebar-nav app-sidebar-nav-accordion">
                    <a class="app-sidebar-link @(string.Equals(currentController, "Plataforma", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" asp-controller="Plataforma" asp-action="Index"><i class="bi bi-grid-1x2"></i>Resumen</a>
                    <a class="app-sidebar-link @(string.Equals(currentController, "Plataforma", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Cobros", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" asp-controller="Plataforma" asp-action="Cobros"><i class="bi bi-cash-coin"></i>Registro de cobros</a>
                    <section class="app-sidebar-group app-sidebar-group-accordion">
                        <button class="app-sidebar-group-toggle @(maestroContableOpen ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-maestros-contables" aria-expanded="@(maestroContableOpen.ToString().ToLowerInvariant())" aria-controls="sidebar-maestros-contables">
                            <span>Maestros contables</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div id="sidebar-maestros-contables" class="collapse @(maestroContableOpen ? "show" : string.Empty)">
                            <div class="app-sidebar-group-body">
                                <a class="app-sidebar-link @(IsMaestroContableAction("Index") ? "active" : string.Empty)" asp-controller="MaestroContable" asp-action="Index"><i class="bi bi-speedometer2"></i>Resumen maestros</a>
                                <a class="app-sidebar-link @(IsMaestroContableAction("PlanCuenta", "RegistrarPlanCuenta", "EditarPlanCuenta") ? "active" : string.Empty)" asp-controller="MaestroContable" asp-action="PlanCuenta"><i class="bi bi-diagram-3"></i>Plan de cuentas</a>
                                <a class="app-sidebar-link @(IsMaestroContableAction("CuentasDestino", "RegistrarCuentaDestino", "EditarCuentaDestino") ? "active" : string.Empty)" asp-controller="MaestroContable" asp-action="CuentasDestino"><i class="bi bi-signpost-split"></i>Cuentas destino</a>
                                <a class="app-sidebar-link @(IsMaestroContableAction("Asignaciones") ? "active" : string.Empty)" asp-controller="MaestroContable" asp-action="Asignaciones"><i class="bi bi-link-45deg"></i>Asignaciones</a>
                                <a class="app-sidebar-link @(IsMaestroContableAction("Origenes", "RegistrarOrigen", "EditarOrigen") ? "active" : string.Empty)" asp-controller="MaestroContable" asp-action="Origenes"><i class="bi bi-journal-code"></i>Origenes</a>
                                <a class="app-sidebar-link @(IsMaestroContableAction("Configuracion") ? "active" : string.Empty)" asp-controller="MaestroContable" asp-action="Configuracion"><i class="bi bi-sliders"></i>Configuracion</a>
                            </div>
                        </div>
                    </section>
                </nav>
                <div class="app-sidebar-session">
                    <div class="app-sidebar-session-user">
                        <small>Usuario actual</small>
                        <strong>@userDisplayName</strong>
                        <span>@userEmail</span>
                    </div>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="btn btn-outline-secondary app-sidebar-logout">Cerrar sesion</button>
                    </form>
                </div>
            </aside>
            <div class="app-shell-main">
                <main role="main" class="app-shell-content">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main role="main" class="container app-public-main">
            @if (TempData["ErrorMessage"] is string publicErrorMessage)
            {
                <div class="alert alert-danger">@publicErrorMessage</div>
            }
            @RenderBody()
        </main>
        <footer class="app-public-footer">
            <div class="container">
                <div class="app-public-footer-links">
                    <a asp-controller="Legal" asp-action="Terminos">Terminos y condiciones</a>
                    <a asp-controller="Legal" asp-action="Privacidad">Politica de privacidad</a>
                    <a asp-controller="Legal" asp-action="Cancelaciones">Cancelaciones y devoluciones</a>
                </div>
                <div>&copy; 2026 - FralseCont</div>
            </div>
        </footer>
        <partial name="_WhatsAppFloatingButton" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
