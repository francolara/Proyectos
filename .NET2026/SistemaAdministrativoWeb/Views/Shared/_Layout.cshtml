@using Microsoft.AspNetCore.Identity
@using SistemaAdministrativoWeb.Infrastructure.Empresas
@inject ICurrentCompanyAccessor CurrentCompanyAccessor
@inject UserManager<IdentityUser> UserManager
<!DOCTYPE html>
@{
    var adminShell = ViewData["AdminShell"] as bool? ?? false;
    var platformShell = ViewData["PlatformShell"] as bool? ?? false;
    var pageTitle = ViewData["Title"]?.ToString() ?? "Sistema Administrativo";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    var userEmail = User.Identity?.Name ?? "usuario@sisadm.local";
    var userDisplayName = userEmail;
    if (User.Identity?.IsAuthenticated == true)
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (!string.IsNullOrWhiteSpace(currentUser?.Email))
        {
            userEmail = currentUser.Email!.Trim();
        }
    }

    bool IsActiveController(params string[] controllers) =>
        controllers.Any(x => string.Equals(x, currentController, StringComparison.OrdinalIgnoreCase));

    bool IsActivePath(params string[] segments) =>
        segments.Any(x => currentPath.StartsWith($"/{x}", StringComparison.OrdinalIgnoreCase));

    var generalOpen = IsActiveController("Panel", "EmpresaContexto");
    var mantenimientoOpen = IsActiveController("PlanCuenta", "CentroCosto", "CuentaCorriente", "Origen", "CuentaDestinoRegla", "ConfiguracionContabilizacion", "Persona")
        || IsActivePath("PlanCuenta", "CentroCosto", "CuentaCorriente", "Origen", "CuentaDestinoRegla", "ConfiguracionContabilizacion", "Persona");
    var registroOpen = IsActiveController("Asiento", "Compra", "Venta", "CajaBanco", "TransferenciaCuenta", "Aplicacion")
        || IsActivePath("Asiento", "Compra", "Venta", "CajaBanco", "TransferenciaCuenta", "Aplicacion");
    var reportesOpen = IsActiveController("Reporte") || IsActivePath("Reporte");
}
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - SisAdm</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaAdministrativoWeb.styles.css" asp-append-version="true" />
</head>
<body class="app-body @(adminShell || platformShell ? "app-shell-body" : "app-public-body")">
    @if (!adminShell && !platformShell)
    {
        <header class="app-public-header">
            <nav class="navbar navbar-expand-lg navbar-light">
                <div class="container">
                    <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="app-brand-mark"><i class="bi bi-journal-text"></i></span>
                        <span>
                            <strong>SisAdm</strong>
                            <small>Gestion contable multiempresa</small>
                        </span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div id="mainNav" class="collapse navbar-collapse">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Registro de usuario</a>
                            </li>
                        </ul>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>
    }

    @if (adminShell)
    {
        <div class="app-shell">
            <aside class="app-sidebar">
                <a class="app-sidebar-brand" asp-controller="Panel" asp-action="Index">
                    <span class="app-brand-mark"><i class="bi bi-building"></i></span>
                    <div>
                        <strong>Panel</strong>
                        <small>@(CurrentCompanyAccessor.EmpresaNombre ?? "Sin empresa activa")</small>
                    </div>
                </a>
                <div class="app-sidebar-company-chip">
                    <span>Empresa activa</span>
                    <strong>@(CurrentCompanyAccessor.EmpresaNombre ?? "Seleccione empresa")</strong>
                </div>
                <nav class="app-sidebar-nav app-sidebar-nav-accordion">
                    <section class="app-sidebar-group app-sidebar-group-accordion">
                        <button class="app-sidebar-group-toggle @(generalOpen ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-general" aria-expanded="@(generalOpen.ToString().ToLowerInvariant())" aria-controls="sidebar-general">
                            <span>General</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div id="sidebar-general" class="collapse @(generalOpen ? "show" : string.Empty)">
                            <div class="app-sidebar-group-body">
                                <a class="app-sidebar-link @(IsActiveController("Panel") ? "active" : string.Empty)" asp-controller="Panel" asp-action="Index"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                                <a class="app-sidebar-link @(IsActiveController("EmpresaContexto") ? "active" : string.Empty)" asp-controller="EmpresaContexto" asp-action="Index"><i class="bi bi-buildings"></i><span>Empresas</span></a>
                            </div>
                        </div>
                    </section>
                    <section class="app-sidebar-group app-sidebar-group-accordion">
                        <button class="app-sidebar-group-toggle @(mantenimientoOpen ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-mantenimiento" aria-expanded="@(mantenimientoOpen.ToString().ToLowerInvariant())" aria-controls="sidebar-mantenimiento">
                            <span>Mantenimiento</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div id="sidebar-mantenimiento" class="collapse @(mantenimientoOpen ? "show" : string.Empty)">
                            <div class="app-sidebar-group-body">
                                <a class="app-sidebar-link @(IsActiveController("PlanCuenta") ? "active" : string.Empty)" asp-controller="PlanCuenta" asp-action="Index"><i class="bi bi-diagram-3"></i><span>Plan de cuentas</span></a>
                                <a class="app-sidebar-link @(IsActiveController("CentroCosto") ? "active" : string.Empty)" asp-controller="CentroCosto" asp-action="Index"><i class="bi bi-diagram-2"></i><span>Centros de costo</span></a>
                                <a class="app-sidebar-link @(IsActiveController("CuentaCorriente") ? "active" : string.Empty)" asp-controller="CuentaCorriente" asp-action="Index"><i class="bi bi-bank"></i><span>Cuentas corrientes</span></a>
                                <a class="app-sidebar-link @(IsActiveController("Persona") ? "active" : string.Empty)" asp-controller="Persona" asp-action="Index"><i class="bi bi-people"></i><span>Personas</span></a>
                                <a class="app-sidebar-link @(IsActiveController("Origen") ? "active" : string.Empty)" asp-controller="Origen" asp-action="Index"><i class="bi bi-journal-richtext"></i><span>Origenes</span></a>
                                <a class="app-sidebar-link @(IsActiveController("CuentaDestinoRegla") ? "active" : string.Empty)" asp-controller="CuentaDestinoRegla" asp-action="Index"><i class="bi bi-sliders2"></i><span>Cuentas destino</span></a>
                                <a class="app-sidebar-link @(IsActiveController("ConfiguracionContabilizacion") ? "active" : string.Empty)" asp-controller="ConfiguracionContabilizacion" asp-action="Index"><i class="bi bi-gear-wide-connected"></i><span>Configuracion contable</span></a>
                            </div>
                        </div>
                    </section>
                    <section class="app-sidebar-group app-sidebar-group-accordion">
                        <button class="app-sidebar-group-toggle @(registroOpen ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-registro" aria-expanded="@(registroOpen.ToString().ToLowerInvariant())" aria-controls="sidebar-registro">
                            <span>Registro</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div id="sidebar-registro" class="collapse @(registroOpen ? "show" : string.Empty)">
                            <div class="app-sidebar-group-body">
                                <a class="app-sidebar-link @(IsActiveController("Asiento") ? "active" : string.Empty)" asp-controller="Asiento" asp-action="Index"><i class="bi bi-receipt"></i><span>Asientos</span></a>
                                <a class="app-sidebar-link @(IsActiveController("Compra") ? "active" : string.Empty)" asp-controller="Compra" asp-action="Index"><i class="bi bi-cart-check"></i><span>Compras</span></a>
                                <a class="app-sidebar-link @(IsActiveController("Venta") ? "active" : string.Empty)" asp-controller="Venta" asp-action="Index"><i class="bi bi-cash-stack"></i><span>Ventas</span></a>
                                <a class="app-sidebar-link @(IsActiveController("CajaBanco") ? "active" : string.Empty)" asp-controller="CajaBanco" asp-action="Index"><i class="bi bi-cash-coin"></i><span>Caja y Bancos</span></a>
                                <a class="app-sidebar-link @(IsActiveController("TransferenciaCuenta") ? "active" : string.Empty)" asp-controller="TransferenciaCuenta" asp-action="Index"><i class="bi bi-arrow-left-right"></i><span>Transferencias</span></a>
                                <a class="app-sidebar-link @(IsActiveController("Aplicacion") ? "active" : string.Empty)" asp-controller="Aplicacion" asp-action="Index"><i class="bi bi-link-45deg"></i><span>Aplicaciones</span></a>
                            </div>
                        </div>
                    </section>
                    <section class="app-sidebar-group app-sidebar-group-accordion">
                        <button class="app-sidebar-group-toggle @(reportesOpen ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-reportes" aria-expanded="@(reportesOpen.ToString().ToLowerInvariant())" aria-controls="sidebar-reportes">
                            <span>Reportes</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div id="sidebar-reportes" class="collapse @(reportesOpen ? "show" : string.Empty)">
                            <div class="app-sidebar-group-body">
                                <a class="app-sidebar-link disabled" href="#"><i class="bi bi-journal-richtext"></i><span>Libros</span></a>
                                <a class="app-sidebar-link disabled" href="#"><i class="bi bi-bar-chart"></i><span>Analisis</span></a>
                            </div>
                        </div>
                    </section>
                </nav>
                <div class="app-sidebar-session">
                    <div class="app-sidebar-session-user">
                        <small>Usuario actual</small>
                        <strong>@userDisplayName</strong>
                        <span>@userEmail</span>
                    </div>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="btn btn-outline-secondary app-sidebar-logout">Cerrar sesion</button>
                    </form>
                </div>
            </aside>
            <div class="app-shell-main">
                <main role="main" class="app-shell-content">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else if (platformShell)
    {
        <div class="app-shell">
            <aside class="app-sidebar app-sidebar-platform">
                <a class="app-sidebar-brand" asp-controller="Plataforma" asp-action="Index">
                    <span class="app-brand-mark"><i class="bi bi-shield-check"></i></span>
                    <div>
                        <strong>SuperAdmin</strong>
                        <small>Control de suscriptores</small>
                    </div>
                </a>
                <nav class="app-sidebar-nav">
                    <a class="app-sidebar-link" asp-controller="Plataforma" asp-action="Index"><i class="bi bi-grid-1x2"></i>Resumen</a>
                    <a class="app-sidebar-link" asp-controller="EmpresaContexto" asp-action="Index"><i class="bi bi-buildings"></i>Empresas</a>
                    <a class="app-sidebar-link disabled" href="#"><i class="bi bi-person-badge"></i>Contratos</a>
                </nav>
                <div class="app-sidebar-session">
                    <div class="app-sidebar-session-user">
                        <small>Usuario actual</small>
                        <strong>@userDisplayName</strong>
                        <span>@userEmail</span>
                    </div>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="btn btn-outline-secondary app-sidebar-logout">Cerrar sesion</button>
                    </form>
                </div>
            </aside>
            <div class="app-shell-main">
                <main role="main" class="app-shell-content">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main role="main" class="container app-public-main">
            @RenderBody()
        </main>
        <footer class="app-public-footer">
            <div class="container">
                &copy; 2026 - SisAdm
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
