@model SistemaAdministrativoWeb.ViewModels.Contabilidad.CajaBancoEstadoCuentaViewModel
@* Firma: FRANCO LARA - 19/11/2026 | Presenta los datos bancarios en minitarjetas y el título en una tarjeta con barra lateral. *@
@* Firma: FRANCO LARA - 18/11/2026 | Aplica el diseño común de reportes y abre la impresión y exportación CSV en una pestaña independiente. *@

@* Firma: FRANCO LARA - 07/11/2026 | Unifica el estilo HTML e impreso del reporte con linea verde, tarjeta con filtros aplicados y rotulos de tabla en negro. Mejora el contraste de Imprimir en modo oscuro. *@

@* Firma: FRANCO LARA - 12/07/2026 | Crea el reporte HTML imprimible Estado de Cuenta para Caja y Bancos, mostrando saldos iniciales, movimientos del mes y saldo final de la cuenta corriente seleccionada. *@
@* Firma: FRANCO LARA - 21/07/2026 | Corrige la impresion A4 vertical del Estado de cuenta, conserva cabecera y tarjetas horizontales, compacta el contenido y evita heredar el modo oscuro. *@

@{
    ViewData["Title"] = "Estado de cuenta";
    ViewData["AdminShell"] = true;
    var textInfo = System.Globalization.CultureInfo.CurrentCulture.TextInfo;
    var periodoTexto = textInfo.ToTitleCase(new DateTime(Model.AnioSeleccionado, Model.MesSeleccionado, 1).ToString("MMMM 'de' yyyy"));
    ViewData["EstilosReporte"] = true;
    if (string.Equals(Context.Request.Query["vistaImpresion"].ToString(), "true", StringComparison.OrdinalIgnoreCase))
    {
        Layout = "_ReporteImpresionLayout";
        ViewData["MostrarAccionesReporte"] = true;
        ViewData["ReporteVertical"] = true;
        await RenderDocumentoAsync();
        return;
    }
}


<section class="dashboard-shell">
    <section class="workspace-window">
        <div class="workspace-window-head no-print">
            <div>
                <span class="workspace-window-kicker">Reporte</span>
                <h1>Estado de cuenta</h1>
                <p>Vista HTML imprimible del movimiento mensual de la cuenta corriente seleccionada.</p>
            </div>
            <div class="workspace-window-badge">
                <strong>@Model.EmpresaNombre</strong>
                <span>@periodoTexto</span>
            </div>
        </div>

        <div class="workspace-window-body">
            <div class="balance-document-preview">
                <div class="report-action-bar no-print">
                    <a asp-action="Index"
                       asp-route-idBancoConfiguracionEmpresa="@Model.IdBancoConfiguracionEmpresa"
                       asp-route-anio="@Model.AnioSeleccionado"
                       asp-route-mes="@Model.MesSeleccionado"
                       class="btn btn-outline-secondary">Volver a Caja y Bancos</a>
                    <partial name="_ReporteAbrirImpresion" />
                </div>
                @{ await RenderDocumentoAsync(); }
            </div>
        </div>
    </section>
</section>

@{
    async Task RenderDocumentoAsync()
    {
        <article class="balance-document accounting-document" aria-labelledby="balance-document-title">
            @await Component.InvokeAsync("ReporteEmpresa", new { empresaNombre = Model.EmpresaNombre, rucEmpresa = (string?)null })

            <section class="accounting-document-heading" aria-labelledby="balance-document-title">
                <h1 id="balance-document-title">Estado de cuenta</h1>
                <dl class="accounting-document-cards" data-report-csv-context>
                    <div class="accounting-document-card">
                        <dt>Banco</dt>
                        <dd>@Model.NombreBanco</dd>
                    </div>
                    <div class="accounting-document-card">
                        <dt>Cuenta bancaria</dt>
                        <dd>@Model.NroCuentaCorriente</dd>
                    </div>
                    <div class="accounting-document-card">
                        <dt>Moneda</dt>
                        <dd>@Model.CodigoMoneda - @Model.NombreMoneda</dd>
                    </div>
                    <div class="accounting-document-card">
                        <dt>Periodo</dt>
                        <dd>@periodoTexto</dd>
                    </div>
                    <div class="accounting-document-card">
                        <dt>Titular</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Titular) ? "-" : Model.Titular)</dd>
                    </div>
                </dl>
            </section>

            <section class="accounting-document-cards" data-report-csv-context>
                <article class="accounting-document-card">
                    <span>Saldo inicial debe</span>
                    <strong>@Model.SaldoInicialDebe.ToString("N2")</strong>
                </article>
                <article class="accounting-document-card">
                    <span>Saldo inicial haber</span>
                    <strong>@Model.SaldoInicialHaber.ToString("N2")</strong>
                </article>
                <article class="accounting-document-card">
                    <span>Ingresos del mes</span>
                    <strong>@Model.IngresosMes.ToString("N2")</strong>
                </article>
                <article class="accounting-document-card">
                    <span>Egresos del mes</span>
                    <strong>@Model.EgresosMes.ToString("N2")</strong>
                </article>
                <article class="accounting-document-card">
                    <span class="accounting-report-total-label">Saldo final</span>
                    <strong>@Model.SaldoFinal.ToString("N2")</strong>
                </article>
            </section>

            <div class="balance-document-scroll" tabindex="0" role="region" aria-label="Detalle del reporte">
                <table class="balance-document-table">
                    <thead>
                        <tr>
                            <th class="bank-col-numero">Nro</th>
                            <th class="bank-col-fecha">Fecha</th>
                            <th class="bank-col-tipo">Tipo</th>
                            <th class="bank-col-operacion">Operacion</th>
                            <th class="bank-col-persona">Persona</th>
                            <th class="bank-col-documento">Nro operacion</th>
                            <th class="bank-col-glosa">Glosa</th>
                            <th class="bank-col-monto">Ingreso</th>
                            <th class="bank-col-monto">Egreso</th>
                            <th class="bank-col-monto">Saldo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Movimientos.Count == 0)
                        {
                            <tr data-report-csv-skip>
                                <td colspan="10">No se encontraron movimientos para el periodo seleccionado.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Movimientos)
                            {
                                var tipoTexto = string.Equals(item.TipoMovimiento, "I", StringComparison.OrdinalIgnoreCase) ? "Ingreso" : "Egreso";
                                <tr>
                                    <td>@item.NumeroMovimiento</td>
                                    <td>@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                                    <td>@tipoTexto</td>
                                    <td class="bank-op-cell">
                                        <strong>@item.TipoOperacion</strong>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(item.NombrePersona) ? "-" : item.NombrePersona)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.NumeroOperacion) ? "-" : item.NumeroOperacion)</td>
                                    <td class="bank-description">@item.Glosa</td>
                                    <td class="balance-amount">@item.Ingreso.ToString("N2")</td>
                                    <td class="balance-amount">@item.Egreso.ToString("N2")</td>
                                    <td class="balance-amount">@item.SaldoAcumulado.ToString("N2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr class="balance-a4-total-row">
                            <td class="accounting-report-total-label" colspan="7">Totales del periodo</td>
                            <td class="balance-amount">@Model.IngresosMes.ToString("N2")</td>
                            <td class="balance-amount">@Model.EgresosMes.ToString("N2")</td>
                            <td class="balance-amount">@Model.SaldoFinal.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </article>
    }
}
