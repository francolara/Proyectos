@model SistemaAdministrativoWeb.ViewModels.Contabilidad.CajaBancoIndexViewModel

@* =============================================
   Author:        FRANCO LARA
   Create date:   23/06/2026
   Description:   Agrega el formulario base del modulo Caja y Bancos con seleccion de cuenta corriente, operacion bancaria, persona relacionada y detalle contable con ayudas de cuenta, centro de costo, persona y comprobantes por linea.
   ============================================= *@
@* Firma: FRANCO LARA - 24/06/2026 | Reubica el resumen del movimiento junto al importe de cabecera, cambia sus indicadores a Total Operacion/Total Detalle/Diferencia, amplia el detalle para guardar persona por linea, enlaza comprobantes Compra/Venta jalando su saldo pendiente, bloquea el guardado cuando exista diferencia y muestra calendario en Fecha emision. *@
@* Firma: FRANCO LARA - 26/06/2026 | Incorpora detracciones en la ayuda de comprobantes pendientes de Caja y Bancos, asigna tipo documento por codigo, hereda serie y numero del comprobante original y precarga la cuenta contable SPOT configurada para su pago. *@
@* Firma: FRANCO LARA - 29/06/2026 | Exige tipo de cambio en cabecera y detalle de Caja y Bancos, consulta siempre USD por fecha al cargar o cambiarla, muestra 3 decimales en ambos niveles, deja el valor por defecto en 0 para validar al grabar e incorpora percepciones como documento pendiente adicional de compras. *@
@* Firma: FRANCO LARA - 03/07/2026 | Corrige el resumen visual de Caja y Bancos para que valide tambien el sentido contable del detalle segun ingreso o egreso y avise antes de enviar cuando el asiento automatico quedaria invertido. *@
@* Firma: FRANCO LARA - 04/07/2026 | Bloquea la edicion manual del tipo de cambio en Caja y Bancos y convierte automaticamente el saldo sugerido del comprobante a la moneda de la cuenta corriente usando el TC de cabecera. *@

@{
    ViewData["Title"] = Model.Formulario.IdMovimientoBanco.HasValue ? "Editar movimiento bancario" : "Registrar movimiento bancario";
    ViewData["AdminShell"] = true;
    var periodoTexto = new DateTime(Model.AnioSeleccionado, Model.MesSeleccionado, 1).ToString("MMMM 'de' yyyy");
    var textInfo = System.Globalization.CultureInfo.CurrentCulture.TextInfo;
    var tipoMovimientoActual = string.Equals(Model.Formulario.TipoMovimiento, "E", StringComparison.OrdinalIgnoreCase) ? "E" : "I";
    var operacionesActuales = tipoMovimientoActual == "E" ? Model.OperacionesEgreso : Model.OperacionesIngreso;
    var personaTexto = string.IsNullOrWhiteSpace(Model.Formulario.PersonaTexto) ? "Sin persona vinculada" : Model.Formulario.PersonaTexto;
}

<style>
    .workspace-caja-banco-layout {
        display: grid;
        grid-template-columns: minmax(280px, 320px) minmax(0, 1fr);
        gap: 1rem;
        align-items: stretch;
    }

    .workspace-caja-banco-sidebar,
    .workspace-caja-banco-main,
    .workspace-caja-banco-sidebar .workspace-section,
    .workspace-caja-banco-main .workspace-section {
        height: 100%;
    }

    .workspace-caja-banco-sidebar .workspace-window-body,
    .workspace-caja-banco-main .workspace-window-body {
        height: calc(100% - 88px);
    }

    .workspace-operation-tabs {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .workspace-operation-tab {
        display: grid;
        grid-template-columns: 1fr;
        align-items: center;
        gap: 0.35rem;
        min-height: 58px;
        padding: 0.9rem 1rem;
        border-radius: 18px;
        justify-items: center;
        text-align: center;
    }

    .workspace-operation-copy strong {
        display: block;
        font-size: 1rem;
        line-height: 1.1;
    }

    .workspace-caja-banco-tree-group + .workspace-caja-banco-tree-group {
        margin-top: 0.9rem;
    }

    .workspace-tree-group-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        padding: 0 0.1rem;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #35507f;
    }

    .workspace-tree-group-title small {
        font-size: 0.72rem;
        font-weight: 600;
        color: #6a7a96;
    }

    .workspace-caja-banco-tree-group {
        position: relative;
        padding-left: 0.35rem;
    }

    .workspace-caja-banco-tree-group::before {
        content: "";
        position: absolute;
        left: 0.6rem;
        top: 1.95rem;
        bottom: 0.65rem;
        width: 1px;
        background: rgba(64, 99, 160, 0.18);
    }

    .workspace-tree-option {
        display: grid;
        grid-template-columns: 3rem 1fr;
        align-items: center;
        justify-items: start;
        gap: 0.7rem;
        text-align: left;
        margin-left: 0.75rem;
        position: relative;
    }

    .workspace-tree-option::before {
        content: "";
        position: absolute;
        left: -0.52rem;
        top: 50%;
        width: 0.45rem;
        height: 1px;
        background: rgba(64, 99, 160, 0.3);
        transform: translateY(-50%);
    }

    .workspace-tree-label {
        display: flex;
        flex-direction: column;
        gap: 0.12rem;
        min-width: 0;
        width: 100%;
        align-items: flex-start;
        text-align: left;
    }

    .workspace-tree-label strong {
        font-size: 0.9rem;
        line-height: 1.2;
        color: inherit;
    }

    .workspace-tree-label small {
        font-size: 0.72rem;
        line-height: 1.2;
        color: #6f7f98;
    }

    .workspace-tree-option.active .workspace-tree-label small {
        color: rgba(255,255,255,0.82);
    }

    .workspace-tree-code {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2rem;
        padding: 0.3rem 0.45rem;
        border-radius: 12px;
        font-weight: 800;
        letter-spacing: 0.02em;
        background: rgba(42, 106, 220, 0.08);
        color: #214f9d;
    }

    .workspace-tree-option.active .workspace-tree-code {
        background: rgba(255,255,255,0.18);
        color: #fff;
    }

    .workspace-section-head-meta {
        min-width: 13rem;
        align-self: center;
        border-radius: 1rem;
        padding: 0.9rem 1rem;
        background: rgba(42, 106, 220, 0.06);
        border: 1px solid rgba(86, 126, 204, 0.18);
        text-align: right;
    }

    .workspace-section-head-meta span,
    .workspace-section-head-meta strong {
        display: block;
    }

    .workspace-section-head-meta span {
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #5f7291;
    }

    .workspace-section-head-meta strong {
        margin-top: 0.25rem;
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--app-ink);
    }

    .workspace-balance-summary-cabecera {
        grid-column: span 2;
        margin-top: 0.2rem;
        gap: 0.75rem;
    }

    .workspace-balance-summary-cabecera .workspace-balance-card {
        min-height: 92px;
        padding: 0.85rem 1rem;
    }

    .workspace-balance-summary-cabecera .workspace-balance-card span {
        font-size: 0.7rem;
    }

    .workspace-balance-summary-cabecera .workspace-balance-card strong {
        font-size: 1.55rem;
    }

    .workspace-balance-summary-cabecera .workspace-balance-card small {
        font-size: 0.78rem;
    }

    .workspace-persona-linea-note {
        display: block;
        margin-top: 0.35rem;
        font-size: 0.72rem;
        color: #6a7a96;
        line-height: 1.25;
    }
</style>

<section class="dashboard-shell">
    <section class="workspace-window">
        <div class="workspace-window-head">
            <div>
                <span class="workspace-window-kicker">Formulario</span>
                <h1>@ViewData["Title"]</h1>
                <p>Registra ingresos y egresos de la cuenta corriente seleccionada con detalle contable y referencia del periodo.</p>
            </div>
            <div class="workspace-window-badge">
                <strong>@textInfo.ToTitleCase(periodoTexto)</strong>
                <span>Periodo contable</span>
                <small>@Model.PeriodoConsulta</small>
            </div>
        </div>
        <div class="workspace-window-body">
            @if (Model.CuentasCorrientesDisponibles.Count == 0)
            {
                <div class="alert alert-warning">No existen cuentas corrientes activas para la empresa. Registre una cuenta corriente antes de crear movimientos bancarios.</div>
            }
            @if (Model.OperacionesIngreso.Count == 0 && Model.OperacionesEgreso.Count == 0)
            {
                <div class="alert alert-warning">No existen operaciones bancarias configuradas para ingresos o egresos.</div>
            }

            <form asp-action="Guardar" method="post" id="caja-bancos-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Formulario.IdMovimientoBanco" />
                <input type="hidden" name="anio" value="@Model.AnioSeleccionado" />
                <input type="hidden" name="mes" value="@Model.MesSeleccionado" />
                <input type="hidden" asp-for="Formulario.TipoMovimiento" id="tipoMovimientoInput" />
                <input type="hidden" asp-for="Formulario.IdOpeBancaria" id="idOpeBancariaInput" />
                <input type="hidden" asp-for="Formulario.TipoOperacionTexto" id="tipoOperacionTextoInput" />
                <input type="hidden" asp-for="Formulario.IdPersona" id="personaIdInput" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="workspace-form-grid">
                    <div class="workspace-field">
                        <label asp-for="Formulario.IdBancoConfiguracionEmpresa" class="form-label">Cuenta corriente</label>
                        <select asp-for="Formulario.IdBancoConfiguracionEmpresa" class="form-select" id="cuentaCorrienteSelect">
                            <option value="">Seleccione cuenta</option>
                            @foreach (var cuenta in Model.CuentasCorrientesDisponibles)
                            {
                                <option value="@cuenta.IdBancoConfiguracionEmpresa"
                                        data-banco="@($"{cuenta.NombreBanco} ({cuenta.CodigoBanco})")"
                                        data-moneda="@($"{cuenta.CodigoMoneda} - {cuenta.NombreMoneda}")"
                                        data-codigo-moneda="@cuenta.CodigoMoneda"
                                        data-cuenta="@cuenta.NroCuentaCorriente"
                                        selected="@(cuenta.IdBancoConfiguracionEmpresa == Model.Formulario.IdBancoConfiguracionEmpresa)">
                                    @($"{cuenta.NroCuentaCorriente} | {cuenta.NombreBanco} | {cuenta.CodigoMoneda}")
                                </option>
                            }
                        </select>
                        <span asp-validation-for="Formulario.IdBancoConfiguracionEmpresa" class="text-danger"></span>
                    </div>
                    <div class="workspace-field">
                        <label class="form-label">Moneda</label>
                        <input class="form-control" id="monedaTexto" value="@Model.Formulario.MonedaTexto" readonly />
                    </div>
                </div>

                <div class="workspace-caja-banco-layout mt-4">
                    <aside class="workspace-caja-banco-sidebar">
                        <div class="workspace-section">
                            <div class="workspace-section-head workspace-section-head-compact">
                                <div>
                                    <h2>Flujo bancario</h2>
                                </div>
                            </div>
                            <div class="workspace-window-body">
                                <div class="workspace-operation-tabs">
                                    <button type="button" class="workspace-operation-tab @(tipoMovimientoActual == "I" ? "active" : string.Empty)" data-movimiento="I">
                                        <span class="workspace-operation-copy">
                                            <strong>Ingresos</strong>
                                        </span>
                                    </button>
                                    <button type="button" class="workspace-operation-tab @(tipoMovimientoActual == "E" ? "active" : string.Empty)" data-movimiento="E">
                                        <span class="workspace-operation-copy">
                                            <strong>Egresos</strong>
                                        </span>
                                    </button>
                                </div>

                                <div class="workspace-caja-banco-tree" id="operacionesTree">
                                    <div class="workspace-caja-banco-tree-group @(tipoMovimientoActual == "I" ? string.Empty : "is-hidden")" data-tree-group="I">
                                        <div class="workspace-tree-group-title">
                                            <span>Ingresos</span>
                                            <small>Ordenado por codigo</small>
                                        </div>
                                        @foreach (var operacion in Model.OperacionesIngreso)
                                        {
                                            <button type="button"
                                                    class="workspace-tree-option @(tipoMovimientoActual == "I" && string.Equals(Model.Formulario.IdOpeBancaria, operacion.IdOpeBancaria, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                                                    data-tree-movimiento="I"
                                                data-tree-id="@operacion.IdOpeBancaria"
                                                data-tree-texto="@operacion.TipoOperacion">
                                                <span class="workspace-tree-code">@operacion.IdOpeBancaria</span>
                                                <span class="workspace-tree-label">
                                                    <strong>@operacion.TipoOperacion</strong>
                                                </span>
                                            </button>
                                        }
                                    </div>

                                    <div class="workspace-caja-banco-tree-group @(tipoMovimientoActual == "E" ? string.Empty : "is-hidden")" data-tree-group="E">
                                        <div class="workspace-tree-group-title">
                                            <span>Egresos</span>
                                            <small>Ordenado por codigo</small>
                                        </div>
                                        @foreach (var operacion in Model.OperacionesEgreso)
                                        {
                                            <button type="button"
                                                    class="workspace-tree-option @(tipoMovimientoActual == "E" && string.Equals(Model.Formulario.IdOpeBancaria, operacion.IdOpeBancaria, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                                                    data-tree-movimiento="E"
                                                data-tree-id="@operacion.IdOpeBancaria"
                                                data-tree-texto="@operacion.TipoOperacion">
                                                <span class="workspace-tree-code">@operacion.IdOpeBancaria</span>
                                                <span class="workspace-tree-label">
                                                    <strong>@operacion.TipoOperacion</strong>
                                                </span>
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="workspace-preview-message is-ok mt-3" id="operacionSeleccionadaBox">
                                    <i class="bi bi-journal-check"></i>
                                    <span id="operacionSeleccionadaTexto">@(string.IsNullOrWhiteSpace(Model.Formulario.TipoOperacionTexto) ? "Seleccione una operacion bancaria" : Model.Formulario.TipoOperacionTexto)</span>
                                </div>
                            </div>
                        </div>
                    </aside>

                    <div class="workspace-caja-banco-main">
                        <div class="workspace-section">
                            <div class="workspace-section-head workspace-section-head-compact">
                                <div>
                                    <h2>Datos del movimiento</h2>
                                </div>
                                <div class="workspace-section-head-meta">
                                    <span>Nro movimiento</span>
                                    <strong>@(Model.Formulario.NumeroMovimiento?.ToString() ?? "Se asignara al guardar")</strong>
                                </div>
                            </div>
                            <div class="workspace-window-body">
                                <div class="workspace-form-grid">
                                    <div class="workspace-field">
                                        <label asp-for="Formulario.FechaEmision" class="form-label">Fecha emision</label>
                                        <input asp-for="Formulario.FechaEmision" type="date" class="form-control js-fecha-tipo-cambio" id="cajaBancoFechaEmision" />
                                        <span asp-validation-for="Formulario.FechaEmision" class="text-danger"></span>
                                    </div>
                                    <div class="workspace-field">
                                        <label asp-for="Formulario.TipoCambio" class="form-label">Tipo de cambio</label>
                                        <div class="input-group">
                                            <input asp-for="Formulario.TipoCambio" class="form-control js-tipo-cambio-cabecera" id="cajaBancoTipoCambio" readonly />
                                            <button type="button" class="btn btn-outline-secondary workspace-icon-button js-actualizar-tipo-cambio" title="Actualizar tipo de cambio" aria-label="Actualizar tipo de cambio"><i class="bi bi-arrow-clockwise"></i></button>
                                        </div>
                                        <span asp-validation-for="Formulario.TipoCambio" class="text-danger"></span>
                                    </div>
                                    <div class="workspace-field">
                                        <label asp-for="Formulario.NumeroDocumento" class="form-label">Nro de Operacion</label>
                                        <input asp-for="Formulario.NumeroDocumento" class="form-control" />
                                        <span asp-validation-for="Formulario.NumeroDocumento" class="text-danger"></span>
                                    </div>
                                    <div class="workspace-field workspace-field-span-2">
                                        <label class="form-label">Persona vinculada</label>
                                        <div class="workspace-lookup-control">
                                            <input class="form-control" id="personaTexto" value="@personaTexto" readonly />
                                            <button type="button" class="btn btn-outline-secondary workspace-icon-button" id="abrirPersonaModal" title="Buscar persona" aria-label="Buscar persona"><i class="bi bi-person"></i></button>
                                            <button type="button" class="btn btn-outline-secondary workspace-icon-button" id="limpiarPersona" title="Limpiar persona" aria-label="Limpiar persona"><i class="bi bi-brush"></i></button>
                                        </div>
                                        <div class="workspace-inline-note" id="personaDocumentoTexto">
                                            @(string.IsNullOrWhiteSpace(Model.Formulario.NumeroDocumentoPersona) ? "Sin RUC/DNI relacionado" : $"RUC/DNI: {Model.Formulario.NumeroDocumentoPersona}")
                                        </div>
                                    </div>
                                    <div class="workspace-field workspace-field-span-2">
                                        <label asp-for="Formulario.Glosa" class="form-label">Glosa</label>
                                        <input asp-for="Formulario.Glosa" class="form-control" />
                                        <span asp-validation-for="Formulario.Glosa" class="text-danger"></span>
                                    </div>
                                    <div class="workspace-field workspace-field-span-2">
                                        <label asp-for="Formulario.Observacion" class="form-label">Observaciones</label>
                                        <textarea asp-for="Formulario.Observacion" class="form-control" rows="2"></textarea>
                                        <span asp-validation-for="Formulario.Observacion" class="text-danger"></span>
                                    </div>
                                    <div class="workspace-field">
                                        <label asp-for="Formulario.ImporteTotal" class="form-label">Importe total</label>
                                        <input asp-for="Formulario.ImporteTotal" class="form-control" id="importeTotalInput" />
                                        <span asp-validation-for="Formulario.ImporteTotal" class="text-danger"></span>
                                    </div>
                                    <div class="workspace-balance-summary workspace-balance-summary-cabecera">
                                        <article class="workspace-balance-card">
                                            <span>Total Operacion</span>
                                            <strong id="totalOperacion">0.00</strong>
                                            <small>Importe de la cabecera</small>
                                        </article>
                                        <article class="workspace-balance-card">
                                            <span>Total Detalle</span>
                                            <strong id="totalDetalle">0.00</strong>
                                            <small id="totalDetalleEstado">Resultado neto del detalle</small>
                                        </article>
                                        <article class="workspace-balance-card workspace-balance-card-diff" id="diferenciaCard">
                                            <span>Diferencia</span>
                                            <strong id="totalDiferencia">0.00</strong>
                                            <small id="diferenciaEstado">Revision del movimiento</small>
                                        </article>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="workspace-section mt-4">
                    <div class="workspace-section-head workspace-section-head-compact">
                        <div>
                            <h2>Detalle del movimiento</h2>
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="agregar-linea">Agregar linea</button>
                    </div>
                    <div class="table-responsive workspace-table-wrap">
                        <table class="table align-middle app-table workspace-table" id="detalleTable">
                            <thead>
                                <tr>
                                    <th class="detalle-orden-cell">Item</th>
                                    <th>Cuenta</th>
                                    <th>Glosa detalle</th>
                                    <th class="detalle-centro-costo-cell">Centro costo</th>
                                    <th>Persona</th>
                                    <th>TipoDoc</th>
                                    <th>Serie</th>
                                    <th>Referencia</th>
                                    <th>TC</th>
                                    <th class="detalle-porcentaje-cell">Debe</th>
                                    <th class="detalle-porcentaje-cell">Haber</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Formulario.Detalles.Count; i++)
                                {
                                    <tr>
                                        <td class="detalle-orden-cell">
                                            <input asp-for="Formulario.Detalles[i].IdMovimientoBancoDetalle" type="hidden" />
                                            <input asp-for="Formulario.Detalles[i].Item" class="form-control" readonly />
                                        </td>
                                        <td>
                                            <input asp-for="Formulario.Detalles[i].IdPlanCuenta" type="hidden" class="js-cuenta-id" />
                                            <input asp-for="Formulario.Detalles[i].RequiereCentroCostoCuenta" type="hidden" class="js-requiere-centro-costo" />
                                            <div class="workspace-lookup-control workspace-lookup-control-compact">
                                                <input class="form-control js-cuenta-texto" value="@(string.IsNullOrWhiteSpace(Model.Formulario.Detalles[i].CuentaTexto) ? "Seleccione cuenta" : Model.Formulario.Detalles[i].CuentaTexto)" readonly />
                                                <button type="button" class="btn btn-outline-secondary workspace-icon-button js-abrir-cuenta-modal" title="Buscar cuenta" aria-label="Buscar cuenta"><i class="bi bi-search"></i></button>
                                            </div>
                                            <span asp-validation-for="Formulario.Detalles[i].IdPlanCuenta" class="text-danger"></span>
                                        </td>
                                        <td>
                                            <input asp-for="Formulario.Detalles[i].GlosaDetalle" class="form-control" />
                                            <span asp-validation-for="Formulario.Detalles[i].GlosaDetalle" class="text-danger"></span>
                                        </td>
                                        <td class="detalle-centro-costo-cell">
                                            <input asp-for="Formulario.Detalles[i].CodigoCentroCosto" type="hidden" class="js-centro-costo-codigo" />
                                            <div class="workspace-lookup-control workspace-lookup-control-inline-tools">
                                                <input class="form-control js-centro-costo-texto" value="@Model.Formulario.Detalles[i].CodigoCentroCosto" placeholder="Centro de costo opcional" readonly />
                                                <button type="button" class="btn btn-outline-secondary workspace-icon-button js-abrir-centro-modal" title="Buscar centro de costo" aria-label="Buscar centro de costo"><i class="bi bi-search"></i></button>
                                                <button type="button" class="btn btn-outline-secondary workspace-icon-button js-limpiar-centro" title="Limpiar centro de costo" aria-label="Limpiar centro de costo"><i class="bi bi-brush"></i></button>
                                            </div>
                                            <span asp-validation-for="Formulario.Detalles[i].CodigoCentroCosto" class="text-danger"></span>
                                        </td>
                                        <td>
                                            <input asp-for="Formulario.Detalles[i].IdPersona" type="hidden" class="js-persona-id-linea" />
                                            <input asp-for="Formulario.Detalles[i].NumeroDocumento" type="hidden" class="js-numero-documento-linea" />
                                            <input asp-for="Formulario.Detalles[i].ModuloOperacionComprobante" type="hidden" class="js-modulo-comprobante-linea" />
                                            <input asp-for="Formulario.Detalles[i].IdRegistroComprobante" type="hidden" class="js-id-registro-comprobante-linea" />
                                            <input type="hidden" class="js-comprobante-moneda-linea" />
                                            <input type="hidden" class="js-comprobante-saldo-original-linea" />
