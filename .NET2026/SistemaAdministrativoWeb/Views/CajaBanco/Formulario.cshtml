@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById("caja-bancos-form");
            if (!form) {
                return;
            }

            const tipoMovimientoInput = document.getElementById("tipoMovimientoInput");
            const idOpeBancariaInput = document.getElementById("idOpeBancariaInput");
            const tipoOperacionTextoInput = document.getElementById("tipoOperacionTextoInput");
            const operacionTextoBox = document.getElementById("operacionSeleccionadaTexto");
            const operacionTabs = Array.from(document.querySelectorAll(".workspace-operation-tab"));
            const operacionButtons = Array.from(document.querySelectorAll(".workspace-tree-option"));
            const operacionGroups = Array.from(document.querySelectorAll("[data-tree-group]"));
            const cuentaCorrienteSelect = document.getElementById("cuentaCorrienteSelect");
            const cuentaCorrienteTexto = document.getElementById("cuentaCorrienteTexto");
            const bancoTexto = document.getElementById("bancoTexto");
            const monedaTexto = document.getElementById("monedaTexto");
            const fechaEmisionEl = document.getElementById("cajaBancoFechaEmision");
            const tipoCambioCabeceraEl = document.getElementById("cajaBancoTipoCambio");
            const actualizarTipoCambioButton = document.querySelector(".js-actualizar-tipo-cambio");
            const detalleTable = document.getElementById("detalleTable");
            const detalleBody = detalleTable?.querySelector("tbody");
            const detalleTemplate = document.getElementById("detalleRowTemplate");
            const agregarLineaButton = document.getElementById("agregar-linea");
            const importeTotalInput = document.getElementById("importeTotalInput");
            const totalOperacionLabel = document.getElementById("totalOperacion");
            const totalDetalleLabel = document.getElementById("totalDetalle");
            const totalDiferenciaLabel = document.getElementById("totalDiferencia");
            const diferenciaCard = document.getElementById("diferenciaCard");
            const diferenciaEstado = document.getElementById("diferenciaEstado");
            const totalDetalleEstado = document.getElementById("totalDetalleEstado");
            const personaTexto = document.getElementById("personaTexto");
            const personaDocumentoTexto = document.getElementById("personaDocumentoTexto");
            const personaIdInput = document.getElementById("personaIdInput");
            const abrirPersonaModal = document.getElementById("abrirPersonaModal");
            const limpiarPersonaButton = document.getElementById("limpiarPersona");
            const personaFiltro = document.getElementById("personaFiltro");
            const personaResultados = document.getElementById("personaResultados");
            const personaModal = window.bootstrap ? new bootstrap.Modal(document.getElementById("personaModal")) : null;
            const comprobanteFiltro = document.getElementById("comprobanteFiltro");
            const comprobanteResultados = document.getElementById("comprobanteResultados");
            const comprobanteModal = window.bootstrap ? new bootstrap.Modal(document.getElementById("comprobanteModal")) : null;
            const cuentaFiltro = document.getElementById("cuentaFiltro");
            const nivelCuentaFiltro = document.getElementById("nivelCuentaFiltro");
            const cuentaResultados = document.getElementById("cuentaResultados");
            const cuentaModal = window.bootstrap ? new bootstrap.Modal(document.getElementById("cuentaModal")) : null;
            const centroFiltro = document.getElementById("centroFiltro");
            const centroResultados = document.getElementById("centroResultados");
            const centroModal = window.bootstrap ? new bootstrap.Modal(document.getElementById("centroModal")) : null;

            const buscarPersonasUrl = "@Url.Action("BuscarPersonasAyuda", "CajaBanco")";
            const buscarComprobantesDetalleUrl = "@Url.Action("BuscarComprobantesDetalleAyuda", "CajaBanco")";
            const buscarCuentasUrl = "@Url.Action("BuscarAyuda", "PlanCuenta")";
            const buscarCentrosUrl = "@Url.Action("BuscarAyuda", "CentroCosto")";
            const obtenerTipoCambioUrl = "@Url.Action("ObtenerValorPorFecha", "TipoCambio")";

            let personaSeleccion = null;
            let comprobanteSeleccion = null;
            let cuentaSeleccion = null;
            let centroSeleccion = null;
            let rowPersonaActiva = null;
            let rowComprobanteActiva = null;
            let rowCuentaActiva = null;
            let rowCentroActiva = null;
            let personaBusquedaProgramada = null;
            let comprobanteBusquedaProgramada = null;
            let cuentaBusquedaProgramada = null;
            let centroBusquedaProgramada = null;

            const parseDecimal = (value) => {
                const normalized = String(value || "0").replace(",", ".");
                const number = Number.parseFloat(normalized);
                return Number.isFinite(number) ? number : 0;
            };

            const roundTwo = (value) => Math.round((Number(value || 0) + Number.EPSILON) * 100) / 100;

            const obtenerCodigoMonedaCuenta = () =>
                String(cuentaCorrienteSelect?.selectedOptions?.[0]?.dataset.codigoMoneda || "")
                    .trim()
                    .toUpperCase();

            const convertirImporte = (importe, monedaOrigen, monedaDestino, tipoCambio) => {
                const importeTrabajo = parseDecimal(importe);
                const monedaOrigenTrabajo = String(monedaOrigen || "").trim().toUpperCase();
                const monedaDestinoTrabajo = String(monedaDestino || "").trim().toUpperCase();
                const tipoCambioTrabajo = parseDecimal(tipoCambio);

                if (importeTrabajo <= 0) {
                    return 0;
                }

                if (!monedaOrigenTrabajo || !monedaDestinoTrabajo || monedaOrigenTrabajo === monedaDestinoTrabajo) {
                    return roundTwo(importeTrabajo);
                }

                if (tipoCambioTrabajo <= 0) {
                    return 0;
                }

                if (monedaOrigenTrabajo === "USD" && monedaDestinoTrabajo === "PEN") {
                    return roundTwo(importeTrabajo * tipoCambioTrabajo);
                }

                if (monedaOrigenTrabajo === "PEN" && monedaDestinoTrabajo === "USD") {
                    return roundTwo(importeTrabajo / tipoCambioTrabajo);
                }

                return roundTwo(importeTrabajo);
            };

            const formatTipoCambioInput = (input) => {
                if (!input) {
                    return;
                }

                input.value = parseDecimal(input.value).toFixed(3);
            };

            const sincronizarTipoCambioDetalle = (row = null) => {
                const valorCabecera = Number(tipoCambioCabeceraEl?.value || 0);
                if (!Number.isFinite(valorCabecera) || valorCabecera <= 0) {
                    return;
                }

                const aplicar = (targetRow) => {
                    const input = targetRow?.querySelector(".js-tipo-cambio-linea");
                    if (input) {
                        input.value = valorCabecera.toFixed(3);
                    }
                };

                if (row) {
                    aplicar(row);
                    return;
                }

                Array.from(detalleBody?.querySelectorAll("tr") || []).forEach(aplicar);
            };

            const consultarTipoCambioCabecera = async (mostrarMensaje) => {
                const fecha = String(fechaEmisionEl?.value || "").trim();

                if (!fecha) {
                    if (mostrarMensaje) {
                        window.alert("Seleccione fecha antes de actualizar el tipo de cambio.");
                    }
                    return false;
                }

                const response = await fetch(`${obtenerTipoCambioUrl}?${new URLSearchParams({ fecha, idMoneda: "USD" }).toString()}`, { cache: "no-store" });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    if (mostrarMensaje) {
                        window.alert(payload.mensaje || "No se pudo obtener el tipo de cambio.");
                    }
                    return false;
                }

                if (!payload.encontrado) {
                    if (mostrarMensaje) {
                        window.alert(payload.mensaje || "No existe un tipo de cambio registrado para la fecha y moneda seleccionadas.");
                    }
                    return false;
                }

                if (tipoCambioCabeceraEl) {
                    tipoCambioCabeceraEl.value = Number(payload.tipoCambio || 0).toFixed(3);
                }
                sincronizarTipoCambioDetalle();
                actualizarAplicacionesComprobante(false);
                return true;
            };

            const obtenerPersonaCabecera = () => {
                const idPersona = Number.parseInt(String(personaIdInput?.value || ""), 10);
                const documentoTexto = personaDocumentoTexto?.textContent || "";
                const numeroDocumento = documentoTexto.replace("RUC/DNI:", "").trim();

                return {
                    idPersona: Number.isFinite(idPersona) && idPersona > 0 ? idPersona : null,
                    nombre: String(personaTexto?.value || "").trim(),
                    numeroDocumento: numeroDocumento && !numeroDocumento.startsWith("Sin ") ? numeroDocumento : ""
                };
            };

            const obtenerPersonaLinea = (row) => {
                const idInput = row?.querySelector(".js-persona-id-linea");
                const documentoInput = row?.querySelector(".js-numero-documento-linea");
                const textoInput = row?.querySelector(".js-persona-texto-linea");
                const idPersona = Number.parseInt(String(idInput?.value || ""), 10);

                return {
                    idPersona: Number.isFinite(idPersona) && idPersona > 0 ? idPersona : null,
                    numeroDocumento: String(documentoInput?.value || "").trim(),
                    nombre: String(textoInput?.value || "").trim()
                };
            };

            const asignarPersonaLinea = (row, persona) => {
                const personaActual = obtenerPersonaLinea(row);
                const idInput = row?.querySelector(".js-persona-id-linea");
                const documentoInput = row?.querySelector(".js-numero-documento-linea");
                const textoInput = row?.querySelector(".js-persona-texto-linea");

                if (idInput) {
                    idInput.value = persona?.idPersona || "";
                }
                if (documentoInput) {
                    documentoInput.value = persona?.numeroDocumento || "";
                }
                if (textoInput) {
                    textoInput.value = persona?.nombreCompleto || persona?.nombre || "Seleccione persona";
                }

                if (personaActual.idPersona !== (persona?.idPersona || null)) {
                    limpiarComprobanteLinea(row);
                }
            };

            const construirGlosaDetalleDesdeComprobante = (comprobante) => {
                const tipo = comprobante?.descripcionTipoComprobante || "Comprobante";
                const serie = comprobante?.serie || "";
                const numero = comprobante?.numero || "";
                const referencia = [serie, numero].filter(Boolean).join("-");
                return [tipo, referencia].filter(Boolean).join(" ").trim();
            };

            const limpiarComprobanteLinea = (row, limpiarMontos = false) => {
                const moduloInput = row?.querySelector(".js-modulo-comprobante-linea");
                const idRegistroInput = row?.querySelector(".js-id-registro-comprobante-linea");
                const tipoDocumentoInput = row?.querySelector(".js-tipo-documento-linea");
                const serieInput = row?.querySelector(".js-serie-linea");
                const referenciaInput = row?.querySelector(".js-referencia-linea");
                const monedaComprobanteInput = row?.querySelector(".js-comprobante-moneda-linea");
                const saldoOriginalInput = row?.querySelector(".js-comprobante-saldo-original-linea");
                const saldoSugeridoInput = row?.querySelector(".js-comprobante-saldo-sugerido-linea");
                const debeInput = row?.querySelector(".js-debe");
                const haberInput = row?.querySelector(".js-haber");

                if (moduloInput) {
                    moduloInput.value = "";
                }
                if (idRegistroInput) {
                    idRegistroInput.value = "";
                }
                if (tipoDocumentoInput) {
                    tipoDocumentoInput.value = "";
                }
                if (serieInput) {
                    serieInput.value = "";
                }
                if (referenciaInput) {
                    referenciaInput.value = "";
                }
                if (monedaComprobanteInput) {
                    monedaComprobanteInput.value = "";
                }
                if (saldoOriginalInput) {
                    saldoOriginalInput.value = "";
                }
                if (saldoSugeridoInput) {
                    saldoSugeridoInput.value = "";
                }
                if (limpiarMontos) {
                    if (debeInput) {
                        debeInput.value = "0.00";
                    }
                    if (haberInput) {
                        haberInput.value = "0.00";
                    }
                }
            };

            const aplicarSaldoPendienteComprobante = (row, saldoPendiente) => {
                const debeInput = row?.querySelector(".js-debe");
                const haberInput = row?.querySelector(".js-haber");
                const importe = Number(saldoPendiente || 0).toFixed(2);
                const moduloComprobante = String(row?.querySelector(".js-modulo-comprobante-linea")?.value || "").toUpperCase();

                if (moduloComprobante === "VEN") {
                    if (debeInput) {
                        debeInput.value = "0.00";
                    }
                    if (haberInput) {
                        haberInput.value = importe;
                    }
                    return;
                }

                if (moduloComprobante === "COM" || moduloComprobante === "DET" || moduloComprobante === "PER") {
                    if (debeInput) {
                        debeInput.value = importe;
                    }
                    if (haberInput) {
                        haberInput.value = "0.00";
                    }
                }
            };

            const obtenerMontoLinea = (row) => {
                const debe = parseDecimal(row?.querySelector(".js-debe")?.value);
                const haber = parseDecimal(row?.querySelector(".js-haber")?.value);
                return debe > 0 ? debe : haber;
            };

            const actualizarAplicacionComprobanteFila = (row, forzarReemplazo) => {
                const monedaComprobanteInput = row?.querySelector(".js-comprobante-moneda-linea");
                const saldoOriginalInput = row?.querySelector(".js-comprobante-saldo-original-linea");
                const saldoSugeridoInput = row?.querySelector(".js-comprobante-saldo-sugerido-linea");
                const monedaComprobante = String(monedaComprobanteInput?.value || "").trim().toUpperCase();
                const saldoOriginal = parseDecimal(saldoOriginalInput?.value);

                if (!monedaComprobante || saldoOriginal <= 0) {
                    return;
                }

                const importeSugeridoAnterior = parseDecimal(saldoSugeridoInput?.value);
                const importeActual = obtenerMontoLinea(row);
                const importeConvertido = convertirImporte(
                    saldoOriginal,
                    monedaComprobante,
                    obtenerCodigoMonedaCuenta(),
                    tipoCambioCabeceraEl?.value);

                if (forzarReemplazo || Math.abs(importeActual - importeSugeridoAnterior) < 0.005 || importeActual <= 0) {
                    aplicarSaldoPendienteComprobante(row, importeConvertido);
                }

                if (saldoSugeridoInput) {
                    saldoSugeridoInput.value = importeConvertido.toFixed(2);
                }
            };

            const actualizarAplicacionesComprobante = (forzarReemplazo = false) => {
                Array.from(detalleBody?.querySelectorAll("tr") || []).forEach((row) => {
                    actualizarAplicacionComprobanteFila(row, forzarReemplazo);
                });
                refreshRows();
            };

            const actualizarCuentaCorrientePreview = () => {
                const selected = cuentaCorrienteSelect?.selectedOptions?.[0];
                if (!selected) {
                    return;
                }

                if (cuentaCorrienteTexto) {
                    cuentaCorrienteTexto.value = selected.dataset.cuenta || "";
                }
                if (bancoTexto) {
                    bancoTexto.value = selected.dataset.banco || "";
                }
                if (monedaTexto) {
                    monedaTexto.value = selected.dataset.moneda || "";
                }
            };

            const renderOperaciones = () => {
                const movimiento = String(tipoMovimientoInput?.value || "I").toUpperCase();
                operacionTabs.forEach((button) => {
                    button.classList.toggle("active", button.dataset.movimiento === movimiento);
                });

                operacionGroups.forEach((group) => {
                    group.classList.toggle("is-hidden", group.dataset.treeGroup !== movimiento);
                });

                let operacionActivaTexto = "Seleccione una operacion bancaria";
                operacionButtons.forEach((button) => {
                    const visible = button.dataset.treeMovimiento === movimiento;
                    button.classList.toggle("is-hidden", !visible);
                    const isActive = visible && button.dataset.treeId === idOpeBancariaInput?.value;
                    button.classList.toggle("active", isActive);
                    if (isActive) {
                        operacionActivaTexto = button.dataset.treeTexto || operacionActivaTexto;
                    }
                });

                if (!idOpeBancariaInput?.value) {
                    const primerVisible = operacionButtons.find((button) => !button.classList.contains("is-hidden"));
                    if (primerVisible) {
                        idOpeBancariaInput.value = primerVisible.dataset.treeId || "";
                        tipoOperacionTextoInput.value = primerVisible.dataset.treeTexto || "";
                        primerVisible.classList.add("active");
                        operacionActivaTexto = primerVisible.dataset.treeTexto || operacionActivaTexto;
                    }
                }

                operacionTextoBox.textContent = tipoOperacionTextoInput?.value || operacionActivaTexto;
            };

            const refreshRows = () => {
                const rows = Array.from(detalleBody?.querySelectorAll("tr") || []);
                let totalDebe = 0;
                let totalHaber = 0;

                rows.forEach((row, index) => {
                    row.querySelectorAll("input, select, textarea, span").forEach((element) => {
                        ["name", "id", "for", "data-valmsg-for"].forEach((attribute) => {
                            const currentValue = element.getAttribute(attribute);
                            if (!currentValue) {
                                return;
                            }

                            const updatedValue = currentValue
                                .replaceAll("__index__", index)
                                .replace(/Formulario\.Detalles\[\d+\]/g, `Formulario.Detalles[${index}]`)
                                .replace(/Formulario_Detalles_\d+__/g, `Formulario_Detalles_${index}__`);

                            if (updatedValue !== currentValue) {
                                element.setAttribute(attribute, updatedValue);
                            }
                        });
                    });

                    const itemInput = row.querySelector('input[name$=".Item"]');
                    if (itemInput) {
                        itemInput.value = (index + 1).toString();
                    }

                    totalDebe += parseDecimal(row.querySelector(".js-debe")?.value);
                    totalHaber += parseDecimal(row.querySelector(".js-haber")?.value);
                });

                const totalOperacion = parseDecimal(importeTotalInput?.value);
                const tipoMovimiento = String(tipoMovimientoInput?.value || "I").toUpperCase();
                const totalDetalleBase = tipoMovimiento === "E"
                    ? totalDebe - totalHaber
                    : totalHaber - totalDebe;
                const totalDetalle = Math.abs(totalDetalleBase);
                const diferencia = totalOperacion - totalDetalle;
                const sentidoCorrecto = tipoMovimiento === "E"
                    ? totalDebe > totalHaber
                    : totalHaber > totalDebe;

                if (totalOperacionLabel) {
                    totalOperacionLabel.textContent = totalOperacion.toFixed(2);
                }
                if (totalDetalleLabel) {
                    totalDetalleLabel.textContent = totalDetalle.toFixed(2);
                }
                if (totalDiferenciaLabel) {
                    totalDiferenciaLabel.textContent = diferencia.toFixed(2);
                }

                const cuadrado = Math.abs(diferencia) < 0.005 && sentidoCorrecto;
                diferenciaCard?.classList.toggle("is-balanced", cuadrado);
                diferenciaCard?.classList.toggle("is-unbalanced", !cuadrado);
                if (totalDetalleEstado) {
                    totalDetalleEstado.textContent = tipoMovimiento === "E"
                        ? `Debe - Haber = ${totalDebe.toFixed(2)} - ${totalHaber.toFixed(2)}`
                        : `Haber - Debe = ${totalHaber.toFixed(2)} - ${totalDebe.toFixed(2)}`;
                }
                if (diferenciaEstado) {
                    if (cuadrado) {
                        diferenciaEstado.textContent = "Movimiento equilibrado";
                    } else if (Math.abs(diferencia) < 0.005) {
                        diferenciaEstado.textContent = tipoMovimiento === "E"
                            ? "Revisar sentido: en egresos el Debe debe superar al Haber."
                            : "Revisar sentido: en ingresos el Haber debe superar al Debe.";
                    } else {
                        diferenciaEstado.textContent = "Revisar diferencia del movimiento";
                    }
                }
            };

            const bindRow = (row) => {
                row.querySelector(".js-quitar-linea")?.addEventListener("click", () => {
                    if ((detalleBody?.querySelectorAll("tr").length || 0) <= 1) {
                        return;
                    }

                    row.remove();
                    refreshRows();
                });

                row.querySelector(".js-abrir-cuenta-modal")?.addEventListener("click", () => {
                    rowCuentaActiva = row;
                    cuentaSeleccion = null;
                    cargarCuentas();
                    cuentaModal?.show();
                });

                row.querySelector(".js-abrir-centro-modal")?.addEventListener("click", () => {
                    rowCentroActiva = row;
                    centroSeleccion = null;
                    cargarCentros();
                    centroModal?.show();
                });

                row.querySelector(".js-abrir-persona-linea-modal")?.addEventListener("click", async () => {
                    rowPersonaActiva = row;
                    personaSeleccion = null;
                    await cargarPersonas();
                    personaModal?.show();
                });

                row.querySelector(".js-abrir-comprobante-modal")?.addEventListener("click", async () => {
                    const personaLinea = obtenerPersonaLinea(row);
                    if (!personaLinea.idPersona) {
                        window.alert("Seleccione una persona en la linea antes de buscar comprobantes.");
                        return;
                    }

                    rowComprobanteActiva = row;
                    comprobanteSeleccion = null;
                    await cargarComprobantes(personaLinea.idPersona);
                    comprobanteModal?.show();
                });

                row.querySelector(".js-limpiar-centro")?.addEventListener("click", () => {
                    const codigo = row.querySelector(".js-centro-costo-codigo");
                    const texto = row.querySelector(".js-centro-costo-texto");
                    if (codigo) {
                        codigo.value = "";
                    }
                    if (texto) {
                        texto.value = "";
                    }
                });

                row.querySelector(".js-actualizar-tc-linea")?.addEventListener("click", async () => {
                    try {
                        const actualizado = await consultarTipoCambioCabecera(true);
                        if (!actualizado) {
                            return;
                        }
                        sincronizarTipoCambioDetalle(row);
                    } catch (error) {
                        console.warn(error);
                        window.alert("No se pudo obtener el tipo de cambio.");
                    }
                });
            };

            const marcarFilaSeleccion = (tbody, selectedRow) => {
                Array.from(tbody.querySelectorAll("tr")).forEach((row) => {
                    row.classList.toggle("is-selected", row === selectedRow);
                });
            };

            const renderPersonas = (items) => {
                personaResultados.innerHTML = "";
                if (!items.length) {
                    personaResultados.innerHTML = `<tr><td colspan="5"><div class="app-empty-state app-empty-state-inline"><i class="bi bi-person"></i><div><strong>No hay personas con ese filtro</strong><p>Ajusta la busqueda para continuar.</p></div></div></td></tr>`;
                    return;
                }

                items.forEach((item) => {
                    const row = document.createElement("tr");
                    row.innerHTML = `
                        <td class="workspace-lookup-select-cell"><input type="radio" name="personaSeleccion" /></td>
                        <td>${item.numeroDocumento || ""}</td>
                        <td>${item.nombreCompleto || ""}</td>
                        <td>${item.tipoPersona || ""}</td>
                        <td>${item.nombreTipoDocumento || ""}</td>`;
                    row.addEventListener("click", () => {
                        personaSeleccion = item;
                        marcarFilaSeleccion(personaResultados, row);
                        row.querySelector("input").checked = true;
                    });
                    personaResultados.appendChild(row);
                });
            };

            const renderComprobantes = (items) => {
                comprobanteResultados.innerHTML = "";
                if (!items.length) {
                    comprobanteResultados.innerHTML = `<tr><td colspan="10"><div class="app-empty-state app-empty-state-inline"><i class="bi bi-receipt"></i><div><strong>No hay comprobantes disponibles</strong><p>Selecciona una persona con saldo pendiente o ajusta el filtro.</p></div></div></td></tr>`;
                    return;
                }

                items.forEach((item) => {
                    const row = document.createElement("tr");
                    row.innerHTML = `
                        <td class="workspace-lookup-select-cell"><input type="radio" name="comprobanteSeleccion" /></td>
                        <td>${item.moduloOperacionTexto || item.moduloOperacion || ""}</td>
                        <td>${item.fechaEmision || ""}</td>
                        <td>${item.nombrePersona || ""}</td>
                        <td>${item.descripcionTipoComprobante || ""}</td>
                        <td>${item.serie || ""}</td>
                        <td>${item.numero || ""}</td>
                        <td>${item.codigoMoneda || ""}</td>
                        <td>${Number(item.importeTotal || 0).toFixed(2)}</td>
                        <td>${Number(item.saldo || 0).toFixed(2)}</td>`;
                    row.addEventListener("click", () => {
                        comprobanteSeleccion = item;
                        marcarFilaSeleccion(comprobanteResultados, row);
                        row.querySelector("input").checked = true;
                    });
                    comprobanteResultados.appendChild(row);
                });
            };

            const renderCuentas = (items) => {
                cuentaResultados.innerHTML = "";
                if (!items.length) {
                    cuentaResultados.innerHTML = `<tr><td colspan="4"><div class="app-empty-state app-empty-state-inline"><i class="bi bi-search"></i><div><strong>No hay cuentas con ese filtro</strong><p>Refina el codigo, nombre o nivel.</p></div></div></td></tr>`;
                    return;
                }

                items.forEach((item) => {
                    const row = document.createElement("tr");
                    row.innerHTML = `
                        <td class="workspace-lookup-select-cell"><input type="radio" name="cuentaSeleccion" /></td>
                        <td>${item.codigoCuenta || ""}</td>
                        <td>${item.nombreCuenta || ""}</td>
                        <td>${item.nivelCuenta || ""}</td>`;
                    row.addEventListener("click", () => {
                        cuentaSeleccion = item;
                        marcarFilaSeleccion(cuentaResultados, row);
                        row.querySelector("input").checked = true;
                    });
                    cuentaResultados.appendChild(row);
                });
            };

            const renderCentros = (items) => {
                centroResultados.innerHTML = "";
                if (!items.length) {
                    centroResultados.innerHTML = `<tr><td colspan="3"><div class="app-empty-state app-empty-state-inline"><i class="bi bi-diagram-2"></i><div><strong>No hay centros con ese filtro</strong><p>Refina la busqueda para continuar.</p></div></div></td></tr>`;
                    return;
                }

                items.forEach((item) => {
                    const row = document.createElement("tr");
                    row.innerHTML = `
                        <td class="workspace-lookup-select-cell"><input type="radio" name="centroSeleccion" /></td>
                        <td>${item.codigoCentroCosto || ""}</td>
                        <td>${item.nombreCentroCosto || ""}</td>`;
                    row.addEventListener("click", () => {
                        centroSeleccion = item;
                        marcarFilaSeleccion(centroResultados, row);
                        row.querySelector("input").checked = true;
                    });
                    centroResultados.appendChild(row);
                });
            };

            const cargarPersonas = async () => {
                const params = new URLSearchParams();
                const filtro = String(personaFiltro?.value || "").trim();
                if (filtro.length >= 2) {
                    params.append("textoBusqueda", filtro);
                }

                const response = await fetch(`${buscarPersonasUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                renderPersonas(payload.items || []);
            };

            const cargarComprobantes = async (idPersonaBase = null) => {
                const idPersona = Number.parseInt(String(idPersonaBase || ""), 10);
                if (!Number.isFinite(idPersona) || idPersona <= 0) {
                    renderComprobantes([]);
                    return;
                }

                const params = new URLSearchParams({ idPersona: idPersona.toString() });
                const filtro = String(comprobanteFiltro?.value || "").trim();
                if (filtro.length >= 2) {
                    params.append("textoBusqueda", filtro);
                }

                const response = await fetch(`${buscarComprobantesDetalleUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                renderComprobantes(payload.ok === false ? [] : payload.items || []);
            };

            const cargarCuentas = async () => {
                const params = new URLSearchParams({ soloMovimiento: "true", tamanoPagina: "100" });
                const filtro = String(cuentaFiltro?.value || "").trim();
                const nivel = String(nivelCuentaFiltro?.value || "").trim();
                if (filtro.length >= 2) {
                    params.append("textoBusqueda", filtro);
                }
                if (nivel) {
                    params.append("nivelCuenta", nivel);
                }

                const response = await fetch(`${buscarCuentasUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                renderCuentas(payload.items || []);
            };

            const cargarCentros = async () => {
                const params = new URLSearchParams({ tamanoPagina: "100" });
                const filtro = String(centroFiltro?.value || "").trim();
                if (filtro.length >= 2) {
                    params.append("textoBusqueda", filtro);
                }

                const response = await fetch(`${buscarCentrosUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                renderCentros(payload.items || []);
            };

            operacionTabs.forEach((button) => {
                button.addEventListener("click", () => {
                    if (tipoMovimientoInput) {
                        tipoMovimientoInput.value = button.dataset.movimiento || "I";
                    }
                    if (idOpeBancariaInput) {
                        idOpeBancariaInput.value = "";
                    }
                    if (tipoOperacionTextoInput) {
                        tipoOperacionTextoInput.value = "";
                    }
                    renderOperaciones();
                });
            });

            operacionButtons.forEach((button) => {
                button.addEventListener("click", () => {
                    if (button.classList.contains("is-hidden")) {
                        return;
                    }

                    idOpeBancariaInput.value = button.dataset.treeId || "";
                    tipoOperacionTextoInput.value = button.dataset.treeTexto || "";
                    renderOperaciones();
                });
            });

            cuentaCorrienteSelect?.addEventListener("change", () => {
                actualizarCuentaCorrientePreview();
                consultarTipoCambioCabecera(false).catch((error) => console.warn(error));
                actualizarAplicacionesComprobante(false);
            });
            fechaEmisionEl?.addEventListener("input", () => {
                consultarTipoCambioCabecera(false).catch((error) => console.warn(error));
            });
            fechaEmisionEl?.addEventListener("change", () => {
                consultarTipoCambioCabecera(false).catch((error) => console.warn(error));
            });
            formatTipoCambioInput(tipoCambioCabeceraEl);
            Array.from(detalleBody?.querySelectorAll(".js-tipo-cambio-linea") || []).forEach((input) => formatTipoCambioInput(input));
            form?.addEventListener("blur", (event) => {
                const input = event.target;
                if (input instanceof HTMLInputElement && input.matches(".js-tipo-cambio-cabecera, .js-tipo-cambio-linea")) {
                    formatTipoCambioInput(input);
                    if (input.matches(".js-tipo-cambio-cabecera")) {
                        sincronizarTipoCambioDetalle();
                    }
                }
            }, true);
            form?.addEventListener("change", (event) => {
                const input = event.target;
                if (input instanceof HTMLInputElement && input.matches(".js-tipo-cambio-cabecera, .js-tipo-cambio-linea")) {
                    formatTipoCambioInput(input);
                    if (input.matches(".js-tipo-cambio-cabecera")) {
                        sincronizarTipoCambioDetalle();
                    }
                }
            });
            actualizarTipoCambioButton?.addEventListener("click", async () => {
                try {
                    await consultarTipoCambioCabecera(true);
                } catch (error) {
                    console.warn(error);
                    window.alert("No se pudo obtener el tipo de cambio.");
                }
            });
            consultarTipoCambioCabecera(false).catch((error) => console.warn(error));
            importeTotalInput?.addEventListener("input", refreshRows);

            agregarLineaButton?.addEventListener("click", () => {
                const index = detalleBody?.querySelectorAll("tr").length || 0;
                const html = detalleTemplate.innerHTML
                    .replaceAll("__index__", index)
                    .replaceAll("__item__", (index + 1).toString());
                detalleBody?.insertAdjacentHTML("beforeend", html);
                const row = detalleBody?.lastElementChild;
                if (row) {
                    const personaCabecera = obtenerPersonaCabecera();
                    if (personaCabecera.idPersona) {
                        asignarPersonaLinea(row, {
                            idPersona: personaCabecera.idPersona,
                            nombreCompleto: personaCabecera.nombre,
                            numeroDocumento: personaCabecera.numeroDocumento
                        });
                    }
                    bindRow(row);
                    sincronizarTipoCambioDetalle(row);
                }
                refreshRows();
            });

            abrirPersonaModal?.addEventListener("click", async () => {
                personaSeleccion = null;
                await cargarPersonas();
                personaModal?.show();
            });

            limpiarPersonaButton?.addEventListener("click", () => {
                personaIdInput.value = "";
                personaTexto.value = "Sin persona vinculada";
                personaDocumentoTexto.textContent = "Sin RUC/DNI relacionado";
            });

            personaFiltro?.addEventListener("input", () => {
                if (personaBusquedaProgramada) {
                    window.clearTimeout(personaBusquedaProgramada);
                }
                personaBusquedaProgramada = window.setTimeout(cargarPersonas, 250);
            });

            cuentaFiltro?.addEventListener("input", () => {
                if (cuentaBusquedaProgramada) {
                    window.clearTimeout(cuentaBusquedaProgramada);
                }
                cuentaBusquedaProgramada = window.setTimeout(cargarCuentas, 250);
            });

            nivelCuentaFiltro?.addEventListener("change", cargarCuentas);

            centroFiltro?.addEventListener("input", () => {
                if (centroBusquedaProgramada) {
                    window.clearTimeout(centroBusquedaProgramada);
                }
                centroBusquedaProgramada = window.setTimeout(cargarCentros, 250);
            });

            form.addEventListener("submit", (event) => {
                refreshRows();

                const totalOperacion = parseDecimal(importeTotalInput?.value);
                const totalDetalle = parseDecimal(totalDetalleLabel?.textContent);
                const diferencia = Math.abs(totalOperacion - totalDetalle);
                let totalDebe = 0;
                let totalHaber = 0;

                detalleBody?.querySelectorAll("tr").forEach((row) => {
                    totalDebe += parseDecimal(row.querySelector(".js-debe")?.value);
                    totalHaber += parseDecimal(row.querySelector(".js-haber")?.value);
                });

                const tipoMovimiento = String(tipoMovimientoInput?.value || "I").toUpperCase();
                const sentidoCorrecto = tipoMovimiento === "E"
                    ? totalDebe > totalHaber
                    : totalHaber > totalDebe;

                if (diferencia >= 0.005) {
                    event.preventDefault();
                    window.alert("No puede guardar mientras exista diferencia entre Total Operacion y Total Detalle.");
                    return;
                }

                if (!sentidoCorrecto) {
                    event.preventDefault();
                    window.alert(tipoMovimiento === "E"
                        ? "En egresos, el detalle debe tener mayor Debe que Haber para compensar la cuenta bancaria."
                        : "En ingresos, el detalle debe tener mayor Haber que Debe para compensar la cuenta bancaria.");
                }
            });

            document.getElementById("aceptarPersona")?.addEventListener("click", () => {
                if (personaSeleccion) {
                    if (rowPersonaActiva) {
                        asignarPersonaLinea(rowPersonaActiva, personaSeleccion);
                        rowPersonaActiva = null;
                    }
                    else
                    {
                        personaIdInput.value = personaSeleccion.idPersona || "";
                        personaTexto.value = personaSeleccion.nombreCompleto || "";
                        personaDocumentoTexto.textContent = `RUC/DNI: ${personaSeleccion.numeroDocumento || ""}`;
                    }
                }
                personaModal?.hide();
            });

            comprobanteFiltro?.addEventListener("input", () => {
                if (comprobanteBusquedaProgramada) {
                    window.clearTimeout(comprobanteBusquedaProgramada);
                }
                comprobanteBusquedaProgramada = window.setTimeout(() => {
                    const personaLinea = rowComprobanteActiva ? obtenerPersonaLinea(rowComprobanteActiva) : null;
                    cargarComprobantes(personaLinea?.idPersona ?? null);
                }, 250);
            });

            document.getElementById("aceptarCuenta")?.addEventListener("click", () => {
                if (String(cuentaSeleccion?.nivelCuenta || "") !== "5") {
                    window.alert("Seleccione una cuenta contable de nivel 5.");
                    return;
                }

                if (cuentaSeleccion && rowCuentaActiva) {
                    const idInput = rowCuentaActiva.querySelector(".js-cuenta-id");
                    const textoInput = rowCuentaActiva.querySelector(".js-cuenta-texto");
                    const requiereInput = rowCuentaActiva.querySelector(".js-requiere-centro-costo");
                    const centroTexto = rowCuentaActiva.querySelector(".js-centro-costo-texto");
                    if (idInput) {
                        idInput.value = cuentaSeleccion.idPlanCuenta || "";
                    }
                    if (textoInput) {
                        textoInput.value = `${cuentaSeleccion.codigoCuenta || ""} - ${cuentaSeleccion.nombreCuenta || ""}`;
                    }
                    if (requiereInput) {
                        requiereInput.value = cuentaSeleccion.requiereCentroCosto ? "true" : "false";
                    }
                    if (centroTexto && cuentaSeleccion.requiereCentroCosto) {
                        centroTexto.placeholder = "Seleccione centro de costo obligatorio";
                    }
                }
                cuentaModal?.hide();
            });

            document.getElementById("aceptarCentro")?.addEventListener("click", () => {
                if (centroSeleccion && rowCentroActiva) {
                    const codigoInput = rowCentroActiva.querySelector(".js-centro-costo-codigo");
                    const textoInput = rowCentroActiva.querySelector(".js-centro-costo-texto");
                    if (codigoInput) {
                        codigoInput.value = centroSeleccion.codigoCentroCosto || "";
                    }
                    if (textoInput) {
                        textoInput.value = `${centroSeleccion.codigoCentroCosto || ""} - ${centroSeleccion.nombreCentroCosto || ""}`;
                    }
                }
                centroModal?.hide();
            });

            document.getElementById("aceptarComprobante")?.addEventListener("click", () => {
                if (comprobanteSeleccion && rowComprobanteActiva) {
                    const cuentaIdInput = rowComprobanteActiva.querySelector(".js-cuenta-id");
                    const cuentaTextoInput = rowComprobanteActiva.querySelector(".js-cuenta-texto");
                    const moduloInput = rowComprobanteActiva.querySelector(".js-modulo-comprobante-linea");
                    const idRegistroInput = rowComprobanteActiva.querySelector(".js-id-registro-comprobante-linea");
                    const tipoDocumentoInput = rowComprobanteActiva.querySelector(".js-tipo-documento-linea");
                    const serieInput = rowComprobanteActiva.querySelector(".js-serie-linea");
                    const referenciaInput = rowComprobanteActiva.querySelector(".js-referencia-linea");
                    const tipoCambioInput = rowComprobanteActiva.querySelector(".js-tipo-cambio-linea");
                    const glosaDetalleInput = rowComprobanteActiva.querySelector('input[name$=".GlosaDetalle"]');
                    if (moduloInput) {
                        moduloInput.value = comprobanteSeleccion.moduloOperacion || "";
                    }
                    if (idRegistroInput) {
                        idRegistroInput.value = comprobanteSeleccion.idRegistro || "";
                    }
                    if (cuentaIdInput && comprobanteSeleccion.cuentaContable?.idPlanCuenta) {
                        cuentaIdInput.value = comprobanteSeleccion.cuentaContable.idPlanCuenta;
                    }
                    if (cuentaTextoInput && comprobanteSeleccion.cuentaContable?.cuentaTexto) {
                        cuentaTextoInput.value = comprobanteSeleccion.cuentaContable.cuentaTexto;
                    }
                    if (tipoDocumentoInput) {
                        tipoDocumentoInput.value = comprobanteSeleccion.tipoComprobante || "";
                    }
                    if (serieInput) {
                        serieInput.value = comprobanteSeleccion.serie || "";
                    }
                    if (referenciaInput) {
                        referenciaInput.value = comprobanteSeleccion.numero || "";
                    }
                    if (tipoCambioInput) {
                        tipoCambioInput.value = Number(parseDecimal(tipoCambioCabeceraEl?.value) || 0).toFixed(3);
                    }
                    if (glosaDetalleInput && !glosaDetalleInput.value) {
                        glosaDetalleInput.value = construirGlosaDetalleDesdeComprobante(comprobanteSeleccion);
                    }
                    const monedaComprobanteInput = rowComprobanteActiva.querySelector(".js-comprobante-moneda-linea");
                    const saldoOriginalInput = rowComprobanteActiva.querySelector(".js-comprobante-saldo-original-linea");
                    const saldoSugeridoInput = rowComprobanteActiva.querySelector(".js-comprobante-saldo-sugerido-linea");
                    if (monedaComprobanteInput) {
                        monedaComprobanteInput.value = String(comprobanteSeleccion.codigoMoneda || "").trim().toUpperCase();
                    }
                    if (saldoOriginalInput) {
                        saldoOriginalInput.value = Number(comprobanteSeleccion.saldo || 0).toFixed(2);
                    }
                    if (saldoSugeridoInput) {
                        saldoSugeridoInput.value = "0.00";
                    }
                    actualizarAplicacionComprobanteFila(rowComprobanteActiva, true);
                    refreshRows();
                }
                comprobanteModal?.hide();
            });

            detalleBody?.querySelectorAll("tr").forEach(bindRow);
            detalleBody?.addEventListener("input", refreshRows);
            detalleBody?.addEventListener("change", refreshRows);

            actualizarCuentaCorrientePreview();
            renderOperaciones();
            refreshRows();
        })();
    </script>
}
