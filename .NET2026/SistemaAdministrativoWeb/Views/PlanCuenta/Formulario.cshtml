@model SistemaAdministrativoWeb.ViewModels.Contabilidad.PlanCuentaIndexViewModel

@* =============================================
   Author:        FRANCO LARA
   Create date:   18/06/2026
   Description:   Reemplaza combo de cuenta padre por ayuda modal reutilizable.
   ============================================= *@

@* =============================================
   Author:        FRANCO LARA
   Create date:   22/06/2026
   Description:   Cambia la ayuda de cuenta padre a carga inicial Top 100 con filtro remoto.
   ============================================= *@

@* =============================================
   Author:        FRANCO LARA
   Create date:   23/06/2026
   Description:   Reemplaza los botones de ayuda de cuenta padre por iconos de lupa y brocha.
   ============================================= *@

@* Firma: FRANCO LARA - 25/06/2026 | Agrega la configuracion de cuentas destino y contrapartida desde plan de cuentas para cuentas operativas o de ultimo nivel usando la misma ayuda contable del mantenimiento central. *@
@* Firma: FRANCO LARA - 02/07/2026 | Ajusta el texto visible del indicador de analisis en plan de cuentas y muestra su validacion directamente en el formulario cuando la cuenta no cumple las reglas contables. *@

@{
    ViewData["Title"] = Model.Formulario.IdPlanCuenta.HasValue ? "Editar cuenta contable" : "Registrar cuenta contable";
    ViewData["AdminShell"] = true;
    var cuentaPadreTexto = string.IsNullOrWhiteSpace(Model.Formulario.CuentaPadreTexto)
        ? "Sin padre"
        : Model.Formulario.CuentaPadreTexto;
    var mostrarDestinos = Model.Formulario.PermiteConfigurarDestinos || Model.Formulario.AceptaMovimiento;
    var forzarMostrarDestinos = Model.Formulario.PermiteConfigurarDestinos || Model.Formulario.ConfiguracionDestino.Detalles.Count > 0;
}

<section class="dashboard-shell">
    <section class="workspace-window">
        <div class="workspace-window-head">
            <div>
                <span class="workspace-window-kicker">Formulario</span>
                <h1>@ViewData["Title"]</h1>
                <p>Completa los datos base de la cuenta y su comportamiento dentro del circuito contable.</p>
            </div>
            <div class="workspace-window-badge">
                <strong>@(Model.Formulario.IdPlanCuenta.HasValue ? "Edicion" : "Nueva")</strong>
                <span>@(Model.Formulario.IdPlanCuenta.HasValue ? "actualizacion directa" : "alta en catalogo")</span>
            </div>
        </div>

        <div class="workspace-window-body">
            <form asp-action="Guardar" method="post" id="planCuentaForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Formulario.IdPlanCuenta" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="workspace-form-grid">
                    <div class="workspace-field">
                        <label asp-for="Formulario.IdPlanCuentaPadre" class="form-label">Cuenta padre</label>
                        <input type="hidden" asp-for="Formulario.IdPlanCuentaPadre" id="cuentaPadreId" />
                        <div class="workspace-lookup-control">
                            <input id="cuentaPadreTexto" class="form-control" value="@cuentaPadreTexto" readonly />
                            <button type="button" class="btn btn-outline-secondary workspace-icon-button" data-bs-toggle="modal" data-bs-target="#cuentaPadreModal" title="Buscar cuenta padre" aria-label="Buscar cuenta padre"><i class="bi bi-search"></i></button>
                            <button type="button" class="btn btn-outline-secondary workspace-icon-button" id="limpiarCuentaPadre" title="Limpiar cuenta padre" aria-label="Limpiar cuenta padre"><i class="bi bi-brush"></i></button>
                        </div>
                        <div class="form-text">El nivel se calcula segun la cuenta padre y la longitud se valida con parametros contables.</div>
                    </div>
                    <div class="workspace-field">
                        <label asp-for="Formulario.CodigoCuenta" class="form-label">Codigo cuenta</label>
                        <input asp-for="Formulario.CodigoCuenta" class="form-control" />
                        <span asp-validation-for="Formulario.CodigoCuenta" class="text-danger"></span>
                    </div>
                    <div class="workspace-field">
                        <label asp-for="Formulario.NombreCuenta" class="form-label">Nombre cuenta</label>
                        <input asp-for="Formulario.NombreCuenta" class="form-control" />
                        <span asp-validation-for="Formulario.NombreCuenta" class="text-danger"></span>
                    </div>
                    <div class="workspace-field">
                        <label asp-for="Formulario.ColBalance" class="form-label">Columna balance</label>
                        <select asp-for="Formulario.ColBalance" class="form-select">
                            <option value="">Seleccione</option>
                            <option value="S">S - Saldo</option>
                            <option value="I">I - Inventario</option>
                            <option value="N">N - Naturaleza</option>
                            <option value="F">F - Funcion</option>
                            <option value="R">R - Resultado</option>
                        </select>
                        <span asp-validation-for="Formulario.ColBalance" class="text-danger"></span>
                    </div>
                    <div class="workspace-field">
                        <label asp-for="Formulario.IdMoneda" class="form-label">Moneda cuenta</label>
                        <select asp-for="Formulario.IdMoneda" class="form-select">
                            <option value="">Sin moneda fija</option>
                            @foreach (var moneda in Model.Monedas)
                            {
                                <option value="@moneda.Valor">@moneda.Texto</option>
                            }
                        </select>
                        <span asp-validation-for="Formulario.IdMoneda" class="text-danger"></span>
                    </div>
                    <div class="workspace-field">
                        <label asp-for="Formulario.TipoCambio" class="form-label">Tipo cambio</label>
                        <select asp-for="Formulario.TipoCambio" class="form-select">
                            <option value="">Sin tipo de cambio</option>
                            <option value="V">Venta</option>
                            <option value="C">Compra</option>
                        </select>
                        <span asp-validation-for="Formulario.TipoCambio" class="text-danger"></span>
                    </div>
                </div>

                <div class="workspace-check-grid">
                    <label class="workspace-check">
                        <input asp-for="Formulario.AceptaMovimiento" class="form-check-input" id="aceptaMovimiento" />
                        <span>Acepta movimiento</span>
                    </label>
                    <label class="workspace-check">
                        <input asp-for="Formulario.GeneraDiferenciaPorAnalisis" class="form-check-input" />
                        <span>Analisis</span>
                    </label>
                    <label class="workspace-check">
                        <input asp-for="Formulario.RequiereCentroCosto" class="form-check-input" />
                        <span>Requiere centro de costo</span>
                    </label>
                    <label class="workspace-check">
                        <input asp-for="Formulario.Estado" class="form-check-input" />
                        <span>Cuenta activa</span>
                    </label>
                </div>
                <span asp-validation-for="Formulario.GeneraDiferenciaPorAnalisis" class="text-danger d-block mb-2"></span>
                <div class="form-text mb-4">Marca esta opcion en cuentas de movimiento que deban trabajar por analisis, separando documentos o auxiliares en lugar de usar saldo global.</div>

                <section class="workspace-section @(mostrarDestinos ? string.Empty : "d-none")" id="destino-config-section" data-force-visible="@(forzarMostrarDestinos ? "true" : "false")">
                    <div class="workspace-section-head">
                        <div>
                            <h2>Cuentas destino</h2>
                            <p>Define destino y contrapartida para esta cuenta. Solo aplica a cuentas operativas o de ultimo nivel.</p>
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="agregar-destino">Agregar tramo</button>
                    </div>

                    <div class="workspace-form-grid mb-3">
                        <div class="workspace-field workspace-field-span-2">
                            <label asp-for="Formulario.ConfiguracionDestino.Observacion" class="form-label">Observacion</label>
                            <textarea asp-for="Formulario.ConfiguracionDestino.Observacion" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Formulario.ConfiguracionDestino.Observacion" class="text-danger"></span>
                        </div>
                        <div class="workspace-field">
                            <label class="form-label d-block">Estado</label>
                            <label class="workspace-check">
                                <input asp-for="Formulario.ConfiguracionDestino.Activo" class="form-check-input" />
                                <span>Configuracion activa</span>
                            </label>
                        </div>
                    </div>

                    <div class="table-responsive workspace-table-wrap">
                        <table class="table align-middle app-table workspace-table" id="destino-table">
                            <thead>
                                <tr>
                                    <th>Orden</th>
                                    <th>Cuenta destino</th>
                                    <th>Contrapartida</th>
                                    <th>%</th>
                                    <th>Activo</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Formulario.ConfiguracionDestino.Detalles.Count; i++)
                                {
                                    <tr>
                                        <td class="detalle-orden-cell">
                                            <input asp-for="Formulario.ConfiguracionDestino.Detalles[i].Orden" class="form-control" readonly />
                                            <span asp-validation-for="Formulario.ConfiguracionDestino.Detalles[i].Orden" class="text-danger"></span>
                                        </td>
                                        <td>
                                            <input type="hidden" asp-for="Formulario.ConfiguracionDestino.Detalles[i].IdPlanCuentaDestinoCargo" class="js-destino-cargo-id" />
                                            <div class="workspace-lookup-control workspace-lookup-control-compact">
                                                <input class="form-control js-destino-cargo-texto" value="@(string.IsNullOrWhiteSpace(Model.Formulario.ConfiguracionDestino.Detalles[i].CuentaDestinoCargoTexto) ? "Seleccione cuenta" : Model.Formulario.ConfiguracionDestino.Detalles[i].CuentaDestinoCargoTexto)" readonly />
                                                <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-open-destino-cargo-modal" title="Buscar cuenta destino" aria-label="Buscar cuenta destino"><i class="bi bi-search"></i></button>
                                            </div>
                                            <span asp-validation-for="Formulario.ConfiguracionDestino.Detalles[i].IdPlanCuentaDestinoCargo" class="text-danger"></span>
                                        </td>
                                        <td>
                                            <input type="hidden" asp-for="Formulario.ConfiguracionDestino.Detalles[i].IdPlanCuentaDestinoAbono" class="js-destino-abono-id" />
                                            <div class="workspace-lookup-control workspace-lookup-control-compact">
                                                <input class="form-control js-destino-abono-texto" value="@(string.IsNullOrWhiteSpace(Model.Formulario.ConfiguracionDestino.Detalles[i].CuentaDestinoAbonoTexto) ? "Seleccione cuenta" : Model.Formulario.ConfiguracionDestino.Detalles[i].CuentaDestinoAbonoTexto)" readonly />
                                                <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-open-destino-abono-modal" title="Buscar contrapartida" aria-label="Buscar contrapartida"><i class="bi bi-search"></i></button>
                                            </div>
                                            <span asp-validation-for="Formulario.ConfiguracionDestino.Detalles[i].IdPlanCuentaDestinoAbono" class="text-danger"></span>
                                        </td>
                                        <td class="detalle-porcentaje-cell">
                                            <input asp-for="Formulario.ConfiguracionDestino.Detalles[i].Porcentaje" class="form-control js-destino-porcentaje" />
                                            <span asp-validation-for="Formulario.ConfiguracionDestino.Detalles[i].Porcentaje" class="text-danger"></span>
                                        </td>
                                        <td class="text-center">
                                            <input asp-for="Formulario.ConfiguracionDestino.Detalles[i].Activo" class="form-check-input js-destino-activo" />
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-outline-secondary btn-sm js-remove-destino-row">Quitar</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="workspace-inline-note">
                        <strong>Total activo:</strong> <span id="destino-porcentaje-total">0.0000</span>
                    </div>
                </section>

                <div class="workspace-actions">
                    <button type="submit" class="btn btn-primary">Guardar cuenta</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </section>
</section>

<template id="destino-row-template">
    <tr>
        <td class="detalle-orden-cell">
            <input name="Formulario.ConfiguracionDestino.Detalles[__index__].Orden" class="form-control" readonly value="0" />
        </td>
        <td>
            <input type="hidden" name="Formulario.ConfiguracionDestino.Detalles[__index__].IdPlanCuentaDestinoCargo" class="js-destino-cargo-id" />
            <div class="workspace-lookup-control workspace-lookup-control-compact">
                <input class="form-control js-destino-cargo-texto" value="Seleccione cuenta" readonly />
                <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-open-destino-cargo-modal" title="Buscar cuenta destino" aria-label="Buscar cuenta destino"><i class="bi bi-search"></i></button>
            </div>
        </td>
        <td>
            <input type="hidden" name="Formulario.ConfiguracionDestino.Detalles[__index__].IdPlanCuentaDestinoAbono" class="js-destino-abono-id" />
            <div class="workspace-lookup-control workspace-lookup-control-compact">
                <input class="form-control js-destino-abono-texto" value="Seleccione cuenta" readonly />
                <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-open-destino-abono-modal" title="Buscar contrapartida" aria-label="Buscar contrapartida"><i class="bi bi-search"></i></button>
            </div>
        </td>
        <td class="detalle-porcentaje-cell">
            <input name="Formulario.ConfiguracionDestino.Detalles[__index__].Porcentaje" class="form-control js-destino-porcentaje" value="0" />
        </td>
        <td class="text-center">
            <input name="Formulario.ConfiguracionDestino.Detalles[__index__].Activo" class="form-check-input js-destino-activo" type="checkbox" value="true" checked />
            <input name="Formulario.ConfiguracionDestino.Detalles[__index__].Activo" type="hidden" value="false" />
        </td>
        <td class="text-end">
            <button type="button" class="btn btn-outline-secondary btn-sm js-remove-destino-row">Quitar</button>
        </td>
    </tr>
</template>

<div class="modal fade workspace-modal" id="cuentaPadreModal" tabindex="-1" aria-labelledby="cuentaPadreModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content workspace-modal-content">
            <div class="modal-header workspace-modal-header">
                <div>
                    <span class="workspace-window-kicker">Ayuda contable</span>
                    <h2 class="workspace-modal-title" id="cuentaPadreModalLabel">Seleccionar cuenta padre</h2>
                    <p class="workspace-modal-subtitle">Busca por codigo, nombre o nivel. La cuenta elegida define el nivel de la nueva cuenta.</p>
                </div>
                <button type="button" class="btn-close workspace-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body workspace-modal-body">
                <div class="workspace-filter-card mt-0">
                    <div class="workspace-filter-grid">
                        <div class="workspace-field workspace-field-span-2">
                            <label class="form-label" for="cuentaPadreFiltro">Filtro</label>
                            <input id="cuentaPadreFiltro" class="form-control" placeholder="Codigo o nombre de cuenta" autocomplete="off" />
                        </div>
                        <div class="workspace-field">
                            <label class="form-label" for="cuentaPadreNivelFiltro">Nivel</label>
                            <select id="cuentaPadreNivelFiltro" class="form-select">
                                <option value="">Todos</option>
                                @for (var nivel = 1; nivel <= 5; nivel++)
                                {
                                    <option value="@nivel">@nivel</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="table-responsive workspace-table-wrap">
                    <table class="table align-middle app-table workspace-table workspace-lookup-table">
                        <thead>
                            <tr>
                                <th class="workspace-lookup-select-cell">Sel.</th>
                                <th>Codigo</th>
                                <th>Nombre</th>
                                <th>Nivel</th>
                                <th>Movimiento</th>
                            </tr>
                        </thead>
                        <tbody id="cuentaPadreResultados">
                            <tr data-empty-row="true" class="d-none">
                                <td colspan="5">
                                    <div class="app-empty-state app-empty-state-inline">
                                        <i class="bi bi-search"></i>
                                        <div>
                                            <strong>No hay cuentas con ese filtro</strong>
                                            <p>Ajusta el texto o el nivel para ubicar la cuenta padre.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="workspace-inline-note">
                    <strong>Ayuda:</strong> se cargan hasta 100 cuentas. Si necesita una cuenta especifica, filtre por codigo o nombre.
                </div>
            </div>
            <div class="modal-footer workspace-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="aceptarCuentaPadre">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade workspace-modal" id="destinoCuentaModal" tabindex="-1" aria-labelledby="destinoCuentaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content workspace-modal-content">
            <div class="modal-header workspace-modal-header">
                <div>
                    <span class="workspace-window-kicker">Ayuda contable</span>
                    <h2 class="workspace-modal-title" id="destinoCuentaModalLabel">Seleccionar cuenta contable</h2>
                    <p class="workspace-modal-subtitle">Solo se permite confirmar cuentas de nivel 5 para destino y contrapartida.</p>
                </div>
                <button type="button" class="btn-close workspace-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body workspace-modal-body">
                <div class="workspace-filter-card mt-0">
                    <div class="workspace-filter-grid">
                        <div class="workspace-field workspace-field-span-2">
                            <label class="form-label" for="destinoCuentaFiltro">Filtro</label>
                            <input id="destinoCuentaFiltro" class="form-control" placeholder="Codigo o nombre de cuenta" autocomplete="off" />
                        </div>
                        <div class="workspace-field">
                            <label class="form-label" for="destinoCuentaNivelFiltro">Nivel</label>
                            <select id="destinoCuentaNivelFiltro" class="form-select">
                                <option value="">Todos</option>
                                @for (var nivel = 1; nivel <= 5; nivel++)
                                {
                                    <option value="@nivel">@nivel</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="table-responsive workspace-table-wrap">
                    <table class="table align-middle app-table workspace-table workspace-lookup-table">
                        <thead>
                            <tr>
                                <th class="workspace-lookup-select-cell">Sel.</th>
                                <th>Codigo</th>
                                <th>Cuenta</th>
                                <th>Nivel</th>
                                <th>Centro costo</th>
                            </tr>
                        </thead>
                        <tbody id="destinoCuentaResultados">
                            <tr data-destino-empty-row="true" class="d-none">
                                <td colspan="5">
                                    <div class="app-empty-state app-empty-state-inline">
                                        <i class="bi bi-search"></i>
                                        <div>
                                            <strong>No hay cuentas con ese filtro</strong>
                                            <p>Ajusta el texto o el nivel para ubicar la cuenta contable.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer workspace-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="aceptarDestinoCuenta">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const cuentaPadreId = document.getElementById("cuentaPadreId");
            const cuentaPadreTexto = document.getElementById("cuentaPadreTexto");
            const limpiarCuentaPadre = document.getElementById("limpiarCuentaPadre");
            const aceptarCuentaPadre = document.getElementById("aceptarCuentaPadre");
            const filtro = document.getElementById("cuentaPadreFiltro");
            const nivelFiltro = document.getElementById("cuentaPadreNivelFiltro");
            const modalEl = document.getElementById("cuentaPadreModal");
            const resultadosEl = document.getElementById("cuentaPadreResultados");
            const filaVacia = resultadosEl?.querySelector("[data-empty-row='true']");
            const buscarCuentasUrl = '@Url.Action("BuscarAyuda", "PlanCuenta")';
            const aceptaMovimientoEl = document.getElementById("aceptaMovimiento");
            const destinoSection = document.getElementById("destino-config-section");
            const destinoTableBody = document.querySelector("#destino-table tbody");
            const destinoTemplate = document.getElementById("destino-row-template");
            const agregarDestinoButton = document.getElementById("agregar-destino");
            const destinoTotalLabel = document.getElementById("destino-porcentaje-total");
            const destinoModalEl = document.getElementById("destinoCuentaModal");
            const destinoModal = destinoModalEl && window.bootstrap ? bootstrap.Modal.getOrCreateInstance(destinoModalEl) : null;
            const destinoResultadosEl = document.getElementById("destinoCuentaResultados");
            const destinoFilaVacia = destinoResultadosEl?.querySelector("[data-destino-empty-row='true']");
            const destinoFiltro = document.getElementById("destinoCuentaFiltro");
            const destinoNivelFiltro = document.getElementById("destinoCuentaNivelFiltro");
            let seleccion = cuentaPadreId?.value ? { idPlanCuenta: cuentaPadreId.value } : null;
            let busquedaProgramada = null;
            let destinoSeleccion = null;
            let destinoTarget = null;
            let destinoBusquedaProgramada = null;

            function toggleDestinoSection() {
                if (!destinoSection || !aceptaMovimientoEl) {
                    return;
                }

                const forceVisible = destinoSection.dataset.forceVisible === "true";
                destinoSection.classList.toggle("d-none", !aceptaMovimientoEl.checked && !forceVisible);
            }

            function marcarFila() {
                const filas = Array.from(resultadosEl?.querySelectorAll("[data-cuenta-row='true']") || []);
                filas.forEach(function (item) {
                    const seleccionado = seleccion && item.dataset.id === String(seleccion.idPlanCuenta);
                    item.classList.toggle("is-selected", seleccionado);
                    const radio = item.querySelector("input[type='radio']");
                    if (radio) {
                        radio.checked = Boolean(seleccionado);
                    }
                });
            }

            function renderResultados(items) {
                if (!resultadosEl) {
                    return;
                }

                resultadosEl.querySelectorAll("[data-cuenta-row='true']").forEach((fila) => fila.remove());
                if (filaVacia) {
                    filaVacia.classList.toggle("d-none", items.length > 0);
                }

                items.forEach(function (item) {
                    const fila = document.createElement("tr");
                    fila.className = "workspace-lookup-row";
                    fila.dataset.cuentaRow = "true";
                    fila.dataset.id = String(item.idPlanCuenta || "");
                    fila.dataset.codigo = String(item.codigoCuenta || "");
                    fila.dataset.nombre = String(item.nombreCuenta || "");
                    fila.dataset.nivel = String(item.nivelCuenta || "");
                    fila.innerHTML = `
                        <td class="workspace-lookup-select-cell"><input class="form-check-input" type="radio" name="cuentaPadreSeleccion" value="${String(item.idPlanCuenta || "")}" /></td>
                        <td class="workspace-tree-code">${String(item.codigoCuenta || "")}</td>
                        <td>${String(item.nombreCuenta || "")}</td>
                        <td>${String(item.nivelCuenta || "")}</td>
                        <td>${item.aceptaMovimiento ? "Si" : "No"}</td>`;
                    fila.addEventListener("click", function () {
                        seleccion = item;
                        marcarFila();
                    });
                    resultadosEl.appendChild(fila);
                });

                marcarFila();
            }

            async function cargarResultados() {
                const params = new URLSearchParams({ tamanoPagina: "100" });
                const texto = String(filtro?.value || "").trim();
                const nivel = String(nivelFiltro?.value || "").trim();
                if (texto.length >= 2) {
                    params.append("textoBusqueda", texto);
                }
                if (nivel) {
                    params.append("nivelCuenta", nivel);
                }

                const response = await fetch(`${buscarCuentasUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    throw new Error(payload.mensaje || "No se pudo cargar el plan de cuentas.");
                }

                renderResultados(payload.items || []);
            }

            function programarBusqueda() {
                if (busquedaProgramada) {
                    window.clearTimeout(busquedaProgramada);
                }

                busquedaProgramada = window.setTimeout(async function () {
                    try {
                        await cargarResultados();
                    } catch (error) {
                        console.warn(error);
                        renderResultados([]);
                    }
                }, 250);
            }

            function marcarFilaDestino() {
                const filas = Array.from(destinoResultadosEl?.querySelectorAll("[data-destino-row='true']") || []);
                filas.forEach((item) => {
                    const seleccionado = destinoSeleccion && item.dataset.id === String(destinoSeleccion.idPlanCuenta);
                    item.classList.toggle("is-selected", seleccionado);
                    const radio = item.querySelector("input[type='radio']");
                    if (radio) {
                        radio.checked = Boolean(seleccionado);
                    }
                });
            }

            function renderDestinoResultados(items) {
                if (!destinoResultadosEl) {
                    return;
                }

                destinoResultadosEl.querySelectorAll("[data-destino-row='true']").forEach((fila) => fila.remove());
                destinoFilaVacia?.classList.toggle("d-none", items.length > 0);

                items.forEach((item) => {
                    const fila = document.createElement("tr");
                    fila.className = "workspace-lookup-row";
                    fila.dataset.destinoRow = "true";
                    fila.dataset.id = String(item.idPlanCuenta || "");
                    fila.dataset.codigo = String(item.codigoCuenta || "");
                    fila.dataset.nombre = String(item.nombreCuenta || "");
                    fila.innerHTML = `
                        <td class="workspace-lookup-select-cell"><input class="form-check-input" type="radio" name="destinoCuentaSeleccion" value="${String(item.idPlanCuenta || "")}" /></td>
                        <td class="workspace-tree-code">${String(item.codigoCuenta || "")}</td>
                        <td>${String(item.nombreCuenta || "")}</td>
                        <td>${String(item.nivelCuenta || "")}</td>
                        <td>${item.requiereCentroCosto ? "Si" : "No"}</td>`;
                    fila.addEventListener("click", () => {
                        destinoSeleccion = item;
                        marcarFilaDestino();
                    });
                    destinoResultadosEl.appendChild(fila);
                });

                marcarFilaDestino();
            }

            async function cargarDestinoResultados() {
                const params = new URLSearchParams({ tamanoPagina: "100", soloUltimoNivel: "true" });
                const texto = String(destinoFiltro?.value || "").trim();
                const nivel = String(destinoNivelFiltro?.value || "").trim();
                if (texto.length >= 2) {
                    params.append("textoBusqueda", texto);
                }
                if (nivel) {
                    params.append("nivelCuenta", nivel);
                }

                const response = await fetch(`${buscarCuentasUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    throw new Error(payload.mensaje || "No se pudo cargar el plan de cuentas.");
                }

                renderDestinoResultados(payload.items || []);
            }

            function programarBusquedaDestino() {
                if (destinoBusquedaProgramada) {
                    window.clearTimeout(destinoBusquedaProgramada);
                }

                destinoBusquedaProgramada = window.setTimeout(async () => {
                    try {
                        await cargarDestinoResultados();
                    } catch (error) {
                        console.warn(error);
                        renderDestinoResultados([]);
                    }
                }, 250);
            }

            function bindDestinoRowActions(row) {
                row.querySelector(".js-remove-destino-row")?.addEventListener("click", () => {
                    row.remove();
                    refreshDestinoRows();
                });

                row.querySelector(".js-open-destino-cargo-modal")?.addEventListener("click", async () => {
                    destinoTarget = { tipo: "cargo", row };
                    const cuentaIdActual = row.querySelector(".js-destino-cargo-id")?.value || "";
                    destinoSeleccion = cuentaIdActual ? { idPlanCuenta: cuentaIdActual } : null;
                    try {
                        await cargarDestinoResultados();
                    } catch (error) {
                        console.warn(error);
                        renderDestinoResultados([]);
                    }
                    destinoModal?.show();
                });

                row.querySelector(".js-open-destino-abono-modal")?.addEventListener("click", async () => {
                    destinoTarget = { tipo: "abono", row };
                    const cuentaIdActual = row.querySelector(".js-destino-abono-id")?.value || "";
                    destinoSeleccion = cuentaIdActual ? { idPlanCuenta: cuentaIdActual } : null;
                    try {
                        await cargarDestinoResultados();
                    } catch (error) {
                        console.warn(error);
                        renderDestinoResultados([]);
                    }
                    destinoModal?.show();
                });
            }

            function refreshDestinoRows() {
                if (!destinoTableBody || !destinoTotalLabel) {
                    return;
                }

                const rows = Array.from(destinoTableBody.querySelectorAll("tr"));
                let total = 0;

                rows.forEach((row, index) => {
                    row.querySelectorAll("input, select, textarea, span").forEach((element) => {
                        ["name", "id", "for"].forEach((attribute) => {
                            const currentValue = element.getAttribute(attribute);
                            if (!currentValue) {
                                return;
                            }

                            const updatedValue = currentValue
                                .replaceAll("__index__", index)
                                .replace(/Formulario\.ConfiguracionDestino\.Detalles\[\d+\]/g, `Formulario.ConfiguracionDestino.Detalles[${index}]`)
                                .replace(/Formulario_ConfiguracionDestino_Detalles_\d+__/g, `Formulario_ConfiguracionDestino_Detalles_${index}__`);

                            if (updatedValue !== currentValue) {
                                element.setAttribute(attribute, updatedValue);
                            }
                        });
                    });

                    const orderInput = row.querySelector('input[name$=".Orden"]');
                    if (orderInput) {
                        orderInput.value = (index + 1).toString();
                    }

                    const activeInput = row.querySelector(".js-destino-activo");
                    const percentageInput = row.querySelector(".js-destino-porcentaje");
                    const percentageValue = parseFloat((percentageInput?.value ?? "0").replace(",", "."));
                    if (activeInput?.checked && !Number.isNaN(percentageValue)) {
                        total += percentageValue;
                    }
                });

                destinoTotalLabel.textContent = total.toFixed(4);
            }

            modalEl?.addEventListener("show.bs.modal", async function () {
                try {
                    await cargarResultados();
                } catch (error) {
                    console.warn(error);
                    renderResultados([]);
                }
            });

            filtro?.addEventListener("input", programarBusqueda);
            nivelFiltro?.addEventListener("change", programarBusqueda);
            destinoFiltro?.addEventListener("input", programarBusquedaDestino);
            destinoNivelFiltro?.addEventListener("change", programarBusquedaDestino);
            aceptaMovimientoEl?.addEventListener("change", toggleDestinoSection);

            aceptarCuentaPadre?.addEventListener("click", function () {
                if (seleccion && cuentaPadreId && cuentaPadreTexto) {
                    cuentaPadreId.value = seleccion.dataset.id || "";
                    cuentaPadreTexto.value = `${seleccion.dataset.codigo || ""} - ${seleccion.dataset.nombre || ""}`;
                }

                if (modalEl && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                }
            });

            limpiarCuentaPadre?.addEventListener("click", function () {
                if (cuentaPadreId) {
                    cuentaPadreId.value = "";
                }
                if (cuentaPadreTexto) {
                    cuentaPadreTexto.value = "Sin padre";
                }
                seleccion = null;
                marcarFila();
            });

            agregarDestinoButton?.addEventListener("click", () => {
                if (!destinoTableBody || !destinoTemplate) {
                    return;
                }

                const index = destinoTableBody.querySelectorAll("tr").length;
                const html = destinoTemplate.innerHTML.replaceAll("__index__", index);
                destinoTableBody.insertAdjacentHTML("beforeend", html);
                const row = destinoTableBody.lastElementChild;
                if (row) {
                    bindDestinoRowActions(row);
                }
                refreshDestinoRows();
            });

            document.getElementById("aceptarDestinoCuenta")?.addEventListener("click", () => {
                if (String(destinoSeleccion?.nivelCuenta || "") !== "5") {
                    window.alert("Seleccione una cuenta contable de nivel 5.");
                    return;
                }

                if (destinoSeleccion && destinoTarget?.row) {
                    const textoCuenta = `${String(destinoSeleccion.codigoCuenta || "")} - ${String(destinoSeleccion.nombreCuenta || "")}`;
                    const idSelector = destinoTarget.tipo === "cargo" ? ".js-destino-cargo-id" : ".js-destino-abono-id";
                    const textSelector = destinoTarget.tipo === "cargo" ? ".js-destino-cargo-texto" : ".js-destino-abono-texto";
                    const idInput = destinoTarget.row.querySelector(idSelector);
                    const textInput = destinoTarget.row.querySelector(textSelector);
                    if (idInput) {
                        idInput.value = String(destinoSeleccion.idPlanCuenta || "");
                    }
                    if (textInput) {
                        textInput.value = textoCuenta;
                    }
                }

                destinoModal?.hide();
            });

            destinoTableBody?.querySelectorAll("tr").forEach(bindDestinoRowActions);
            destinoTableBody?.addEventListener("input", refreshDestinoRows);
            destinoTableBody?.addEventListener("change", refreshDestinoRows);

            toggleDestinoSection();
            refreshDestinoRows();
        });
    </script>
}
