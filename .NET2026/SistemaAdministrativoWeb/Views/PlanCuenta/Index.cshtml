@model SistemaAdministrativoWeb.ViewModels.Contabilidad.PlanCuentaIndexViewModel
@* Firma: FRANCO LARA - 25/08/2026 | Informa que la carga por defecto inicializa plan, parametros, cuentas destino, impuestos y documentos. *@

@* =============================================
   Author:        FRANCO LARA
   Create date:   18/06/2026
   Description:   Agrega filtro de nivel en el listado de plan de cuentas.
   ============================================= *@
@* Firma: FRANCO LARA - 01/07/2026 | Muestra el modo de diferencia en cambio por cuenta para identificar rapidamente si una cuenta en USD se procesa por saldo o por analisis. *@
@* Firma: FRANCO LARA - 25/07/2026 | Alinea a la izquierda los nombres de las cuentas en el listado y elimina la sangria visual por nivel. *@

@{
    ViewData["Title"] = "Plan de cuentas";
    ViewData["AdminShell"] = true;
    var paginaInicio = Math.Max(1, Model.Paginacion.PaginaActual - 2);
    var paginaFin = Math.Min(Model.Paginacion.TotalPaginas, Model.Paginacion.PaginaActual + 2);

    static string ObtenerColBalance(string colBalance) => colBalance switch
    {
        "S" => "S - Saldo",
        "I" => "I - Inventario",
        "N" => "N - Naturaleza",
        "F" => "F - Funcion",
        "R" => "R - Resultado",
        _ => "-"
    };

    static string ObtenerTipoCambio(string tipoCambio) => tipoCambio switch
    {
        "V" => "Venta",
        "C" => "Compra",
        _ => "-"
    };

    static string NormalizarMonedaPlanCuenta(string idMoneda) => (idMoneda ?? string.Empty).Trim().ToUpperInvariant() switch
    {
        "S" => "PEN",
        "D" => "USD",
        var valor => valor
    };

    static string ObtenerModoDiferenciaCambio(string idMoneda, bool generaPorAnalisis) =>
        !string.Equals(NormalizarMonedaPlanCuenta(idMoneda), "USD", StringComparison.OrdinalIgnoreCase)
            ? "-"
            : generaPorAnalisis ? "Analisis" : "Saldo";
}

<section class="dashboard-shell">
    <section class="dashboard-metrics">
        <article class="dashboard-metric-card dashboard-metric-card-count">
            <span>Total cuentas</span>
            <strong>@Model.TotalCuentas</strong>
            <small>Registros filtrados segun la consulta actual.</small>
        </article>
        <article class="dashboard-metric-card dashboard-metric-card-count">
            <span>Cuentas movimiento</span>
            <strong>@Model.TotalMovimiento</strong>
            <small>Registros visibles en la pagina actual.</small>
        </article>
        <article class="dashboard-metric-card dashboard-metric-card-count">
            <span>Cuentas activas</span>
            <strong>@Model.TotalActivas</strong>
            <small>Items activos dentro de la pagina consultada.</small>
        </article>
    </section>

    <section class="workspace-window">
        <div class="workspace-window-head">
            <div>
                <span class="workspace-window-kicker">Catalogo</span>
                <h1>Cuentas registradas</h1>
                <p>Consulta, filtra y abre el registro en modo edicion desde la misma grilla.</p>
            </div>
            <div class="workspace-row-actions">
                <a asp-action="Registrar" class="btn btn-light btn-sm">Registrar cuenta</a>
            </div>
        </div>
        <div class="workspace-window-body">
            @if (TempData["PlanCuentaOk"] is string ok)
            {
                <div class="alert alert-success">@ok</div>
            }
            @if (TempData["PlanCuentaError"] is string error)
            {
                <div class="alert alert-danger">@error</div>
            }

            <form asp-action="Index" method="get" class="workspace-filter-card">
                <div class="workspace-filter-grid">
                    <div class="workspace-field workspace-field-span-2">
                        <label class="form-label" for="textoBusqueda">Buscar cuenta</label>
                        <input id="textoBusqueda" name="textoBusqueda" value="@Model.TextoBusqueda" class="form-control" placeholder="Codigo o nombre de cuenta" />
                    </div>
                    <div class="workspace-field">
                        <label class="form-label" for="nivelCuenta">Nivel</label>
                        <select id="nivelCuenta" name="nivelCuenta" class="form-select">
                            <option value="">Todos</option>
                            @for (byte nivel = 1; nivel <= 5; nivel++)
                            {
                                if (Model.NivelCuentaFiltro == nivel)
                                {
                                    <option value="@nivel" selected>@nivel</option>
                                }
                                else
                                {
                                    <option value="@nivel">@nivel</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="workspace-actions">
                    <button type="submit" class="btn btn-primary">Consultar</button>
                </div>
            </form>

            @if (Model.PuedeCargarDefault)
            {
                <form asp-action="CargarDefault" method="post" class="workspace-filter-card">
                    @Html.AntiForgeryToken()
                    <div class="app-empty-state app-empty-state-inline">
                        <i class="bi bi-diagram-3"></i>
                        <div>
                            <strong>La empresa no tiene plan de cuentas</strong>
                            <p>Carga el plan base junto con parametros, cuentas destino, impuestos y cuentas por documento.</p>
                        </div>
                    </div>
                    <div class="workspace-actions">
                        <button type="submit" class="btn btn-primary">Cargar configuracion contable por defecto</button>
                    </div>
                </form>
            }

            <div class="table-responsive workspace-table-wrap">
                <table class="table align-middle app-table workspace-table">
                    <thead>
                        <tr>
                            <th>Codigo</th>
                            <th>Nombre</th>
                            <th>Nivel</th>
                            <th>Col. balance</th>
                            <th>Moneda</th>
                            <th>TC</th>
                            <th>Dif. cambio</th>
                            <th>Movimiento</th>
                            <th>Centro costo</th>
                            <th>Estado</th>
                            <th class="text-end">Accion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Cuentas.Count == 0)
                        {
                            <tr>
                                <td colspan="11">
                                    <div class="app-empty-state app-empty-state-inline">
                                        <i class="bi bi-diagram-3"></i>
                                        <div>
                                            <strong>No hay cuentas para la consulta actual</strong>
                                            <p>Ajusta los filtros o registra la primera cuenta contable.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var cuenta in Model.Cuentas)
                            {
                                <tr class="workspace-clickable-row" data-edit-url="@Url.Action("Editar", new { idPlanCuenta = cuenta.IdPlanCuenta })">
                                    <td class="workspace-tree-code">@cuenta.CodigoCuenta</td>
                                    <td class="text-start">@cuenta.NombreCuenta</td>
                                    <td>@cuenta.NivelCuenta</td>
                                    <td>@ObtenerColBalance(cuenta.ColBalance)</td>
                                    <td>@(string.IsNullOrWhiteSpace(cuenta.IdMoneda) ? "-" : NormalizarMonedaPlanCuenta(cuenta.IdMoneda))</td>
                                    <td>@ObtenerTipoCambio(cuenta.TipoCambio)</td>
                                    <td>@ObtenerModoDiferenciaCambio(cuenta.IdMoneda, cuenta.GeneraDiferenciaPorAnalisis)</td>
                                    <td>@(cuenta.AceptaMovimiento ? "Si" : "No")</td>
                                    <td>@(cuenta.RequiereCentroCosto ? "Si" : "No")</td>
                                    <td>
                                        <span class="workspace-status-badge @(cuenta.Estado ? "is-active" : "is-inactive")">
                                            @(cuenta.Estado ? "Activa" : "Inactiva")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Editar" asp-route-idPlanCuenta="@cuenta.IdPlanCuenta" class="workspace-row-link">Editar</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Paginacion.TotalPaginas > 1)
            {
                <nav class="workspace-pagination" aria-label="Paginacion plan de cuentas">
                    <a class="btn btn-outline-secondary @(Model.Paginacion.TienePaginaAnterior ? string.Empty : "disabled")"
                       asp-action="Index"
                       asp-route-textoBusqueda="@Model.TextoBusqueda"
                       asp-route-nivelCuenta="@Model.NivelCuentaFiltro"
                       asp-route-pagina="@(Model.Paginacion.PaginaActual - 1)">Anterior</a>

                    @for (var pagina = paginaInicio; pagina <= paginaFin; pagina++)
                    {
                        <a class="btn @(pagina == Model.Paginacion.PaginaActual ? "btn-primary" : "btn-outline-secondary")"
                           asp-action="Index"
                           asp-route-textoBusqueda="@Model.TextoBusqueda"
                           asp-route-nivelCuenta="@Model.NivelCuentaFiltro"
                           asp-route-pagina="@pagina">@pagina</a>
                    }

                    <a class="btn btn-outline-secondary @(Model.Paginacion.TienePaginaSiguiente ? string.Empty : "disabled")"
                       asp-action="Index"
                       asp-route-textoBusqueda="@Model.TextoBusqueda"
                       asp-route-nivelCuenta="@Model.NivelCuentaFiltro"
                       asp-route-pagina="@(Model.Paginacion.PaginaActual + 1)">Siguiente</a>
                </nav>
            }
        </div>
    </section>
</section>
