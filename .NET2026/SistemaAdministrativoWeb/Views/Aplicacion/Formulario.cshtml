@model SistemaAdministrativoWeb.ViewModels.Contabilidad.AplicacionNotaCreditoIndexViewModel

@* =============================================
   Author:        FRANCO LARA
   Create date:   24/06/2026
   Description:   Crea el formulario del modulo Aplicaciones separando comprobantes pendientes y notas de credito por cliente o proveedor para registrar aplicaciones parciales.
   ============================================= *@
@* Firma: FRANCO LARA - 24/06/2026 | Cambia la seleccion de persona a popup filtrado por cliente/proveedor, muestra moneda y tipo de cambio de la aplicacion, bloquea combinaciones de distinta moneda y mejora la validacion visual del guardado. *@
@* Firma: FRANCO LARA - 08/07/2026 | Ajusta el modo oscuro del formulario de aplicaciones mejorando contraste en paneles gemelos, tablas de seleccion y tarjetas resumen. *@

@{
    ViewData["Title"] = "Registrar aplicacion";
    ViewData["AdminShell"] = true;
    var periodoTexto = new DateTime(Model.AnioSeleccionado, Model.MesSeleccionado, 1).ToString("MMMM 'de' yyyy");
    var textInfo = System.Globalization.CultureInfo.CurrentCulture.TextInfo;
    var personaTexto = string.IsNullOrWhiteSpace(Model.Formulario.PersonaTexto) ? "Seleccione persona" : Model.Formulario.PersonaTexto;
    var numeroDocumentoTexto = string.IsNullOrWhiteSpace(Model.Formulario.NumeroDocumentoPersona) ? "Sin RUC/DNI relacionado" : $"RUC/DNI: {Model.Formulario.NumeroDocumentoPersona}";
}

<style>
    .workspace-application-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .workspace-application-card {
        border: 1px solid rgba(76, 108, 168, 0.16);
        border-radius: 1.25rem;
        background: #fff;
        box-shadow: 0 20px 45px rgba(20, 38, 73, 0.05);
        overflow: hidden;
    }

    .workspace-application-card-head {
        padding: 1rem 1.2rem;
        color: #fff;
        background: linear-gradient(135deg, #163867, #2d7bf0);
    }

    .workspace-application-card-head h2 {
        margin: 0;
        font-size: 1.2rem;
    }

    .workspace-application-card-head p {
        margin: 0.35rem 0 0;
        opacity: 0.88;
    }

    .workspace-application-card-body {
        padding: 1rem 1.1rem 1.2rem;
    }

    .workspace-application-selector td:first-child,
    .workspace-application-selector th:first-child {
        width: 52px;
        text-align: center;
    }

    .workspace-application-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem;
        margin-top: 1rem;
    }

    .workspace-application-stat {
        border: 1px solid rgba(71, 101, 158, 0.14);
        border-radius: 1rem;
        padding: 0.9rem 1rem;
        background: rgba(241, 246, 255, 0.78);
    }

    .workspace-application-stat span,
    .workspace-application-stat strong,
    .workspace-application-stat small {
        display: block;
    }

    .workspace-application-stat span {
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #5272a0;
    }

    .workspace-application-stat strong {
        margin-top: 0.3rem;
        font-size: 1.45rem;
        color: #173863;
    }

    .workspace-application-stat small {
        margin-top: 0.18rem;
        color: #627493;
    }

    .workspace-persona-note {
        display: block;
        margin-top: 0.35rem;
        font-size: 0.72rem;
        color: #6a7a96;
        line-height: 1.3;
    }

    .workspace-application-alert {
        margin-top: 1rem;
    }

    .workspace-lookup-select-cell {
        width: 52px;
        text-align: center;
    }

    html[data-theme="dark"] .workspace-application-card {
        border-color: rgba(94, 116, 150, 0.28);
        background: linear-gradient(180deg, rgba(18, 27, 44, 0.98) 0%, rgba(11, 18, 31, 0.96) 100%);
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.22);
    }

    html[data-theme="dark"] .workspace-application-card-body {
        color: var(--app-ink);
    }

    html[data-theme="dark"] .workspace-application-stat {
        border-color: rgba(94, 116, 150, 0.28);
        background: linear-gradient(180deg, rgba(22, 31, 50, 0.96) 0%, rgba(14, 23, 39, 0.94) 100%);
    }

    html[data-theme="dark"] .workspace-application-stat span,
    html[data-theme="dark"] .workspace-persona-note {
        color: #9cb0d1;
    }

    html[data-theme="dark"] .workspace-application-stat strong {
        color: #f2f7ff;
    }

    html[data-theme="dark"] .workspace-application-stat small {
        color: #9cb0d1;
    }

    @@media (max-width: 991.98px) {
        .workspace-application-grid,
        .workspace-application-summary {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="dashboard-shell">
    <section class="workspace-window">
        <div class="workspace-window-head">
            <div>
                <span class="workspace-window-kicker">Formulario</span>
                <h1>Registrar aplicacion</h1>
                <p>Selecciona un comprobante pendiente y una nota de credito del mismo cliente o proveedor para compensar saldos de forma parcial o total.</p>
            </div>
            <div class="workspace-window-badge">
                <strong>@textInfo.ToTitleCase(periodoTexto)</strong>
                <span>Periodo contable</span>
                <small>@Model.PeriodoConsulta</small>
            </div>
        </div>
        <div class="workspace-window-body">
            <form asp-action="Registrar" method="get" class="workspace-filter-card" id="aplicacion-filtro-form">
                <input type="hidden" name="anio" value="@Model.AnioSeleccionado" />
                <input type="hidden" name="mes" value="@Model.MesSeleccionado" />
                <input type="hidden" name="idPersona" id="personaIdFiltro" value="@Model.Formulario.IdPersona" />
                <div class="workspace-form-grid">
                    <div class="workspace-field">
                        <label class="form-label" for="tipoPersonaFiltro">Tipo</label>
                        <select id="tipoPersonaFiltro" name="tipoPersona" class="form-select">
                            <option value="C" selected="@(Model.Formulario.TipoPersona == "C")">Cliente</option>
                            <option value="P" selected="@(Model.Formulario.TipoPersona == "P")">Proveedor</option>
                        </select>
                    </div>
                    <div class="workspace-field workspace-field-span-2">
                        <label class="form-label">Persona</label>
                        <div class="workspace-lookup-control">
                            <input id="personaTextoFiltro" class="form-control" value="@personaTexto" readonly />
                            <button type="button" class="btn btn-outline-secondary workspace-icon-button" id="abrirPersonaModal" title="Buscar persona" aria-label="Buscar persona"><i class="bi bi-person"></i></button>
                            <button type="button" class="btn btn-outline-secondary workspace-icon-button" id="limpiarPersonaFiltro" title="Limpiar persona" aria-label="Limpiar persona"><i class="bi bi-brush"></i></button>
                        </div>
                        <span class="workspace-persona-note" id="personaDocumentoFiltro">@numeroDocumentoTexto</span>
                    </div>
                </div>
                <div class="workspace-actions">
                    <button type="submit" class="btn btn-outline-primary">Cargar saldos</button>
                    <a asp-action="Index" asp-route-anio="@Model.AnioSeleccionado" asp-route-mes="@Model.MesSeleccionado" class="btn btn-outline-secondary">Volver al listado</a>
                </div>
            </form>

            <form asp-action="Guardar" method="post" id="aplicacion-form" class="mt-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="anio" value="@Model.AnioSeleccionado" />
                <input type="hidden" name="mes" value="@Model.MesSeleccionado" />
                <input asp-for="Formulario.TipoPersona" type="hidden" id="tipoPersonaGuardar" />
                <input asp-for="Formulario.IdPersona" type="hidden" id="personaIdGuardar" />
                <input asp-for="Formulario.PersonaTexto" type="hidden" id="personaTextoGuardar" />
                <input asp-for="Formulario.NumeroDocumentoPersona" type="hidden" id="personaDocumentoGuardar" />
                <input asp-for="Formulario.IdMoneda" type="hidden" id="monedaIdGuardar" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="workspace-form-grid">
                    <div class="workspace-field">
                        <label asp-for="Formulario.FechaAplicacion" class="form-label">Fecha de aplicacion</label>
                        <input asp-for="Formulario.FechaAplicacion" type="date" class="form-control" />
                        <span asp-validation-for="Formulario.FechaAplicacion" class="text-danger"></span>
                    </div>
                    <div class="workspace-field">
                        <label asp-for="Formulario.MonedaTexto" class="form-label">Moneda</label>
                        <input asp-for="Formulario.MonedaTexto" class="form-control" id="monedaAplicacion" readonly />
                    </div>
                    <div class="workspace-field">
                        <label asp-for="Formulario.TipoCambio" class="form-label">Tipo de cambio</label>
                        <input asp-for="Formulario.TipoCambio" class="form-control js-tipo-cambio" />
                        <span asp-validation-for="Formulario.TipoCambio" class="text-danger"></span>
                    </div>
                    <div class="workspace-field">
                        <label asp-for="Formulario.ImporteAplicado" class="form-label">Importe aplicado</label>
                        <input asp-for="Formulario.ImporteAplicado" class="form-control js-importe-aplicado" />
                        <span asp-validation-for="Formulario.ImporteAplicado" class="text-danger"></span>
                    </div>
                    <div class="workspace-field workspace-field-span-2">
                        <label asp-for="Formulario.Glosa" class="form-label">Glosa</label>
                        <input asp-for="Formulario.Glosa" class="form-control" placeholder="Aplicacion de nota de credito al comprobante pendiente" />
                        <span asp-validation-for="Formulario.Glosa" class="text-danger"></span>
                    </div>
                    <div class="workspace-field workspace-field-span-2">
                        <label asp-for="Formulario.Observacion" class="form-label">Observaciones</label>
                        <textarea asp-for="Formulario.Observacion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Formulario.Observacion" class="text-danger"></span>
                    </div>
                </div>

                <div class="alert alert-warning workspace-application-alert d-none" id="aplicacionValidacionMoneda">
                    El comprobante y la nota de credito deben estar en la misma moneda para poder aplicar.
                </div>

                @if (!Model.Formulario.IdPersona.HasValue)
                {
                    <div class="alert alert-info mt-4">Seleccione primero un cliente o proveedor para cargar sus comprobantes pendientes y sus notas de credito disponibles.</div>
                }
                else
                {
                    <div class="workspace-application-grid">
                        <section class="workspace-application-card">
                            <div class="workspace-application-card-head">
                                <h2>Comprobantes pendientes</h2>
                                <p>Elige un solo comprobante que recibira la aplicacion de la NC.</p>
                            </div>
                            <div class="workspace-application-card-body">
                                @if (Model.ComprobantesPendientes.Count == 0)
                                {
                                    <div class="alert alert-warning mb-0">La persona seleccionada no tiene comprobantes pendientes aplicables.</div>
                                }
                                else
                                {
                                    <div class="table-responsive workspace-application-selector">
                                        <table class="table align-middle app-table workspace-table">
                                            <thead>
                                                <tr>
                                                    <th>Sel.</th>
                                                    <th>Fecha</th>
                                                    <th>Documento</th>
                                                    <th>Serie-Número</th>
                                                    <th>Moneda</th>
                                                    <th>Total</th>
                                                    <th>Saldo</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.ComprobantesPendientes)
                                                {
                                                    <tr>
                                                        <td>
                                                            <input type="radio"
                                                                   asp-for="Formulario.IdRegistroComprobante"
                                                                   value="@item.IdRegistro"
                                                                   class="form-check-input js-comprobante"
                                                                   data-id-moneda="@item.IdMoneda"
                                                                   data-saldo="@item.Saldo.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                                   data-moneda="@item.CodigoMoneda"
                                                                   data-tc="@item.TipoCambio.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                                        </td>
                                                        <td>@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                                                        <td>
                                                            <strong>@item.DocumentoTexto</strong>
                                                            <div class="workspace-inline-note">@item.EscenarioOperacion</div>
                                                        </td>
                                                        <td>@item.SerieNumeroTexto</td>
                                                        <td>@item.CodigoMoneda</td>
                                                        <td class="workspace-money-cell">@item.ImporteTotal.ToString("0.00")</td>
                                                        <td class="workspace-money-cell">@item.Saldo.ToString("0.00")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <span asp-validation-for="Formulario.IdRegistroComprobante" class="text-danger"></span>
                                }
                            </div>
                        </section>

                        <section class="workspace-application-card">
                            <div class="workspace-application-card-head">
                                <h2>Notas de credito disponibles</h2>
                                <p>Elige una sola NC que se aplicara contra el comprobante seleccionado.</p>
                            </div>
                            <div class="workspace-application-card-body">
                                @if (Model.NotasCreditoPendientes.Count == 0)
                                {
                                    <div class="alert alert-warning mb-0">La persona seleccionada no tiene notas de credito pendientes para aplicar.</div>
                                }
                                else
                                {
                                    <div class="table-responsive workspace-application-selector">
                                        <table class="table align-middle app-table workspace-table">
                                            <thead>
                                                <tr>
                                                    <th>Sel.</th>
                                                    <th>Fecha</th>
                                                    <th>Documento</th>
                                                    <th>Serie-Número</th>
                                                    <th>Moneda</th>
                                                    <th>Total</th>
                                                    <th>Saldo</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.NotasCreditoPendientes)
                                                {
                                                    <tr>
                                                        <td>
                                                            <input type="radio"
                                                                   asp-for="Formulario.IdRegistroNotaCredito"
                                                                   value="@item.IdRegistro"
                                                                   class="form-check-input js-nota-credito"
                                                                   data-id-moneda="@item.IdMoneda"
                                                                   data-saldo="@item.Saldo.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                                   data-moneda="@item.CodigoMoneda"
                                                                   data-tc="@item.TipoCambio.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                                        </td>
                                                        <td>@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                                                        <td>
                                                            <strong>@item.DocumentoTexto</strong>
                                                            <div class="workspace-inline-note">@item.EscenarioOperacion</div>
                                                        </td>
                                                        <td>@item.SerieNumeroTexto</td>
                                                        <td>@item.CodigoMoneda</td>
                                                        <td class="workspace-money-cell">@item.ImporteTotal.ToString("0.00")</td>
                                                        <td class="workspace-money-cell">@item.Saldo.ToString("0.00")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <span asp-validation-for="Formulario.IdRegistroNotaCredito" class="text-danger"></span>
                                }
                            </div>
                        </section>
                    </div>

                    <div class="workspace-application-summary">
                        <article class="workspace-application-stat">
                            <span>Saldo comprobante</span>
                            <strong id="saldoComprobanteTexto">0.00</strong>
                            <small>Saldo pendiente del comprobante elegido.</small>
                        </article>
                        <article class="workspace-application-stat">
                            <span>Saldo NC</span>
                            <strong id="saldoNcTexto">0.00</strong>
                            <small>Saldo disponible de la nota de credito seleccionada.</small>
                        </article>
                        <article class="workspace-application-stat">
                            <span>Importe sugerido</span>
                            <strong id="importeSugeridoTexto">0.00</strong>
                            <small>Se propone el menor saldo entre el comprobante y la NC.</small>
                        </article>
                    </div>

                    <div class="workspace-actions mt-4">
                        <button type="submit" class="btn btn-primary" @(Model.ComprobantesPendientes.Count == 0 || Model.NotasCreditoPendientes.Count == 0 ? "disabled" : null)>Guardar aplicacion</button>
                        <a asp-action="Index" asp-route-anio="@Model.AnioSeleccionado" asp-route-mes="@Model.MesSeleccionado" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                }
            </form>
        </div>
    </section>
</section>

<div class="modal fade workspace-modal" id="personaModal" tabindex="-1" aria-labelledby="personaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content workspace-modal-content">
            <div class="modal-header workspace-modal-header">
                <div>
                    <span class="workspace-modal-kicker">Ayuda persona</span>
                    <h2 class="workspace-modal-title" id="personaModalLabel">Seleccionar persona</h2>
                    <p class="workspace-modal-subtitle">Busca por nombre o documento y filtra solo clientes o solo proveedores segun el tipo elegido.</p>
                </div>
                <button type="button" class="btn-close workspace-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body workspace-modal-body">
                <div class="workspace-form-grid">
                    <div class="workspace-field workspace-field-span-2">
                        <label class="form-label" for="personaFiltro">Filtro</label>
                        <input id="personaFiltro" class="form-control" placeholder="Nombre o documento" autocomplete="off" />
                    </div>
                </div>
                <div class="table-responsive workspace-table-wrap workspace-modal-results">
                    <table class="table align-middle app-table workspace-table">
                        <thead>
                            <tr>
                                <th>Sel.</th>
                                <th>Documento</th>
                                <th>Persona</th>
                                <th>Tipo doc.</th>
                            </tr>
                        </thead>
                        <tbody id="personaResultados"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer workspace-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="aceptarPersona">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const filtroForm = document.getElementById("aplicacion-filtro-form");
            const form = document.getElementById("aplicacion-form");
            const tipoPersonaFiltro = document.getElementById("tipoPersonaFiltro");
            const personaIdFiltro = document.getElementById("personaIdFiltro");
            const personaTextoFiltro = document.getElementById("personaTextoFiltro");
            const personaDocumentoFiltro = document.getElementById("personaDocumentoFiltro");
            const personaIdGuardar = document.getElementById("personaIdGuardar");
            const personaTextoGuardar = document.getElementById("personaTextoGuardar");
            const personaDocumentoGuardar = document.getElementById("personaDocumentoGuardar");
            const tipoPersonaGuardar = document.getElementById("tipoPersonaGuardar");
            const limpiarPersonaFiltro = document.getElementById("limpiarPersonaFiltro");
            const abrirPersonaModal = document.getElementById("abrirPersonaModal");
            const personaFiltro = document.getElementById("personaFiltro");
            const personaResultados = document.getElementById("personaResultados");
            const personaModalEl = document.getElementById("personaModal");
            const personaModal = personaModalEl ? new bootstrap.Modal(personaModalEl) : null;
            const buscarPersonasUrl = '@Url.Action("BuscarPersonasAyuda", "Aplicacion")';

            if (!filtroForm || !form) {
                return;
            }

            const comprobantes = form.querySelectorAll(".js-comprobante");
            const notasCredito = form.querySelectorAll(".js-nota-credito");
            const importeAplicado = form.querySelector(".js-importe-aplicado");
            const tipoCambioInput = form.querySelector(".js-tipo-cambio");
            const monedaAplicacion = document.getElementById("monedaAplicacion");
            const monedaIdGuardar = document.getElementById("monedaIdGuardar");
            const saldoComprobanteTexto = document.getElementById("saldoComprobanteTexto");
            const saldoNcTexto = document.getElementById("saldoNcTexto");
            const importeSugeridoTexto = document.getElementById("importeSugeridoTexto");
            const alertaMoneda = document.getElementById("aplicacionValidacionMoneda");
            let personaSeleccion = null;
            let personaBusquedaProgramada = null;
            let tipoCambioTocado = false;

            const parseDecimal = (value) => {
                const normalized = String(value || "").replace(",", ".");
                const parsed = Number.parseFloat(normalized);
                return Number.isFinite(parsed) ? parsed : 0;
            };

            const formatTipoCambioInput = (input) => {
                if (!input) {
                    return;
                }

                input.value = parseDecimal(input.value).toFixed(3);
            };

            const selectedValue = (inputs) => Array.from(inputs).find((input) => input.checked);

            const marcarFilaSeleccion = (tbody, selectedRow) => {
                Array.from(tbody.querySelectorAll("tr")).forEach((row) => {
                    row.classList.toggle("is-selected", row === selectedRow);
                });
            };

            const limpiarPersona = () => {
                personaIdFiltro.value = "";
                personaTextoFiltro.value = "Seleccione persona";
                personaDocumentoFiltro.textContent = "Sin RUC/DNI relacionado";
                if (personaIdGuardar) {
                    personaIdGuardar.value = "";
                }
                if (personaTextoGuardar) {
                    personaTextoGuardar.value = "";
                }
                if (personaDocumentoGuardar) {
                    personaDocumentoGuardar.value = "";
                }
            };

            const aplicarPersonaSeleccionada = (item) => {
                personaIdFiltro.value = item.idPersona || "";
                personaTextoFiltro.value = item.nombreCompleto || "";
                personaDocumentoFiltro.textContent = item.numeroDocumento ? `RUC/DNI: ${item.numeroDocumento}` : "Sin RUC/DNI relacionado";
                if (personaIdGuardar) {
                    personaIdGuardar.value = item.idPersona || "";
                }
                if (personaTextoGuardar) {
                    personaTextoGuardar.value = item.nombreCompleto || "";
                }
                if (personaDocumentoGuardar) {
                    personaDocumentoGuardar.value = item.numeroDocumento || "";
                }
            };

            const renderPersonas = (items) => {
                personaResultados.innerHTML = "";
                if (!items.length) {
                    personaResultados.innerHTML = `<tr><td colspan="4"><div class="app-empty-state app-empty-state-inline"><i class="bi bi-person"></i><div><strong>No hay personas con ese filtro</strong><p>Ajusta la busqueda para continuar.</p></div></div></td></tr>`;
                    return;
                }

                items.forEach((item) => {
                    const row = document.createElement("tr");
                    row.innerHTML = `
                        <td class="workspace-lookup-select-cell"><input type="radio" name="personaSeleccionAplicacion" /></td>
                        <td>${item.numeroDocumento || ""}</td>
                        <td>${item.nombreCompleto || ""}</td>
                        <td>${item.nombreTipoDocumento || ""}</td>`;
                    row.addEventListener("click", () => {
                        personaSeleccion = item;
                        marcarFilaSeleccion(personaResultados, row);
                        row.querySelector("input").checked = true;
                    });
                    personaResultados.appendChild(row);
                });
            };

            const cargarPersonas = async () => {
                const params = new URLSearchParams({ tipoPersona: tipoPersonaFiltro?.value || "C", tamanoPagina: "20" });
                const filtro = String(personaFiltro?.value || "").trim();
                if (filtro.length >= 2) {
                    params.append("textoBusqueda", filtro);
                }

                const response = await fetch(`${buscarPersonasUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                if (!response.ok || payload.ok === false) {
                    throw new Error(payload.mensaje || "No se pudo cargar la ayuda de personas.");
                }

                renderPersonas(payload.items || []);
            };

            const actualizarSugerencia = () => {
                const comprobante = selectedValue(comprobantes);
                const nc = selectedValue(notasCredito);
                const saldoComprobante = parseDecimal(comprobante?.dataset?.saldo);
                const saldoNc = parseDecimal(nc?.dataset?.saldo);
                const monedaComprobante = String(comprobante?.dataset?.moneda || "");
                const monedaNc = String(nc?.dataset?.moneda || "");
                const mismaMoneda = comprobante && nc && monedaComprobante === monedaNc;
                const sugerido = mismaMoneda ? Math.min(saldoComprobante, saldoNc) : 0;

                if (saldoComprobanteTexto) {
                    saldoComprobanteTexto.textContent = saldoComprobante.toFixed(2);
                }
                if (saldoNcTexto) {
                    saldoNcTexto.textContent = saldoNc.toFixed(2);
                }
                if (importeSugeridoTexto) {
                    importeSugeridoTexto.textContent = sugerido.toFixed(2);
                }
                if (monedaAplicacion) {
                    monedaAplicacion.value = mismaMoneda ? monedaComprobante : "";
                }
                if (monedaIdGuardar) {
                    monedaIdGuardar.value = mismaMoneda ? String(comprobante?.dataset?.idMoneda || "") : "";
                }
                alertaMoneda?.classList.toggle("d-none", !comprobante || !nc || mismaMoneda);

                if (tipoCambioInput && !tipoCambioTocado) {
                    const tcBase = parseDecimal(comprobante?.dataset?.tc || nc?.dataset?.tc || "1");
                    tipoCambioInput.value = (tcBase > 0 ? tcBase : 1).toFixed(3);
                }

                if (importeAplicado && sugerido > 0) {
                    importeAplicado.value = sugerido.toFixed(2);
                }
            };

            abrirPersonaModal?.addEventListener("click", async () => {
                personaSeleccion = null;
                if (personaFiltro) {
                    personaFiltro.value = "";
                }
                try {
                    await cargarPersonas();
                    personaModal?.show();
                } catch (error) {
                    window.alert(error.message || "No se pudo abrir la ayuda de personas.");
                }
            });

            limpiarPersonaFiltro?.addEventListener("click", limpiarPersona);

            tipoPersonaFiltro?.addEventListener("change", () => {
                if (tipoPersonaGuardar) {
                    tipoPersonaGuardar.value = tipoPersonaFiltro.value || "C";
                }
                limpiarPersona();
            });

            personaFiltro?.addEventListener("input", () => {
                if (personaBusquedaProgramada) {
                    window.clearTimeout(personaBusquedaProgramada);
                }
                personaBusquedaProgramada = window.setTimeout(async () => {
                    try {
                        await cargarPersonas();
                    } catch (error) {
                        personaResultados.innerHTML = "";
                        window.console.warn(error);
                    }
                }, 250);
            });

            document.getElementById("aceptarPersona")?.addEventListener("click", () => {
                if (!personaSeleccion) {
                    window.alert("Seleccione una persona para continuar.");
                    return;
                }

                aplicarPersonaSeleccionada(personaSeleccion);
                personaModal?.hide();
            });

            tipoCambioInput?.addEventListener("input", () => {
                tipoCambioTocado = true;
            });
            tipoCambioInput?.addEventListener("blur", () => {
                formatTipoCambioInput(tipoCambioInput);
            });
            tipoCambioInput?.addEventListener("change", () => {
                formatTipoCambioInput(tipoCambioInput);
                tipoCambioTocado = true;
            });

            comprobantes.forEach((input) => input.addEventListener("change", actualizarSugerencia));
            notasCredito.forEach((input) => input.addEventListener("change", actualizarSugerencia));

            form.addEventListener("submit", (event) => {
                const comprobante = selectedValue(comprobantes);
                const nc = selectedValue(notasCredito);
                const monedaComprobante = String(comprobante?.dataset?.moneda || "");
                const monedaNc = String(nc?.dataset?.moneda || "");

                if (!comprobante) {
                    event.preventDefault();
                    window.alert("Seleccione un comprobante pendiente.");
                    return;
                }

                if (!nc) {
                    event.preventDefault();
                    window.alert("Seleccione una nota de credito.");
                    return;
                }

                if (monedaComprobante !== monedaNc) {
                    event.preventDefault();
                    alertaMoneda?.classList.remove("d-none");
                    window.alert("La aplicacion solo puede realizarse entre documentos de la misma moneda.");
                    return;
                }
            });

            if (tipoPersonaGuardar && tipoPersonaFiltro) {
                tipoPersonaGuardar.value = tipoPersonaFiltro.value || "C";
            }

            formatTipoCambioInput(tipoCambioInput);
            actualizarSugerencia();
        })();
    </script>
}
