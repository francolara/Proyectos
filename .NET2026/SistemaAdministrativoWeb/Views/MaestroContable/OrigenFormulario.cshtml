@model SistemaAdministrativoWeb.ViewModels.Plataforma.OrigenMaestroFormViewModel
@{ ViewData["Title"] = Model.IdOrigenMaestro.HasValue ? "Editar origen maestro" : "Registrar origen maestro"; ViewData["PlatformShell"] = true; }
@* =============================================
   Author: FRANCO LARA / Codex
   Create date: 27/08/2026
   Description: Formulario de alta y edicion de origenes maestros, navegable exclusivamente desde el menu lateral.
   ============================================= *@
<section class="dashboard-shell"><section class="dashboard-hero"><div><span class="dashboard-kicker">Origen maestro</span><h1 class="app-page-title"><i class="bi bi-journal-code"></i><span>@ViewData["Title"]</span></h1><p>El código queda bloqueado después del registro.</p></div></section>
<form asp-action="GuardarOrigen" method="post" class="table-panel p-3"><input asp-for="IdOrigenMaestro" type="hidden"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-3"><label asp-for="CodigoOrigen" class="form-label"></label><input asp-for="CodigoOrigen" class="form-control" readonly="@(Model.IdOrigenMaestro.HasValue ? "readonly" : null)"><span asp-validation-for="CodigoOrigen" class="text-danger"></span></div><div class="col-md-5"><label asp-for="NombreOrigen" class="form-label"></label><input asp-for="NombreOrigen" class="form-control"><span asp-validation-for="NombreOrigen" class="text-danger"></span></div><div class="col-md-2"><label asp-for="ModuloOrigen" class="form-label"></label><input asp-for="ModuloOrigen" class="form-control"><span asp-validation-for="ModuloOrigen" class="text-danger"></span></div><div class="col-md-2"><label asp-for="Orden" class="form-label"></label><input asp-for="Orden" class="form-control" type="number"></div><div class="col-12 d-flex gap-4"><div class="form-check"><input asp-for="PermiteRegistroManual" class="form-check-input"><label asp-for="PermiteRegistroManual" class="form-check-label">Permite registro manual</label></div><div class="form-check"><input asp-for="Estado" class="form-check-input"><label asp-for="Estado" class="form-check-label">Activo</label></div></div></div><div class="workspace-actions mt-4"><button class="btn btn-primary">Guardar</button><a class="btn btn-outline-secondary" asp-action="Origenes">Cancelar</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
