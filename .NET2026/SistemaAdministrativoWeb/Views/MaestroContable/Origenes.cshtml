@model SistemaAdministrativoWeb.ViewModels.Plataforma.OrigenMaestroIndexViewModel
@{
    ViewData["Title"] = "Orígenes maestros";
    ViewData["PlatformShell"] = true;
    var paginaInicio = Math.Max(1, Model.Paginacion.PaginaActual - 2);
    var paginaFin = Math.Min(Model.Paginacion.TotalPaginas, Model.Paginacion.PaginaActual + 2);
}
@* =============================================
   Author: FRANCO LARA / Codex
   Create date: 27/08/2026
   Description: Lista de origenes maestros con mantenimiento integral, paginacion numerada y navegacion lateral exclusiva.
   ============================================= *@
@* Firma: FRANCO LARA - 29/08/2026 | Uniformiza Editar y Eliminar con el patron compacto de Centros de costo. *@
<section class="dashboard-shell"><partial name="_Alertas" /><section class="dashboard-hero"><div><span class="dashboard-kicker">Maestro</span><h1 class="app-page-title"><i class="bi bi-journal-code"></i><span>Orígenes maestros</span></h1><p>Catálogo base de orígenes que se copia a cada empresa.</p></div><a class="btn btn-light" asp-action="RegistrarOrigen">Registrar origen</a></section>
<section class="table-panel"><form method="get" class="workspace-filter-card"><div class="workspace-filter-grid"><div class="workspace-field"><label class="form-label">Buscar origen</label><input class="form-control" name="textoBusqueda" value="@Model.TextoBusqueda" placeholder="Código, nombre o módulo" /></div></div><div class="workspace-actions"><button class="btn btn-primary">Consultar</button><a class="btn btn-outline-secondary" asp-action="Origenes">Limpiar</a></div></form>
<div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Código</th><th>Nombre</th><th>Módulo</th><th>Manual</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td><strong>@item.CodigoOrigen</strong></td><td>@item.NombreOrigen</td><td>@item.ModuloOrigen</td><td>@(item.PermiteRegistroManual ? "Sí" : "No")</td><td>@(item.Estado ? "Activo" : "Inactivo")</td><td class="text-end"><div class="workspace-row-actions-compact"><a class="workspace-row-link" asp-action="EditarOrigen" asp-route-id="@item.IdOrigenMaestro">Editar</a><form asp-action="EliminarOrigen" method="post" class="d-inline-flex" onsubmit="return confirm('¿Eliminar este origen maestro?');"><input type="hidden" name="id" value="@item.IdOrigenMaestro"><button type="submit" class="workspace-row-link text-danger">Eliminar</button></form></div></td></tr> } @if (Model.Items.Count == 0) { <tr><td colspan="6" class="text-muted">No se encontraron orígenes.</td></tr> }</tbody></table></div>
@if (Model.Paginacion.TotalPaginas > 1)
{
    <nav class="workspace-pagination mt-3" aria-label="Paginación de orígenes maestros">
        <a class="btn btn-outline-secondary @(Model.Paginacion.TienePaginaAnterior ? string.Empty : "disabled")" asp-action="Origenes" asp-route-textoBusqueda="@Model.TextoBusqueda" asp-route-pagina="@(Model.Paginacion.PaginaActual - 1)">Anterior</a>
        @for (var pagina = paginaInicio; pagina <= paginaFin; pagina++)
        {
            <a class="btn @(pagina == Model.Paginacion.PaginaActual ? "btn-primary" : "btn-outline-secondary")" asp-action="Origenes" asp-route-textoBusqueda="@Model.TextoBusqueda" asp-route-pagina="@pagina">@pagina</a>
        }
        <a class="btn btn-outline-secondary @(Model.Paginacion.TienePaginaSiguiente ? string.Empty : "disabled")" asp-action="Origenes" asp-route-textoBusqueda="@Model.TextoBusqueda" asp-route-pagina="@(Model.Paginacion.PaginaActual + 1)">Siguiente</a>
    </nav>
}
</section></section>
