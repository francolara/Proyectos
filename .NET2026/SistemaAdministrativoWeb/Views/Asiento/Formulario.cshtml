@model SistemaAdministrativoWeb.ViewModels.Contabilidad.AsientoIndexViewModel

@* =============================================
   Author:        FRANCO LARA
   Create date:   18/06/2026
   Description:   Agrega ayudas modal para origen/cuenta y campos documentarios en detalle.
   ============================================= *@

@* =============================================
   Author:        FRANCO LARA
   Create date:   22/06/2026
   Description:   Cambia la ayuda de plan de cuentas del asiento a carga inicial Top 100 con filtro remoto, la restringe a cuentas validas, agrega fecha de emision, deja el mes contable informativo y mejora el resumen visual de Debe/Haber/Diferencia sin exigir cuadre obligatorio.
   ============================================= *@
@* Firma: FRANCO LARA - 24/06/2026 | Restringe la ayuda popup de cuenta contable del asiento manual a cuentas del ultimo nivel y muestra mensaje si se intenta elegir una cuenta intermedia. *@
@* Firma: FRANCO LARA - 26/06/2026 | Ajusta la ayuda de comprobantes para grabar el codigo del tipo de documento y no su descripcion en el detalle del asiento. *@

@* =============================================
   Author:        FRANCO LARA
   Create date:   23/06/2026
   Description:   Oculta la fecha de contabilizacion del asiento, la fija automaticamente segun el periodo contable, reubica dicho periodo en la tarjeta derecha del encabezado, mantiene visible el origen actual al editar, agrega seleccion modal de centro de costo segun la cuenta contable y suma ayudas de persona/comprobantes con botones compactos por icono en el detalle.
   ============================================= *@
@* Firma: FRANCO LARA - 29/06/2026 | Exige tipo de cambio en cabecera y detalle del asiento manual, consulta siempre USD por fecha al cargar o cambiarla, muestra 3 decimales en ambos niveles y deja el valor por defecto en 0 para validar al grabar; corrige el script del formulario declarando la referencia del form para que el resumen Debe/Haber/Diferencia se recalcule tambien en asientos generados desde provisiones importadas. *@
@* Firma: FRANCO LARA - 06/07/2026 | Mantiene el formulario de asientos con 16 periodos contables y reorganiza el detalle para pantallas pequenas, evitando que los botones de ayuda se monten sobre los campos de texto. *@
@* Firma: FRANCO LARA - 09/07/2026 | Amplia el layout del detalle de asientos para escritorio y prioriza scroll horizontal util antes que superponer ayudas o inputs entre columnas. *@
@* Firma: FRANCO LARA - 10/07/2026 | Corrige el detalle de asientos para que use ancho horizontal real con scroll como compras, evitando comprimir columnas y manteniendo visible el boton Quitar segun el tamano de pantalla. *@
@* Firma: FRANCO LARA - 13/07/2026 | Ajusta el acceso al voucher contable para abrir el reporte en la misma pestana y no generar una ventana adicional al imprimir. *@
@* Firma: FRANCO LARA - 13/08/2026 | Duplica el ancho de TipoDoc, fija la columna Quitar para aprovechar el espacio disponible del detalle de asientos sin dejar una separacion vacia al final y reduce Item en 30%. *@

@{
    ViewData["Title"] = Model.Formulario.IdAsiento.HasValue ? "Editar asiento manual" : "Registrar asiento manual";
    ViewData["AdminShell"] = true;
    var origenSeleccionado = Model.Formulario.IdOrigen.HasValue
        ? Model.OrigenesManual.FirstOrDefault(x => x.IdOrigen == Model.Formulario.IdOrigen.Value)
        : null;
    var origenTexto = !string.IsNullOrWhiteSpace(Model.Formulario.OrigenTexto)
        ? Model.Formulario.OrigenTexto
        : origenSeleccionado is null
            ? "Seleccione origen"
            : $"{origenSeleccionado.CodigoOrigen} - {origenSeleccionado.NombreOrigen}";
    var periodoContableNombre = Model.MesesDisponibles.FirstOrDefault(x => x.Valor == Model.MesSeleccionado)?.Nombre ?? Model.PeriodoConsulta;
    var periodoContableTexto = $"{periodoContableNombre} {Model.AnioSeleccionado:0000}";

}

<style>
    .asiento-detail-wrap {
        overflow-x: auto;
        padding-bottom: 0.2rem;
    }

    .asiento-detail-table {
        width: max-content;
        min-width: 100%;
        table-layout: auto;
    }

    .asiento-detail-table th,
    .asiento-detail-table td {
        white-space: nowrap;
        min-width: 0;
    }

    .asiento-detail-table .detalle-col-full-sm,
    .asiento-detail-table .detalle-action-cell {
        white-space: normal;
    }

    .asiento-detail-table .asiento-col-cuenta {
        min-width: 18rem;
    }

    .asiento-detail-table .asiento-col-glosa {
        min-width: 18rem;
    }

    .asiento-detail-table .detalle-centro-costo-cell {
        min-width: 16rem;
    }

    .asiento-detail-table .detalle-persona-cell {
        min-width: 14rem;
    }

    .asiento-detail-table .detalle-tipodoc-cell {
        width: 18rem;
        min-width: 18rem;
    }

    .asiento-detail-table .detalle-serie-cell,
    .asiento-detail-table .detalle-referencia-cell {
        min-width: 7rem;
    }

    .asiento-detail-table .detalle-tc-cell,
    .asiento-detail-table .detalle-porcentaje-cell {
        min-width: 6rem;
    }

    .asiento-detail-table .detalle-orden-cell {
        width: 4.2rem;
        min-width: 4.2rem;
        max-width: 4.2rem;
    }

    .asiento-detail-table .detalle-action-cell {
        width: 8rem;
        min-width: 8rem;
        max-width: 8rem;
    }

    .asiento-detail-table .workspace-lookup-control,
    .asiento-detail-table .workspace-lookup-control-compact,
    .asiento-detail-table .workspace-lookup-control-inline-tools,
    .asiento-detail-table .form-control,
    .asiento-detail-table .form-select {
        width: 100%;
    }

    @@media (max-width: 991.98px) {
        .asiento-detail-table {
            min-width: 120rem;
        }
    }
</style>

<section class="dashboard-shell">
    <section class="workspace-window">
        <div class="workspace-window-head">
            <div>
                <span class="workspace-window-kicker">Formulario</span>
                <h1>@ViewData["Title"]</h1>
                <p>Registra origen, fechas, moneda y detalle del asiento con resumen visual de Debe, Haber y diferencia.</p>
                @if (Model.Formulario.IdAsiento.HasValue)
                {
                    <div class="mt-3">
                        <a asp-controller="Reporte"
                           asp-action="VoucherContable"
                           asp-route-idAsiento="@Model.Formulario.IdAsiento.Value"
                           class="btn btn-outline-secondary">
                            Ver voucher contable
                        </a>
                    </div>
                }
            </div>
            <div class="workspace-window-badge">
                <strong>@periodoContableTexto</strong>
                <span>Periodo contable</span>
                @if (Model.Formulario.NumeroAsiento.HasValue)
                {
                    <small>Asiento - @Model.Formulario.NumeroAsiento.Value</small>
                }
            </div>
        </div>
        <div class="workspace-window-body">
            @if (Model.OrigenesManual.Count == 0)
            {
                <div class="alert alert-warning">No existen origenes manuales activos para esta empresa. Revise el mantenimiento de origenes.</div>
            }
            else if (Model.Monedas.Count == 0)
            {
                <div class="alert alert-warning">No existen monedas activas disponibles. Ejecute los seeds o registre el maestro de monedas.</div>
            }
            else
            {
                <form asp-action="Guardar" method="post" id="asiento-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Formulario.IdAsiento" />
                    <input type="hidden" asp-for="Formulario.PermiteRegistroManual" />
                    <input type="hidden" name="periodo" value="@Model.PeriodoConsulta" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    @if (Model.Formulario.IdAsiento.HasValue && !Model.Formulario.PermiteRegistroManual)
                    {
                        <div class="alert alert-warning mb-3">Asiento generado automaticamente. Revise el detalle, pero cualquier cambio debe hacerse desde el modulo de origen.</div>
                    }

                    <div class="workspace-form-grid">
                        <div class="workspace-field">
                            <label asp-for="Formulario.IdOrigen" class="form-label">Origen</label>
                            <input type="hidden" asp-for="Formulario.IdOrigen" id="origenId" />
                            <div class="workspace-lookup-control">
                                <input id="origenTexto" class="form-control" value="@origenTexto" readonly />
                                <button type="button" class="btn btn-outline-secondary workspace-icon-button" id="abrirOrigenModal" title="Buscar origen" aria-label="Buscar origen"><i class="bi bi-search"></i></button>
                                <button type="button" class="btn btn-outline-secondary workspace-icon-button" id="limpiarOrigen" title="Limpiar origen" aria-label="Limpiar origen"><i class="bi bi-brush"></i></button>
                            </div>
                            <span asp-validation-for="Formulario.IdOrigen" class="text-danger"></span>
                        </div>
                        <div class="workspace-field">
                            <label asp-for="Formulario.FechaEmision" class="form-label">Fecha emision</label>
                            <input asp-for="Formulario.FechaEmision" class="form-control js-fecha-tipo-cambio" id="asientoFechaEmision" />
                            <span asp-validation-for="Formulario.FechaEmision" class="text-danger"></span>
                        </div>
                        <div class="workspace-field workspace-field-span-2">
                            <label asp-for="Formulario.Glosa" class="form-label">Glosa</label>
                            <input asp-for="Formulario.Glosa" class="form-control" />
                            <span asp-validation-for="Formulario.Glosa" class="text-danger"></span>
                        </div>
                        <div class="workspace-field">
                            <label asp-for="Formulario.IdMoneda" class="form-label">Moneda</label>
                            <select asp-for="Formulario.IdMoneda" class="form-select js-moneda-tipo-cambio" id="asientoMonedaSelect">
                                <option value="">Seleccione</option>
                                @foreach (var moneda in Model.Monedas)
                                {
                                    <option value="@moneda.IdMoneda" data-codigo-moneda="@moneda.CodigoMoneda" data-es-moneda-base="@(moneda.EsMonedaBase.ToString().ToLowerInvariant())">@moneda.CodigoMoneda - @moneda.NombreMoneda</option>
                                }
                            </select>
                            <span asp-validation-for="Formulario.IdMoneda" class="text-danger"></span>
                        </div>
                        <div class="workspace-field">
                            <label asp-for="Formulario.TipoCambio" class="form-label">Tipo de cambio</label>
                            <div class="input-group">
                                <input asp-for="Formulario.TipoCambio" class="form-control js-tipo-cambio-cabecera" id="asientoTipoCambio" />
                                <button type="button" class="btn btn-outline-secondary workspace-icon-button js-actualizar-tipo-cambio" title="Actualizar tipo de cambio" aria-label="Actualizar tipo de cambio"><i class="bi bi-arrow-clockwise"></i></button>
                            </div>
                            <span asp-validation-for="Formulario.TipoCambio" class="text-danger"></span>
                        </div>
                        <div class="workspace-field">
                            <label asp-for="Formulario.ReferenciaExterna" class="form-label">Referencia externa</label>
                            <input asp-for="Formulario.ReferenciaExterna" class="form-control" />
                            <span asp-validation-for="Formulario.ReferenciaExterna" class="text-danger"></span>
                        </div>
                        <div class="workspace-field">
                            <label asp-for="Formulario.Observacion" class="form-label">Observacion</label>
                            <input asp-for="Formulario.Observacion" class="form-control" />
                            <span asp-validation-for="Formulario.Observacion" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="workspace-section">
                        <div class="workspace-section-head workspace-section-head-compact">
                            <div>
                                <h2>Detalle contable</h2>
                            </div>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="agregar-linea">Agregar linea</button>
                        </div>

                        <div class="table-responsive workspace-table-wrap asiento-detail-wrap">
                            <table class="table align-middle app-table workspace-table asiento-detail-table" id="detalle-table">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th class="asiento-col-cuenta">Cuenta</th>
                                        <th class="asiento-col-glosa">Glosa detalle</th>
                                        <th>Centro costo</th>
                                        <th>RUC/DNI</th>
                                        <th>TipoDoc</th>
                                        <th>Serie</th>
                                        <th>Referencia</th>
                                        <th>TC</th>
                                        <th>Debe</th>
                                        <th>Haber</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < Model.Formulario.Detalles.Count; i++)
                                    {
                                        var tipoDocumentoActual = Model.Formulario.Detalles[i].TipoDocumento;
                                        var tipoDocumentoEsPersonalizado = !string.IsNullOrWhiteSpace(tipoDocumentoActual)
                                            && !Model.TiposDocumentoIdentidad.Any(x => x.Valor == tipoDocumentoActual);
                                        <tr>
                                            <td class="detalle-orden-cell" data-label="Item">
                                                <input asp-for="Formulario.Detalles[i].Item" class="form-control" readonly />
                                                <span asp-validation-for="Formulario.Detalles[i].Item" class="text-danger"></span>
                                            </td>
                                            <td class="asiento-col-cuenta detalle-col-full-sm" data-label="Cuenta">
                                                <input type="hidden" asp-for="Formulario.Detalles[i].IdPlanCuenta" class="js-cuenta-id" />
                                                <input type="hidden" asp-for="Formulario.Detalles[i].RequiereCentroCostoCuenta" class="js-cuenta-requiere-centro-costo" />
                                                <div class="workspace-lookup-control workspace-lookup-control-compact">
                                                    <input class="form-control js-cuenta-texto" value="@(string.IsNullOrWhiteSpace(Model.Formulario.Detalles[i].CuentaTexto) ? "Seleccione cuenta" : Model.Formulario.Detalles[i].CuentaTexto)" readonly />
                                                    <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-open-cuenta-modal" title="Buscar cuenta" aria-label="Buscar cuenta"><i class="bi bi-search"></i></button>
                                                </div>
                                                <span asp-validation-for="Formulario.Detalles[i].IdPlanCuenta" class="text-danger"></span>
                                            </td>
                                            <td class="asiento-col-glosa detalle-col-full-sm" data-label="Glosa detalle">
                                                <input asp-for="Formulario.Detalles[i].GlosaDetalle" class="form-control" />
                                                <span asp-validation-for="Formulario.Detalles[i].GlosaDetalle" class="text-danger"></span>
                                            </td>
                                            <td class="detalle-centro-costo-cell" data-label="Centro costo">
                                                <input type="hidden" asp-for="Formulario.Detalles[i].CodigoCentroCosto" class="js-centro-costo-codigo" />
                                                <div class="workspace-lookup-control workspace-lookup-control-compact workspace-lookup-control-inline-tools js-centro-costo-control">
                                                    <input class="form-control js-centro-costo-texto"
                                                           value="@Model.Formulario.Detalles[i].CentroCostoTexto"
                                                           placeholder="Centro de costo opcional"
                                                           readonly />
                                                    <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-open-centro-costo-modal" title="Buscar centro de costo" aria-label="Buscar centro de costo"><i class="bi bi-search"></i></button>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-clear-centro-costo" title="Limpiar centro de costo" aria-label="Limpiar centro de costo"><i class="bi bi-brush"></i></button>
                                                </div>
                                                <span asp-validation-for="Formulario.Detalles[i].CodigoCentroCosto" class="text-danger"></span>
                                            </td>
                                            <td class="detalle-persona-cell" data-label="RUC/DNI">
                                                <div class="workspace-lookup-control workspace-lookup-control-inline-tools">
                                                    <input asp-for="Formulario.Detalles[i].NumeroDocumento" class="form-control js-numero-documento" />
                                                    <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-open-persona-modal" title="Buscar persona" aria-label="Buscar persona"><i class="bi bi-person"></i></button>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-open-comprobante-modal" title="Buscar comprobante con saldo" aria-label="Buscar comprobante con saldo"><i class="bi bi-receipt"></i></button>
                                                </div>
                                                <span asp-validation-for="Formulario.Detalles[i].NumeroDocumento" class="text-danger"></span>
                                            </td>
                                            <td class="detalle-tipodoc-cell" data-label="TipoDoc">
                                                <select asp-for="Formulario.Detalles[i].TipoDocumento" class="form-select form-select-sm workspace-form-select-compact">
                                                    <option value="">Seleccione</option>
                                                    @if (tipoDocumentoEsPersonalizado)
                                                    {
                                                        <option value="@tipoDocumentoActual">@tipoDocumentoActual</option>
                                                    }
                                                    @foreach (var tipoDocumento in Model.TiposDocumentoIdentidad)
                                                    {
                                                        <option value="@tipoDocumento.Valor">@tipoDocumento.Texto</option>
                                                    }
                                                </select>
                                                <span asp-validation-for="Formulario.Detalles[i].TipoDocumento" class="text-danger"></span>
                                            </td>
                                            <td class="detalle-serie-cell" data-label="Serie">
                                                <input asp-for="Formulario.Detalles[i].Serie" class="form-control" />
                                                <span asp-validation-for="Formulario.Detalles[i].Serie" class="text-danger"></span>
                                            </td>
                                            <td class="detalle-referencia-cell" data-label="Referencia">
                                                <input asp-for="Formulario.Detalles[i].ReferenciaLinea" class="form-control" />
                                                <span asp-validation-for="Formulario.Detalles[i].ReferenciaLinea" class="text-danger"></span>
                                            </td>
                                            <td class="detalle-tc-cell" data-label="TC">
                                                <input asp-for="Formulario.Detalles[i].TipoCambioLinea" class="form-control js-tipo-cambio-linea" />
                                                <span asp-validation-for="Formulario.Detalles[i].TipoCambioLinea" class="text-danger"></span>
                                            </td>
                                            <td class="detalle-porcentaje-cell" data-label="Debe">
                                                <input asp-for="Formulario.Detalles[i].Debe" class="form-control js-debe" />
                                                <span asp-validation-for="Formulario.Detalles[i].Debe" class="text-danger"></span>
                                            </td>
                                            <td class="detalle-porcentaje-cell" data-label="Haber">
                                                <input asp-for="Formulario.Detalles[i].Haber" class="form-control js-haber" />
                                                <span asp-validation-for="Formulario.Detalles[i].Haber" class="text-danger"></span>
                                            </td>
                                            <td class="text-end detalle-action-cell" data-label="Accion">
                                                <button type="button" class="btn btn-outline-secondary btn-sm js-remove-row">Quitar</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="workspace-balance-summary" id="balance-summary">
                            <article class="workspace-balance-card">
                                <span>Total Debe</span>
                                <strong id="total-debe">0.00</strong>
                            </article>
                            <article class="workspace-balance-card">
                                <span>Total Haber</span>
                                <strong id="total-haber">0.00</strong>
                            </article>
                            <article class="workspace-balance-card workspace-balance-card-diff" id="balance-diff-card">
                                <span>Total Diferencia</span>
                                <strong id="total-diferencia">0.00</strong>
                                <small id="balance-diff-state">Pendiente de revision</small>
                            </article>
                        </div>
                    </div>

                    <div class="workspace-actions">
                        @if (Model.Formulario.PermiteRegistroManual)
                        {
                            <button type="submit" class="btn btn-primary">Guardar asiento</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary" disabled>Guardar asiento</button>
                        }
                        <a asp-action="Index" asp-route-anio="@Model.AnioSeleccionado" asp-route-mes="@Model.MesSeleccionado" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            }
        </div>
    </section>
</section>

<div class="modal fade workspace-modal" id="origenModal" tabindex="-1" aria-labelledby="origenModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content workspace-modal-content">
            <div class="modal-header workspace-modal-header">
                <div>
                    <span class="workspace-window-kicker">Ayuda contable</span>
                    <h2 class="workspace-modal-title" id="origenModalLabel">Seleccionar origen</h2>
                    <p class="workspace-modal-subtitle">El origen define el subdiario y el correlativo del asiento en el periodo.</p>
                </div>
                <button type="button" class="btn-close workspace-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body workspace-modal-body">
                <div class="workspace-filter-card mt-0">
                    <div class="workspace-field">
                        <label class="form-label" for="origenFiltro">Filtro</label>
                        <input id="origenFiltro" class="form-control" placeholder="Codigo o nombre de origen" autocomplete="off" />
                    </div>
                </div>
                <div class="table-responsive workspace-table-wrap">
                    <table class="table align-middle app-table workspace-table workspace-lookup-table">
                        <thead>
                            <tr>
                                <th class="workspace-lookup-select-cell">Sel.</th>
                                <th>Codigo</th>
                                <th>Origen</th>
                                <th>Modulo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr data-origen-empty-row="true" class="d-none">
                                <td colspan="4">
                                    <div class="app-empty-state app-empty-state-inline">
                                        <i class="bi bi-search"></i>
                                        <div>
                                            <strong>No hay origenes con ese filtro</strong>
                                            <p>Ajusta el texto para ubicar el origen manual.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            @foreach (var origen in Model.OrigenesManual)
                            {
                                var estaSeleccionado = Model.Formulario.IdOrigen == origen.IdOrigen;
                                <tr class="workspace-lookup-row @(estaSeleccionado ? "is-selected" : string.Empty)"
                                    data-origen-row="true"
                                    data-id="@origen.IdOrigen"
                                    data-codigo="@origen.CodigoOrigen"
                                    data-nombre="@origen.NombreOrigen"
                                    data-modulo="@origen.ModuloOrigen">
                                    <td class="workspace-lookup-select-cell">
                                        @if (estaSeleccionado)
                                        {
                                            <input class="form-check-input" type="radio" name="origenSeleccion" value="@origen.IdOrigen" checked />
                                        }
                                        else
                                        {
                                            <input class="form-check-input" type="radio" name="origenSeleccion" value="@origen.IdOrigen" />
                                        }
                                    </td>
                                    <td class="workspace-tree-code">@origen.CodigoOrigen</td>
                                    <td>@origen.NombreOrigen</td>
                                    <td>@origen.ModuloOrigen</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer workspace-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="aceptarOrigen">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade workspace-modal" id="asientoCuentaModal" tabindex="-1" aria-labelledby="asientoCuentaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content workspace-modal-content">
            <div class="modal-header workspace-modal-header">
                <div>
                    <span class="workspace-window-kicker">Ayuda contable</span>
