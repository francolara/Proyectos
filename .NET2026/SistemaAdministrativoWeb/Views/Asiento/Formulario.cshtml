@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const tableBody = document.querySelector("#detalle-table tbody");
            const template = document.getElementById("detalle-row-template");
            const addButton = document.getElementById("agregar-linea");
            const form = document.getElementById("asiento-form");
            const totalDebeLabel = document.getElementById("total-debe");
            const totalHaberLabel = document.getElementById("total-haber");
            const diferenciaLabel = document.getElementById("total-diferencia");
            const balanceDiffCard = document.getElementById("balance-diff-card");
            const balanceDiffState = document.getElementById("balance-diff-state");
            const origenModalEl = document.getElementById("origenModal");
            const cuentaModalEl = document.getElementById("asientoCuentaModal");
            const centroCostoModalEl = document.getElementById("centroCostoModal");
            const personaModalEl = document.getElementById("personaModal");
            const comprobantePersonaModalEl = document.getElementById("comprobantePersonaModal");
            const origenModal = origenModalEl && window.bootstrap ? bootstrap.Modal.getOrCreateInstance(origenModalEl) : null;
            const cuentaModal = cuentaModalEl && window.bootstrap ? bootstrap.Modal.getOrCreateInstance(cuentaModalEl) : null;
            const centroCostoModal = centroCostoModalEl && window.bootstrap ? bootstrap.Modal.getOrCreateInstance(centroCostoModalEl) : null;
            const personaModal = personaModalEl && window.bootstrap ? bootstrap.Modal.getOrCreateInstance(personaModalEl) : null;
            const comprobantePersonaModal = comprobantePersonaModalEl && window.bootstrap ? bootstrap.Modal.getOrCreateInstance(comprobantePersonaModalEl) : null;
            const origenRows = Array.from(document.querySelectorAll("[data-origen-row='true']"));
            const cuentaResultadosBodyEl = document.getElementById("asientoCuentaResultados");
            const centroCostoResultadosBodyEl = document.getElementById("asientoCentroCostoResultados");
            const personaResultadosBodyEl = document.getElementById("asientoPersonaResultados");
            const comprobantePersonaResultadosBodyEl = document.getElementById("asientoComprobantePersonaResultados");
            const origenFiltro = document.getElementById("origenFiltro");
            const cuentaFiltro = document.getElementById("cuentaFiltro");
            const cuentaNivelFiltro = document.getElementById("cuentaNivelFiltro");
            const centroCostoFiltro = document.getElementById("centroCostoFiltro");
            const personaFiltro = document.getElementById("personaFiltro");
            const comprobantePersonaNumeroDocumento = document.getElementById("comprobantePersonaNumeroDocumento");
            const comprobantePersonaFiltro = document.getElementById("comprobantePersonaFiltro");
            const fechaEmisionEl = document.getElementById("asientoFechaEmision");
            const monedaSelectEl = document.getElementById("asientoMonedaSelect");
            const tipoCambioCabeceraEl = document.getElementById("asientoTipoCambio");
            const actualizarTipoCambioButton = document.querySelector(".js-actualizar-tipo-cambio");
            const buscarCuentasUrl = '@Url.Action("BuscarAyuda", "PlanCuenta")';
            const buscarCentroCostoUrl = '@Url.Action("BuscarAyuda", "CentroCosto")';
            const buscarPersonasUrl = '@Url.Action("BuscarPersonasAyuda", "Asiento")';
            const buscarComprobantesPersonaUrl = '@Url.Action("BuscarComprobantesPersonaAyuda", "Asiento")';
            const obtenerTipoCambioUrl = '@Url.Action("ObtenerValorPorFecha", "TipoCambio")';
            const origenId = document.getElementById("origenId");
            const origenTexto = document.getElementById("origenTexto");
            let origenSeleccion = origenRows.find((row) => row.classList.contains("is-selected")) || null;
            let cuentaSeleccion = null;
            let cuentaRowActiva = null;
            let cuentaBusquedaProgramada = null;
            let centroCostoSeleccion = null;
            let centroCostoRowActiva = null;
            let centroCostoBusquedaProgramada = null;
            let personaSeleccion = null;
            let personaRowActiva = null;
            let personaBusquedaProgramada = null;
            let comprobantePersonaSeleccion = null;
            let comprobantePersonaRowActiva = null;
            let comprobantePersonaBusquedaProgramada = null;

            if (!tableBody || !template || !addButton || !totalDebeLabel || !totalHaberLabel || !diferenciaLabel) {
                return;
            }

            const parseAmount = (value) => {
                const parsed = parseFloat((value ?? "0").replace(",", "."));
                return Number.isNaN(parsed) ? 0 : parsed;
            };

            const formatTipoCambioInput = (input) => {
                if (!input) {
                    return;
                }

                input.value = parseAmount(input.value).toFixed(3);
            };

            const sincronizarTipoCambioDetalle = (row = null) => {
                const valorCabecera = Number(tipoCambioCabeceraEl?.value || 0);
                if (!Number.isFinite(valorCabecera) || valorCabecera <= 0) {
                    return;
                }

                const aplicar = (targetRow) => {
                    const input = targetRow?.querySelector(".js-tipo-cambio-linea");
                    if (input) {
                        input.value = valorCabecera.toFixed(3);
                    }
                };

                if (row) {
                    aplicar(row);
                    return;
                }

                Array.from(tableBody.querySelectorAll("tr")).forEach(aplicar);
            };

            const consultarTipoCambioCabecera = async (mostrarMensaje) => {
                const fecha = String(fechaEmisionEl?.value || "").trim();

                if (!fecha) {
                    if (mostrarMensaje) {
                        window.alert("Seleccione fecha antes de actualizar el tipo de cambio.");
                    }
                    return false;
                }

                const response = await fetch(`${obtenerTipoCambioUrl}?${new URLSearchParams({ fecha, idMoneda: "USD" }).toString()}`, { cache: "no-store" });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    if (mostrarMensaje) {
                        window.alert(payload.mensaje || "No se pudo obtener el tipo de cambio.");
                    }
                    return false;
                }

                if (!payload.encontrado) {
                    if (mostrarMensaje) {
                        window.alert(payload.mensaje || "No existe un tipo de cambio registrado para la fecha y moneda seleccionadas.");
                    }
                    return false;
                }

                if (tipoCambioCabeceraEl) {
                    tipoCambioCabeceraEl.value = Number(payload.tipoCambio || 0).toFixed(3);
                }
                sincronizarTipoCambioDetalle();
                return true;
            };

            const marcarSeleccion = (rows, selectedRow) => {
                rows.forEach((row) => {
                    row.classList.toggle("is-selected", row === selectedRow);
                    const radio = row.querySelector("input[type='radio']");
                    if (radio) {
                        radio.checked = row === selectedRow;
                    }
                });
            };

            const aplicarFiltroOrigen = () => {
                const texto = String(origenFiltro?.value || "").trim().toLowerCase();
                const emptyRow = document.querySelector("[data-origen-empty-row='true']");
                let visibles = 0;

                origenRows.forEach((row) => {
                    const busqueda = `${row.dataset.codigo || ""} ${row.dataset.nombre || ""} ${row.dataset.modulo || ""}`.toLowerCase();
                    const visible = !texto || busqueda.includes(texto);
                    row.classList.toggle("d-none", !visible);
                    if (visible) {
                        visibles += 1;
                    }
                });

                emptyRow?.classList.toggle("d-none", visibles > 0);
            };

            const marcarSeleccionCuenta = () => {
                const rows = Array.from(cuentaResultadosBodyEl?.querySelectorAll("[data-cuenta-row='true']") || []);
                rows.forEach((row) => {
                    const seleccionado = cuentaSeleccion && row.dataset.id === String(cuentaSeleccion.idPlanCuenta);
                    row.classList.toggle("is-selected", seleccionado);
                    const radio = row.querySelector("input[type='radio']");
                    if (radio) {
                        radio.checked = Boolean(seleccionado);
                    }
                });
            };

            const marcarSeleccionCentroCosto = () => {
                const rows = Array.from(centroCostoResultadosBodyEl?.querySelectorAll("[data-centro-costo-row='true']") || []);
                rows.forEach((row) => {
                    const seleccionado = centroCostoSeleccion && row.dataset.codigo === String(centroCostoSeleccion.codigoCentroCosto || "");
                    row.classList.toggle("is-selected", seleccionado);
                    const radio = row.querySelector("input[type='radio']");
                    if (radio) {
                        radio.checked = Boolean(seleccionado);
                    }
                });
            };

            const marcarSeleccionPersona = () => {
                const rows = Array.from(personaResultadosBodyEl?.querySelectorAll("[data-persona-row='true']") || []);
                rows.forEach((row) => {
                    const seleccionado = personaSeleccion && row.dataset.id === String(personaSeleccion.idPersona || "");
                    row.classList.toggle("is-selected", Boolean(seleccionado));
                    const radio = row.querySelector("input[type='radio']");
                    if (radio) {
                        radio.checked = Boolean(seleccionado);
                    }
                });
            };

            const marcarSeleccionComprobantePersona = () => {
                const rows = Array.from(comprobantePersonaResultadosBodyEl?.querySelectorAll("[data-comprobante-row='true']") || []);
                rows.forEach((row) => {
                    const seleccionado = comprobantePersonaSeleccion
                        && row.dataset.modulo === String(comprobantePersonaSeleccion.moduloOperacion || "")
                        && row.dataset.id === String(comprobantePersonaSeleccion.idRegistro || "");
                    row.classList.toggle("is-selected", Boolean(seleccionado));
                    const radio = row.querySelector("input[type='radio']");
                    if (radio) {
                        radio.checked = Boolean(seleccionado);
                    }
                });
            };

            const renderCuentaResultados = (items) => {
                if (!cuentaResultadosBodyEl) {
                    return;
                }

                const emptyRow = cuentaResultadosBodyEl.querySelector("[data-cuenta-empty-row='true']");
                cuentaResultadosBodyEl.querySelectorAll("[data-cuenta-row='true']").forEach((row) => row.remove());
                emptyRow?.classList.toggle("d-none", items.length > 0);

                items.forEach((item) => {
                    const row = document.createElement("tr");
                    row.className = "workspace-lookup-row";
                    row.dataset.cuentaRow = "true";
                    row.dataset.id = String(item.idPlanCuenta || "");
                    row.dataset.codigo = String(item.codigoCuenta || "");
                    row.dataset.nombre = String(item.nombreCuenta || "");
                    row.dataset.nivel = String(item.nivelCuenta || "");
                    row.innerHTML = `
                        <td class="workspace-lookup-select-cell">
                            <input class="form-check-input" type="radio" name="cuentaSeleccion" value="${String(item.idPlanCuenta || "")}" />
                        </td>
                        <td class="workspace-tree-code">${String(item.codigoCuenta || "")}</td>
                        <td>${String(item.nombreCuenta || "")}</td>
                        <td>${String(item.nivelCuenta || "")}</td>
                        <td>${item.requiereCentroCosto ? "Si" : "No"}</td>`;
                    row.addEventListener("click", () => {
                        cuentaSeleccion = item;
                        marcarSeleccionCuenta();
                    });
                    cuentaResultadosBodyEl.appendChild(row);
                });

                marcarSeleccionCuenta();
            };

            const renderCentroCostoResultados = (items) => {
                if (!centroCostoResultadosBodyEl) {
                    return;
                }

                const emptyRow = centroCostoResultadosBodyEl.querySelector("[data-centro-costo-empty-row='true']");
                centroCostoResultadosBodyEl.querySelectorAll("[data-centro-costo-row='true']").forEach((row) => row.remove());
                emptyRow?.classList.toggle("d-none", items.length > 0);

                items.forEach((item) => {
                    const row = document.createElement("tr");
                    row.className = "workspace-lookup-row";
                    row.dataset.centroCostoRow = "true";
                    row.dataset.id = String(item.idCentroCosto || "");
                    row.dataset.codigo = String(item.codigoCentroCosto || "");
                    row.dataset.nombre = String(item.nombreCentroCosto || "");
                    row.innerHTML = `
                        <td class="workspace-lookup-select-cell">
                            <input class="form-check-input" type="radio" name="centroCostoSeleccion" value="${String(item.idCentroCosto || "")}" />
                        </td>
                        <td class="workspace-tree-code">${String(item.codigoCentroCosto || "")}</td>
                        <td>${String(item.nombreCentroCosto || "")}</td>`;
                    row.addEventListener("click", () => {
                        centroCostoSeleccion = item;
                        marcarSeleccionCentroCosto();
                    });
                    centroCostoResultadosBodyEl.appendChild(row);
                });

                marcarSeleccionCentroCosto();
            };

            const renderPersonaResultados = (items) => {
                if (!personaResultadosBodyEl) {
                    return;
                }

                const emptyRow = personaResultadosBodyEl.querySelector("[data-persona-empty-row='true']");
                personaResultadosBodyEl.querySelectorAll("[data-persona-row='true']").forEach((row) => row.remove());
                emptyRow?.classList.toggle("d-none", items.length > 0);

                items.forEach((item) => {
                    const row = document.createElement("tr");
                    row.className = "workspace-lookup-row";
                    row.dataset.personaRow = "true";
                    row.dataset.id = String(item.idPersona || "");
                    row.dataset.documento = String(item.numeroDocumento || "");
                    row.dataset.nombre = String(item.nombreCompleto || "");
                    row.innerHTML = `
                        <td class="workspace-lookup-select-cell">
                            <input class="form-check-input" type="radio" name="personaSeleccion" value="${String(item.idPersona || "")}" />
                        </td>
                        <td>${String(item.nombreTipoDocumento || "")}</td>
                        <td class="workspace-tree-code">${String(item.numeroDocumento || "")}</td>
                        <td>${String(item.nombreCompleto || "")}</td>
                        <td>${String(item.tipoPersona || "")}</td>`;
                    row.addEventListener("click", () => {
                        personaSeleccion = item;
                        marcarSeleccionPersona();
                    });
                    personaResultadosBodyEl.appendChild(row);
                });

                marcarSeleccionPersona();
            };

            const renderComprobantePersonaResultados = (items) => {
                if (!comprobantePersonaResultadosBodyEl) {
                    return;
                }

                const emptyRow = comprobantePersonaResultadosBodyEl.querySelector("[data-comprobante-empty-row='true']");
                comprobantePersonaResultadosBodyEl.querySelectorAll("[data-comprobante-row='true']").forEach((row) => row.remove());
                emptyRow?.classList.toggle("d-none", items.length > 0);

                items.forEach((item) => {
                    const row = document.createElement("tr");
                    row.className = "workspace-lookup-row";
                    row.dataset.comprobanteRow = "true";
                    row.dataset.modulo = String(item.moduloOperacion || "");
                    row.dataset.id = String(item.idRegistro || "");
                    row.innerHTML = `
                        <td class="workspace-lookup-select-cell">
                            <input class="form-check-input" type="radio" name="comprobantePersonaSeleccion" value="${String(item.idRegistro || "")}" />
                        </td>
                        <td>${String(item.moduloOperacion || "")}</td>
                        <td>${String(item.fechaEmision || "")}</td>
                        <td>${String(item.nombrePersona || "")}</td>
                        <td>${String(item.descripcionTipoComprobante || "")} ${String(item.serie || "")}-${String(item.numero || "")}</td>
                        <td>${String(item.codigoMoneda || "")}</td>
                        <td class="text-end">${Number(item.importeTotal || 0).toFixed(2)}</td>
                        <td class="text-end">${Number(item.saldo || 0).toFixed(2)}</td>`;
                    row.addEventListener("click", () => {
                        comprobantePersonaSeleccion = item;
                        marcarSeleccionComprobantePersona();
                    });
                    comprobantePersonaResultadosBodyEl.appendChild(row);
                });

                marcarSeleccionComprobantePersona();
            };

            const cargarCuentasAyuda = async () => {
                const params = new URLSearchParams({ tamanoPagina: "100", soloMovimiento: "true" });
                const filtro = String(cuentaFiltro?.value || "").trim();
                const nivel = String(cuentaNivelFiltro?.value || "").trim();
                if (filtro.length >= 2) {
                    params.append("textoBusqueda", filtro);
                }
                if (nivel) {
                    params.append("nivelCuenta", nivel);
                }

                const response = await fetch(`${buscarCuentasUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    throw new Error(payload.mensaje || "No se pudo cargar el plan de cuentas.");
                }

                renderCuentaResultados(payload.items || []);
            };

            const cargarCentroCostoAyuda = async () => {
                const params = new URLSearchParams({ tamanoPagina: "100" });
                const filtro = String(centroCostoFiltro?.value || "").trim();
                if (filtro.length >= 2) {
                    params.append("textoBusqueda", filtro);
                }

                const response = await fetch(`${buscarCentroCostoUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    throw new Error(payload.mensaje || "No se pudo cargar el catalogo de centros de costo.");
                }

                renderCentroCostoResultados(payload.items || []);
            };

            const cargarPersonasAyuda = async () => {
                const params = new URLSearchParams({ tamanoPagina: "20" });
                const filtro = String(personaFiltro?.value || "").trim();
                if (filtro.length >= 2) {
                    params.append("textoBusqueda", filtro);
                }

                const response = await fetch(`${buscarPersonasUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    throw new Error(payload.mensaje || "No se pudo cargar la ayuda de personas.");
                }

                renderPersonaResultados(payload.items || []);
            };

            const cargarComprobantesPersonaAyuda = async () => {
                const numeroDocumento = String(comprobantePersonaNumeroDocumento?.value || "").trim();
                if (!numeroDocumento) {
                    renderComprobantePersonaResultados([]);
                    return;
                }

                const params = new URLSearchParams({ numeroDocumento });
                const filtro = String(comprobantePersonaFiltro?.value || "").trim();
                if (filtro.length >= 2) {
                    params.append("textoBusqueda", filtro);
                }

                const response = await fetch(`${buscarComprobantesPersonaUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    throw new Error(payload.mensaje || "No se pudo cargar la ayuda de comprobantes.");
                }

                renderComprobantePersonaResultados(payload.items || []);
            };

            const construirGlosaDetalleDesdeComprobante = (item) => {
                const modulo = String(item?.moduloOperacion || "").trim().toUpperCase() === "VEN" ? "Venta" : "Compra";
                const tipoComprobante = String(item?.descripcionTipoComprobante || "").trim();
                const serie = String(item?.serie || "").trim();
                const numero = String(item?.numero || "").trim();
                const comprobante = [serie, numero].filter(Boolean).join("-");

                return [modulo, tipoComprobante, comprobante].filter(Boolean).join(" ");
            };

            const programarBusquedaCuenta = () => {
                if (cuentaBusquedaProgramada) {
                    window.clearTimeout(cuentaBusquedaProgramada);
                }

                cuentaBusquedaProgramada = window.setTimeout(async () => {
                    try {
                        await cargarCuentasAyuda();
                    } catch (error) {
                        console.warn(error);
                        renderCuentaResultados([]);
                    }
                }, 250);
            };

            const programarBusquedaCentroCosto = () => {
                if (centroCostoBusquedaProgramada) {
                    window.clearTimeout(centroCostoBusquedaProgramada);
                }

                centroCostoBusquedaProgramada = window.setTimeout(async () => {
                    try {
                        await cargarCentroCostoAyuda();
                    } catch (error) {
                        console.warn(error);
                        renderCentroCostoResultados([]);
                    }
                }, 250);
            };

            const programarBusquedaPersona = () => {
                if (personaBusquedaProgramada) {
                    window.clearTimeout(personaBusquedaProgramada);
                }

                personaBusquedaProgramada = window.setTimeout(async () => {
                    try {
                        await cargarPersonasAyuda();
                    } catch (error) {
                        console.warn(error);
                        renderPersonaResultados([]);
                    }
                }, 250);
            };

            const programarBusquedaComprobantePersona = () => {
                if (comprobantePersonaBusquedaProgramada) {
                    window.clearTimeout(comprobantePersonaBusquedaProgramada);
                }

                comprobantePersonaBusquedaProgramada = window.setTimeout(async () => {
                    try {
                        await cargarComprobantesPersonaAyuda();
                    } catch (error) {
                        console.warn(error);
                        renderComprobantePersonaResultados([]);
                    }
                }, 250);
            };

            const abrirCuentaModal = async (row) => {
                cuentaRowActiva = row;
                const cuentaIdActual = row.querySelector(".js-cuenta-id")?.value || "";
                cuentaSeleccion = cuentaIdActual ? { idPlanCuenta: cuentaIdActual } : null;
                try {
                    await cargarCuentasAyuda();
                } catch (error) {
                    console.warn(error);
                    renderCuentaResultados([]);
                }
                cuentaModal?.show();
            };

            const abrirCentroCostoModal = async (row) => {
                centroCostoRowActiva = row;
                const codigoActual = row.querySelector(".js-centro-costo-codigo")?.value || "";
                centroCostoSeleccion = codigoActual ? { codigoCentroCosto: codigoActual } : null;
                try {
                    await cargarCentroCostoAyuda();
                } catch (error) {
                    console.warn(error);
                    renderCentroCostoResultados([]);
                }
                centroCostoModal?.show();
            };

            const abrirPersonaModal = async (row) => {
                personaRowActiva = row;
                const numeroDocumentoActual = row.querySelector(".js-numero-documento")?.value || "";
                personaSeleccion = numeroDocumentoActual ? { numeroDocumento: numeroDocumentoActual } : null;
                if (personaFiltro) {
                    personaFiltro.value = numeroDocumentoActual;
                }

                try {
                    await cargarPersonasAyuda();
                } catch (error) {
                    console.warn(error);
                    renderPersonaResultados([]);
                }

                personaModal?.show();
            };

            const abrirComprobantePersonaModal = async (row) => {
                comprobantePersonaRowActiva = row;
                comprobantePersonaSeleccion = null;
                const numeroDocumentoActual = row.querySelector(".js-numero-documento")?.value || "";

                if (!numeroDocumentoActual.trim()) {
                    window.alert("Seleccione una persona o ingrese primero un RUC/DNI en la linea.");
                    return;
                }

                if (comprobantePersonaNumeroDocumento) {
                    comprobantePersonaNumeroDocumento.value = numeroDocumentoActual.trim();
                }
                if (comprobantePersonaFiltro) {
                    comprobantePersonaFiltro.value = "";
                }

                try {
                    await cargarComprobantesPersonaAyuda();
                } catch (error) {
                    console.warn(error);
                    renderComprobantePersonaResultados([]);
                }

                comprobantePersonaModal?.show();
            };

            const actualizarEstadoCentroCosto = (row, requiereCentroCosto) => {
                const hidden = row.querySelector(".js-cuenta-requiere-centro-costo");
                const control = row.querySelector(".js-centro-costo-control");
                const texto = row.querySelector(".js-centro-costo-texto");
                if (hidden) {
                    hidden.value = requiereCentroCosto ? "true" : "false";
                }
                control?.classList.toggle("is-required", requiereCentroCosto);
                if (texto) {
                    texto.placeholder = requiereCentroCosto
                        ? "Seleccione centro de costo obligatorio"
                        : "Centro de costo opcional";
                }
            };

            const bindRowActions = (row) => {
                row.querySelector(".js-remove-row")?.addEventListener("click", () => {
                    if (tableBody.querySelectorAll("tr").length <= 2) {
                        return;
                    }

                    row.remove();
                    refreshRows();
                });

                row.querySelector(".js-open-cuenta-modal")?.addEventListener("click", () => {
                    abrirCuentaModal(row);
                });

                row.querySelector(".js-open-centro-costo-modal")?.addEventListener("click", () => {
                    abrirCentroCostoModal(row);
                });

                row.querySelector(".js-open-persona-modal")?.addEventListener("click", () => {
                    abrirPersonaModal(row);
                });

                row.querySelector(".js-open-comprobante-modal")?.addEventListener("click", () => {
                    abrirComprobantePersonaModal(row);
                });

                row.querySelector(".js-clear-centro-costo")?.addEventListener("click", () => {
                    const codigoInput = row.querySelector(".js-centro-costo-codigo");
                    const textoInput = row.querySelector(".js-centro-costo-texto");
                    if (codigoInput) {
                        codigoInput.value = "";
                    }
                    if (textoInput) {
                        textoInput.value = "";
                    }
                });

                const requiereCentroCosto = String(row.querySelector(".js-cuenta-requiere-centro-costo")?.value || "").toLowerCase() === "true";
                actualizarEstadoCentroCosto(row, requiereCentroCosto);
            };

            const refreshRows = () => {
                const rows = Array.from(tableBody.querySelectorAll("tr"));
                let totalDebe = 0;
                let totalHaber = 0;

                rows.forEach((row, index) => {
                    row.querySelectorAll("input, select, textarea, span").forEach((element) => {
                        ["name", "id", "for", "data-valmsg-for"].forEach((attribute) => {
                            const currentValue = element.getAttribute(attribute);
                            if (!currentValue) {
                                return;
                            }

                            const updatedValue = currentValue
                                .replaceAll("__index__", index)
                                .replace(/Formulario\.Detalles\[\d+\]/g, `Formulario.Detalles[${index}]`)
                                .replace(/Formulario_Detalles_\d+__/g, `Formulario_Detalles_${index}__`);

                            if (updatedValue !== currentValue) {
                                element.setAttribute(attribute, updatedValue);
                            }
                        });
                    });

                    const itemInput = row.querySelector('input[name$=".Item"]');
                    if (itemInput) {
                        itemInput.value = (index + 1).toString();
                    }

                    totalDebe += parseAmount(row.querySelector(".js-debe")?.value);
                    totalHaber += parseAmount(row.querySelector(".js-haber")?.value);
                });

                totalDebeLabel.textContent = totalDebe.toFixed(2);
                totalHaberLabel.textContent = totalHaber.toFixed(2);
                const diferencia = totalDebe - totalHaber;
                const estaCuadrado = Math.abs(diferencia) < 0.005;
                diferenciaLabel.textContent = diferencia.toFixed(2);
                balanceDiffCard?.classList.toggle("is-balanced", estaCuadrado);
                balanceDiffCard?.classList.toggle("is-unbalanced", !estaCuadrado);
                if (balanceDiffState) {
                    balanceDiffState.textContent = estaCuadrado
                        ? "Asiento cuadrado"
                        : "Asiento con diferencia";
                }
            };

            addButton.addEventListener("click", () => {
                const index = tableBody.querySelectorAll("tr").length;
                const html = template.innerHTML.replaceAll("__index__", index);
                tableBody.insertAdjacentHTML("beforeend", html);
                const row = tableBody.lastElementChild;
                if (row) {
                    bindRowActions(row);
                    sincronizarTipoCambioDetalle(row);
                }
                refreshRows();
            });

            fechaEmisionEl?.addEventListener("change", () => {
                consultarTipoCambioCabecera(false).catch((error) => console.warn(error));
            });
            monedaSelectEl?.addEventListener("change", () => {
                consultarTipoCambioCabecera(false).catch((error) => console.warn(error));
            });
            formatTipoCambioInput(tipoCambioCabeceraEl);
            Array.from(tableBody.querySelectorAll(".js-tipo-cambio-linea")).forEach((input) => formatTipoCambioInput(input));
            form?.addEventListener("blur", (event) => {
                const input = event.target;
                if (input instanceof HTMLInputElement && input.matches(".js-tipo-cambio-cabecera, .js-tipo-cambio-linea")) {
                    formatTipoCambioInput(input);
                    if (input.matches(".js-tipo-cambio-cabecera")) {
                        sincronizarTipoCambioDetalle();
                    }
                }
            }, true);
            form?.addEventListener("change", (event) => {
                const input = event.target;
                if (input instanceof HTMLInputElement && input.matches(".js-tipo-cambio-cabecera, .js-tipo-cambio-linea")) {
                    formatTipoCambioInput(input);
                    if (input.matches(".js-tipo-cambio-cabecera")) {
                        sincronizarTipoCambioDetalle();
                    }
                }
            });
            actualizarTipoCambioButton?.addEventListener("click", async () => {
                try {
                    await consultarTipoCambioCabecera(true);
                } catch (error) {
                    console.warn(error);
                    window.alert("No se pudo obtener el tipo de cambio.");
                }
            });
            consultarTipoCambioCabecera(false).catch((error) => console.warn(error));

            document.getElementById("abrirOrigenModal")?.addEventListener("click", () => {
                aplicarFiltroOrigen();
                origenModal?.show();
            });

            document.getElementById("limpiarOrigen")?.addEventListener("click", () => {
                if (origenId) {
                    origenId.value = "";
                }
                if (origenTexto) {
                    origenTexto.value = "Seleccione origen";
                }
                origenSeleccion = null;
                marcarSeleccion(origenRows, null);
            });

            origenRows.forEach((row) => {
                row.addEventListener("click", () => {
                    origenSeleccion = row;
                    marcarSeleccion(origenRows, row);
                });
            });

            document.getElementById("aceptarOrigen")?.addEventListener("click", () => {
                if (origenSeleccion && origenId && origenTexto) {
                    origenId.value = origenSeleccion.dataset.id || "";
                    origenTexto.value = `${origenSeleccion.dataset.codigo || ""} - ${origenSeleccion.dataset.nombre || ""}`;
                }
                origenModal?.hide();
            });

            document.getElementById("aceptarCuenta")?.addEventListener("click", () => {
                if (String(cuentaSeleccion?.nivelCuenta || "") !== "5") {
                    window.alert("Seleccione una cuenta contable de nivel 5.");
                    return;
                }

                if (cuentaSeleccion && cuentaRowActiva) {
                    const cuentaIdInput = cuentaRowActiva.querySelector(".js-cuenta-id");
                    const cuentaTextoInput = cuentaRowActiva.querySelector(".js-cuenta-texto");
                    if (cuentaIdInput) {
                        cuentaIdInput.value = String(cuentaSeleccion.idPlanCuenta || "");
                    }
                    if (cuentaTextoInput) {
                        cuentaTextoInput.value = `${String(cuentaSeleccion.codigoCuenta || "")} - ${String(cuentaSeleccion.nombreCuenta || "")}`;
                    }
                    actualizarEstadoCentroCosto(cuentaRowActiva, Boolean(cuentaSeleccion.requiereCentroCosto));
                }
                cuentaModal?.hide();
            });

            document.getElementById("aceptarCentroCosto")?.addEventListener("click", () => {
                if (centroCostoSeleccion && centroCostoRowActiva) {
                    const codigoInput = centroCostoRowActiva.querySelector(".js-centro-costo-codigo");
                    const textoInput = centroCostoRowActiva.querySelector(".js-centro-costo-texto");
                    if (codigoInput) {
                        codigoInput.value = String(centroCostoSeleccion.codigoCentroCosto || "");
                    }
                    if (textoInput) {
                        textoInput.value = `${String(centroCostoSeleccion.codigoCentroCosto || "")} - ${String(centroCostoSeleccion.nombreCentroCosto || "")}`;
                    }
                }
                centroCostoModal?.hide();
            });

            document.getElementById("aceptarPersona")?.addEventListener("click", () => {
                if (personaSeleccion && personaRowActiva) {
                    const documentoInput = personaRowActiva.querySelector(".js-numero-documento");
                    if (documentoInput) {
                        documentoInput.value = String(personaSeleccion.numeroDocumento || "");
                    }
                }
                personaModal?.hide();
            });

            document.getElementById("aceptarComprobantePersona")?.addEventListener("click", () => {
                if (comprobantePersonaSeleccion && comprobantePersonaRowActiva) {
                    const documentoInput = comprobantePersonaRowActiva.querySelector(".js-numero-documento");
                    const glosaDetalleInput = comprobantePersonaRowActiva.querySelector("input[name$='.GlosaDetalle']");
                    const tipoDocumentoInput = comprobantePersonaRowActiva.querySelector("select[name$='.TipoDocumento']");
                    const serieInput = comprobantePersonaRowActiva.querySelector("input[name$='.Serie']");
                    const referenciaInput = comprobantePersonaRowActiva.querySelector("input[name$='.ReferenciaLinea']");

                    if (documentoInput) {
                        documentoInput.value = String(comprobantePersonaSeleccion.numeroDocumentoPersona || "");
                    }
                    if (glosaDetalleInput) {
                        glosaDetalleInput.value = construirGlosaDetalleDesdeComprobante(comprobantePersonaSeleccion);
                    }
                    if (tipoDocumentoInput) {
                        tipoDocumentoInput.value = String(comprobantePersonaSeleccion.tipoComprobante || "");
                    }
                    if (serieInput) {
                        serieInput.value = String(comprobantePersonaSeleccion.serie || "");
                    }
                    if (referenciaInput) {
                        referenciaInput.value = String(comprobantePersonaSeleccion.numero || "");
                    }
                }

                comprobantePersonaModal?.hide();
            });

            origenFiltro?.addEventListener("input", aplicarFiltroOrigen);
            cuentaFiltro?.addEventListener("input", programarBusquedaCuenta);
            cuentaNivelFiltro?.addEventListener("change", programarBusquedaCuenta);
            centroCostoFiltro?.addEventListener("input", programarBusquedaCentroCosto);
            personaFiltro?.addEventListener("input", programarBusquedaPersona);
            comprobantePersonaFiltro?.addEventListener("input", programarBusquedaComprobantePersona);
            tableBody.querySelectorAll("tr").forEach(bindRowActions);
            tableBody.addEventListener("input", refreshRows);
            tableBody.addEventListener("change", refreshRows);
            refreshRows();
        })();
    </script>
}
