@model SistemaAdministrativoWeb.ViewModels.Contabilidad.AsientoIndexViewModel

@* Firma: FRANCO LARA - 06/07/2026 | Agrega al listado de asientos la columna visible de moneda equivalente usando TotalImporteS y TotalImporteD segun la moneda del asiento. *@
@* Firma: FRANCO LARA - 09/07/2026 | Reemplaza la columna Soles / Dolares por Tipo de cambio y uniformiza la columna de acciones del listado de asientos. *@
@* Firma: FRANCO LARA - 21/07/2026 | Ajusta la impresion del voucher contable para abrirse en la misma pestana del listado de asientos. *@

@* Firma: FRANCO LARA - 02/07/2026 | Corrige la seleccion visible de año y mes en asientos para que el periodo mostrado respete el contexto devuelto por la opcion, incorpora los 16 periodos contables del libro diario y bloquea la eliminacion directa de asientos automaticos manteniendo el acceso por clic en la fila. *@

@{
    ViewData["Title"] = "Asientos contables";
    ViewData["AdminShell"] = true;
    var paginaInicio = Math.Max(1, Model.Paginacion.PaginaActual - 2);
    var paginaFin = Math.Min(Model.Paginacion.TotalPaginas, Model.Paginacion.PaginaActual + 2);
}

<section class="dashboard-shell">
    <section class="dashboard-metrics">
        <article class="dashboard-metric-card dashboard-metric-card-count">
            <span>Total asientos</span>
            <strong>@Model.TotalAsientos</strong>
            <small>Asientos visibles para la consulta actual.</small>
        </article>
        <article class="dashboard-metric-card dashboard-metric-card-amount">
            <span>Total Debe</span>
            <div class="dashboard-metric-amounts">
                <div class="dashboard-metric-amount-line">
                    <label>Total soles</label>
                    <strong>@Model.TotalDebeSolesPeriodo.ToString("0.00")</strong>
                </div>
                <div class="dashboard-metric-amount-line">
                    <label>Total dolares</label>
                    <strong>@Model.TotalDebeDolaresPeriodo.ToString("0.00")</strong>
                </div>
            </div>
            <small>Debe visible separado por moneda.</small>
        </article>
        <article class="dashboard-metric-card dashboard-metric-card-amount">
            <span>Total Haber</span>
            <div class="dashboard-metric-amounts">
                <div class="dashboard-metric-amount-line">
                    <label>Total soles</label>
                    <strong>@Model.TotalHaberSolesPeriodo.ToString("0.00")</strong>
                </div>
                <div class="dashboard-metric-amount-line">
                    <label>Total dolares</label>
                    <strong>@Model.TotalHaberDolaresPeriodo.ToString("0.00")</strong>
                </div>
            </div>
            <small>Haber visible separado por moneda.</small>
        </article>
    </section>

    <section class="workspace-window">
        <div class="workspace-window-head">
            <div>
                <span class="workspace-window-kicker">Libro diario</span>
                <h1>Asientos del periodo</h1>
                <p>Consulta y filtra los asientos manuales y automaticos del periodo.</p>
            </div>
            <div class="workspace-row-actions">
                <a asp-action="Registrar" asp-route-periodo="@Model.PeriodoConsulta" class="btn btn-light btn-sm">Registrar asiento</a>
            </div>
        </div>
        <div class="workspace-window-body">
            @if (TempData["AsientoOk"] is string ok)
            {
                <div class="alert alert-success">@ok</div>
            }
            @if (TempData["AsientoError"] is string error)
            {
                <div class="alert alert-danger">@error</div>
            }

            <form asp-action="Index" method="get" class="workspace-filter-card">
                <div class="workspace-filter-grid">
                    <div class="workspace-field">
                        <label class="form-label" for="anio">Año</label>
                        <select id="anio" name="anio" class="form-select">
                            @foreach (var anio in Model.AniosDisponibles)
                            {
                                <option value="@anio" selected="@(anio == Model.AnioSeleccionado ? "selected" : null)">@anio</option>
                            }
                        </select>
                    </div>
                    <div class="workspace-field">
                        <label class="form-label" for="mes">Mes</label>
                        <select id="mes" name="mes" class="form-select">
                            @foreach (var mes in Model.MesesDisponibles)
                            {
                                <option value="@mes.Valor" selected="@(mes.Valor == Model.MesSeleccionado ? "selected" : null)">@mes.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="workspace-field workspace-field-span-2">
                        <label class="form-label" for="textoBusqueda">Buscar asiento</label>
                        <input id="textoBusqueda" name="textoBusqueda" value="@Model.TextoBusqueda" class="form-control" placeholder="Numero, glosa, origen o referencia" />
                    </div>
                </div>
                <div class="workspace-actions">
                    <button type="submit" class="btn btn-primary">Consultar</button>
                </div>
            </form>

            <div class="table-responsive workspace-table-wrap">
                <table class="table align-middle app-table workspace-table">
                    <thead>
                        <tr>
                            <th>Nro</th>
                            <th>Fecha</th>
                            <th>Origen</th>
                            <th>Glosa</th>
                            <th>Moneda</th>
                            <th>Tipo cambio</th>
                            <th>Debe</th>
                            <th>Haber</th>
                            <th>Estado</th>
                            <th class="text-end">Accion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Asientos.Count == 0)
                        {
                            <tr>
                                <td colspan="10">
                                    <div class="app-empty-state app-empty-state-inline">
                                        <i class="bi bi-journal-check"></i>
                                        <div>
                                            <strong>No hay asientos para la consulta actual</strong>
                                            <p>Ajusta el periodo o registra el primer asiento de la empresa activa.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var asiento in Model.Asientos)
                            {
                                var filaCss = "workspace-clickable-row";
                                var editarUrl = Url.Action("Editar", new { periodo = Model.PeriodoConsulta, idAsiento = asiento.IdAsiento });
                                <tr class="@filaCss" data-edit-url="@editarUrl">
                                    <td>@asiento.Periodo-@asiento.NumeroAsiento</td>
                                    <td>@asiento.FechaEmision.ToString("dd/MM/yyyy")</td>
                                    <td>@asiento.NombreOrigen</td>
                                    <td>@asiento.Glosa</td>
                                    <td>@asiento.CodigoMoneda</td>
                                    <td>@asiento.TipoCambio.ToString("0.000")</td>
                                    <td>@asiento.TotalDebe.ToString("0.00")</td>
                                    <td>@asiento.TotalHaber.ToString("0.00")</td>
                                    <td>
                                        <span class="workspace-status-badge is-active">@asiento.Estado</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="workspace-row-actions-compact asiento-row-actions">
                                            <a asp-action="Editar" asp-route-periodo="@Model.PeriodoConsulta" asp-route-idAsiento="@asiento.IdAsiento" class="workspace-row-btn workspace-row-btn-primary">Editar</a>
                                            <a asp-controller="Reporte" asp-action="VoucherContable" asp-route-idAsiento="@asiento.IdAsiento" class="workspace-row-btn workspace-row-btn-secondary">Imprimir</a>
                                            @if (asiento.PermiteRegistroManual)
                                            {
                                                <form asp-action="Eliminar" method="post" onsubmit="return confirm('Se eliminara el asiento seleccionado. ¿Desea continuar?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="idAsiento" value="@asiento.IdAsiento" />
                                                    <input type="hidden" name="anio" value="@Model.AnioSeleccionado" />
                                                    <input type="hidden" name="mes" value="@Model.MesSeleccionado" />
                                                    <input type="hidden" name="textoBusqueda" value="@Model.TextoBusqueda" />
                                                    <input type="hidden" name="pagina" value="@Model.Paginacion.PaginaActual" />
                                                    <button type="submit" class="workspace-row-btn workspace-row-btn-danger">Eliminar</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="workspace-row-btn workspace-row-btn-secondary workspace-row-btn-static">Automatico</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Paginacion.TotalPaginas > 1)
            {
                <nav class="workspace-pagination" aria-label="Paginacion asientos">
                    <a class="btn btn-outline-secondary @(Model.Paginacion.TienePaginaAnterior ? string.Empty : "disabled")"
                       asp-action="Index"
                       asp-route-anio="@Model.AnioSeleccionado"
                       asp-route-mes="@Model.MesSeleccionado"
                       asp-route-textoBusqueda="@Model.TextoBusqueda"
                       asp-route-pagina="@(Model.Paginacion.PaginaActual - 1)">Anterior</a>

                    @for (var pagina = paginaInicio; pagina <= paginaFin; pagina++)
                    {
                        <a class="btn @(pagina == Model.Paginacion.PaginaActual ? "btn-primary" : "btn-outline-secondary")"
                           asp-action="Index"
                           asp-route-anio="@Model.AnioSeleccionado"
                           asp-route-mes="@Model.MesSeleccionado"
                           asp-route-textoBusqueda="@Model.TextoBusqueda"
                           asp-route-pagina="@pagina">@pagina</a>
                    }

                    <a class="btn btn-outline-secondary @(Model.Paginacion.TienePaginaSiguiente ? string.Empty : "disabled")"
                       asp-action="Index"
                       asp-route-anio="@Model.AnioSeleccionado"
                       asp-route-mes="@Model.MesSeleccionado"
                       asp-route-textoBusqueda="@Model.TextoBusqueda"
                       asp-route-pagina="@(Model.Paginacion.PaginaActual + 1)">Siguiente</a>
                </nav>
            }
        </div>
    </section>
</section>
