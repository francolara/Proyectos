@model SistemaAdministrativoWeb.ViewModels.Contabilidad.LibroMayorViewModel

@* Firma: FRANCO LARA - 07/07/2026 | Mantiene el reporte HTML Libro Mayor, adapta su visualizacion al formato compacto tipo hoja A4 de los reportes legacy y agrega impresion directa en pantalla. *@
@* Firma: FRANCO LARA - 08/07/2026 | Ajusta Libro Mayor a filtro por anio/mes y periodo contable, quita moneda editable, separa tarjetas USD y deja el saldo final solo al cierre de cada cuenta. *@

@{
    ViewData["Title"] = "Libro Mayor";
    ViewData["AdminShell"] = true;
    var textInfo = System.Globalization.CultureInfo.CurrentCulture.TextInfo;
    var cuentaTexto = string.IsNullOrWhiteSpace(Model.CuentaDesde) && string.IsNullOrWhiteSpace(Model.CuentaHasta)
        ? "Todas las cuentas"
        : $"{Model.CuentaDesde} - {Model.CuentaHasta}";
    var grupos = Model.Resultados
        .GroupBy(x => new { x.CodigoCuenta, x.NombreCuenta })
        .ToList();
}

<section class="dashboard-shell">
    <section class="workspace-window">
        <div class="workspace-window-head">
            <div>
                <span class="workspace-window-kicker">Reporte</span>
                <h1>Libro Mayor</h1>
                <p>Replica el formato legacy <strong>rptMayorAuxiliarA4</strong> en HTML, segmentando por cuenta contable y mostrando el saldo del mes anterior junto al detalle en soles y dolares.</p>
            </div>
            <div class="workspace-window-badge">
                <strong>@Model.EmpresaNombre</strong>
                <span>@Model.PeriodoConsulta</span>
            </div>
        </div>

        <div class="workspace-window-body">
            @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
            {
                <div class="alert alert-danger">@Model.MensajeError</div>
            }

            <form asp-action="LibroMayor" method="get" class="workspace-filter-card">
                <input type="hidden" name="consultar" value="true" />
                <div class="workspace-filter-grid">
                    <div class="workspace-field">
                        <label class="form-label" for="anio">Anio</label>
                        <select id="anio" name="anio" class="form-select">
                            @foreach (var anio in Model.AniosDisponibles)
                            {
                                <option value="@anio" selected="@(anio == Model.AnioSeleccionado ? "selected" : null)">@anio</option>
                            }
                        </select>
                    </div>
                    <div class="workspace-field">
                        <label class="form-label" for="mes">Mes</label>
                        <select id="mes" name="mes" class="form-select">
                            @foreach (var mes in Model.MesesDisponibles)
                            {
                                <option value="@mes.Valor" selected="@(mes.Valor == Model.MesSeleccionado ? "selected" : null)">@textInfo.ToTitleCase(mes.Nombre)</option>
                            }
                        </select>
                    </div>
                    <div class="workspace-field">
                        <label class="form-label">Moneda base</label>
                        <input class="form-control" value="Soles" readonly />
                    </div>
                    <div class="workspace-field">
                        <label class="form-label" for="cuentaDesde">Cuenta desde</label>
                        <input id="cuentaDesde" name="cuentaDesde" class="form-control" value="@Model.CuentaDesde" list="libro-mayor-cuentas" />
                    </div>
                    <div class="workspace-field">
                        <label class="form-label" for="cuentaHasta">Cuenta hasta</label>
                        <input id="cuentaHasta" name="cuentaHasta" class="form-control" value="@Model.CuentaHasta" list="libro-mayor-cuentas" />
                    </div>
                    <div class="workspace-field">
                        <label class="form-label" for="numeroDocumento">Nro documento</label>
                        <input id="numeroDocumento" name="numeroDocumento" class="form-control" value="@Model.NumeroDocumento" maxlength="20" />
                    </div>
                    <div class="workspace-field d-flex align-items-end">
                        <button type="submit" class="btn btn-primary">Consultar mayor</button>
                    </div>
                </div>

                <datalist id="libro-mayor-cuentas">
                    @foreach (var cuenta in Model.CuentasDisponibles)
                    {
                        <option value="@cuenta.Valor">@cuenta.Texto</option>
                    }
                </datalist>
            </form>

            @if (Model.ConsultaEjecutada && Model.Resultados.Count == 0 && string.IsNullOrWhiteSpace(Model.MensajeError))
            {
                <div class="alert alert-info mt-4">No se encontraron movimientos para los filtros seleccionados.</div>
            }

            @if (Model.Resultados.Count > 0)
            {
                <section class="workspace-report-sheet report-ledger-sheet mt-4">
                    <div class="report-action-bar no-print">
                        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Imprimir</button>
                    </div>

                    <header class="report-ledger-header">
                        <div>
                            <strong>@Model.EmpresaNombre</strong>
                            <span>LIBRO MAYOR</span>
                        </div>
                        <div class="report-ledger-meta">
                            <span>Periodo: @Model.PeriodoConsulta</span>
                            <span>Moneda base: Soles</span>
                            <span>Cuentas: @cuentaTexto</span>
                            <span>Nro documento: @(string.IsNullOrWhiteSpace(Model.NumeroDocumento) ? "Todos" : Model.NumeroDocumento)</span>
                            <span>Filas: @Model.Resultados.Count</span>
                        </div>
                    </header>

                    <div class="workspace-balance-summary mb-3">
                        <div class="workspace-balance-card">
                            <span>Total Debe</span>
                            <strong>@Model.TotalDebe.ToString("N2")</strong>
                            <small>Soles</small>
                        </div>
                        <div class="workspace-balance-card">
                            <span>Total Haber</span>
                            <strong>@Model.TotalHaber.ToString("N2")</strong>
                            <small>Soles</small>
                        </div>
                        <div class="workspace-balance-card">
                            <span>Total Debe USD</span>
                            <strong>@Model.TotalDebeDolares.ToString("N2")</strong>
                            <small>Dolares</small>
                        </div>
                        <div class="workspace-balance-card">
                            <span>Total Haber USD</span>
                            <strong>@Model.TotalHaberDolares.ToString("N2")</strong>
                            <small>Dolares</small>
                        </div>
                    </div>

                    @foreach (var grupo in grupos)
                    {
                        var filas = grupo.ToList();
                        var saldoAnterior = filas.FirstOrDefault(x => x.EsSaldoInicial);
                        var movimientos = filas.Where(x => !x.EsSaldoInicial).ToList();
                        var totalDebeCuenta = movimientos.Sum(x => x.Debe);
                        var totalHaberCuenta = movimientos.Sum(x => x.Haber);
                        var totalDebeCuentaUsd = movimientos.Sum(x => x.DebeDolares);
                        var totalHaberCuentaUsd = movimientos.Sum(x => x.HaberDolares);
                        var saldoAnteriorSoles = saldoAnterior?.SaldoInicial ?? 0m;
                        var saldoAnteriorUsd = saldoAnterior?.SaldoInicialDolares ?? 0m;
                        var saldoFinal = saldoAnteriorSoles + totalDebeCuenta - totalHaberCuenta;
                        var saldoFinalUsd = saldoAnteriorUsd + totalDebeCuentaUsd - totalHaberCuentaUsd;

                        <section class="report-ledger-account-block">
                            <header class="report-ledger-account-header">
                                <div>
                                    <strong>@grupo.Key.CodigoCuenta</strong>
                                    <span>@grupo.Key.NombreCuenta</span>
                                </div>
                                <div class="report-ledger-account-meta">
                                    <span>Saldo anterior S/: @saldoAnteriorSoles.ToString("N2")</span>
                                    <span>Saldo anterior USD: @saldoAnteriorUsd.ToString("N2")</span>
                                </div>
                            </header>

                            <div class="table-responsive report-ledger-table-wrap">
                                <table class="table app-table report-ledger-table">
                                    <thead>
                                        <tr>
                                            <th>Fecha</th>
                                            <th>Origen / Asiento</th>
                                            <th>Documento</th>
                                            <th>Auxiliar</th>
                                            <th>Glosa</th>
                                            <th>TC</th>
                                            <th>Debe</th>
                                            <th>Haber</th>
                                            <th>Debe USD</th>
                                            <th>Haber USD</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr class="report-ledger-highlight-row">
                                            <td>-</td>
                                            <td colspan="5"><strong>Saldo del mes anterior</strong></td>
                                            <td class="workspace-money-cell">0.00</td>
                                            <td class="workspace-money-cell">0.00</td>
                                            <td class="workspace-money-cell">0.00</td>
                                            <td class="workspace-money-cell">0.00</td>
                                        </tr>
                                        @foreach (var item in movimientos)
                                        {
                                            <tr>
                                                <td>@item.FechaEmision?.ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    <strong>@(string.IsNullOrWhiteSpace(item.CodigoOrigen) ? "-" : item.CodigoOrigen)</strong>
                                                    <div>@($"{item.NombreOrigen} / {item.NumeroAsiento:00000000}-{item.Item}")</div>
                                                </td>
                                                <td>
                                                    <strong>@(string.IsNullOrWhiteSpace(item.NumeroDocumento) ? "-" : item.NumeroDocumento)</strong>
                                                    <div>
                                                        @(string.IsNullOrWhiteSpace(item.TipoDocumento) ? "-" : item.TipoDocumento)
                                                        /
                                                        @(string.IsNullOrWhiteSpace(item.Serie) ? "-" : item.Serie)
                                                        /
                                                        @(string.IsNullOrWhiteSpace(item.Referencia) ? "-" : item.Referencia)
                                                    </div>
                                                </td>
                                                <td>@(string.IsNullOrWhiteSpace(item.NombreAuxiliar) ? "-" : item.NombreAuxiliar)</td>
                                                <td class="report-ledger-description">@item.Glosa</td>
                                                <td class="workspace-money-cell">@item.TipoCambio.ToString("N3")</td>
                                                <td class="workspace-money-cell">@item.Debe.ToString("N2")</td>
                                                <td class="workspace-money-cell">@item.Haber.ToString("N2")</td>
                                                <td class="workspace-money-cell">@item.DebeDolares.ToString("N2")</td>
                                                <td class="workspace-money-cell">@item.HaberDolares.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="report-ledger-total-row">
                                            <td colspan="6">Subtotal @grupo.Key.CodigoCuenta</td>
                                            <td class="workspace-money-cell">@totalDebeCuenta.ToString("N2")</td>
                                            <td class="workspace-money-cell">@totalHaberCuenta.ToString("N2")</td>
                                            <td class="workspace-money-cell">@totalDebeCuentaUsd.ToString("N2")</td>
                                            <td class="workspace-money-cell">@totalHaberCuentaUsd.ToString("N2")</td>
                                        </tr>
                                        <tr class="report-ledger-total-row">
                                            <td colspan="8">Saldo final @grupo.Key.CodigoCuenta</td>
                                            <td class="workspace-money-cell">@saldoFinal.ToString("N2")</td>
                                            <td class="workspace-money-cell">@saldoFinalUsd.ToString("N2")</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </section>
                    }
                </section>
            }
        </div>
    </section>
</section>
