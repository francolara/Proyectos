@model SistemaAdministrativoWeb.ViewModels.Contabilidad.RegistroVentasViewModel
@* Firma: FRANCO LARA - 18/11/2026 | Aplica el diseño común de reportes y abre la impresión y exportación CSV en una pestaña independiente. *@

@* Firma: FRANCO LARA - 07/11/2026 | Unifica el estilo HTML e impreso del reporte con linea verde, tarjeta con filtros aplicados y rotulos de tabla en negro. Mejora el contraste de Imprimir en modo oscuro. *@

@* Firma: FRANCO LARA - 07/07/2026 | Crea el reporte HTML Registro de ventas con formato A4 inspirado en rptRegVentasA4 del legacy, usando solo la provision actual y habilitando impresion directa. *@
@* Firma: FRANCO LARA - 08/07/2026 | Ajusta el formato visible del registro de ventas retirando la columna Cod. segun el disenio solicitado y actualiza el subtitulo del reporte. *@
@* Firma: FRANCO LARA - 21/07/2026 | Corrige la impresion del Registro de ventas en A4 horizontal, compacta cabecera y tabla y evita heredar el modo oscuro. *@
@* Firma: FRANCO LARA - 04/08/2026 | Separa los parametros principales y el filtro opcional del Registro de ventas con el patron visual compartido de reportes. *@
@* Firma: FRANCO LARA - 26/08/2026 | Agrega ayuda de clientes para filtrar Codigo persona por DNI/RUC y filtro independiente por numero de comprobante. *@

@{
    ViewData["Title"] = "Registro de ventas";
    ViewData["AdminShell"] = true;
    var textInfo = System.Globalization.CultureInfo.CurrentCulture.TextInfo;
    var mesTexto = Model.MesesDisponibles.FirstOrDefault(x => x.Valor == Model.MesSeleccionado)?.Nombre ?? Model.MesSeleccionado.ToString("00");
    var tieneFiltrosAvanzados = !string.IsNullOrWhiteSpace(Model.CodigoPersona)
        || !string.IsNullOrWhiteSpace(Model.NumeroComprobante);
    ViewData["EstilosReporte"] = true;
    if (string.Equals(Context.Request.Query["vistaImpresion"].ToString(), "true", StringComparison.OrdinalIgnoreCase))
    {
        Layout = "_ReporteImpresionLayout";
        ViewData["MostrarAccionesReporte"] = Model.Resultados.Count > 0;
        if (Model.Resultados.Count > 0)
        {
            await RenderDocumentoAsync();
        }
        else
        {
            <section class="balance-document">
                <h1>@ViewData["Title"]</h1>
                <p>@(Model.MensajeError ?? "No se encontraron datos para los filtros seleccionados.")</p>
            </section>
        }
        return;
    }
}

<section class="dashboard-shell">
    <section class="workspace-window">
        <div class="workspace-window-head">
            <div>
                <span class="workspace-window-kicker">Reporte</span>
                <h1>Registro de ventas</h1>
                <p>Consulta el registro mensual de ventas con la provision actual del sistema y salida lista para impresion.</p>
            </div>
            <div class="workspace-window-badge">
                <strong>@Model.EmpresaNombre</strong>
                <span>@textInfo.ToTitleCase(mesTexto) @Model.AnioSeleccionado</span>
            </div>
        </div>

        <div class="workspace-window-body">
            @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
            {
                <div class="alert alert-danger">@Model.MensajeError</div>
            }

            <section class="workspace-section report-filter-section no-print" aria-labelledby="registro-ventas-filter-title">
                <partial name="_AdminSectionHeader" model="@(new AdminSectionHeaderViewModel
                    {
                        Id = "registro-ventas-filter-title",
                        Category = "Filtros",
                        Title = "Parámetros del reporte",
                        Description = "Seleccione el periodo y, si lo necesita, limite el registro por DNI/RUC del cliente o numero de comprobante.",
                        IconClass = "bi bi-funnel"
                    })" />

                <form asp-action="RegistroVentas" method="get" class="report-filter-form">
                    <input type="hidden" name="consultar" value="true" />
                    <div class="report-filter-primary-grid report-filter-grid-2">
                        <div class="workspace-field">
                            <label class="form-label" for="anio">Anio</label>
                            <select id="anio" name="anio" class="form-select">
                                @foreach (var anio in Model.AniosDisponibles)
                                {
                                    <option value="@anio" selected="@(anio == Model.AnioSeleccionado ? "selected" : null)">@anio</option>
                                }
                            </select>
                        </div>
                        <div class="workspace-field">
                            <label class="form-label" for="mes">Periodo</label>
                            <select id="mes" name="mes" class="form-select">
                                @foreach (var mes in Model.MesesDisponibles)
                                {
                                    <option value="@mes.Valor" selected="@(mes.Valor == Model.MesSeleccionado ? "selected" : null)">@textInfo.ToTitleCase(mes.Nombre)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="report-filter-toggle-wrap">
                        <input type="checkbox" class="report-filter-toggle-input" id="registroVentasAdvancedToggle"
                               data-report-filter-toggle data-target="registroVentasAdvancedFilters"
                               checked="@(tieneFiltrosAvanzados ? "checked" : null)"
                               aria-controls="registroVentasAdvancedFilters"
                               aria-expanded="@(tieneFiltrosAvanzados ? "true" : "false")" />
                        <label class="report-filter-toggle" for="registroVentasAdvancedToggle">
                            <span class="report-filter-toggle-copy">
                                <strong>Filtros avanzados</strong>
                                <small>Codigo persona corresponde al DNI/RUC; Nro documento corresponde al numero del comprobante.</small>
                            </span>
                            <span class="report-filter-switch" aria-hidden="true"><span></span></span>
                        </label>
                    </div>

                    <div id="registroVentasAdvancedFilters" class="report-filter-advanced-grid report-filter-grid-2 @(tieneFiltrosAvanzados ? string.Empty : "d-none")">
                        <div class="workspace-field">
                            <label class="form-label" for="codigoPersona">Codigo persona</label>
                            <div class="input-group">
                                <input id="codigoPersona" name="codigoPersona" class="form-control" value="@Model.CodigoPersona" maxlength="20" placeholder="RUC o DNI" />
                                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#registroVentasPersonaAyuda" title="Buscar cliente" aria-label="Buscar cliente">
                                    <i class="bi bi-person-search" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                        <div class="workspace-field">
                            <label class="form-label" for="numeroDocumento">Nro documento</label>
                            <input id="numeroDocumento" name="numeroDocumento" class="form-control" value="@Model.NumeroComprobante" maxlength="20" placeholder="Numero de comprobante" />
                        </div>
                    </div>

                    <div class="report-filter-actions">
                        <a class="btn btn-outline-secondary report-filter-action" asp-action="RegistroVentas">
                            <i class="bi bi-eraser" aria-hidden="true"></i>
                            <span>Limpiar filtros</span>
                        </a>
                        <button type="submit" class="btn btn-primary report-filter-action">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <span>Consultar reporte</span>
                        </button>
                    </div>
                </form>
            </section>

            @if (Model.ConsultaEjecutada && Model.Resultados.Count == 0 && string.IsNullOrWhiteSpace(Model.MensajeError))
            {
                <div class="alert alert-info mt-4">No se encontraron ventas para los filtros seleccionados.</div>
            }

            @if (Model.Resultados.Count > 0)
            {
                <div class="balance-document-preview mt-4">
                    <div class="report-action-bar no-print">
                        <partial name="_ReporteAbrirImpresion" />
                    </div>
                    @{ await RenderDocumentoAsync(); }
                </div>
            }
        </div>
    </section>
</section>

<partial name="_PersonaFiltroAyuda" model="@(new SistemaAdministrativoWeb.ViewModels.Contabilidad.ReportePersonaAyudaViewModel
    {
        ModalId = "registroVentasPersonaAyuda",
        TipoRegistro = "VEN",
        Titulo = "Ayuda de clientes",
        CodigoInputId = "codigoPersona"
    })" />

@{
    async Task RenderDocumentoAsync()
    {
        <article class="balance-document accounting-document accounting-document-wide" aria-labelledby="balance-document-title">
            @await Component.InvokeAsync("ReporteEmpresa", new { empresaNombre = Model.EmpresaNombre, rucEmpresa = (string?)null })

            <div class="balance-document-filters">
                <h1 id="balance-document-title">Registro de ventas</h1>
                <div class="balance-document-context">
                    <span>Periodo: @textInfo.ToTitleCase(mesTexto) @Model.AnioSeleccionado</span>
                    <span>Codigo persona: @(string.IsNullOrWhiteSpace(Model.CodigoPersona) ? "Todos" : Model.CodigoPersona)</span>
                    <span>Nro documento: @(string.IsNullOrWhiteSpace(Model.NumeroComprobante) ? "Todos" : Model.NumeroComprobante)</span>
                    <span>Filas: @Model.Resultados.Count</span>
                </div>
            </div>

            <div class="balance-document-scroll" tabindex="0" role="region" aria-label="Detalle del reporte">
                <table class="balance-document-table">
                    <thead>
                        <tr>
                            <th>F. emision</th>
                            <th>F. cont.</th>
                            <th>T.D.</th>
                            <th>Serie</th>
                            <th>Numero</th>
                            <th>Nro doc.</th>
                            <th>Cliente</th>
                            <th>Mon.</th>
                            <th>T.C.</th>
                            <th>Base imp.</th>
                            <th>Dscto.</th>
                            <th>Exon.</th>
                            <th>Inaf.</th>
                            <th>IGV</th>
                            <th>ISC</th>
                            <th>Otros</th>
                            <th>ICBPER</th>
                            <th>Red.</th>
                            <th>Total</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Resultados)
                        {
                            <tr>
                                <td>@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                                <td>@item.FechaContabilizacion.ToString("dd/MM/yyyy")</td>
                                <td>@item.TipoComprobante</td>
                                <td>@item.Serie</td>
                                <td>@item.Numero</td>
                                <td>@item.NumeroDocumentoPersona</td>
                                <td class="balance-a4-description">@item.NombrePersona</td>
                                <td>@item.CodigoMoneda</td>
                                <td class="balance-amount">@item.TipoCambio.ToString("N3")</td>
                                <td class="balance-amount">@item.BaseImponible.ToString("N2")</td>
                                <td class="balance-amount">@item.Descuento.ToString("N2")</td>
                                <td class="balance-amount">@item.TotalExonerado.ToString("N2")</td>
                                <td class="balance-amount">@item.TotalInafecto.ToString("N2")</td>
                                <td class="balance-amount">@item.Igv.ToString("N2")</td>
                                <td class="balance-amount">@item.Isc.ToString("N2")</td>
                                <td class="balance-amount">@item.OtrosTributos.ToString("N2")</td>
                                <td class="balance-amount">@item.Icbper.ToString("N2")</td>
                                <td class="balance-amount">@item.Redondeo.ToString("N2")</td>
                                <td class="balance-amount">@item.ImporteTotal.ToString("N2")</td>
                                <td>@item.Estado</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="balance-a4-total-row">
                            <td class="accounting-report-total-label" colspan="9">Totales</td>
                            <td class="balance-amount">@Model.TotalBaseImponible.ToString("N2")</td>
                            <td class="balance-amount">@Model.TotalDescuento.ToString("N2")</td>
                            <td class="balance-amount">@Model.TotalExonerado.ToString("N2")</td>
                            <td class="balance-amount">@Model.TotalInafecto.ToString("N2")</td>
                            <td class="balance-amount">@Model.TotalIgv.ToString("N2")</td>
                            <td class="balance-amount">@Model.TotalIsc.ToString("N2")</td>
                            <td class="balance-amount">@Model.TotalOtrosTributos.ToString("N2")</td>
                            <td class="balance-amount">@Model.TotalIcbper.ToString("N2")</td>
                            <td class="balance-amount">@Model.TotalRedondeo.ToString("N2")</td>
                            <td class="balance-amount">@Model.TotalImporte.ToString("N2")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </article>
    }
}
