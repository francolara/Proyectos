@model SistemaAdministrativoWeb.ViewModels.Contabilidad.VoucherContableViewModel
@* Firma: FRANCO LARA - 18/11/2026 | Aplica el diseño común de reportes y abre la impresión y exportación CSV en una pestaña independiente. *@

@* Firma: FRANCO LARA - 07/11/2026 | Unifica el estilo HTML e impreso del reporte con linea verde, tarjeta con filtros aplicados y rotulos de tabla en negro. Mejora el contraste de Imprimir en modo oscuro. *@

@* Firma: FRANCO LARA - 11/07/2026 | Crea el voucher contable HTML A4 inspirado en rptVoucherContableA4 del legacy, reutilizando el asiento actual y habilitando impresion directa. *@
@* Firma: FRANCO LARA - 21/07/2026 | Corrige la impresion A4 del voucher, conserva la cabecera y tarjetas en formato horizontal, compacta el contenido, evita heredar el modo oscuro y permite volver al listado del mismo periodo. *@

@{
    ViewData["Title"] = "Voucher contable";
    ViewData["AdminShell"] = true;
    var numeroVoucher = $"{Model.Periodo}-{Model.NumeroAsiento}";
    ViewData["EstilosReporte"] = true;
    if (string.Equals(Context.Request.Query["vistaImpresion"].ToString(), "true", StringComparison.OrdinalIgnoreCase))
    {
        Layout = "_ReporteImpresionLayout";
        ViewData["MostrarAccionesReporte"] = true;
        await RenderDocumentoAsync();
        return;
    }
}


<section class="dashboard-shell">
    <section class="workspace-window">
        <div class="workspace-window-head no-print">
            <div>
                <span class="workspace-window-kicker">Reporte</span>
                <h1>Voucher contable</h1>
                <p>Vista HTML tipo A4 del comprobante contable basada en el formato legacy del sistema.</p>
            </div>
            <div class="workspace-window-badge">
                <strong>@Model.EmpresaNombre</strong>
                <span>@numeroVoucher</span>
            </div>
        </div>

        <div class="workspace-window-body">
            <div class="balance-document-preview">
                <div class="report-action-bar no-print">
                    <a asp-controller="Asiento"
                       asp-action="Index"
                       asp-route-anio="@Model.FechaEmision.Year"
                       asp-route-mes="@Model.FechaEmision.Month"
                       class="btn btn-outline-secondary">Volver al listado</a>
                    <partial name="_ReporteAbrirImpresion" />
                </div>
                @{ await RenderDocumentoAsync(); }
            </div>
        </div>
    </section>
</section>

@{
    async Task RenderDocumentoAsync()
    {
        <article class="balance-document accounting-document" aria-labelledby="balance-document-title">
            @await Component.InvokeAsync("ReporteEmpresa", new { empresaNombre = Model.EmpresaNombre, rucEmpresa = Model.RucEmpresa })

            <section class="balance-document-filters">
                <h1 id="balance-document-title">Comprobante de contabilidad</h1>
                <div class="balance-document-context">
                    <span>Voucher: @numeroVoucher</span>
                    <span>Origen: @Model.CodigoOrigen - @Model.NombreOrigen</span>
                    <span>Fecha emision: @Model.FechaEmision.ToString("dd/MM/yyyy")</span>
                    <span>Moneda: @Model.Moneda</span>
                    <span>Tipo de cambio: @Model.TipoCambio.ToString("N3")</span>
                    <span>Referencia externa: @(string.IsNullOrWhiteSpace(Model.ReferenciaExterna) ? "-" : Model.ReferenciaExterna)</span>
                    <span>Lineas: @Model.Detalles.Count</span>
                </div>
            </section>

            <section class="voucher-glosa" data-report-csv-context>
                <div class="accounting-document-note">
                    <span>Glosa</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.Glosa) ? "-" : Model.Glosa)</strong>
                </div>
            </section>

            <div class="balance-document-scroll" tabindex="0" role="region" aria-label="Detalle del reporte">
                <table class="balance-document-table">
                    <thead>
                        <tr>
                            <th class="voucher-col-item">Item</th>
                            <th class="voucher-col-cuenta">Cuenta</th>
                            <th class="voucher-col-detalle">Detalle</th>
                            <th class="voucher-col-documento">Documento</th>
                            <th class="voucher-col-centro">Centro costo</th>
                            <th class="voucher-col-tc">TC</th>
                            <th class="voucher-col-monto">Debe</th>
                            <th class="voucher-col-monto">Haber</th>
                            <th class="voucher-col-monto">Imp. S/</th>
                            @if (Model.MuestraColumnaDolares)
                            {
                                <th class="voucher-col-monto">Imp. US$</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Detalles)
                        {
                            <tr>
                                <td>@item.Item</td>
                                <td class="voucher-account">
                                    <strong>@item.CodigoCuenta</strong>
                                    <div>@item.NombreCuenta</div>
                                </td>
                                <td class="voucher-description">@(string.IsNullOrWhiteSpace(item.GlosaDetalle) ? "-" : item.GlosaDetalle)</td>
                                <td class="voucher-doc">
                                    <strong>@(string.IsNullOrWhiteSpace(item.NumeroDocumento) ? "-" : item.NumeroDocumento)</strong>
                                    <div>@($"{(string.IsNullOrWhiteSpace(item.TipoDocumento) ? "-" : item.TipoDocumento)} / {(string.IsNullOrWhiteSpace(item.Serie) ? "-" : item.Serie)} / {(string.IsNullOrWhiteSpace(item.Referencia) ? "-" : item.Referencia)}")</div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.CentroCosto) ? "-" : item.CentroCosto)</td>
                                <td class="balance-amount">@item.TipoCambio.ToString("N3")</td>
                                <td class="balance-amount">@item.Debe.ToString("N2")</td>
                                <td class="balance-amount">@item.Haber.ToString("N2")</td>
                                <td class="balance-amount">@item.ImporteSoles.ToString("N2")</td>
                                @if (Model.MuestraColumnaDolares)
                                {
                                    <td class="balance-amount">@item.ImporteDolares.ToString("N2")</td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="balance-a4-total-row">
                            <td class="accounting-report-total-label" colspan="6">Totales</td>
                            <td class="balance-amount">@Model.TotalDebe.ToString("N2")</td>
                            <td class="balance-amount">@Model.TotalHaber.ToString("N2")</td>
                            <td class="balance-amount">@Model.TotalSoles.ToString("N2")</td>
                            @if (Model.MuestraColumnaDolares)
                            {
                                <td class="balance-amount">@Model.TotalDolares.ToString("N2")</td>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>

            <section class="voucher-notes" data-report-csv-context>
                <article class="accounting-document-note">
                    <span>Observacion</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.Observacion) ? "-" : Model.Observacion)</strong>
                </article>
                <article class="accounting-document-note">
                    <span>Resumen</span>
                    <strong>Debe: @Model.TotalDebe.ToString("N2") | Haber: @Model.TotalHaber.ToString("N2")</strong>
                    <div class="mt-2">Moneda base del asiento: @Model.Moneda</div>
                </article>
            </section>
        </article>
    }
}
