            const addButton = document.getElementById("agregar-detalle");
            const totalDetalleLabel = document.getElementById("total-detalle");
            const cuentaModalEl = document.getElementById("compraCuentaModal");
            const cuentaModal = cuentaModalEl && window.bootstrap ? bootstrap.Modal.getOrCreateInstance(cuentaModalEl) : null;
            const cuentaResultadosBodyEl = document.getElementById("compraCuentaResultados");
            const cuentaFiltro = document.getElementById("compraCuentaFiltro");
            const cuentaNivelFiltro = document.getElementById("compraCuentaNivelFiltro");
            const buscarCuentasUrl = '@Url.Action("BuscarAyuda", "PlanCuenta")';
            const obtenerTipoCambioUrl = '@Url.Action("ObtenerValorPorFecha", "TipoCambio")';
            const tieneDetraccionEl = document.getElementById("compraTieneDetraccion");
            const detraccionIdEl = document.getElementById("compraDetraccionId");
            const detraccionTextoEl = document.getElementById("compraDetraccionTexto");
            const porcentajeDetraccionEl = document.getElementById("compraPorcentajeDetraccion");
            const importeDetraccionEl = document.getElementById("compraImporteDetraccion");
            const saldoPagoEl = document.getElementById("compraSaldoPago");
            const tienePercepcionEl = document.getElementById("compraTienePercepcion");
            const retencion4taWrapEl = document.getElementById("compraRetencion4taWrap");
            const exoneracionRenta4taEl = document.getElementById("compraExoneracionRenta4ta");
            const porcentajeRetencionEl = document.getElementById("compraPorcentajeRetencion");
            const igvInputEl = document.getElementById("compraIgv");
            const retencionInputEl = document.getElementById("compraRetencion");
            const impuestoLabelEl = document.getElementById("compraImpuestoLabel");
            const igvHelpEl = document.getElementById("compraIgvHelp");
            const retencionHelpEl = document.getElementById("compraRetencionHelp");
            const percepcionDetalleEl = document.getElementById("compraPercepcionDetalle");
            const detraccionDetalleEl = document.getElementById("compraDetraccionDetalle");
            const tipoPercepcionSelectEl = document.getElementById("compraTipoPercepcionId");
            const porcentajePercepcionEl = document.getElementById("compraPorcentajePercepcion");
            const basePercepcionEl = document.getElementById("compraBasePercepcion");
            const importePercepcionEl = document.getElementById("compraImportePercepcion");
            const btnAbrirDetraccionModalEl = document.getElementById("btnAbrirDetraccionModal");
            const detraccionModalEl = document.getElementById("compraDetraccionModal");
            const detraccionModal = detraccionModalEl && window.bootstrap ? bootstrap.Modal.getOrCreateInstance(detraccionModalEl) : null;
            const detraccionFiltroEl = document.getElementById("compraDetraccionFiltro");
            const detraccionResultadosEl = document.getElementById("compraDetraccionResultados");
            const codigoReciboHonorarios = "02";
            const porcentajeRetencionRenta4ta = Number(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PorcentajeRetencionRenta4ta)));
            let cuentaSeleccion = null;
            let cuentaRowActiva = null;
            let cuentaBusquedaProgramada = null;
            let detraccionSeleccion = null;
            const proveedorRapidoModal = proveedorRapidoModalEl && window.bootstrap
                ? new bootstrap.Modal(proveedorRapidoModalEl)
                : null;

            if (!tableBody || !template || !addButton || !totalDetalleLabel) {
                return;
            }

            const parseAmount = (value) => {
                const parsed = parseFloat((value ?? "0").replace(",", "."));
                return Number.isNaN(parsed) ? 0 : parsed;
            };

            const formatMoney = (value) => Number(value || 0).toFixed(2);
            const formatTipoCambioInput = (input) => {
                if (!input) {
                    return;
                }

                input.value = parseAmount(input.value).toFixed(3);
            };
            const normalizeAlphaNumeric = (value, maxLength) => String(value || "").toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, maxLength);
            const normalizeSerieDocumento = (value, completar = false) => {
                return normalizeAlphaNumeric(value, 10);
            };
            const obtenerCategoriaAfectacion = (codigoAfectacion) => {
                const codigo = String(codigoAfectacion || "").trim();
                if (codigo.startsWith("1")) {
                    return "gravado";
                }
                if (codigo.startsWith("2")) {
                    return "exonerado";
                }
                if (codigo.startsWith("3")) {
                    return "inafecto";
                }

                return "otros";
            };
            const esReciboHonorarios = () => String(tipoComprobanteEl?.value || "").trim().toUpperCase() === codigoReciboHonorarios;

            const setFormValue = (name, value) => {
                const input = formEl?.querySelector(`[name="${name}"]`);
                if (input) {
                    input.value = formatMoney(value);
                }

                const resumen = formEl?.querySelector(`[data-resumen-for="${name}"]`);
                if (resumen) {
                    resumen.textContent = formatMoney(value);
                }
            };

            const obtenerMonedaSeleccionada = () => monedaSelectEl?.selectedOptions?.[0] ?? null;

            const consultarTipoCambioCabecera = async (mostrarMensaje) => {
                const fecha = String(fechaEmisionEl?.value || "").trim();
                const moneda = obtenerMonedaSeleccionada();
                const codigoMoneda = String(moneda?.dataset.codigoMoneda || "").trim().toUpperCase();

                if (!fecha || !codigoMoneda) {
                    if (mostrarMensaje) {
                        window.alert("Seleccione fecha y moneda antes de actualizar el tipo de cambio.");
                    }
                    return false;
                }

                const response = await fetch(`${obtenerTipoCambioUrl}?${new URLSearchParams({ fecha, idMoneda: "USD" }).toString()}`, { cache: "no-store" });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    if (mostrarMensaje) {
                        window.alert(payload.mensaje || "No se pudo obtener el tipo de cambio.");
                    }
                    return false;
                }

                if (!payload.encontrado) {
                    if (mostrarMensaje) {
                        window.alert(payload.mensaje || "No existe un tipo de cambio registrado para la fecha y moneda seleccionadas.");
                    }
                    return false;
                }

                if (tipoCambioInputEl) {
                    tipoCambioInputEl.value = Number(payload.tipoCambio || 0).toFixed(3);
                }

                return true;
            };

            const setDetraccionValue = (input, value, decimals = 2) => {
                if (!input) {
                    return;
                }

                const numericValue = Number(value || 0);
                input.value = numericValue.toFixed(decimals);
                const resumen = formEl?.querySelector(`[data-resumen-for="${input.name}"]`);
                if (resumen) {
                    resumen.textContent = numericValue.toFixed(decimals);
                }
            };

            const setPercepcionValue = (input, value, decimals = 2) => {
                if (!input) {
                    return;
                }

                const numericValue = Number(value || 0);
                input.value = numericValue.toFixed(decimals);
                const resumen = formEl?.querySelector(`[data-resumen-for="${input.name}"]`);
                if (resumen) {
                    resumen.textContent = numericValue.toFixed(decimals);
                }
            };
            const setRetencionValue = (input, value, decimals = 2) => {
                if (!input) {
                    return;
                }

                const numericValue = Number(value || 0);
                input.value = numericValue.toFixed(decimals);
                const resumen = formEl?.querySelector(`[data-resumen-for="${input.name}"]`);
                if (resumen) {
                    resumen.textContent = numericValue.toFixed(decimals);
                }
            };
            const actualizarRetencionVisual = () => {
                const aplicaRetencion = esReciboHonorarios();
                retencion4taWrapEl?.classList.toggle("d-none", !aplicaRetencion);
                if (impuestoLabelEl) {
                    impuestoLabelEl.textContent = aplicaRetencion ? "Retencion" : "IGV";
                }
                document.getElementById("compraIgvResumen")?.classList.toggle("d-none", aplicaRetencion);
                document.getElementById("compraRetencionResumen")?.classList.toggle("d-none", !aplicaRetencion);
                igvHelpEl?.classList.toggle("d-none", aplicaRetencion);
                retencionHelpEl?.classList.toggle("d-none", !aplicaRetencion);
                if (!aplicaRetencion && exoneracionRenta4taEl) {
                    exoneracionRenta4taEl.checked = false;
                }
                if (porcentajeRetencionEl) {
                    porcentajeRetencionEl.value = aplicaRetencion ? porcentajeRetencionRenta4ta.toFixed(4) : "0.0000";
                }
            };

            const marcarSeleccionDetraccion = () => {
                const rows = Array.from(detraccionResultadosEl?.querySelectorAll("[data-detraccion-row='true']") || []);
                rows.forEach((row) => {
                    const seleccionado = detraccionSeleccion && row.dataset.id === String(detraccionSeleccion.idDetraccionSunat);
                    row.classList.toggle("is-selected", seleccionado);
                    const radio = row.querySelector("input[type='radio']");
                    if (radio) {
                        radio.checked = Boolean(seleccionado);
                    }
                });
            };

            const calcularTotalesDetraccion = () => {
                const importeTotal = parseAmount(formEl?.querySelector('[name="Formulario.ImporteTotal"]')?.value);
                const aplicaDetraccion = Boolean(tieneDetraccionEl?.checked);
                const porcentaje = aplicaDetraccion ? parseAmount(porcentajeDetraccionEl?.value) : 0;
                const importeDetraccion = aplicaDetraccion && porcentaje > 0
                    ? Math.round((importeTotal * (porcentaje / 100)) * 100) / 100
                    : 0;
                const saldoPago = Math.max(0, Math.round((importeTotal - importeDetraccion) * 100) / 100);

                setDetraccionValue(importeDetraccionEl, importeDetraccion);
                setDetraccionValue(saldoPagoEl, saldoPago);

                if (!aplicaDetraccion) {
                    setDetraccionValue(porcentajeDetraccionEl, 0, 4);
                }
            };

            const limpiarPercepcionSeleccion = () => {
                if (tipoPercepcionSelectEl) {
                    tipoPercepcionSelectEl.value = "";
                }
                setPercepcionValue(porcentajePercepcionEl, 0, 4);
                setPercepcionValue(basePercepcionEl, 0);
                setPercepcionValue(importePercepcionEl, 0);
            };

            const calcularTotalesPercepcion = () => {
                const aplicaPercepcion = Boolean(tienePercepcionEl?.checked);
                const importeTotal = parseAmount(formEl?.querySelector('[name="Formulario.ImporteTotal"]')?.value);
                const porcentaje = aplicaPercepcion ? parseAmount(porcentajePercepcionEl?.value) : 0;
                const basePercepcion = aplicaPercepcion ? importeTotal : 0;
                const importePercepcion = aplicaPercepcion && porcentaje > 0
                    ? Math.round((basePercepcion * (porcentaje / 100)) * 100) / 100
                    : 0;

                setPercepcionValue(basePercepcionEl, basePercepcion);
                setPercepcionValue(importePercepcionEl, importePercepcion);

                if (!aplicaPercepcion) {
                    setPercepcionValue(porcentajePercepcionEl, 0, 4);
                }
            };

            const actualizarPercepcionSeleccion = () => {
                const selected = tipoPercepcionSelectEl?.selectedOptions?.[0];
                const porcentaje = Number(selected?.dataset.porcentaje || "0");
                setPercepcionValue(porcentajePercepcionEl, porcentaje, 4);
                calcularTotalesPercepcion();
            };

            const alternarPercepcion = () => {
                const aplicaPercepcion = Boolean(tienePercepcionEl?.checked);
                percepcionDetalleEl?.classList.toggle("d-none", !aplicaPercepcion);
                if (!aplicaPercepcion) {
                    limpiarPercepcionSeleccion();
                } else {
                    actualizarPercepcionSeleccion();
                }
            };

            const limpiarDetraccionSeleccion = () => {
                detraccionSeleccion = null;
                if (detraccionIdEl) {
                    detraccionIdEl.value = "";
                }
                if (detraccionTextoEl) {
                    detraccionTextoEl.value = "";
                }
                setDetraccionValue(porcentajeDetraccionEl, 0, 4);
                marcarSeleccionDetraccion();
                calcularTotalesDetraccion();
            };

            const aplicarDetraccionSeleccion = (item) => {
                if (!item) {
                    limpiarDetraccionSeleccion();
                    return;
                }

                detraccionSeleccion = item;
                if (detraccionIdEl) {
                    detraccionIdEl.value = String(item.idDetraccionSunat || "");
                }
                if (detraccionTextoEl) {
                    detraccionTextoEl.value = `${String(item.codigoSunat || "")} - ${String(item.descripcion || "")}`;
                }
                setDetraccionValue(porcentajeDetraccionEl, Number(item.porcentaje || 0), 4);
                marcarSeleccionDetraccion();
                calcularTotalesDetraccion();
            };

            const alternarDetraccion = () => {
                const aplicaDetraccion = Boolean(tieneDetraccionEl?.checked);
                detraccionDetalleEl?.classList.toggle("d-none", !aplicaDetraccion);
                if (btnAbrirDetraccionModalEl) {
                    btnAbrirDetraccionModalEl.disabled = !aplicaDetraccion;
                }

                if (!aplicaDetraccion) {
                    limpiarDetraccionSeleccion();
                } else {
                    calcularTotalesDetraccion();
                }
            };

            const filtrarDetracciones = () => {
                if (!detraccionResultadosEl) {
                    return;
                }

                const filtro = String(detraccionFiltroEl?.value || "").trim().toLowerCase();
                const rows = Array.from(detraccionResultadosEl.querySelectorAll("[data-detraccion-row='true']"));
                let visibles = 0;

                rows.forEach((row) => {
                    const texto = `${row.dataset.codigo || ""} ${row.dataset.descripcion || ""}`.toLowerCase();
                    const visible = !filtro || texto.includes(filtro);
                    row.classList.toggle("d-none", !visible);
                    if (visible) {
                        visibles += 1;
                    }
                });

                const emptyRow = detraccionResultadosEl.querySelector("[data-detraccion-empty-row='true']");
                if (emptyRow) {
                    emptyRow.classList.toggle("d-none", visibles > 0);
                }
            };

            const marcarSeleccionCuenta = () => {
                const rows = Array.from(cuentaResultadosBodyEl?.querySelectorAll("[data-cuenta-row='true']") || []);
                rows.forEach((row) => {
                    const seleccionado = cuentaSeleccion && row.dataset.id === String(cuentaSeleccion.idPlanCuenta);
                    row.classList.toggle("is-selected", seleccionado);
                    const radio = row.querySelector("input[type='radio']");
                    if (radio) {
                        radio.checked = Boolean(seleccionado);
                    }
                });
            };

            const renderCuentaResultados = (items) => {
                if (!cuentaResultadosBodyEl) {
                    return;
                }

                const emptyRow = cuentaResultadosBodyEl.querySelector("[data-cuenta-empty-row='true']");
                cuentaResultadosBodyEl.querySelectorAll("[data-cuenta-row='true']").forEach((row) => row.remove());
                emptyRow?.classList.toggle("d-none", items.length > 0);

                items.forEach((item) => {
                    const row = document.createElement("tr");
                    row.className = "workspace-lookup-row";
                    row.dataset.cuentaRow = "true";
                    row.dataset.id = String(item.idPlanCuenta || "");
                    row.dataset.codigo = String(item.codigoCuenta || "");
                    row.dataset.nombre = String(item.nombreCuenta || "");
                    row.dataset.nivel = String(item.nivelCuenta || "");
                    row.innerHTML = `
                        <td class="workspace-lookup-select-cell">
                            <input class="form-check-input" type="radio" name="cuentaCompraSeleccion" value="${String(item.idPlanCuenta || "")}" />
                        </td>
                        <td class="workspace-tree-code">${String(item.codigoCuenta || "")}</td>
                        <td>${String(item.nombreCuenta || "")}</td>
                        <td>${String(item.nivelCuenta || "")}</td>
                        <td>${item.requiereCentroCosto ? "Si" : "No"}</td>`;
                    row.addEventListener("click", () => {
                        cuentaSeleccion = item;
                        marcarSeleccionCuenta();
                    });
                    cuentaResultadosBodyEl.appendChild(row);
                });

                marcarSeleccionCuenta();
            };

            const cargarCuentasAyuda = async () => {
                const params = new URLSearchParams({ tamanoPagina: "100", soloMovimiento: "true" });
                const filtro = String(cuentaFiltro?.value || "").trim();
                const nivel = String(cuentaNivelFiltro?.value || "").trim();
                if (filtro.length >= 2) {
                    params.append("textoBusqueda", filtro);
                }
                if (nivel) {
                    params.append("nivelCuenta", nivel);
                }

                const response = await fetch(`${buscarCuentasUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    throw new Error(payload.mensaje || "No se pudo cargar el plan de cuentas.");
                }

                renderCuentaResultados(payload.items || []);
            };

            const programarBusquedaCuenta = () => {
                if (cuentaBusquedaProgramada) {
                    window.clearTimeout(cuentaBusquedaProgramada);
                }

                cuentaBusquedaProgramada = window.setTimeout(async () => {
                    try {
                        await cargarCuentasAyuda();
                    } catch (error) {
                        console.warn(error);
                        renderCuentaResultados([]);
                    }
                }, 250);
            };

            const abrirCuentaModal = async (row) => {
                cuentaRowActiva = row;
                const cuentaIdActual = row.querySelector(".js-cuenta-id")?.value || "";
                cuentaSeleccion = cuentaIdActual ? { idPlanCuenta: cuentaIdActual } : null;
                try {
                    await cargarCuentasAyuda();
                } catch (error) {
                    console.warn(error);
                    renderCuentaResultados([]);
                }
                cuentaModal?.show();
            };

            const mostrarResultadosProveedor = (visible) => {
                if (!proveedorResultadosWrapEl) {
                    return;
                }

                proveedorResultadosWrapEl.classList.toggle("d-none", !visible);
            };

            const actualizarDatosProveedor = (detalle = null) => {
                if (proveedorTipoDocumentoEl) {
                    proveedorTipoDocumentoEl.value = detalle?.tipoDocumento || "-";
                }
                if (proveedorNumeroDocumentoEl) {
                    proveedorNumeroDocumentoEl.value = detalle?.numeroDocumento || "-";
                }
                if (proveedorNombreLegalEl) {
                    proveedorNombreLegalEl.value = detalle?.nombre || "-";
                }
            };

            const seleccionarProveedor = (proveedorId, textoProveedor, detalle = null) => {
                if (!proveedorIdEl || !proveedorBuscarEl) {
                    return;
                }

                proveedorIdEl.value = proveedorId ? String(proveedorId) : "";
                proveedorBuscarEl.value = proveedorId ? String(textoProveedor || "") : "";
                const info = detalle || proveedoresDetalleMap.get(String(proveedorId)) || null;
                actualizarDatosProveedor(info);
                mostrarResultadosProveedor(false);
            };

            const limpiarProveedorRapidoError = () => {
                if (!proveedorRapidoErrorEl) {
                    return;
                }

                proveedorRapidoErrorEl.textContent = "";
                proveedorRapidoErrorEl.classList.add("d-none");
            };

            const mostrarProveedorRapidoError = (mensaje) => {
                if (!proveedorRapidoErrorEl) {
                    return;
                }

                proveedorRapidoErrorEl.textContent = mensaje || "No se pudo registrar el proveedor.";
                proveedorRapidoErrorEl.classList.remove("d-none");
            };

            const actualizarFormularioProveedorRapido = () => {
                const tipoPersona = String(proveedorRapidoTipoPersonaEl?.value || "");
                const esJuridica = tipoPersona === "J";
                const esNatural = tipoPersona === "N";

                proveedorRapidoRazonSocialWrapEl?.classList.toggle("d-none", !esJuridica);
                proveedorRapidoNombresWrapEl?.classList.toggle("d-none", !esNatural);
                proveedorRapidoApellidosWrapEl?.classList.toggle("d-none", !esNatural);

                if (proveedorRapidoRazonSocialEl) {
                    proveedorRapidoRazonSocialEl.required = esJuridica;
                }
                if (proveedorRapidoNombresEl) {
                    proveedorRapidoNombresEl.required = esNatural;
                }
                if (proveedorRapidoApellidosEl) {
                    proveedorRapidoApellidosEl.required = esNatural;
                }
            };

            const limpiarOpcionesProveedor = (mensaje = "Escribe y presiona Enter para buscar...") => {
                if (proveedorIdEl) {
                    proveedorIdEl.value = "";
                }
                if (!proveedorResultadosEl) {
                    return;
                }

                proveedorResultadosEl.innerHTML = "";
                proveedoresDetalleMap.clear();
                const option = document.createElement("option");
                option.value = "";
                option.textContent = mensaje;
                proveedorResultadosEl.appendChild(option);
                actualizarDatosProveedor(null);
                mostrarResultadosProveedor(false);
            };

            const recargarProveedores = async (buscar = "", proveedorIdPreferido = "") => {
                if (!proveedorResultadosEl) {
                    return [];
                }

                const params = new URLSearchParams();
                if (buscar) {
                    params.append("buscar", buscar);
                }
                if (proveedorIdPreferido) {
                    params.append("proveedorId", proveedorIdPreferido);
                }

                const response = await fetch(`${proveedoresUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    throw new Error(payload.mensaje || "No se pudo buscar proveedores.");
                }

                const items = (payload.items || []).map(item => ({
                    value: String(item.value ?? ""),
                    text: String(item.text ?? ""),
                    tipoDocumento: String(item.tipoDocumento ?? ""),
                    numeroDocumento: String(item.numeroDocumento ?? ""),
                    nombre: String(item.nombre ?? ""),
                    numero: String(item.numero ?? ""),
                    correo: String(item.correo ?? "")
                }));

                proveedoresDetalleMap.clear();
                proveedorResultadosEl.innerHTML = "";

                if (items.length === 0) {
                    const option = document.createElement("option");
                    option.value = "";
                    option.textContent = "Sin resultados";
                    proveedorResultadosEl.appendChild(option);
                    mostrarResultadosProveedor(true);
                    if (!proveedorIdPreferido && proveedorIdEl) {
                        proveedorIdEl.value = "";
                        actualizarDatosProveedor(null);
                    }
                    return items;
                }

                let encontradoPreferido = false;
                items.forEach(item => {
                    const option = document.createElement("option");
                    option.value = item.value;
                    option.textContent = item.text;
                    option.setAttribute("data-tipo-documento", item.tipoDocumento || "");
                    option.setAttribute("data-numero-documento", item.numeroDocumento || "");
                    option.setAttribute("data-nombre", item.nombre || "");
                    option.setAttribute("data-numero", item.numero || "");
                    option.setAttribute("data-correo", item.correo || "");
                    proveedorResultadosEl.appendChild(option);
                    proveedoresDetalleMap.set(item.value, {
                        tipoDocumento: item.tipoDocumento || "",
                        numeroDocumento: item.numeroDocumento || "",
                        nombre: item.nombre || "",
                        numero: item.numero || "",
                        correo: item.correo || ""
                    });
                    if (proveedorIdPreferido && item.value === String(proveedorIdPreferido)) {
                        encontradoPreferido = true;
                    }
                });

                if (proveedorIdPreferido && encontradoPreferido) {
                    const selected = Array.from(proveedorResultadosEl.options).find(x => x.value === String(proveedorIdPreferido));
                    if (selected) {
                        seleccionarProveedor(selected.value, selected.text || "", {
                            tipoDocumento: selected.getAttribute("data-tipo-documento") || "",
                            numeroDocumento: selected.getAttribute("data-numero-documento") || "",
                            nombre: selected.getAttribute("data-nombre") || "",
                            numero: selected.getAttribute("data-numero") || "",
                            correo: selected.getAttribute("data-correo") || ""
                        });
                    }
                } else {
                    mostrarResultadosProveedor(true);
                    if (proveedorIdEl) {
                        proveedorIdEl.value = "";
                    }
                    actualizarDatosProveedor(null);
                }

                return items;
            };

            const bindRowActions = (row) => {
                row.querySelector(".js-remove-row")?.addEventListener("click", () => {
                    if (tableBody.querySelectorAll("tr").length === 1) {
                        return;
                    }

                    row.remove();
                    refreshRows();
                });

                row.querySelector(".js-open-cuenta-modal")?.addEventListener("click", () => {
                    abrirCuentaModal(row);
                });
            };

            const refreshRows = () => {
                const rows = Array.from(tableBody.querySelectorAll("tr"));
                let subtotal = 0;
                let totalGravado = 0;
                let totalExonerado = 0;
                let totalInafecto = 0;
                const icbper = 0;

                rows.forEach((row, index) => {
                    row.querySelectorAll("input, select, textarea, span").forEach((element) => {
                        ["name", "id", "for"].forEach((attribute) => {
                            const currentValue = element.getAttribute(attribute);
                            if (!currentValue) {
                                return;
                            }

                            const updatedValue = currentValue
                                .replaceAll("__index__", index)
                                .replace(/Formulario\.Detalles\[\d+\]/g, `Formulario.Detalles[${index}]`)
                                .replace(/Formulario_Detalles_\d+__/g, `Formulario_Detalles_${index}__`);

                            if (updatedValue !== currentValue) {
                                element.setAttribute(attribute, updatedValue);
                            }
                        });
                    });

                    const itemInput = row.querySelector('input[name$=".Item"]');
                    if (itemInput) {
                        itemInput.value = (index + 1).toString();
                    }

                    const cantidad = parseAmount(row.querySelector(".js-cantidad")?.value);
                    const valorUnitario = parseAmount(row.querySelector(".js-unitario")?.value);
                    const importe = Math.round((cantidad * valorUnitario) * 100) / 100;
                    const brutoInput = row.querySelector(".js-bruto");
                    if (brutoInput) {
                        brutoInput.value = formatMoney(importe);
                    }
                    const afectacionSelect = row.querySelector(".js-afectacion");
                    const codigoAfectacion = afectacionSelect?.selectedOptions?.[0]?.dataset.codigo || "";
                    const categoria = obtenerCategoriaAfectacion(codigoAfectacion);
                    subtotal += importe;
                    if (categoria === "gravado") {
                        totalGravado += importe;
                    } else if (categoria === "exonerado") {
                        totalExonerado += importe;
                    } else if (categoria === "inafecto") {
                        totalInafecto += importe;
                    }
                });

                const aplicaRetencion = esReciboHonorarios();
                const igv = aplicaRetencion ? 0 : Math.round((totalGravado * 0.18) * 100) / 100;
                const retencion = aplicaRetencion && !Boolean(exoneracionRenta4taEl?.checked)
                    ? Math.round((subtotal * (porcentajeRetencionRenta4ta / 100)) * 100) / 100
                    : 0;
                const importeTotal = aplicaRetencion
                    ? Math.max(0, Math.round((subtotal - retencion) * 100) / 100)
                    : subtotal + igv;
                totalDetalleLabel.textContent = subtotal.toFixed(2);
                setFormValue("Formulario.BaseImponible", subtotal);
                setFormValue("Formulario.TotalExonerado", totalExonerado);
                setFormValue("Formulario.TotalInafecto", totalInafecto);
                setFormValue("Formulario.Icbper", icbper);
                setFormValue("Formulario.Igv", igv);
                setRetencionValue(retencionInputEl, retencion);
                setRetencionValue(porcentajeRetencionEl, aplicaRetencion ? porcentajeRetencionRenta4ta : 0, 4);
                setFormValue("Formulario.Isc", 0);
                setFormValue("Formulario.OtrosTributos", 0);
                setFormValue("Formulario.Redondeo", 0);
                setFormValue("Formulario.ImporteTotal", importeTotal);
                calcularTotalesDetraccion();
                calcularTotalesPercepcion();
            };

            addButton.addEventListener("click", () => {
                const index = tableBody.querySelectorAll("tr").length;
                const html = template.innerHTML.replaceAll("__index__", index);
                tableBody.insertAdjacentHTML("beforeend", html);
                const row = tableBody.lastElementChild;
                if (row) {
                    bindRowActions(row);
                }
                refreshRows();
            });

            tableBody.querySelectorAll("tr").forEach(bindRowActions);
            tableBody.addEventListener("input", refreshRows);
            tableBody.addEventListener("change", refreshRows);
            actualizarRetencionVisual();
            refreshRows();
            if (detraccionIdEl?.value) {
                const filaDetraccionInicial = detraccionResultadosEl?.querySelector(`[data-detraccion-row='true'][data-id='${detraccionIdEl.value}']`);
                if (filaDetraccionInicial) {
                    detraccionSeleccion = {
                        idDetraccionSunat: Number(filaDetraccionInicial.getAttribute("data-id") || "0"),
                        codigoSunat: String(filaDetraccionInicial.getAttribute("data-codigo") || ""),
                        descripcion: String(filaDetraccionInicial.getAttribute("data-descripcion") || ""),
                        porcentaje: Number(filaDetraccionInicial.getAttribute("data-porcentaje") || "0")
                    };
                }
            }
            alternarDetraccion();
            if (tipoPercepcionSelectEl?.value) {
                actualizarPercepcionSeleccion();
            }
            alternarPercepcion();
            fechaContabilizacionEl.value = `${@Html.Raw(System.Text.Json.JsonSerializer.Serialize(periodoContableValue))}-01`;
            fechaEmisionEl?.addEventListener("change", () => {
                consultarTipoCambioCabecera(false).catch((error) => console.warn(error));
            });
            monedaSelectEl?.addEventListener("change", () => {
                consultarTipoCambioCabecera(false).catch((error) => console.warn(error));
            });
            formatTipoCambioInput(tipoCambioInputEl);
            tipoCambioInputEl?.addEventListener("blur", () => formatTipoCambioInput(tipoCambioInputEl));
            tipoCambioInputEl?.addEventListener("change", () => formatTipoCambioInput(tipoCambioInputEl));
            tipoComprobanteEl?.addEventListener("change", () => {
                actualizarRetencionVisual();
                refreshRows();
            });
            exoneracionRenta4taEl?.addEventListener("change", refreshRows);
            actualizarTipoCambioButton?.addEventListener("click", async () => {
                try {
                    await consultarTipoCambioCabecera(true);
                } catch (error) {
                    console.warn(error);
                    window.alert("No se pudo obtener el tipo de cambio.");
                }
            });
            consultarTipoCambioCabecera(false).catch((error) => console.warn(error));
            numeroDocumentoEl?.addEventListener("keydown", (event) => {
                const teclasPermitidas = ["Backspace", "Delete", "Tab", "ArrowLeft", "ArrowRight", "Home", "End"];
                if (teclasPermitidas.includes(event.key) || event.ctrlKey || event.metaKey) {
                    return;
                }

                if (!/^[A-Za-z0-9]$/.test(event.key)) {
                    event.preventDefault();
                }
            });
            serieDocumentoEl?.addEventListener("input", () => {
                serieDocumentoEl.value = normalizeSerieDocumento(serieDocumentoEl.value, false);
            });
            serieDocumentoEl?.addEventListener("blur", () => {
                serieDocumentoEl.value = normalizeSerieDocumento(serieDocumentoEl.value, true);
            });
            numeroDocumentoEl?.addEventListener("input", () => {
                numeroDocumentoEl.value = normalizeAlphaNumeric(numeroDocumentoEl.value, 20);
            });
            numeroDocumentoEl?.addEventListener("blur", () => {
                numeroDocumentoEl.value = normalizeAlphaNumeric(numeroDocumentoEl.value, 20);
            });

            document.getElementById("aceptarCuentaCompra")?.addEventListener("click", () => {
                if (String(cuentaSeleccion?.nivelCuenta || "") !== "5") {
                    window.alert("Seleccione una cuenta contable de nivel 5.");
                    return;
                }

                if (cuentaSeleccion && cuentaRowActiva) {
                    const cuentaIdInput = cuentaRowActiva.querySelector(".js-cuenta-id");
                    const cuentaTextoInput = cuentaRowActiva.querySelector(".js-cuenta-texto");
                    if (cuentaIdInput) {
                        cuentaIdInput.value = String(cuentaSeleccion.idPlanCuenta || "");
                    }
                    if (cuentaTextoInput) {
                        cuentaTextoInput.value = `${String(cuentaSeleccion.codigoCuenta || "")} - ${String(cuentaSeleccion.nombreCuenta || "")}`;
                    }
                }
                cuentaModal?.hide();
            });

            cuentaFiltro?.addEventListener("input", programarBusquedaCuenta);
            cuentaNivelFiltro?.addEventListener("change", programarBusquedaCuenta);
            tieneDetraccionEl?.addEventListener("change", alternarDetraccion);
            tienePercepcionEl?.addEventListener("change", alternarPercepcion);
            tipoPercepcionSelectEl?.addEventListener("change", actualizarPercepcionSeleccion);
            btnAbrirDetraccionModalEl?.addEventListener("click", () => {
                if (!tieneDetraccionEl?.checked) {
                    window.alert("Primero marque que la compra tiene detraccion.");
                    return;
                }

                marcarSeleccionDetraccion();
                filtrarDetracciones();
                detraccionModal?.show();
            });
            detraccionFiltroEl?.addEventListener("input", filtrarDetracciones);
            detraccionResultadosEl?.querySelectorAll("[data-detraccion-row='true']").forEach((row) => {
                const seleccionarFila = () => {
                    detraccionSeleccion = {
                        idDetraccionSunat: Number(row.dataset.id || "0"),
                        codigoSunat: String(row.dataset.codigo || ""),
                        descripcion: String(row.dataset.descripcion || ""),
                        porcentaje: Number(row.dataset.porcentaje || "0")
                    };
                    marcarSeleccionDetraccion();
                };

                row.addEventListener("click", seleccionarFila);
                row.addEventListener("dblclick", () => {
                    seleccionarFila();
                    aplicarDetraccionSeleccion(detraccionSeleccion);
                    detraccionModal?.hide();
                });
            });
            document.getElementById("aceptarDetraccionCompra")?.addEventListener("click", () => {
                if (!detraccionSeleccion || !detraccionSeleccion.idDetraccionSunat) {
                    window.alert("Seleccione un codigo de detraccion SUNAT.");
                    return;
                }

                aplicarDetraccionSeleccion(detraccionSeleccion);
                detraccionModal?.hide();
            });

            if (proveedorBuscarEl && proveedorIdEl && proveedorResultadosEl) {
                proveedorBuscarEl.addEventListener("input", () => {
                    if (proveedorIdEl.value) {
                        proveedorIdEl.value = "";
                        actualizarDatosProveedor(null);
                    }
                });

                proveedorBuscarEl.addEventListener("keydown", async (event) => {
                    if (event.key !== "Enter") {
                        return;
                    }

                    event.preventDefault();
                    const filtro = String(proveedorBuscarEl.value || "").trim();
                    if (filtro.length < 2) {
                        limpiarOpcionesProveedor("Escribe al menos 2 caracteres y presiona Enter.");
                        mostrarResultadosProveedor(true);
                        return;
                    }

                    try {
                        const items = await recargarProveedores(filtro);
                        if (items.length === 1) {
                            seleccionarProveedor(items[0].value, items[0].text, {
                                tipoDocumento: items[0].tipoDocumento || "",
                                numeroDocumento: items[0].numeroDocumento || "",
                                nombre: items[0].nombre || "",
                                numero: items[0].numero || "",
                                correo: items[0].correo || ""
                            });
                        } else {
                            mostrarResultadosProveedor(true);
                            proveedorResultadosEl.focus();
                        }
                    } catch (error) {
                        console.warn(error);
                        limpiarOpcionesProveedor("No se pudo cargar proveedores");
                        mostrarResultadosProveedor(true);
                    }
                });

                const sincronizarProveedorDesdeSelect = () => {
                    const option = proveedorResultadosEl.selectedOptions?.[0];
                    if (!option || !option.value) {
                        return;
                    }

                    seleccionarProveedor(option.value, option.text || "", {
                        tipoDocumento: option.getAttribute("data-tipo-documento") || "",
                        numeroDocumento: option.getAttribute("data-numero-documento") || "",
                        nombre: option.getAttribute("data-nombre") || "",
                        numero: option.getAttribute("data-numero") || "",
                        correo: option.getAttribute("data-correo") || ""
                    });
                };

                proveedorResultadosEl.addEventListener("change", sincronizarProveedorDesdeSelect);
                proveedorResultadosEl.addEventListener("dblclick", sincronizarProveedorDesdeSelect);
                proveedorResultadosEl.addEventListener("keydown", (event) => {
                    if (event.key !== "Enter") {
                        return;
                    }

                    event.preventDefault();
                    sincronizarProveedorDesdeSelect();
                });
            }

            if (btnNuevoProveedorEl && proveedorRapidoModal) {
                btnNuevoProveedorEl.addEventListener("click", () => {
                    limpiarProveedorRapidoError();
                    proveedorRapidoFormEl?.reset();
                    if (proveedorRapidoTipoPersonaEl) {
                        proveedorRapidoTipoPersonaEl.value = "";
                    }
                    if (proveedorRapidoTipoDocumentoEl) {
                        proveedorRapidoTipoDocumentoEl.value = "";
                    }
                    actualizarFormularioProveedorRapido();
                    proveedorRapidoModal.show();
                });
            }

            proveedorRapidoTipoPersonaEl?.addEventListener("change", actualizarFormularioProveedorRapido);
            actualizarFormularioProveedorRapido();

            proveedorRapidoFormEl?.addEventListener("submit", async (event) => {
                event.preventDefault();
                limpiarProveedorRapidoError();

                const payload = {
                    tipoPersona: String(proveedorRapidoTipoPersonaEl?.value || ""),
                    tipoDocumento: String(proveedorRapidoTipoDocumentoEl?.value || ""),
                    numeroDocumento: String(proveedorRapidoNumeroDocumentoEl?.value || ""),
                    razonSocial: String(proveedorRapidoRazonSocialEl?.value || ""),
                    nombres: String(proveedorRapidoNombresEl?.value || ""),
                    apellidos: String(proveedorRapidoApellidosEl?.value || "")
                };

                if (proveedorRapidoGuardarEl) {
                    proveedorRapidoGuardarEl.disabled = true;
                }

                try {
                    const response = await fetch(crearProveedorRapidoUrl, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify(payload)
                    });
                    const responseText = await response.text();
                    let data = null;
                    try {
                        data = responseText ? JSON.parse(responseText) : null;
                    } catch {
                        throw new Error(responseText || "No se pudo registrar el proveedor.");
                    }

                    if (!response.ok || !data.ok) {
                        throw new Error(data.mensaje || "No se pudo registrar el proveedor.");
                    }

                    await recargarProveedores("", String(data.proveedorId || ""));
                    if (data.proveedorId) {
                        seleccionarProveedor(String(data.proveedorId), String(data.proveedorTexto || ""), {
                            tipoDocumento: String(data.tipoDocumento || ""),
                            numeroDocumento: String(data.numeroDocumento || ""),
                            nombre: String(data.nombre || ""),
                            numero: String(data.numero || ""),
                            correo: String(data.correo || "")
                        });
                    }
                    proveedorRapidoModal.hide();
                } catch (error) {
                    mostrarProveedorRapidoError(error?.message || "No se pudo registrar el proveedor.");
                } finally {
                    if (proveedorRapidoGuardarEl) {
                        proveedorRapidoGuardarEl.disabled = false;
                    }
                }
            });

        })();
    </script>
}
