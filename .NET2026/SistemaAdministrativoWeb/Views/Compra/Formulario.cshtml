</div>

<div class="modal fade workspace-modal" id="compraDetraccionModal" tabindex="-1" aria-labelledby="compraDetraccionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content workspace-modal-content">
            <div class="modal-header workspace-modal-header">
                <div>
                    <span class="workspace-window-kicker">SUNAT</span>
                    <h2 class="workspace-modal-title" id="compraDetraccionModalLabel">Seleccionar codigo de detraccion</h2>
                    <p class="workspace-modal-subtitle">Elige el codigo SPOT que corresponde al bien o servicio.</p>
                </div>
                <button type="button" class="btn-close workspace-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body workspace-modal-body">
                <div class="workspace-filter-card mt-0">
                    <div class="workspace-filter-grid">
                        <div class="workspace-field workspace-field-span-3">
                            <label class="form-label" for="compraDetraccionFiltro">Filtro</label>
                            <input id="compraDetraccionFiltro" class="form-control" placeholder="Codigo o descripcion de detraccion" autocomplete="off" />
                        </div>
                    </div>
                </div>
                <div class="table-responsive workspace-table-wrap">
                    <table class="table align-middle app-table workspace-table workspace-lookup-table">
                        <thead>
                            <tr>
                                <th class="workspace-lookup-select-cell">Sel.</th>
                                <th>Codigo</th>
                                <th>Descripcion</th>
                                <th>%</th>
                            </tr>
                        </thead>
                        <tbody id="compraDetraccionResultados">
                            @if (Model.DetraccionesSunat.Count == 0)
                            {
                                <tr data-detraccion-empty-row="true">
                                    <td colspan="4">
                                        <div class="app-empty-state app-empty-state-inline">
                                            <i class="bi bi-search"></i>
                                            <div>
                                                <strong>No hay codigos de detraccion cargados</strong>
                                                <p>Registre primero el maestro general de detracciones SUNAT.</p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var detraccion in Model.DetraccionesSunat)
                                {
                                    <tr data-detraccion-row="true"
                                        data-id="@detraccion.IdDetraccionSunat"
                                        data-codigo="@detraccion.CodigoSunat"
                                        data-descripcion="@detraccion.Descripcion"
                                        data-porcentaje="@detraccion.Porcentaje.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)">
                                        <td class="workspace-lookup-select-cell">
                                            <input type="radio" name="compraDetraccionSeleccion" value="@detraccion.IdDetraccionSunat" />
                                        </td>
                                        <td>@detraccion.CodigoSunat</td>
                                        <td>@detraccion.Descripcion</td>
                                        <td>@detraccion.Porcentaje.ToString("0.##")</td>
                                    </tr>
                                }
                                <tr data-detraccion-empty-row="true" class="d-none">
                                    <td colspan="4">
                                        <div class="app-empty-state app-empty-state-inline">
                                            <i class="bi bi-search"></i>
                                            <div>
                                                <strong>No hay codigos con ese filtro</strong>
                                                <p>Ajusta el codigo o la descripcion para ubicar la detraccion SUNAT.</p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer workspace-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="aceptarDetraccionCompra">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<style>
    .workspace-toggle-card-wrap {
        position: relative;
        margin-top: 0.35rem;
    }

    .workspace-toggle-input {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .workspace-toggle-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.95rem 1.15rem;
        border: 1px solid rgba(31, 80, 67, 0.16);
        border-radius: 1rem;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(236, 245, 241, 0.96));
        box-shadow: 0 14px 28px rgba(17, 54, 44, 0.08);
        cursor: pointer;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease, background 0.2s ease;
    }

    .workspace-toggle-card:hover {
        border-color: rgba(31, 80, 67, 0.28);
        box-shadow: 0 18px 34px rgba(17, 54, 44, 0.12);
        transform: translateY(-1px);
    }

    .workspace-toggle-input:focus-visible + .workspace-toggle-card {
        outline: 0;
        border-color: rgba(15, 105, 79, 0.52);
        box-shadow: 0 0 0 0.24rem rgba(25, 135, 84, 0.16);
    }

    .workspace-toggle-card-copy {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 0;
    }

    .workspace-toggle-card-title {
        font-weight: 700;
        color: #154b3d;
        line-height: 1.2;
    }

    .workspace-toggle-card-text {
        color: #5b6e68;
        font-size: 0.9rem;
        line-height: 1.35;
    }

    .workspace-toggle-pill {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
    }

    .workspace-toggle-pill-track {
        position: relative;
        display: inline-flex;
        align-items: center;
        inline-size: 3.4rem;
        block-size: 1.9rem;
        padding: 0.18rem;
        border-radius: 999px;
        background: linear-gradient(135deg, #d4dde0, #bcc9cd);
        box-shadow: inset 0 1px 3px rgba(16, 24, 40, 0.16);
        transition: background 0.2s ease;
    }

    .workspace-toggle-pill-thumb {
        inline-size: 1.54rem;
        block-size: 1.54rem;
        border-radius: 50%;
        background: linear-gradient(135deg, #ffffff, #eef3f5);
        box-shadow: 0 4px 12px rgba(16, 24, 40, 0.18);
        transition: transform 0.2s ease;
    }

    .workspace-toggle-input:checked + .workspace-toggle-card {
        border-color: rgba(15, 105, 79, 0.34);
        background: linear-gradient(135deg, rgba(236, 250, 245, 0.98), rgba(220, 244, 234, 0.98));
        box-shadow: 0 18px 34px rgba(15, 105, 79, 0.14);
    }

    .workspace-toggle-input:checked + .workspace-toggle-card .workspace-toggle-pill-track {
        background: linear-gradient(135deg, #1d8a67, #44c096);
    }

    .workspace-toggle-input:checked + .workspace-toggle-card .workspace-toggle-pill-thumb {
        transform: translateX(1.5rem);
    }

    html[data-theme="dark"] .workspace-toggle-card {
        border-color: rgba(93, 117, 158, 0.3);
        background: linear-gradient(135deg, rgba(21, 31, 50, 0.98), rgba(12, 21, 36, 0.96));
        box-shadow: 0 16px 30px rgba(0, 0, 0, 0.2);
    }

    html[data-theme="dark"] .workspace-toggle-card:hover {
        border-color: rgba(115, 151, 226, 0.38);
        box-shadow: 0 18px 34px rgba(0, 0, 0, 0.24);
    }

    html[data-theme="dark"] .workspace-toggle-input:focus-visible + .workspace-toggle-card {
        border-color: rgba(70, 134, 245, 0.48);
        box-shadow: 0 0 0 0.24rem rgba(53, 119, 233, 0.16);
    }

    html[data-theme="dark"] .workspace-toggle-card-title {
        color: #eef4ff;
    }

    html[data-theme="dark"] .workspace-toggle-card-text {
        color: #9cb0d1;
    }

    html[data-theme="dark"] .workspace-toggle-pill-track {
        background: linear-gradient(135deg, #445268, #2d3b4f);
        box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.32);
    }

    html[data-theme="dark"] .workspace-toggle-pill-thumb {
        background: linear-gradient(135deg, #f8fbff, #b9cae6);
    }

    html[data-theme="dark"] .workspace-toggle-input:checked + .workspace-toggle-card {
        border-color: rgba(58, 159, 123, 0.42);
        background: linear-gradient(135deg, rgba(16, 52, 42, 0.98), rgba(10, 37, 30, 0.96));
        box-shadow: 0 18px 34px rgba(8, 33, 27, 0.28);
    }

    @@media (max-width: 767.98px) {
        .workspace-toggle-card {
            align-items: flex-start;
        }
    }
</style>

