@model SistemaAdministrativoWeb.ViewModels.Contabilidad.CompraIndexViewModel

@* =============================================
   Author:        FRANCO LARA
   Create date:   18/06/2026
   Description:   Retira la previsualizacion visible del asiento en provision de compras.
   ============================================= *@

@* =============================================
   Author:        FRANCO LARA
   Create date:   21/06/2026
   Description:   Reorganiza el registro de provision de compras con Datos de la Compra debajo de Periodo Contable, importe bruto automatico y totales subtotal/exonerado/inafecto/IGV, retirando la tarjeta superior.
   ============================================= *@
@* Firma: FRANCO LARA - 24/06/2026 | Mantiene la ayuda popup de cuenta contable visible en compras y valida al aceptar que la cuenta seleccionada sea de nivel 5. *@

@* =============================================
   Author:        FRANCO LARA
   Create date:   22/06/2026
   Description:   Agrega tipo de persona en registro rapido de proveedor, cambia la ayuda de plan de cuentas a carga inicial Top 100 con filtro remoto, restringe la seleccion a cuentas de movimiento validas, ajusta serie/numero del comprobante y deja el mes contable solo informativo segun el periodo elegido en el listado.
   ============================================= *@

@* =============================================
   Author:        FRANCO LARA
   Create date:   23/06/2026
   Description:   Reubica el periodo contable en la tarjeta derecha del encabezado del registro de compras, deja la cabecera mas compacta, vuelve a mostrar el campo ICBPER en los totales y reemplaza los botones de ayuda por iconos de lupa.
   ============================================= *@
@* =============================================
   Author:        FRANCO LARA
   Create date:   26/06/2026
   Description:   Agrega detraccion SUNAT en provisiones de compra con popup de codigos, porcentaje, importe retenido y saldo neto pendiente de pago.
   ============================================= *@

@{
    ViewData["Title"] = Model.Formulario.IdCompra.HasValue ? "Editar compra" : "Registrar compra";
    ViewData["AdminShell"] = true;
    var periodoContableValue = $"{Model.Formulario.FechaContabilizacion.Year:0000}-{Model.Formulario.FechaContabilizacion.Month:00}";
    var periodoContableTexto = new DateTime(Model.Formulario.FechaContabilizacion.Year, Model.Formulario.FechaContabilizacion.Month, 1).ToString("MMMM 'de' yyyy");

}

<section class="dashboard-shell">
    <section class="workspace-window">
        <div class="workspace-window-head">
            <div>
                <span class="workspace-window-kicker">Provision</span>
                <h1>@ViewData["Title"]</h1>
                <p>Registra el comprobante de compra y su detalle referencial para la contabilizacion automatica.</p>
            </div>
            <div class="workspace-window-badge">
                <strong>@System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(periodoContableTexto)</strong>
                <span>Periodo contable</span>
                <small>COM · origen automatico</small>
            </div>
        </div>
        <div class="workspace-window-body">
            @if (Model.ConfiguracionesCompra.Count == 0)
            {
                <div class="alert alert-warning">No existe configuracion contable activa para compras. Primero configure compras/ventas.</div>
            }
            else
            {
                <form asp-action="Guardar" method="post" id="compra-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Formulario.IdCompra" />
                    <input type="hidden" asp-for="Formulario.IdConfiguracionContabilizacion" />
                    <input asp-for="Formulario.FechaContabilizacion" type="hidden" id="compraFechaContabilizacion" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @if (Model.Proveedores.Count == 0)
                    {
                        <div class="alert alert-info mb-3">Aun no existen proveedores en la empresa. Puede registrarlos desde el boton <strong>Nuevo proveedor</strong>.</div>
                    }

                    <div class="workspace-section">
                        <div class="workspace-section-head workspace-section-head-compact">
                            <div>
                                <span class="workspace-section-kicker">Cabecera</span>
                                <h2>Datos de la Compra</h2>
                                <p>Completa los datos principales del comprobante antes de registrar el detalle.</p>
                            </div>
                        </div>

                        <div class="workspace-form-grid">
                            <div class="workspace-field workspace-field-span-2">
                                <label class="form-label" for="compraProveedorBuscar">Proveedor</label>
                                <input asp-for="Formulario.IdProveedor" type="hidden" id="compraProveedorId" />
                                <div class="input-group">
                                    <input type="text"
                                           id="compraProveedorBuscar"
                                           class="form-control"
                                           value="@Model.ProveedorSeleccionadoTexto"
                                           placeholder="Escribe proveedor, documento o codigo y presiona Enter..." />
                                    <button type="button" class="btn btn-outline-primary" id="btnNuevoProveedor" title="Nuevo proveedor">+</button>
                                </div>
                                <span asp-validation-for="Formulario.IdProveedor" class="text-danger"></span>
                                <div class="workspace-lookup-results d-none" id="compraProveedorResultadosWrap">
                                    <select class="form-select" id="compraProveedorResultados" size="6">
                                        <option value="">Escribe y presiona Enter para buscar...</option>
                                    </select>
                                </div>
                            </div>
                            <div class="workspace-field">
                                <label class="form-label">Tipo documento</label>
                                <input type="text" id="compraProveedorTipoDocumento" class="form-control" value="@Model.ProveedorSeleccionadoTipoDocumento" readonly />
                            </div>
                            <div class="workspace-field">
                                <label class="form-label">Numero documento</label>
                                <input type="text" id="compraProveedorNumeroDocumento" class="form-control" value="@Model.ProveedorSeleccionadoNumeroDocumento" readonly />
                            </div>
                            <div class="workspace-field workspace-field-span-2">
                                <label class="form-label">Razon social / nombre</label>
                                <input type="text" id="compraProveedorNombreLegal" class="form-control" value="@Model.ProveedorSeleccionadoNombreLegal" readonly />
                            </div>
                            <div class="workspace-field">
                                <label asp-for="Formulario.FechaEmision" class="form-label">Fecha emision</label>
                                <input asp-for="Formulario.FechaEmision" class="form-control" />
                            </div>
                            <div class="workspace-field">
                                <label asp-for="Formulario.TipoComprobante" class="form-label">Tipo comprobante</label>
                                <select asp-for="Formulario.TipoComprobante" class="form-select">
                                    <option value="">Seleccione</option>
                                    @foreach (var tipo in Model.TiposComprobante)
                                    {
                                        <option value="@tipo.CodigoTipoComprobante">@tipo.CodigoTipoComprobante - @tipo.Descripcion</option>
                                    }
                                </select>
                            </div>
                            <div class="workspace-field">
                                <label asp-for="Formulario.Serie" class="form-label">Serie</label>
                                <input asp-for="Formulario.Serie" class="form-control js-serie-documento" maxlength="4" inputmode="text" placeholder="F001" />
                            </div>
                            <div class="workspace-field">
                                <label asp-for="Formulario.Numero" class="form-label">Numero</label>
                                <input asp-for="Formulario.Numero" class="form-control js-numero-documento" maxlength="10" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                            </div>
                            <div class="workspace-field">
                                <label asp-for="Formulario.IdMoneda" class="form-label">Moneda</label>
                                <select asp-for="Formulario.IdMoneda" class="form-select">
                                    <option value="">Seleccione</option>
                                    @foreach (var moneda in Model.Monedas)
                                    {
                                        <option value="@moneda.IdMoneda">@moneda.CodigoMoneda - @moneda.NombreMoneda</option>
                                    }
                                </select>
                            </div>
                            <div class="workspace-field">
                                <label asp-for="Formulario.TipoCambio" class="form-label">Tipo cambio</label>
                                <input asp-for="Formulario.TipoCambio" class="form-control" />
                            </div>
                            <div class="workspace-field workspace-field-span-3">
                                <label asp-for="Formulario.Observacion" class="form-label">Observacion</label>
                                <input asp-for="Formulario.Observacion" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="workspace-section">
                        <div class="workspace-section-head workspace-section-head-compact">
                            <div>
                                <h2>Detalle de compra</h2>
                                <p>La suma del detalle debe coincidir con la base imponible.</p>
                            </div>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="agregar-detalle">Agregar linea</button>
                        </div>

                        <div class="table-responsive workspace-table-wrap">
                            <table class="table align-middle app-table workspace-table" id="detalle-table">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th>Cuenta contable</th>
                                        <th>Afectacion IGV</th>
                                        <th>Descripcion</th>
                                        <th>Cantidad</th>
                                        <th>Valor unitario</th>
                                        <th>Importe bruto</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < Model.Formulario.Detalles.Count; i++)
                                    {
                                        <tr>
                                            <td class="detalle-orden-cell">
                                                <input asp-for="Formulario.Detalles[i].Item" class="form-control" readonly />
                                            </td>
                                            <td>
                                                <input type="hidden" asp-for="Formulario.Detalles[i].IdPlanCuenta" class="js-cuenta-id" />
                                                <div class="workspace-lookup-control workspace-lookup-control-compact">
                                                    <input class="form-control js-cuenta-texto" value="@(string.IsNullOrWhiteSpace(Model.Formulario.Detalles[i].CuentaTexto) ? "Seleccione cuenta" : Model.Formulario.Detalles[i].CuentaTexto)" readonly />
                                                    <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-open-cuenta-modal" title="Buscar cuenta" aria-label="Buscar cuenta"><i class="bi bi-search"></i></button>
                                                </div>
                                                <span asp-validation-for="Formulario.Detalles[i].IdPlanCuenta" class="text-danger"></span>
                                            </td>
                                            <td>
                                                <select asp-for="Formulario.Detalles[i].IdTipoAfectacionIGV" class="form-select js-afectacion">
                                                    @foreach (var afectacion in Model.TiposAfectacionIgv)
                                                    {
                                                        <option value="@afectacion.IdTipoAfectacionIGV" data-codigo="@afectacion.CodigoSunat">@afectacion.CodigoSunat - @afectacion.NombreAfectacion</option>
                                                    }
                                                </select>
                                                <span asp-validation-for="Formulario.Detalles[i].IdTipoAfectacionIGV" class="text-danger"></span>
                                            </td>
                                            <td>
                                                <input asp-for="Formulario.Detalles[i].Descripcion" class="form-control" />
                                                <span asp-validation-for="Formulario.Detalles[i].Descripcion" class="text-danger"></span>
                                            </td>
                                            <td class="detalle-porcentaje-cell">
                                                <input asp-for="Formulario.Detalles[i].Cantidad" class="form-control js-cantidad" />
                                            </td>
                                            <td class="detalle-porcentaje-cell">
                                                <input asp-for="Formulario.Detalles[i].ValorUnitario" class="form-control js-unitario" />
                                            </td>
                                            <td class="detalle-porcentaje-cell">
                                                <input asp-for="Formulario.Detalles[i].ImporteBruto" class="form-control js-bruto" readonly />
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-outline-secondary btn-sm js-remove-row">Quitar</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="workspace-inline-note">
                            <strong>Total detalle:</strong> <span id="total-detalle">0.00</span>
                        </div>
                    </div>

                    <div class="workspace-section workspace-totals-section">
                        <div class="workspace-section-head workspace-section-head-compact">
                            <div>
                                <span class="workspace-section-kicker">Totales</span>
                                <h2>Totales globales</h2>
                                <p>Resume los importes tributarios y el total del comprobante.</p>
                            </div>
                        </div>
                        <div class="workspace-window-body">
                            <div class="workspace-form-grid workspace-totals-grid">
                                <div class="workspace-field">
                                    <label asp-for="Formulario.BaseImponible" class="form-label">Sub total</label>
                                    <input asp-for="Formulario.BaseImponible" class="form-control js-total-global" readonly />
                                </div>
                                <div class="workspace-field">
                                    <label asp-for="Formulario.TotalExonerado" class="form-label">Total exonerado</label>
                                    <input asp-for="Formulario.TotalExonerado" class="form-control js-total-global" readonly />
                                </div>
                                <div class="workspace-field">
                                    <label asp-for="Formulario.TotalInafecto" class="form-label">Total inafecto</label>
                                    <input asp-for="Formulario.TotalInafecto" class="form-control js-total-global" readonly />
                                </div>
                                <div class="workspace-field">
                                    <label asp-for="Formulario.Igv" class="form-label">IGV</label>
                                    <input asp-for="Formulario.Igv" class="form-control js-total-global" readonly />
                                    <small class="workspace-field-help">Impuesto General a las Ventas.</small>
                                </div>
                                <div class="workspace-field">
                                    <label asp-for="Formulario.Icbper" class="form-label">ICBPER</label>
                                    <input asp-for="Formulario.Icbper" class="form-control js-total-global" readonly />
                                </div>
                                <div class="workspace-field">
                                    <label asp-for="Formulario.ImporteTotal" class="form-label">Importe total</label>
                                    <input asp-for="Formulario.ImporteTotal" class="form-control workspace-total-input js-total-global" readonly />
                                </div>
                                <input asp-for="Formulario.Isc" type="hidden" />
                                <input asp-for="Formulario.OtrosTributos" type="hidden" />
                                <input asp-for="Formulario.Redondeo" type="hidden" />
                            </div>
                        </div>
                    </div>

                    <div class="workspace-section">
                        <div class="workspace-section-head workspace-section-head-compact">
                            <div>
                                <span class="workspace-section-kicker">Detraccion</span>
                                <h2>Sistema SPOT</h2>
                                <p>Descuenta la detraccion del saldo del comprobante y separa un documento independiente para su pago.</p>
                            </div>
                        </div>

                        <div class="workspace-form-grid">
                            <div class="workspace-field">
                                <label class="form-label d-block">Aplicar detraccion</label>
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="Formulario.TieneDetraccion" class="form-check-input" id="compraTieneDetraccion" />
                                    <label class="form-check-label" for="compraTieneDetraccion">La compra esta afecta a detraccion</label>
                                </div>
                            </div>
                            <div class="workspace-field workspace-field-span-2">
                                <label class="form-label" for="compraDetraccionTexto">Codigo detraccion SUNAT</label>
                                <input asp-for="Formulario.IdDetraccionSunat" type="hidden" id="compraDetraccionId" />
                                <div class="workspace-lookup-control">
                                    <input asp-for="Formulario.DetraccionTexto" id="compraDetraccionTexto" class="form-control" readonly placeholder="Seleccione un codigo SUNAT" />
                                    <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button" id="btnAbrirDetraccionModal" title="Buscar detraccion" aria-label="Buscar detraccion"><i class="bi bi-search"></i></button>
                                </div>
                                <span asp-validation-for="Formulario.IdDetraccionSunat" class="text-danger"></span>
                            </div>
                            <div class="workspace-field">
                                <label asp-for="Formulario.PorcentajeDetraccion" class="form-label">Porcentaje</label>
                                <input asp-for="Formulario.PorcentajeDetraccion" class="form-control" id="compraPorcentajeDetraccion" readonly />
                            </div>
                            <div class="workspace-field">
                                <label asp-for="Formulario.ImporteDetraccion" class="form-label">Importe detraccion</label>
                                <input asp-for="Formulario.ImporteDetraccion" class="form-control js-total-global" id="compraImporteDetraccion" readonly />
                                <span asp-validation-for="Formulario.ImporteDetraccion" class="text-danger"></span>
                            </div>
                            <div class="workspace-field">
                                <label asp-for="Formulario.SaldoPago" class="form-label">Saldo por pagar</label>
                                <input asp-for="Formulario.SaldoPago" class="form-control js-total-global" id="compraSaldoPago" readonly />
                                <small class="workspace-field-help">Saldo pendiente del comprobante principal luego de descontar la detraccion.</small>
                            </div>
                        </div>
                    </div>

                    <div class="workspace-actions">
                        <button type="submit" class="btn btn-primary">Guardar compra</button>
                        <a asp-action="Index" asp-route-anio="@Model.Formulario.FechaContabilizacion.Year" asp-route-mes="@Model.Formulario.FechaContabilizacion.Month" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            }
        </div>
    </section>
</section>

<template id="detalle-row-template">
    <tr>
        <td class="detalle-orden-cell">
            <input name="Formulario.Detalles[__index__].Item" class="form-control" readonly value="0" />
        </td>
        <td>
            <input type="hidden" name="Formulario.Detalles[__index__].IdPlanCuenta" class="js-cuenta-id" />
            <div class="workspace-lookup-control workspace-lookup-control-compact">
                <input class="form-control js-cuenta-texto" value="Seleccione cuenta" readonly />
                <button type="button" class="btn btn-outline-secondary btn-sm workspace-icon-button js-open-cuenta-modal" title="Buscar cuenta" aria-label="Buscar cuenta"><i class="bi bi-search"></i></button>
            </div>
        </td>
        <td>
            <select name="Formulario.Detalles[__index__].IdTipoAfectacionIGV" class="form-select js-afectacion">
                @foreach (var afectacion in Model.TiposAfectacionIgv)
                {
                    <option value="@afectacion.IdTipoAfectacionIGV" data-codigo="@afectacion.CodigoSunat" selected="@(afectacion.CodigoSunat == "10")">@afectacion.CodigoSunat - @afectacion.NombreAfectacion</option>
                }
            </select>
        </td>
        <td>
            <input name="Formulario.Detalles[__index__].Descripcion" class="form-control" />
        </td>
        <td class="detalle-porcentaje-cell">
            <input name="Formulario.Detalles[__index__].Cantidad" class="form-control js-cantidad" value="1" />
        </td>
        <td class="detalle-porcentaje-cell">
            <input name="Formulario.Detalles[__index__].ValorUnitario" class="form-control js-unitario" value="0" />
        </td>
        <td class="detalle-porcentaje-cell">
            <input name="Formulario.Detalles[__index__].ImporteBruto" class="form-control js-bruto" value="0" readonly />
        </td>
        <td class="text-end">
            <button type="button" class="btn btn-outline-secondary btn-sm js-remove-row">Quitar</button>
        </td>
    </tr>
</template>

<div class="modal fade workspace-modal" id="compraCuentaModal" tabindex="-1" aria-labelledby="compraCuentaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content workspace-modal-content">
            <div class="modal-header workspace-modal-header">
                <div>
                    <span class="workspace-window-kicker">Ayuda contable</span>
                    <h2 class="workspace-modal-title" id="compraCuentaModalLabel">Seleccionar cuenta contable</h2>
                    <p class="workspace-modal-subtitle">Filtra por codigo, nombre o nivel y confirma la cuenta para la linea de compra activa.</p>
                </div>
                <button type="button" class="btn-close workspace-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body workspace-modal-body">
                <div class="workspace-filter-card mt-0">
                    <div class="workspace-filter-grid">
                        <div class="workspace-field workspace-field-span-2">
                            <label class="form-label" for="compraCuentaFiltro">Filtro</label>
                            <input id="compraCuentaFiltro" class="form-control" placeholder="Codigo o nombre de cuenta" autocomplete="off" />
                        </div>
                        <div class="workspace-field">
                            <label class="form-label" for="compraCuentaNivelFiltro">Nivel</label>
                            <select id="compraCuentaNivelFiltro" class="form-select">
                                <option value="">Todos</option>
                                @for (var nivel = 1; nivel <= 5; nivel++)
                                {
                                    <option value="@nivel">@nivel</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="table-responsive workspace-table-wrap">
                    <table class="table align-middle app-table workspace-table workspace-lookup-table">
                        <thead>
                            <tr>
                                <th class="workspace-lookup-select-cell">Sel.</th>
                                <th>Codigo</th>
                                <th>Cuenta</th>
                                <th>Nivel</th>
                                <th>Centro costo</th>
                            </tr>
                        </thead>
                        <tbody id="compraCuentaResultados">
                            <tr data-cuenta-empty-row="true" class="d-none">
                                <td colspan="5">
                                    <div class="app-empty-state app-empty-state-inline">
                                        <i class="bi bi-search"></i>
                                        <div>
                                            <strong>No hay cuentas con ese filtro</strong>
                                            <p>Ajusta el texto o nivel para ubicar la cuenta contable.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="workspace-inline-note">
                    <strong>Ayuda:</strong> se cargan hasta 100 cuentas. Si necesita una cuenta especifica, filtre por codigo o nombre.
                </div>
            </div>
            <div class="modal-footer workspace-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="aceptarCuentaCompra">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade workspace-modal" id="proveedorRapidoModal" tabindex="-1" aria-labelledby="proveedorRapidoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content workspace-modal-content">
            <div class="modal-header workspace-modal-header">
                <div>
                    <span class="workspace-window-kicker">Registro rapido</span>
                    <h2 class="workspace-modal-title" id="proveedorRapidoModalLabel">Nuevo proveedor rapido</h2>
                    <p class="workspace-modal-subtitle">Se registrara en personas y se activara como proveedor de la empresa actual.</p>
                </div>
                <button type="button" class="btn-close workspace-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="proveedorRapidoForm">
                <div class="modal-body workspace-modal-body">
                    <div class="alert alert-danger d-none" id="proveedorRapidoError"></div>
                    <div class="row g-3 workspace-modal-form-row">
                        <div class="col-md-4">
                            <label class="form-label" for="proveedorRapidoTipoPersona">Tipo de persona</label>
                            <select class="form-select" id="proveedorRapidoTipoPersona" required>
                                <option value="">Seleccione</option>
                                <option value="N">Natural</option>
                                <option value="J">Juridica</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="proveedorRapidoTipoDocumento">Tipo documento</label>
                            <select class="form-select" id="proveedorRapidoTipoDocumento" required>
                                <option value="">Seleccione</option>
                                @foreach (var tipoDocumento in Model.TiposDocumentoIdentidad)
                                {
                                    <option value="@tipoDocumento.Valor">@tipoDocumento.Texto</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="proveedorRapidoNumeroDocumento">Numero documento</label>
                            <input type="text" class="form-control" id="proveedorRapidoNumeroDocumento" maxlength="20" required />
                        </div>
                        <div class="col-md-6" id="proveedorRapidoRazonSocialWrap">
                            <label class="form-label" for="proveedorRapidoRazonSocial">Razon social</label>
                            <input type="text" class="form-control" id="proveedorRapidoRazonSocial" maxlength="200" />
                        </div>
                        <div class="col-md-3 d-none" id="proveedorRapidoNombresWrap">
                            <label class="form-label" for="proveedorRapidoNombres">Nombres</label>
                            <input type="text" class="form-control" id="proveedorRapidoNombres" maxlength="150" />
                        </div>
                        <div class="col-md-3 d-none" id="proveedorRapidoApellidosWrap">
                            <label class="form-label" for="proveedorRapidoApellidos">Apellidos</label>
                            <input type="text" class="form-control" id="proveedorRapidoApellidos" maxlength="100" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer workspace-modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="proveedorRapidoGuardar">Guardar proveedor</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade workspace-modal" id="compraDetraccionModal" tabindex="-1" aria-labelledby="compraDetraccionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content workspace-modal-content">
            <div class="modal-header workspace-modal-header">
                <div>
                    <span class="workspace-window-kicker">SUNAT</span>
                    <h2 class="workspace-modal-title" id="compraDetraccionModalLabel">Seleccionar codigo de detraccion</h2>
                    <p class="workspace-modal-subtitle">Elige el codigo SPOT que corresponde al bien o servicio.</p>
                </div>
                <button type="button" class="btn-close workspace-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body workspace-modal-body">
                <div class="workspace-filter-card mt-0">
                    <div class="workspace-filter-grid">
                        <div class="workspace-field workspace-field-span-3">
                            <label class="form-label" for="compraDetraccionFiltro">Filtro</label>
                            <input id="compraDetraccionFiltro" class="form-control" placeholder="Codigo o descripcion de detraccion" autocomplete="off" />
                        </div>
                    </div>
                </div>
                <div class="table-responsive workspace-table-wrap">
                    <table class="table align-middle app-table workspace-table workspace-lookup-table">
                        <thead>
                            <tr>
                                <th class="workspace-lookup-select-cell">Sel.</th>
                                <th>Codigo</th>
                                <th>Descripcion</th>
                                <th>%</th>
                            </tr>
                        </thead>
                        <tbody id="compraDetraccionResultados">
                            @if (Model.DetraccionesSunat.Count == 0)
                            {
                                <tr data-detraccion-empty-row="true">
                                    <td colspan="4">
                                        <div class="app-empty-state app-empty-state-inline">
                                            <i class="bi bi-search"></i>
                                            <div>
                                                <strong>No hay codigos de detraccion cargados</strong>
                                                <p>Registre primero el maestro general de detracciones SUNAT.</p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var detraccion in Model.DetraccionesSunat)
                                {
                                    <tr data-detraccion-row="true"
                                        data-id="@detraccion.IdDetraccionSunat"
                                        data-codigo="@detraccion.CodigoSunat"
                                        data-descripcion="@detraccion.Descripcion"
                                        data-porcentaje="@detraccion.Porcentaje.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)">
                                        <td class="workspace-lookup-select-cell">
                                            <input type="radio" name="compraDetraccionSeleccion" value="@detraccion.IdDetraccionSunat" />
                                        </td>
                                        <td>@detraccion.CodigoSunat</td>
                                        <td>@detraccion.Descripcion</td>
                                        <td>@detraccion.Porcentaje.ToString("0.##")</td>
                                    </tr>
                                }
                                <tr data-detraccion-empty-row="true" class="d-none">
                                    <td colspan="4">
                                        <div class="app-empty-state app-empty-state-inline">
                                            <i class="bi bi-search"></i>
                                            <div>
                                                <strong>No hay codigos con ese filtro</strong>
                                                <p>Ajusta el codigo o la descripcion para ubicar la detraccion SUNAT.</p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer workspace-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="aceptarDetraccionCompra">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const proveedorBuscarEl = document.getElementById("compraProveedorBuscar");
            const proveedorIdEl = document.getElementById("compraProveedorId");
            const proveedorResultadosEl = document.getElementById("compraProveedorResultados");
            const proveedorResultadosWrapEl = document.getElementById("compraProveedorResultadosWrap");
            const proveedorTipoDocumentoEl = document.getElementById("compraProveedorTipoDocumento");
            const proveedorNumeroDocumentoEl = document.getElementById("compraProveedorNumeroDocumento");
            const proveedorNombreLegalEl = document.getElementById("compraProveedorNombreLegal");
            const proveedorContactoEl = document.getElementById("compraProveedorContacto");
            const proveedorCorreoEl = document.getElementById("compraProveedorCorreo");
            const fechaContabilizacionEl = document.getElementById("compraFechaContabilizacion");
            const btnNuevoProveedorEl = document.getElementById("btnNuevoProveedor");
            const proveedorRapidoModalEl = document.getElementById("proveedorRapidoModal");
            const proveedorRapidoFormEl = document.getElementById("proveedorRapidoForm");
            const proveedorRapidoErrorEl = document.getElementById("proveedorRapidoError");
            const proveedorRapidoTipoPersonaEl = document.getElementById("proveedorRapidoTipoPersona");
            const proveedorRapidoTipoDocumentoEl = document.getElementById("proveedorRapidoTipoDocumento");
            const proveedorRapidoNumeroDocumentoEl = document.getElementById("proveedorRapidoNumeroDocumento");
            const proveedorRapidoRazonSocialEl = document.getElementById("proveedorRapidoRazonSocial");
            const proveedorRapidoNombresEl = document.getElementById("proveedorRapidoNombres");
            const proveedorRapidoApellidosEl = document.getElementById("proveedorRapidoApellidos");
            const proveedorRapidoRazonSocialWrapEl = document.getElementById("proveedorRapidoRazonSocialWrap");
            const proveedorRapidoNombresWrapEl = document.getElementById("proveedorRapidoNombresWrap");
            const proveedorRapidoApellidosWrapEl = document.getElementById("proveedorRapidoApellidosWrap");
            const proveedorRapidoGuardarEl = document.getElementById("proveedorRapidoGuardar");
            const crearProveedorRapidoUrl = '@Url.Action("CrearProveedorRapido", "Compra")';
            const proveedoresUrl = '@Url.Action("BuscarProveedores", "Compra")';
            const proveedoresDetalleMap = new Map();
            const formEl = document.getElementById("compra-form");
            const serieDocumentoEl = formEl?.querySelector(".js-serie-documento");
            const numeroDocumentoEl = formEl?.querySelector(".js-numero-documento");
            const tableBody = document.querySelector("#detalle-table tbody");
            const template = document.getElementById("detalle-row-template");
            const addButton = document.getElementById("agregar-detalle");
            const totalDetalleLabel = document.getElementById("total-detalle");
            const cuentaModalEl = document.getElementById("compraCuentaModal");
            const cuentaModal = cuentaModalEl && window.bootstrap ? bootstrap.Modal.getOrCreateInstance(cuentaModalEl) : null;
            const cuentaResultadosBodyEl = document.getElementById("compraCuentaResultados");
            const cuentaFiltro = document.getElementById("compraCuentaFiltro");
            const cuentaNivelFiltro = document.getElementById("compraCuentaNivelFiltro");
            const buscarCuentasUrl = '@Url.Action("BuscarAyuda", "PlanCuenta")';
            const tieneDetraccionEl = document.getElementById("compraTieneDetraccion");
            const detraccionIdEl = document.getElementById("compraDetraccionId");
            const detraccionTextoEl = document.getElementById("compraDetraccionTexto");
            const porcentajeDetraccionEl = document.getElementById("compraPorcentajeDetraccion");
            const importeDetraccionEl = document.getElementById("compraImporteDetraccion");
            const saldoPagoEl = document.getElementById("compraSaldoPago");
            const btnAbrirDetraccionModalEl = document.getElementById("btnAbrirDetraccionModal");
            const detraccionModalEl = document.getElementById("compraDetraccionModal");
            const detraccionModal = detraccionModalEl && window.bootstrap ? bootstrap.Modal.getOrCreateInstance(detraccionModalEl) : null;
            const detraccionFiltroEl = document.getElementById("compraDetraccionFiltro");
            const detraccionResultadosEl = document.getElementById("compraDetraccionResultados");
            let cuentaSeleccion = null;
            let cuentaRowActiva = null;
            let cuentaBusquedaProgramada = null;
            let detraccionSeleccion = null;
            const proveedorRapidoModal = proveedorRapidoModalEl && window.bootstrap
                ? new bootstrap.Modal(proveedorRapidoModalEl)
                : null;

            if (!tableBody || !template || !addButton || !totalDetalleLabel) {
                return;
            }

            const parseAmount = (value) => {
                const parsed = parseFloat((value ?? "0").replace(",", "."));
                return Number.isNaN(parsed) ? 0 : parsed;
            };

            const formatMoney = (value) => Number(value || 0).toFixed(2);
            const normalizeDigits = (value, maxLength) => String(value || "").replace(/\D/g, "").slice(0, maxLength);
            const normalizeSerieDocumento = (value, completar = false) => {
                const cleaned = String(value || "").toUpperCase().replace(/[^A-Z0-9]/g, "");
                if (!cleaned) {
                    return "";
                }

                const prefijo = cleaned.charAt(0);
                if (prefijo !== "F" && prefijo !== "B") {
                    return "";
                }

                const digitos = cleaned.slice(1).replace(/\D/g, "").slice(0, 3);
                return completar ? `${prefijo}${digitos.padStart(3, "0")}` : `${prefijo}${digitos}`;
            };
            const obtenerCategoriaAfectacion = (codigoAfectacion) => {
                const codigo = String(codigoAfectacion || "").trim();
                if (codigo.startsWith("1")) {
                    return "gravado";
                }
                if (codigo.startsWith("2")) {
                    return "exonerado";
                }
                if (codigo.startsWith("3")) {
                    return "inafecto";
                }

                return "otros";
            };

            const setFormValue = (name, value) => {
                const input = formEl?.querySelector(`[name="${name}"]`);
                if (input) {
                    input.value = formatMoney(value);
                }
            };

            const setDetraccionValue = (input, value, decimals = 2) => {
                if (!input) {
                    return;
                }

                const numericValue = Number(value || 0);
                input.value = numericValue.toFixed(decimals);
            };

            const marcarSeleccionDetraccion = () => {
                const rows = Array.from(detraccionResultadosEl?.querySelectorAll("[data-detraccion-row='true']") || []);
                rows.forEach((row) => {
                    const seleccionado = detraccionSeleccion && row.dataset.id === String(detraccionSeleccion.idDetraccionSunat);
                    row.classList.toggle("is-selected", seleccionado);
                    const radio = row.querySelector("input[type='radio']");
                    if (radio) {
                        radio.checked = Boolean(seleccionado);
                    }
                });
            };

            const calcularTotalesDetraccion = () => {
                const importeTotal = parseAmount(formEl?.querySelector('[name="Formulario.ImporteTotal"]')?.value);
                const aplicaDetraccion = Boolean(tieneDetraccionEl?.checked);
                const porcentaje = aplicaDetraccion ? parseAmount(porcentajeDetraccionEl?.value) : 0;
                const importeDetraccion = aplicaDetraccion && porcentaje > 0
                    ? Math.round((importeTotal * (porcentaje / 100)) * 100) / 100
                    : 0;
                const saldoPago = Math.max(0, Math.round((importeTotal - importeDetraccion) * 100) / 100);

                setDetraccionValue(importeDetraccionEl, importeDetraccion);
                setDetraccionValue(saldoPagoEl, saldoPago);

                if (!aplicaDetraccion) {
                    setDetraccionValue(porcentajeDetraccionEl, 0, 4);
                }
            };

            const limpiarDetraccionSeleccion = () => {
                detraccionSeleccion = null;
                if (detraccionIdEl) {
                    detraccionIdEl.value = "";
                }
                if (detraccionTextoEl) {
                    detraccionTextoEl.value = "";
                }
                setDetraccionValue(porcentajeDetraccionEl, 0, 4);
                marcarSeleccionDetraccion();
                calcularTotalesDetraccion();
            };

            const aplicarDetraccionSeleccion = (item) => {
                if (!item) {
                    limpiarDetraccionSeleccion();
                    return;
                }

                detraccionSeleccion = item;
                if (detraccionIdEl) {
                    detraccionIdEl.value = String(item.idDetraccionSunat || "");
                }
                if (detraccionTextoEl) {
                    detraccionTextoEl.value = `${String(item.codigoSunat || "")} - ${String(item.descripcion || "")}`;
                }
                setDetraccionValue(porcentajeDetraccionEl, Number(item.porcentaje || 0), 4);
                marcarSeleccionDetraccion();
                calcularTotalesDetraccion();
            };

            const alternarDetraccion = () => {
                const aplicaDetraccion = Boolean(tieneDetraccionEl?.checked);
                if (btnAbrirDetraccionModalEl) {
                    btnAbrirDetraccionModalEl.disabled = !aplicaDetraccion;
                }

                if (!aplicaDetraccion) {
                    limpiarDetraccionSeleccion();
                } else {
                    calcularTotalesDetraccion();
                }
            };

            const filtrarDetracciones = () => {
                if (!detraccionResultadosEl) {
                    return;
                }

                const filtro = String(detraccionFiltroEl?.value || "").trim().toLowerCase();
                const rows = Array.from(detraccionResultadosEl.querySelectorAll("[data-detraccion-row='true']"));
                let visibles = 0;

                rows.forEach((row) => {
                    const texto = `${row.dataset.codigo || ""} ${row.dataset.descripcion || ""}`.toLowerCase();
                    const visible = !filtro || texto.includes(filtro);
                    row.classList.toggle("d-none", !visible);
                    if (visible) {
                        visibles += 1;
                    }
                });

                const emptyRow = detraccionResultadosEl.querySelector("[data-detraccion-empty-row='true']");
                if (emptyRow) {
                    emptyRow.classList.toggle("d-none", visibles > 0);
                }
            };

            const marcarSeleccionCuenta = () => {
                const rows = Array.from(cuentaResultadosBodyEl?.querySelectorAll("[data-cuenta-row='true']") || []);
                rows.forEach((row) => {
                    const seleccionado = cuentaSeleccion && row.dataset.id === String(cuentaSeleccion.idPlanCuenta);
                    row.classList.toggle("is-selected", seleccionado);
                    const radio = row.querySelector("input[type='radio']");
                    if (radio) {
                        radio.checked = Boolean(seleccionado);
                    }
                });
            };

            const renderCuentaResultados = (items) => {
                if (!cuentaResultadosBodyEl) {
                    return;
                }

                const emptyRow = cuentaResultadosBodyEl.querySelector("[data-cuenta-empty-row='true']");
                cuentaResultadosBodyEl.querySelectorAll("[data-cuenta-row='true']").forEach((row) => row.remove());
                emptyRow?.classList.toggle("d-none", items.length > 0);

                items.forEach((item) => {
                    const row = document.createElement("tr");
                    row.className = "workspace-lookup-row";
                    row.dataset.cuentaRow = "true";
                    row.dataset.id = String(item.idPlanCuenta || "");
                    row.dataset.codigo = String(item.codigoCuenta || "");
                    row.dataset.nombre = String(item.nombreCuenta || "");
                    row.dataset.nivel = String(item.nivelCuenta || "");
                    row.innerHTML = `
                        <td class="workspace-lookup-select-cell">
                            <input class="form-check-input" type="radio" name="cuentaCompraSeleccion" value="${String(item.idPlanCuenta || "")}" />
                        </td>
                        <td class="workspace-tree-code">${String(item.codigoCuenta || "")}</td>
                        <td>${String(item.nombreCuenta || "")}</td>
                        <td>${String(item.nivelCuenta || "")}</td>
                        <td>${item.requiereCentroCosto ? "Si" : "No"}</td>`;
                    row.addEventListener("click", () => {
                        cuentaSeleccion = item;
                        marcarSeleccionCuenta();
                    });
                    cuentaResultadosBodyEl.appendChild(row);
                });

                marcarSeleccionCuenta();
            };

            const cargarCuentasAyuda = async () => {
                const params = new URLSearchParams({ tamanoPagina: "100", soloMovimiento: "true" });
                const filtro = String(cuentaFiltro?.value || "").trim();
                const nivel = String(cuentaNivelFiltro?.value || "").trim();
                if (filtro.length >= 2) {
                    params.append("textoBusqueda", filtro);
                }
                if (nivel) {
                    params.append("nivelCuenta", nivel);
                }

                const response = await fetch(`${buscarCuentasUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    throw new Error(payload.mensaje || "No se pudo cargar el plan de cuentas.");
                }

                renderCuentaResultados(payload.items || []);
            };

            const programarBusquedaCuenta = () => {
                if (cuentaBusquedaProgramada) {
                    window.clearTimeout(cuentaBusquedaProgramada);
                }

                cuentaBusquedaProgramada = window.setTimeout(async () => {
                    try {
                        await cargarCuentasAyuda();
                    } catch (error) {
                        console.warn(error);
                        renderCuentaResultados([]);
                    }
                }, 250);
            };

            const abrirCuentaModal = async (row) => {
                cuentaRowActiva = row;
                const cuentaIdActual = row.querySelector(".js-cuenta-id")?.value || "";
                cuentaSeleccion = cuentaIdActual ? { idPlanCuenta: cuentaIdActual } : null;
                try {
                    await cargarCuentasAyuda();
                } catch (error) {
                    console.warn(error);
                    renderCuentaResultados([]);
                }
                cuentaModal?.show();
            };

            const mostrarResultadosProveedor = (visible) => {
                if (!proveedorResultadosWrapEl) {
                    return;
                }

                proveedorResultadosWrapEl.classList.toggle("d-none", !visible);
            };

            const actualizarDatosProveedor = (detalle = null) => {
                if (proveedorTipoDocumentoEl) {
                    proveedorTipoDocumentoEl.value = detalle?.tipoDocumento || "-";
                }
                if (proveedorNumeroDocumentoEl) {
                    proveedorNumeroDocumentoEl.value = detalle?.numeroDocumento || "-";
                }
                if (proveedorNombreLegalEl) {
                    proveedorNombreLegalEl.value = detalle?.nombre || "-";
                }
            };

            const seleccionarProveedor = (proveedorId, textoProveedor, detalle = null) => {
                if (!proveedorIdEl || !proveedorBuscarEl) {
                    return;
                }

                proveedorIdEl.value = proveedorId ? String(proveedorId) : "";
                proveedorBuscarEl.value = proveedorId ? String(textoProveedor || "") : "";
                const info = detalle || proveedoresDetalleMap.get(String(proveedorId)) || null;
                actualizarDatosProveedor(info);
                mostrarResultadosProveedor(false);
            };

            const limpiarProveedorRapidoError = () => {
                if (!proveedorRapidoErrorEl) {
                    return;
                }

                proveedorRapidoErrorEl.textContent = "";
                proveedorRapidoErrorEl.classList.add("d-none");
            };

            const mostrarProveedorRapidoError = (mensaje) => {
                if (!proveedorRapidoErrorEl) {
                    return;
                }

                proveedorRapidoErrorEl.textContent = mensaje || "No se pudo registrar el proveedor.";
                proveedorRapidoErrorEl.classList.remove("d-none");
            };

            const actualizarFormularioProveedorRapido = () => {
                const tipoPersona = String(proveedorRapidoTipoPersonaEl?.value || "");
                const esJuridica = tipoPersona === "J";
                const esNatural = tipoPersona === "N";

                proveedorRapidoRazonSocialWrapEl?.classList.toggle("d-none", !esJuridica);
                proveedorRapidoNombresWrapEl?.classList.toggle("d-none", !esNatural);
                proveedorRapidoApellidosWrapEl?.classList.toggle("d-none", !esNatural);

                if (proveedorRapidoRazonSocialEl) {
                    proveedorRapidoRazonSocialEl.required = esJuridica;
                }
                if (proveedorRapidoNombresEl) {
                    proveedorRapidoNombresEl.required = esNatural;
                }
                if (proveedorRapidoApellidosEl) {
                    proveedorRapidoApellidosEl.required = esNatural;
                }
            };

            const limpiarOpcionesProveedor = (mensaje = "Escribe y presiona Enter para buscar...") => {
                if (proveedorIdEl) {
                    proveedorIdEl.value = "";
                }
                if (!proveedorResultadosEl) {
                    return;
                }

                proveedorResultadosEl.innerHTML = "";
                proveedoresDetalleMap.clear();
                const option = document.createElement("option");
                option.value = "";
                option.textContent = mensaje;
                proveedorResultadosEl.appendChild(option);
                actualizarDatosProveedor(null);
                mostrarResultadosProveedor(false);
            };

            const recargarProveedores = async (buscar = "", proveedorIdPreferido = "") => {
                if (!proveedorResultadosEl) {
                    return [];
                }

                const params = new URLSearchParams();
                if (buscar) {
                    params.append("buscar", buscar);
                }
                if (proveedorIdPreferido) {
                    params.append("proveedorId", proveedorIdPreferido);
                }

                const response = await fetch(`${proveedoresUrl}?${params.toString()}`, { cache: "no-store" });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    throw new Error(payload.mensaje || "No se pudo buscar proveedores.");
                }

                const items = (payload.items || []).map(item => ({
                    value: String(item.value ?? ""),
                    text: String(item.text ?? ""),
                    tipoDocumento: String(item.tipoDocumento ?? ""),
                    numeroDocumento: String(item.numeroDocumento ?? ""),
                    nombre: String(item.nombre ?? ""),
                    numero: String(item.numero ?? ""),
                    correo: String(item.correo ?? "")
                }));

                proveedoresDetalleMap.clear();
                proveedorResultadosEl.innerHTML = "";

                if (items.length === 0) {
                    const option = document.createElement("option");
                    option.value = "";
                    option.textContent = "Sin resultados";
                    proveedorResultadosEl.appendChild(option);
                    mostrarResultadosProveedor(true);
                    if (!proveedorIdPreferido && proveedorIdEl) {
                        proveedorIdEl.value = "";
                        actualizarDatosProveedor(null);
                    }
                    return items;
                }

                let encontradoPreferido = false;
                items.forEach(item => {
                    const option = document.createElement("option");
                    option.value = item.value;
                    option.textContent = item.text;
                    option.setAttribute("data-tipo-documento", item.tipoDocumento || "");
                    option.setAttribute("data-numero-documento", item.numeroDocumento || "");
                    option.setAttribute("data-nombre", item.nombre || "");
                    option.setAttribute("data-numero", item.numero || "");
                    option.setAttribute("data-correo", item.correo || "");
                    proveedorResultadosEl.appendChild(option);
                    proveedoresDetalleMap.set(item.value, {
                        tipoDocumento: item.tipoDocumento || "",
                        numeroDocumento: item.numeroDocumento || "",
                        nombre: item.nombre || "",
                        numero: item.numero || "",
                        correo: item.correo || ""
                    });
                    if (proveedorIdPreferido && item.value === String(proveedorIdPreferido)) {
                        encontradoPreferido = true;
                    }
                });

                if (proveedorIdPreferido && encontradoPreferido) {
                    const selected = Array.from(proveedorResultadosEl.options).find(x => x.value === String(proveedorIdPreferido));
                    if (selected) {
                        seleccionarProveedor(selected.value, selected.text || "", {
                            tipoDocumento: selected.getAttribute("data-tipo-documento") || "",
                            numeroDocumento: selected.getAttribute("data-numero-documento") || "",
                            nombre: selected.getAttribute("data-nombre") || "",
                            numero: selected.getAttribute("data-numero") || "",
                            correo: selected.getAttribute("data-correo") || ""
                        });
                    }
                } else {
                    mostrarResultadosProveedor(true);
                    if (proveedorIdEl) {
                        proveedorIdEl.value = "";
                    }
                    actualizarDatosProveedor(null);
                }

                return items;
            };

            const bindRowActions = (row) => {
                row.querySelector(".js-remove-row")?.addEventListener("click", () => {
                    if (tableBody.querySelectorAll("tr").length === 1) {
                        return;
                    }

                    row.remove();
                    refreshRows();
                });

                row.querySelector(".js-open-cuenta-modal")?.addEventListener("click", () => {
                    abrirCuentaModal(row);
                });
            };

            const refreshRows = () => {
                const rows = Array.from(tableBody.querySelectorAll("tr"));
                let subtotal = 0;
                let totalGravado = 0;
                let totalExonerado = 0;
                let totalInafecto = 0;
                const icbper = 0;

                rows.forEach((row, index) => {
                    row.querySelectorAll("input, select, textarea, span").forEach((element) => {
                        ["name", "id", "for"].forEach((attribute) => {
                            const currentValue = element.getAttribute(attribute);
                            if (!currentValue) {
                                return;
                            }

                            const updatedValue = currentValue
                                .replaceAll("__index__", index)
                                .replace(/Formulario\.Detalles\[\d+\]/g, `Formulario.Detalles[${index}]`)
                                .replace(/Formulario_Detalles_\d+__/g, `Formulario_Detalles_${index}__`);

                            if (updatedValue !== currentValue) {
                                element.setAttribute(attribute, updatedValue);
                            }
                        });
                    });

                    const itemInput = row.querySelector('input[name$=".Item"]');
                    if (itemInput) {
                        itemInput.value = (index + 1).toString();
                    }

                    const cantidad = parseAmount(row.querySelector(".js-cantidad")?.value);
                    const valorUnitario = parseAmount(row.querySelector(".js-unitario")?.value);
                    const importe = Math.round((cantidad * valorUnitario) * 100) / 100;
                    const brutoInput = row.querySelector(".js-bruto");
                    if (brutoInput) {
                        brutoInput.value = formatMoney(importe);
                    }
                    const afectacionSelect = row.querySelector(".js-afectacion");
                    const codigoAfectacion = afectacionSelect?.selectedOptions?.[0]?.dataset.codigo || "";
                    const categoria = obtenerCategoriaAfectacion(codigoAfectacion);
                    subtotal += importe;
                    if (categoria === "gravado") {
                        totalGravado += importe;
                    } else if (categoria === "exonerado") {
                        totalExonerado += importe;
                    } else if (categoria === "inafecto") {
                        totalInafecto += importe;
                    }
                });

                const igv = Math.round((totalGravado * 0.18) * 100) / 100;
                const importeTotal = subtotal + igv;
                totalDetalleLabel.textContent = subtotal.toFixed(2);
                setFormValue("Formulario.BaseImponible", subtotal);
                setFormValue("Formulario.TotalExonerado", totalExonerado);
                setFormValue("Formulario.TotalInafecto", totalInafecto);
                setFormValue("Formulario.Icbper", icbper);
                setFormValue("Formulario.Igv", igv);
                setFormValue("Formulario.Isc", 0);
                setFormValue("Formulario.OtrosTributos", 0);
                setFormValue("Formulario.Redondeo", 0);
                setFormValue("Formulario.ImporteTotal", importeTotal);
                calcularTotalesDetraccion();
            };

            addButton.addEventListener("click", () => {
                const index = tableBody.querySelectorAll("tr").length;
                const html = template.innerHTML.replaceAll("__index__", index);
                tableBody.insertAdjacentHTML("beforeend", html);
                const row = tableBody.lastElementChild;
                if (row) {
                    bindRowActions(row);
                }
                refreshRows();
            });

            tableBody.querySelectorAll("tr").forEach(bindRowActions);
            tableBody.addEventListener("input", refreshRows);
            tableBody.addEventListener("change", refreshRows);
            refreshRows();
            if (detraccionIdEl?.value) {
                const filaDetraccionInicial = detraccionResultadosEl?.querySelector(`[data-detraccion-row='true'][data-id='${detraccionIdEl.value}']`);
                if (filaDetraccionInicial) {
                    detraccionSeleccion = {
                        idDetraccionSunat: Number(filaDetraccionInicial.getAttribute("data-id") || "0"),
                        codigoSunat: String(filaDetraccionInicial.getAttribute("data-codigo") || ""),
                        descripcion: String(filaDetraccionInicial.getAttribute("data-descripcion") || ""),
                        porcentaje: Number(filaDetraccionInicial.getAttribute("data-porcentaje") || "0")
                    };
                }
            }
            alternarDetraccion();
            fechaContabilizacionEl.value = `${@Html.Raw(System.Text.Json.JsonSerializer.Serialize(periodoContableValue))}-01`;
            numeroDocumentoEl?.addEventListener("keydown", (event) => {
                const teclasPermitidas = ["Backspace", "Delete", "Tab", "ArrowLeft", "ArrowRight", "Home", "End"];
                if (teclasPermitidas.includes(event.key) || event.ctrlKey || event.metaKey) {
                    return;
                }

                if (!/^\d$/.test(event.key)) {
                    event.preventDefault();
                }
            });
            serieDocumentoEl?.addEventListener("input", () => {
                serieDocumentoEl.value = normalizeSerieDocumento(serieDocumentoEl.value, false);
            });
            serieDocumentoEl?.addEventListener("blur", () => {
                serieDocumentoEl.value = normalizeSerieDocumento(serieDocumentoEl.value, true);
            });
            numeroDocumentoEl?.addEventListener("input", () => {
                numeroDocumentoEl.value = normalizeDigits(numeroDocumentoEl.value, 10);
            });
            numeroDocumentoEl?.addEventListener("blur", () => {
                numeroDocumentoEl.value = normalizeDigits(numeroDocumentoEl.value, 10);
            });

            document.getElementById("aceptarCuentaCompra")?.addEventListener("click", () => {
                if (String(cuentaSeleccion?.nivelCuenta || "") !== "5") {
                    window.alert("Seleccione una cuenta contable de nivel 5.");
                    return;
                }

                if (cuentaSeleccion && cuentaRowActiva) {
                    const cuentaIdInput = cuentaRowActiva.querySelector(".js-cuenta-id");
                    const cuentaTextoInput = cuentaRowActiva.querySelector(".js-cuenta-texto");
                    if (cuentaIdInput) {
                        cuentaIdInput.value = String(cuentaSeleccion.idPlanCuenta || "");
                    }
                    if (cuentaTextoInput) {
                        cuentaTextoInput.value = `${String(cuentaSeleccion.codigoCuenta || "")} - ${String(cuentaSeleccion.nombreCuenta || "")}`;
                    }
                }
                cuentaModal?.hide();
            });

            cuentaFiltro?.addEventListener("input", programarBusquedaCuenta);
            cuentaNivelFiltro?.addEventListener("change", programarBusquedaCuenta);
            tieneDetraccionEl?.addEventListener("change", alternarDetraccion);
            btnAbrirDetraccionModalEl?.addEventListener("click", () => {
                if (!tieneDetraccionEl?.checked) {
                    window.alert("Primero marque que la compra tiene detraccion.");
                    return;
                }

                marcarSeleccionDetraccion();
                filtrarDetracciones();
                detraccionModal?.show();
            });
            detraccionFiltroEl?.addEventListener("input", filtrarDetracciones);
            detraccionResultadosEl?.querySelectorAll("[data-detraccion-row='true']").forEach((row) => {
                const seleccionarFila = () => {
                    detraccionSeleccion = {
                        idDetraccionSunat: Number(row.dataset.id || "0"),
                        codigoSunat: String(row.dataset.codigo || ""),
                        descripcion: String(row.dataset.descripcion || ""),
                        porcentaje: Number(row.dataset.porcentaje || "0")
                    };
                    marcarSeleccionDetraccion();
                };

                row.addEventListener("click", seleccionarFila);
                row.addEventListener("dblclick", () => {
                    seleccionarFila();
                    aplicarDetraccionSeleccion(detraccionSeleccion);
                    detraccionModal?.hide();
                });
            });
            document.getElementById("aceptarDetraccionCompra")?.addEventListener("click", () => {
                if (!detraccionSeleccion || !detraccionSeleccion.idDetraccionSunat) {
                    window.alert("Seleccione un codigo de detraccion SUNAT.");
                    return;
                }

                aplicarDetraccionSeleccion(detraccionSeleccion);
                detraccionModal?.hide();
            });

            if (proveedorBuscarEl && proveedorIdEl && proveedorResultadosEl) {
                proveedorBuscarEl.addEventListener("input", () => {
                    if (proveedorIdEl.value) {
                        proveedorIdEl.value = "";
                        actualizarDatosProveedor(null);
                    }
                });

                proveedorBuscarEl.addEventListener("keydown", async (event) => {
                    if (event.key !== "Enter") {
                        return;
                    }

                    event.preventDefault();
                    const filtro = String(proveedorBuscarEl.value || "").trim();
                    if (filtro.length < 2) {
                        limpiarOpcionesProveedor("Escribe al menos 2 caracteres y presiona Enter.");
                        mostrarResultadosProveedor(true);
                        return;
                    }

                    try {
                        const items = await recargarProveedores(filtro);
                        if (items.length === 1) {
                            seleccionarProveedor(items[0].value, items[0].text, {
                                tipoDocumento: items[0].tipoDocumento || "",
                                numeroDocumento: items[0].numeroDocumento || "",
                                nombre: items[0].nombre || "",
                                numero: items[0].numero || "",
                                correo: items[0].correo || ""
                            });
                        } else {
                            mostrarResultadosProveedor(true);
                            proveedorResultadosEl.focus();
                        }
                    } catch (error) {
                        console.warn(error);
                        limpiarOpcionesProveedor("No se pudo cargar proveedores");
                        mostrarResultadosProveedor(true);
                    }
                });

                const sincronizarProveedorDesdeSelect = () => {
                    const option = proveedorResultadosEl.selectedOptions?.[0];
                    if (!option || !option.value) {
                        return;
                    }

                    seleccionarProveedor(option.value, option.text || "", {
                        tipoDocumento: option.getAttribute("data-tipo-documento") || "",
                        numeroDocumento: option.getAttribute("data-numero-documento") || "",
                        nombre: option.getAttribute("data-nombre") || "",
                        numero: option.getAttribute("data-numero") || "",
                        correo: option.getAttribute("data-correo") || ""
                    });
                };

                proveedorResultadosEl.addEventListener("change", sincronizarProveedorDesdeSelect);
                proveedorResultadosEl.addEventListener("dblclick", sincronizarProveedorDesdeSelect);
                proveedorResultadosEl.addEventListener("keydown", (event) => {
                    if (event.key !== "Enter") {
                        return;
                    }

                    event.preventDefault();
                    sincronizarProveedorDesdeSelect();
                });
            }

            if (btnNuevoProveedorEl && proveedorRapidoModal) {
                btnNuevoProveedorEl.addEventListener("click", () => {
                    limpiarProveedorRapidoError();
                    proveedorRapidoFormEl?.reset();
                    if (proveedorRapidoTipoPersonaEl) {
                        proveedorRapidoTipoPersonaEl.value = "";
                    }
                    if (proveedorRapidoTipoDocumentoEl) {
                        proveedorRapidoTipoDocumentoEl.value = "";
                    }
                    actualizarFormularioProveedorRapido();
                    proveedorRapidoModal.show();
                });
            }

            proveedorRapidoTipoPersonaEl?.addEventListener("change", actualizarFormularioProveedorRapido);
            actualizarFormularioProveedorRapido();

            proveedorRapidoFormEl?.addEventListener("submit", async (event) => {
                event.preventDefault();
                limpiarProveedorRapidoError();

                const payload = {
                    tipoPersona: String(proveedorRapidoTipoPersonaEl?.value || ""),
                    tipoDocumento: String(proveedorRapidoTipoDocumentoEl?.value || ""),
                    numeroDocumento: String(proveedorRapidoNumeroDocumentoEl?.value || ""),
                    razonSocial: String(proveedorRapidoRazonSocialEl?.value || ""),
                    nombres: String(proveedorRapidoNombresEl?.value || ""),
                    apellidos: String(proveedorRapidoApellidosEl?.value || "")
                };

                if (proveedorRapidoGuardarEl) {
                    proveedorRapidoGuardarEl.disabled = true;
                }

                try {
                    const response = await fetch(crearProveedorRapidoUrl, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify(payload)
                    });
                    const responseText = await response.text();
                    let data = null;
                    try {
                        data = responseText ? JSON.parse(responseText) : null;
                    } catch {
                        throw new Error(responseText || "No se pudo registrar el proveedor.");
                    }

                    if (!response.ok || !data.ok) {
                        throw new Error(data.mensaje || "No se pudo registrar el proveedor.");
                    }

                    await recargarProveedores("", String(data.proveedorId || ""));
                    if (data.proveedorId) {
                        seleccionarProveedor(String(data.proveedorId), String(data.proveedorTexto || ""), {
                            tipoDocumento: String(data.tipoDocumento || ""),
                            numeroDocumento: String(data.numeroDocumento || ""),
                            nombre: String(data.nombre || ""),
                            numero: String(data.numero || ""),
                            correo: String(data.correo || "")
                        });
                    }
                    proveedorRapidoModal.hide();
                } catch (error) {
                    mostrarProveedorRapidoError(error?.message || "No se pudo registrar el proveedor.");
                } finally {
                    if (proveedorRapidoGuardarEl) {
                        proveedorRapidoGuardarEl.disabled = false;
                    }
                }
            });

        })();
    </script>
}
