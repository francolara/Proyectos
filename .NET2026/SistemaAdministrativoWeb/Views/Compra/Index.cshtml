@* Firma: FRANCO LARA - 24/06/2026 | Mantiene Estado como Provisionado en provisiones de compra y agrega la columna Situacion segun saldo pendiente. *@

@model SistemaAdministrativoWeb.ViewModels.Contabilidad.CompraIndexViewModel

@{
    ViewData["Title"] = "Compras";
    ViewData["AdminShell"] = true;
    var paginaInicio = Math.Max(1, Model.Paginacion.PaginaActual - 2);
    var paginaFin = Math.Min(Model.Paginacion.TotalPaginas, Model.Paginacion.PaginaActual + 2);
    var textInfo = System.Globalization.CultureInfo.CurrentCulture.TextInfo;
}

<section class="dashboard-shell">
    <section class="dashboard-metrics">
        <article class="dashboard-metric-card dashboard-metric-card-count">
            <span>Total compras</span>
            <strong>@Model.TotalCompras</strong>
            <small>Registros visibles para la consulta actual.</small>
        </article>
        <article class="dashboard-metric-card dashboard-metric-card-amount">
            <span>Total provisionado</span>
            <div class="dashboard-metric-amounts">
                <div class="dashboard-metric-amount-line">
                    <label>Total soles</label>
                    <strong>@Model.TotalImporteSolesPeriodo.ToString("0.00")</strong>
                </div>
                <div class="dashboard-metric-amount-line">
                    <label>Total dolares</label>
                    <strong>@Model.TotalImporteDolaresPeriodo.ToString("0.00")</strong>
                </div>
            </div>
            <small>Totales visibles separados por moneda.</small>
        </article>
        <article class="dashboard-metric-card dashboard-metric-card-count">
            <span>Configuraciones COM</span>
            <strong>@Model.ConfiguracionesCompra.Count</strong>
            <small>Escenarios disponibles para asiento automatico.</small>
        </article>
    </section>

    <section class="workspace-window">
        <div class="workspace-window-head">
            <div>
                <span class="workspace-window-kicker">Consulta</span>
                <h1>Compras del periodo</h1>
                <p>Consulta provisiones registradas y reabre el documento para ajuste o revision.</p>
            </div>
            <div class="workspace-row-actions">
                <a asp-action="Registrar" asp-route-periodo="@Model.PeriodoConsulta" class="btn btn-light btn-sm">Registrar compra</a>
            </div>
        </div>
        <div class="workspace-window-body">
            @if (TempData["CompraOk"] is string ok)
            {
                <div class="alert alert-success">@ok</div>
            }
            @if (TempData["CompraError"] is string error)
            {
                <div class="alert alert-danger">@error</div>
            }

            <form asp-action="Index" method="get" class="workspace-filter-card">
                <div class="workspace-filter-grid">
                    <div class="workspace-field">
                        <label class="form-label" for="anio">Año</label>
                        <select id="anio" name="anio" class="form-select">
                            @foreach (var anio in Model.AniosDisponibles)
                            {
                                <option value="@anio" selected="@(anio == Model.AnioSeleccionado)">@anio</option>
                            }
                        </select>
                    </div>
                    <div class="workspace-field">
                        <label class="form-label" for="mes">Mes</label>
                        <select id="mes" name="mes" class="form-select">
                            @foreach (var mes in Model.MesesDisponibles)
                            {
                                <option value="@mes.Valor" selected="@(mes.Valor == Model.MesSeleccionado)">@textInfo.ToTitleCase(mes.Nombre)</option>
                            }
                        </select>
                    </div>
                    <div class="workspace-field workspace-field-span-2">
                        <label class="form-label" for="textoBusqueda">Buscar compra</label>
                        <input id="textoBusqueda" name="textoBusqueda" value="@Model.TextoBusqueda" class="form-control" placeholder="Proveedor, documento, escenario u observacion" />
                    </div>
                </div>
                <div class="workspace-actions">
                    <button type="submit" class="btn btn-primary">Consultar</button>
                </div>
            </form>

            <div class="table-responsive workspace-table-wrap">
                <table class="table align-middle app-table workspace-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Proveedor</th>
                            <th>Documento</th>
                            <th>Escenario</th>
                            <th>Moneda</th>
                            <th>Total</th>
                            <th>Saldo</th>
                            <th>Asiento</th>
                            <th>Estado</th>
                            <th>Situacion</th>
                            <th class="text-end">Accion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Compras.Count == 0)
                        {
                            <tr>
                                <td colspan="11">
                                    <div class="app-empty-state app-empty-state-inline">
                                        <i class="bi bi-cart-check"></i>
                                        <div>
                                            <strong>No hay compras para la consulta actual</strong>
                                            <p>Ajusta el periodo o registra la primera provision usando la configuracion contable.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var compra in Model.Compras)
                            {
                                <tr class="workspace-clickable-row" data-edit-url="@Url.Action("Editar", new { periodo = Model.PeriodoConsulta, idCompra = compra.IdCompra })">
                                    <td>@compra.FechaEmision.ToString("dd/MM/yyyy")</td>
                                    <td>@compra.NombreProveedor</td>
                                    <td>@compra.Documento</td>
                                    <td>@compra.EscenarioOperacion</td>
                                    <td>@compra.CodigoMoneda</td>
                                    <td>@compra.ImporteTotal.ToString("0.00")</td>
                                    <td>@compra.Saldo.ToString("0.00")</td>
                                    <td>@(compra.IdAsiento?.ToString() ?? "-")</td>
                                    <td><span class="workspace-status-badge is-active">@compra.Estado</span></td>
                                    <td><span class="workspace-status-badge">@compra.Situacion</span></td>
                                    <td class="text-end">
                                        <div class="workspace-row-actions-compact">
                                            <a asp-action="Editar" asp-route-periodo="@Model.PeriodoConsulta" asp-route-idCompra="@compra.IdCompra" class="workspace-row-btn workspace-row-btn-primary">Editar</a>
                                            <form asp-action="Eliminar" method="post" onsubmit="return confirm('Se eliminara la compra seleccionada. ¿Desea continuar?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idCompra" value="@compra.IdCompra" />
                                                <input type="hidden" name="anio" value="@Model.AnioSeleccionado" />
                                                <input type="hidden" name="mes" value="@Model.MesSeleccionado" />
                                                <input type="hidden" name="textoBusqueda" value="@Model.TextoBusqueda" />
                                                <input type="hidden" name="pagina" value="@Model.Paginacion.PaginaActual" />
                                                <button type="submit" class="workspace-row-btn workspace-row-btn-danger">Eliminar</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Paginacion.TotalPaginas > 1)
            {
                <nav class="workspace-pagination" aria-label="Paginacion compras">
                    <a class="btn btn-outline-secondary @(Model.Paginacion.TienePaginaAnterior ? string.Empty : "disabled")"
                       asp-action="Index"
                       asp-route-anio="@Model.AnioSeleccionado"
                       asp-route-mes="@Model.MesSeleccionado"
                       asp-route-textoBusqueda="@Model.TextoBusqueda"
                       asp-route-pagina="@(Model.Paginacion.PaginaActual - 1)">Anterior</a>

                    @for (var pagina = paginaInicio; pagina <= paginaFin; pagina++)
                    {
                        <a class="btn @(pagina == Model.Paginacion.PaginaActual ? "btn-primary" : "btn-outline-secondary")"
                           asp-action="Index"
                           asp-route-anio="@Model.AnioSeleccionado"
                           asp-route-mes="@Model.MesSeleccionado"
                           asp-route-textoBusqueda="@Model.TextoBusqueda"
                           asp-route-pagina="@pagina">@pagina</a>
                    }

                    <a class="btn btn-outline-secondary @(Model.Paginacion.TienePaginaSiguiente ? string.Empty : "disabled")"
                       asp-action="Index"
                       asp-route-anio="@Model.AnioSeleccionado"
                       asp-route-mes="@Model.MesSeleccionado"
                       asp-route-textoBusqueda="@Model.TextoBusqueda"
                       asp-route-pagina="@(Model.Paginacion.PaginaActual + 1)">Siguiente</a>
                </nav>
            }
        </div>
    </section>
</section>
