@using FralseTech.Web.ViewModels
@{
    var pageTitle = ViewData["Title"] as string ?? FralseTechSiteContent.GetDefaultPageTitle();
    var metaDescription = ViewData["MetaDescription"] as string ?? FralseTechSiteContent.GetDefaultMetaDescription();
    var canonicalUrl = ViewData["CanonicalUrl"] as string ?? FralseTechSiteContent.GetDefaultCanonicalUrl();
    var structuredDataJson = ViewData["StructuredDataJson"] as string ?? FralseTechSiteContent.GetStructuredDataJson();
    var landingPage = Model as LandingPageViewModel ?? FralseTechSiteContent.BuildLandingPage();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@metaDescription" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="https://fralsetech.com/images/logo-fralse-tech.png" />
    <meta property="og:locale" content="es_PE" />
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/favicon.ico")" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script type="application/ld+json">@Html.Raw(structuredDataJson)</script>
</head>
<body>
    <a class="skip-link" href="#inicio">Ir al contenido principal</a>

    <header class="site-header" data-header>
        <div class="section-container site-header__inner">
            <a class="brand" href="#inicio" aria-label="Ir al inicio de FRALSE TECH">
                <img src="@Url.Content(landingPage.LogoPath)" alt="Logo de @landingPage.LegalName" width="500" height="236" />
            </a>
            <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Abrir menú" data-menu-toggle>
                <span></span>
                <span></span>
                <span></span>
            </button>
            <nav class="site-nav" id="site-navigation" aria-label="Principal" data-navigation>
                @foreach (var item in landingPage.Navigation)
                {
                    <a href="@item.Target">@item.Text</a>
                }
                <a class="btn btn-header" href="#contacto">Contáctanos</a>
            </nav>
        </div>
    </header>

    @RenderBody()

    <a class="whatsapp-float" href="@landingPage.WhatsAppUrl" target="_blank" rel="noreferrer" aria-label="Abrir conversación de WhatsApp">
        <i class="bi bi-whatsapp" aria-hidden="true"></i>
        <span>Escríbenos</span>
    </a>

    <footer class="site-footer">
        <div class="section-container site-footer__grid">
            <div>
                <img class="site-footer__logo" src="@Url.Content(landingPage.LogoPath)" alt="Logo de @landingPage.LegalName" width="500" height="236" loading="lazy" />
                <p>@landingPage.LegalName desarrolla tecnología para impulsar empresas.</p>
                <p class="site-footer__tax-id">RUC : @landingPage.TaxId</p>
            </div>
            <div>
                <h2>Enlaces rápidos</h2>
                @foreach (var item in landingPage.Navigation)
                {
                    <a href="@item.Target">@item.Text</a>
                }
            </div>
            <div>
                <h2>Sistemas</h2>
                @foreach (var product in landingPage.Products)
                {
                    <a href="@product.PrimaryActionUrl" target="_blank" rel="noreferrer">@product.Name</a>
                }
            </div>
            <div>
                <h2>Contacto</h2>
                <a href="@landingPage.MailToUrl">@landingPage.Email</a>
                <a href="@landingPage.WhatsAppUrl" target="_blank" rel="noreferrer">@landingPage.WhatsAppNumber</a>
                <span>@landingPage.Country</span>
            </div>
        </div>
        <div class="section-container site-footer__bottom">
            <span>© @landingPage.CurrentYear @landingPage.LegalName. Todos los derechos reservados.</span>
            <span>Desarrollamos tecnología para impulsar empresas.</span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
