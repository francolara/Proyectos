@model FralseTech.Web.ViewModels.LandingPageViewModel
@* Firma: FRANCO LARA - 18/09/2026 | Rediseña la página principal con composición tecnológica, productos editoriales y respuesta móvil prioritaria. *@
@{
    ViewData["Title"] = Model.PageTitle;
    ViewData["MetaDescription"] = Model.MetaDescription;
    ViewData["CanonicalUrl"] = Model.CanonicalUrl;
    ViewData["StructuredDataJson"] = Model.StructuredDataJson;
}

<main>
    <section class="hero" id="inicio" aria-labelledby="hero-title">
        <img class="hero__image" src="@Model.HeroImageUrl" alt="Oficina tecnológica de FRALSE TECH" width="1664" height="944" fetchpriority="high" />
        <div class="hero__veil"></div>
        <div class="site-container hero__content">
            <p class="kicker"><span></span>@Model.HeaderTagline</p>
            <h1 id="hero-title">Convertimos<br /><em>operaciones</em> en<br />ventaja digital.</h1>
            <p class="hero__summary">@Model.HeroDescription</p>
            <div class="hero__actions">
                <a class="button button--primary" href="@Model.HeroPrimaryActionTarget">@Model.HeroPrimaryActionText <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                <a class="text-action" href="@Model.HeroSecondaryActionTarget">@Model.HeroSecondaryActionText <i class="bi bi-arrow-down-right" aria-hidden="true"></i></a>
            </div>
        </div>
        <div class="hero__rail" aria-hidden="true"><span>FRALSE TECH · SOFTWARE EMPRESARIAL</span><span>PERÚ · 2026</span></div>
    </section>

    <section class="intro section" id="nosotros">
        <div class="site-container intro__grid">
            <p class="section-label reveal">01 / Nosotros</p>
            <div class="intro__statement reveal">
                <h2>Software con propósito: <span>hacer que tu empresa avance sin fricción.</span></h2>
                <p>FRALSE TECH S.A.C. crea herramientas modernas para empresas que buscan orden, velocidad y visibilidad en cada proceso.</p>
                <a class="text-action" href="#contacto">Conoce al equipo <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
            </div>
        </div>
        <div class="site-container capability-strip" aria-label="Capacidades de FRALSE TECH">
            @foreach (var pill in Model.HeroPills)
            {
                <div class="capability-strip__item reveal"><i class="@pill.IconClass" aria-hidden="true"></i><span>@pill.Text</span></div>
            }
        </div>
    </section>

    <section class="services section" id="servicios">
        <div class="site-container services__header">
            <p class="section-label reveal">02 / Servicios</p>
            <div class="reveal"><h2>Una base tecnológica<br />que trabaja contigo.</h2><p>De la idea al uso cotidiano, diseñamos productos útiles y preparados para evolucionar.</p></div>
        </div>
        <div class="site-container service-list">
            @for (var index = 0; index < Model.Services.Count; index++)
            {
                var service = Model.Services[index];
                <article class="service-row reveal">
                    <span class="service-row__number">@((index + 1).ToString("00"))</span>
                    <i class="@service.IconClass" aria-hidden="true"></i>
                    <h3>@service.Title</h3>
                    <p>@service.Description</p>
                    <i class="bi bi-arrow-up-right service-row__arrow" aria-hidden="true"></i>
                </article>
            }
        </div>
    </section>

    <section class="products section" id="productos">
        <div class="site-container products__header">
            <p class="section-label reveal">03 / Sistemas</p>
            <div class="reveal"><h2>Productos hechos para<br /><span>la operación real.</span></h2></div>
        </div>
        <div class="site-container product-list">
            @for (var index = 0; index < Model.Products.Count; index++)
            {
                var product = Model.Products[index];
                <article class="product-showcase @product.AccentClass reveal">
                    <div class="product-showcase__copy">
                        <div class="product-showcase__meta"><span>@((index + 1).ToString("00")) / @product.Category</span><span class="availability"><i></i>@product.Status</span></div>
                        <div class="product-showcase__title"><i class="@product.IconClass" aria-hidden="true"></i><h3>@product.Name</h3></div>
                        <p>@product.Description</p>
                        <ul>
                            @foreach (var feature in product.Features.Take(4))
                            {
                                <li><i class="bi bi-check2" aria-hidden="true"></i>@feature</li>
                            }
                        </ul>
                        <div class="product-showcase__actions">
                            <a class="button button--dark" href="@product.PrimaryActionUrl" target="_blank" rel="noreferrer">@product.PrimaryActionText <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                            <a class="text-action" href="@product.SecondaryActionUrl" target="_blank" rel="noreferrer">@product.SecondaryActionText</a>
                        </div>
                    </div>
                    <figure class="product-showcase__visual">
                        <span class="product-showcase__glow" aria-hidden="true"></span>
                        <img src="@product.ImageUrl" alt="@product.ImageAlt" width="1200" height="900" loading="lazy" decoding="async" />
                    </figure>
                </article>
            }
        </div>
    </section>

    <section class="reasons section" id="ventajas">
        <div class="site-container reasons__grid">
            <div class="reveal"><p class="section-label">04 / Forma de trabajar</p><h2>Claros en la estrategia. Cercanos en la ejecución.</h2></div>
            <div class="reason-list">
                @foreach (var advantage in Model.Advantages)
                {
                    <article class="reason reveal"><span>@advantage.Indicator</span><h3>@advantage.Title</h3><p>@advantage.Description</p></article>
                }
            </div>
        </div>
    </section>

    <section class="contact section" id="contacto">
        <div class="site-container contact__inner reveal">
            <p class="section-label">05 / Contacto</p>
            <h2>@Model.CallToActionTitle</h2>
            <p>@Model.CallToActionText</p>
            <div class="contact__actions">
                <a class="button button--light" href="@Model.WhatsAppUrl" target="_blank" rel="noreferrer"><i class="bi bi-whatsapp" aria-hidden="true"></i> Hablemos por WhatsApp</a>
                <a class="contact__email" href="@Model.MailToUrl">@Model.Email <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
            </div>
        </div>
    </section>
</main>
