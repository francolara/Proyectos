@page
@model SistemaAdministrativoWeb.Areas.Identity.Pages.Account.ResetPasswordModel
@using SistemaAdministrativoWeb.Infrastructure.Assets
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@* Firma: FRANCO LARA - 31/08/2026 | Restablece la contrasena con banner remoto versionado, visores de clave y regla visible de complejidad. *@
@{
    ViewData["Title"] = "Restablecer contrasena";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var loginBannerUrl = PublicAssetUrlBuilder.Build(Configuration, "Banner/InicioSesion.webp");
}

<section class="auth-shell">
    <aside class="auth-visual @(!string.IsNullOrWhiteSpace(loginBannerUrl) ? "auth-visual-banner" : string.Empty)"
           style="@(!string.IsNullOrWhiteSpace(loginBannerUrl) ? $"background-image: url('{loginBannerUrl}');" : string.Empty)"
           role="@(!string.IsNullOrWhiteSpace(loginBannerUrl) ? "img" : null)"
           aria-label="@(!string.IsNullOrWhiteSpace(loginBannerUrl) ? "FralseCont: inicia sesion y gestiona tu empresa con confianza." : null)">
        @if (string.IsNullOrWhiteSpace(loginBannerUrl))
        {
            <div class="auth-visual-content">
                <p class="auth-visual-tag">Nueva credencial</p>
                <h2>Crea una contrasena robusta para proteger tu informacion.</h2>
                <ul class="auth-visual-list">
                    <li>Combina mayusculas, minusculas, numeros y simbolos.</li>
                    <li>No reutilices contrasenas de otros servicios.</li>
                </ul>
            </div>
        }
    </aside>
    <section class="auth-panel">
        <div class="auth-card">
            <h1>Restablecer contrasena</h1>
            <p class="auth-subtitle">Define la nueva contrasena para tu cuenta.</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input asp-for="Input.Code" type="hidden" />
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Correo electronico</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" readonly />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Nueva contrasena</label>
                    <div class="auth-password-field">
                        <input asp-for="Input.Password" class="form-control pe-5" autocomplete="new-password" />
                        <button type="button"
                                class="auth-password-toggle"
                                data-password-toggle
                                data-password-target="Input_Password"
                                aria-label="Mostrar contrasena"
                                aria-pressed="false">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <div class="form-text">Debe tener minimo 6 caracteres e incluir mayuscula, minuscula, numero y caracter especial.</div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar contrasena</label>
                    <div class="auth-password-field">
                        <input asp-for="Input.ConfirmPassword" class="form-control pe-5" autocomplete="new-password" />
                        <button type="button"
                                class="auth-password-toggle"
                                data-password-toggle
                                data-password-target="Input_ConfirmPassword"
                                aria-label="Mostrar contrasena"
                                aria-pressed="false">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-primary auth-cta">Guardar nueva contrasena</button>
            </form>
        </div>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
