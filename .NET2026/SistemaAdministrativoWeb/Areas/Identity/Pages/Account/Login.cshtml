@page
@model SistemaAdministrativoWeb.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Iniciar sesion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="auth-shell">
    <aside class="auth-visual">
        <div class="auth-visual-content">
            <p class="auth-visual-tag">SisAdm</p>
            <h2>Control contable, comercial y multiempresa desde una sola sesion.</h2>
            <ul class="auth-visual-list">
                <li>Seleccion de empresa activa por usuario.</li>
                <li>Acceso preparado para panel administrativo y superadmin.</li>
                <li>Base unica SQL Server para crecer por modulos.</li>
            </ul>
        </div>
    </aside>

    <section class="auth-panel">
        <div class="auth-card">
            <h1>Iniciar sesion</h1>
            <p class="auth-subtitle">Ingresa con tu cuenta para acceder a tu empresa o al panel superadmin.</p>

            <form id="account" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Correo electronico</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Contrasena</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label">Recordarme</label>
                </div>

                @if (Model.MostrarTurnstile)
                {
                    <div class="mb-3">
                        <div class="cf-turnstile" data-sitekey="@Model.TurnstileSiteKey"></div>
                    </div>
                }

                <button id="login-submit" type="submit" class="w-100 btn btn-primary auth-cta">Ingresar al sistema</button>

                @if (Model.ExternalLogins.Count > 0)
                {
                    <div class="mt-3">
                        @foreach (var provider in Model.ExternalLogins)
                        {
                            <button type="submit"
                                    class="w-100 btn btn-outline-dark auth-cta mt-2"
                                    asp-page-handler="ExternalLogin"
                                    asp-route-provider="@provider.Name"
                                    asp-route-returnUrl="@Model.ReturnUrl"
                                    asp-route-flow="login">
                                <span class="d-inline-flex align-items-center justify-content-center gap-2">
                                    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google" width="18" height="18" />
                                    <span>Continuar con @provider.DisplayName</span>
                                </span>
                            </button>
                        }
                    </div>
                }

                <div class="auth-foot-links auth-foot-links-pro">
                    <a asp-page="./Register">Registrar usuario o negocio</a>
                    <a asp-controller="Home" asp-action="Index">Volver al inicio</a>
                </div>
            </form>
        </div>
    </section>
</section>

@section Scripts {
    @if (Model.MostrarTurnstile)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
    <partial name="_ValidationScriptsPartial" />
}
