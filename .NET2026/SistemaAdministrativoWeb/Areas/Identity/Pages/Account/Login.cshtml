@page
@model SistemaAdministrativoWeb.Areas.Identity.Pages.Account.LoginModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@* Firma: FRANCO LARA - 13/07/2026 | Agrega respaldo de captcha manual en login y prepara la derivacion al flujo de verificacion y cambio obligatorio para usuarios con contrasena temporal. *@
@* Firma: FRANCO LARA - 14/07/2026 | Centra los enlaces inferiores del login y corrige Volver al inicio para redirigir al Home fuera del area Identity. *@
@* Firma: FRANCO LARA - 22/07/2026 | Agrega el control accesible para mostrar u ocultar la contrasena durante el inicio de sesion. *@
@* Firma: FRANCO LARA - 25/07/2026 | Muestra y centra sin recortes el banner de inicio de sesion desde el bucket Cloudflare configurado, siguiendo la proporcion 4:5 del proyecto deportivo y conservando el contenido anterior como respaldo. *@
@* Firma: FRANCO LARA - 26/08/2026 | Lee la ubicacion publica de recursos desde la seccion local y variable de entorno identificada con el prefijo FRALSECONT_. *@
@{
    ViewData["Title"] = "Iniciar sesion";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var publicAssetBaseUrl = Configuration["FRALSECONT_SedeImagenStorage:PublicBaseUrl"]?.Trim().TrimEnd('/');
    var loginBannerUrl = string.IsNullOrWhiteSpace(publicAssetBaseUrl)
        ? string.Empty
        : $"{publicAssetBaseUrl}/Banner/InicioSesion.webp";
}

<section class="auth-shell">
    <aside class="auth-visual @(!string.IsNullOrWhiteSpace(loginBannerUrl) ? "auth-visual-banner" : string.Empty)"
           style="@(!string.IsNullOrWhiteSpace(loginBannerUrl) ? $"background-image: url('{loginBannerUrl}');" : string.Empty)"
           role="@(!string.IsNullOrWhiteSpace(loginBannerUrl) ? "img" : null)"
           aria-label="@(!string.IsNullOrWhiteSpace(loginBannerUrl) ? "FralseCont: inicia sesion y gestiona tu empresa con confianza." : null)">
        @if (string.IsNullOrWhiteSpace(loginBannerUrl))
        {
            <div class="auth-visual-content">
                <p class="auth-visual-tag">SisAdm</p>
                <h2>Control contable, comercial y multiempresa desde una sola sesion.</h2>
                <ul class="auth-visual-list">
                    <li>Seleccion de empresa activa por usuario.</li>
                    <li>Acceso preparado para panel administrativo y superadmin.</li>
                    <li>Base unica SQL Server para crecer por modulos.</li>
                </ul>
            </div>
        }
    </aside>

    <section class="auth-panel">
        <div class="auth-card">
            <h1>Iniciar sesion</h1>
            <p class="auth-subtitle">Ingresa con tu cuenta para acceder a tu empresa o al panel superadmin.</p>

            <form id="account" method="post">
                <input asp-for="UsarCaptchaManual" type="hidden" id="UsarCaptchaManualLogin" />
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Correo electronico</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Contrasena</label>
                    <div class="auth-password-field">
                        <input asp-for="Input.Password" class="form-control pe-5" autocomplete="current-password" />
                        <button type="button"
                                class="auth-password-toggle"
                                data-password-toggle
                                data-password-target="Input_Password"
                                aria-label="Mostrar contrasena"
                                aria-pressed="false">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label">Recordarme</label>
                </div>

                @if (Model.MostrarTurnstile && !Model.MostrarCaptchaManual)
                {
                    <div class="mb-3">
                        <div class="cf-turnstile" data-sitekey="@Model.TurnstileSiteKey"></div>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm mb-3" data-manual-captcha-trigger="UsarCaptchaManualLogin">Usar captcha manual de respaldo</button>
                }

                @if (Model.MostrarCaptchaManual)
                {
                    <div class="auth-manual-captcha mb-3">
                        <label asp-for="CaptchaManual" class="form-label">Captcha manual de respaldo</label>
                        <div class="auth-manual-captcha-code" aria-label="Codigo captcha">@Model.CaptchaManualCodigo</div>
                        <input asp-for="CaptchaManual" class="form-control mt-2" autocomplete="off" spellcheck="false" placeholder="Escribe el codigo mostrado" />
                        <span asp-validation-for="CaptchaManual" class="text-danger"></span>
                        <div class="form-text">Usa este respaldo si la verificacion automatica falla.</div>
                    </div>
                }

                <button id="login-submit" type="submit" class="w-100 btn btn-primary auth-cta">Ingresar al sistema</button>

                @if (Model.ExternalLogins.Count > 0)
                {
                    <div class="mt-3">
                        @foreach (var provider in Model.ExternalLogins)
                        {
                            <button type="submit"
                                    class="w-100 btn btn-outline-dark auth-cta mt-2"
                                    asp-page-handler="ExternalLogin"
                                    asp-route-provider="@provider.Name"
                                    asp-route-returnUrl="@Model.ReturnUrl"
                                    asp-route-flow="login">
                                <span class="d-inline-flex align-items-center justify-content-center gap-2">
                                    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google" width="18" height="18" />
                                    <span>Continuar con @provider.DisplayName</span>
                                </span>
                            </button>
                        }
                    </div>
                }

                <div class="auth-foot-links auth-foot-links-pro auth-foot-links-centered">
                    <a asp-page="./Register">Registrar usuario</a>
                    <a asp-area="" asp-controller="Home" asp-action="Index">Volver al inicio</a>
                </div>
            </form>
        </div>
    </section>
</section>

@section Scripts {
    @if (Model.MostrarTurnstile && !Model.MostrarCaptchaManual)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            document.querySelectorAll("[data-manual-captcha-trigger]").forEach((button) => {
                button.addEventListener("click", () => {
                    const targetId = button.getAttribute("data-manual-captcha-trigger");
                    const hidden = targetId ? document.getElementById(targetId) : null;
                    if (!hidden) {
                        return;
                    }

                    hidden.value = "true";
                    button.closest("form")?.submit();
                });
            });
        })();
    </script>
}
