@page
@model SistemaAdministrativoWeb.Areas.Identity.Pages.Account.ForgotPasswordModel
@using SistemaAdministrativoWeb.Infrastructure.Assets
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@* Firma: FRANCO LARA - 31/08/2026 | Agrega recuperacion segura con version global para evitar cache obsoleta en recursos remotos y conserva el respaldo visual. *@
@{
    ViewData["Title"] = "Recuperar contrasena";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var loginBannerUrl = PublicAssetUrlBuilder.Build(Configuration, "Banner/InicioSesion.webp");
}

<section class="auth-shell">
    <aside class="auth-visual @(!string.IsNullOrWhiteSpace(loginBannerUrl) ? "auth-visual-banner" : string.Empty)"
           style="@(!string.IsNullOrWhiteSpace(loginBannerUrl) ? $"background-image: url('{loginBannerUrl}');" : string.Empty)"
           role="@(!string.IsNullOrWhiteSpace(loginBannerUrl) ? "img" : null)"
           aria-label="@(!string.IsNullOrWhiteSpace(loginBannerUrl) ? "FralseCont: inicia sesion y gestiona tu empresa con confianza." : null)">
        @if (string.IsNullOrWhiteSpace(loginBannerUrl))
        {
            <div class="auth-visual-content">
                <p class="auth-visual-tag">Seguridad</p>
                <h2>Recupera el acceso a tu cuenta de forma segura.</h2>
                <ul class="auth-visual-list">
                    <li>El enlace se envia solamente al correo registrado.</li>
                    <li>El codigo es personal y de un solo uso.</li>
                    <li>FralseCont nunca solicita tu contrasena por correo.</li>
                </ul>
            </div>
        }
    </aside>

    <section class="auth-panel">
        <div class="auth-card">
            <h1>Recuperar contrasena</h1>
            <p class="auth-subtitle">Ingresa tu correo y te enviaremos las instrucciones para continuar.</p>

            @if (!Model.EmailsEnabled)
            {
                <div class="alert alert-warning">La recuperacion por correo no esta disponible temporalmente.</div>
                <div class="auth-foot-links auth-foot-links-pro auth-foot-links-centered">
                    <a asp-page="./Login">Volver al inicio de sesion</a>
                </div>
            }
            else
            {
                <form method="post">
                    <input asp-for="UsarCaptchaManual" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Correo electronico</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    @if (Model.MostrarTurnstile && !Model.MostrarCaptchaManual)
                    {
                        <div class="mb-3">
                            <div class="cf-turnstile" data-sitekey="@Model.TurnstileSiteKey"></div>
                        </div>
                    }

                    @if (Model.MostrarCaptchaManual)
                    {
                        <div class="auth-manual-captcha mb-3">
                            <label asp-for="CaptchaManual" class="form-label">Captcha manual de respaldo</label>
                            <div class="auth-manual-captcha-code" aria-label="Codigo captcha">@Model.CaptchaManualCodigo</div>
                            <input asp-for="CaptchaManual" class="form-control mt-2" autocomplete="off" spellcheck="false" />
                            <span asp-validation-for="CaptchaManual" class="text-danger"></span>
                        </div>
                    }

                    <button type="submit" class="w-100 btn btn-primary auth-cta">Enviar instrucciones</button>
                    <div class="auth-foot-links auth-foot-links-pro auth-foot-links-centered">
                        <a asp-page="./Login">Volver al inicio de sesion</a>
                    </div>
                </form>
            }
        </div>
    </section>
</section>

@section Scripts {
    @if (Model.MostrarTurnstile && !Model.MostrarCaptchaManual)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
    <partial name="_ValidationScriptsPartial" />
}
