@page
@model SistemaAdministrativoWeb.Areas.Identity.Pages.Account.RegisterModel
@using SistemaAdministrativoWeb.Infrastructure.Assets
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@* Firma: FRANCO LARA - 09/07/2026 | Agrega control visual para mostrar u ocultar la contrasena y confirmar contrasena en el registro de usuarios. *@
@* Firma: FRANCO LARA - 10/07/2026 | Muestra el plan comercial recibido desde la landing publica, conserva el parametro de registro durante el alta del usuario y mejora la presentacion del formulario evitando autocompletar correo y contrasena en la apertura inicial. *@
@* Firma: FRANCO LARA - 13/07/2026 | Agrega captcha manual de respaldo para el registro cuando la verificacion automatica de Turnstile no se encuentra disponible. *@
@* Firma: FRANCO LARA - 14/07/2026 | Retira la activacion manual del captcha de respaldo en registro para que solo se muestre cuando Turnstile no este disponible o falle durante la validacion. *@
@* Firma: FRANCO LARA - 25/07/2026 | Corrige Volver al inicio para salir explicitamente del area Identity y centra sin recortes el banner de registro desde Cloudflare con proporcion 4:5, conservando el contenido anterior como respaldo. *@
@* Firma: FRANCO LARA - 26/08/2026 | Lee la ubicacion publica de recursos desde la seccion local y variable de entorno identificada con el prefijo FRALSECONT_. *@
@* Firma: FRANCO LARA - 29/08/2026 | Activa automaticamente el captcha de respaldo cuando Turnstile reporta error o tiempo agotado. *@
@* Firma: FRANCO LARA - 31/08/2026 | Hace visibles los errores, muestra el procesamiento y versiona los recursos remotos para evitar cache obsoleta. *@
@{
    ViewData["Title"] = "Crear cuenta";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var registerBannerUrl = PublicAssetUrlBuilder.Build(Configuration, "Banner/Registro.webp");
}

<section class="auth-shell">
    <aside class="auth-visual @(!string.IsNullOrWhiteSpace(registerBannerUrl) ? "auth-visual-banner" : string.Empty)"
           style="@(!string.IsNullOrWhiteSpace(registerBannerUrl) ? $"background-image: url('{registerBannerUrl}');" : string.Empty)"
           role="@(!string.IsNullOrWhiteSpace(registerBannerUrl) ? "img" : null)"
           aria-label="@(!string.IsNullOrWhiteSpace(registerBannerUrl) ? "FralseCont: crea tu cuenta y empieza a ordenar tu empresa." : null)">
        @if (string.IsNullOrWhiteSpace(registerBannerUrl))
        {
            <div class="auth-visual-content">
                <p class="auth-visual-tag">Onboarding</p>
                <h2>Registra tu usuario y deja lista la cuenta para vincular una o varias empresas.</h2>
                <ul class="auth-visual-list">
                    <li>Acceso personal para contadores y administradores.</li>
                    <li>La empresa se vinculara despues desde el flujo administrativo.</li>
                    <li>Base lista para que superadmin gestione contrato y vigencia.</li>
                </ul>
            </div>
        }
    </aside>

    <section class="auth-panel">
        <div class="auth-card">
            <h1>Crear una cuenta</h1>
            <p class="auth-subtitle">Registra un usuario para ingresar a la plataforma y luego vincular sus empresas.</p>

            @if (!string.IsNullOrWhiteSpace(Model.Plan))
            {
                <div class="auth-plan-chip" role="status" aria-live="polite">
                    <strong>Plan seleccionado: @Model.ObtenerNombrePlanSeleccionado()</strong>
                    <span>@Model.ObtenerResumenPlanSeleccionado()</span>
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All"
                     class="alert alert-danger mb-3"
                     id="registerValidationSummary"
                     role="alert"
                     tabindex="-1"></div>
            }

            <form method="post" id="registerForm" autocomplete="off" data-clear-sensitive-fields="@Model.LimpiarCamposIniciales.ToString().ToLowerInvariant()">
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="Plan" />
                <input asp-for="UsarCaptchaManual" type="hidden" id="UsarCaptchaManualRegister" />

                <div class="mb-3">
                    <label asp-for="Usuario.NombreCompleto" class="form-label">Nombre completo</label>
                    <input asp-for="Usuario.NombreCompleto" class="form-control" />
                    <span asp-validation-for="Usuario.NombreCompleto" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Usuario.Telefono" class="form-label">Telefono</label>
                    <input asp-for="Usuario.Telefono" class="form-control" />
                    <span asp-validation-for="Usuario.Telefono" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Usuario.Email" class="form-label">Correo electronico</label>
                    <input asp-for="Usuario.Email" class="form-control" autocomplete="off" spellcheck="false" />
                    <div class="form-text">Enviaremos un correo electronico para verificar su cuenta.</div>
                    <span asp-validation-for="Usuario.Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Usuario.Password" class="form-label">Contrasena</label>
                    <div class="auth-password-field">
                        <input asp-for="Usuario.Password" class="form-control pe-5" autocomplete="new-password" />
                        <button type="button"
                                class="auth-password-toggle"
                                data-password-toggle
                                data-password-target="Usuario_Password"
                                aria-label="Mostrar contrasena"
                                aria-pressed="false">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <div class="form-text">Debe tener minimo 6 caracteres e incluir mayuscula, minuscula, numero y caracter especial.</div>
                    <span asp-validation-for="Usuario.Password" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Usuario.ConfirmPassword" class="form-label">Confirmar contrasena</label>
                    <div class="auth-password-field">
                        <input asp-for="Usuario.ConfirmPassword" class="form-control pe-5" autocomplete="new-password" />
                        <button type="button"
                                class="auth-password-toggle"
                                data-password-toggle
                                data-password-target="Usuario_ConfirmPassword"
                                aria-label="Mostrar contrasena"
                                aria-pressed="false">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Usuario.ConfirmPassword" class="text-danger"></span>
                </div>
                @if (!Model.MostrarCaptchaManual && !string.IsNullOrWhiteSpace(Model.TurnstileSiteKey))
                {
                    <div class="mb-3">
                        <div class="cf-turnstile"
                             data-sitekey="@Model.TurnstileSiteKey"
                             data-error-callback="registerTurnstileFallback"
                             data-timeout-callback="registerTurnstileFallback"></div>
                    </div>
                }

                @if (Model.MostrarCaptchaManual)
                {
                    <div class="auth-manual-captcha mb-3">
                        <label asp-for="CaptchaManual" class="form-label">Captcha manual de respaldo</label>
                        <div class="auth-manual-captcha-code" aria-label="Codigo captcha">@Model.CaptchaManualCodigo</div>
                        <input asp-for="CaptchaManual" class="form-control mt-2" autocomplete="off" spellcheck="false" placeholder="Escribe el codigo mostrado" />
                        <span asp-validation-for="CaptchaManual" class="text-danger"></span>
                        <div class="form-text">Usa este respaldo si la verificacion automatica falla.</div>
                    </div>
                }

                <button type="submit"
                        asp-page-handler="Usuario"
                        class="w-100 btn btn-primary auth-cta"
                        id="registerSubmitButton"
                        data-default-text="Registrar usuario"
                        data-submitting-text="Creando cuenta...">Registrar usuario</button>

                @if (Model.ExternalLogins.Count > 0)
                {
                    @foreach (var provider in Model.ExternalLogins)
                    {
                        <button type="submit"
                                class="w-100 btn btn-outline-dark auth-cta mt-2"
                                asp-page-handler="ExternalLogin"
                                asp-route-provider="@provider.Name"
                                asp-route-returnUrl="@Model.ReturnUrl"
                                asp-route-flow="register"
                                formnovalidate>
                            <span class="d-inline-flex align-items-center justify-content-center gap-2">
                                <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google" width="18" height="18" />
                                <span>Registrarse con @provider.DisplayName</span>
                            </span>
                        </button>
                    }
                }

                <div class="auth-foot-links auth-foot-links-pro auth-foot-links-centered">
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Ya tengo cuenta</a>
                    <a asp-area="" asp-controller="Home" asp-action="Index">Volver al inicio</a>
                </div>
            </form>
        </div>
    </section>
</section>

@section Scripts {
    <script>
        window.registerTurnstileFallback = () => {
            const fallback = document.getElementById("UsarCaptchaManualRegister");
            if (fallback) {
                fallback.value = "true";
            }
        };
    </script>
    @if (!Model.MostrarCaptchaManual && !string.IsNullOrWhiteSpace(Model.TurnstileSiteKey))
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer onerror="window.registerTurnstileFallback?.()"></script>
    }
    <script>
        (() => {
            const form = document.getElementById("registerForm");
            if (!form || form.dataset.clearSensitiveFields !== "true") {
                return;
            }

            const clearFields = () => {
                ["Usuario_Email", "Usuario_Password", "Usuario_ConfirmPassword"].forEach((id) => {
                    const field = document.getElementById(id);
                    if (field) {
                        field.value = "";
                    }
                });
            };

            window.addEventListener("pageshow", () => window.setTimeout(clearFields, 120), { once: true });
        })();
    </script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const hidden = document.getElementById("UsarCaptchaManualRegister");
            if (hidden) {
                hidden.value = "false";
            }

            const validationSummary = document.getElementById("registerValidationSummary");
            if (validationSummary) {
                validationSummary.focus({ preventScroll: true });
                validationSummary.scrollIntoView({ behavior: "smooth", block: "center" });
            }

            const form = document.getElementById("registerForm");
            const submitButton = document.getElementById("registerSubmitButton");
            form?.addEventListener("submit", (event) => {
                if (event.submitter !== submitButton || !form.checkValidity()) {
                    return;
                }

                if (submitButton.dataset.submitting === "true") {
                    event.preventDefault();
                    return;
                }

                submitButton.dataset.submitting = "true";
                submitButton.setAttribute("aria-disabled", "true");
                submitButton.classList.add("disabled");
                submitButton.textContent = submitButton.dataset.submittingText ?? "Creando cuenta...";
            });
        })();
    </script>
}
