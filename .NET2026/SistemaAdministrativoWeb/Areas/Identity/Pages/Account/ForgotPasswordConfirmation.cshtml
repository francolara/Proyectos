@page
@using SistemaAdministrativoWeb.Infrastructure.Assets
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@* Firma: FRANCO LARA - 31/08/2026 | Confirma de forma generica la recuperacion y usa el banner remoto versionado del inicio de sesion. *@
@{
    ViewData["Title"] = "Correo enviado";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var loginBannerUrl = PublicAssetUrlBuilder.Build(Configuration, "Banner/InicioSesion.webp");
}

<section class="auth-shell">
    <aside class="auth-visual @(!string.IsNullOrWhiteSpace(loginBannerUrl) ? "auth-visual-banner" : string.Empty)"
           style="@(!string.IsNullOrWhiteSpace(loginBannerUrl) ? $"background-image: url('{loginBannerUrl}');" : string.Empty)"
           role="@(!string.IsNullOrWhiteSpace(loginBannerUrl) ? "img" : null)"
           aria-label="@(!string.IsNullOrWhiteSpace(loginBannerUrl) ? "FralseCont: inicia sesion y gestiona tu empresa con confianza." : null)">
        @if (string.IsNullOrWhiteSpace(loginBannerUrl))
        {
            <div class="auth-visual-content">
                <p class="auth-visual-tag">FralseCont</p>
                <h2>Protegemos la privacidad de cada cuenta.</h2>
            </div>
        }
    </aside>
    <section class="auth-panel">
        <div class="auth-card text-center">
            <div class="mb-3"><i class="bi bi-envelope-check fs-1 text-primary"></i></div>
            <h1>Revisa tu correo</h1>
            <p class="auth-subtitle">Si el correo coincide con una cuenta valida, recibirás instrucciones para continuar.</p>
            <p class="text-muted">Revisa tambien las carpetas Spam o Promociones.</p>
            <a class="w-100 btn btn-primary auth-cta" asp-page="./Login">Volver al inicio de sesion</a>
        </div>
    </section>
</section>
