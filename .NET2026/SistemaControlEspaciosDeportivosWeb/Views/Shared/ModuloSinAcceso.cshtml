@model SistemaControlEspaciosDeportivosWeb.ViewModels.ModuloBaseViewModel

@{
    ViewData["Title"] = "Sin acceso";
}

<div class="alert alert-danger">
    <h1 class="h5 mb-2">Acceso denegado</h1>
    <p class="mb-0">@(Model.Mensaje ?? "No cuentas con permiso para este modulo.")</p>
</div>

<a class="btn btn-outline-primary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Volver al panel</a>

