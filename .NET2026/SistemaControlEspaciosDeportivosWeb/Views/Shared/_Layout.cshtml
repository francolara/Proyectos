<!DOCTYPE html>
@using SistemaControlEspaciosDeportivosWeb.Services
@using SistemaControlEspaciosDeportivosWeb.ViewModels
@using Microsoft.AspNetCore.Identity
@using SistemaControlEspaciosDeportivosWeb.Models
@inject ISportCenterStoredProcedureService spService
@inject IModuloPermisoService moduloPermisoService
@inject UserManager<ApplicationUser> userManager
@{
    var adminShellHead = ViewData["AdminShell"] as bool? ?? false;
    var platformShellHead = ViewData["PlatformShell"] as bool? ?? false;
    var adminThemeEnabled = adminShellHead || platformShellHead;
}
<html lang="es">
<head>
@{
    var canonicalUrl = ViewData["CanonicalUrl"]?.ToString();
    var robotsContent = ViewData["Robots"]?.ToString();
    var ogUrl = string.IsNullOrWhiteSpace(canonicalUrl)
        ? "https://www.lazonadeportiva.com/"
        : canonicalUrl;
}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - La Zona Deportiva</title>
    <script>
        (() => {
            const isAdminThemeEnabled = @(adminThemeEnabled ? "true" : "false");
            const storageKey = "sc-admin-theme";
            let theme = "light";

            if (isAdminThemeEnabled) {
                try {
                    theme = localStorage.getItem(storageKey) === "dark" ? "dark" : "light";
                } catch {
                    theme = "light";
                }
            }

            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-bs-theme", theme);
        })();
    </script>
    <meta name="description" content="Reserva canchas y espacios deportivos en La Zona Deportiva. Consulta disponibilidad, precios y confirma tu reserva en linea de forma rapida y segura." />
    @if (!string.IsNullOrWhiteSpace(robotsContent))
    {
        <meta name="robots" content="@robotsContent" />
    }
    @if (!string.IsNullOrWhiteSpace(canonicalUrl))
    {
        <link rel="canonical" href="@canonicalUrl" />
    }
    <meta property="og:title" content="@($"{ViewData["Title"]} - La Zona Deportiva")" />
    <meta property="og:site_name" content="La Zona Deportiva" />
    <meta property="og:description" content="Reserva de espacios deportivos en línea de forma rápida y segura." />
    <meta property="og:image" content="https://pub-3afaea6b0b354821989565fa4b8bd250.r2.dev/logos/LaZonaDeportiva/LaZonaDeportiva_Logo.webp" />
    <meta property="og:url" content="@ogUrl" />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload"
          href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
          as="style"
          onload="this.onload=null;this.rel='stylesheet'" />
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    </noscript>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    @if (string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="preload" href="~/lib/bootstrap/dist/css/bootstrap.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
        <noscript>
            <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        </noscript>
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="preload"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          as="style"
          onload="this.onload=null;this.rel='stylesheet'" />
    <noscript>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    </noscript>
    @if (string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="preload" href="~/SistemaControlEspaciosDeportivosWeb.styles.css" asp-append-version="true" as="style" onload="this.onload=null;this.rel='stylesheet'" />
        <noscript>
            <link rel="stylesheet" href="~/SistemaControlEspaciosDeportivosWeb.styles.css" asp-append-version="true" />
        </noscript>
    }
    else
    {
        <link rel="stylesheet" href="~/SistemaControlEspaciosDeportivosWeb.styles.css" asp-append-version="true" />
    }
    @if (string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/css/home-critical.css" asp-append-version="true" />
        <link rel="preload" as="style" href="~/css/site.css" asp-append-version="true" onload="this.onload=null;this.rel='stylesheet'" />
        <noscript>
            <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        </noscript>
    }
    else
    {
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
@{
    var adminShell = ViewData["AdminShell"] as bool? ?? false;
    var platformShell = ViewData["PlatformShell"] as bool? ?? false;
    var publicFullWidth = ViewData["PublicFullWidth"] as bool? ?? false;
    var hideDefaultFooter = ViewData["HideDefaultFooter"] as bool? ?? false;
    var contentClass = (adminShell || platformShell || publicFullWidth) ? "flex-fill p-0" : "container py-4 flex-fill";
    var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToUpperInvariant();
    var negocioIdRaw = ViewData["AdminNegocioId"]?.ToString()
        ?? ViewContext.RouteData.Values["negocioId"]?.ToString()
        ?? Context.Request.Query["negocioId"].FirstOrDefault();
    var hasNegocioId = int.TryParse(negocioIdRaw, out var adminNegocioId);
    string? adminNegocioNombre = ViewData["AdminNegocioNombre"]?.ToString();
    string? adminNegocioLogoUrl = null;
    var usuarioNombre = User.Identity?.Name ?? "Usuario";
    var usuarioCorreoSidebar = usuarioNombre;
    var saludoNombre = usuarioNombre;
    var rolActualSidebar = "Sin rol";
    var esOwnerPlataforma = User.IsInRole("OwnerPlataforma");
    var usuarioId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var bloquearModulosPorSuscripcion = false;
    var adminEsPlanBasico = false;

    if (!string.IsNullOrWhiteSpace(usuarioId))
    {
        var usuarioActual = await userManager.GetUserAsync(User);
        if (!string.IsNullOrWhiteSpace(usuarioActual?.Email))
            usuarioCorreoSidebar = usuarioActual.Email!.Trim();
        if (!string.IsNullOrWhiteSpace(usuarioActual?.Nombres))
            saludoNombre = usuarioActual.Nombres!.Trim();
    }

    if (adminShell && hasNegocioId)
    {
        try
        {
            var suscripcionNegocio = await spService.MiSuscripcionObtenerAsync(adminNegocioId);
            if (suscripcionNegocio is null)
            {
                bloquearModulosPorSuscripcion = true;
            }
            else
            {
                adminEsPlanBasico = string.Equals(suscripcionNegocio.TipoPlan, "Basico", StringComparison.OrdinalIgnoreCase);
                var estadoSuscripcion = suscripcionNegocio.EstadoSuscripcion;
                var esPruebaVencida = suscripcionNegocio.EstadoSuscripcion == 1
                                      && suscripcionNegocio.EsPrueba
                                      && suscripcionNegocio.FechaFinPrueba.HasValue
                                      && suscripcionNegocio.FechaFinPrueba.Value.Date < DateTime.Today;
                var contratoVencido = suscripcionNegocio.EstadoSuscripcion == 2
                                      && suscripcionNegocio.FechaFinPlan.HasValue
                                      && suscripcionNegocio.FechaFinPlan.Value.Date < DateTime.Today;
                bloquearModulosPorSuscripcion = estadoSuscripcion is not 1 and not 2
                                                || esPruebaVencida
                                                || contratoVencido;
            }

            var configuracionNegocio = await spService.ConfiguracionClubObtenerAsync(adminNegocioId);
            if (configuracionNegocio is not null)
            {
                adminNegocioNombre = string.IsNullOrWhiteSpace(configuracionNegocio.NombreComercial)
                    ? adminNegocioNombre
                    : configuracionNegocio.NombreComercial;
                adminNegocioLogoUrl = string.IsNullOrWhiteSpace(configuracionNegocio.LogoUrl)
                    ? null
                    : configuracionNegocio.LogoUrl;
            }

            if (!string.IsNullOrWhiteSpace(usuarioId))
            {
                var contextoRol = await moduloPermisoService.ObtenerContextoAsync(User, adminNegocioId, "DASHBOARD");
                if (contextoRol.Autorizado && !string.IsNullOrWhiteSpace(contextoRol.RolActual))
                    rolActualSidebar = contextoRol.RolActual;
            }
        }
        catch
        {
            // Evita afectar la navegacion si falla la carga opcional del logo.
        }
    }

    if (esOwnerPlataforma && (!adminShell || !hasNegocioId))
        rolActualSidebar = "OwnerPlataforma";

    adminNegocioNombre ??= "SportCenter";
    var inicialesNegocio = new string(
        adminNegocioNombre
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => char.ToUpperInvariant(x[0]))
            .Take(2)
            .ToArray());
    if (string.IsNullOrWhiteSpace(inicialesNegocio))
        inicialesNegocio = "SC";

    var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).ToUpperInvariant();
    var adminContentMode = currentController is "AYUDA" or "MISUSCRIPCION"
        ? "reading"
        : currentController is "CONFIGURACION" or "ONBOARDING" or "CUENTA"
          || (currentController == "PLATAFORMA" && currentAction == "PORTALWEB")
          || currentAction.StartsWith("CREATE", StringComparison.OrdinalIgnoreCase)
          || currentAction.StartsWith("EDIT", StringComparison.OrdinalIgnoreCase)
            ? "form"
            : "fluid";
    var adminWorkspaceClass = $"sc-admin-workspace sc-admin-workspace--{adminContentMode}";
    OnboardingChecklistViewModel? onboardingChecklist = null;
    byte onboardingPasoPendiente = 1;
    byte onboardingPasoContexto = 0;
    var onboardingVisible = false;
    var onboardingAvance = 0;
    var onboardingSiguientePaso = (byte)1;
    var onboardingSiguienteUrl = string.Empty;
    var onboardingSedeUrl = string.Empty;
    var onboardingEspacioUrl = string.Empty;
    var onboardingResumenPaso = string.Empty;
    var onboardingTituloPaso = string.Empty;
    var onboardingDetallePaso = string.Empty;
    string menuClass(string controller) => currentController == controller.ToUpperInvariant() ? "sc-admin-navlink active" : "sc-admin-navlink";
    string menuClassAction(string controller, string action)
        => currentController == controller.ToUpperInvariant() && currentAction == action.ToUpperInvariant()
            ? "sc-admin-navlink active"
            : "sc-admin-navlink";
    string menuUrl(string controller)
    {
        return hasNegocioId
            ? (Url.Action("Index", controller, new { negocioId = adminNegocioId }) ?? "#")
            : (Url.Action("Index", controller) ?? "#");
    }

    byte resolverPasoPendiente(OnboardingChecklistViewModel checklist)
    {
        var pasoMaestrosOk = checklist.MaestroTipoDeporteOk
                              && checklist.MaestroTipoSueloOk
                              && checklist.MaestroFormaPagoOk
                              && checklist.MaestroMonedaOk;
        if (!pasoMaestrosOk) return 1;

        var pasoConfiguracionOk = checklist.ConfigNombreComercialOk
                                  && checklist.ConfigTipoDocumentoOk
                                  && checklist.ConfigMonedaOk
                                  && checklist.ConfigCpeCondicionesOk;
        if (!pasoConfiguracionOk) return 2;

        if (!checklist.SedeMinimaOk) return 3;
        if (!checklist.EspacioMinimoOk) return 4;
        return 5;
    }

    if (adminShell && hasNegocioId)
    {
        onboardingPasoContexto = currentController switch
        {
            "MAESTROS" => (byte)1,
            "CONFIGURACION" => (byte)2,
            "SEDES" when currentAction == "CREATE" || currentAction == "EDIT" => (byte)3,
            "ESPACIOS" when currentAction == "CREATE" || currentAction == "EDIT" => (byte)4,
            _ => (byte)0
        };

        if (onboardingPasoContexto > 0)
        {
            onboardingChecklist = await spService.OnboardingChecklistValidarAsync(adminNegocioId);
            var sedeExistente = (await spService.SedesListarAsync(adminNegocioId)).FirstOrDefault();
            var espacioExistente = (await spService.EspaciosListarAsync(adminNegocioId)).FirstOrDefault();
            onboardingSedeUrl = sedeExistente is null
                ? (Url.Action("Create", "Sedes", new { negocioId = adminNegocioId }) ?? "#")
                : (Url.Action("Edit", "Sedes", new { id = sedeExistente.Id, negocioId = adminNegocioId }) ?? "#");
            onboardingEspacioUrl = espacioExistente is null
                ? (Url.Action("Create", "Espacios", new { negocioId = adminNegocioId }) ?? "#")
                : (Url.Action("Edit", "Espacios", new { id = espacioExistente.Id, negocioId = adminNegocioId }) ?? "#");
            var onboardingChecklistVal = onboardingChecklist!;
            onboardingPasoPendiente = resolverPasoPendiente(onboardingChecklistVal);
            var completados = 0;
            if (onboardingChecklistVal.ConfigNombreComercialOk && onboardingChecklistVal.ConfigTipoDocumentoOk && onboardingChecklistVal.ConfigMonedaOk && onboardingChecklistVal.ConfigCpeCondicionesOk) completados++;
            if (onboardingChecklistVal.MaestroTipoDeporteOk && onboardingChecklistVal.MaestroTipoSueloOk && onboardingChecklistVal.MaestroFormaPagoOk && onboardingChecklistVal.MaestroMonedaOk) completados++;
            if (onboardingChecklistVal.SedeMinimaOk) completados++;
            if (onboardingChecklistVal.EspacioMinimoOk) completados++;
            if (onboardingChecklistVal.ChecklistCompleto) completados++;
            onboardingAvance = completados * 100 / 5;
            onboardingVisible = !onboardingChecklistVal.ChecklistCompleto;
            onboardingSiguientePaso = onboardingPasoPendiente <= onboardingPasoContexto
                ? (byte)Math.Min(5, onboardingPasoContexto + 1)
                : onboardingPasoPendiente;

            onboardingSiguienteUrl = onboardingSiguientePaso switch
            {
                1 => Url.Action("Index", "Maestros", new { negocioId = adminNegocioId }) ?? "#",
                2 => Url.Action("Index", "Configuracion", new { negocioId = adminNegocioId }) ?? "#",
                3 => onboardingSedeUrl,
                4 => onboardingEspacioUrl,
                _ => Url.Action("Index", "Onboarding", new { negocioId = adminNegocioId, paso = 5 }) ?? "#"
            };

            if (onboardingPasoContexto == 1)
            {
                onboardingTituloPaso = "Paso 1: Maestros";
                onboardingResumenPaso = "Activa como minimo deporte, suelo, moneda y forma de pago.";
                onboardingDetallePaso = "Documento y serie quedan disponibles, pero ya no son obligatorios para cerrar onboarding.";
            }
            else if (onboardingPasoContexto == 2)
            {
                onboardingTituloPaso = "Paso 2: Configuracion";
                onboardingResumenPaso = "Completa razon social, documento, direccion fiscal, ubigeo, IGV y reglas clave de reserva.";
                onboardingDetallePaso = "Esto asegura validacion fiscal basica y reglas operativas desde el primer dia.";
            }
            else if (onboardingPasoContexto == 3)
            {
                onboardingTituloPaso = "Paso 3: Sede";
                onboardingResumenPaso = "Registra sede con direccion, ubigeo, horario y servicios.";
                onboardingDetallePaso = "En activacion tambien se exige notificaciones activas, correo y WhatsApp de contacto.";
            }
            else if (onboardingPasoContexto == 4)
            {
                onboardingTituloPaso = "Paso 4: Espacio";
                onboardingResumenPaso = "Crea un espacio activo con codigo, sede, deporte, suelo y tarifa valida.";
                onboardingDetallePaso = "Con esto ya habilitas la gestion real de reservas desde el modulo operativo.";
            }
        }
    }
}
<body class="d-flex flex-column min-vh-100 @(adminThemeEnabled ? "sc-admin-theme-shell" : "sc-public-theme-shell")">
    @if (!adminShell && !platformShell)
    {
        <header>
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sc-public-navbar">
                <div class="container">
                    <a class="navbar-brand fw-bold sc-public-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="SportCenter">
                        <img src="https://pub-3afaea6b0b354821989565fa4b8bd250.r2.dev/logos/LaZonaDeportiva/LaZonaDeportiva_Logo.webp" alt="La Zona Deportiva" class="sc-public-logo" width="320" height="68" />
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
