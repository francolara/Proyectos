    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (adminShell || platformShell)
    {
        <script>
            (() => {
                const sidebar = document.querySelector('.sc-admin-sidebar');
                const nav = document.querySelector('.sc-admin-nav');
                if (!sidebar || !nav) return;

                const pageKey = `${location.pathname}${location.search}`;
                const negocioKey = new URLSearchParams(location.search).get('negocioId') || 'global';
                const navKey = `sc-admin-sidebar-scroll:${negocioKey}`;
                const pageScrollKey = `sc-admin-page-scroll:${pageKey}`;
                const mobileModuleAnchorKey = `sc-admin-mobile-module-anchor:${negocioKey}`;
                const navBodies = Array.from(nav.querySelectorAll('.sc-admin-nav-group-body'));
                const adminMain = document.querySelector('.sc-admin-main');
                const mainContent = adminMain?.querySelector('main[role="main"]') ?? null;
                let savedNavScroll = 0;

                const isMobileAdminViewport = () => window.matchMedia('(max-width: 991.98px)').matches;

                const markMobileModuleRestoreNeeded = () => {
                    if (!isMobileAdminViewport()) return;
                    try {
                        sessionStorage.setItem(mobileModuleAnchorKey, '1');
                    } catch {
                    }
                };

                const resolveMobileModuleAnchor = () => {
                    const scope = mainContent ?? adminMain ?? document.querySelector('main[role="main"]');
                    if (!scope) return null;
                    return scope.querySelector('.sc-page-title-wrap, .sc-dash-shell, .page-header, .page-header-card, .admin-page-frame') ?? scope;
                };

                const restoreMobileModuleAnchor = () => {
                    if (!isMobileAdminViewport()) return;
                    let shouldRestore = false;
                    try {
                        shouldRestore = sessionStorage.getItem(mobileModuleAnchorKey) === '1';
                    } catch {
                        shouldRestore = false;
                    }
                    if (!shouldRestore) return;

                    const target = resolveMobileModuleAnchor();
                    if (!target) return;

                    target.scrollIntoView({ behavior: 'auto', block: 'start' });
                    setTimeout(() => target.scrollIntoView({ behavior: 'auto', block: 'start' }), 140);
                    setTimeout(() => target.scrollIntoView({ behavior: 'auto', block: 'start' }), 360);

                    try {
                        sessionStorage.removeItem(mobileModuleAnchorKey);
                    } catch {
                    }
                };

                try {
                    const savedNavScrollValue = sessionStorage.getItem(navKey);
                    if (savedNavScrollValue !== null) {
                        savedNavScroll = Number(savedNavScrollValue) || 0;
                        sidebar.scrollTop = savedNavScroll;
                    }

                    const savedPageScroll = sessionStorage.getItem(pageScrollKey);
                    if (savedPageScroll !== null) {
                        requestAnimationFrame(() => window.scrollTo(0, Number(savedPageScroll) || 0));
                    }
                } catch {
                }

                const restoreNavScroll = () => {
                    if (!savedNavScroll) return;
                    sidebar.scrollTop = savedNavScroll;
                };

                const getGroupBodyKey = (body) => {
                    const sectionId = body.closest('.collapse')?.id || 'default';
                    return `sc-admin-nav-group-scroll:${negocioKey}:${sectionId}`;
                };

                const restoreGroupBodyScroll = (body) => {
                    try {
                        const savedValue = sessionStorage.getItem(getGroupBodyKey(body));
                        if (savedValue !== null) {
                            body.scrollTop = Number(savedValue) || 0;
                        }
                    } catch {
                    }
                };

                const persistGroupBodyScroll = (body) => {
                    try {
                        sessionStorage.setItem(getGroupBodyKey(body), String(body.scrollTop || 0));
                    } catch {
                    }
                };

                requestAnimationFrame(() => {
                    restoreNavScroll();
                    navBodies.forEach(restoreGroupBodyScroll);
                    requestAnimationFrame(restoreNavScroll);
                    requestAnimationFrame(() => navBodies.forEach(restoreGroupBodyScroll));
                    requestAnimationFrame(restoreMobileModuleAnchor);
                });
                window.addEventListener('load', restoreNavScroll, { once: true });
                window.addEventListener('load', () => navBodies.forEach(restoreGroupBodyScroll), { once: true });
                window.addEventListener('load', restoreMobileModuleAnchor, { once: true });
                setTimeout(restoreNavScroll, 180);
                setTimeout(() => navBodies.forEach(restoreGroupBodyScroll), 180);
                setTimeout(restoreMobileModuleAnchor, 180);

                const persistScrollState = () => {
                    try {
                        sessionStorage.setItem(navKey, String(sidebar.scrollTop || 0));
                        sessionStorage.setItem(pageScrollKey, String(window.scrollY || 0));
                    } catch {
                    }
                };

                sidebar.addEventListener('scroll', persistScrollState, { passive: true });
                navBodies.forEach(body => {
                    body.addEventListener('scroll', () => persistGroupBodyScroll(body), { passive: true });
                });
                nav.querySelectorAll('.collapse').forEach(section => {
                    section.addEventListener('shown.bs.collapse', () => {
                        restoreNavScroll();
                        const body = section.querySelector('.sc-admin-nav-group-body');
                        if (body) {
                            restoreGroupBodyScroll(body);
                        }
                        restoreMobileModuleAnchor();
                    });
                });
                window.addEventListener('scroll', persistScrollState, { passive: true });
                window.addEventListener('beforeunload', persistScrollState);

                document.querySelectorAll('.sc-admin-nav a, .sc-admin-homecard').forEach(anchor => {
                    anchor.addEventListener('click', () => {
                        markMobileModuleRestoreNeeded();
                        persistScrollState();
                        navBodies.forEach(persistGroupBodyScroll);
                    });
                });

                if (adminMain) {
                    adminMain.querySelectorAll('form').forEach(form => {
                        const method = (form.getAttribute('method') || 'get').toLowerCase();
                        if (method !== 'get') return;

                        form.addEventListener('submit', () => {
                            markMobileModuleRestoreNeeded();
                        });

                        form.querySelectorAll('select, input, button').forEach(control => {
                            control.addEventListener('change', () => {
                                markMobileModuleRestoreNeeded();
                            });
                        });
                    });

                    adminMain.querySelectorAll('a[href]').forEach(anchor => {
                        anchor.addEventListener('click', () => {
                            const href = anchor.getAttribute('href');
                            if (!href || href.startsWith('#')) return;

                            try {
                                const targetUrl = new URL(href, location.href);
                                if (targetUrl.origin === location.origin) {
                                    markMobileModuleRestoreNeeded();
                                }
                            } catch {
                            }
                        });
                    });
                }
            })();
        </script>
    }
    @if (adminShell && hasNegocioId)
    {
        <script>
            (() => {
                const wrap = document.getElementById('scAdminNotifyWrap');
                const btn = document.getElementById('scAdminNotifyBtn');
                const badge = document.getElementById('scAdminNotifyBadge');
                const panel = document.getElementById('scAdminNotifyPanel');
                const list = document.getElementById('scAdminNotifyList');
                const countText = document.getElementById('scAdminNotifyCountText');
                const markAllBtn = document.getElementById('scAdminNotifyMarkAll');
                if (!wrap || !btn || !badge || !panel || !list || !countText || !markAllBtn) return;

                const negocioId = wrap.getAttribute('data-negocio-id');
                if (!negocioId) return;

                const endpoint = '@Url.Action("Resumen", "Notificaciones")';
                const markReadEndpoint = '@Url.Action("MarcarLeida", "Notificaciones")';
                const markAllEndpoint = '@Url.Action("MarcarTodasLeidas", "Notificaciones")';
                let busy = false;

                function setBadge(value) {
                    const n = Number(value || 0);
                    badge.textContent = String(n);
                    badge.classList.toggle('d-none', n <= 0);
                    countText.textContent = n > 0 ? `${n} sin revisar` : 'Sin nuevas';
                }

                function renderItems(items) {
                    const data = Array.isArray(items) ? items : [];
                    if (data.length === 0) {
                        list.innerHTML = '<div class="sc-admin-notify-empty">No hay notificaciones nuevas.</div>';
                        return;
                    }

                    list.innerHTML = data.map(x => {
                        const title = (x.titulo || '').toString();
                        const mensaje = (x.mensaje || '').toString();
                        const fecha = (x.fechaTexto || '').toString();
                        const href = (x.urlDestino || '').toString();
                        const id = Number(x.id || 0);
                        const body = `
                            <div class="sc-admin-notify-item" data-id="${id}">
                                <div class="sc-admin-notify-item-title">${title}</div>
                                <div class="sc-admin-notify-item-msg">${mensaje}</div>
                                <div class="sc-admin-notify-item-time">${fecha}</div>
                            </div>`;
                        return href ? `<a class="sc-admin-notify-link" data-id="${id}" href="${href}">${body}</a>` : body;
                    }).join('');
                }

                async function postForm(url, formData) {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: formData
                    });
                    if (!response.ok) return null;
                    return await response.json();
                }

                async function marcarLeida(id) {
                    if (!id || Number(id) <= 0) return;
                    const data = new FormData();
                    data.append('negocioId', negocioId);
                    data.append('notificacionId', String(id));
                    const result = await postForm(markReadEndpoint, data);
                    if (result && result.ok) setBadge(result.noLeidas || 0);
                }

                async function refreshNotifications() {
                    if (busy) return;
                    busy = true;
                    try {
                        const url = `${endpoint}?negocioId=${encodeURIComponent(negocioId)}&top=12`;
                        const response = await fetch(url, { cache: 'no-store' });
                        if (!response.ok) return;
                        const data = await response.json();
                        if (!data || data.ok !== true) return;
                        setBadge(data.noLeidas || 0);
                        renderItems(data.items || []);
                    } catch {
                    } finally {
                        busy = false;
                    }
                }

                btn.addEventListener('click', () => {
                    const open = !panel.classList.contains('d-none');
                    panel.classList.toggle('d-none', open);
                    btn.setAttribute('aria-expanded', open ? 'false' : 'true');
                });

                list.addEventListener('click', async (ev) => {
                    const link = ev.target.closest('.sc-admin-notify-link');
                    if (!link) return;
                    ev.preventDefault();
                    const id = Number(link.getAttribute('data-id') || '0');
                    await marcarLeida(id);
                    const href = link.getAttribute('href');
                    if (href) window.location.href = href;
                });

                markAllBtn.addEventListener('click', async () => {
                    const data = new FormData();
                    data.append('negocioId', negocioId);
                    const result = await postForm(markAllEndpoint, data);
                    if (!result || result.ok !== true) return;
                    setBadge(result.noLeidas || 0);
                    renderItems([]);
                });

                document.addEventListener('click', (ev) => {
                    if (!wrap.contains(ev.target)) {
                        panel.classList.add('d-none');
                        btn.setAttribute('aria-expanded', 'false');
                    }
                });

                const pollingMs = 20000;
                refreshNotifications();
                setInterval(refreshNotifications, pollingMs);
            })();
        </script>
    }
    @if (onboardingVisible && onboardingPasoContexto > 0)
    {
        <script>
            (() => {
                const widget = document.querySelector('[data-onboarding-widget]');
                if (widget) {
                    const card = widget.querySelector('[data-onboarding-float]');
                    const fab = widget.querySelector('[data-onboarding-expand]');
                    const collapseBtn = widget.querySelector('[data-onboarding-collapse]');
                    const negocioId = widget.getAttribute('data-negocio-id') || '0';
                    const storageKey = `sc_onboarding_float_collapsed_${negocioId}`;
                    const isMobile = window.matchMedia('(max-width: 991.98px)').matches;

                    const applyCollapsed = (collapsed) => {
                        if (!card || !fab) return;
                        card.classList.toggle('d-none', collapsed);
                        fab.classList.toggle('d-none', !collapsed);
                    };

                    let collapsed = false;
                    try {
                        const saved = localStorage.getItem(storageKey);
                        collapsed = saved === null ? isMobile : saved === '1';
                    } catch {
                        collapsed = isMobile;
                    }
                    applyCollapsed(collapsed);

                    collapseBtn?.addEventListener('click', () => {
                        collapsed = true;
                        applyCollapsed(true);
                        try { localStorage.setItem(storageKey, '1'); } catch {}
                    });

                    fab?.addEventListener('click', () => {
                        collapsed = false;
                        applyCollapsed(false);
                        try { localStorage.setItem(storageKey, '0'); } catch {}
                    });
                }

                const step = Number(document.querySelector('[data-onboarding-float]')?.getAttribute('data-step') || '0');
                const selectorsByStep = {
                    1: ['.sc-maestros-nav', '[data-target="tipos-deporte"]', '[data-target="tipos-suelo"]', '[data-target="formas-pago"]', '[data-target="monedas"]'],
                    2: ['#NombreComercial', '#RazonSocial', '#TipoDocumento', '#NumeroDocumento', '#DireccionFiscal', '#CodigoDepartamento', '#CodigoProvincia', '#CodigoUbigeo', '#PorcentajeIgv', '#CancelacionAutomaticaNoConfirmada', '#PermitirModificarPrecioReserva', '#PoliticaConfirmacionPago', '#MonedaId'],
                    3: ['#Nombre', '#Direccion', '#CodigoUbigeo', '#HoraApertura', '#HoraCierre', '#NotificacionesActivas', '#CorreoNotificacion', '#WhatsappNumeroLocal', '#ServiciosComplejoCard'],
                    4: ['#SedeId', '#TipoDeporteId', '#TipoSueloId', '#Codigo', '#Nombre', '#tablaTarifasEspacio']
                };

                const clearHighlight = () => {
                    document.querySelectorAll('.sc-onboarding-highlight').forEach(x => x.classList.remove('sc-onboarding-highlight'));
                };

                const highlightNow = () => {
                    clearHighlight();
                    const targets = selectorsByStep[step] || [];
                    let first = null;
                    targets.forEach((selector) => {
                        document.querySelectorAll(selector).forEach((el) => {
                            el.classList.add('sc-onboarding-highlight');
                            first ||= el;
                        });
                    });
                    if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
                };

                setTimeout(highlightNow, 500);
            })();
        </script>
    }
    @if (!adminShell && !platformShell)
    {
        @* Firma: FRANCO LARA - 11/06/2026 | El popup de promociones se carga una sola vez desde el layout publico para abrirse en Home, Reserva, Boletines, Login y Registro sin redireccionar al inicio. *@
        @await Component.InvokeAsync("PopupPromocionesPublicas")
    }
    <script>
        (() => {
            const links = document.querySelectorAll('.js-nav-open-promociones');
            if (!links.length) return;

            links.forEach((link) => {
                link.addEventListener('click', function (ev) {
                    ev.preventDefault();

                    const modalEl = document.getElementById('popupPromocionesModal');
                    if (modalEl && window.bootstrap) {
                        bootstrap.Modal.getOrCreateInstance(modalEl).show();
                    }
                });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

