<!DOCTYPE html>
@using SistemaControlEspaciosDeportivosWeb.Services
@using Microsoft.AspNetCore.Identity
@using SistemaControlEspaciosDeportivosWeb.Models
@inject ISportCenterStoredProcedureService spService
@inject UserManager<ApplicationUser> userManager
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SportCenter</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.14/index.global.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/SistemaControlEspaciosDeportivosWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reservas-calendario.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
@{
    var adminShell = ViewData["AdminShell"] as bool? ?? false;
    var platformShell = ViewData["PlatformShell"] as bool? ?? false;
    var publicFullWidth = ViewData["PublicFullWidth"] as bool? ?? false;
    var hideDefaultFooter = ViewData["HideDefaultFooter"] as bool? ?? false;
    var contentClass = (adminShell || platformShell || publicFullWidth) ? "flex-fill p-0" : "container py-4 flex-fill";
    var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToUpperInvariant();
    var negocioIdRaw = ViewData["AdminNegocioId"]?.ToString()
        ?? ViewContext.RouteData.Values["negocioId"]?.ToString()
        ?? Context.Request.Query["negocioId"].FirstOrDefault();
    var hasNegocioId = int.TryParse(negocioIdRaw, out var adminNegocioId);
    string? adminNegocioNombre = ViewData["AdminNegocioNombre"]?.ToString();
    string? adminNegocioLogoUrl = null;
    var usuarioNombre = User.Identity?.Name ?? "Usuario";
    var usuarioCorreoSidebar = usuarioNombre;
    var saludoNombre = usuarioNombre;
    var rolActualSidebar = "Sin rol";
    var esOwnerPlataforma = User.IsInRole("OwnerPlataforma");
    var usuarioId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    if (!string.IsNullOrWhiteSpace(usuarioId))
    {
        var usuarioActual = await userManager.GetUserAsync(User);
        if (!string.IsNullOrWhiteSpace(usuarioActual?.Email))
            usuarioCorreoSidebar = usuarioActual.Email!.Trim();
        if (!string.IsNullOrWhiteSpace(usuarioActual?.Nombres))
            saludoNombre = usuarioActual.Nombres!.Trim();
    }

    if (adminShell && hasNegocioId)
    {
        try
        {
            var configuracionNegocio = await spService.ConfiguracionClubObtenerAsync(adminNegocioId);
            if (configuracionNegocio is not null)
            {
                adminNegocioNombre = string.IsNullOrWhiteSpace(configuracionNegocio.NombreComercial)
                    ? adminNegocioNombre
                    : configuracionNegocio.NombreComercial;
                adminNegocioLogoUrl = string.IsNullOrWhiteSpace(configuracionNegocio.LogoUrl)
                    ? null
                    : configuracionNegocio.LogoUrl;
            }

            if (!string.IsNullOrWhiteSpace(usuarioId))
            {
                var rol = await spService.PanelObtenerRolAsync(usuarioId, adminNegocioId);
                if (!string.IsNullOrWhiteSpace(rol))
                    rolActualSidebar = rol;
            }
        }
        catch
        {
            // Evita afectar la navegacion si falla la carga opcional del logo.
        }
    }

    if (esOwnerPlataforma && (!adminShell || !hasNegocioId))
        rolActualSidebar = "OwnerPlataforma";

    adminNegocioNombre ??= "SportCenter";
    var inicialesNegocio = new string(
        adminNegocioNombre
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => char.ToUpperInvariant(x[0]))
            .Take(2)
            .ToArray());
    if (string.IsNullOrWhiteSpace(inicialesNegocio))
        inicialesNegocio = "SC";

    var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).ToUpperInvariant();
    string menuClass(string controller) => currentController == controller.ToUpperInvariant() ? "sc-admin-navlink active" : "sc-admin-navlink";
    string menuClassAction(string controller, string action)
        => currentController == controller.ToUpperInvariant() && currentAction == action.ToUpperInvariant()
            ? "sc-admin-navlink active"
            : "sc-admin-navlink";
    string menuUrl(string controller)
    {
        return hasNegocioId
            ? (Url.Action("Index", controller, new { negocioId = adminNegocioId }) ?? "#")
            : (Url.Action("Index", controller) ?? "#");
    }
}
<body class="d-flex flex-column min-vh-100">
    @if (!adminShell && !platformShell)
    {
        <header>
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sc-public-navbar">
                <div class="container">
                    <a class="navbar-brand fw-bold sc-public-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span>SportCenter</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div id="mainNav" class="collapse navbar-collapse">
                        <ul class="navbar-nav me-auto sc-public-nav-main">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door me-1"></i>Inicio
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="buscar">
                                    <i class="bi bi-search me-1"></i>Disponibilidad
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="caracteristicas">
                                    <i class="bi bi-stars me-1"></i>Caracteristicas
                                </a>
                            </li>
                            @if (ViewData["MostrarPromosNav"] is bool mostrarPromosNav && mostrarPromosNav)
                            {
                                <li class="nav-item">
                                    <button type="button" class="nav-link btn btn-link" data-popup-promociones-open>
                                        <i class="bi bi-megaphone-fill me-1"></i>Anuncios y promociones
                                    </button>
                                </li>
                            }
                        </ul>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>
    }

    @if (adminShell)
    {
        <div class="sc-admin-shell">
            <aside class="sc-admin-sidebar">
                <a class="sc-admin-homecard" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door-fill"></i>
                    <div>
                        <small>Volver al portal</small>
                        <strong>Ir al inicio</strong>
                    </div>
                </a>
                <div class="sc-admin-welcome">
                    <small>Bienvenido</small>
                    <strong>@saludoNombre</strong>
                </div>
                <div class="sc-admin-brand">
                    @if (!string.IsNullOrWhiteSpace(adminNegocioLogoUrl))
                    {
                        <img src="@Url.Action("VerImagen", "Sedes", new { url = adminNegocioLogoUrl })" alt="Logo club" class="sc-admin-brand-logo-img" />
                    }
                    else
                    {
                        <span class="sc-admin-brand-logo">@inicialesNegocio</span>
                    }
                    <p class="sc-admin-brand-title">@adminNegocioNombre</p>
                </div>

                @if (hasNegocioId)
                {
                    <div class="sc-admin-notify" id="scAdminNotifyWrap" data-negocio-id="@adminNegocioId">
                        <button type="button" class="sc-admin-notify-btn" id="scAdminNotifyBtn" aria-expanded="false" aria-controls="scAdminNotifyPanel">
                            <i class="bi bi-bell"></i>
                            <span>Notificaciones</span>
                            <span class="sc-admin-notify-badge d-none" id="scAdminNotifyBadge">0</span>
                        </button>
                        <div class="sc-admin-notify-panel d-none" id="scAdminNotifyPanel">
                            <div class="sc-admin-notify-head">
                                <strong>Reservas web</strong>
                                <div class="d-flex align-items-center gap-2">
                                    <small id="scAdminNotifyCountText">Sin nuevas</small>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" id="scAdminNotifyMarkAll">Marcar todas</button>
                                </div>
                            </div>
                            <div class="sc-admin-notify-list" id="scAdminNotifyList">
                                <div class="sc-admin-notify-empty">No hay notificaciones nuevas.</div>
                            </div>
                        </div>
                    </div>
                }

                <nav class="sc-admin-nav">
                    <a class="@menuClass("Panel")" href="@menuUrl("Panel")"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                    <a class="@menuClass("Maestros")" href="@menuUrl("Maestros")"><i class="bi bi-collection"></i><span>Maestros</span></a>
                    <a class="@menuClass("Sedes")" href="@menuUrl("Sedes")"><i class="bi bi-geo-alt"></i><span>Sedes</span></a>
                    <a class="@menuClass("Espacios")" href="@menuUrl("Espacios")"><i class="bi bi-grid-1x2"></i><span>Espacio deportivo</span></a>
                    <a class="@menuClass("Clientes")" href="@menuUrl("Clientes")"><i class="bi bi-people"></i><span>Clientes</span></a>
                    <a class="@menuClass("Reservas")" href="@menuUrl("Reservas")"><i class="bi bi-calendar-check"></i><span>Reservas</span></a>
                    <a class="@menuClass("Pagos")" href="@menuUrl("Pagos")"><i class="bi bi-wallet2"></i><span>Pagos</span></a>
                    <a class="@menuClass("Comprobantes")" href="@menuUrl("Comprobantes")"><i class="bi bi-receipt-cutoff"></i><span>Comprobantes</span></a>
                    <a class="@menuClass("Reportes")" href="@menuUrl("Reportes")"><i class="bi bi-graph-up-arrow"></i><span>Reportes</span></a>
                    <a class="@menuClass("Usuarios")" href="@menuUrl("Usuarios")"><i class="bi bi-person-gear"></i><span>Usuarios</span></a>
                    <a class="@menuClass("Promociones")" href="@menuUrl("Promociones")"><i class="bi bi-tags"></i><span>Promociones</span></a>
                    <a class="@menuClass("Configuracion")" href="@menuUrl("Configuracion")"><i class="bi bi-sliders2-vertical"></i><span>Configuracion</span></a>
                    <a class="@menuClass("MiSuscripcion")" href="@menuUrl("MiSuscripcion")"><i class="bi bi-credit-card-2-front"></i><span>Mi suscripcion</span></a>
                </nav>

                <div class="sc-admin-session-box">
                    <div class="sc-admin-session-user">
                        <strong>@usuarioCorreoSidebar</strong>
                        <span>Rol: @rolActualSidebar</span>
                    </div>
                    <a class="btn btn-outline-light w-100 mb-2" asp-controller="Cuenta" asp-action="CambiarContrasena">
                        <i class="bi bi-key me-1"></i>Cambiar contrasena
                    </a>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light w-100">
                            <i class="bi bi-box-arrow-right me-1"></i>Cerrar sesion
                        </button>
                    </form>
                </div>
            </aside>

            <section class="sc-admin-main">
                <main role="main" class="admin-page-frame">
                    @RenderBody()
                </main>
            </section>
        </div>
    }
    else if (platformShell)
    {
        <div class="sc-admin-shell">
            <aside class="sc-admin-sidebar">
                <a class="sc-admin-homecard" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door-fill"></i>
                    <div>
                        <small>Volver al portal</small>
                        <strong>Ir al inicio</strong>
                    </div>
                </a>
                <div class="sc-admin-welcome">
                    <small>Bienvenido</small>
                    <strong>@saludoNombre</strong>
                </div>
                <div class="sc-admin-brand">
                    <span class="sc-admin-brand-logo">SC</span>
                    <p class="sc-admin-brand-title">Control de plataforma</p>
                </div>

                <nav class="sc-admin-nav">
                    <a class="@menuClassAction("Plataforma", "Index")" href="@Url.Action("Index", "Plataforma")"><i class="bi bi-window-sidebar"></i><span>Dashboard global</span></a>
                    <a class="@menuClass("Banners")" href="@Url.Action("Index", "Banners")"><i class="bi bi-images"></i><span>Banners web</span></a>
                    <a class="@menuClassAction("Plataforma", "PortalWeb")" href="@Url.Action("PortalWeb", "Plataforma")"><i class="bi bi-sliders2"></i><span>Portal web</span></a>
                    <a class="@menuClassAction("Plataforma", "ClubesPendientes")" href="@Url.Action("ClubesPendientes", "Plataforma")"><i class="bi bi-person-check"></i><span>Altas de clubes</span></a>
                    <a class="@menuClassAction("Plataforma", "Negocios")" href="@Url.Action("Negocios", "Plataforma")"><i class="bi bi-buildings"></i><span>Negocios</span></a>
                    <a class="@menuClassAction("Plataforma", "ReferencialesExternos")" href="@Url.Action("ReferencialesExternos", "Plataforma")"><i class="bi bi-binoculars"></i><span>Referenciales externos</span></a>
                    <a class="@menuClass("Anuncios")" href="@Url.Action("Index", "Anuncios")"><i class="bi bi-megaphone"></i><span>Anuncios</span></a>
                </nav>

                <div class="sc-admin-session-box">
                    <div class="sc-admin-session-user">
                        <strong>@usuarioCorreoSidebar</strong>
                        <span>Rol: @rolActualSidebar</span>
                    </div>
                    <a class="btn btn-outline-light w-100 mb-2" asp-controller="Cuenta" asp-action="CambiarContrasena">
                        <i class="bi bi-key me-1"></i>Cambiar contrasena
                    </a>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light w-100">
                            <i class="bi bi-box-arrow-right me-1"></i>Cerrar sesion
                        </button>
                    </form>
                </div>
            </aside>

            <section class="sc-admin-main">
                <main role="main" class="admin-page-frame">
                    @RenderBody()
                </main>
            </section>
        </div>
    }
    else
    {
        <div class="@contentClass">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    }

    @if (!adminShell && !platformShell && !hideDefaultFooter)
    {
        <footer class="border-top footer text-muted py-3 mt-auto">
            <div class="container">
                &copy; 2026 - SportCenter
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (adminShell && hasNegocioId)
    {
        <script>
            (() => {
                const wrap = document.getElementById('scAdminNotifyWrap');
                const btn = document.getElementById('scAdminNotifyBtn');
                const badge = document.getElementById('scAdminNotifyBadge');
                const panel = document.getElementById('scAdminNotifyPanel');
                const list = document.getElementById('scAdminNotifyList');
                const countText = document.getElementById('scAdminNotifyCountText');
                const markAllBtn = document.getElementById('scAdminNotifyMarkAll');
                if (!wrap || !btn || !badge || !panel || !list || !countText || !markAllBtn) return;

                const negocioId = wrap.getAttribute('data-negocio-id');
                if (!negocioId) return;

                const endpoint = '@Url.Action("Resumen", "Notificaciones")';
                const markReadEndpoint = '@Url.Action("MarcarLeida", "Notificaciones")';
                const markAllEndpoint = '@Url.Action("MarcarTodasLeidas", "Notificaciones")';
                let busy = false;

                function setBadge(value) {
                    const n = Number(value || 0);
                    badge.textContent = String(n);
                    badge.classList.toggle('d-none', n <= 0);
                    countText.textContent = n > 0 ? `${n} sin revisar` : 'Sin nuevas';
                }

                function renderItems(items) {
                    const data = Array.isArray(items) ? items : [];
                    if (data.length === 0) {
                        list.innerHTML = '<div class="sc-admin-notify-empty">No hay notificaciones nuevas.</div>';
                        return;
                    }

                    list.innerHTML = data.map(x => {
                        const title = (x.titulo || '').toString();
                        const mensaje = (x.mensaje || '').toString();
                        const fecha = (x.fechaTexto || '').toString();
                        const href = (x.urlDestino || '').toString();
                        const id = Number(x.id || 0);
                        const body = `
                            <div class="sc-admin-notify-item" data-id="${id}">
                                <div class="sc-admin-notify-item-title">${title}</div>
                                <div class="sc-admin-notify-item-msg">${mensaje}</div>
                                <div class="sc-admin-notify-item-time">${fecha}</div>
                            </div>`;
                        return href ? `<a class="sc-admin-notify-link" data-id="${id}" href="${href}">${body}</a>` : body;
                    }).join('');
                }

                async function postForm(url, formData) {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: formData
                    });
                    if (!response.ok) return null;
                    return await response.json();
                }

                async function marcarLeida(id) {
                    if (!id || Number(id) <= 0) return;
                    const data = new FormData();
                    data.append('negocioId', negocioId);
                    data.append('notificacionId', String(id));
                    const result = await postForm(markReadEndpoint, data);
                    if (result && result.ok) setBadge(result.noLeidas || 0);
                }

                async function refreshNotifications() {
                    if (busy) return;
                    busy = true;
                    try {
                        const url = `${endpoint}?negocioId=${encodeURIComponent(negocioId)}&top=12`;
                        const response = await fetch(url, { cache: 'no-store' });
                        if (!response.ok) return;
                        const data = await response.json();
                        if (!data || data.ok !== true) return;
                        setBadge(data.noLeidas || 0);
                        renderItems(data.items || []);
                    } catch {
                    } finally {
                        busy = false;
                    }
                }

                btn.addEventListener('click', () => {
                    const open = !panel.classList.contains('d-none');
                    panel.classList.toggle('d-none', open);
                    btn.setAttribute('aria-expanded', open ? 'false' : 'true');
                });

                list.addEventListener('click', async (ev) => {
                    const link = ev.target.closest('.sc-admin-notify-link');
                    if (!link) return;
                    ev.preventDefault();
                    const id = Number(link.getAttribute('data-id') || '0');
                    await marcarLeida(id);
                    const href = link.getAttribute('href');
                    if (href) window.location.href = href;
                });

                markAllBtn.addEventListener('click', async () => {
                    const data = new FormData();
                    data.append('negocioId', negocioId);
                    const result = await postForm(markAllEndpoint, data);
                    if (!result || result.ok !== true) return;
                    setBadge(result.noLeidas || 0);
                    renderItems([]);
                });

                document.addEventListener('click', (ev) => {
                    if (!wrap.contains(ev.target)) {
                        panel.classList.add('d-none');
                        btn.setAttribute('aria-expanded', 'false');
                    }
                });

                const pollingMs = 20000;
                refreshNotifications();
                setInterval(refreshNotifications, pollingMs);
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
