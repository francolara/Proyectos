                                   href="#">
                                    <i class="bi bi-ticket-perforated me-1"></i>Promociones
                                </a>
                            </li>
                            @* Firma: FRANCO LARA - 21/07/2026 | Retira el acceso FAQ de la navegación pública para trasladarlo al plan Esencial. *@
                        </ul>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>
    }

    @if (adminShell)
    {
        <div class="sc-admin-shell">
            <aside class="sc-admin-sidebar">
                <a class="sc-admin-homecard" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door-fill"></i>
                    <div>
                        <small>Volver al portal</small>
                        <strong>Ir al inicio</strong>
                    </div>
                </a>
                <div class="sc-admin-welcome">
                    <small>Bienvenido</small>
                    <strong>@saludoNombre</strong>
                </div>
                <div class="sc-admin-brand">
                    @* Firma: FRANCO LARA - 09/05/2026 | Ajuste de etiquetas del panel Super Admin para usar la nomenclatura Complejo deportivo. *@
                    @if (!string.IsNullOrWhiteSpace(adminNegocioLogoUrl))
                    {
                        <img src="@Url.Action("VerImagen", "Sedes", new { url = adminNegocioLogoUrl })" alt="Logo complejo deportivo" class="sc-admin-brand-logo-img" />
                    }
                    else
                    {
                        <span class="sc-admin-brand-logo">@inicialesNegocio</span>
                    }
                    <p class="sc-admin-brand-title">@adminNegocioNombre</p>
                </div>
                @* Firma: FRANCO LARA - 08/07/2026 | Replica el selector de modo oscuro del sistema administrativo y unifica el scroll del panel lateral para admin y super admin. *@
                <section class="sc-admin-theme-card">
                    <div class="sc-admin-theme-copy">
                        <span>Apariencia</span>
                        <strong class="sc-theme-label" data-theme-label aria-live="polite"></strong>
                        <small>Cambia el tema del panel y conserva tu preferencia.</small>
                    </div>
                    <button type="button" class="sc-theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Alternar modo oscuro">
                        <span class="sc-theme-toggle-track">
                            <i class="bi bi-sun-fill sc-theme-icon sc-theme-icon-sun"></i>
                            <span class="sc-theme-toggle-thumb"></span>
                            <i class="bi bi-moon-stars-fill sc-theme-icon sc-theme-icon-moon"></i>
                        </span>
                    </button>
                </section>

                @if (hasNegocioId)
                {
                    <div class="sc-admin-notify" id="scAdminNotifyWrap" data-negocio-id="@adminNegocioId">
                        <button type="button" class="sc-admin-notify-btn" id="scAdminNotifyBtn" aria-expanded="false" aria-controls="scAdminNotifyPanel">
                            <i class="bi bi-bell"></i>
                            <span>Notificaciones</span>
                            <span class="sc-admin-notify-badge d-none" id="scAdminNotifyBadge">0</span>
                        </button>
                        <div class="sc-admin-notify-panel d-none" id="scAdminNotifyPanel">
                            <div class="sc-admin-notify-head">
                                <strong>Reservas web</strong>
                                <div class="d-flex align-items-center gap-2">
                                    <small id="scAdminNotifyCountText">Sin nuevas</small>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" id="scAdminNotifyMarkAll">Marcar todas</button>
                                </div>
                            </div>
                            <div class="sc-admin-notify-list" id="scAdminNotifyList">
                                <div class="sc-admin-notify-empty">No hay notificaciones nuevas.</div>
                            </div>
                        </div>
                    </div>
                }

                <nav class="sc-admin-nav" id="scAdminNavAccordion">
                    @{
                        var seccionOperacionAbierta = currentController is "PANEL" or "ONBOARDING" or "MAESTROS" or "SEDES" or "ESPACIOS" or "RESERVAS" or "PAGOS" or "COMPROBANTES";
                        var seccionComercialAbierta = currentController is "CLIENTES" or "PROMOCIONES" or "CUPONES" or "REPORTES";
                        var seccionSistemaAbierta = currentController is "USUARIOS" or "CONFIGURACION" or "AYUDA" or "MISUSCRIPCION";
                    }
                    @* Firma: FRANCO LARA - 01/06/2026 | Menú lateral agrupado por secciones colapsables sin alterar rutas ni reglas de permiso. *@
                    <div class="sc-admin-nav-group">
                        <button class="sc-admin-nav-group-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#scNavOperacion" aria-expanded="@(seccionOperacionAbierta ? "true" : "false")" aria-controls="scNavOperacion">
                            <span><i class="bi bi-grid-3x3-gap me-1"></i>Operacion</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="collapse @(seccionOperacionAbierta ? "show" : null)" id="scNavOperacion">
                            <div class="sc-admin-nav-group-body">
                                <a class="@menuClass("Panel")" href="@menuUrl("Panel")"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                                <a class="@menuClass("Onboarding")" href="@menuUrl("Onboarding")"><i class="bi bi-signpost-split"></i><span>Guia de configuracion</span></a>
                                @if (!bloquearModulosPorSuscripcion)
                                {
                                    <a class="@menuClass("Maestros")" href="@menuUrl("Maestros")"><i class="bi bi-collection"></i><span>Maestros</span></a>
