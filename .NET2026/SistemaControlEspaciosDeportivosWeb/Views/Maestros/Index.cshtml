@model SistemaControlEspaciosDeportivosWeb.ViewModels.MaestrosIndexViewModel
<!-- Firma: Codex - 01/04/2026 | Nueva pestaña Maestros para mantenimiento de Monedas, Tipos de suelo, Tipos de deporte y Formas de pago -->
<!-- Firma: Codex - 02/04/2026 | Monedas por negocio desde supermaestro LATAM, mantenimiento por NegocioId y mejora visual Fase 1/Fase 2 en navegación, paneles y composición visual de Maestros -->

@{
    ViewData["Title"] = "Maestros";
}

<div class="admin-page-frame">
    <section class="page-header">
        <div>
            <h1>Maestros</h1>
            <p class="page-subtitle">@Model.NegocioNombre | Rol: @Model.RolActual</p>
        </div>
        <div class="action-toolbar">
            <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Panel
            </a>
        </div>
    </section>

    @if (TempData["MaestrosOk"] is string okMsg && !string.IsNullOrWhiteSpace(okMsg))
    {
        <div class="alert alert-success">@okMsg</div>
    }
    @if (TempData["MaestrosError"] is string errMsg && !string.IsNullOrWhiteSpace(errMsg))
    {
        <div class="alert alert-danger">@errMsg</div>
    }

    <section class="kpi-grid mb-3">
        <article class="kpi-card sc-maestros-kpi">
            <p class="kpi-card-label">Monedas</p>
            <h3 class="kpi-card-value">@Model.Monedas.Count</h3>
        </article>
        <article class="kpi-card sc-maestros-kpi">
            <p class="kpi-card-label">Tipos de suelo</p>
            <h3 class="kpi-card-value">@Model.TiposSuelo.Count</h3>
        </article>
        <article class="kpi-card sc-maestros-kpi">
            <p class="kpi-card-label">Tipos de deporte</p>
            <h3 class="kpi-card-value">@Model.TiposDeporte.Count</h3>
        </article>
        <article class="kpi-card sc-maestros-kpi">
            <p class="kpi-card-label">Formas de pago</p>
            <h3 class="kpi-card-value">@Model.FormasPago.Count</h3>
        </article>
    </section>

    <section class="table-card sc-maestros-nav-card mb-3">
        <div class="sc-maestros-nav">
            <button type="button" class="sc-maestro-tab is-active" data-target="monedas">
                <span class="sc-maestro-tab-icon"><i class="bi bi-cash-stack"></i></span>
                <span class="sc-maestro-tab-text">
                    <strong>Monedas</strong>
                    <small>@Model.Monedas.Count registro(s)</small>
                </span>
            </button>
            <button type="button" class="sc-maestro-tab" data-target="tipos-suelo">
                <span class="sc-maestro-tab-icon"><i class="bi bi-grid-1x2"></i></span>
                <span class="sc-maestro-tab-text">
                    <strong>Tipos de suelo</strong>
                    <small>@Model.TiposSuelo.Count registro(s)</small>
                </span>
            </button>
            <button type="button" class="sc-maestro-tab" data-target="tipos-deporte">
                <span class="sc-maestro-tab-icon"><i class="bi bi-dribbble"></i></span>
                <span class="sc-maestro-tab-text">
                    <strong>Tipos de deporte</strong>
                    <small>@Model.TiposDeporte.Count registro(s)</small>
                </span>
            </button>
            <button type="button" class="sc-maestro-tab" data-target="formas-pago">
                <span class="sc-maestro-tab-icon"><i class="bi bi-wallet2"></i></span>
                <span class="sc-maestro-tab-text">
                    <strong>Formas de pago</strong>
                    <small>@Model.FormasPago.Count registro(s)</small>
                </span>
            </button>
        </div>
    </section>

    <div class="sc-maestros-paneles">
        <section class="table-card sc-reservas-list-card mb-3 sc-maestro-panel is-active" data-panel="monedas">
            @{
                var monedasActivas = Model.Monedas.Count(x => x.Activo);
                var monedasInactivas = Model.Monedas.Count - monedasActivas;
            }
            <div class="sc-maestro-panel-header">
                <div>
                    <h2 class="section-title mb-1"><i class="bi bi-cash-stack me-1 text-primary"></i>Monedas</h2>
                    <p class="text-secondary-emphasis small mb-0">Asocia monedas del supermaestro al club/negocio.</p>
                </div>
                <div class="sc-maestro-panel-search">
                    <i class="bi bi-search"></i>
                    <input type="search" class="form-control form-control-sm sc-maestro-search-input" data-search-target="monedas" placeholder="Buscar moneda..." />
                </div>
            </div>
            <div class="sc-maestro-stats px-3">
                <span class="sc-maestro-stat-pill"><i class="bi bi-collection"></i>Total: @Model.Monedas.Count</span>
                <span class="sc-maestro-stat-pill is-success"><i class="bi bi-check2-circle"></i>Activas: @monedasActivas</span>
                <span class="sc-maestro-stat-pill is-danger"><i class="bi bi-x-circle"></i>Inactivas: @monedasInactivas</span>
            </div>
            @if (Model.PuedeCrear)
            {
                <form asp-action="MonedaCrear" method="post" class="px-3 pb-2 pt-2 sc-maestro-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                    <div class="row g-2">
                        <div class="col-md-6">
                            <select name="monedaSuperId" class="form-select" required>
                                <option value="">Selecciona moneda del supermaestro</option>
                                @foreach (var m in Model.MonedasSuper)
                                {
                                    <option value="@m.Value">@m.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="activo" class="form-select">
                                <option value="true">Activa</option>
                                <option value="false">Inactiva</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-circle me-1"></i>Agregar</button>
                        </div>
                    </div>
                </form>
            }
            <div class="table-responsive px-3 pb-3">
                <table class="table table-sm align-middle sc-maestro-table" data-table-id="monedas">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Símbolo</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Monedas.OrderBy(x => x.Nombre))
                        {
                            <tr data-search-text="@($"{item.Codigo} {item.Nombre} {item.Simbolo}")">
                                <td>@item.Codigo</td>
                                <td>@item.Nombre</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Simbolo) ? "-" : item.Simbolo)</td>
                                <td>
                                    <span class="badge @(item.Activo ? "bg-success-subtle text-success-emphasis border border-success-subtle" : "bg-danger-subtle text-danger-emphasis border border-danger-subtle")">
                                        @(item.Activo ? "Activa" : "Inactiva")
                                    </span>
                                </td>
                                <td class="text-end">
                                    @if (Model.PuedeEditar)
                                    {
                                        <form asp-action="MonedaEditar" method="post" class="d-inline-flex gap-1 align-items-center">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <select name="activo" class="form-select form-select-sm" style="max-width:96px;">
                                                <option value="true" selected="@item.Activo">Activa</option>
                                                <option value="false" selected="@(!item.Activo)">Inactiva</option>
                                            </select>
                                            <button type="submit" class="btn btn-sm sc-action-btn sc-action-edit"><i class="bi bi-pencil-square"></i>Editar</button>
                                        </form>
                                    }
                                    @if (Model.PuedeEliminar)
                                    {
                                        <form asp-action="MonedaEliminar" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm sc-action-btn sc-action-delete"><i class="bi bi-trash3"></i>Inactivar</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <div class="sc-maestro-panel" data-panel="tipos-suelo">
            @await Html.PartialAsync("_CatalogoSimple", (Model.TiposSuelo, "Tipos de suelo", "TipoSueloCrear", "TipoSueloEditar", "TipoSueloEliminar", Model.NegocioId, Model.PuedeCrear, Model.PuedeEditar, Model.PuedeEliminar))
        </div>
        <div class="sc-maestro-panel" data-panel="tipos-deporte">
            @await Html.PartialAsync("_CatalogoSimple", (Model.TiposDeporte, "Tipos de deporte", "TipoDeporteCrear", "TipoDeporteEditar", "TipoDeporteEliminar", Model.NegocioId, Model.PuedeCrear, Model.PuedeEditar, Model.PuedeEliminar))
        </div>
        <div class="sc-maestro-panel" data-panel="formas-pago">
            @await Html.PartialAsync("_CatalogoSimple", (Model.FormasPago, "Formas de pago", "FormaPagoCrear", "FormaPagoEditar", "FormaPagoEliminar", Model.NegocioId, Model.PuedeCrear, Model.PuedeEditar, Model.PuedeEliminar))
        </div>
    </div>
</div>

<script>
    (() => {
        const tabs = Array.from(document.querySelectorAll('.sc-maestro-tab'));
        const panels = Array.from(document.querySelectorAll('.sc-maestro-panel'));

        function activatePanel(target) {
            tabs.forEach((tab) => tab.classList.toggle('is-active', tab.dataset.target === target));
            panels.forEach((panel) => panel.classList.toggle('is-active', panel.dataset.panel === target));
        }

        tabs.forEach((tab) => {
            tab.addEventListener('click', () => activatePanel(tab.dataset.target));
        });

        document.querySelectorAll('.sc-maestro-search-input').forEach((input) => {
            input.addEventListener('input', () => {
                const tableId = input.dataset.searchTarget;
                const value = (input.value || '').trim().toLowerCase();
                const rows = document.querySelectorAll(`table[data-table-id="${tableId}"] tbody tr`);
                rows.forEach((row) => {
                    const text = (row.dataset.searchText || row.textContent || '').toLowerCase();
                    row.style.display = text.includes(value) ? '' : 'none';
                });
            });
        });
    })();
</script>
