@model SistemaControlEspaciosDeportivosWeb.ViewModels.CuponFormViewModel
@{
    ViewData["Title"] = "Nuevo cupon";
}

<div class="admin-page-frame">
    <section class="page-header">
        <div>
            <h1>Nuevo cupon</h1>
            <p class="page-subtitle">Define codigo, vigencia, uso maximo y alcance por sede/espacio.</p>
        </div>
        <div class="action-toolbar">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId"><i class="bi bi-arrow-left me-1"></i> Volver al listado</a>
        </div>
    </section>

    <form asp-action="Create" method="post" class="sc-form-shell">
        <input type="hidden" asp-for="NegocioId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-0"></div>
        <section class="sc-form-card">
            <div class="sc-form-section">
                <h2 class="sc-form-title"><i class="bi bi-ticket-perforated"></i> Datos del cupon</h2>
                <div class="row g-3">
                    <div class="col-md-4"><label asp-for="CodigoCupon" class="form-label"></label><input asp-for="CodigoCupon" class="form-control" /></div>
                    <div class="col-md-8"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" /></div>
                    <div class="col-md-3"><label asp-for="TipoDescuento" class="form-label"></label><select asp-for="TipoDescuento" class="form-select"><option value="PORCENTAJE">PORCENTAJE</option><option value="MONTO_FIJO">MONTO_FIJO</option></select></div>
                    <div class="col-md-3"><label asp-for="ValorDescuento" class="form-label"></label><input asp-for="ValorDescuento" class="form-control" /></div>
                    <div class="col-md-3"><label asp-for="CantidadMaxUsos" class="form-label"></label><input asp-for="CantidadMaxUsos" class="form-control" /></div>
                    <div class="col-md-3 d-flex align-items-end"><div class="form-check"><input asp-for="Activo" class="form-check-input" /><label asp-for="Activo" class="form-check-label"></label></div></div>
                    <div class="col-md-3"><label asp-for="FechaInicio" class="form-label"></label><input asp-for="FechaInicio" type="date" class="form-control" /></div>
                    <div class="col-md-3"><label asp-for="FechaFin" class="form-label"></label><input asp-for="FechaFin" type="date" class="form-control" /></div>
                    <div class="col-md-3"><label asp-for="SedeId" class="form-label">Sede</label><select asp-for="SedeId" asp-items="Model.Sedes" class="form-select" id="sedeSelect"></select></div>
                    <div class="col-md-3"><label asp-for="EspacioDeportivoId" class="form-label">Espacio</label><select asp-for="EspacioDeportivoId" asp-items="Model.Espacios" class="form-select" id="espacioSelect"></select></div>
                </div>
            </div>
        </section>
        <div class="sc-form-actions">
            <button type="submit" class="btn btn-primary btn-grabar"><i class="bi bi-check2-circle me-1"></i> Guardar cupon</button>
            <a class="btn btn-outline-secondary btn-cancelar" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const sede = document.getElementById('sedeSelect');
            const espacio = document.getElementById('espacioSelect');
            if (!sede || !espacio) return;
            const negocioId = @Model.NegocioId;
            const endpoint = '@Url.Action("EspaciosPorSede", "Cupones")';
            async function cargarEspacios() {
                const sedeId = sede.value || '';
                const r = await fetch(`${endpoint}?negocioId=${negocioId}&sedeId=${encodeURIComponent(sedeId)}`);
                if (!r.ok) return;
                const data = await r.json();
                const actual = espacio.value;
                espacio.innerHTML = '<option value="">Todos los espacios</option>';
                (data || []).forEach(i => {
                    const o = document.createElement('option');
                    o.value = i.value;
                    o.textContent = i.text;
                    if (i.value === actual) o.selected = true;
                    espacio.appendChild(o);
                });
            }
            sede.addEventListener('change', cargarEspacios);
        })();
    </script>
}
