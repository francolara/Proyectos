@model SistemaControlEspaciosDeportivosWeb.ViewModels.CuponesIndexViewModel
@* Firma: FRANCO LARA - 01/09/2026 | Presenta el listado con un titulo operativo y directo. *@
@{
    ViewData["Title"] = "Cupones";
    var totalCuponesVista = Model.Cupones.Count;
    var totalVigentesVista = Model.Cupones.Count(x => x.VigenteHoy && x.CantidadUsosDisponibles > 0);
    var totalAgotadosVista = Model.Cupones.Count(x => x.CantidadUsosDisponibles <= 0);
    var totalVencidosVista = Model.Cupones.Count(x => !x.VigenteHoy && x.FechaFin < DateOnly.FromDateTime(DateTime.Today));
}

<div class="admin-page-frame">
    <section class="page-header">
        <div class="sc-page-title-wrap">
            <div>
                <h1>Cupones</h1>
                <p class="page-subtitle">Gestiona codigos promocionales por sede y espacio deportivo.</p>
            </div>
            <div class="sc-negocio-ref-card" aria-readonly="true">
                <div class="sc-negocio-ref-card-head"><i class="bi bi-building"></i><span>Complejo Deportivo</span></div>
                <div class="sc-negocio-ref-card-name">@Model.NegocioNombre</div>
                <div class="sc-negocio-ref-card-id">ID: @Model.NegocioId</div>
            </div>
        </div>
        <div class="action-toolbar">
            @if (Model.PuedeCrear)
            {
                <a class="btn btn-primary" asp-action="Create" asp-route-negocioId="@Model.NegocioId"><i class="bi bi-plus-circle me-1"></i> Nuevo cupon</a>
            }
            <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId"><i class="bi bi-arrow-left me-1"></i> Volver al panel</a>
        </div>
    </section>

    <section class="kpi-grid mb-3">
        <article class="kpi-card"><p class="kpi-card-label">Cupones (pagina)</p><h3 class="kpi-card-value">@totalCuponesVista</h3></article>
        <article class="kpi-card"><p class="kpi-card-label">Vigentes (pagina)</p><h3 class="kpi-card-value">@totalVigentesVista</h3></article>
        <article class="kpi-card"><p class="kpi-card-label">Agotados (pagina)</p><h3 class="kpi-card-value">@totalAgotadosVista</h3></article>
        <article class="kpi-card"><p class="kpi-card-label">Vencidos (pagina)</p><h3 class="kpi-card-value">@totalVencidosVista</h3></article>
    </section>

    <section class="filter-card mb-3">
        <h2 class="section-title"><i class="bi bi-funnel me-1"></i>Filtro</h2>
        <form method="get" asp-action="Index">
            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
            <div class="row g-2 align-items-end px-3 pb-3">
                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <select class="form-select" name="estado">
                        <option value="vigentes" selected="@(Model.EstadoFiltro == "vigentes")">Vigentes</option>
                        <option value="activos" selected="@(Model.EstadoFiltro == "activos")">Activos</option>
                        <option value="agotados" selected="@(Model.EstadoFiltro == "agotados")">Agotados</option>
                        <option value="vencidos" selected="@(Model.EstadoFiltro == "vencidos")">Vencidos</option>
                        <option value="todos" selected="@(Model.EstadoFiltro == "todos")">Todos</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Desde</label>
                    <input type="date" class="form-control" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Hasta</label>
                    <input type="date" class="form-control" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label d-block">Seleccion rapida</label>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-sm btn-outline-primary btn-accion-filtro" name="preset" value="hoy">Hoy</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary btn-accion-filtro" name="preset" value="7d">7 dias</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary btn-accion-filtro" name="preset" value="30d">30 dias</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary btn-accion-filtro" name="preset" value="mes">Mes actual</button>
                        <button type="submit" class="btn btn-outline-primary btn-accion-filtro"><i class="bi bi-search me-1"></i> Buscar</button>
                    </div>
                </div>
            </div>
        </form>
    </section>

    <section class="table-card">
        <h2 class="section-title"><i class="bi bi-ticket-perforated me-1"></i>Cupones registrados</h2>
        @if (!Model.Cupones.Any())
        {
            <div class="empty-state"><i class="bi bi-info-circle"></i><span>No hay cupones para el filtro seleccionado.</span></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-ticket-perforated"></i><small>Cupon</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-percent"></i><small>Descuento</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-calendar-range"></i><small>Vigencia</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-bar-chart"></i><small>Uso</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-geo-alt"></i><small>Cobertura</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-gear"></i><small>Acciones</small></span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Cupones)
                    {
                        <tr>
                            <td class="text-center"><span class="sc-id-chip">@item.CodigoCupon</span><div class="mt-1 fw-semibold">@item.Nombre</div></td>
                            <td class="text-center">@(item.TipoDescuento == "PORCENTAJE" ? $"{item.ValorDescuento:N0}%" : $"S/ {item.ValorDescuento:N2}")</td>
                            <td class="text-center">@item.FechaInicio.ToString("dd/MM/yyyy") - @item.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td class="text-center"><span class="sc-list-mini-card sc-list-mini-card-center"><i class="bi bi-check2-circle"></i><span>@item.CantidadUsosActuales / @item.CantidadMaxUsos</span></span></td>
                            <td class="text-center"><div class="d-flex flex-column gap-1"><span class="sc-list-mini-card sc-list-mini-card-center"><i class="bi bi-geo-alt"></i><span>@item.Sede</span></span><span class="sc-list-mini-card sc-list-mini-card-center"><i class="bi bi-grid-3x3-gap"></i><span>@item.Espacio</span></span></div></td>
                            <td class="text-end">
                                @if (Model.PuedeEditar)
                                {
                                    <a class="btn btn-sm sc-action-btn sc-action-edit" asp-action="Edit" asp-route-negocioId="@Model.NegocioId" asp-route-id="@item.Id"><i class="bi bi-pencil-square"></i> Editar</a>
                                }
                                @if (Model.PuedeEliminar)
                                {
                                    <form asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm sc-action-btn sc-action-delete"><i class="bi bi-trash3"></i> Desactivar</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.TotalPaginas > 1)
        {
            var paginaAnterior = Model.Pagina > 1 ? Model.Pagina - 1 : 1;
            var paginaSiguiente = Model.Pagina < Model.TotalPaginas ? Model.Pagina + 1 : Model.TotalPaginas;
            <div class="sc-pagination-bar px-3 pb-3">
                <small class="sc-pagination-meta">Pagina @Model.Pagina de @Model.TotalPaginas (@Model.TotalRegistros registros)</small>
                <nav class="sc-pagination-nav" aria-label="Paginacion cupones">
                    <a class="sc-page-link @(Model.Pagina <= 1 ? "is-disabled" : null)" asp-action="Index" asp-route-negocioId="@Model.NegocioId" asp-route-estado="@Model.EstadoFiltro" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-pagina="@paginaAnterior">Anterior</a>
                    @for (var p = 1; p <= Model.TotalPaginas; p++)
                    {
                        <a class="sc-page-link @(p == Model.Pagina ? "is-active" : null)" asp-action="Index" asp-route-negocioId="@Model.NegocioId" asp-route-estado="@Model.EstadoFiltro" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-pagina="@p">@p</a>
                    }
                    <a class="sc-page-link @(Model.Pagina >= Model.TotalPaginas ? "is-disabled" : null)" asp-action="Index" asp-route-negocioId="@Model.NegocioId" asp-route-estado="@Model.EstadoFiltro" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-pagina="@paginaSiguiente">Siguiente</a>
                </nav>
                <span class="sc-pagination-spacer" aria-hidden="true"></span>
            </div>
        }
    </section>
</div>
