@model SistemaControlEspaciosDeportivosWeb.ViewModels.UsuariosNegocioIndexViewModel
@* Firma: FRANCO LARA - 21/07/2026 | Ajusta el mensaje de alta de usuarios para respetar IdentityBehavior. *@
@* Firma: FRANCO LARA - 01/09/2026 | Presenta el listado con un titulo operativo y directo. *@
@{
    ViewData["Title"] = "Usuarios del negocio";
}

<div class="admin-page-frame">
<section class="page-header">
    <div class="sc-page-title-wrap">
        <div>
            <h1>Usuarios del negocio</h1>
            <p class="page-subtitle">Gestion de accesos y permisos del equipo.</p>
        </div>
        <div class="sc-negocio-ref-card" aria-readonly="true">
            <div class="sc-negocio-ref-card-head"><i class="bi bi-building"></i><span>Complejo Deportivo</span></div>
            <div class="sc-negocio-ref-card-name">@Model.NegocioNombre</div>
            <div class="sc-negocio-ref-card-id">ID: @Model.NegocioId</div>
        </div>
    </div>
    <div class="action-toolbar">
        <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId"><i class="bi bi-arrow-left me-1"></i>Volver al panel</a>
    </div>
</section>

@if (TempData["UsuariosMsg"] is string okMsg)
{
    <div class="alert alert-success">@okMsg</div>
}
@if (TempData["UsuariosErr"] is string errMsg)
{
    <div class="alert alert-danger">@errMsg</div>
}

<section class="filter-card mb-3">
    <div class="card-body">
        <h2 class="section-title"><i class="bi bi-person-plus me-1"></i>Asignar usuario por correo</h2>
        <form asp-action="Asignar" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="NegocioId" value="@Model.NegocioId" />
            <div class="col-md-4">
                <label class="form-label">Correo</label>
                <input class="form-control" name="Correo" type="email" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Nombres y apellidos</label>
                <input class="form-control" name="NombreUsuario" maxlength="120" placeholder="Ej. Elver Gonzales" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Rol</label>
                <select class="form-select" name="RolNegocio">
                    @foreach (var rol in Model.Roles)
                    {
                        <option value="@rol.Value" selected="@(rol.Value == Model.AsignarForm.RolNegocio.ToString())">@rol.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Sede</label>
                <select class="form-select js-sede-selector" name="SedeId">
                    <option value="">Selecciona</option>
                    @foreach (var sede in Model.Sedes)
                    {
                        <option value="@sede.Value" selected="@(Model.SedeIdAsignada.HasValue && Model.SedeIdAsignada.Value.ToString() == sede.Value)">@sede.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-1 d-grid">
                <button type="submit" class="btn btn-primary btn-accion-filtro">Asignar</button>
            </div>
        </form>
        <small class="text-muted d-block mt-2">Si el correo no existe, se creara el usuario y la confirmacion dependera de la configuracion de acceso vigente.</small>
    </div>
</section>

<section class="table-card">
    <h2 class="section-title"><i class="bi bi-person-badge me-1"></i>Usuarios registrados</h2>
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle sc-list-table">
        <thead>
            <tr>
                <th class="text-center"><span class="sc-col-header"><i class="bi bi-person-vcard"></i><small>Usuario</small></span></th>
                <th class="text-center"><span class="sc-col-header"><i class="bi bi-envelope"></i><small>Correo</small></span></th>
                <th class="text-center"><span class="sc-col-header"><i class="bi bi-shield-check"></i><small>Rol</small></span></th>
                <th class="text-center"><span class="sc-col-header"><i class="bi bi-geo-alt"></i><small>Sede</small></span></th>
                <th class="text-center"><span class="sc-col-header"><i class="bi bi-patch-check"></i><small>Estado</small></span></th>
                <th class="text-center"><span class="sc-col-header"><i class="bi bi-envelope-check"></i><small>Correo confirmado</small></span></th>
                <th class="text-center"><span class="sc-col-header"><i class="bi bi-gear"></i><small>Acciones</small></span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Usuarios)
            {
                <tr>
                    <td>@($"{item.Nombres} {item.Apellidos}".Trim())</td>
                    <td>@item.Correo</td>
                    <td>
                        <form asp-action="CambiarRol" method="post" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="NegocioId" value="@Model.NegocioId" />
                            <input type="hidden" name="UsuarioNegocioId" value="@item.UsuarioNegocioId" />
                            <select class="form-select form-select-sm js-rol-edicion" name="RolNegocio">
                                @foreach (var rol in Model.Roles)
                                {
                                    <option value="@rol.Value" selected="@(rol.Value == item.RolNegocio.ToString())">@rol.Text</option>
                                }
                            </select>
                            <select class="form-select form-select-sm js-sede-edicion" name="SedeId">
                                <option value="">Selecciona</option>
                                @foreach (var sede in Model.Sedes)
                                {
                                    <option value="@sede.Value" selected="@(item.SedeId.HasValue && item.SedeId.Value.ToString() == sede.Value)">@sede.Text</option>
                                }
                            </select>
                            @if (Model.PuedeEditar)
                            {
                                <button class="btn btn-sm btn-outline-primary btn-grabar" type="submit">Guardar</button>
                            }
                        </form>
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(item.SedeNombre) ? "-" : item.SedeNombre)</td>
                    <td>@(item.Activo ? "Activo" : "Inactivo")</td>
                    <td>@(item.CorreoConfirmado ? "Si" : "No")</td>
                    <td class="text-end">
                        @if (Model.PuedeEditar)
                        {
                            <a class="btn btn-sm sc-action-btn sc-action-edit" asp-action="Permisos" asp-route-negocioId="@Model.NegocioId" asp-route-usuarioNegocioId="@item.UsuarioNegocioId">
                                <i class="bi bi-pencil-square"></i> Permisos
                            </a>
                            @if (Model.EsAdministrador && item.Activo)
                            {
                                <form asp-action="EnviarEnlaceRecuperacion" method="post" class="d-inline" onsubmit="return confirm('Se enviara un enlace de acceso al correo del usuario. Deseas continuar?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                    <input type="hidden" name="usuarioNegocioId" value="@item.UsuarioNegocioId" />
                                    <button type="submit" class="btn btn-sm sc-action-btn sc-action-neutral">
                                        <i class="bi bi-envelope-paper"></i> Enviar enlace
                                    </button>
                                </form>
                            }
                        }
                        @if (Model.PuedeEliminar && item.Activo)
                        {
                            <form asp-action="Desactivar" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                <input type="hidden" name="usuarioNegocioId" value="@item.UsuarioNegocioId" />
                                <button type="submit" class="btn btn-sm sc-action-btn sc-action-delete">
                                    <i class="bi bi-trash3"></i> Desactivar
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
        </table>
    </div>
</section>
</div>

@section Scripts
{
    <script>
        (function () {
            const esAdminActual = @Model.EsAdministrador.ToString().ToLowerInvariant();
            const sedeFija = '@(Model.SedeIdAsignada?.ToString() ?? string.Empty)';

            function toggleSede(rolSelect, sedeSelect) {
                const esAdminRol = (rolSelect.value === "1");
                if (!esAdminActual && sedeFija) {
                    sedeSelect.value = sedeFija;
                }
                sedeSelect.disabled = esAdminRol || (!esAdminActual && !!sedeFija);
                sedeSelect.required = !esAdminRol;
                if (esAdminRol) {
                    sedeSelect.value = "";
                }
            }

            const rolAlta = document.querySelector('form[asp-action="Asignar"] select[name="RolNegocio"]')
                || document.querySelector('form[action$="/Asignar"] select[name="RolNegocio"]');
            const sedeAlta = document.querySelector('form[action$="/Asignar"] select[name="SedeId"]');
            if (rolAlta && sedeAlta) {
                toggleSede(rolAlta, sedeAlta);
                rolAlta.addEventListener('change', function () { toggleSede(rolAlta, sedeAlta); });
            }

            document.querySelectorAll('form[action$="/CambiarRol"]').forEach(function (form) {
                const rol = form.querySelector('.js-rol-edicion');
                const sede = form.querySelector('.js-sede-edicion');
                if (!rol || !sede) return;
                toggleSede(rol, sede);
                rol.addEventListener('change', function () { toggleSede(rol, sede); });
            });
        })();
    </script>
}

