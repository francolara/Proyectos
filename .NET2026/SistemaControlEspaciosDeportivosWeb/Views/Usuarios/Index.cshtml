@model SistemaControlEspaciosDeportivosWeb.ViewModels.UsuariosNegocioIndexViewModel

@{
    ViewData["Title"] = "Usuarios del negocio";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-1">Usuarios del negocio</h1>
        <p class="text-muted mb-0">@Model.NegocioNombre | Rol: @Model.RolActual</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Panel</a>
</div>

@if (TempData["UsuariosMsg"] is string okMsg)
{
    <div class="alert alert-success">@okMsg</div>
}
@if (TempData["UsuariosErr"] is string errMsg)
{
    <div class="alert alert-danger">@errMsg</div>
}

<section class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <h2 class="h6 mb-3">Asignar usuario por correo</h2>
        <form asp-action="Asignar" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="NegocioId" value="@Model.NegocioId" />
            <div class="col-md-5">
                <label class="form-label">Correo</label>
                <input class="form-control" name="Correo" type="email" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Rol</label>
                <select class="form-select" name="RolNegocio">
                    <option value="1">Administrador</option>
                    <option value="2" selected>Trabajador</option>
                    <option value="3">Recepcion</option>
                    <option value="4">Caja</option>
                    <option value="5">Supervisor</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">Asignar</button>
            </div>
        </form>
    </div>
</section>

<div class="table-responsive">
    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Usuarios)
            {
                <tr>
                    <td>@($"{item.Nombres} {item.Apellidos}".Trim())</td>
                    <td>@item.Correo</td>
                    <td>
                        <form asp-action="CambiarRol" method="post" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="NegocioId" value="@Model.NegocioId" />
                            <input type="hidden" name="UsuarioNegocioId" value="@item.UsuarioNegocioId" />
                            <select class="form-select form-select-sm" name="RolNegocio">
                                <option value="1" selected="@(item.RolNegocio == 1)">Administrador</option>
                                <option value="2" selected="@(item.RolNegocio == 2)">Trabajador</option>
                                <option value="3" selected="@(item.RolNegocio == 3)">Recepcion</option>
                                <option value="4" selected="@(item.RolNegocio == 4)">Caja</option>
                                <option value="5" selected="@(item.RolNegocio == 5)">Supervisor</option>
                            </select>
                            @if (Model.PuedeEditar)
                            {
                                <button class="btn btn-sm btn-outline-primary" type="submit">Guardar</button>
                            }
                        </form>
                    </td>
                    <td>@(item.Activo ? "Activo" : "Inactivo")</td>
                    <td class="text-end">
                        @if (Model.PuedeEditar)
                        {
                            <a class="btn btn-sm btn-outline-warning" asp-action="Permisos" asp-route-negocioId="@Model.NegocioId" asp-route-usuarioNegocioId="@item.UsuarioNegocioId">Permisos</a>
                        }
                        @if (Model.PuedeEliminar && item.Activo)
                        {
                            <form asp-action="Desactivar" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                <input type="hidden" name="usuarioNegocioId" value="@item.UsuarioNegocioId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
