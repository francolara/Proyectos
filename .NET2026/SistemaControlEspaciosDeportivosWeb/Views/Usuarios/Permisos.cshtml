@model SistemaControlEspaciosDeportivosWeb.ViewModels.UsuarioNegocioPermisosViewModel
@{
    ViewData["Title"] = "Permisos de usuario";
}

<div class="admin-page-frame">
    <section class="page-header">
        <div>
            <h1>Permisos por modulo</h1>
            <p class="page-subtitle">@Model.UsuarioNombre (@Model.UsuarioCorreo)</p>
        </div>
        <div class="action-toolbar">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>
    </section>

    @if (TempData["UsuariosMsg"] is string okMsg)
    {
        <div class="alert alert-success">@okMsg</div>
    }
    @if (TempData["UsuariosErr"] is string errMsg)
    {
        <div class="alert alert-danger">@errMsg</div>
    }

    <form asp-action="GuardarPermisos" method="post" class="sc-form-shell">
        @Html.AntiForgeryToken()
        <input type="hidden" name="negocioId" value="@Model.NegocioId" />
        <input type="hidden" name="usuarioNegocioId" value="@Model.UsuarioNegocioId" />

        <section class="table-card">
            <h2 class="section-title">Permisos por modulo</h2>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Modulo</th>
                            <th>Ver</th>
                            <th>Crear</th>
                            <th>Editar</th>
                            <th>Eliminar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Modulos.Count; i++)
                        {
                            <tr>
                                <td>
                                    @Model.Modulos[i].ModuloNombre
                                    <input type="hidden" name="modulos[@i].ModuloSistemaId" value="@Model.Modulos[i].ModuloSistemaId" />
                                    <input type="hidden" name="modulos[@i].ModuloCodigo" value="@Model.Modulos[i].ModuloCodigo" />
                                    <input type="hidden" name="modulos[@i].ModuloNombre" value="@Model.Modulos[i].ModuloNombre" />
                                </td>
                                <td><input class="form-check-input" type="checkbox" name="modulos[@i].PuedeVer" value="true" @(Model.Modulos[i].PuedeVer ? "checked" : null) /></td>
                                <td><input class="form-check-input" type="checkbox" name="modulos[@i].PuedeCrear" value="true" @(Model.Modulos[i].PuedeCrear ? "checked" : null) /></td>
                                <td><input class="form-check-input" type="checkbox" name="modulos[@i].PuedeEditar" value="true" @(Model.Modulos[i].PuedeEditar ? "checked" : null) /></td>
                                <td><input class="form-check-input" type="checkbox" name="modulos[@i].PuedeEliminar" value="true" @(Model.Modulos[i].PuedeEliminar ? "checked" : null) /></td>
                            </tr>
                            <input type="hidden" name="modulos[@i].PuedeVer" value="false" />
                            <input type="hidden" name="modulos[@i].PuedeCrear" value="false" />
                            <input type="hidden" name="modulos[@i].PuedeEditar" value="false" />
                            <input type="hidden" name="modulos[@i].PuedeEliminar" value="false" />
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <div class="sc-form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2-circle me-1"></i> Guardar permisos
            </button>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Cancelar</a>
        </div>
    </form>
</div>

