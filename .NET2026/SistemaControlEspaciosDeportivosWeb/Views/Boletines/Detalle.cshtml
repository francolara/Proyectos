@model SistemaControlEspaciosDeportivosWeb.ViewModels.BoletinDeportivoDetalleViewModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Titulo) ? "Boletin deportivo" : Model.Titulo;
}

<div class="container py-4">
    <div class="content-card p-4">
        <div class="d-flex flex-column flex-lg-row align-items-lg-start justify-content-between gap-3 mb-4">
            <div class="boletin-detalle-head">
                <span class="section-chip boletin-detalle-chip">
                    <i class="bi bi-image"></i>Boletines deportivos
                </span>
                <h1 class="boletin-detalle-title">@(string.IsNullOrWhiteSpace(Model.Titulo) ? "Evento deportivo" : Model.Titulo)</h1>
                <p class="boletin-detalle-subtitle mb-0">Consulta el boletin completo del evento y revisa rapidamente su fecha, ubicacion y detalle principal.</p>
                <div class="boletin-detalle-meta">
                    <span class="boletin-detalle-date">
                        <i class="bi bi-calendar-event"></i>
                        <span>Fecha del evento: @Model.FechaEvento.ToString("dd/MM/yyyy")</span>
                    </span>
                    @if (!string.IsNullOrWhiteSpace(Model.Zona))
                    {
                        <span class="boletin-detalle-zone">
                            <i class="bi bi-geo-alt"></i>
                            <span>@Model.Zona</span>
                        </span>
                    }
                </div>
                <div class="boletin-detalle-location-card">
                    <span class="boletin-detalle-label">Ubicacion</span>
                    <p>@Model.Departamento / @Model.Provincia / @Model.Distrito</p>
                </div>
            </div>
            <a asp-action="Index" class="auth-nav-mini auth-nav-mini-outline">
                <i class="bi bi-arrow-left me-1"></i>Volver a boletines
            </a>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
        {
            <div class="boletin-detalle-summary mb-4">
                <span class="boletin-detalle-label">Subtitulo / resumen del evento</span>
                <p class="mb-0">@Model.Descripcion</p>
            </div>
        }

        <div class="boletin-detalle-frame">
            <img src="@Model.ImagenUrl" alt="Boletin deportivo completo" />
        </div>
    </div>
</div>

@section Styles{
    <style>
        .boletin-detalle-head {
            max-width: 860px;
        }
        .boletin-detalle-chip {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            min-height: 32px;
            padding: .36rem .82rem;
            margin-bottom: .58rem;
            border-radius: 999px;
            border: 1px solid #bfdbfe;
            background: linear-gradient(180deg, #f8fbff 0%, #ebf4ff 100%);
            color: #2a5da8;
            font-size: .72rem;
            font-weight: 800;
            letter-spacing: .03em;
            text-transform: uppercase;
            box-shadow: 0 8px 18px rgba(59, 130, 246, .12);
        }
        .boletin-detalle-chip i {
            font-size: .8rem;
        }
        .boletin-detalle-title {
            margin: 0 0 .45rem;
            color: #0f2f64;
            font-size: clamp(2rem, 3vw, 3rem);
            line-height: 1.04;
            font-weight: 900;
            letter-spacing: -.03em;
            text-wrap: balance;
        }
        .boletin-detalle-subtitle {
            max-width: 760px;
            color: #5a7394;
            margin-bottom: 1.05rem !important;
            line-height: 1.6;
        }
        .boletin-detalle-meta {
            display: flex;
            gap: .75rem;
            flex-wrap: wrap;
            margin-bottom: 1rem;
        }
        .boletin-detalle-date,
        .boletin-detalle-zone {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            min-height: 46px;
            padding: .78rem 1rem;
            border-radius: 999px;
            font-size: .92rem;
            font-weight: 800;
        }
        .boletin-detalle-date {
            color: #fff;
            background: linear-gradient(135deg, #0f3f84, #2563eb);
            box-shadow: 0 16px 30px rgba(37, 99, 235, .22);
        }
        .boletin-detalle-zone {
            color: #166534;
            background: linear-gradient(135deg, #ecfdf5, #d1fae5);
            border: 1px solid #a7f3d0;
        }
        .boletin-detalle-label {
            display: inline-block;
            margin-bottom: .35rem;
            color: #6983a5;
            font-size: .76rem;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
        }
        .boletin-detalle-location-card,
        .boletin-detalle-summary {
            padding: 1.05rem 1.15rem;
            border-radius: 22px;
            border: 1px solid #dbe8fb;
            background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(244,248,255,.98));
            box-shadow: 0 14px 28px rgba(15, 47, 100, .08);
        }
        .boletin-detalle-location-card p {
            margin: 0;
            color: #1f3f6f;
            font-size: 1.02rem;
            font-weight: 800;
            line-height: 1.45;
        }
        .boletin-detalle-summary p {
            color: #4f6887;
            font-size: 1rem;
            line-height: 1.72;
        }
        .boletin-detalle-frame {
            width: 100%;
            display: flex;
            justify-content: center;
            padding: 1.2rem;
            border-radius: 24px;
            background: linear-gradient(180deg, #eff6ff, #dbeafe);
            border: 1px solid #d1e3fb;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.8);
        }
        .boletin-detalle-frame img {
            width: min(100%, 980px);
            height: auto;
            display: block;
            border-radius: 18px;
            box-shadow: 0 24px 48px rgba(15, 23, 42, .18);
            background: #fff;
        }
        @@media (max-width: 991.98px) {
            .boletin-detalle-title {
                font-size: 1.75rem;
            }
            .boletin-detalle-meta {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
}
