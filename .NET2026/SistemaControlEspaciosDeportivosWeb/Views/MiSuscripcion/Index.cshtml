@model SistemaControlEspaciosDeportivosWeb.ViewModels.MiSuscripcionIndexViewModel
@{
    ViewData["Title"] = "Mi suscripcion";
    var sus = Model.Suscripcion;
    var dias = Model.DiasParaVencer;
    var badgeClass = "text-bg-secondary";
    if (dias.HasValue)
    {
        badgeClass = dias.Value switch
        {
            < 0 => "text-bg-danger",
            <= 7 => "text-bg-warning",
            _ => "text-bg-success"
        };
    }
}
<div class="admin-page-frame">
<header class="page-header">
    <div class="sc-page-title-wrap">
        <div>
            <h1>Mi suscripcion</h1>
            <p class="page-subtitle">Revisa tu estado actual, fecha de vencimiento y datos de contacto de la plataforma.</p>
        </div>
        <div class="sc-negocio-ref-card" aria-readonly="true">
            <div class="sc-negocio-ref-card-head"><i class="bi bi-building"></i><span>Complejo deportivo</span></div>
            <div class="sc-negocio-ref-card-name">@(string.IsNullOrWhiteSpace(Model.NegocioNombre) ? "Complejo sin nombre" : Model.NegocioNombre)</div>
            <div class="sc-negocio-ref-card-id">ID: @Model.NegocioId</div>
        </div>
    </div>
    <div class="action-toolbar">
        <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
            <i class="bi bi-arrow-left"></i> Volver al panel
        </a>
    </div>
</header>

@if (sus is null)
{
    <div class="alert alert-warning">
        No se encontro informacion de suscripcion para este negocio. Contacta al administrador de plataforma.
    </div>
}
else
{
    <section class="content-card mb-3">
        <div class="kpi-grid">
            <article class="kpi-card">
                <p class="kpi-card-label">Estado</p>
                <h2 class="kpi-card-value">@sus.EstadoSuscripcionNombre</h2>
            </article>
            <article class="kpi-card">
                <p class="kpi-card-label">Plan</p>
                <h2 class="kpi-card-value">@Model.TipoPlan</h2>
            </article>
            <article class="kpi-card">
                <p class="kpi-card-label">Vence</p>
                <h2 class="kpi-card-value">@(Model.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "-")</h2>
            </article>
            <article class="kpi-card">
                <p class="kpi-card-label">Dias para vencer</p>
                <h2 class="kpi-card-value">
                    @if (dias.HasValue)
                    {
                        <span class="badge @badgeClass px-3 py-2">@dias.Value</span>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </h2>
            </article>
        </div>
    </section>

    <section class="content-card mb-3">
        <h2 class="section-title mb-3"><i class="bi bi-stars me-1"></i>Tu plan actual</h2>
        <div class="sc-suscripcion-limites-grid">
            <article class="sc-suscripcion-info-card">
                <span class="sc-suscripcion-info-icon"><i class="bi bi-award"></i></span>
                <div class="sc-suscripcion-info-copy">
                    <small>Plan contratado</small>
                    <strong>@Model.TipoPlan</strong>
                    <span>@(Model.EsPlanBasico ? "Plan ideal para operar reservas, pagos y administracion esencial." : "Plan completo con herramientas comerciales y comprobantes habilitados.")</span>
                </div>
            </article>
            <article class="sc-suscripcion-info-card">
                <span class="sc-suscripcion-info-icon"><i class="bi bi-check2-square"></i></span>
                <div class="sc-suscripcion-info-copy">
                    <small>Basico</small>
                    <strong>Operacion esencial</strong>
                    <span>Incluye reservas, pagos, clientes, sedes, espacios, usuarios y reportes.</span>
                </div>
            </article>
            <article class="sc-suscripcion-info-card">
                <span class="sc-suscripcion-info-icon"><i class="bi bi-rocket-takeoff"></i></span>
                <div class="sc-suscripcion-info-copy">
                    <small>Full</small>
                    <strong>Comercial avanzado</strong>
                    <span>Habilita promociones, cupones y comprobantes para escalar tus ventas.</span>
                </div>
            </article>
        </div>
    </section>

    <section class="content-card mb-3">
        <h2 class="section-title mb-3"><i class="bi bi-sliders me-1"></i>Limites del negocio</h2>
        <div class="sc-suscripcion-limites-grid">
            <article class="sc-suscripcion-info-card">
                <span class="sc-suscripcion-info-icon"><i class="bi bi-buildings"></i></span>
                <div class="sc-suscripcion-info-copy">
                    <small>Sedes permitidas</small>
                    <strong>@Model.SedesPermitidas</strong>
                    <span>Capacidad maxima de sedes activas para tu negocio.</span>
                </div>
            </article>
            <article class="sc-suscripcion-info-card">
                <span class="sc-suscripcion-info-icon"><i class="bi bi-grid-3x3-gap"></i></span>
                <div class="sc-suscripcion-info-copy">
                    <small>Espacios deportivos permitidos</small>
                    <strong>@Model.EspaciosPermitidos</strong>
                    <span>Numero de canchas o espacios operativos habilitados.</span>
                </div>
            </article>
            <article class="sc-suscripcion-info-card">
                <span class="sc-suscripcion-info-icon"><i class="bi bi-people"></i></span>
                <div class="sc-suscripcion-info-copy">
                    <small>Usuarios permitidos</small>
                    <strong>@Model.UsuariosPermitidos</strong>
                    <span>Accesos activos disponibles para tu equipo interno.</span>
                </div>
            </article>
        </div>
    </section>

    <section class="content-card">
        <h2 class="section-title mb-3"><i class="bi bi-headset me-1"></i>Contacto de soporte de plataforma</h2>
        <div class="sc-suscripcion-soporte-grid">
            <article class="sc-suscripcion-info-card">
                <span class="sc-suscripcion-info-icon"><i class="bi bi-envelope-paper"></i></span>
                <div class="sc-suscripcion-info-copy">
                    <small>Correo</small>
                    <strong>@(!string.IsNullOrWhiteSpace(Model.ContactoPlataformaEmail) ? Model.ContactoPlataformaEmail : "No configurado")</strong>
                    <span>Canal principal para consultas, ampliaciones y soporte operativo.</span>
                </div>
            </article>
            <article class="sc-suscripcion-info-card">
                <span class="sc-suscripcion-info-icon"><i class="bi bi-telephone"></i></span>
                <div class="sc-suscripcion-info-copy">
                    <small>Telefono</small>
                    <strong>@(!string.IsNullOrWhiteSpace(Model.ContactoPlataformaTelefono) ? Model.ContactoPlataformaTelefono : "No configurado")</strong>
                    <span>Linea de atencion para coordinaciones directas con plataforma.</span>
                </div>
            </article>
        </div>
    </section>
}

</div>

