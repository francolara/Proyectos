@model SistemaControlEspaciosDeportivosWeb.ViewModels.SedeFormViewModel
<!-- Firma: Codex - 27/03/2026 -->

@{
    ViewData["Title"] = "Nueva sede";
}

<h1 class="h4 mb-3">Nueva sede</h1>

<form asp-action="Create" method="post" class="card card-body shadow-sm">
    <input type="hidden" asp-for="NegocioId" />
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Telefono" class="form-label"></label>
            <input asp-for="Telefono" class="form-control" />
            <span asp-validation-for="Telefono" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Direccion" class="form-label"></label>
            <input asp-for="Direccion" class="form-control" />
            <span asp-validation-for="Direccion" class="text-danger"></span>
        </div>
        <div class="col-12">
            <div class="form-check">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-12">
            <label class="form-label">Servicios del club</label>
            <div class="row row-cols-1 row-cols-md-2 g-2">
                @for (var i = 0; i < Model.ServiciosDisponibles.Count; i++)
                {
                    var servicio = Model.ServiciosDisponibles[i];
                    var seleccionado = Model.ServiciosSeleccionados.Contains(int.Parse(servicio.Value));
                    <div class="col">
                        <label class="form-check border rounded p-2 d-flex align-items-center gap-2">
                            <input class="form-check-input mt-0" type="checkbox" name="ServiciosSeleccionados" value="@servicio.Value" @(seleccionado ? "checked" : null) />
                            <span class="form-check-label">@servicio.Text</span>
                        </label>
                    </div>
                }
            </div>
        </div>
        <div class="col-12">
            <hr />
            <h2 class="h6 mb-2">Configuracion de notificaciones y contacto</h2>
        </div>
        <div class="col-md-3">
            <div class="form-check mt-4">
                <input asp-for="NotificacionesActivas" class="form-check-input" />
                <label asp-for="NotificacionesActivas" class="form-check-label">Notificaciones activas</label>
            </div>
        </div>
        <div class="col-md-3">
            <label asp-for="MinutosAnticipacionRecordatorio" class="form-label">Minutos antes del recordatorio</label>
            <input asp-for="MinutosAnticipacionRecordatorio" class="form-control" />
            <span asp-validation-for="MinutosAnticipacionRecordatorio" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="MinutosToleranciaNoShow" class="form-label">Tolerancia no-show (min)</label>
            <input asp-for="MinutosToleranciaNoShow" class="form-control" />
            <span asp-validation-for="MinutosToleranciaNoShow" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <div class="form-check mt-4">
                <input asp-for="PermiteChatWhatsapp" class="form-check-input" />
                <label asp-for="PermiteChatWhatsapp" class="form-check-label">Habilitar chat por WhatsApp</label>
            </div>
        </div>
        <div class="col-md-6">
            <label asp-for="CorreoNotificacion" class="form-label">Correo de notificaciones</label>
            <input asp-for="CorreoNotificacion" class="form-control" />
            <span asp-validation-for="CorreoNotificacion" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="WhatsappContacto" class="form-label">WhatsApp de contacto</label>
            <input asp-for="WhatsappContacto" class="form-control" placeholder="+51999999999" />
            <span asp-validation-for="WhatsappContacto" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
