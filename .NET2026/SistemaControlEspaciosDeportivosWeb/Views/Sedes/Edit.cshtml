@model SistemaControlEspaciosDeportivosWeb.ViewModels.SedeFormViewModel
@inject IConfiguration Configuration
<!-- Firma: Codex - 27/03/2026 | Rediseño visual pro del formulario de sedes (estructura SaaS y jerarquia por secciones) -->
<!-- Firma: Codex - 30/03/2026 | Selector de codigo pais para telefonos de sede y WhatsApp -->
<!-- Firma: Codex - 02/04/2026 | Agrega ubicacion/fotos de sede, PlaceId y URL ocultos, autocomplete de Places y carga de maximo 6 imagenes en nube (principal+alternativas), estandarizando subida a JPG/PNG de entrada, conversion automatica a WebP 1200x900 <= 400KB, listado visual de archivos seleccionados y ajuste de region R2. -->
<!-- Firma: Codex - 03/04/2026 | Quita boton de validacion R2, cambia edicion de imagenes a manejo incremental y agrega visualizacion estable (miniatura + lupa) mediante endpoint de vista para URLs de storage no publicas. -->
<!-- Firma: Codex - 04/04/2026 | Habilita reordenamiento de imagenes actuales (subir/bajar) para poder cambiar el rol principal entre fotos ya registradas. -->
<!-- Firma: Codex - 05/04/2026 | Estandariza texto de estado para mostrar "No Asistio" en lugar de "no-show" en etiquetas de configuracion de sede. -->

@{
    ViewData["Title"] = "Editar sede";
    var mapsApiKey = Configuration["GoogleMaps:ApiKey"];

    var galeriaSede = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.FotoPrincipalUrl))
    {
        galeriaSede.Add(Model.FotoPrincipalUrl);
    }
    if (Model.FotosUrls?.Count > 0)
    {
        galeriaSede.AddRange(Model.FotosUrls.Where(x => !string.IsNullOrWhiteSpace(x)));
    }
}

<div class="admin-page-frame">
    <section class="page-header">
        <div>
            <h1>Editar sede</h1>
            <p class="page-subtitle">Actualiza datos generales, servicios, horarios y configuraciones de contacto.</p>
        </div>
        <div class="action-toolbar">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>
        </div>
    </section>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="sc-form-shell">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="NegocioId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-0"></div>

        <section class="sc-form-card">
            <div class="sc-form-section">
                <h2 class="sc-form-title"><i class="bi bi-building"></i> Datos generales</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" type="hidden" />
                        <div class="input-group">
                            <select asp-for="TelefonoCodigoPais" asp-items="Model.CodigosPais" class="form-select" style="max-width: 180px;"></select>
                            <input asp-for="TelefonoNumeroLocal" class="form-control" inputmode="numeric" placeholder="999999999" />
                        </div>
                        <span asp-validation-for="TelefonoCodigoPais" class="text-danger"></span>
                        <span asp-validation-for="TelefonoNumeroLocal" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <input asp-for="GooglePlaceId" type="hidden" />
                        <input asp-for="Latitud" type="hidden" />
                        <input asp-for="Longitud" type="hidden" />
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Direccion" class="form-label"></label>
                        <input asp-for="Direccion" class="form-control" />
                        <span asp-validation-for="Direccion" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 d-grid align-items-end">
                        <button id="btnBuscarDireccionMapa" type="button" class="btn btn-outline-primary mt-md-4">
                            <i class="bi bi-geo-alt me-1"></i> Buscar en mapa
                        </button>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Enlace de Google Maps (generado)</label>
                        <input asp-for="GoogleMapsUrl" type="hidden" />
                        <input id="GoogleMapsUrlDisplay" class="form-control" type="text" readonly placeholder="Se genera automaticamente al fijar ubicacion" />
                        <a id="GoogleMapsUrlLink" class="form-text d-inline-block mt-1" href="#" target="_blank" rel="noopener noreferrer" style="display:none;">
                            Abrir ubicacion en Google Maps
                        </a>
                        <span asp-validation-for="GoogleMapsUrl" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <div id="sedeMapa" class="border rounded-3" style="min-height: 280px;"></div>
                        <div class="form-text">Puedes hacer clic en el mapa para fijar el punto exacto de la sede.</div>
                    </div>
                    <div class="col-12">
                        <label class="sc-check-chip">
                            <input asp-for="Activo" class="form-check-input mt-0" />
                            <span class="form-check-label fw-semibold">Sede activa</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="sc-form-section">
                <h2 class="sc-form-title"><i class="bi bi-grid"></i> Servicios del club</h2>
                <div class="sc-check-grid">
                    @for (var i = 0; i < Model.ServiciosDisponibles.Count; i++)
                    {
                        var servicio = Model.ServiciosDisponibles[i];
                        var seleccionado = Model.ServiciosSeleccionados.Contains(int.Parse(servicio.Value));
                        <label class="sc-check-chip">
                            <input class="form-check-input mt-0" type="checkbox" name="ServiciosSeleccionados" value="@servicio.Value" @(seleccionado ? "checked" : null) />
                            <span>@servicio.Text</span>
                        </label>
                    }
                </div>
            </div>
        </section>

        <section class="sc-form-card">
            <div class="sc-form-section">
                <h2 class="sc-form-title"><i class="bi bi-bell"></i> Notificaciones y contacto</h2>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="sc-check-chip mt-md-4">
                            <input asp-for="NotificacionesActivas" class="form-check-input mt-0" />
                            <span>Notificaciones activas</span>
                        </label>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="MinutosAnticipacionRecordatorio" class="form-label">Minutos antes del recordatorio</label>
                        <input asp-for="MinutosAnticipacionRecordatorio" class="form-control" />
                        <span asp-validation-for="MinutosAnticipacionRecordatorio" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="MinutosToleranciaNoShow" class="form-label">Tolerancia No Asistio (min)</label>
                        <input asp-for="MinutosToleranciaNoShow" class="form-control" />
                        <span asp-validation-for="MinutosToleranciaNoShow" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="sc-check-chip mt-md-4">
                            <input asp-for="PermiteChatWhatsapp" class="form-check-input mt-0" />
                            <span>Habilitar chat por WhatsApp</span>
                        </label>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CorreoNotificacion" class="form-label">Correo de notificaciones</label>
                        <input asp-for="CorreoNotificacion" class="form-control" />
                        <span asp-validation-for="CorreoNotificacion" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="WhatsappContacto" class="form-label">WhatsApp de contacto</label>
                        <input asp-for="WhatsappContacto" type="hidden" />
                        <div class="input-group">
                            <select asp-for="WhatsappCodigoPais" asp-items="Model.CodigosPais" class="form-select" style="max-width: 180px;"></select>
                            <input asp-for="WhatsappNumeroLocal" class="form-control" inputmode="numeric" placeholder="999999999" />
                        </div>
                        <span asp-validation-for="WhatsappCodigoPais" class="text-danger"></span>
                        <span asp-validation-for="WhatsappNumeroLocal" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </section>

        <section class="sc-form-card">
            <div class="sc-form-section">
                <h2 class="sc-form-title"><i class="bi bi-clock-history"></i> Horario de atencion</h2>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="sc-days-row">
                            <label class="sc-day-chip"><input asp-for="AtiendeLunes" class="form-check-input mt-0" /> <span>Lunes</span></label>
                            <label class="sc-day-chip"><input asp-for="AtiendeMartes" class="form-check-input mt-0" /> <span>Martes</span></label>
                            <label class="sc-day-chip"><input asp-for="AtiendeMiercoles" class="form-check-input mt-0" /> <span>Miercoles</span></label>
                            <label class="sc-day-chip"><input asp-for="AtiendeJueves" class="form-check-input mt-0" /> <span>Jueves</span></label>
                            <label class="sc-day-chip"><input asp-for="AtiendeViernes" class="form-check-input mt-0" /> <span>Viernes</span></label>
                            <label class="sc-day-chip"><input asp-for="AtiendeSabado" class="form-check-input mt-0" /> <span>Sabado</span></label>
                            <label class="sc-day-chip"><input asp-for="AtiendeDomingo" class="form-check-input mt-0" /> <span>Domingo</span></label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="HoraApertura" class="form-label">Hora de apertura</label>
                        <input asp-for="HoraApertura" type="time" class="form-control" />
                        <span asp-validation-for="HoraApertura" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="HoraCierre" class="form-label">Hora de cierre</label>
                        <input asp-for="HoraCierre" type="time" class="form-control" />
                        <span asp-validation-for="HoraCierre" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="sc-form-section">
                <h2 class="sc-form-title"><i class="bi bi-calendar-x"></i> Fechas no laborables</h2>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Agregar fecha</label>
                        <div class="input-group">
                            <input id="fechaNoLaborableInput" type="date" class="form-control" />
                            <button id="btnAgregarFechaNoLaborable" type="button" class="btn btn-outline-secondary">Agregar</button>
                        </div>
                    </div>
                    <div class="col-12">
                        <input asp-for="FechasInhabilitadasCsv" type="hidden" />
                        <div id="fechasNoLaborablesList" class="d-flex flex-wrap gap-2"></div>
                        <div class="form-text">Estas fechas se bloquearan automaticamente en el calendario.</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="sc-form-card">
            <div class="sc-form-section">
                <h2 class="sc-form-title"><i class="bi bi-images"></i> Fotos de la sede</h2>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="ImagenesArchivos" class="form-label">Agregar imagenes (maximo 6 en total)</label>
                        <input asp-for="ImagenesArchivos" id="imagenesArchivosInput" type="file" class="form-control" multiple accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                        <span asp-validation-for="ImagenesArchivos" class="text-danger"></span>
                        <div class="form-text">
                            Puedes mantener imagenes actuales y agregar nuevas.
                            Si eliminas la principal, se asignara la siguiente disponible.
                            Formato de entrada permitido: JPG/JPEG/PNG.
                            Salida automatica estandar: WebP, 1200x900 (4:3), maximo 400KB.
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Resumen actual</label>
                        <div class="border rounded-3 p-2 bg-light-subtle small text-secondary">
                            <div><strong>Principal:</strong> @(string.IsNullOrWhiteSpace(Model.FotoPrincipalUrl) ? "Sin definir" : "Disponible")</div>
                            <div><strong>Alternativas:</strong> @(Model.FotosUrls?.Count ?? 0)</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <input asp-for="FotoPrincipalUrl" type="hidden" />
                        <input asp-for="FotosUrlsCsv" type="hidden" />
                        <div id="fotosEliminarContainer"></div>
                        <span asp-validation-for="FotoPrincipalUrl" class="text-danger d-block"></span>
                        <span asp-validation-for="FotosUrlsCsv" class="text-danger d-block"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Imagenes actuales</label>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:70px;">Orden</th>
                                        <th style="width:130px;">Vista</th>
                                        <th>Archivo</th>
                                        <th style="width:160px;">Rol</th>
                                        <th style="width:170px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="imagenesActualesBody">
                                    <tr>
                                        <td colspan="5" class="text-muted small">No hay imagenes registradas.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Nuevas imagenes seleccionadas</label>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:70px;">Orden</th>
                                        <th>Archivo</th>
                                        <th style="width:160px;">Rol</th>
                                        <th style="width:140px;">Tamano</th>
                                        <th style="width:170px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="imagenesSeleccionadasBody">
                                    <tr>
                                        <td colspan="5" class="text-muted small">Aun no has seleccionado archivos.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="sc-form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2-circle me-1"></i> Guardar cambios
            </button>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const input = document.getElementById('fechaNoLaborableInput');
            const btn = document.getElementById('btnAgregarFechaNoLaborable');
            const list = document.getElementById('fechasNoLaborablesList');
            const hidden = document.getElementById('FechasInhabilitadasCsv');
            const valores = new Set((hidden.value || '').split(',').map(x => x.trim()).filter(Boolean));

            function render() {
                const ordenados = Array.from(valores).sort();
                hidden.value = ordenados.join(',');
                list.innerHTML = '';
                for (const fecha of ordenados) {
                    const tag = document.createElement('span');
                    tag.className = 'badge text-bg-light border d-inline-flex align-items-center gap-2 p-2';
                    tag.innerHTML = `${fecha} <button type="button" class="btn-close btn-close-sm" aria-label="Quitar"></button>`;
                    tag.querySelector('button').addEventListener('click', () => {
                        valores.delete(fecha);
                        render();
                    });
                    list.appendChild(tag);
                }
            }

            btn.addEventListener('click', () => {
                if (!input.value) return;
                valores.add(input.value);
                input.value = '';
                render();
            });

            render();
        })();
    </script>
    <script>
        (() => {
            const latInput = document.getElementById('Latitud');
            const lngInput = document.getElementById('Longitud');
            const placeIdInput = document.getElementById('GooglePlaceId');
            const dirInput = document.getElementById('Direccion');
            const mapsUrlInput = document.getElementById('GoogleMapsUrl');
            const mapsUrlDisplay = document.getElementById('GoogleMapsUrlDisplay');
            const mapsUrlLink = document.getElementById('GoogleMapsUrlLink');
            const btnBuscar = document.getElementById('btnBuscarDireccionMapa');
            const targetMap = document.getElementById('sedeMapa');
            const hasGoogleApi = @(!string.IsNullOrWhiteSpace(mapsApiKey) ? "true" : "false");
            let map;
            let marker;
            let geocoder;
            let autocomplete;

            function setCoords(lat, lng) {
                const latNorm = Number(lat).toFixed(7);
                const lngNorm = Number(lng).toFixed(7);
                latInput.value = latNorm;
                lngInput.value = lngNorm;
                mapsUrlInput.value = `https://www.google.com/maps?q=${latNorm},${lngNorm}`;
                if (mapsUrlDisplay) mapsUrlDisplay.value = mapsUrlInput.value;
                if (mapsUrlLink) {
                    mapsUrlLink.href = mapsUrlInput.value;
                    mapsUrlLink.style.display = '';
                }
            }

            function paintFallback() {
                targetMap.classList.add('d-flex', 'align-items-center', 'justify-content-center', 'text-muted', 'bg-light');
                targetMap.innerHTML = 'Configura GoogleMaps:ApiKey para habilitar el mapa interactivo en esta pantalla.';
                btnBuscar.disabled = true;
            }

            function initMap() {
                const lat = parseFloat((latInput.value || '-12.046374').replace(',', '.'));
                const lng = parseFloat((lngInput.value || '-77.042793').replace(',', '.'));
                geocoder = new google.maps.Geocoder();
                map = new google.maps.Map(targetMap, { center: { lat, lng }, zoom: 15 });
                marker = new google.maps.Marker({ position: { lat, lng }, map, draggable: true });
                autocomplete = new google.maps.places.Autocomplete(dirInput, {
                    fields: ['place_id', 'formatted_address', 'geometry'],
                    componentRestrictions: { country: ['pe'] }
                });

                marker.addListener('dragend', () => {
                    const pos = marker.getPosition();
                    setCoords(pos.lat(), pos.lng());
                });
                map.addListener('click', (e) => {
                    marker.setPosition(e.latLng);
                    setCoords(e.latLng.lat(), e.latLng.lng());
                });
                autocomplete.addListener('place_changed', () => {
                    const place = autocomplete.getPlace();
                    if (!place || !place.geometry || !place.geometry.location) return;
                    const latPlace = place.geometry.location.lat();
                    const lngPlace = place.geometry.location.lng();
                    if (place.formatted_address) dirInput.value = place.formatted_address;
                    if (placeIdInput) placeIdInput.value = place.place_id || '';
                    map.setCenter({ lat: latPlace, lng: lngPlace });
                    map.setZoom(16);
                    marker.setPosition({ lat: latPlace, lng: lngPlace });
                    setCoords(latPlace, lngPlace);
                });
            }

            function buscarDireccion() {
                if (!hasGoogleApi || !geocoder) return;
                const value = (dirInput.value || '').trim();
                if (!value) return;
                geocoder.geocode({ address: value }, (results, status) => {
                    if (status !== 'OK' || !results || !results.length) return;
                    const loc = results[0].geometry.location;
                    map.setCenter(loc);
                    marker.setPosition(loc);
                    setCoords(loc.lat(), loc.lng());
                    if (placeIdInput) placeIdInput.value = results[0].place_id || '';
                });
            }

            if (!hasGoogleApi) {
                paintFallback();
                return;
            }

            if (mapsUrlInput?.value && mapsUrlDisplay && mapsUrlLink) {
                mapsUrlDisplay.value = mapsUrlInput.value;
                mapsUrlLink.href = mapsUrlInput.value;
                mapsUrlLink.style.display = '';
            }

            window.initSedeMapa = initMap;
            btnBuscar.addEventListener('click', buscarDireccion);
        })();
    </script>
    <script>
        (() => {
            const fotoPrincipalInput = document.getElementById('FotoPrincipalUrl');
            const fotosCsvInput = document.getElementById('FotosUrlsCsv');
            const bodyActuales = document.getElementById('imagenesActualesBody');
            const eliminarContainer = document.getElementById('fotosEliminarContainer');
            if (!fotoPrincipalInput || !fotosCsvInput || !bodyActuales || !eliminarContainer) return;

            const iniciales = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(galeriaSede));
            const verImagenBaseUrl = '@Url.Action("VerImagen", "Sedes")';
            const imagenFallbackSvg = "data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='110' height='72' viewBox='0 0 110 72'%3E%3Crect width='110' height='72' fill='%23f3f4f6'/%3E%3Cpath d='M8 56l20-20 12 12 18-18 24 26H8z' fill='%23cbd5e1'/%3E%3Ccircle cx='36' cy='24' r='8' fill='%23cbd5e1'/%3E%3C/svg%3E";
            let actuales = Array.isArray(iniciales) ? [...iniciales] : [];
            const removidas = new Set();

            function nombreArchivo(url) {
                try {
                    const pathname = new URL(url).pathname;
                    return decodeURIComponent(pathname.split('/').pop() || url);
                } catch {
                    return url;
                }
            }

            function syncHiddenRemovidas() {
                eliminarContainer.innerHTML = '';
                for (const url of removidas) {
                    const hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'FotosEliminarUrls';
                    hidden.value = url;
                    eliminarContainer.appendChild(hidden);
                }
            }

            function syncModelo() {
                fotoPrincipalInput.value = actuales.length > 0 ? actuales[0] : '';
                fotosCsvInput.value = actuales.length > 1 ? actuales.slice(1).join(',') : '';
                syncHiddenRemovidas();
            }

            function obtenerUrlVisualizacion(url) {
                return `${verImagenBaseUrl}?url=${encodeURIComponent(url)}`;
            }

            function renderActuales() {
                if (actuales.length === 0) {
                    bodyActuales.innerHTML = '<tr><td colspan="5" class="text-muted small">No hay imagenes registradas.</td></tr>';
                    syncModelo();
                    return;
                }

                bodyActuales.innerHTML = '';
                actuales.forEach((url, index) => {
                    const rol = index === 0 ? 'Principal' : `Alternativa ${index}`;
                    const urlVisualizacion = obtenerUrlVisualizacion(url);
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>${index + 1}</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="${urlVisualizacion}" alt="Imagen ${index + 1}" style="width:110px;height:72px;object-fit:cover;border-radius:8px;border:1px solid #dbe2ef;" data-preview="true" />
                                <a class="btn btn-sm btn-outline-secondary" href="${urlVisualizacion}" target="_blank" rel="noopener noreferrer" title="Ver imagen completa">
                                    <i class="bi bi-search"></i>
                                </a>
                            </div>
                        </td>
                        <td class="text-truncate" style="max-width:380px;" title="${url}">${nombreArchivo(url)}</td>
                        <td><span class="badge ${index === 0 ? 'text-bg-primary' : 'text-bg-secondary'}">${rol}</span></td>
                        <td class="d-flex gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="up-current" data-index="${index}" ${index === 0 ? 'disabled' : ''}>↑</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="down-current" data-index="${index}" ${index === actuales.length - 1 ? 'disabled' : ''}>↓</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-action="remove-current" data-url="${url}">Quitar</button>
                        </td>
                    `;
                    const img = tr.querySelector('img[data-preview="true"]');
                    if (img) {
                        img.addEventListener('error', () => {
                            img.src = imagenFallbackSvg;
                        }, { once: true });
                    }
                    bodyActuales.appendChild(tr);
                });
                syncModelo();
            }

            bodyActuales.addEventListener('click', (e) => {
                const btn = e.target.closest('button[data-action]');
                if (!btn) return;
                const action = btn.getAttribute('data-action');

                if (action === 'up-current' || action === 'down-current') {
                    const index = Number(btn.getAttribute('data-index'));
                    if (!Number.isInteger(index)) return;
                    const target = action === 'up-current' ? index - 1 : index + 1;
                    if (target < 0 || target >= actuales.length) return;
                    const temp = actuales[index];
                    actuales[index] = actuales[target];
                    actuales[target] = temp;
                    renderActuales();
                    return;
                }

                if (action === 'remove-current') {
                    const url = btn.getAttribute('data-url');
                    if (!url) return;
                    actuales = actuales.filter(x => x !== url);
                    removidas.add(url);
                    renderActuales();
                }
            });

            renderActuales();
        })();
    </script>
    <script>
        (() => {
            const input = document.getElementById('imagenesArchivosInput');
            const body = document.getElementById('imagenesSeleccionadasBody');
            if (!input || !body) return;
            let selectedFiles = [];

            function formatBytes(bytes) {
                if (!bytes || bytes <= 0) return '0 KB';
                const kb = bytes / 1024;
                if (kb < 1024) return `${kb.toFixed(1)} KB`;
                return `${(kb / 1024).toFixed(2)} MB`;
            }

            function syncInputFiles() {
                const dt = new DataTransfer();
                selectedFiles.forEach(file => dt.items.add(file));
                input.files = dt.files;
            }

            function move(index, offset) {
                const target = index + offset;
                if (target < 0 || target >= selectedFiles.length) return;
                const tmp = selectedFiles[index];
                selectedFiles[index] = selectedFiles[target];
                selectedFiles[target] = tmp;
                syncInputFiles();
                render();
            }

            function removeAt(index) {
                selectedFiles.splice(index, 1);
                syncInputFiles();
                render();
            }

            function render() {
                if (selectedFiles.length === 0) {
                    body.innerHTML = '<tr><td colspan="5" class="text-muted small">Aun no has seleccionado archivos.</td></tr>';
                    return;
                }

                body.innerHTML = '';
                selectedFiles.forEach((file, index) => {
                    const rol = index === 0 ? 'Principal' : `Alternativa ${index}`;
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>${index + 1}</td>
                        <td class="text-truncate" style="max-width:420px;" title="${file.name}">${file.name}</td>
                        <td><span class="badge ${index === 0 ? 'text-bg-primary' : 'text-bg-secondary'}">${rol}</span></td>
                        <td>${formatBytes(file.size)}</td>
                        <td class="d-flex gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="up" data-index="${index}" ${index === 0 ? 'disabled' : ''}>↑</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="down" data-index="${index}" ${index === selectedFiles.length - 1 ? 'disabled' : ''}>↓</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-action="remove" data-index="${index}">Quitar</button>
                        </td>
                    `;
                    body.appendChild(tr);
                });
            }

            body.addEventListener('click', (e) => {
                const btn = e.target.closest('button[data-action]');
                if (!btn) return;
                const action = btn.getAttribute('data-action');
                const index = Number(btn.getAttribute('data-index'));
                if (!Number.isInteger(index)) return;
                if (action === 'up') move(index, -1);
                if (action === 'down') move(index, 1);
                if (action === 'remove') removeAt(index);
            });

            input.addEventListener('change', () => {
                selectedFiles = Array.from(input.files || []);
                syncInputFiles();
                render();
            });
        })();
    </script>
    @if (!string.IsNullOrWhiteSpace(mapsApiKey))
    {
        <script async defer src="https://maps.googleapis.com/maps/api/js?key=@mapsApiKey&libraries=places&callback=initSedeMapa"></script>
    }
}
