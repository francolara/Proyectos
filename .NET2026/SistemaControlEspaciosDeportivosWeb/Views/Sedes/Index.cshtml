@model SistemaControlEspaciosDeportivosWeb.ViewModels.SedesIndexViewModel
@{
    ViewData["Title"] = "Sedes";
    var totalSedes = Model.Sedes.Count;
    var totalActivas = Model.Sedes.Count(x => x.Activo);
    var totalNotificaciones = Model.Sedes.Count(x => x.NotificacionesActivas);
    var totalWhatsapp = Model.Sedes.Count(x => x.PermiteChatWhatsapp && !string.IsNullOrWhiteSpace(x.WhatsappContacto));
}

<div class="admin-page-frame">
    @if (TempData["SedesError"] is string sedesError && !string.IsNullOrWhiteSpace(sedesError))
    {
        <div class="alert alert-danger">@sedesError</div>
    }
    @if (TempData["SedesOk"] is string sedesOk && !string.IsNullOrWhiteSpace(sedesOk))
    {
        <div class="alert alert-success">@sedesOk</div>
    }

    <section class="page-header">
        <div class="sc-page-title-wrap">
            <div>
                <h1>Sedes</h1>
                <p class="page-subtitle">Administracion de sedes y cobertura operativa.</p>
            </div>
            <div class="sc-negocio-ref-card" aria-readonly="true">
                <div class="sc-negocio-ref-card-head"><i class="bi bi-building"></i><span>Complejo Deportivo</span></div>
                <div class="sc-negocio-ref-card-name">@Model.NegocioNombre</div>
                <div class="sc-negocio-ref-card-id">ID: @Model.NegocioId</div>
            </div>
        </div>
        <div class="action-toolbar">
            @if (Model.PuedeCrear)
            {
                <a class="btn btn-primary" asp-action="Create" asp-route-negocioId="@Model.NegocioId">
                    <i class="bi bi-plus-circle me-1"></i> Nueva sede
                </a>
            }
            <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Volver al panel
            </a>
        </div>
    </section>

    <section class="kpi-grid mb-3">
        <article class="kpi-card">
            <p class="kpi-card-label">Total sedes</p>
            <h3 class="kpi-card-value">@totalSedes</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Sedes activas</p>
            <h3 class="kpi-card-value">@totalActivas</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Con notificaciones</p>
            <h3 class="kpi-card-value">@totalNotificaciones</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Con WhatsApp activo</p>
            <h3 class="kpi-card-value">@totalWhatsapp</h3>
        </article>
    </section>

    <section class="filter-card mb-3">
        <h2 class="section-title"><i class="bi bi-funnel me-1"></i>Filtro rapido</h2>
        <div class="row g-2 align-items-end px-3 pb-3">
            <div class="col-lg-8 col-md-7">
                <label class="form-label">Buscar por sede, direccion, servicios o contacto</label>
                <input type="text" id="filtroSedes" class="form-control" placeholder="Ejemplo: UNION CALLAO, Wi-Fi, correo, telefono..." />
            </div>
            <div class="col-lg-4 col-md-5">
                <label class="form-label">Registros visibles</label>
                <div class="form-control bg-light" id="contadorSedes">@totalSedes</div>
            </div>
        </div>
    </section>

    <section class="table-card">
        <h2 class="section-title"><i class="bi bi-list-ul me-1"></i>Listado detallado de sedes</h2>
        @if (!Model.Sedes.Any())
        {
            <div class="empty-state">
                <i class="bi bi-info-circle"></i>
                <span>No hay sedes registradas para este negocio.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle" id="tablaSedesDetallada">
                    <thead>
                        <tr>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-building"></i><small>Sede</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-clipboard2-pulse"></i><small>Atencion y servicios</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-bell"></i><small>Notificaciones y contacto</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-patch-check"></i><small>Estado</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-gear"></i><small>Acciones</small></span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Sedes)
                        {
                            var serviciosTexto = string.IsNullOrWhiteSpace(item.Servicios) ? "-" : item.Servicios!;
                            var diasTexto = string.IsNullOrWhiteSpace(item.DiasAtencion) ? "-" : item.DiasAtencion!;
                            var horarioTexto = string.IsNullOrWhiteSpace(item.HorarioAtencion) ? "-" : item.HorarioAtencion!;
                            var correoTexto = string.IsNullOrWhiteSpace(item.CorreoNotificacion) ? "-" : item.CorreoNotificacion!;
                            var whatsappTexto = string.IsNullOrWhiteSpace(item.WhatsappContacto) ? "-" : item.WhatsappContacto!;
                            var serviciosLista = (item.Servicios ?? string.Empty)
                                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                                .Take(3)
                                .ToList();

                            <tr data-search="@($"{item.Nombre} {item.Direccion} {serviciosTexto} {diasTexto} {horarioTexto} {correoTexto} {whatsappTexto} {(item.Activo ? "Activa" : "Inactiva")}".ToLowerInvariant())">
                                <td>
                                    <div class="sc-list-main">
                                        <div class="sc-list-title">@item.Nombre</div>
                                        <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@item.Direccion</small>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <div class="d-flex flex-wrap gap-2">
                                            <span class="badge bg-light text-dark border"><i class="bi bi-clock me-1"></i>@horarioTexto</span>
                                            <span class="badge bg-light text-dark border"><i class="bi bi-calendar3 me-1"></i>@diasTexto</span>
                                            <span class="badge bg-light text-dark border"><i class="bi bi-calendar-x me-1"></i>No laborables: @item.FechasNoLaborablesCount</span>
                                        </div>
                                        <div class="d-flex flex-wrap gap-1">
                                            @if (serviciosLista.Any())
                                            {
                                                foreach (var servicio in serviciosLista)
                                                {
                                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">@servicio</span>
                                                }
                                                @if ((item.Servicios ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Length > 3)
                                                {
                                                    <span class="badge bg-light text-dark border">+ mas</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark border">Sin servicios</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        @if (item.NotificacionesActivas)
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">Notificaciones activas</span>
                                            <small class="text-muted">@item.MinutosAnticipacionRecordatorio min antes | No Asistio: @item.MinutosToleranciaNoShow min</small>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">Notificaciones inactivas</span>
                                        }
                                        <div class="d-flex flex-wrap gap-2">
                                            <span class="badge bg-light text-dark border"><i class="bi bi-envelope me-1"></i>@correoTexto</span>
                                            <span class="badge bg-light text-dark border"><i class="bi bi-whatsapp me-1"></i>@whatsappTexto</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle sc-estado-pill">Activa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle sc-estado-pill">Inactiva</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (Model.PuedeEditar)
                                    {
                                        <a class="btn btn-sm sc-action-btn sc-action-edit" asp-action="Edit" asp-route-negocioId="@Model.NegocioId" asp-route-id="@item.Id">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                    }
                                    @if (Model.PuedeEliminar)
                                    {
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm sc-action-btn sc-action-delete">
                                                <i class="bi bi-trash3"></i> Eliminar
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const filtro = document.getElementById('filtroSedes');
            const tabla = document.getElementById('tablaSedesDetallada');
            const contador = document.getElementById('contadorSedes');
            if (!filtro || !tabla || !contador) return;

            function aplicarFiltro() {
                const valor = (filtro.value || '').trim().toLowerCase();
                let visibles = 0;
                tabla.querySelectorAll('tbody tr').forEach(row => {
                    const texto = row.getAttribute('data-search') || '';
                    const mostrar = !valor || texto.includes(valor);
                    row.style.display = mostrar ? '' : 'none';
                    if (mostrar) visibles++;
                });
                contador.textContent = String(visibles);
            }

            filtro.addEventListener('input', aplicarFiltro);
            aplicarFiltro();
        })();
    </script>
}
