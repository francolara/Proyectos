@section Scripts {
<script>
(() => {
    const popupPromocionesState = {
        hasItems: @popupPromociones.Count,
        isAuthenticated: @(esUsuarioAutenticado ? "true" : "false"),
        autoOpen: @(habilitarPopupAutomatico && popupConfig.ActivarPopupAutomatico ? "true" : "false"),
        delayMs: @(popupConfig.SegundosEsperaAntesDeMostrar * 1000),
        autoplay: @(popupConfig.ActivarAutoplaySlider ? "true" : "false"),
        autoplayMs: @popupConfig.VelocidadAutoplayMs,
        version: '@popupPromocionesVersion'
    };

    if (!popupPromocionesState.hasItems) return;

    const modalEl = document.getElementById('popupPromocionesModal');
    const carouselEl = document.getElementById('popupPromocionesCarousel');
    const openButtons = document.querySelectorAll('[data-popup-promociones-open]');
    if (!modalEl || !carouselEl || !window.bootstrap) return;

    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    let carouselInstance = null;

    function getCarousel() {
        if (carouselInstance) return carouselInstance;
        carouselInstance = bootstrap.Carousel.getOrCreateInstance(carouselEl, {
            interval: popupPromocionesState.autoplay ? popupPromocionesState.autoplayMs : false,
            ride: popupPromocionesState.autoplay ? 'carousel' : false,
            pause: false,
            wrap: true,
            touch: true
        });
        if (!popupPromocionesState.autoplay) {
            carouselInstance.pause();
        } else {
            carouselInstance.cycle();
        }
        return carouselInstance;
    }

    function openPopupPromociones() {
        const carousel = getCarousel();
        if (popupPromocionesState.autoplay) {
            carousel.cycle();
        }
        modal.show();
    }

    openButtons.forEach(button => {
        button.addEventListener('click', function () {
            openPopupPromociones();
        });
    });

    modalEl.addEventListener('hidden.bs.modal', function () {
        if (carouselInstance) {
            carouselInstance.pause();
        }
        if (popupPromocionesState.version) {
            sessionStorage.setItem('popupPromocionesVisto', popupPromocionesState.version);
        }
    });

    modalEl.addEventListener('shown.bs.modal', function () {
        if (!carouselInstance) return;
        if (popupPromocionesState.autoplay) {
            carouselInstance.cycle();
        } else {
            carouselInstance.pause();
        }
    });

    const popupPromocionesVistas = sessionStorage.getItem('popupPromocionesVisto') || '';
    if (popupPromocionesState.autoOpen && popupPromocionesVistas !== popupPromocionesState.version) {
        window.setTimeout(openPopupPromociones, popupPromocionesState.delayMs);
    }
})();
</script>
<script>
(() => {
    const quoteCards = document.querySelectorAll('.js-home-price-quote');
    if (!quoteCards.length) return;
    const omitirFechaHorario = @((Model.OmitirFechaHorario == true ? "true" : "false"));

    async function cotizarCard(card) {
        const negocioId = (card.getAttribute('data-negocio-id') || '').trim();
        const espacioId = (card.getAttribute('data-espacio-id') || '').trim();
        const fecha = (card.getAttribute('data-fecha') || '').trim();
        const horaInicio = (card.getAttribute('data-hora-inicio') || '').trim();
        const horaFin = (card.getAttribute('data-hora-fin') || '').trim();
        if (omitirFechaHorario || !negocioId || !espacioId || !fecha || !horaInicio || !horaFin) return;

        const priceMain = card.querySelector('.home-price-main');
        const promoWrap = card.querySelector('.home-price-promo');
        const baseEl = card.querySelector('.home-price-base');
        const badgeEl = card.querySelector('.home-price-discount-badge');

        const params = new URLSearchParams({
            negocioId,
            espacioDeportivoId: espacioId,
            fecha,
            horaInicio,
            horaFin
        });

        try {
            const resp = await fetch('@Url.Action("CotizarReservaPublica", "Home")' + '?' + params.toString(), { credentials: 'same-origin' });
            const data = await resp.json();
            if (!data || data.ok !== true) return;

            const c = data.cotizacion || {};
            const precioFinal = Number(c.precioFinal || 0);
            const precioBase = Number(c.precioBase || 0);
            const descuento = Number(c.descuentoPct || 0);
            const simbolo = c.monedaSimbolo || 'S/';

            if (priceMain && Number.isFinite(precioFinal) && precioFinal > 0) {
                priceMain.innerHTML = `Precio para este horario <strong>${simbolo} ${precioFinal.toFixed(2)}</strong>`;
            }

            if (descuento > 0 && promoWrap && baseEl && badgeEl) {
                promoWrap.classList.remove('d-none');
                baseEl.textContent = `${simbolo} ${precioBase.toFixed(2)}`;
                badgeEl.textContent = `-${Math.round(descuento)}%`;
            } else if (promoWrap && baseEl && badgeEl) {
                promoWrap.classList.add('d-none');
                baseEl.textContent = '';
                badgeEl.textContent = '';
            }
        } catch {
            // Mantener tarifa base si falla la cotizacion.
        }
    }

    quoteCards.forEach(card => { void cotizarCard(card); });
})();
</script>
<script>
(() => {
    const mediaQueryMobile = window.matchMedia('(max-width: 767.98px)');
    const slides = document.querySelectorAll('.home-hero-slide-dynamic');
    const heroDirectLinks = document.querySelectorAll('.js-hero-direct-link');

    heroDirectLinks.forEach(link => {
        ['pointerdown', 'touchstart', 'mousedown', 'click'].forEach(evtName => {
            link.addEventListener(evtName, function (event) {
                event.stopPropagation();
            }, { passive: true });
        });
    });

    function applyBannerBackgrounds() {
        slides.forEach(slide => {
            const desktop = slide.getAttribute('data-bg-desktop') || '';
            const mobile = slide.getAttribute('data-bg-mobile') || desktop;
            const selected = mediaQueryMobile.matches ? mobile : desktop;
            slide.style.backgroundImage = `linear-gradient(120deg,rgba(4,13,32,.42),rgba(10,38,86,.28)), url('${selected}')`;
        });
    }

    applyBannerBackgrounds();
    if (typeof mediaQueryMobile.addEventListener === 'function') {
        mediaQueryMobile.addEventListener('change', applyBannerBackgrounds);
    } else if (typeof mediaQueryMobile.addListener === 'function') {
        mediaQueryMobile.addListener(applyBannerBackgrounds);
    }

    const dep = document.getElementById('codigoDepartamento');
    const prov = document.getElementById('codigoProvincia');
    const dist = document.getElementById('codigoUbigeo');
    const negocio = document.getElementById('negocioId');
    const homeSearchForm = document.getElementById('homeSearchForm');
    const btnUbicacionActual = document.getElementById('btnUsarUbicacionActual');
    const btnBuscarCercaDeMi = document.getElementById('btnBuscarCercaDeMi');
    const buscarCercaDeMiInput = document.getElementById('buscarCercaDeMi');
    const latitudUsuarioInput = document.getElementById('latitudUsuario');
    const longitudUsuarioInput = document.getElementById('longitudUsuario');
    const radioKmInput = document.getElementById('radioKm');
    const ubicacionActualEstado = document.getElementById('ubicacionActualEstado');
    const omitirFechaHorario = document.getElementById('omitirFechaHorario');
    const fechaFiltro = document.getElementById('fechaFiltro');
    const horaInicioFiltro = document.getElementById('horaInicioFiltro');
    const horaFinFiltro = document.getElementById('horaFinFiltro');
    if (!dep || !prov || !dist) return;

    const garantizarAnclaResultados = () => {
        if (!homeSearchForm) return;
        const actionBase = (homeSearchForm.getAttribute('action') || '').split('#')[0];
        homeSearchForm.setAttribute('action', `${actionBase}#resultados`);
    };

    const urlProv = '@Url.Action("UbigeoProvincias", "Home")';
    const urlDist = '@Url.Action("UbigeoDistritos", "Home")';
    const urlNegocios = '@Url.Action("NegociosPorUbigeo", "Home")';

    function renderOptions(select, rows, emptyText) {
        select.innerHTML = '';
        const first = document.createElement('option');
        first.value = '';
        first.textContent = emptyText;
        select.appendChild(first);

        (rows || []).forEach(x => {
            const opt = document.createElement('option');
            opt.value = x.value || '';
            opt.textContent = x.text || '';
            select.appendChild(opt);
        });
    }

    function normalizeText(value) {
        return (value || '')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/\b(PROVINCIA|PROV|DISTRITO|DIST)\b\.?/gi, '')
            .replace(/\b(PROVINCE|DISTRICT|MUNICIPALITY|MUNICIPIO)\b\.?/gi, '')
            .replace(/\b(DEL|DE|LA|EL|METROPOLITANA)\b/gi, '')
            .replace(/\s+/g, ' ')
            .trim()
            .toUpperCase();
    }

    function findOptionValueByText(select, targetText) {
        const targetNorm = normalizeText(targetText);
        if (!targetNorm) return '';
        for (const option of Array.from(select.options)) {
            if (normalizeText(option.textContent || '') === targetNorm) {
                return option.value || '';
            }
        }
        return '';
    }

    function setUbicacionEstado(text, type = 'muted') {
        if (!ubicacionActualEstado) return;
        ubicacionActualEstado.className = type === 'error' ? 'form-text text-danger' : 'form-text';
        ubicacionActualEstado.textContent = text || '';
    }

    function desactivarFiltroCercania() {
        if (buscarCercaDeMiInput) buscarCercaDeMiInput.value = 'false';
    }

    function setCoordenadasUsuario(latitud, longitud) {
        if (latitudUsuarioInput) latitudUsuarioInput.value = Number(latitud).toFixed(7);
        if (longitudUsuarioInput) longitudUsuarioInput.value = Number(longitud).toFixed(7);
    }

    function getRadioKmEfectivo() {
        const radio = radioKmInput?.value || '';
        return radio.length > 0 ? radio : '5';
    }

    async function refreshNegocios() {
        if (!negocio) return;
        const seleccionadoActual = (negocio.value || '').trim();
        const query = new URLSearchParams({
            codigoDepartamento: (dep?.value || '').trim(),
            codigoProvincia: (prov?.value || '').trim(),
            codigoUbigeo: (dist?.value || '').trim()
        });

        const response = await fetch(`${urlNegocios}?${query.toString()}`, { cache: 'no-store' });
        if (!response.ok) return;
        const data = await response.json();
        renderOptions(negocio, data, 'Todos');

        if (seleccionadoActual.length > 0 && data.some(x => (x.value || '') === seleccionadoActual)) {
            negocio.value = seleccionadoActual;
        }

        actualizarEstadoFiltroHorario();
    }

    let primerRefreshNegociosEjecutado = false;
    const ejecutarPrimerRefreshNegocios = () => {
        if (primerRefreshNegociosEjecutado) return;
        primerRefreshNegociosEjecutado = true;
        void refreshNegocios();
    };

    const programarRefreshNegociosDiferido = () => {
        if ('requestIdleCallback' in window) {
            window.requestIdleCallback(() => ejecutarPrimerRefreshNegocios(), { timeout: 1200 });
            return;
        }
        window.setTimeout(ejecutarPrimerRefreshNegocios, 600);
    };

    async function autoSeleccionarUbigeoPorNombres(departamentoNombre, provinciaNombre, distritoNombre) {
        const depValue = findOptionValueByText(dep, departamentoNombre);
        if (!depValue) {
            setUbicacionEstado('No se pudo mapear el departamento detectado. Ajusta el ubigeo manualmente.', 'error');
            return;
        }

        dep.value = depValue;
        renderOptions(prov, [], 'Todas');
        renderOptions(dist, [], 'Todos');

        const responseProv = await fetch(`${urlProv}?codigoDepartamento=${encodeURIComponent(depValue)}`, { cache: 'no-store' });
        if (!responseProv.ok) {
            setUbicacionEstado('No se pudieron cargar provincias para tu ubicacion.', 'error');
            return;
        }
        const dataProv = await responseProv.json();
        renderOptions(prov, dataProv, 'Todas');

        const provinciaValue = findOptionValueByText(prov, provinciaNombre);

        const tryDistritoEnProvincia = async (provinciaCodigo) => {
            const responseDist = await fetch(`${urlDist}?codigoProvincia=${encodeURIComponent(provinciaCodigo)}`, { cache: 'no-store' });
            if (!responseDist.ok) return false;
            const dataDist = await responseDist.json();
            renderOptions(dist, dataDist, 'Todos');
            const distritoValue = findOptionValueByText(dist, distritoNombre);
            if (!distritoValue) return false;
            prov.value = provinciaCodigo;
            dist.value = distritoValue;
            return true;
        };

        if (provinciaValue) {
            const ok = await tryDistritoEnProvincia(provinciaValue);
            if (ok) {
                await refreshNegocios();
                return;
            }
        }

        for (const item of (dataProv || [])) {
            const codigo = item.value || '';
            if (!codigo || codigo === provinciaValue) continue;
            const ok = await tryDistritoEnProvincia(codigo);
            if (ok) {
                await refreshNegocios();
                return;
            }
        }

        setUbicacionEstado('Ubicacion detectada parcialmente. Completa provincia/distrito manualmente.', 'error');
        await refreshNegocios();
    }

    async function usarUbicacionActual() {
        if (!btnUbicacionActual) return;
        if (!navigator.geolocation) {
            setUbicacionEstado('Tu navegador no soporta geolocalizacion.', 'error');
            return;
        }

        btnUbicacionActual.disabled = true;
        setUbicacionEstado('Detectando ubicacion...');

        navigator.geolocation.getCurrentPosition(async (position) => {
            try {
                const lat = position.coords.latitude;
                const lon = position.coords.longitude;
                setCoordenadasUsuario(lat, lon);
                const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lon)}&accept-language=es`;
                const response = await fetch(url, { headers: { 'Accept': 'application/json' } });
                if (!response.ok) {
                    setUbicacionEstado('No se pudo resolver tu direccion automaticamente.', 'error');
                    return;
                }

                const data = await response.json();
                const address = data?.address || {};
                const departamento = address.state || address.region || '';
                const provincia = address.county || address.state_district || '';
                const distrito = address.city_district || address.suburb || address.city || address.town || address.village || '';

                if (!departamento) {
                    setUbicacionEstado('No se pudo detectar departamento desde tu ubicacion.', 'error');
                    return;
                }

                await autoSeleccionarUbigeoPorNombres(departamento, provincia, distrito);
                desactivarFiltroCercania();
                setUbicacionEstado('Ubicacion detectada. Verifica provincia/distrito antes de buscar.');
            } catch {
                setUbicacionEstado('No se pudo completar la deteccion de ubicacion.', 'error');
            } finally {
                btnUbicacionActual.disabled = false;
            }
        }, () => {
            btnUbicacionActual.disabled = false;
            setUbicacionEstado('No se obtuvo permiso para usar tu ubicacion.', 'error');
        }, {
            enableHighAccuracy: false,
            timeout: 12000,
            maximumAge: 600000
        });
    }

    function buscarCercaDeMi() {
        if (!btnBuscarCercaDeMi || !navigator.geolocation) {
            setUbicacionEstado('Tu navegador no soporta geolocalizacion.', 'error');
            return;
        }

        btnBuscarCercaDeMi.disabled = true;
        setUbicacionEstado('Obteniendo tu ubicacion para buscar espacios cercanos...');

        navigator.geolocation.getCurrentPosition((position) => {
            try {
                const lat = position.coords.latitude;
                const lon = position.coords.longitude;
                setCoordenadasUsuario(lat, lon);
                if (buscarCercaDeMiInput) buscarCercaDeMiInput.value = 'true';
                if (radioKmInput && !radioKmInput.value) {
                    radioKmInput.value = getRadioKmEfectivo();
                }
                setUbicacionEstado('Buscando espacios cercanos a tu ubicacion actual...');
                homeSearchForm?.submit();
            } finally {
                btnBuscarCercaDeMi.disabled = false;
            }
        }, () => {
            btnBuscarCercaDeMi.disabled = false;
            setUbicacionEstado('No se obtuvo permiso para usar tu ubicacion.', 'error');
        }, {
            enableHighAccuracy: true,
            timeout: 12000,
            maximumAge: 120000
        });
    }

    dep.addEventListener('change', async () => {
        desactivarFiltroCercania();
        const value = (dep.value || '').trim();
        renderOptions(prov, [], 'Todas');
        renderOptions(dist, [], 'Todos');
        await refreshNegocios();
        if (value.length !== 2) return;

        const response = await fetch(`${urlProv}?codigoDepartamento=${encodeURIComponent(value)}`, { cache: 'no-store' });
        if (!response.ok) return;
        const data = await response.json();
        renderOptions(prov, data, 'Todas');
    });

    prov.addEventListener('change', async () => {
        desactivarFiltroCercania();
        const value = (prov.value || '').trim();
        renderOptions(dist, [], 'Todos');
        await refreshNegocios();
        if (value.length !== 4) return;

        const response = await fetch(`${urlDist}?codigoProvincia=${encodeURIComponent(value)}`, { cache: 'no-store' });
        if (!response.ok) return;
        const data = await response.json();
        renderOptions(dist, data, 'Todos');
    });

    dist.addEventListener('change', () => {
        desactivarFiltroCercania();
        refreshNegocios();
    });
    negocio?.addEventListener('change', desactivarFiltroCercania);
    ['focus', 'pointerdown', 'touchstart', 'keydown'].forEach((evtName) => {
        dep.addEventListener(evtName, ejecutarPrimerRefreshNegocios, { once: true, passive: true });
        prov.addEventListener(evtName, ejecutarPrimerRefreshNegocios, { once: true, passive: true });
        dist.addEventListener(evtName, ejecutarPrimerRefreshNegocios, { once: true, passive: true });
        negocio?.addEventListener(evtName, ejecutarPrimerRefreshNegocios, { once: true, passive: true });
    });
    radioKmInput?.addEventListener('change', () => {
        if (buscarCercaDeMiInput?.value === 'true') {
            homeSearchForm?.submit();
        }
    });

    function actualizarEstadoFiltroHorario() {
        if (!omitirFechaHorario) return;
        const deshabilitarCampos = omitirFechaHorario.checked;
        if (fechaFiltro) fechaFiltro.disabled = deshabilitarCampos;
        if (horaInicioFiltro) horaInicioFiltro.disabled = deshabilitarCampos;
        if (horaFinFiltro) horaFinFiltro.disabled = deshabilitarCampos;
    }

    negocio?.addEventListener('change', actualizarEstadoFiltroHorario);
    omitirFechaHorario?.addEventListener('change', actualizarEstadoFiltroHorario);
    btnUbicacionActual?.addEventListener('click', usarUbicacionActual);
    btnBuscarCercaDeMi?.addEventListener('click', buscarCercaDeMi);
    homeSearchForm?.addEventListener('submit', garantizarAnclaResultados);
    actualizarEstadoFiltroHorario();
    garantizarAnclaResultados();
    programarRefreshNegociosDiferido();
})();

(() => {
    document.addEventListener('click', async (event) => {
        const link = event.target instanceof Element
            ? event.target.closest('a.home-page-link')
            : null;
        if (!link) return;
        if (link.classList.contains('is-disabled')) {
            event.preventDefault();
            return;
        }

        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        if (link.target && link.target !== '_self') return;

        event.preventDefault();

        try {
            const response = await fetch(link.href, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                cache: 'no-store'
            });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);

            const html = await response.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const nuevosResultados = doc.getElementById('resultados');
            const resultadosActuales = document.getElementById('resultados');

            if (!nuevosResultados || !resultadosActuales) throw new Error('No se encontro la seccion de resultados.');

            resultadosActuales.replaceWith(nuevosResultados);
            history.replaceState(null, '', link.href);
        } catch {
            window.location.href = link.href;
        }
    });
})();

(() => {
    if (!window.location.hash || window.location.hash !== '#resultados') return;
    const resultados = document.getElementById('resultados');
    if (!resultados) return;
    window.requestAnimationFrame(() => {
        resultados.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
})();

(() => {
    document.querySelectorAll('.js-detalle-toggle').forEach((btn) => {
        const selector = btn.getAttribute('data-bs-target');
        if (!selector) return;
        const panel = document.querySelector(selector);
        if (!panel) return;

        const syncLabel = () => {
            const expanded = btn.getAttribute('aria-expanded') === 'true' || panel.classList.contains('show');
            btn.textContent = expanded ? 'Ocultar detalle' : 'Ver detalle';
        };

        panel.addEventListener('shown.bs.collapse', syncLabel);
        panel.addEventListener('hidden.bs.collapse', syncLabel);
        syncLabel();
    });
})();
</script>
