@model SistemaControlEspaciosDeportivosWeb.ViewModels.HomeIndexViewModel
@using System.Linq
@using System.Globalization
@using System

@{
    ViewData["Title"] = "Portal deportivo";
    var horasMediaHora = Enumerable.Range(0, 48)
        .Select(i => TimeOnly.FromTimeSpan(TimeSpan.FromMinutes(i * 30)))
        .ToList();
    var banners = Model.Banners?.Where(x => !string.IsNullOrWhiteSpace(x.ImagenUrl)).OrderBy(x => x.Orden).ThenBy(x => x.Id).ToList()
        ?? new List<SistemaControlEspaciosDeportivosWeb.ViewModels.WebBannerPublicoViewModel>();
}
<!-- Firma: Codex - 14/04/2026 | Home publico con mini carrusel de fotos por sede en tarjetas de espacios disponibles. -->
<!-- Firma: Codex - 15/04/2026 | Resultado publico simplificado: boton Reservar ahora (sin formulario embebido) y retiro del bloque Consideraciones en las tarjetas para reducir carga visual. -->
<!-- Firma: Codex - 15/04/2026 | Home agrega bloque 'Busqueda por dia y horario' con opcion de omitir filtro cuando se selecciona club/negocio. -->
<!-- Firma: Codex - 15/04/2026 | Home renovado: titulos profesionales, paginacion de 12, bloque de beneficios y CTA/footer administrable desde super admin. -->
<!-- Firma: Codex - 15/04/2026 | Seccion de beneficios (6 tarjetas fijas) configurable por parametros globales HOME_PORTAL_BENEF_*. -->

<section class="home-hero mb-4">
    <div id="homeHeroCarousel" class="carousel slide home-hero-carousel h-100" data-bs-ride="carousel" data-bs-interval="5500">
        <div class="carousel-inner rounded-4 h-100">
                    @if (banners.Count == 0)
                    {
                        <div class="carousel-item active h-100">
                            <div class="home-hero-slide home-hero-slide-1">
                                <div>
                                    <span class="home-hero-kicker">Reserva inteligente</span>
                                    <h1>Encuentra tu espacio deportivo en segundos</h1>
                                    <p>Filtra por ubicacion y deporte, valida disponibilidad en tiempo real y reserva al instante.</p>
                                </div>
                                <div class="d-flex gap-2 flex-wrap">
                                    <a href="#buscar" class="btn btn-light fw-semibold">Buscar espacios</a>
                                    <a asp-action="ConsultarSolicitud" class="btn btn-outline-light fw-semibold">Consultar solicitud</a>
                                </div>
                            </div>
                        </div>
                        <div class="carousel-item h-100">
                            <div class="home-hero-slide home-hero-slide-2">
                                <div>
                                    <span class="home-hero-kicker">Promociones activas</span>
                                    <h2>Juega en los mejores horarios con ofertas del dia</h2>
                                    <p>Descubre complejos cercanos, revisa atributos del campo y reserva con la mejor tarifa disponible.</p>
                                </div>
                                <div class="d-flex gap-2 flex-wrap">
                                    <a href="#resultados" class="btn btn-light fw-semibold">Ver destacados</a>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        var idx = 0;
                        foreach (var banner in banners)
                        {
                            var imageUrlDesktop = Url.Action("VerImagen", "Sedes", new { url = banner.ImagenUrl }) ?? string.Empty;
                            var imageUrlMobile = string.IsNullOrWhiteSpace(banner.ImagenUrlMobile)
                                ? imageUrlDesktop
                                : (Url.Action("VerImagen", "Sedes", new { url = banner.ImagenUrlMobile }) ?? imageUrlDesktop);
                            var botonTexto = string.IsNullOrWhiteSpace(banner.BotonTexto) ? "Explorar espacios" : banner.BotonTexto;
                            var botonUrl = string.IsNullOrWhiteSpace(banner.BotonUrl) ? "#buscar" : banner.BotonUrl;
                            var esExterno = botonUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || botonUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
                            var target = esExterno ? "_blank" : "_self";
                            var rel = esExterno ? "noopener noreferrer" : null;
                            <div class="carousel-item h-100 @(idx == 0 ? "active" : null)">
                                <div class="home-hero-slide home-hero-slide-dynamic"
                                     data-bg-desktop="@imageUrlDesktop"
                                     data-bg-mobile="@imageUrlMobile"
                                     style="background-image:linear-gradient(120deg,rgba(4,13,32,.42),rgba(10,38,86,.28)), url('@imageUrlDesktop');">
                                    <div>
                                        @if (!string.IsNullOrWhiteSpace(banner.Subtitulo))
                                        {
                                            <span class="home-hero-kicker">@banner.Subtitulo</span>
                                        }
                                        <h1>@banner.Titulo</h1>
                                        @if (!string.IsNullOrWhiteSpace(banner.Descripcion))
                                        {
                                            <p>@banner.Descripcion</p>
                                        }
                                    </div>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <a href="@botonUrl" target="@target" rel="@rel" class="btn btn-light fw-semibold">@botonTexto</a>
                                        <a asp-action="ConsultarSolicitud" class="btn btn-outline-light fw-semibold">Consultar solicitud</a>
                                    </div>
                                </div>
                            </div>
                            idx++;
                        }
                    }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</section>

<div class="container py-4">

@if (!string.IsNullOrWhiteSpace(Model.MensajeSolicitud))
{
    <div class="alert alert-success">@Model.MensajeSolicitud</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
}

<section id="buscar" class="card border-0 shadow-sm mb-4 home-search-card">
    <div class="card-body">
        <div class="home-section-head mb-3">
            <span class="home-section-kicker"><i class="bi bi-compass"></i>Busqueda inteligente</span>
            <h2 class="home-section-title mb-0">Buscar por zona y deporte</h2>
            <p class="home-section-subtitle mb-0">Ubica canchas por departamento, provincia, distrito y tipo de deporte en una sola consulta.</p>
        </div>

        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Departamento</label>
                <select class="form-select" id="codigoDepartamento" name="codigoDepartamento">
                    <option value="">Todos</option>
                    @foreach (var dep in Model.DepartamentosUbigeo)
                    {
                        <option value="@dep.Value" selected="@(Model.CodigoDepartamento == dep.Value)">@dep.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Provincia</label>
                <select class="form-select" id="codigoProvincia" name="codigoProvincia">
                    <option value="">Todas</option>
                    @foreach (var prov in Model.ProvinciasUbigeo)
                    {
                        <option value="@prov.Value" selected="@(Model.CodigoProvincia == prov.Value)">@prov.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Distrito</label>
                <select class="form-select" id="codigoUbigeo" name="codigoUbigeo">
                    <option value="">Todos</option>
                    @foreach (var dist in Model.DistritosUbigeo)
                    {
                        <option value="@dist.Value" selected="@(Model.CodigoUbigeo == dist.Value)">@dist.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Tipo de deporte</label>
                <select class="form-select" name="tipoDeporteId">
                    <option value="">Todos</option>
                    @foreach (var deporte in Model.TiposDeporte)
                    {
                        <option value="@deporte.Id" selected="@(Model.TipoDeporteId == deporte.Id)">@deporte.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Club / negocio</label>
                <select class="form-select" id="negocioId" name="negocioId">
                    <option value="">Todos</option>
                    @foreach (var negocio in Model.Negocios)
                    {
                        if (int.TryParse(negocio.Value, out var negocioIdOption) && Model.NegocioId == negocioIdOption)
                        {
                            <option value="@negocio.Value" selected="selected">@negocio.Text</option>
                        }
                        else
                        {
                            <option value="@negocio.Value">@negocio.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-12">
                <div class="border rounded-3 p-3 bg-light-subtle">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                        <h3 class="home-subsection-title mb-0"><i class="bi bi-calendar-week me-1"></i>Busqueda por dia y horario</h3>
                        <div class="form-check mb-0">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="omitirFechaHorario"
                                   name="omitirFechaHorario"
                                   value="true"
                                   @(Model.OmitirFechaHorario ? "checked" : null) />
                            <label class="form-check-label small" for="omitirFechaHorario">Obviar filtro de dia y horario para ver todos los espacios del club</label>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Fecha</label>
                            <input class="form-control" type="date" id="fechaFiltro" name="fecha" value="@Model.Fecha.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Hora inicio</label>
                            <select class="form-select" id="horaInicioFiltro" name="horaInicio">
                                @foreach (var hora in horasMediaHora)
                                {
                                    var valor = hora.ToString("HH\\:mm");
                                    if (hora == Model.HoraInicio)
                                    {
                                        <option value="@valor" selected="selected">@valor</option>
                                    }
                                    else
                                    {
                                        <option value="@valor">@valor</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Hora fin</label>
                            <select class="form-select" id="horaFinFiltro" name="horaFin">
                                @foreach (var hora in horasMediaHora)
                                {
                                    var valor = hora.ToString("HH\\:mm");
                                    if (hora == Model.HoraFin)
                                    {
                                        <option value="@valor" selected="selected">@valor</option>
                                    }
                                    else
                                    {
                                        <option value="@valor">@valor</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-text mt-2">Si seleccionas club/negocio puedes marcar "obviar" para explorar todos sus espacios y luego revisar disponibilidad al reservar.</div>
                </div>
            </div>
            <div class="col-md-12 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Buscar espacios deportivos</button>
            </div>
        </form>
    </div>
</section>

<section id="resultados" class="mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h2 class="home-section-title mb-0"><i class="bi bi-grid-3x3-gap-fill me-1"></i>Espacios disponibles</h2>
        <span class="badge text-bg-primary">@Model.TotalResultados resultado(s)</span>
    </div>

    @if (Model.Disponibles.Count == 0)
    {
        <div class="alert alert-warning mb-0">
            No hay espacios disponibles con los filtros seleccionados.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model.Disponibles)
            {
                var carouselId = $"sedeFotos-{item.EspacioDeportivoId}";
                var numeroWhatsappEspacio = string.IsNullOrWhiteSpace(item.WhatsappContacto)
                    ? string.Empty
                    : new string(item.WhatsappContacto.Where(char.IsDigit).ToArray());
                var mensajeWhatsappEspacio = Uri.EscapeDataString($"Hola, quiero reservar {item.NombreEspacio} en la sede {item.SedeNombre} para {Model.Fecha:dd/MM/yyyy} de {Model.HoraInicio:HH\\:mm} a {Model.HoraFin:HH\\:mm}.");
                var enlaceWhatsappEspacio = string.IsNullOrWhiteSpace(numeroWhatsappEspacio)
                    ? string.Empty
                    : $"https://wa.me/{numeroWhatsappEspacio}?text={mensajeWhatsappEspacio}";
                var sedeRef = item.SedeId.HasValue
                    ? Model.Sedes.FirstOrDefault(x => x.Id == item.SedeId.Value)
                    : null;
                var mapaUrl = sedeRef?.GoogleMapsUrl;
                if (string.IsNullOrWhiteSpace(mapaUrl) && sedeRef?.Latitud is decimal lat && sedeRef.Longitud is decimal lng)
                {
                    mapaUrl = $"https://www.google.com/maps?q={lat.ToString(CultureInfo.InvariantCulture)},{lng.ToString(CultureInfo.InvariantCulture)}";
                }
                var sedeFotos = new List<string>();
                if (!string.IsNullOrWhiteSpace(item.SedeFotoPrincipalUrl))
                {
                    sedeFotos.Add(item.SedeFotoPrincipalUrl);
                }
                if (item.SedeFotos is not null && item.SedeFotos.Count > 0)
                {
                    sedeFotos.AddRange(item.SedeFotos.Where(x => !string.IsNullOrWhiteSpace(x)));
                }
                sedeFotos = sedeFotos
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();

                <div class="col-md-6 col-xl-4">
                    <article class="card h-100 border-0 shadow-sm home-space-card">
                        <div class="card-body d-flex flex-column">
                            @if (sedeFotos.Count > 0)
                            {
                                <div class="home-space-media mb-3">
                                    @if (sedeFotos.Count == 1)
                                    {
                                        <img src="@(Url.Action("VerImagen", "Sedes", new { url = sedeFotos[0] }))"
                                             alt="Foto de @item.SedeNombre"
                                             class="home-space-media-img" />
                                    }
                                    else
                                    {
                                        <div id="@carouselId" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3500">
                                            <div class="carousel-inner">
                                                @for (var fotoIdx = 0; fotoIdx < sedeFotos.Count; fotoIdx++)
                                                {
                                                    var foto = sedeFotos[fotoIdx];
                                                    <div class="carousel-item @(fotoIdx == 0 ? "active" : null)">
                                                        <img src="@(Url.Action("VerImagen", "Sedes", new { url = foto }))"
                                                             alt="Foto @(fotoIdx + 1) de @item.SedeNombre"
                                                             class="home-space-media-img" />
                                                    </div>
                                                }
                                            </div>
                                            <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                                                <span class="carousel-control-prev-icon"></span>
                                            </button>
                                            <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                                                <span class="carousel-control-next-icon"></span>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div>
                                    <span class="home-item-label">Nombre del espacio</span>
                                    <h3 class="h6 fw-bold mb-1 home-item-title">@item.NombreEspacio</h3>
                                    <span class="home-space-code">@item.Codigo</span>
                                </div>
                                <span class="badge text-bg-success">Disponible</span>
                            </div>

                            <div class="home-sede-head mb-1">
                                <p class="mb-0 home-item-sede">
                                    <span class="home-item-label">Nombre de sede</span>
                                    @item.SedeNombre
                                </p>
                                @if (!string.IsNullOrWhiteSpace(mapaUrl))
                                {
                                    <a class="btn btn-outline-primary btn-sm home-map-btn"
                                       href="@mapaUrl"
                                       target="_blank"
                                       rel="noopener noreferrer">Ver en mapa</a>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.SedeDireccion))
                            {
                                <p class="mb-1 text-muted small">@item.SedeDireccion</p>
                            }
                            <p class="mb-2 text-muted small">
                                @string.Join(" / ", new[] { item.Departamento, item.Provincia, item.Distrito }.Where(x => !string.IsNullOrWhiteSpace(x)))
                            </p>

                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <span class="badge text-bg-light border">@item.TipoDeporteNombre</span>
                                @if (!string.IsNullOrWhiteSpace(item.TipoSueloNombre))
                                {
                                    <span class="badge text-bg-light border">@item.TipoSueloNombre</span>
                                }
                                <span class="badge text-bg-light border">@(item.Techada ? "Techada" : "No techada")</span>
                                <span class="badge text-bg-light border">@(item.TieneIluminacion ? "Iluminacion" : "Sin iluminacion")</span>
                            </div>

                            @if (item.TarifaDesde.HasValue)
                            {
                                <p class="mb-2 home-price-from">
                                    <span class="home-item-label">Precio por hora</span>
                                    Desde <strong>S/ @item.TarifaDesde.Value.ToString("0.00", CultureInfo.InvariantCulture)</strong>
                                </p>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.CorreoNotificacion) || !string.IsNullOrWhiteSpace(item.WhatsappContacto))
                            {
                                <div class="home-contact-box mb-2">
                                    <span class="home-item-label">Contacto</span>
                                    @if (!string.IsNullOrWhiteSpace(item.CorreoNotificacion))
                                    {
                                        <div><strong>Correo:</strong> @item.CorreoNotificacion</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.WhatsappContacto))
                                    {
                                        <div><strong>WhatsApp:</strong> @item.WhatsappContacto</div>
                                    }
                                </div>
                            }

                            <div class="mt-auto">
                                <a class="btn btn-primary btn-sm"
                                   asp-action="Reservar"
                                   asp-route-espacioDeportivoId="@item.EspacioDeportivoId"
                                   asp-route-fecha="@Model.Fecha.ToString("yyyy-MM-dd")"
                                   asp-route-horaInicio="@Model.HoraInicio.ToString("HH\\:mm")"
                                   asp-route-horaFin="@Model.HoraFin.ToString("HH\\:mm")"
                                   asp-route-codigoDepartamento="@Model.CodigoDepartamento"
                                   asp-route-codigoProvincia="@Model.CodigoProvincia"
                                   asp-route-codigoUbigeo="@Model.CodigoUbigeo"
                                   asp-route-tipoDeporteId="@Model.TipoDeporteId"
                                   asp-route-negocioId="@Model.NegocioId"
                                   asp-route-omitirFechaHorario="@Model.OmitirFechaHorario">
                                    Reservar ahora
                                </a>
                                @if (item.PermiteChatWhatsapp && !string.IsNullOrWhiteSpace(numeroWhatsappEspacio))
                                {
                                    <a class="btn btn-success btn-sm ms-2"
                                       href="@enlaceWhatsappEspacio"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        WhatsApp
                                    </a>
                                }
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }

    @if (Model.TotalPaginas > 1)
    {
        <nav class="mt-4 d-flex justify-content-center" aria-label="Paginacion de espacios">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : null)">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-fecha="@Model.Fecha.ToString("yyyy-MM-dd")"
                       asp-route-horaInicio="@Model.HoraInicio.ToString("HH\\:mm")"
                       asp-route-horaFin="@Model.HoraFin.ToString("HH\\:mm")"
                       asp-route-codigoDepartamento="@Model.CodigoDepartamento"
                       asp-route-codigoProvincia="@Model.CodigoProvincia"
                       asp-route-codigoUbigeo="@Model.CodigoUbigeo"
                       asp-route-tipoDeporteId="@Model.TipoDeporteId"
                       asp-route-negocioId="@Model.NegocioId"
                       asp-route-omitirFechaHorario="@Model.OmitirFechaHorario"
                       asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                </li>

                @for (var p = 1; p <= Model.TotalPaginas; p++)
                {
                    <li class="page-item @(p == Model.PaginaActual ? "active" : null)">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-fecha="@Model.Fecha.ToString("yyyy-MM-dd")"
                           asp-route-horaInicio="@Model.HoraInicio.ToString("HH\\:mm")"
                           asp-route-horaFin="@Model.HoraFin.ToString("HH\\:mm")"
                           asp-route-codigoDepartamento="@Model.CodigoDepartamento"
                           asp-route-codigoProvincia="@Model.CodigoProvincia"
                           asp-route-codigoUbigeo="@Model.CodigoUbigeo"
                           asp-route-tipoDeporteId="@Model.TipoDeporteId"
                           asp-route-negocioId="@Model.NegocioId"
                           asp-route-omitirFechaHorario="@Model.OmitirFechaHorario"
                           asp-route-pagina="@p">@p</a>
                    </li>
                }

                <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : null)">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-fecha="@Model.Fecha.ToString("yyyy-MM-dd")"
                       asp-route-horaInicio="@Model.HoraInicio.ToString("HH\\:mm")"
                       asp-route-horaFin="@Model.HoraFin.ToString("HH\\:mm")"
                       asp-route-codigoDepartamento="@Model.CodigoDepartamento"
                       asp-route-codigoProvincia="@Model.CodigoProvincia"
                       asp-route-codigoUbigeo="@Model.CodigoUbigeo"
                       asp-route-tipoDeporteId="@Model.TipoDeporteId"
                       asp-route-negocioId="@Model.NegocioId"
                       asp-route-omitirFechaHorario="@Model.OmitirFechaHorario"
                       asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</section>

<section class="home-benefits-section mb-4">
    <div class="home-benefits-head">
        <h2>@Model.PortalConfig.BeneficiosTitulo</h2>
        <p>@Model.PortalConfig.BeneficiosSubtitulo</p>
    </div>
    <div class="home-benefits-grid">
        <article class="home-benefit-card">
            <div class="home-benefit-icon"><i class="bi bi-calendar-check"></i></div>
            <h3>@Model.PortalConfig.Beneficio1Titulo</h3>
            <p>@Model.PortalConfig.Beneficio1Detalle</p>
        </article>
        <article class="home-benefit-card">
            <div class="home-benefit-icon"><i class="bi bi-geo-alt"></i></div>
            <h3>@Model.PortalConfig.Beneficio2Titulo</h3>
            <p>@Model.PortalConfig.Beneficio2Detalle</p>
        </article>
        <article class="home-benefit-card">
            <div class="home-benefit-icon"><i class="bi bi-shield-check"></i></div>
            <h3>@Model.PortalConfig.Beneficio3Titulo</h3>
            <p>@Model.PortalConfig.Beneficio3Detalle</p>
        </article>
        <article class="home-benefit-card">
            <div class="home-benefit-icon"><i class="bi bi-stars"></i></div>
            <h3>@Model.PortalConfig.Beneficio4Titulo</h3>
            <p>@Model.PortalConfig.Beneficio4Detalle</p>
        </article>
        <article class="home-benefit-card">
            <div class="home-benefit-icon"><i class="bi bi-bar-chart"></i></div>
