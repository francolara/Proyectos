@model SistemaControlEspaciosDeportivosWeb.ViewModels.HomeIndexViewModel
@inject Microsoft.Extensions.Options.IOptions<SistemaControlEspaciosDeportivosWeb.Services.SedeImagenStorageSettings> SedeImagenStorageOptions
@using System.Linq
@using System.Globalization
@using System

@{
    ViewData["Title"] = "Portal deportivo";
    var horasMediaHora = Enumerable.Range(0, 48)
        .Select(i => TimeOnly.FromTimeSpan(TimeSpan.FromMinutes(i * 30)))
        .ToList();
    var banners = Model.Banners?.Where(x => !string.IsNullOrWhiteSpace(x.ImagenUrl)).OrderBy(x => x.Orden).ThenBy(x => x.Id).ToList()
        ?? new List<SistemaControlEspaciosDeportivosWeb.ViewModels.WebBannerPublicoViewModel>();
    var ctaClubUrl = (Model.PortalConfig.CtaBotonClubUrl ?? string.Empty).Trim();
    if (string.IsNullOrWhiteSpace(ctaClubUrl) || ctaClubUrl.Equals("/Home/SoftwareClubes", StringComparison.OrdinalIgnoreCase))
    {
        ctaClubUrl = "/Identity/Account/Register?TipoRegistro=club";
    }
    var popupPromociones = Model.PopupPromociones?.Where(x => !string.IsNullOrWhiteSpace(x.ImagenUrl)).OrderBy(x => x.Orden).ThenByDescending(x => x.IdPopupPromocion).ToList()
        ?? new List<SistemaControlEspaciosDeportivosWeb.ViewModels.PopupPromocionPublicoViewModel>();
    var heroLcpDesktopUrl = banners.Count > 0
        ? (SistemaControlEspaciosDeportivosWeb.Services.SedeImagenUrlHelper.NormalizarUrlPublica(
            banners[0].ImagenUrl,
            SedeImagenStorageOptions.Value.PublicBaseUrl,
            SedeImagenStorageOptions.Value.BucketName) ?? string.Empty)
        : string.Empty;
    var heroLcpMobileUrl = banners.Count > 0
        ? (string.IsNullOrWhiteSpace(banners[0].ImagenUrlMobile)
            ? heroLcpDesktopUrl
            : (SistemaControlEspaciosDeportivosWeb.Services.SedeImagenUrlHelper.NormalizarUrlPublica(
                banners[0].ImagenUrlMobile,
                SedeImagenStorageOptions.Value.PublicBaseUrl,
                SedeImagenStorageOptions.Value.BucketName) ?? heroLcpDesktopUrl))
        : string.Empty;
    var esUsuarioAutenticado = User?.Identity?.IsAuthenticated ?? false;
    var mostrarPromosNav = popupPromociones.Count > 0;
    var habilitarPopupAutomatico = !esUsuarioAutenticado && popupPromociones.Count > 0;
    var popupConfig = Model.PopupPromocionesConfig ?? new SistemaControlEspaciosDeportivosWeb.ViewModels.PopupPromocionConfigViewModel();
    var popupPromocionesVersion = popupPromociones.Count == 0
        ? string.Empty
        : string.Join("|", popupPromociones.Select(x => $"{x.IdPopupPromocion}:{x.Orden}:{x.Orientacion}:{(x.ImagenUrl ?? string.Empty)}"));
    var whatsappAnunciosMensaje = Uri.EscapeDataString("Hola, quiero anunciar en SportCenter. �Podrian brindarme informacion sobre planes, alcance y condiciones para publicar mi anuncio?");
    var whatsappHomeConfigurado = (Model.PortalConfig.SiguenosWhatsappUrl ?? string.Empty).Trim();
    var whatsappAnunciosUrl = whatsappHomeConfigurado;
    if (!string.IsNullOrWhiteSpace(whatsappHomeConfigurado))
    {
        var whatsappNumero = new string(whatsappHomeConfigurado.Where(char.IsDigit).ToArray());
        if (!string.IsNullOrWhiteSpace(whatsappNumero))
        {
            whatsappAnunciosUrl = $"https://wa.me/{whatsappNumero}?text={whatsappAnunciosMensaje}";
        }
    }
    if (Uri.TryCreate(whatsappHomeConfigurado, UriKind.Absolute, out var whatsappUriRobusta))
    {
        string? whatsappNumeroConfigurado = null;
        var queryWhatsapp = whatsappUriRobusta.Query?.TrimStart('?') ?? string.Empty;
        foreach (var part in queryWhatsapp.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && string.Equals(kv[0], "phone", StringComparison.OrdinalIgnoreCase))
            {
                whatsappNumeroConfigurado = new string(Uri.UnescapeDataString(kv[1]).Where(char.IsDigit).ToArray());
                break;
            }
        }

        if (string.IsNullOrWhiteSpace(whatsappNumeroConfigurado))
        {
            var pathNumeroWhatsapp = whatsappUriRobusta.AbsolutePath.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
            if (!string.IsNullOrWhiteSpace(pathNumeroWhatsapp))
            {
                whatsappNumeroConfigurado = new string(pathNumeroWhatsapp.Where(char.IsDigit).ToArray());
            }
        }

        if (!string.IsNullOrWhiteSpace(whatsappNumeroConfigurado))
        {
            whatsappAnunciosUrl = $"https://wa.me/{whatsappNumeroConfigurado}?text={Uri.EscapeDataString("Hola, quiero anunciar en SportCenter. �Podr�an brindarme informaci�n sobre planes, alcance y condiciones para publicar mi anuncio?")}";
        }
    }
}
@section Styles {
    @if (!string.IsNullOrWhiteSpace(heroLcpDesktopUrl))
    {
        <link rel="preload" as="image" href="@heroLcpDesktopUrl" fetchpriority="high" />
    }
    @if (!string.IsNullOrWhiteSpace(heroLcpMobileUrl) && !string.Equals(heroLcpMobileUrl, heroLcpDesktopUrl, StringComparison.OrdinalIgnoreCase))
    {
        <link rel="preload" as="image" href="@heroLcpMobileUrl" media="(max-width: 576px)" fetchpriority="high" />
    }
}
<section class="home-hero mb-4">
    <div id="homeHeroCarousel" class="carousel slide home-hero-carousel h-100" data-bs-ride="carousel" data-bs-interval="5500" data-bs-touch="false">
        <div class="carousel-inner rounded-4 h-100">
                    @if (banners.Count == 0)
                    {
                        <div class="carousel-item active h-100">
                            <div class="home-hero-slide home-hero-slide-1">
                                <div>
                                    <span class="home-hero-kicker">Reserva inteligente</span>
                                    <h1>Encuentra tu espacio deportivo en segundos</h1>
                                    <p>Filtra por ubicacion y deporte, valida disponibilidad en tiempo real y reserva al instante.</p>
                                </div>
                                <div class="d-flex gap-2 flex-wrap align-items-center">
                                    <a href="#buscar" class="btn btn-light fw-semibold">Buscar espacios</a>
                                    <a asp-controller="PerfilPublico" asp-action="Index" asp-route-tab="reservas" class="btn btn-outline-light fw-semibold ms-auto js-hero-direct-link">Ver mis reservas</a>
                                </div>
                            </div>
                        </div>
                        <div class="carousel-item h-100">
                            <div class="home-hero-slide home-hero-slide-2">
                                <div>
                                    <span class="home-hero-kicker">Promociones activas</span>
                                    <h2>Juega en los mejores horarios con ofertas del dia</h2>
                                    <p>Descubre complejos cercanos, revisa atributos del campo y reserva con la mejor tarifa disponible.</p>
                                </div>
                                <div class="d-flex gap-2 flex-wrap">
                                    <a href="#resultados" class="btn btn-light fw-semibold">Ver destacados</a>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        var idx = 0;
                        foreach (var banner in banners)
                        {
                            // Antes: URL proxy por backend (mas latencia).
                            // var imageUrlDesktop = Url.Action("VerImagen", "Sedes", new { url = banner.ImagenUrl }) ?? string.Empty;
                            // var imageUrlMobile = string.IsNullOrWhiteSpace(banner.ImagenUrlMobile)
                            //     ? imageUrlDesktop
                            //     : (Url.Action("VerImagen", "Sedes", new { url = banner.ImagenUrlMobile }) ?? imageUrlDesktop);
                            var imageUrlDesktop = SistemaControlEspaciosDeportivosWeb.Services.SedeImagenUrlHelper.NormalizarUrlPublica(
                                banner.ImagenUrl,
                                SedeImagenStorageOptions.Value.PublicBaseUrl,
                                SedeImagenStorageOptions.Value.BucketName) ?? string.Empty;
                            var imageUrlMobile = string.IsNullOrWhiteSpace(banner.ImagenUrlMobile)
                                ? imageUrlDesktop
                                : (SistemaControlEspaciosDeportivosWeb.Services.SedeImagenUrlHelper.NormalizarUrlPublica(
                                    banner.ImagenUrlMobile,
                                    SedeImagenStorageOptions.Value.PublicBaseUrl,
                                    SedeImagenStorageOptions.Value.BucketName) ?? imageUrlDesktop);
                            var botonTexto = string.IsNullOrWhiteSpace(banner.BotonTexto) ? "Explorar espacios" : banner.BotonTexto;
                            var botonUrl = string.IsNullOrWhiteSpace(banner.BotonUrl) ? "#buscar" : banner.BotonUrl;
                            var esExterno = botonUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || botonUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
                            var target = esExterno ? "_blank" : "_self";
                            var rel = esExterno ? "noopener noreferrer" : null;
                            <div class="carousel-item h-100 @(idx == 0 ? "active" : null)">
                                <div class="home-hero-slide home-hero-slide-dynamic"
                                     data-bg-desktop="@imageUrlDesktop"
                                     data-bg-mobile="@imageUrlMobile"
                                     style="background-image:linear-gradient(120deg,rgba(4,13,32,.42),rgba(10,38,86,.28)), url('@imageUrlDesktop');">
                                    @if (idx == 0)
                                    {
                                        <img src="@imageUrlDesktop"
                                             alt=""
                                             aria-hidden="true"
                                             fetchpriority="high"
                                             loading="eager"
                                             decoding="async"
                                             width="1"
                                             height="1"
                                             style="position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;" />
                                    }
                                    <div>
                                        @if (!string.IsNullOrWhiteSpace(banner.Subtitulo))
                                        {
                                            <span class="home-hero-kicker">@banner.Subtitulo</span>
                                        }
                                        <h1>@banner.Titulo</h1>
                                        @if (!string.IsNullOrWhiteSpace(banner.Descripcion))
                                        {
                                            <p>@banner.Descripcion</p>
                                        }
                                    </div>
                                    <div class="d-flex gap-2 flex-wrap align-items-center">
                                        <a href="@botonUrl" target="@target" rel="@rel" class="btn btn-light fw-semibold">@botonTexto</a>
                                        <a asp-controller="PerfilPublico" asp-action="Index" asp-route-tab="reservas" class="btn btn-outline-light fw-semibold ms-auto js-hero-direct-link">Ver mis reservas</a>
                                    </div>
                                </div>
                            </div>
                            idx++;
                        }
                    }
        </div>
        <button class="carousel-control-prev home-hero-control" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="prev" aria-label="Slide anterior del banner principal" title="Slide anterior del banner principal">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>
        <button class="carousel-control-next home-hero-control" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="next" aria-label="Slide siguiente del banner principal" title="Slide siguiente del banner principal">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>
    </div>
</section>

<div class="container py-4">

@if (!string.IsNullOrWhiteSpace(Model.MensajeSolicitud))
{
    <div class="alert alert-success">@Model.MensajeSolicitud</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
}

<section id="buscar" class="card border-0 shadow-sm mb-4 home-search-card">
    <div class="card-body">
        <div class="home-section-head mb-3">
            <div class="home-section-head-top">
                <div>
                    <span class="home-section-kicker"><i class="bi bi-compass"></i>Busqueda inteligente</span>
                    <h2 class="home-section-title mb-0">Buscar por zona y deporte</h2>
                    <p class="home-section-subtitle mb-0">Ubica canchas por departamento, provincia, distrito y tipo de deporte en una sola consulta.</p>
                </div>
                <div class="home-section-head-actions d-flex align-items-end">
                    <div class="home-head-radio-wrap">
                        <label class="home-head-radio-label" for="tipoDeporteId">Tipo de deporte</label>
                        <select class="form-select form-select-sm home-head-radio-select" id="tipoDeporteId" name="tipoDeporteId" form="homeSearchForm">
                            <option value="">Todos</option>
                            @foreach (var deporte in Model.TiposDeporte)
                            {
                                <option value="@deporte.Id" selected="@(Model.TipoDeporteId == deporte.Id)">@deporte.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        <div class="home-head-radio-wrap">
                            <label class="home-head-radio-label" for="radioKm">Radio (km)</label>
                            <select class="form-select form-select-sm home-head-radio-select" id="radioKm" name="radioKm" form="homeSearchForm">
                                @{
                                    var radiosHead = new decimal[] { 3m, 5m, 10m, 20m };
                                    var radioSeleccionadoHead = Model.RadioKm ?? 5m;
                                }
                                @foreach (var radio in radiosHead)
                                {
                                    <option value="@radio.ToString(CultureInfo.InvariantCulture)" selected="@(radioSeleccionadoHead == radio)">@radio km</option>
                                }
                            </select>
                        </div>
                        <button type="button" class="btn auth-nav-mini auth-nav-mini-solid home-head-btn home-nearby-btn w-100" id="btnBuscarCercaDeMi">
                            <i class="bi bi-geo-alt-fill me-1"></i>Buscar cerca de mi
                        </button>
                    </div>
                    <button type="button" class="btn auth-nav-mini auth-nav-mini-outline home-head-btn home-nearby-btn" id="btnUsarUbicacionActual">
                        <i class="bi bi-crosshair me-1"></i>Usar mi ubicacion
                    </button>
                </div>
            </div>
        </div>

        <form asp-action="Index" method="get" class="row g-2 home-search-form-tight" id="homeSearchForm">
            <input type="hidden" id="buscarCercaDeMi" name="buscarCercaDeMi" value="@(Model.BuscarCercaDeMi ? "true" : "false")" />
            <input type="hidden" id="latitudUsuario" name="latitudUsuario" value="@(Model.LatitudUsuario?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" />
            <input type="hidden" id="longitudUsuario" name="longitudUsuario" value="@(Model.LongitudUsuario?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" />
            <div class="col-md-3">
                <label class="form-label" for="codigoDepartamento">Departamento</label>
                <select class="form-select" id="codigoDepartamento" name="codigoDepartamento">
                    <option value="">Todos</option>
                    @foreach (var dep in Model.DepartamentosUbigeo)
                    {
                        <option value="@dep.Value" selected="@(Model.CodigoDepartamento == dep.Value)">@dep.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="codigoProvincia">Provincia</label>
                <select class="form-select" id="codigoProvincia" name="codigoProvincia">
                    <option value="">Todos</option>
                    @foreach (var prov in Model.ProvinciasUbigeo)
                    {
                        <option value="@prov.Value" selected="@(Model.CodigoProvincia == prov.Value)">@prov.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="codigoUbigeo">Distrito</label>
                <select class="form-select" id="codigoUbigeo" name="codigoUbigeo">
                    <option value="">Todos</option>
                    @foreach (var dist in Model.DistritosUbigeo)
                    {
                        <option value="@dist.Value" selected="@(Model.CodigoUbigeo == dist.Value)">@dist.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="negocioId">Complejo Deportivo</label>
                <select class="form-select" id="negocioId" name="negocioId">
                    <option value="">Todos</option>
                    @foreach (var negocio in Model.Negocios)
                    {
                        if (int.TryParse(negocio.Value, out var negocioIdOption) && Model.NegocioId == negocioIdOption)
                        {
                            <option value="@negocio.Value" selected="selected">@negocio.Text</option>
                        }
                        else
                        {
                            <option value="@negocio.Value">@negocio.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 py-0 my-0">
                <div id="ubicacionActualEstado" class="form-text home-ubicacion-estado"></div>
            </div>
            <div class="col-12">
                <div class="border rounded-3 p-3 bg-light-subtle">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                        <h3 class="home-subsection-title mb-0"><i class="bi bi-calendar-week me-1"></i>Busqueda por dia y horario</h3>
                        <div class="form-check mb-0 home-omit-toggle">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="omitirFechaHorario"
                                   name="omitirFechaHorario"
                                   value="true"
                                   @(Model.OmitirFechaHorario == true ? "checked" : null) />
                            <label class="form-check-label small fw-semibold" for="omitirFechaHorario">Mostrar todos los espacios (sin filtrar por dia y horario)</label>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Fecha</label>
                            <input class="form-control" type="date" id="fechaFiltro" name="fecha" value="@Model.Fecha.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="horaInicioFiltro">Hora inicio</label>
                            <select class="form-select" id="horaInicioFiltro" name="horaInicio">
                                @foreach (var hora in horasMediaHora)
                                {
                                    var valor = hora.ToString("HH\\:mm");
                                    if (hora == Model.HoraInicio)
                                    {
                                        <option value="@valor" selected="selected">@valor</option>
                                    }
                                    else
                                    {
                                        <option value="@valor">@valor</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="horaFinFiltro">Hora fin</label>
                            <select class="form-select" id="horaFinFiltro" name="horaFin">
                                @foreach (var hora in horasMediaHora)
                                {
                                    var valor = hora.ToString("HH\\:mm");
                                    if (hora == Model.HoraFin)
                                    {
                                        <option value="@valor" selected="selected">@valor</option>
                                    }
                                    else
                                    {
                                        <option value="@valor">@valor</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-text mt-2">Recomendado: deja activado este modo para explorar opciones y luego ajusta fecha/hora exacta al reservar.</div>
                </div>
            </div>
            <div class="col-md-12 d-flex align-items-end">
                                <button type="submit" class="btn w-100 auth-nav-mini auth-nav-mini-solid home-action-btn">
                    <i class="bi bi-search me-1"></i>Buscar espacios deportivos
                </button>
            </div>
        </form>
    </div>
</section>

<section id="resultados" class="mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h2 class="home-section-title mb-0"><i class="bi bi-grid-3x3-gap-fill me-1"></i>Espacios disponibles</h2>
        <span class="badge text-bg-primary">@Model.TotalResultados resultado(s)</span>
    </div>

    @if (Model.Disponibles.Count == 0)
    {
        <div class="alert alert-warning mb-0">
            No hay espacios disponibles con los filtros seleccionados.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model.Disponibles)
            {
                var carouselId = $"sedeFotos-{item.EspacioDeportivoId}";
                var detalleId = $"detalle-{item.EspacioDeportivoId}";
                var sedeFotos = item.SedeFotosConFallback ?? new List<string>();

                <div class="col-md-6 col-xl-4">
                    <article class="card h-100 border-0 shadow-sm home-space-card @(item.SedeId.HasValue ? null : "home-space-card--external")">
                        <div class="card-body d-flex flex-column">
                            @if (sedeFotos.Count == 1)
                            {
                                <div class="home-space-media mb-3">
                                    <img src="@(SistemaControlEspaciosDeportivosWeb.Services.SedeImagenUrlHelper.NormalizarUrlPublica(
                                        sedeFotos[0],
                                        SedeImagenStorageOptions.Value.PublicBaseUrl,
                                        SedeImagenStorageOptions.Value.BucketName) ?? sedeFotos[0])"
                                         alt="Foto de @item.SedeNombre"
                                         class="home-space-media-img" />
                                </div>
                            }
                            else if (sedeFotos.Count > 1)
                            {
                                <div class="home-space-media mb-3">
                                    <div id="@carouselId" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3500">
                                        <div class="carousel-inner">
                                            @for (var fotoIdx = 0; fotoIdx < sedeFotos.Count; fotoIdx++)
                                            {
                                                var foto = sedeFotos[fotoIdx];
                                                <div class="carousel-item @(fotoIdx == 0 ? "active" : null)">
                                                    <img src="@(SistemaControlEspaciosDeportivosWeb.Services.SedeImagenUrlHelper.NormalizarUrlPublica(
                                                        foto,
                                                        SedeImagenStorageOptions.Value.PublicBaseUrl,
                                                        SedeImagenStorageOptions.Value.BucketName) ?? foto)"
                                                         alt="Foto @(fotoIdx + 1) de @item.SedeNombre"
                                                         class="home-space-media-img" />
                                                </div>
                                            }
                                        </div>
                                        <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev" aria-label="Foto anterior de @item.SedeNombre" title="Foto anterior de @item.SedeNombre">
                                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        </button>
                                        <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next" aria-label="Foto siguiente de @item.SedeNombre" title="Foto siguiente de @item.SedeNombre">
                                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.NegocioNombreDestacado))
                            {
                                <div class="home-negocio-highlight mb-2">
                                    <span class="home-negocio-label"><i class="bi bi-buildings me-1"></i>Complejo Deportivo</span>
                                    <h3 class="home-negocio-title mb-0">@item.NegocioNombreDestacado</h3>
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div>
                                    <span class="home-item-label">Nombre del espacio</span>
                                    <h3 class="h6 fw-bold mb-1 home-item-title">@item.NombreEspacio</h3>
                                </div>
                                @if (item.SedeId.HasValue)
                                {
                                    <span class="badge text-bg-success">Disponible</span>
                                }
                                else
                                {
                                    <span class="home-ref-cta"><i class="bi bi-geo-alt-fill me-1"></i>Referencia externa</span>
                                }
                            </div>
                            @if (item.DistanciaKm.HasValue)
                            {
                                <div class="home-distance-chip mb-2">
                                    <i class="bi bi-signpost-split me-1"></i>
                                    A @item.DistanciaKm.Value.ToString("0.0", CultureInfo.InvariantCulture) km de tu ubicacion
                                </div>
                            }

                            @if (item.SedeId.HasValue)
                            {
                                <div class="home-sede-head mb-1">
                                    <p class="mb-0 home-item-sede">
                                        <span class="home-item-label">Nombre de sede</span>
                                        @item.SedeNombre
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(item.SedeMapaUrlResuelto))
                                    {
                                        <a class="btn btn-sm auth-nav-mini auth-nav-mini-outline home-map-btn"
                                           href="@item.SedeMapaUrlResuelto"
                                           target="_blank"
                                           rel="noopener noreferrer">Ver en mapa</a>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(item.SedeMapaUrlResuelto))
