@model SistemaControlEspaciosDeportivosWeb.ViewModels.AltaClubSolicitudFormViewModel
<!-- Firma: Codex - 27/03/2026 -->
@{
    ViewData["Title"] = "Software para Clubes";
}

<section class="hero-publico p-4 p-md-5 rounded-4 mb-4">
    <h1 class="display-6 fw-bold mb-3">Prueba gratis 1 mes</h1>
    <p class="mb-0">Completa este formulario y te contactaremos para activar tu complejo deportivo en SportCenter.</p>
</section>

@if (TempData["MensajeSolicitudClub"] is string okMsg && !string.IsNullOrWhiteSpace(okMsg))
{
    <div class="alert alert-success">@okMsg</div>
}

<form asp-action="SoftwareClubes" method="post" class="card card-body shadow-sm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <h2 class="h6 mb-3">Informacion personal</h2>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="NombreContacto" class="form-label">Nombre y apellido</label>
            <input asp-for="NombreContacto" class="form-control" />
            <span asp-validation-for="NombreContacto" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Telefono" class="form-label">Telefono</label>
            <input asp-for="Telefono" class="form-control" />
            <span asp-validation-for="Telefono" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Correo" class="form-label">Email dueno</label>
            <input asp-for="Correo" class="form-control" />
            <span asp-validation-for="Correo" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Password" class="form-label">Contrasena</label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="ConfirmPassword" class="form-label">Confirmar contrasena</label>
            <input asp-for="ConfirmPassword" class="form-control" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="RelacionClub" class="form-label">Relacion con el club</label>
            <select asp-for="RelacionClub" class="form-select">
                <option value="Dueno">Dueno</option>
                <option value="Administrador">Administrador</option>
                <option value="Socio">Socio</option>
                <option value="Otro">Otro</option>
            </select>
            <span asp-validation-for="RelacionClub" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="NombreClub" class="form-label">Nombre del club</label>
            <input asp-for="NombreClub" class="form-control" />
            <span asp-validation-for="NombreClub" class="text-danger"></span>
        </div>
    </div>

    <h2 class="h6 mt-4 mb-3">Ubicacion del club</h2>
    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="Pais" class="form-label">Pais</label>
            <input asp-for="Pais" class="form-control" />
            <span asp-validation-for="Pais" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="ProvinciaEstado" class="form-label">Provincia / Estado</label>
            <input asp-for="ProvinciaEstado" class="form-control" />
            <span asp-validation-for="ProvinciaEstado" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Ciudad" class="form-label">Ciudad</label>
            <input asp-for="Ciudad" class="form-control" />
            <span asp-validation-for="Ciudad" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Direccion" class="form-label">Direccion</label>
            <input asp-for="Direccion" class="form-control" />
            <span asp-validation-for="Direccion" class="text-danger"></span>
        </div>
    </div>

    <h2 class="h6 mt-4 mb-3">Verificacion CAPTCHA</h2>
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Codigo</label>
            <div class="form-control bg-light fw-bold text-center tracking-wide">@Model.CaptchaTexto</div>
        </div>
        <div class="col-md-4">
            <label asp-for="CaptchaCodigo" class="form-label">Ingresa el codigo</label>
            <input asp-for="CaptchaCodigo" class="form-control text-uppercase" autocomplete="off" />
            <span asp-validation-for="CaptchaCodigo" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-success">Enviar solicitud</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
