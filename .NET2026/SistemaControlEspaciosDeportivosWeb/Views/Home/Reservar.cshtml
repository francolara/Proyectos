
@model SistemaControlEspaciosDeportivosWeb.ViewModels.ReservaPublicaPageViewModel
@using System.Globalization
@using System.Linq

@{
    ViewData["Title"] = "Registrar reserva";
    var fecha = Model.Formulario.Fecha;
    var horaInicio = Model.Formulario.HoraInicio;
    var horaFin = Model.Formulario.HoraFin;
    var horasMediaHora = Enumerable.Range(0, 48)
        .Select(i => TimeOnly.FromTimeSpan(TimeSpan.FromMinutes(i * 30)))
        .ToList();
    var duracionMinutos = (int)(horaFin.ToTimeSpan() - horaInicio.ToTimeSpan()).TotalMinutes;
    if (duracionMinutos <= 0) { duracionMinutos = 60; }

    var mapaUrl = Model.Sede?.GoogleMapsUrl;
    if (string.IsNullOrWhiteSpace(mapaUrl) && Model.Sede?.Latitud is decimal lat && Model.Sede.Longitud is decimal lng)
    {
        mapaUrl = $"https://www.google.com/maps?q={lat.ToString(CultureInfo.InvariantCulture)},{lng.ToString(CultureInfo.InvariantCulture)}";
    }

    var servicios = (Model.Sede?.Servicios ?? string.Empty)
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
    var negocioNombre = string.IsNullOrWhiteSpace(Model.Sede?.NegocioNombre) ? "Complejo Deportivo" : Model.Sede!.NegocioNombre!;
    var telefonoSedeContacto = (Model.Espacio.TelefonoContacto ?? Model.Sede?.Telefono ?? string.Empty).Trim();
    var correoSedeContacto = (Model.Espacio.CorreoNotificacion ?? string.Empty).Trim();
    var whatsappSedeContacto = (Model.Espacio.WhatsappContacto ?? Model.Sede?.WhatsappContacto ?? string.Empty).Trim();
    var numeroWhatsappSede = string.IsNullOrWhiteSpace(whatsappSedeContacto)
        ? string.Empty
        : new string(whatsappSedeContacto.Where(char.IsDigit).ToArray());
    var mensajeWhatsappSede = Uri.EscapeDataString($"Hola, quiero informacion para reservar {Model.Espacio.NombreEspacio} en la sede {Model.Espacio.SedeNombre}.");
    var enlaceWhatsappSede = string.IsNullOrWhiteSpace(numeroWhatsappSede)
        ? string.Empty
        : $"https://wa.me/{numeroWhatsappSede}?text={mensajeWhatsappSede}";
    var cotizacionTieneDescuento = (Model.Cotizacion?.DescuentoPct ?? 0m) > 0m;
}
<div class="container py-4 home-reservar-page">
    <section class="sc-public-reserva-hero mb-3">
        <div class="sc-public-reserva-hero-main">
            <div class="sc-public-reserva-title-block">
                <span class="sc-public-reserva-eyebrow">Reserva publica</span>
                <h1 class="mb-0">Reserva tu horario</h1>
                <p class="mb-0">Selecciona una franja disponible, revisa el calendario operativo y confirma tu solicitud con una vista mas clara del espacio.</p>
            </div>
            <div class="sc-public-reserva-negocio-card">
                <span class="sc-public-reserva-negocio-label">Complejo Deportivo</span>
                <strong>@negocioNombre</strong>
                <span class="sc-public-reserva-negocio-meta">@Model.Espacio.SedeNombre</span>
            </div>
        </div>
    </section>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <h2 class="h6 mb-0"><i class="bi bi-calendar-week me-1"></i>Calendario del espacio</h2>
                <div class="d-flex flex-wrap gap-2">
                    <span class="sc-legend-chip is-disponible"><i></i>Disponible</span>
                    <span class="sc-legend-chip is-reservada"><i></i>Reservada</span>
                    <span class="sc-legend-chip is-confirmada"><i></i>Confirmada</span>
                </div>
            </div>
            <p class="text-muted small mb-2">Selecciona un bloque disponible o ajusta fecha y horario desde el formulario.</p>
            <div class="sc-public-cal-scroll">
                <div id="calendarioPublicoReserva"></div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3" id="formularioReservaPublica">
        <div class="card-body">
            @* Firma: FRANCO LARA - 03/05/2026 | Reserva publica restringida a bloques exactos de 1 hora con aviso visible y validacion cliente. *@
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <h2 class="h6 mb-0"><i class="bi bi-pencil-square me-1"></i>Datos para registrar la reserva</h2>
                <span class="badge text-bg-info"><i class="bi bi-clock-history me-1"></i>Solo reservas de 1 hora</span>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
            }

            <form asp-action="CrearReservaPublica" method="post" class="row g-3" id="formReservaPublica">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EspacioDeportivoId" value="@Model.Formulario.EspacioDeportivoId" />
                <input type="hidden" name="CodigoDepartamento" value="@Model.Formulario.CodigoDepartamento" />
                <input type="hidden" name="CodigoProvincia" value="@Model.Formulario.CodigoProvincia" />
                <input type="hidden" name="CodigoUbigeo" value="@Model.Formulario.CodigoUbigeo" />
                <input type="hidden" name="TipoDeporteId" value="@Model.Formulario.TipoDeporteId" />
                <input type="hidden" name="NegocioId" value="@Model.Formulario.NegocioId" />
                <input type="hidden" name="OmitirFechaHorario" value="@(Model.Formulario.OmitirFechaHorario == true ? "true" : "false")" />

                <div class="col-md-3">
                    <label class="form-label">Fecha</label>
                    <input id="formFecha"
                           name="Fecha"
                           type="date"
                           class="form-control"
                           value="@Model.Formulario.Fecha.ToString("yyyy-MM-dd")"
                           required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Hora inicio</label>
                    <select id="formHoraInicio" name="HoraInicio" class="form-select" required>
                        @foreach (var hora in horasMediaHora)
                        {
                            var valor = hora.ToString("HH\\:mm");
                            if (hora == Model.Formulario.HoraInicio)
                            {
                                <option value="@valor" selected="selected">@valor</option>
                            }
                            else
                            {
                                <option value="@valor">@valor</option>
                            }
                        }
                    </select>
                    <small class="text-muted">Hora maxima de inicio: 22:30.</small>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Hora fin</label>
                    <input id="formHoraFin"
                           name="HoraFin"
                           type="time"
                           class="form-control"
                           value="@Model.Formulario.HoraFin.ToString("HH\\:mm")"
                           step="1800"
                           readonly
                           required />
                    <small class="text-muted">La hora fin se ajusta automaticamente a +1 hora.</small>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Precio del espacio</label>
                    <div class="sc-price-box">
                        <strong id="cotizacionPrecio">
                            @if (Model.Cotizacion is not null)
                            {
                                @($"{Model.Cotizacion.MonedaSimbolo} {Model.Cotizacion.PrecioFinal.ToString("0.00", CultureInfo.InvariantCulture)}")
                            }
                            else
                            {
                                @:A cotizar
                            }
                        </strong>
                        <div id="cotizacionPromo" class="sc-price-promo @(cotizacionTieneDescuento ? string.Empty : "d-none")">
                            <span id="cotizacionPrecioBase" class="sc-price-base">
                                @if (cotizacionTieneDescuento)
                                {
                                    @($"{Model.Cotizacion!.MonedaSimbolo} {Model.Cotizacion.PrecioBase.ToString("0.00", CultureInfo.InvariantCulture)}")
                                }
                            </span>
                            <span id="cotizacionDescuentoBadge" class="sc-price-discount-badge">
                                @if (cotizacionTieneDescuento)
                                {
                                    @($"-{Math.Round(Model.Cotizacion!.DescuentoPct, 0).ToString("0", CultureInfo.InvariantCulture)}%")
                                }
                            </span>
                        </div>
                        <span id="cotizacionDetalle" class="small text-muted">
                            @if (Model.Cotizacion is not null)
                            {
                                @if (cotizacionTieneDescuento)
                                {
                                    @("Precio final con promocion aplicada.")
                                }
                                else
                                {
                                    @($"Base {Model.Cotizacion.MonedaSimbolo} {Model.Cotizacion.PrecioBase.ToString("0.00", CultureInfo.InvariantCulture)}")
                                }
                            }
                        </span>
                    </div>
                </div>
                <div class="col-12">
                    <div id="slotResumen" class="sc-slot-summary">
                        <i class="bi bi-calendar2-check"></i>
                        <span id="slotFechaTexto">@Model.Formulario.Fecha.ToString("dd/MM/yyyy")</span>
                        <span class="dot"></span>
                        <span id="slotHorarioTexto">@Model.Formulario.HoraInicio.ToString("HH\\:mm") - @Model.Formulario.HoraFin.ToString("HH\\:mm")</span>
                    </div>
                    <small id="cotizacionMensaje" class="text-muted">
                        @(Model.Cotizacion?.Mensaje ?? "El costo se actualiza automaticamente cuando cambias fecha u horario.")
                    </small>
                </div>

                <div class="col-12 pt-2">
                    <h3 class="h6 mb-2"><i class="bi bi-person-badge me-1"></i>Datos del cliente</h3>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Tipo de documento</label>
                    <select id="formTipoDocumento" name="TipoDocumento" class="form-select">
                        @foreach (var item in Model.Formulario.TiposDocumentoIdentidad)
                        {
                            if (string.Equals(item.Value, Model.Formulario.TipoDocumento, StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@item.Value" selected>@item.Text</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Numero de documento</label>
                    <input id="formNumeroDocumento"
                           name="NumeroDocumento"
                           class="form-control"
                           maxlength="20"
                           value="@Model.Formulario.NumeroDocumento" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Nombres</label>
                    <input name="Nombres"
                           class="form-control"
                           maxlength="120"
                           value="@Model.Formulario.Nombres"
                           required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Apellidos</label>
                    <input name="Apellidos"
                           class="form-control"
                           maxlength="120"
                           value="@Model.Formulario.Apellidos"
                           required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Nombre de equipo</label>
                    <input name="NombreEquipo"
                           class="form-control"
                           maxlength="120"
                           value="@Model.Formulario.NombreEquipo" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Telefono</label>
                    <input name="Telefono"
                           class="form-control"
                           maxlength="30"
                           value="@Model.Formulario.Telefono" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Correo</label>
                    <input name="Correo"
                           type="email"
                           class="form-control"
                           maxlength="200"
                           value="@Model.Formulario.Correo" />
                </div>

                <div class="col-12">
                    <label class="form-label">Comentario (opcional)</label>
                    <textarea name="Comentario" class="form-control" rows="3">@Model.Formulario.Comentario</textarea>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Codigo de cupon (opcional)</label>
                    <div class="input-group">
                        <input id="formCodigoCupon" name="CodigoCupon" class="form-control" maxlength="30" value="@Model.Formulario.CodigoCupon" />
                        <button type="button" class="btn btn-outline-primary" id="btnValidarCuponPublico">Validar</button>
                    </div>
                    <small id="cuponMensajePublico" class="text-muted"></small>
                </div>

                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Guardar reserva</button>
                    <a class="btn btn-outline-secondary"
                       asp-action="Index"
                       asp-route-fecha="@fecha.ToString("yyyy-MM-dd")"
                       asp-route-horaInicio="@horaInicio.ToString("HH\\:mm")"
                       asp-route-horaFin="@horaFin.ToString("HH\\:mm")"
                       asp-route-codigoDepartamento="@Model.Formulario.CodigoDepartamento"
                       asp-route-codigoProvincia="@Model.Formulario.CodigoProvincia"
                       asp-route-codigoUbigeo="@Model.Formulario.CodigoUbigeo"
                       asp-route-tipoDeporteId="@Model.Formulario.TipoDeporteId"
                       asp-route-negocioId="@Model.Formulario.NegocioId"
                       asp-route-omitirFechaHorario="@Model.Formulario.OmitirFechaHorario">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Espacio.SedeConsideracionesReserva))
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h2 class="h6 mb-1"><i class="bi bi-info-circle me-1"></i>Consideraciones</h2>
                <p class="mb-0 text-muted">@Model.Espacio.SedeConsideracionesReserva</p>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="row g-2 align-items-stretch">
                <div class="col-lg-3 col-md-6">
                    <div class="sc-mini-info">
                        <span class="sc-mini-kicker"><i class="bi bi-grid-3x3-gap"></i> Nombre del espacio</span>
                        <strong>@Model.Espacio.NombreEspacio</strong>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="sc-mini-info">
                        <div class="d-flex align-items-center gap-2">
                            <span class="sc-mini-kicker mb-0"><i class="bi bi-geo-alt"></i> Nombre de sede</span>
                            @if (!string.IsNullOrWhiteSpace(mapaUrl))
                            {
                                <a class="btn btn-outline-primary btn-sm ms-auto" href="@mapaUrl" target="_blank" rel="noopener noreferrer">Ver en mapa</a>
                            }
                        </div>
                        <strong>@Model.Espacio.SedeNombre</strong>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="sc-mini-info">
                        <span class="sc-mini-kicker"><i class="bi bi-signpost"></i> Direccion</span>
                        <strong>@(string.IsNullOrWhiteSpace(Model.Espacio.SedeDireccion) ? "-" : Model.Espacio.SedeDireccion)</strong>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="sc-mini-info">
                        <span class="sc-mini-kicker"><i class="bi bi-telephone"></i> Contacto</span>
                        @if (!string.IsNullOrWhiteSpace(telefonoSedeContacto))
                        {
                            <strong>Telefono: @telefonoSedeContacto</strong>
                        }
                        @if (!string.IsNullOrWhiteSpace(correoSedeContacto))
                        {
                            <small class="text-muted">Correo: @correoSedeContacto</small>
                        }
                        @if (!string.IsNullOrWhiteSpace(whatsappSedeContacto))
                        {
                            <small class="text-muted">WhatsApp: @whatsappSedeContacto</small>
                        }
                        @if (string.IsNullOrWhiteSpace(telefonoSedeContacto) && string.IsNullOrWhiteSpace(correoSedeContacto) && string.IsNullOrWhiteSpace(whatsappSedeContacto))
                        {
                            <strong>-</strong>
                        }
                        @if (!string.IsNullOrWhiteSpace(enlaceWhatsappSede) || !string.IsNullOrWhiteSpace(Model.Sede?.FacebookUrl) || !string.IsNullOrWhiteSpace(Model.Sede?.InstagramUrl) || !string.IsNullOrWhiteSpace(Model.Sede?.TwitterUrl))
                        {
                            <div class="sc-contact-actions mt-2">
                                @if (!string.IsNullOrWhiteSpace(enlaceWhatsappSede))
                                {
                                    <a class="btn btn-success btn-sm" href="@enlaceWhatsappSede" target="_blank" rel="noopener noreferrer">
                                        <i class="bi bi-whatsapp me-1"></i>WhatsApp
                                    </a>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Sede?.FacebookUrl))
                                {
                                    <a class="sc-social-btn" href="@Model.Sede.FacebookUrl" target="_blank" rel="noopener noreferrer" aria-label="Facebook de la sede"><i class="bi bi-facebook"></i></a>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Sede?.InstagramUrl))
                                {
                                    <a class="sc-social-btn" href="@Model.Sede.InstagramUrl" target="_blank" rel="noopener noreferrer" aria-label="Instagram de la sede"><i class="bi bi-instagram"></i></a>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Sede?.TwitterUrl))
                                {
                                    <a class="sc-social-btn" href="@Model.Sede.TwitterUrl" target="_blank" rel="noopener noreferrer" aria-label="Twitter de la sede"><i class="bi bi-twitter-x"></i></a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <h2 class="h6 mb-2"><i class="bi bi-stars me-1"></i>Servicios del complejo deportivo</h2>
                @if (servicios.Count == 0)
                {
                    <div class="text-muted small">No se registraron servicios para esta sede.</div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var servicio in servicios)
                        {
                            <span class="sc-service-chip"><i class="bi bi-check2-circle"></i>@servicio</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .home-reservar-page .sc-mini-info {
            border: 1px solid #dbe3f3;
            border-radius: 12px;
            padding: .65rem .8rem;
            background: #f8fbff;
            min-height: 92px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: .18rem;
        }
        .home-reservar-page .sc-mini-kicker {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            font-size: .72rem;
            letter-spacing: .03em;
            text-transform: uppercase;
            color: #4b5f87;
            font-weight: 700;
        }
        .home-reservar-page .sc-mini-info strong { font-size: .98rem; color: #0b1f46; }
        .home-reservar-page .sc-contact-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .42rem;
        }
        .home-reservar-page .sc-social-btn {
            width: 1.9rem;
            height: 1.9rem;
            border-radius: 50%;
            border: 1px solid #c8d8f6;
            background: #f2f7ff;
            color: #1f4fad;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: .2s ease;
        }
        .home-reservar-page .sc-social-btn:hover {
            background: #1f4fad;
            border-color: #1f4fad;
            color: #fff;
        }
        .home-reservar-page .sc-public-reserva-hero {
            display: flex;
            justify-content: space-between;
            align-items: stretch;
            gap: 1rem;
            padding: 1.1rem 1.2rem;
            border-radius: 1.15rem;
            background:
                radial-gradient(circle at top right, rgba(125, 211, 252, 0.18), transparent 28%),
                linear-gradient(135deg, #0a2f68 0%, #114792 52%, #155cc0 100%);
            color: #fff;
            box-shadow: 0 18px 36px rgba(15, 23, 42, 0.16);
        }
        .home-reservar-page .sc-public-reserva-hero-main {
            display: flex;
            justify-content: space-between;
            align-items: stretch;
            gap: 1rem;
            flex: 1 1 auto;
            min-width: 0;
        }
        .home-reservar-page .sc-public-reserva-title-block {
            display: flex;
            flex-direction: column;
            gap: .5rem;
            min-width: 0;
        }
        .home-reservar-page .sc-public-reserva-eyebrow {
            display: inline-flex;
            align-items: center;
            width: fit-content;
            padding: .25rem .7rem;
            border-radius: 999px;
            border: 1px solid rgba(191, 219, 254, .45);
            background: rgba(15, 23, 42, .2);
            color: #dbeafe;
            font-size: .74rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
        }
        .home-reservar-page .sc-public-reserva-title-block h1 {
            font-size: clamp(1.55rem, 2.2vw, 2.3rem);
            font-weight: 850;
            line-height: 1.04;
            letter-spacing: -.03em;
            color: #fff;
        }
        .home-reservar-page .sc-public-reserva-title-block p {
            max-width: 46rem;
            color: rgba(255,255,255,.9);
            font-size: .95rem;
            line-height: 1.55;
        }
        .home-reservar-page .sc-public-reserva-negocio-card {
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: .2rem;
            margin-left: auto;
            min-width: min(300px, 100%);
            padding: .95rem 1rem;
            border-radius: 1rem;
            border: 1px solid rgba(191, 219, 254, .28);
            background: rgba(7, 18, 37, .28);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,.08);
        }
        .home-reservar-page .sc-public-reserva-negocio-label {
            color: rgba(219, 234, 254, .86);
            font-size: .74rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .05em;
        }
        .home-reservar-page .sc-public-reserva-negocio-card strong {
            font-size: clamp(1.1rem, 1.5vw, 1.45rem);
            line-height: 1.15;
            color: #fff;
        }
        .home-reservar-page .sc-public-reserva-negocio-meta {
            color: rgba(226, 232, 240, .9);
            font-size: .87rem;
            font-weight: 600;
        }
        .home-reservar-page .sc-service-chip {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .35rem .6rem;
            border-radius: 999px;
            background: #eef4ff;
            border: 1px solid #cddcfb;
            color: #214287;
            font-size: .84rem;
            font-weight: 600;
        }
        .home-reservar-page .sc-legend-chip {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            border-radius: 999px;
            padding: .25rem .55rem;
            border: 1px solid transparent;
            font-size: .78rem;
            font-weight: 700;
        }
        .home-reservar-page .sc-legend-chip i {
            width: .6rem;
            height: .6rem;
            border-radius: 50%;
            display: inline-block;
        }
        .home-reservar-page .sc-legend-chip.is-disponible { background: #ffffff; border-color: #cfd9e8; color: #3a4b63; }
