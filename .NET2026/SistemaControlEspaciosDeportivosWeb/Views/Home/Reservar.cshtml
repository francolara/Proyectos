@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.14/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.14/locales-all.global.min.js"></script>
    <script>
        (() => {
            const calendarEl = document.getElementById('calendarioPublicoReserva');
            if (!calendarEl || typeof FullCalendar === 'undefined') return;

            const negocioId = @Model.NegocioId;
            const espacioId = @Model.Espacio.EspacioDeportivoId;

            const inputFecha = document.getElementById('formFecha');
            const inputInicio = document.getElementById('formHoraInicio');
            const inputFin = document.getElementById('formHoraFin');
            const inputCodigoCupon = document.getElementById('formCodigoCupon');
            const btnValidarCuponPublico = document.getElementById('btnValidarCuponPublico');
            const cuponMensajePublico = document.getElementById('cuponMensajePublico');
            const inputTipoDocumento = document.getElementById('formTipoDocumento');
            const inputNumeroDocumento = document.getElementById('formNumeroDocumento');
            const slotFechaTexto = document.getElementById('slotFechaTexto');
            const slotHorarioTexto = document.getElementById('slotHorarioTexto');
            const cotizacionPrecio = document.getElementById('cotizacionPrecio');
            const cotizacionPromo = document.getElementById('cotizacionPromo');
            const cotizacionPrecioBase = document.getElementById('cotizacionPrecioBase');
            const cotizacionDescuentoBadge = document.getElementById('cotizacionDescuentoBadge');
            const cotizacionDetalle = document.getElementById('cotizacionDetalle');
            const cotizacionMensaje = document.getElementById('cotizacionMensaje');
            const formContainer = document.getElementById('formularioReservaPublica');
            const formReserva = document.getElementById('formReservaPublica');
            let eventosCache = [];
            let debounceCotizar;

            function toIsoDateLocal(date) {
                const y = date.getFullYear();
                const m = String(date.getMonth() + 1).padStart(2, '0');
                const d = String(date.getDate()).padStart(2, '0');
                return `${y}-${m}-${d}`;
            }
            function toHm(date) {
                return `${String(date.getHours()).padStart(2, '0')}:${String(date.getMinutes()).padStart(2, '0')}`;
            }
            function titleCaseEs(texto) {
                if (!texto) return '';
                return texto.charAt(0).toUpperCase() + texto.slice(1);
            }
            function formatAdminRangeTitle(start, end, viewType) {
                const fmtDayMonth = new Intl.DateTimeFormat('es-PE', { day: 'numeric', month: 'long' });
                const s = new Date(start);
                const e = new Date(end.getTime() - 1);
                if (viewType === 'timeGridDay') {
                    const nombreDia = titleCaseEs(new Intl.DateTimeFormat('es-PE', { weekday: 'long' }).format(s));
                    return `${nombreDia} ${titleCaseEs(fmtDayMonth.format(s))} del ${s.getFullYear()}`;
                }
                const ini = titleCaseEs(fmtDayMonth.format(s));
                const fin = titleCaseEs(fmtDayMonth.format(e));
                return `${ini} al ${fin} del ${e.getFullYear()}`;
            }
            function aplicarHeaderHorarios() {
                const axisHeader = calendarEl.querySelector('.fc-col-header .fc-timegrid-axis .fc-col-header-cell-cushion');
                if (axisHeader) axisHeader.textContent = 'Horarios';
            }
            function intersects(startA, endA, startB, endB) {
                return startA < endB && endA > startB;
            }
            function hayCruceBloqueado(start, end) {
                return eventosCache.some(ev => {
                    const evStart = new Date(ev.start);
                    const evEnd = new Date(ev.end);
                    return intersects(start, end, evStart, evEnd);
                });
            }
            function parseTimeToMinutes(hm) {
                const p = String(hm || '').split(':');
                if (p.length < 2) return null;
                const h = Number(p[0]);
                const m = Number(p[1]);
                if (!Number.isFinite(h) || !Number.isFinite(m)) return null;
                return h * 60 + m;
            }
            function getDuracionMinutosFormulario() {
                const ini = parseTimeToMinutes(inputInicio?.value);
                const fin = parseTimeToMinutes(inputFin?.value);
                if (ini === null || fin === null || fin <= ini) return @duracionMinutos;
                return fin - ini;
            }
            function actualizarResumenSlot() {
                if (!inputFecha || !inputInicio || !inputFin) return;
                const fecha = inputFecha.value || '';
                const partes = fecha.split('-');
                if (partes.length === 3) {
                    slotFechaTexto.textContent = `${partes[2]}/${partes[1]}/${partes[0]}`;
                }
                slotHorarioTexto.textContent = `${inputInicio.value} - ${inputFin.value}`;
            }
            function actualizarEstadoNumeroDocumento() {
                if (!inputTipoDocumento || !inputNumeroDocumento) return;
                const tipo = String(inputTipoDocumento.value || '').trim().toUpperCase();
                const noObligatorio = tipo === '0';
                if (noObligatorio) inputNumeroDocumento.value = '';
                inputNumeroDocumento.disabled = noObligatorio;
                inputNumeroDocumento.placeholder = noObligatorio ? 'No obligatorio para este tipo.' : '';
            }
            async function cotizar() {
                if (!inputFecha || !inputInicio || !inputFin) return;
                const ini = parseTimeToMinutes(inputInicio.value);
                const fin = parseTimeToMinutes(inputFin.value);
                if (ini === null || fin === null || fin <= ini) {
                    if (cotizacionMensaje) cotizacionMensaje.textContent = 'La hora fin debe ser mayor que la hora inicio.';
                    if (cotizacionMensaje) cotizacionMensaje.className = 'text-danger';
                    if (cotizacionPrecio) cotizacionPrecio.textContent = 'A cotizar';
                    if (cotizacionPromo) cotizacionPromo.classList.add('d-none');
                    if (cotizacionPrecioBase) cotizacionPrecioBase.textContent = '';
                    if (cotizacionDescuentoBadge) cotizacionDescuentoBadge.textContent = '';
                    if (cotizacionDetalle) cotizacionDetalle.textContent = '';
                    return;
                }

                const params = new URLSearchParams({
                    negocioId: String(negocioId),
                    espacioDeportivoId: String(espacioId),
                    fecha: String(inputFecha.value || ''),
                    horaInicio: String(inputInicio.value || ''),
                    horaFin: String(inputFin.value || '')
                });
                const codigoCupon = String(inputCodigoCupon?.value || '').trim();
                if (codigoCupon) params.append('codigoCupon', codigoCupon);

                try {
                    const resp = await fetch('@Url.Action("CotizarReservaPublica", "Home")' + '?' + params.toString(), { credentials: 'same-origin' });
                    const data = await resp.json();
                    if (!data || data.ok !== true) {
                        if (cotizacionPrecio) cotizacionPrecio.textContent = 'A cotizar';
                        if (cotizacionPromo) cotizacionPromo.classList.add('d-none');
                        if (cotizacionPrecioBase) cotizacionPrecioBase.textContent = '';
                        if (cotizacionDescuentoBadge) cotizacionDescuentoBadge.textContent = '';
                        if (cotizacionDetalle) cotizacionDetalle.textContent = '';
                        if (cotizacionMensaje) cotizacionMensaje.textContent = data?.mensaje || 'No se pudo calcular el precio para este horario.';
                        if (cotizacionMensaje) cotizacionMensaje.className = 'text-danger';
                        return;
                    }

                    const c = data.cotizacion || {};
                    const simbolo = c.monedaSimbolo || 'S/';
                    const precioFinal = Number((c.montoFinalConCupon ?? c.precioFinal) || 0);
                    const precioBase = Number(c.precioBase || 0);
                    const desc = Number(c.descuentoPct || 0);
                    const descCupon = Number(c.montoDescuentoCupon || 0);
                    if (cotizacionPrecio) cotizacionPrecio.textContent = `${simbolo} ${precioFinal.toFixed(2)}`;
                    if (desc > 0) {
                        if (cotizacionPromo) cotizacionPromo.classList.remove('d-none');
                        if (cotizacionPrecioBase) cotizacionPrecioBase.textContent = `${simbolo} ${precioBase.toFixed(2)}`;
                        if (cotizacionDescuentoBadge) cotizacionDescuentoBadge.textContent = `-${Math.round(desc)}%`;
                    } else {
                        if (cotizacionPromo) cotizacionPromo.classList.add('d-none');
                        if (cotizacionPrecioBase) cotizacionPrecioBase.textContent = '';
                        if (cotizacionDescuentoBadge) cotizacionDescuentoBadge.textContent = '';
                    }
                    if (cotizacionDetalle) {
                        cotizacionDetalle.textContent = descCupon > 0
                            ? `Cupon aplicado: -${simbolo} ${descCupon.toFixed(2)}.`
                            : (desc > 0
                                ? 'Precio final con promocion aplicada.'
                                : `Base ${simbolo} ${precioBase.toFixed(2)}`);
                    }
                    if (cotizacionMensaje) cotizacionMensaje.textContent = c.mensajeCupon || c.mensaje || 'Cotizacion actualizada.';
                    if (cotizacionMensaje) cotizacionMensaje.className = descCupon > 0 ? 'text-success' : 'text-muted';
                    if (cuponMensajePublico && codigoCupon) {
                        cuponMensajePublico.className = descCupon > 0 ? 'text-success' : 'text-danger';
                        cuponMensajePublico.textContent = c.mensajeCupon || '';
                    }
                } catch {
                    if (cotizacionMensaje) cotizacionMensaje.textContent = 'No se pudo cotizar en este momento.';
                    if (cotizacionMensaje) cotizacionMensaje.className = 'text-danger';
                }
            }
            function formatMinutesToHm(totalMinutes) {
                const h = Math.floor(totalMinutes / 60);
                const m = totalMinutes % 60;
                return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
            }
            function forzarDuracionUnaHora() {
                if (!inputInicio || !inputFin) return;
                const ini = parseTimeToMinutes(inputInicio.value);
                if (ini === null) return;
                const maxInicio = (22 * 60) + 30;
                if (ini > maxInicio) {
                    inputInicio.value = '22:30';
                }
                const iniAjustado = parseTimeToMinutes(inputInicio.value);
                if (iniAjustado === null) return;
                const finEsperado = iniAjustado + 60;
                if (finEsperado > (23 * 60 + 59)) return;
                inputFin.value = formatMinutesToHm(finEsperado);
            }
            function cotizarDebounced() {
                clearTimeout(debounceCotizar);
                debounceCotizar = setTimeout(() => { cotizar(); }, 220);
            }
            function sincronizarCalendarioConFormulario(calendar) {
                if (!inputFecha || !inputInicio || !inputFin) return;
                const fecha = inputFecha.value;
                if (fecha) calendar.gotoDate(fecha);
                actualizarResumenSlot();
                cotizarDebounced();
            }
            function aplicarSeleccion(start, endSeleccionado) {
                const end = (endSeleccionado && endSeleccionado > start)
                    ? new Date(endSeleccionado)
                    : new Date(start.getTime() + 60 * 60000);

                if (start < new Date()) {
                    alert('Ese horario ya paso. Selecciona una hora futura.');
                    return;
                }
                if (hayCruceBloqueado(start, end)) {
                    alert('Ese horario no esta disponible. Elige otro bloque libre.');
                    return;
                }

                inputFecha.value = toIsoDateLocal(start);
                inputInicio.value = toHm(start);
                inputFin.value = toHm(end);
                forzarDuracionUnaHora();
                actualizarResumenSlot();
                cotizarDebounced();
                if (formContainer) formContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            const calendar = new FullCalendar.Calendar(calendarEl, {
                locale: 'es',
                initialView: 'timeGridWeek',
                initialDate: '@fecha.ToString("yyyy-MM-dd")',
                firstDay: 1,
                weekends: true,
                views: {
                    timeGridWeek: { buttonText: 'Semana' },
                    timeGridDay: { buttonText: 'Dia' }
                },
                allDaySlot: false,
                height: 720,
                slotDuration: '00:30:00',
                slotLabelInterval: '01:00:00',
                slotLabelFormat: { hour: '2-digit', minute: '2-digit', hour12: false },
                slotMinTime: '06:00:00',
                slotMaxTime: '24:00:00',
                nowIndicator: true,
                selectable: true,
                selectMirror: true,
                headerToolbar: { left: 'prev,next today', center: 'title', right: 'timeGridDay,timeGridWeek' },
                buttonText: { today: 'Hoy' },
                dayHeaderContent: function(args) {
                    const dayName = titleCaseEs(new Intl.DateTimeFormat('es-PE', { weekday: 'long' }).format(args.date));
                    const dayDate = new Intl.DateTimeFormat('es-PE', { day: 'numeric', month: 'numeric' }).format(args.date);
                    return { html: `<div class="sc-cal-header-day"><span class="sc-day-name">${dayName}</span><span class="sc-day-date">${dayDate}</span></div>` };
                },
                events: async (fetchInfo, successCallback, failureCallback) => {
                    try {
                        const params = new URLSearchParams({
                            negocioId: String(negocioId),
                            espacioDeportivoId: String(espacioId),
                            start: fetchInfo.startStr,
                            end: fetchInfo.endStr
                        });
                        const resp = await fetch('@Url.Action("ReservarCalendarioEventos", "Home")' + '?' + params.toString(), { credentials: 'same-origin' });
                        if (!resp.ok) throw new Error('No se pudo cargar el calendario.');
                        const data = await resp.json();
                        eventosCache = (data || []).map(x => ({ start: x.start, end: x.end }));
                        successCallback(data || []);
                    } catch (err) {
                        failureCallback(err);
                    }
                },
                dateClick: (info) => aplicarSeleccion(info.date, null),
                select: (info) => aplicarSeleccion(info.start, info.end),
                eventClick: () => alert('Ese bloque ya esta ocupado. Selecciona una franja disponible.'),
                eventDidMount: function(info) {
                    const tipo = String(info.event.extendedProps?.tipo || '').toUpperCase();
                    if (tipo !== 'BLOQUEO' && tipo !== 'NO_ATENCION') return;
                    info.el.innerHTML = '';
                    const texto = String(info.event.extendedProps?.motivo || info.event.title || '').trim();
                    if (texto) {
                        const span = document.createElement('span');
                        span.textContent = texto;
                        span.title = texto;
                        info.el.appendChild(span);
                    }
                },
                datesSet: (info) => {
                    const titulo = formatAdminRangeTitle(info.start, info.end, info.view.type);
                    const tituloEl = calendarEl.querySelector('.fc-toolbar-title');
                    if (tituloEl) tituloEl.textContent = titulo;
                    aplicarHeaderHorarios();
                }
            });

            calendar.render();
            aplicarHeaderHorarios();
            forzarDuracionUnaHora();
            actualizarResumenSlot();
            actualizarEstadoNumeroDocumento();
            cotizarDebounced();

            inputTipoDocumento?.addEventListener('change', actualizarEstadoNumeroDocumento);
            inputCodigoCupon?.addEventListener('change', cotizarDebounced);
            btnValidarCuponPublico?.addEventListener('click', cotizarDebounced);
            inputFecha?.addEventListener('change', () => sincronizarCalendarioConFormulario(calendar));
            inputInicio?.addEventListener('change', () => {
                forzarDuracionUnaHora();
                sincronizarCalendarioConFormulario(calendar);
            });
            inputFin?.addEventListener('change', () => {
                forzarDuracionUnaHora();
                sincronizarCalendarioConFormulario(calendar);
            });
            formReserva?.addEventListener('submit', (e) => {
                const ini = parseTimeToMinutes(inputInicio?.value);
                const fin = parseTimeToMinutes(inputFin?.value);
                if (ini === null || fin === null || fin <= ini) {
                    e.preventDefault();
                    alert('La hora fin debe ser mayor que la hora inicio.');
                    return;
                }
                if ((fin - ini) !== 60) {
                    e.preventDefault();
                    alert('La reserva publica solo permite bloques de 1 hora.');
                }
            });
        })();
    </script>
}

