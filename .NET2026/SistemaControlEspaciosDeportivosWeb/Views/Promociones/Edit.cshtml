@model SistemaControlEspaciosDeportivosWeb.ViewModels.PromocionFormViewModel
@{
    ViewData["Title"] = "Editar promocion";
    var horasMediaHora = Enumerable.Range(0, 48)
        .Select(i => TimeOnly.FromTimeSpan(TimeSpan.FromMinutes(i * 30)))
        .ToList();
}

<div class="admin-page-frame">
    <section class="page-header">
        <div>
            <h1>Editar promocion</h1>
            <p class="page-subtitle">Actualiza condiciones, vigencia y alcance de la promocion.</p>
        </div>
        <div class="action-toolbar">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>
        </div>
    </section>

    <form asp-action="Edit" method="post" class="sc-form-shell">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="NegocioId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-0"></div>

        <section class="sc-form-card">
            <div class="sc-form-section">
                <h2 class="sc-form-title"><i class="bi bi-tags"></i> Datos de la promocion</h2>
                <div class="row g-4">
                    <div class="col-md-8">
                        <label asp-for="Nombre" class="form-label">Nombre promocion</label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PorcentajeDescuento" class="form-label">Porcentaje descuento</label>
                        <div class="input-group">
                            <input asp-for="PorcentajeDescuento"
                                   class="form-control text-end"
                                   type="number"
                                   min="0"
                                   max="100"
                                   step="1"
                                   inputmode="numeric"
                                   pattern="\d*"
                                   oninput="this.value=this.value.replace(/[^0-9]/g,'');" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="PorcentajeDescuento" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SedeId" class="form-label">Sede</label>
                        <select asp-for="SedeId" asp-items="Model.Sedes" class="form-select"></select>
                        <span asp-validation-for="SedeId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EspacioDeportivoId" class="form-label">Espacio deportivo</label>
                        <select asp-for="EspacioDeportivoId" asp-items="Model.Espacios" class="form-select"></select>
                        <span asp-validation-for="EspacioDeportivoId" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="FechaInicio" class="form-label">Fecha Inicio</label>
                        <input asp-for="FechaInicio" class="form-control" type="date" />
                        <span asp-validation-for="FechaInicio" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="FechaFin" class="form-label">Fecha Fin</label>
                        <input asp-for="FechaFin" class="form-control" type="date" />
                        <span asp-validation-for="FechaFin" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="HoraInicio" class="form-label">Hora Inicio</label>
                        <select asp-for="HoraInicio" class="form-select">
                            @foreach (var hora in horasMediaHora)
                            {
                                <option value="@hora.ToString("HH\\:mm")">@hora.ToString("HH\\:mm")</option>
                            }
                        </select>
                        <span asp-validation-for="HoraInicio" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="HoraFin" class="form-label">Hora Fin</label>
                        <select asp-for="HoraFin" class="form-select">
                            @foreach (var hora in horasMediaHora)
                            {
                                <option value="@hora.ToString("HH\\:mm")">@hora.ToString("HH\\:mm")</option>
                            }
                        </select>
                        <span asp-validation-for="HoraFin" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label class="sc-check-chip">
                            <input asp-for="Activo" class="form-check-input mt-0" />
                            <span>Promocion activa</span>
                        </label>
                    </div>
                </div>
            </div>
        </section>

        <div class="sc-form-actions">
            <button type="submit" class="btn btn-primary btn-grabar">
                <i class="bi bi-check2-circle me-1"></i> Guardar cambios
            </button>
            <a class="btn btn-outline-secondary btn-cancelar" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const negocioId = document.getElementById('NegocioId')?.value;
            const sedeSel = document.getElementById('SedeId');
            const espacioSel = document.getElementById('EspacioDeportivoId');
            const descuentoInput = document.getElementById('PorcentajeDescuento');
            if (!negocioId || !sedeSel || !espacioSel) return;

            if (descuentoInput) {
                const n = Number.parseInt(descuentoInput.value || '0', 10);
                descuentoInput.value = Number.isFinite(n) ? String(n) : '';
            }

            async function cargarEspacios() {
                const params = new URLSearchParams({
                    negocioId: String(negocioId),
                    sedeId: (sedeSel.value || '').trim()
                });
                const seleccionActual = (espacioSel.value || '').trim();
                const resp = await fetch('@Url.Action("EspaciosPorSede", "Promociones")' + '?' + params.toString(), { credentials: 'same-origin' });
                if (!resp.ok) return;
                const data = await resp.json();
                const items = Array.isArray(data) ? data : [];

                espacioSel.innerHTML = '';
                const optTodos = document.createElement('option');
                optTodos.value = '';
                optTodos.textContent = 'Todos los espacios';
                espacioSel.appendChild(optTodos);

                items.forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = String(item.value ?? '');
                    opt.textContent = String(item.text ?? '');
                    espacioSel.appendChild(opt);
                });

                if (seleccionActual && items.some(x => String(x.value ?? '') === seleccionActual)) {
                    espacioSel.value = seleccionActual;
                } else {
                    espacioSel.value = '';
                }
            }

            sedeSel.addEventListener('change', () => { void cargarEspacios(); });
            void cargarEspacios();
        })();
    </script>
}

