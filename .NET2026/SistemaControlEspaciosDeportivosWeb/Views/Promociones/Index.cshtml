@model SistemaControlEspaciosDeportivosWeb.ViewModels.PromocionesIndexViewModel
@{
    ViewData["Title"] = "Promociones";
    var totalPromocionesVista = Model.Promociones.Count;
    var totalActivasVista = Model.Promociones.Count(x => x.Activo);
    var totalInactivasVista = Math.Max(0, totalPromocionesVista - totalActivasVista);
    var hoy = DateOnly.FromDateTime(DateTime.Today);
    var vigentesHoy = Model.Promociones.Count(x => x.Activo && x.FechaInicio <= hoy && x.FechaFin >= hoy);

    string estadoClase(bool activo)
    {
        return activo
            ? "bg-success-subtle text-success-emphasis border border-success-subtle"
            : "bg-danger-subtle text-danger-emphasis border border-danger-subtle";
    }
}

<div class="admin-page-frame">
    <section class="page-header">
        <div class="sc-page-title-wrap">
            <div>
                <h1>Promociones</h1>
                <p class="page-subtitle">Promociones activas, vigencias y descuentos comerciales.</p>
            </div>
            <div class="sc-negocio-ref-card" aria-readonly="true">
                <div class="sc-negocio-ref-card-head"><i class="bi bi-building"></i><span>Complejo Deportivo</span></div>
                <div class="sc-negocio-ref-card-name">@Model.NegocioNombre</div>
                <div class="sc-negocio-ref-card-id">ID: @Model.NegocioId</div>
            </div>
        </div>
        <div class="action-toolbar">
            @if (Model.PuedeCrear)
            {
                <a class="btn btn-primary" asp-action="Create" asp-route-negocioId="@Model.NegocioId">
                    <i class="bi bi-plus-circle me-1"></i> Nueva promocion
                </a>
            }
            <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Volver al panel
            </a>
        </div>
    </section>

    <section class="kpi-grid mb-3">
        <article class="kpi-card">
            <p class="kpi-card-label">Promociones (pagina)</p>
            <h3 class="kpi-card-value">@totalPromocionesVista</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Activas (pagina)</p>
            <h3 class="kpi-card-value">@totalActivasVista</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Inactivas (pagina)</p>
            <h3 class="kpi-card-value">@totalInactivasVista</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Vigentes hoy (pagina)</p>
            <h3 class="kpi-card-value">@vigentesHoy</h3>
        </article>
    </section>

    <section class="filter-card mb-3">
        <h2 class="section-title">Filtro rapido</h2>
        <form method="get" asp-action="Index">
            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
            <div class="row g-2 align-items-end px-3 pb-3">
                <div class="col-md-2">
                    <label class="form-label">Estado</label>
                    <select name="estado" class="form-select">
                        @if (Model.EstadoFiltro == "activos")
                        {
                            <option value="activos" selected="selected">Activos</option>
                        }
                        else
                        {
                            <option value="activos">Activos</option>
                        }
                        @if (Model.EstadoFiltro == "todos")
                        {
                            <option value="todos" selected="selected">Todos</option>
                        }
                        else
                        {
                            <option value="todos">Todos</option>
                        }
                        @if (Model.EstadoFiltro == "inactivos")
                        {
                            <option value="inactivos" selected="selected">Inactivos</option>
                        }
                        else
                        {
                            <option value="inactivos">Inactivos</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Desde</label>
                    <input type="date" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Hasta</label>
                    <input type="date" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label d-block">Seleccion rapida</label>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="preset" value="hoy">Hoy</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="preset" value="7d">7 dias</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="preset" value="30d">30 dias</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="preset" value="mes">Mes actual</button>
                        <button type="submit" class="btn btn-outline-primary ms-md-2">
                            <i class="bi bi-search me-1"></i> Buscar
                        </button>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label mb-1">Registros visibles</label>
                    <div class="form-control bg-light text-center fw-bold">@Model.TotalRegistros</div>
                </div>
            </div>
        </form>
        @if (Model.TotalPaginas > 1)
        {
            <div class="px-3 pb-3 d-flex justify-content-between align-items-center">
                <small class="text-muted">Pagina @Model.Pagina de @Model.TotalPaginas (@Model.TotalRegistros registros)</small>
                <nav aria-label="Paginacion promociones">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Pagina <= 1 ? "disabled" : null)">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-negocioId="@Model.NegocioId"
                               asp-route-estado="@Model.EstadoFiltro"
                               asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")"
                               asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")"
                               asp-route-pagina="@(Model.Pagina - 1)">Anterior</a>
                        </li>
                        <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : null)">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-negocioId="@Model.NegocioId"
                               asp-route-estado="@Model.EstadoFiltro"
                               asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")"
                               asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")"
                               asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </section>

    <section class="table-card">
        <h2 class="section-title">Listado detallado de promociones</h2>
        @if (!Model.Promociones.Any())
        {
            <div class="empty-state">
                <i class="bi bi-info-circle"></i>
                <span>No hay promociones para el filtro seleccionado.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle" id="tablaPromocionesDetallada">
                    <thead>
                        <tr>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-tag"></i><small>Promocion</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-geo-alt"></i><small>Cobertura</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-calendar-range"></i><small>Vigencia / horario</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-percent"></i><small>Estado / descuento</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-gear"></i><small>Acciones</small></span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Promociones)
                        {
                            var vigencia = $"{item.FechaInicio:dd/MM/yyyy} - {item.FechaFin:dd/MM/yyyy}";
                            var horario = $"{item.HoraInicio:HH\\:mm} - {item.HoraFin:HH\\:mm}";
                            var estadoTexto = item.Activo ? "Activa" : "Inactiva";
                            <tr>
                                <td class="text-center">
                                    <span class="sc-id-chip">PROMO #@item.Id</span>
                                    <div class="mt-1 fw-semibold">@item.Nombre</div>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex flex-column gap-1">
                                        <span class="sc-list-mini-card sc-list-mini-card-center"><i class="bi bi-geo-alt"></i><span>@item.Sede</span></span>
                                        <span class="sc-list-mini-card sc-list-mini-card-center"><i class="bi bi-grid-3x3-gap"></i><span>@item.Espacio</span></span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex flex-column gap-1">
                                        <span class="sc-list-mini-card sc-list-mini-card-center"><i class="bi bi-calendar3"></i><span>@vigencia</span></span>
                                        <span class="sc-list-mini-card sc-list-mini-card-center"><i class="bi bi-clock"></i><span>@horario</span></span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex flex-column gap-1">
                                        <span class="badge @estadoClase(item.Activo) sc-estado-pill">@estadoTexto</span>
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle sc-estado-pill">@item.PorcentajeDescuento.ToString("N0")%</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    @if (Model.PuedeEditar)
                                    {
                                        <a class="btn btn-sm sc-action-btn sc-action-edit" asp-action="Edit" asp-route-negocioId="@Model.NegocioId" asp-route-id="@item.Id">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                    }
                                    @if (Model.PuedeEliminar)
                                    {
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm sc-action-btn sc-action-delete">
                                                <i class="bi bi-trash3"></i> Desactivar
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

