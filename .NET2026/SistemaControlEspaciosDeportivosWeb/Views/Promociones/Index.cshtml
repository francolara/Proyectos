@model SistemaControlEspaciosDeportivosWeb.ViewModels.PromocionesIndexViewModel
<!-- Firma: Codex - 30/03/2026 | Rediseno del listado de promociones con KPIs, filtro rapido y tabla detallada -->

@{
    ViewData["Title"] = "Promociones";
    var totalPromociones = Model.Promociones.Count;
    var totalActivas = Model.Promociones.Count(x => x.Activo);
    var totalInactivas = Math.Max(0, totalPromociones - totalActivas);
    var hoy = DateOnly.FromDateTime(DateTime.Today);
    var vigentesHoy = Model.Promociones.Count(x => x.Activo && x.FechaInicio <= hoy && x.FechaFin >= hoy);

    string estadoClase(bool activo)
    {
        return activo
            ? "bg-success-subtle text-success-emphasis border border-success-subtle"
            : "bg-danger-subtle text-danger-emphasis border border-danger-subtle";
    }
}

<div class="admin-page-frame">
    <section class="page-header">
        <div>
            <h1>Promociones</h1>
            <p class="page-subtitle">@Model.NegocioNombre | Rol: @Model.RolActual</p>
        </div>
        <div class="action-toolbar">
            @if (Model.PuedeCrear)
            {
                <a class="btn btn-primary" asp-action="Create" asp-route-negocioId="@Model.NegocioId">
                    <i class="bi bi-plus-circle me-1"></i> Nueva promocion
                </a>
            }
            <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Panel
            </a>
        </div>
    </section>

    <section class="kpi-grid mb-3">
        <article class="kpi-card">
            <p class="kpi-card-label">Total promociones</p>
            <h3 class="kpi-card-value">@totalPromociones</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Promociones activas</p>
            <h3 class="kpi-card-value">@totalActivas</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Promociones inactivas</p>
            <h3 class="kpi-card-value">@totalInactivas</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Vigentes hoy</p>
            <h3 class="kpi-card-value">@vigentesHoy</h3>
        </article>
    </section>

    <section class="filter-card mb-3">
        <h2 class="section-title">Filtro rapido</h2>
        <div class="row g-2 align-items-end px-3 pb-3">
            <div class="col-lg-8 col-md-7">
                <label class="form-label">Buscar por nombre, sede, espacio o vigencia</label>
                <input type="text" id="filtroPromociones" class="form-control" placeholder="Ejemplo: Hora punta, CALLAO, CANCHA 1..." />
            </div>
            <div class="col-lg-4 col-md-5">
                <label class="form-label">Registros visibles</label>
                <div class="form-control bg-light" id="contadorPromociones">@totalPromociones</div>
            </div>
        </div>
    </section>

    <section class="table-card">
        <h2 class="section-title">Listado detallado de promociones</h2>
        @if (!Model.Promociones.Any())
        {
            <div class="empty-state">
                <i class="bi bi-info-circle"></i>
                <span>No hay promociones registradas para este negocio.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle" id="tablaPromocionesDetallada">
                    <thead>
                        <tr>
                            <th>Promocion</th>
                            <th>Cobertura</th>
                            <th>Vigencia y horario</th>
                            <th>Estado y descuento</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Promociones)
                        {
                            var vigencia = $"{item.FechaInicio:dd/MM/yyyy} - {item.FechaFin:dd/MM/yyyy}";
                            var horario = $"{item.HoraInicio:HH\\:mm} - {item.HoraFin:HH\\:mm}";
                            var estadoTexto = item.Activo ? "Activa" : "Inactiva";

                            <tr data-search="@($"{item.Nombre} {item.Sede} {item.Espacio} {vigencia} {horario} {item.PorcentajeDescuento:N2} {estadoTexto}".ToLowerInvariant())">
                                <td>
                                    <div class="sc-list-main">
                                        <span class="sc-list-code">PROMO #@item.Id</span>
                                        <div class="sc-list-title">@item.Nombre</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border"><i class="bi bi-geo-alt me-1"></i>@item.Sede</span>
                                        <span class="badge bg-light text-dark border"><i class="bi bi-grid-1x2 me-1"></i>@item.Espacio</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border"><i class="bi bi-calendar3 me-1"></i>@vigencia</span>
                                        <span class="badge bg-light text-dark border"><i class="bi bi-clock me-1"></i>@horario</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <span class="badge @estadoClase(item.Activo) sc-estado-pill">@estadoTexto</span>
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle sc-estado-pill">@item.PorcentajeDescuento.ToString("N2")%</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    @if (Model.PuedeEditar)
                                    {
                                        <a class="btn btn-sm sc-action-btn sc-action-edit" asp-action="Edit" asp-route-negocioId="@Model.NegocioId" asp-route-id="@item.Id">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                    }
                                    @if (Model.PuedeEliminar)
                                    {
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm sc-action-btn sc-action-delete">
                                                <i class="bi bi-trash3"></i> Desactivar
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const filtro = document.getElementById('filtroPromociones');
            const tabla = document.getElementById('tablaPromocionesDetallada');
            const contador = document.getElementById('contadorPromociones');
            if (!filtro || !tabla || !contador) return;

            function aplicarFiltro() {
                const valor = (filtro.value || '').trim().toLowerCase();
                let visibles = 0;
                tabla.querySelectorAll('tbody tr').forEach(row => {
                    const texto = row.getAttribute('data-search') || '';
                    const mostrar = !valor || texto.includes(valor);
                    row.style.display = mostrar ? '' : 'none';
                    if (mostrar) visibles++;
                });
                contador.textContent = String(visibles);
            }

            filtro.addEventListener('input', aplicarFiltro);
            aplicarFiltro();
        })();
    </script>
}
