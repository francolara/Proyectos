@model SistemaControlEspaciosDeportivosWeb.ViewModels.PromocionFormViewModel
<!-- Firma: Codex - 27/03/2026 -->
@{
    ViewData["Title"] = "Nueva promocion";
}

<h1 class="h4 mb-3">Nueva promocion</h1>

<form asp-action="Create" method="post" class="card card-body shadow-sm">
    <input type="hidden" asp-for="NegocioId" />
    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="PorcentajeDescuento" class="form-label"></label>
            <input asp-for="PorcentajeDescuento" class="form-control" />
            <span asp-validation-for="PorcentajeDescuento" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="SedeId" class="form-label">Sede</label>
            <select asp-for="SedeId" asp-items="Model.Sedes" class="form-select"></select>
            <span asp-validation-for="SedeId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="EspacioDeportivoId" class="form-label">Espacio deportivo</label>
            <select asp-for="EspacioDeportivoId" asp-items="Model.Espacios" class="form-select"></select>
            <span asp-validation-for="EspacioDeportivoId" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="FechaInicio" class="form-label"></label>
            <input asp-for="FechaInicio" class="form-control" type="date" />
            <span asp-validation-for="FechaInicio" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="FechaFin" class="form-label"></label>
            <input asp-for="FechaFin" class="form-control" type="date" />
            <span asp-validation-for="FechaFin" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="HoraInicio" class="form-label"></label>
            <input asp-for="HoraInicio" class="form-control" type="time" />
            <span asp-validation-for="HoraInicio" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="HoraFin" class="form-label"></label>
            <input asp-for="HoraFin" class="form-control" type="time" />
            <span asp-validation-for="HoraFin" class="text-danger"></span>
        </div>
        <div class="col-12">
            <div class="form-check">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label"></label>
            </div>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
