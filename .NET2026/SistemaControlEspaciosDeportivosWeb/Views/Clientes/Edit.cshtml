@model SistemaControlEspaciosDeportivosWeb.ViewModels.ClienteFormViewModel
@{
    ViewData["Title"] = "Editar cliente";
}

<div class="admin-page-frame">
    <section class="page-header">
        <div>
            <h1>Editar cliente</h1>
            <p class="page-subtitle">Actualiza la informacion del cliente para reservas y comprobantes.</p>
        </div>
        <div class="action-toolbar">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>
        </div>
    </section>

    <form asp-action="Edit" method="post" class="sc-form-shell">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="NegocioId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-0"></div>

        <section class="sc-form-card">
            <div class="sc-form-section">
                <h2 class="sc-form-title"><i class="bi bi-person-vcard"></i> Datos del cliente</h2>
                <div class="row g-3">
                    <div class="col-md-6" id="grupoRazonSocial">
                        <label asp-for="NombresORazonSocial" class="form-label">Razon social</label>
                        <input asp-for="NombresORazonSocial" class="form-control" id="NombresORazonSocial" />
                        <span asp-validation-for="NombresORazonSocial" class="text-danger"></span>
                    </div>
                    <div class="col-md-3" id="grupoNombres">
                        <label asp-for="Nombres" class="form-label">Nombres</label>
                        <input asp-for="Nombres" class="form-control" id="Nombres" />
                        <span asp-validation-for="Nombres" class="text-danger"></span>
                    </div>
                    <div class="col-md-3" id="grupoApellidos">
                        <label asp-for="Apellidos" class="form-label">Apellidos</label>
                        <input asp-for="Apellidos" class="form-control" id="Apellidos" />
                        <span asp-validation-for="Apellidos" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NombreEquipo" class="form-label">Nombre de equipo</label>
                        <input asp-for="NombreEquipo" class="form-control" />
                        <span asp-validation-for="NombreEquipo" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="TipoDocumento" class="form-label">Tipo de documento</label>
                        <select asp-for="TipoDocumento" asp-items="Model.TiposDocumento" class="form-select"></select>
                        <span asp-validation-for="TipoDocumento" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NumeroDocumento" class="form-label">Numero de documento</label>
                        <input asp-for="NumeroDocumento" class="form-control" maxlength="11" inputmode="numeric" />
                        <span asp-validation-for="NumeroDocumento" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Telefono" class="form-label">Telefono</label>
                        <input asp-for="Telefono" type="hidden" />
                        <div class="input-group">
                            <select asp-for="TelefonoCodigoPais" asp-items="Model.CodigosPais" class="form-select" style="max-width: 180px;"></select>
                            <input asp-for="TelefonoNumeroLocal" class="form-control" inputmode="numeric" placeholder="999999999" />
                        </div>
                        <span asp-validation-for="TelefonoCodigoPais" class="text-danger"></span>
                        <span asp-validation-for="TelefonoNumeroLocal" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Correo" class="form-label">Correo</label>
                        <input asp-for="Correo" class="form-control" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="DireccionFiscal" class="form-label">Direccion fiscal</label>
                        <input asp-for="DireccionFiscal" class="form-control" />
                        <span asp-validation-for="DireccionFiscal" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CodigoDepartamento" class="form-label">Departamento</label>
                        <select asp-for="CodigoDepartamento" asp-items="Model.DepartamentosUbigeo" class="form-select" id="CodigoDepartamento">
                            <option value="">Selecciona departamento</option>
                        </select>
                        <span asp-validation-for="CodigoDepartamento" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CodigoProvincia" class="form-label">Provincia</label>
                        <select asp-for="CodigoProvincia" asp-items="Model.ProvinciasUbigeo" class="form-select" id="CodigoProvincia">
                            <option value="">Selecciona provincia</option>
                        </select>
                        <span asp-validation-for="CodigoProvincia" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CodigoUbigeo" class="form-label">Distrito</label>
                        <select asp-for="CodigoUbigeo" asp-items="Model.DistritosUbigeo" class="form-select" id="CodigoUbigeo">
                            <option value="">Selecciona distrito</option>
                        </select>
                        <span asp-validation-for="CodigoUbigeo" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label class="sc-check-chip">
                            <input asp-for="Activo" class="form-check-input mt-0" />
                            <span>Cliente activo</span>
                        </label>
                    </div>
                </div>
            </div>
        </section>

        <div class="sc-form-actions">
            <button type="submit" class="btn btn-primary btn-grabar">
                <i class="bi bi-check2-circle me-1"></i> Guardar cambios
            </button>
            <a class="btn btn-outline-secondary btn-cancelar" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const direccion = document.getElementById('DireccionFiscal');
            const dep = document.getElementById('CodigoDepartamento');
            const prov = document.getElementById('CodigoProvincia');
            const dist = document.getElementById('CodigoUbigeo');
            if (!direccion || !dep || !prov || !dist) return;

            const urlProv = '@Url.Action("UbigeoProvincias", "Clientes")';
            const urlDist = '@Url.Action("UbigeoDistritos", "Clientes")';

            function toggleRequired() {
                const required = (direccion.value || '').trim().length > 0;
                dep.required = required;
                prov.required = required;
                dist.required = required;
            }

            async function cargarSelect(select, url, emptyText, selectedValue) {
                select.innerHTML = `<option value="">${emptyText}</option>`;
                if (!url) return;
                const resp = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!resp.ok) return;
                const data = await resp.json();
                (data || []).forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item.value;
                    opt.textContent = item.text;
                    if (selectedValue && selectedValue === item.value) opt.selected = true;
                    select.appendChild(opt);
                });
            }

            dep.addEventListener('change', async () => {
                await cargarSelect(prov, dep.value ? `${urlProv}?codigoDepartamento=${encodeURIComponent(dep.value)}` : '', 'Selecciona provincia', '');
                await cargarSelect(dist, '', 'Selecciona distrito', '');
            });

            prov.addEventListener('change', async () => {
                await cargarSelect(dist, prov.value ? `${urlDist}?codigoProvincia=${encodeURIComponent(prov.value)}` : '', 'Selecciona distrito', '');
            });

            direccion.addEventListener('input', toggleRequired);
            toggleRequired();
        })();
    </script>
    <script>
        (() => {
            const tipoDocumentoEl = document.getElementById('TipoDocumento');
            const razonGroup = document.getElementById('grupoRazonSocial');
            const nombresGroup = document.getElementById('grupoNombres');
            const apellidosGroup = document.getElementById('grupoApellidos');
            const razonInput = document.getElementById('NombresORazonSocial');
            const nombresInput = document.getElementById('Nombres');
            const apellidosInput = document.getElementById('Apellidos');
            if (!tipoDocumentoEl || !razonGroup || !nombresGroup || !apellidosGroup || !razonInput || !nombresInput || !apellidosInput) return;

            const esRuc = () => {
                const valor = (tipoDocumentoEl.value || '').trim().toUpperCase();
                return valor === '6' || valor === 'RUC';
            };
            const esNoDomiciliadoSinRuc = () => (tipoDocumentoEl.value || '').trim().toUpperCase() === '0';
            const numeroDocumentoInput = document.getElementById('NumeroDocumento');

            const actualizarVista = () => {
                if (esRuc()) {
                    razonGroup.style.display = '';
                    nombresGroup.style.display = 'none';
                    apellidosGroup.style.display = 'none';
                    razonInput.disabled = false;
                    razonInput.required = true;
                    nombresInput.disabled = true;
                    apellidosInput.disabled = true;
                    nombresInput.required = false;
                    apellidosInput.required = false;
                    if (!razonInput.value.trim() && (nombresInput.value.trim() || apellidosInput.value.trim())) {
                        razonInput.value = `${nombresInput.value} ${apellidosInput.value}`.trim();
                    }
                } else {
                    razonGroup.style.display = 'none';
                    nombresGroup.style.display = '';
                    apellidosGroup.style.display = '';
                    razonInput.disabled = true;
                    razonInput.required = false;
                    nombresInput.disabled = false;
                    apellidosInput.disabled = false;
                    nombresInput.required = true;
                    apellidosInput.required = true;
                    if (!nombresInput.value.trim() && !apellidosInput.value.trim() && razonInput.value.trim()) {
                        nombresInput.value = razonInput.value.trim();
                    }
                }

                if (numeroDocumentoInput) {
                    if (esNoDomiciliadoSinRuc()) {
                        numeroDocumentoInput.value = '';
                        numeroDocumentoInput.disabled = true;
                        numeroDocumentoInput.required = false;
                    } else {
                        numeroDocumentoInput.disabled = false;
                        numeroDocumentoInput.required = true;
                    }
                }
            };

            tipoDocumentoEl.addEventListener('change', actualizarVista);
            actualizarVista();
        })();
    </script>
}

