@model SistemaControlEspaciosDeportivosWeb.ViewModels.ClienteFormViewModel
<!-- Firma: Codex - 27/03/2026 | Estandar visual pro para formulario de clientes -->

@{
    ViewData["Title"] = "Editar cliente";
}

<div class="admin-page-frame">
    <section class="page-header">
        <div>
            <h1>Editar cliente</h1>
            <p class="page-subtitle">Actualiza la informacion del cliente para reservas y comprobantes.</p>
        </div>
        <div class="action-toolbar">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>
        </div>
    </section>

    <form asp-action="Edit" method="post" class="sc-form-shell">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="NegocioId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-0"></div>

        <section class="sc-form-card">
            <div class="sc-form-section">
                <h2 class="sc-form-title"><i class="bi bi-person-vcard"></i> Datos del cliente</h2>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="NombresORazonSocial" class="form-label"></label>
                        <input asp-for="NombresORazonSocial" class="form-control" />
                        <span asp-validation-for="NombresORazonSocial" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="TipoDocumento" class="form-label"></label>
                        <select asp-for="TipoDocumento" class="form-select">
                            <option value="DNI">DNI</option>
                            <option value="RUC">RUC</option>
                            <option value="CE">CE</option>
                            <option value="PASAPORTE">Pasaporte</option>
                        </select>
                        <span asp-validation-for="TipoDocumento" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NumeroDocumento" class="form-label"></label>
                        <input asp-for="NumeroDocumento" class="form-control" />
                        <span asp-validation-for="NumeroDocumento" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" class="form-control" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Correo" class="form-label"></label>
                        <input asp-for="Correo" class="form-control" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="DireccionFiscal" class="form-label"></label>
                        <input asp-for="DireccionFiscal" class="form-control" />
                        <span asp-validation-for="DireccionFiscal" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label class="sc-check-chip">
                            <input asp-for="Activo" class="form-check-input mt-0" />
                            <span>Cliente activo</span>
                        </label>
                    </div>
                </div>
            </div>
        </section>

        <div class="sc-form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2-circle me-1"></i> Guardar cambios
            </button>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
