@model SistemaControlEspaciosDeportivosWeb.ViewModels.ClientesIndexViewModel
@{
    ViewData["Title"] = "Clientes";
    var totalClientes = Model.TotalActivos + Model.TotalInactivos;
    var totalActivos = Model.TotalActivos;
    var totalInactivos = Model.TotalInactivos;
}

<div class="admin-page-frame">
    @if (TempData["ClientesError"] is string clientesError && !string.IsNullOrWhiteSpace(clientesError))
    {
        <div class="alert alert-danger">@clientesError</div>
    }
    @if (TempData["ClientesOk"] is string clientesOk && !string.IsNullOrWhiteSpace(clientesOk))
    {
        <div class="alert alert-success">@clientesOk</div>
    }

    <section class="page-header">
        <div class="sc-page-title-wrap">
            <div>
                <h1>Clientes</h1>
                <p class="page-subtitle">Gestion de clientes del negocio.</p>
            </div>
            <div class="sc-negocio-ref-card" aria-readonly="true">
                <div class="sc-negocio-ref-card-head"><i class="bi bi-building"></i><span>Complejo Deportivo</span></div>
                <div class="sc-negocio-ref-card-name">@Model.NegocioNombre</div>
                <div class="sc-negocio-ref-card-id">ID: @Model.NegocioId</div>
            </div>
        </div>
        <div class="action-toolbar">
            @if (Model.PuedeCrear)
            {
                <a class="btn btn-primary" asp-action="Create" asp-route-negocioId="@Model.NegocioId">
                    <i class="bi bi-plus-circle me-1"></i> Nuevo cliente
                </a>
            }
            <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Volver al panel
            </a>
        </div>
    </section>

    <section class="kpi-grid mb-3">
        <article class="kpi-card">
            <p class="kpi-card-label">Total clientes</p>
            <h3 class="kpi-card-value">@totalClientes</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Clientes activos</p>
            <h3 class="kpi-card-value">@totalActivos</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Clientes inactivos</p>
            <h3 class="kpi-card-value">@totalInactivos</h3>
        </article>
    </section>

    <section class="filter-card mb-3">
        <h2 class="section-title">Filtro rapido</h2>
        <form method="get" asp-action="Index">
            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
            <input type="hidden" name="pagina" value="1" />
            <div class="row g-2 align-items-end px-3 pb-3">
                <div class="col-lg-6 col-md-6">
                    <label class="form-label">Buscar por nombre, documento, telefono o correo</label>
                    <input type="text" id="filtroClientes" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Ejemplo: BORIS, 12345678, gmail.com..." />
                </div>
                <div class="col-lg-3 col-md-3">
                    <label class="form-label">Estado</label>
                    <select id="filtroEstadoClientes" name="estado" class="form-select" onchange="this.form.submit()">
                        <option value="todos" selected="@(Model.EstadoFiltro == "todos" ? "selected" : null)">Todos</option>
                        <option value="activos" selected="@(Model.EstadoFiltro == "activos" ? "selected" : null)">Activos</option>
                        <option value="inactivos" selected="@(Model.EstadoFiltro == "inactivos" ? "selected" : null)">Inactivos</option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-3">
                    <label class="form-label">Registros visibles</label>
                    <div class="form-control bg-light" id="contadorClientes">@Model.TotalRegistros</div>
                </div>
                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search me-1"></i> Buscar
                    </button>
                </div>
            </div>
        </form>
        @if (Model.TotalPaginas > 1)
        {
            var paginaAnterior = Model.Pagina > 1 ? Model.Pagina - 1 : 1;
            var paginaSiguiente = Model.Pagina < Model.TotalPaginas ? Model.Pagina + 1 : Model.TotalPaginas;
            <div class="sc-pagination-bar px-3 pb-3">
                <small class="sc-pagination-meta">Pagina @Model.Pagina de @Model.TotalPaginas (@Model.TotalRegistros registros)</small>
                <nav class="sc-pagination-nav" aria-label="Paginacion clientes">
                    <a class="sc-page-link @(Model.Pagina <= 1 ? "is-disabled" : null)" asp-action="Index" asp-route-negocioId="@Model.NegocioId" asp-route-estado="@Model.EstadoFiltro" asp-route-buscar="@Model.Buscar" asp-route-pagina="@paginaAnterior">Anterior</a>
                    @for (var p = 1; p <= Model.TotalPaginas; p++)
                    {
                        <a class="sc-page-link @(p == Model.Pagina ? "is-active" : null)" asp-action="Index" asp-route-negocioId="@Model.NegocioId" asp-route-estado="@Model.EstadoFiltro" asp-route-buscar="@Model.Buscar" asp-route-pagina="@p">@p</a>
                    }
                    <a class="sc-page-link @(Model.Pagina >= Model.TotalPaginas ? "is-disabled" : null)" asp-action="Index" asp-route-negocioId="@Model.NegocioId" asp-route-estado="@Model.EstadoFiltro" asp-route-buscar="@Model.Buscar" asp-route-pagina="@paginaSiguiente">Siguiente</a>
                </nav>
                <span class="sc-pagination-spacer" aria-hidden="true"></span>
            </div>
        }
    </section>

    <section class="table-card">
        <h2 class="section-title">Listado detallado de clientes</h2>
        @if (!Model.Clientes.Any())
        {
            <div class="empty-state">
                <i class="bi bi-info-circle"></i>
                <span>No hay clientes registrados para este negocio.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle" id="tablaClientesDetallada">
                    <thead>
                        <tr>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-hash"></i><small>ID</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-person"></i><small>Cliente</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-shield"></i><small>Equipo</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-card-checklist"></i><small>Documento y contacto</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-patch-check"></i><small>Estado</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-gear"></i><small>Acciones</small></span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Clientes)
                        {
                            var telefono = string.IsNullOrWhiteSpace(item.Telefono) ? "-" : item.Telefono!;
                            var correo = string.IsNullOrWhiteSpace(item.Correo) ? "-" : item.Correo!;
                            <tr>
                                <td class="text-center">
                                    <span class="sc-id-chip">#@item.Id</span>
                                </td>
                                <td class="text-start">
                                    <span class="sc-list-mini-card">
                                        <i class="bi bi-person"></i>
                                        <span>@item.NombresORazonSocial</span>
                                    </span>
                                </td>
                                <td class="text-start">
                                    @if (!string.IsNullOrWhiteSpace(item.NombreEquipo))
                                    {
                                        <span class="sc-list-mini-card">
                                            <i class="bi bi-shield"></i>
                                            <span>@item.NombreEquipo</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border"><i class="bi bi-credit-card-2-front me-1"></i>@item.TipoDocumento @item.NumeroDocumento</span>
                                        <span class="badge bg-light text-dark border"><i class="bi bi-telephone me-1"></i>@telefono</span>
                                        <span class="badge bg-light text-dark border"><i class="bi bi-envelope me-1"></i>@correo</span>
                                    </div>
                                </td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle sc-estado-pill">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle sc-estado-pill">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (Model.PuedeEditar)
                                    {
                                        <a class="btn btn-sm sc-action-btn sc-action-edit" asp-action="Edit" asp-route-negocioId="@Model.NegocioId" asp-route-id="@item.Id">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                    }
                                    @if (Model.PuedeEliminar && item.Activo)
                                    {
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm sc-action-btn sc-action-delete">
                                                <i class="bi bi-person-x"></i> Inactivar
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

