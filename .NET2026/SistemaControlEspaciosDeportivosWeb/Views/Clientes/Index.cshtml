@model SistemaControlEspaciosDeportivosWeb.ViewModels.ClientesIndexViewModel
<!-- Firma: Codex - 29/03/2026 | Rediseno del listado de clientes con KPIs, filtro rapido y tabla detallada -->
<!-- Firma: Codex - 01/04/2026 | Se agrega visualizacion de Nombre de equipo en listado de clientes. -->
<!-- Firma: Codex - 06/04/2026 | Se agrega filtro de estado (todos/activos/inactivos) en listado de clientes. -->
<!-- Firma: Codex - 06/04/2026 | El filtro de estado consulta backend y preserva el estado seleccionado. -->
<!-- Firma: Codex - 07/04/2026 | La busqueda de clientes ahora consulta backend (SP) y se mantiene en paginacion. -->

@{
    ViewData["Title"] = "Clientes";
    var totalClientes = Model.TotalActivos + Model.TotalInactivos;
    var totalActivos = Model.TotalActivos;
    var totalInactivos = Model.TotalInactivos;
}

<div class="admin-page-frame">
    @if (TempData["ClientesError"] is string clientesError && !string.IsNullOrWhiteSpace(clientesError))
    {
        <div class="alert alert-danger">@clientesError</div>
    }
    @if (TempData["ClientesOk"] is string clientesOk && !string.IsNullOrWhiteSpace(clientesOk))
    {
        <div class="alert alert-success">@clientesOk</div>
    }

    <section class="page-header">
        <div>
            <h1>Clientes</h1>
            <p class="page-subtitle">@Model.NegocioNombre | Rol: @Model.RolActual</p>
        </div>
        <div class="action-toolbar">
            @if (Model.PuedeCrear)
            {
                <a class="btn btn-primary" asp-action="Create" asp-route-negocioId="@Model.NegocioId">
                    <i class="bi bi-plus-circle me-1"></i> Nuevo cliente
                </a>
            }
            <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Panel
            </a>
        </div>
    </section>

    <section class="kpi-grid mb-3">
        <article class="kpi-card">
            <p class="kpi-card-label">Total clientes</p>
            <h3 class="kpi-card-value">@totalClientes</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Clientes activos</p>
            <h3 class="kpi-card-value">@totalActivos</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Clientes inactivos</p>
            <h3 class="kpi-card-value">@totalInactivos</h3>
        </article>
    </section>

    <section class="filter-card mb-3">
        <h2 class="section-title">Filtro rapido</h2>
        <form method="get" asp-action="Index">
            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
            <div class="row g-2 align-items-end px-3 pb-3">
                <div class="col-lg-6 col-md-6">
                    <label class="form-label">Buscar por nombre, documento, telefono o correo</label>
                    <input type="text" id="filtroClientes" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Ejemplo: BORIS, 12345678, gmail.com..." />
                </div>
                <div class="col-lg-3 col-md-3">
                    <label class="form-label">Estado</label>
                    <select id="filtroEstadoClientes" name="estado" class="form-select" onchange="this.form.submit()">
                        <option value="todos" selected="@(Model.EstadoFiltro == "todos" ? "selected" : null)">Todos</option>
                        <option value="activos" selected="@(Model.EstadoFiltro == "activos" ? "selected" : null)">Activos</option>
                        <option value="inactivos" selected="@(Model.EstadoFiltro == "inactivos" ? "selected" : null)">Inactivos</option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-3">
                    <label class="form-label">Registros visibles</label>
                    <div class="form-control bg-light" id="contadorClientes">@Model.TotalRegistros</div>
                </div>
                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search me-1"></i> Buscar
                    </button>
                </div>
            </div>
        </form>
        @if (Model.TotalPaginas > 1)
        {
            <div class="px-3 pb-3 d-flex justify-content-between align-items-center">
                <small class="text-muted">Pagina @Model.Pagina de @Model.TotalPaginas (@Model.TotalRegistros registros)</small>
                <nav aria-label="Paginacion clientes">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Pagina <= 1 ? "disabled" : null)">
                            <a class="page-link" asp-action="Index" asp-route-negocioId="@Model.NegocioId" asp-route-estado="@Model.EstadoFiltro" asp-route-buscar="@Model.Buscar" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a>
                        </li>
                        <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : null)">
                            <a class="page-link" asp-action="Index" asp-route-negocioId="@Model.NegocioId" asp-route-estado="@Model.EstadoFiltro" asp-route-buscar="@Model.Buscar" asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </section>

    <section class="table-card">
        <h2 class="section-title">Listado detallado de clientes</h2>
        @if (!Model.Clientes.Any())
        {
            <div class="empty-state">
                <i class="bi bi-info-circle"></i>
                <span>No hay clientes registrados para este negocio.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle" id="tablaClientesDetallada">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Documento y contacto</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Clientes)
                        {
                            var telefono = string.IsNullOrWhiteSpace(item.Telefono) ? "-" : item.Telefono!;
                            var correo = string.IsNullOrWhiteSpace(item.Correo) ? "-" : item.Correo!;
                            <tr>
                                <td>
                                    <div class="sc-list-main">
                                        <div class="sc-list-title">@item.NombresORazonSocial</div>
                                        @if (!string.IsNullOrWhiteSpace(item.NombreEquipo))
                                        {
                                            <div class="mt-1">
                                                <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle">
                                                    <i class="bi bi-shield me-1"></i>@item.NombreEquipo
                                                </span>
                                            </div>
                                        }
                                        <small class="text-muted">ID: @item.Id</small>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border"><i class="bi bi-credit-card-2-front me-1"></i>@item.TipoDocumento @item.NumeroDocumento</span>
                                        <span class="badge bg-light text-dark border"><i class="bi bi-telephone me-1"></i>@telefono</span>
                                        <span class="badge bg-light text-dark border"><i class="bi bi-envelope me-1"></i>@correo</span>
                                    </div>
                                </td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle sc-estado-pill">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle sc-estado-pill">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (Model.PuedeEditar)
                                    {
                                        <a class="btn btn-sm sc-action-btn sc-action-edit" asp-action="Edit" asp-route-negocioId="@Model.NegocioId" asp-route-id="@item.Id">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                    }
                                    @if (Model.PuedeEliminar && item.Activo)
                                    {
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm sc-action-btn sc-action-delete">
                                                <i class="bi bi-person-x"></i> Inactivar
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
