@model SistemaControlEspaciosDeportivosWeb.ViewModels.ReservasIndexViewModel
@{
    ViewData["Title"] = "Reservas";
    var sedeSeleccionadaTexto = Model.SedesFiltro.FirstOrDefault(x => x.Value == Model.SedeId?.ToString())?.Text ?? "Seleccione sede";
    var espacioSeleccionadoTexto = Model.EspaciosFiltro.FirstOrDefault(x => x.Value == Model.EspacioDeportivoId?.ToString())?.Text ?? "Todos los espacios";
    var mostrarPanelOperativo = Model.SedeId.HasValue && Model.EspacioDeportivoId.HasValue;
    var totalBloqueos = Model.Bloqueos.Count;
    var diasRango = (Model.FechaHasta.DayNumber - Model.FechaDesde.DayNumber) + 1;
    var habilitarFiltroEspacio = Model.SedeId.HasValue;
    var estadosListadoCatalogo = Model.EstadosFiltro.Where(x => !string.IsNullOrWhiteSpace(x.Value)).ToList();
    var horasMediaHora = Enumerable.Range(0, 48)
        .Select(i => TimeOnly.MinValue.AddMinutes(i * 30))
        .ToList();
}

<header class="page-header">
    <div class="sc-page-title-wrap">
        <div>
            <h1>Reservas y calendario</h1>
            <p class="page-subtitle">Planificacion de reservas y calendario operativo.</p>
        </div>
        <div class="sc-negocio-ref-card" aria-readonly="true">
            <div class="sc-negocio-ref-card-head"><i class="bi bi-building"></i><span>Club / negocio</span></div>
            <div class="sc-negocio-ref-card-name">@Model.NegocioNombre</div>
            <div class="sc-negocio-ref-card-id">ID: @Model.NegocioId</div>
        </div>
    </div>
    <div class="action-toolbar">
        <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId"><i class="bi bi-arrow-left me-1"></i>Volver al panel</a>
    </div>
</header>

@if (TempData["ReservasError"] is string reservasError && !string.IsNullOrWhiteSpace(reservasError))
{
    <div class="alert alert-danger">@reservasError</div>
}

@if (mostrarPanelOperativo)
{
    <section class="table-card sc-kpi-operativo-card mb-3" id="panelKpiOperativoDia">
        <div class="sc-reservas-list-head">
            <div>
                <h2 class="section-title"><i class="bi bi-speedometer2 me-1"></i>KPI operativo del dia</h2>
                <p class="mb-0 text-muted small">Resumen en tiempo real por fecha seleccionada (backend).</p>
            </div>
        </div>
        <div class="sc-kpi-grid">
            <article class="sc-kpi-item">
                <span>Ocupacion</span>
                <strong id="kpiOcupacionDia">0%</strong>
            </article>
            <article class="sc-kpi-item">
                <span>Slots ocupados</span>
                <strong id="kpiSlotsOcupadosDia">0</strong>
            </article>
            <article class="sc-kpi-item">
                <span>Slots libres</span>
                <strong id="kpiSlotsLibresDia">0</strong>
            </article>
            <article class="sc-kpi-item">
                <span>Reservas activas</span>
                <strong id="kpiReservasActivasDia">0</strong>
            </article>
            <article class="sc-kpi-item">
                <span>Pendientes</span>
                <strong id="kpiPendientesDia">0</strong>
            </article>
        </div>
    </section>
}

<form method="get" asp-action="Index" class="card card-body shadow-sm mb-3 sc-calendar-filter-card" id="filtrosForm">
    <input type="hidden" name="negocioId" value="@Model.NegocioId" />
    <input id="fechaDesde" type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
    <input id="fechaHasta" type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Sede</label>
            <select id="sedeId" class="form-select" name="sedeId">
                <option value="">Seleccione sede</option>
                @foreach (var s in Model.SedesFiltro)
                {
                    if (Model.SedeId?.ToString() == s.Value)
                    {
                        <option value="@s.Value" selected="selected">@s.Text</option>
                    }
                    else
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                }
            </select>
        </div>
        <div id="espacioFiltroCol" class="col-md-4">
            <label class="form-label">Espacio</label>
            <select id="espacioDeportivoId" class="form-select" name="espacioDeportivoId" @(habilitarFiltroEspacio ? "" : "disabled")>
                <option value="">@(habilitarFiltroEspacio ? "Selecciona espacio" : "Selecciona sede primero")</option>
                @foreach (var e in Model.EspaciosFiltro)
                {
                    if (Model.EspacioDeportivoId?.ToString() == e.Value)
                    {
                        <option value="@e.Value" selected="selected">@e.Text</option>
                    }
                    else
                    {
                        <option value="@e.Value">@e.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Estado</label>
            <select id="estado" class="form-select" name="estado">
                @foreach (var est in Model.EstadosFiltro)
                {
                    if (Model.Estado?.ToString() == est.Value)
                    {
                        <option value="@est.Value" selected="selected">@est.Text</option>
                    }
                    else
                    {
                        <option value="@est.Value">@est.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search me-1"></i> Buscar</button>
        </div>
    </div>
</form>

@if (mostrarPanelOperativo)
{
    <div class="sc-calendar-legend-card mb-3">
        <div class="sc-calendar-legend-header">
            <h2 class="h6 mb-0"><i class="bi bi-palette2"></i> Estado de reservas</h2>
            <div class="sc-calendar-legend-actions">
                <small class="text-muted me-1">Vista rapida por color para lectura inmediata del calendario.</small>
            </div>
        </div>
        <div class="sc-calendar-legend-list">
            <button type="button" class="sc-legend-pill is-pendiente" data-legend-estado="pendiente" data-legend-label="Pendiente" aria-pressed="true"><i></i><span class="sc-legend-pill-label">Pendiente</span> <span class="sc-legend-pill-count" data-legend-count>(0)</span></button>
            <button type="button" class="sc-legend-pill is-confirmada" data-legend-estado="confirmada" data-legend-label="Confirmada" aria-pressed="true"><i></i><span class="sc-legend-pill-label">Confirmada</span> <span class="sc-legend-pill-count" data-legend-count>(0)</span></button>
            <button type="button" class="sc-legend-pill is-finalizada" data-legend-estado="finalizada" data-legend-label="Pagada" aria-pressed="true"><i></i><span class="sc-legend-pill-label">Pagada</span> <span class="sc-legend-pill-count" data-legend-count>(0)</span></button>
            <button type="button" class="sc-legend-pill is-cancelada" data-legend-estado="cancelada" data-legend-label="Cancelada" aria-pressed="true"><i></i><span class="sc-legend-pill-label">Cancelada</span> <span class="sc-legend-pill-count" data-legend-count>(0)</span></button>
            <button type="button" class="sc-legend-pill is-noshow" data-legend-estado="noshow" data-legend-label="No Asistio" aria-pressed="true"><i></i><span class="sc-legend-pill-label">No Asistio</span> <span class="sc-legend-pill-count" data-legend-count>(0)</span></button>
            <button type="button" class="sc-legend-pill is-bloqueada" data-legend-estado="bloqueada" data-legend-label="Bloqueada / No atencion" aria-pressed="true"><i></i><span class="sc-legend-pill-label">Bloqueada / No atencion</span></button>
        </div>
    </div>

    <section class="table-card sc-calendar-card sc-operativa-card mb-3">
        <div class="sc-reservas-list-head">
            <div>
                <h2 class="section-title"><i class="bi bi-calendar-week me-1"></i>Agenda operativa</h2>
                <p class="mb-0 text-muted small">Haz clic en un dia/hora para ver disponibilidad. Arrastra reservas para mover horario.</p>
            </div>
            <div class="sc-reservas-metrics">
                <div class="sc-reservas-metric">
                    <span>Rango</span>
                    <strong>@diasRango dia(s)</strong>
                </div>
                <div class="sc-reservas-metric">
                    <span>Sede</span>
                    <strong>@sedeSeleccionadaTexto</strong>
                </div>
                <div class="sc-reservas-metric">
                    <span>Espacio</span>
                    <strong>@espacioSeleccionadoTexto</strong>
                </div>
            </div>
        </div>
        <div class="sc-calendar-body">
            <div id="calendarioReservas" class="sc-mode-contrast sc-mode-blocks-hc"></div>
        </div>
    </section>

    <section class="table-card sc-disponibilidad-card mb-4" id="panelDisponibilidadDia">
        <div class="sc-reservas-list-head">
            <div>
                <h2 class="section-title"><i class="bi bi-clock-history me-1"></i>Disponibilidad por dia</h2>
                <p class="mb-0 text-muted small">La disponibilidad se calcula con los eventos activos del calendario (reservas y bloqueos).</p>
            </div>
            <div class="sc-disponibilidad-date-filter">
                <label for="disponibilidadFechaFiltro" class="form-label mb-1">Filtrar fecha</label>
                <input type="date" id="disponibilidadFechaFiltro" class="form-control form-control-sm" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="sc-disponibilidad-body">
            <div id="disponibilidadMensaje" class="sc-disponibilidad-msg">Aun no has seleccionado una fecha.</div>
            <div id="disponibilidadSlots" class="d-flex flex-wrap gap-2 mt-2"></div>
        </div>
    </section>

    <section class="table-card sc-pendientes-card mb-4" id="panelPendientesDia">
        <div class="sc-reservas-list-head">
            <div>
                <h2 class="section-title"><i class="bi bi-hourglass-split me-1"></i>Pendiente de confirmar por dia</h2>
                <p class="mb-0 text-muted small">Muestra las reservas en estado pendiente para la fecha seleccionada. Haz clic para abrir el detalle en el pop-up.</p>
            </div>
            <div class="sc-disponibilidad-date-filter">
                <label for="pendientesFechaFiltro" class="form-label mb-1">Filtrar fecha</label>
                <input type="date" id="pendientesFechaFiltro" class="form-control form-control-sm" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="sc-disponibilidad-body">
            <div id="pendientesMensaje" class="sc-pendientes-msg">Aun no has seleccionado una fecha.</div>
            <div id="pendientesSlots" class="d-flex flex-wrap gap-2 mt-2"></div>
        </div>
    </section>

    <section class="table-card sc-reservas-list-card mb-3">
        <div class="sc-reservas-list-head">
            <div>
                <h2 class="section-title"><i class="bi bi-list-check me-1"></i>Listado general de reservas</h2>
                <p class="mb-0 text-muted small">Consulta con filtro independiente de rango y estados multiples.</p>
            </div>
            <div class="sc-reservas-metrics">
                <div class="sc-reservas-metric">
                    <span>Reservas activas</span>
                    <strong>@Model.TotalReservasActivasListadoGlobal</strong>
                </div>
                <div class="sc-reservas-metric">
                    <span>Pendientes</span>
                    <strong>@Model.TotalPendientesListadoGlobal</strong>
                </div>
                <div class="sc-reservas-metric">
                    <span>Pagadas</span>
                    <strong>@Model.TotalPagadasListadoGlobal</strong>
                </div>
                <div class="sc-reservas-metric">
                    <span>Saldo total</span>
                    <strong>@Model.MonedaSimbolo @Model.SaldoTotalListadoGlobal.ToString("N2")</strong>
                </div>
            </div>
        </div>
        <form method="get" asp-action="Index" class="sc-listado-filtro-form">
            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
            <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="sedeId" value="@Model.SedeId" />
            <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
            <input type="hidden" name="estado" value="@Model.Estado" />
            <input type="hidden" name="paginaListado" value="@Model.PaginaListado" />
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label">Desde</label>
                    <input type="date" class="form-control" name="listadoDesde" value="@Model.ListadoFechaDesde.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Hasta</label>
                    <input type="date" class="form-control" name="listadoHasta" value="@Model.ListadoFechaHasta.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label d-block mb-1">Seleccion rapida</label>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="listadoPreset" value="hoy">Hoy</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="listadoPreset" value="7d">7 dias</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="listadoPreset" value="30d">30 dias</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="listadoPreset" value="mes">Mes actual</button>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label d-block mb-1">Estados (puedes elegir varios)</label>
                    <div class="sc-listado-estados-grid">
                        @foreach (var estadoItem in estadosListadoCatalogo)
                        {
                            var estadoValor = int.Parse(estadoItem.Value);
                            var checkedAttr = Model.EstadosListadoSeleccionados.Contains(estadoValor) ? "checked" : null;
                            <label class="sc-estado-check">
                                <input type="checkbox" name="estadosListado" value="@estadoItem.Value" @checkedAttr />
                                <span>@estadoItem.Text</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="col-md-1 d-grid">
                    <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search me-1"></i> Buscar</button>
                </div>
            </div>
        </form>
        <div class="d-flex justify-content-between align-items-center mt-2 mb-2">
            <small class="text-muted">Pagina @Model.PaginaListado de @Model.TotalPaginasListado (@Model.TotalReservasListado registros)</small>
            <nav aria-label="Paginacion listado reservas">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.PaginaListado <= 1 ? "disabled" : null)">
                        <a class="page-link" asp-action="Index" asp-route-negocioId="@Model.NegocioId" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-sedeId="@Model.SedeId" asp-route-espacioDeportivoId="@Model.EspacioDeportivoId" asp-route-estado="@Model.Estado" asp-route-listadoDesde="@Model.ListadoFechaDesde.ToString("yyyy-MM-dd")" asp-route-listadoHasta="@Model.ListadoFechaHasta.ToString("yyyy-MM-dd")" asp-route-estadosListadoCsv="@string.Join(",", Model.EstadosListadoSeleccionados)" asp-route-paginaListado="@(Model.PaginaListado - 1)">Anterior</a>
                    </li>
                    <li class="page-item @(Model.PaginaListado >= Model.TotalPaginasListado ? "disabled" : null)">
                        <a class="page-link" asp-action="Index" asp-route-negocioId="@Model.NegocioId" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-sedeId="@Model.SedeId" asp-route-espacioDeportivoId="@Model.EspacioDeportivoId" asp-route-estado="@Model.Estado" asp-route-listadoDesde="@Model.ListadoFechaDesde.ToString("yyyy-MM-dd")" asp-route-listadoHasta="@Model.ListadoFechaHasta.ToString("yyyy-MM-dd")" asp-route-estadosListadoCsv="@string.Join(",", Model.EstadosListadoSeleccionados)" asp-route-paginaListado="@(Model.PaginaListado + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
        @if (Model.Reservas.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-calendar-x"></i>
                <span>No hay reservas registradas con los filtros seleccionados.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="tablaReservasDetallada" class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th class="sc-col-id"><span class="sc-col-header"><i class="bi bi-hash"></i><small># Reserva</small></span></th>
                            <th><span class="sc-col-header"><i class="bi bi-person"></i><small>Cliente</small></span></th>
                            <th><span class="sc-col-header"><i class="bi bi-people"></i><small>Equipo</small></span></th>
                            <th><span class="sc-col-header"><i class="bi bi-geo-alt"></i><small>Sede</small></span></th>
                            <th><span class="sc-col-header"><i class="bi bi-grid-3x3-gap"></i><small>Espacio</small></span></th>
                            <th><span class="sc-col-header"><i class="bi bi-calendar-event"></i><small>Fecha</small></span></th>
                            <th class="text-center"><span class="sc-col-header sc-col-header-center"><i class="bi bi-clock"></i><small>Horario</small></span></th>
                            <th class="text-center"><span class="sc-col-header sc-col-header-center"><i class="bi bi-cash-stack"></i><small>Precio (@Model.MonedaSimbolo)</small></span></th>
                            <th class="text-center"><span class="sc-col-header sc-col-header-center"><i class="bi bi-wallet2"></i><small>Saldo</small></span></th>
                            <th class="text-center"><span class="sc-col-header sc-col-header-center"><i class="bi bi-patch-check"></i><small>Estado</small></span></th>
                            <th class="text-center"><span class="sc-col-header sc-col-header-center"><i class="bi bi-gear"></i><small>Acciones</small></span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Reservas)
                        {
                            <tr>
                                <td class="text-center sc-col-id"><span class="sc-id-chip">#@item.Id</span></td>
                                <td><span class="sc-list-mini-card"><i class="bi bi-person"></i><span>@item.Cliente</span></span></td>
                                <td><span class="sc-list-mini-card"><i class="bi bi-people"></i><span>@(string.IsNullOrWhiteSpace(item.Equipo) ? "-" : item.Equipo)</span></span></td>
                                <td><span class="sc-list-mini-card"><i class="bi bi-geo-alt"></i><span>@item.Sede</span></span></td>
                                <td><span class="sc-list-mini-card"><i class="bi bi-grid-3x3-gap"></i><span>@item.Espacio</span></span></td>
                                <td><span class="sc-list-mini-card"><i class="bi bi-calendar-event"></i><span>@item.Fecha.ToString("dd/MM/yyyy")</span></span></td>
                                <td class="text-center"><span class="sc-list-mini-card sc-list-mini-card-center"><i class="bi bi-clock"></i><span>@item.HoraInicio.ToString("HH\\:mm") - @item.HoraFin.ToString("HH\\:mm")</span></span></td>
                                <td class="text-center"><span class="sc-list-mini-card sc-list-mini-card-center sc-list-mini-card-amount"><i class="bi bi-cash-stack"></i><span>@item.Total.ToString("N2")</span></span></td>
                                <td class="text-center"><span class="sc-list-mini-card sc-list-mini-card-center sc-list-mini-card-amount"><i class="bi bi-wallet2"></i><span>@item.SaldoPendiente.ToString("N2")</span></span></td>
                                <td class="text-center">
                                    @{
                                    var estadoTexto = item.Estado switch
                                    {
                                        "1" => "Pendiente",
                                        "2" => "Confirmada",
                                        "3" => "Pagada",
                                        "4" => "Pagada",
                                        "5" => "Cancelada",
                                        "6" => "No Asistio",
                                        _ => item.Estado
                                    };
                                }
                                <span class="badge @(item.Estado switch { "1" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle", "2" => "bg-success-subtle text-success-emphasis border border-success-subtle", "3" => "bg-info-subtle text-info-emphasis border border-info-subtle", "4" => "bg-info-subtle text-info-emphasis border border-info-subtle", "5" => "bg-danger-subtle text-danger-emphasis border border-danger-subtle", "6" => "sc-estado-noshow", _ => "bg-light text-dark border" })">@estadoTexto</span>
                            </td>
                            <td class="text-end">
                                @if (Model.PuedeEditar)
                                {
                                    <button type="button" class="btn btn-sm sc-action-btn sc-action-edit" data-accion-editar-reserva data-reserva-id="@item.Id">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </button>
                                }
                                    @if (Model.PuedeEliminar)
                                    {
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm sc-action-btn sc-action-delete">
                                                <i class="bi bi-trash3"></i> Cancelar
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="table-card sc-bloqueo-form-card mb-4">
        <div class="sc-reservas-list-head">
            <div>
                <h2 class="section-title"><i class="bi bi-shield-lock me-1"></i>Bloquear horario</h2>
                <p class="mb-0 text-muted small">Registra cortes por mantenimiento, torneo o eventos internos para evitar sobre-reserva.</p>
            </div>
            <div class="sc-reservas-metrics">
                <div class="sc-reservas-metric">
                    <span>Bloqueos en rango</span>
                    <strong>@totalBloqueos</strong>
                </div>
            </div>
        </div>
        <div class="sc-bloqueo-form-body">
            @if (Model.PuedeEditar)
            {
                <form asp-action="CrearBloqueo" method="post" class="row g-2 align-items-end sc-bloqueo-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="NegocioId" value="@Model.NegocioId" />
                    <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="sedeId" value="@Model.SedeId" />
                    <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
                    <input type="hidden" name="estado" value="@Model.Estado" />
                    <div class="col-md-3">
                        <label class="form-label">Espacio</label>
                        <select name="EspacioDeportivoId" class="form-select" required>
                            @foreach (var e in Model.BloqueoForm.Espacios)
                            {
                                if (Model.EspacioDeportivoId?.ToString() == e.Value)
                                {
                                    <option value="@e.Value" selected="selected">@e.Text</option>
                                }
                                else
                                {
                                    <option value="@e.Value">@e.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Fecha</label>
                        <input type="date" class="form-control" name="Fecha" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Inicio</label>
                        <select class="form-select" name="HoraInicio" required>
                            @foreach (var hora in horasMediaHora)
                            {
                                var valor = hora.ToString("HH\\:mm");
                                if (valor == "08:00")
                                {
                                    <option value="@valor" selected="selected">@valor</option>
                                }
                                else
                                {
                                    <option value="@valor">@valor</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Fin</label>
                        <select class="form-select" name="HoraFin" required>
                            @foreach (var hora in horasMediaHora)
                            {
                                var valor = hora.ToString("HH\\:mm");
                                if (valor == "09:00")
                                {
                                    <option value="@valor" selected="selected">@valor</option>
                                }
                                else
                                {
                                    <option value="@valor">@valor</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Motivo</label>
                        <input type="text" class="form-control" name="Motivo" maxlength="250" required />
                    </div>
                    <div class="col-md-1 d-grid">
                        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-lock"></i> Bloquear</button>
                    </div>
                </form>
            }
            else
            {
                <p class="text-muted mb-0">No tienes permisos para crear bloqueos.</p>
            }
        </div>
    </section>
}
else
{
    <section class="content-card mb-3">
        <h2 class="section-title"><i class="bi bi-funnel"></i> Seleccion requerida para panel operativo</h2>
        <div class="empty-state mb-0">
            <i class="bi bi-info-circle"></i>
            <span>Para mostrar <strong>Agenda operativa</strong>, <strong>Disponibilidad por dia</strong>, <strong>Bloquear horario</strong> y <strong>Bloqueos activos</strong>, selecciona primero una <strong>Sede</strong> y un <strong>Espacio</strong> en los filtros superiores.</span>
        </div>
    </section>

    <section class="table-card sc-reservas-list-card mb-3">
        <div class="sc-reservas-list-head">
            <div>
                <h2 class="section-title"><i class="bi bi-list-check me-1"></i>Listado general de reservas</h2>
                <p class="mb-0 text-muted small">Consulta con filtro independiente de rango y estados multiples.</p>
            </div>
            <div class="sc-reservas-metrics">
                <div class="sc-reservas-metric">
                    <span>Pendientes</span>
                    <strong>@Model.TotalPendientesListadoGlobal</strong>
                </div>
                <div class="sc-reservas-metric">
                    <span>Pagadas</span>
                    <strong>@Model.TotalPagadasListadoGlobal</strong>
                </div>
                <div class="sc-reservas-metric">
                    <span>Saldo total</span>
                    <strong>@Model.MonedaSimbolo @Model.SaldoTotalListadoGlobal.ToString("N2")</strong>
                </div>
            </div>
        </div>
        <form method="get" asp-action="Index" class="sc-listado-filtro-form">
            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
            <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="sedeId" value="@Model.SedeId" />
            <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
            <input type="hidden" name="estado" value="@Model.Estado" />
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label">Desde</label>
                    <input type="date" class="form-control" name="listadoDesde" value="@Model.ListadoFechaDesde.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Hasta</label>
                    <input type="date" class="form-control" name="listadoHasta" value="@Model.ListadoFechaHasta.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label d-block mb-1">Seleccion rapida</label>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="listadoPreset" value="hoy">Hoy</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="listadoPreset" value="7d">7 dias</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="listadoPreset" value="30d">30 dias</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="listadoPreset" value="mes">Mes actual</button>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label d-block mb-1">Estados (puedes elegir varios)</label>
                    <div class="sc-listado-estados-grid">
                        @foreach (var estadoItem in estadosListadoCatalogo)
                        {
                            var estadoValor = int.Parse(estadoItem.Value);
                            var checkedAttr = Model.EstadosListadoSeleccionados.Contains(estadoValor) ? "checked" : null;
                            <label class="sc-estado-check">
                                <input type="checkbox" name="estadosListado" value="@estadoItem.Value" @checkedAttr />
                                <span>@estadoItem.Text</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="col-md-1 d-grid">
                    <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search me-1"></i> Buscar</button>
                </div>
            </div>
        </form>
        <div class="d-flex justify-content-between align-items-center mt-2 mb-2">
            <small class="text-muted">Pagina @Model.PaginaListado de @Model.TotalPaginasListado (@Model.TotalReservasListado registros)</small>
            <nav aria-label="Paginacion listado reservas">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.PaginaListado <= 1 ? "disabled" : null)">
                        <a class="page-link" asp-action="Index" asp-route-negocioId="@Model.NegocioId" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-sedeId="@Model.SedeId" asp-route-espacioDeportivoId="@Model.EspacioDeportivoId" asp-route-estado="@Model.Estado" asp-route-listadoDesde="@Model.ListadoFechaDesde.ToString("yyyy-MM-dd")" asp-route-listadoHasta="@Model.ListadoFechaHasta.ToString("yyyy-MM-dd")" asp-route-estadosListadoCsv="@string.Join(",", Model.EstadosListadoSeleccionados)" asp-route-paginaListado="@(Model.PaginaListado - 1)">Anterior</a>
                    </li>
                    <li class="page-item @(Model.PaginaListado >= Model.TotalPaginasListado ? "disabled" : null)">
                        <a class="page-link" asp-action="Index" asp-route-negocioId="@Model.NegocioId" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-sedeId="@Model.SedeId" asp-route-espacioDeportivoId="@Model.EspacioDeportivoId" asp-route-estado="@Model.Estado" asp-route-listadoDesde="@Model.ListadoFechaDesde.ToString("yyyy-MM-dd")" asp-route-listadoHasta="@Model.ListadoFechaHasta.ToString("yyyy-MM-dd")" asp-route-estadosListadoCsv="@string.Join(",", Model.EstadosListadoSeleccionados)" asp-route-paginaListado="@(Model.PaginaListado + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
        @if (Model.Reservas.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-calendar-x"></i>
                <span>No hay reservas registradas con los filtros seleccionados.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="tablaReservasDetallada" class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th class="sc-col-id"><span class="sc-col-header"><i class="bi bi-hash"></i><small># Reserva</small></span></th>
                            <th><span class="sc-col-header"><i class="bi bi-person"></i><small>Cliente</small></span></th>
                            <th><span class="sc-col-header"><i class="bi bi-people"></i><small>Equipo</small></span></th>
                            <th><span class="sc-col-header"><i class="bi bi-geo-alt"></i><small>Sede</small></span></th>
                            <th><span class="sc-col-header"><i class="bi bi-grid-3x3-gap"></i><small>Espacio</small></span></th>
                            <th><span class="sc-col-header"><i class="bi bi-calendar-event"></i><small>Fecha</small></span></th>
                            <th class="text-center"><span class="sc-col-header sc-col-header-center"><i class="bi bi-clock"></i><small>Horario</small></span></th>
                            <th class="text-center"><span class="sc-col-header sc-col-header-center"><i class="bi bi-cash-stack"></i><small>Precio (@Model.MonedaSimbolo)</small></span></th>
                            <th class="text-center"><span class="sc-col-header sc-col-header-center"><i class="bi bi-wallet2"></i><small>Saldo</small></span></th>
                            <th class="text-center"><span class="sc-col-header sc-col-header-center"><i class="bi bi-patch-check"></i><small>Estado</small></span></th>
                            <th class="text-center"><span class="sc-col-header sc-col-header-center"><i class="bi bi-gear"></i><small>Acciones</small></span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Reservas)
                        {
                            <tr>
                                <td class="text-center sc-col-id"><span class="sc-id-chip">#@item.Id</span></td>
                                <td><span class="sc-list-mini-card"><i class="bi bi-person"></i><span>@item.Cliente</span></span></td>
                                <td><span class="sc-list-mini-card"><i class="bi bi-people"></i><span>@(string.IsNullOrWhiteSpace(item.Equipo) ? "-" : item.Equipo)</span></span></td>
                                <td><span class="sc-list-mini-card"><i class="bi bi-geo-alt"></i><span>@item.Sede</span></span></td>
                                <td><span class="sc-list-mini-card"><i class="bi bi-grid-3x3-gap"></i><span>@item.Espacio</span></span></td>
                                <td><span class="sc-list-mini-card"><i class="bi bi-calendar-event"></i><span>@item.Fecha.ToString("dd/MM/yyyy")</span></span></td>
                                <td class="text-center"><span class="sc-list-mini-card sc-list-mini-card-center"><i class="bi bi-clock"></i><span>@item.HoraInicio.ToString("HH\\:mm") - @item.HoraFin.ToString("HH\\:mm")</span></span></td>
                                <td class="text-center"><span class="sc-list-mini-card sc-list-mini-card-center sc-list-mini-card-amount"><i class="bi bi-cash-stack"></i><span>@item.Total.ToString("N2")</span></span></td>
                                <td class="text-center"><span class="sc-list-mini-card sc-list-mini-card-center sc-list-mini-card-amount"><i class="bi bi-wallet2"></i><span>@item.SaldoPendiente.ToString("N2")</span></span></td>
                                <td class="text-center">
                                    @{
                                    var estadoTexto = item.Estado switch
                                    {
                                        "1" => "Pendiente",
                                        "2" => "Confirmada",
                                        "3" => "Pagada",
                                        "4" => "Pagada",
                                        "5" => "Cancelada",
                                        "6" => "No Asistio",
                                        _ => item.Estado
                                    };
                                }
                                <span class="badge @(item.Estado switch { "1" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle", "2" => "bg-success-subtle text-success-emphasis border border-success-subtle", "3" => "bg-info-subtle text-info-emphasis border border-info-subtle", "4" => "bg-info-subtle text-info-emphasis border border-info-subtle", "5" => "bg-danger-subtle text-danger-emphasis border border-danger-subtle", "6" => "sc-estado-noshow", _ => "bg-light text-dark border" })">@estadoTexto</span>
                            </td>
                                <td class="text-end">
                                    @if (Model.PuedeEditar)
                                    {
                                        <button type="button" class="btn btn-sm sc-action-btn sc-action-edit" data-accion-editar-reserva data-reserva-id="@item.Id">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </button>
                                }
                                    @if (Model.PuedeEliminar)
                                    {
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm sc-action-btn sc-action-delete">
                                                <i class="bi bi-trash3"></i> Cancelar
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@if (mostrarPanelOperativo)
{
    <section class="table-card sc-bloqueos-card mb-4">
        <div class="sc-reservas-list-head">
            <div>
                <h2 class="section-title"><i class="bi bi-ban me-1"></i>Bloqueos activos</h2>
                <p class="mb-0 text-muted small">Listado de franjas bloqueadas en el periodo filtrado para la sede y espacio seleccionados.</p>
            </div>
            <div class="sc-reservas-metrics">
                <div class="sc-reservas-metric">
                    <span>Total bloqueos</span>
                    <strong>@totalBloqueos</strong>
                </div>
            </div>
        </div>
        <div class="sc-bloqueos-body">
            @if (Model.Bloqueos.Count == 0)
            {
                <div class="empty-state mb-0">
                    <i class="bi bi-check2-circle"></i>
                    <span>No hay bloqueos en el rango seleccionado.</span>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var b in Model.Bloqueos)
                    {
                        <div class="sc-bloqueo-item">
                            <div class="small text-muted"><i class="bi bi-calendar-event"></i> @b.Fecha.ToString("dd/MM/yyyy") @b.HoraInicio.ToString("HH\\:mm") - @b.HoraFin.ToString("HH\\:mm")</div>
                            <div class="fw-semibold"><i class="bi bi-geo-alt"></i> @b.Sede - @b.Espacio</div>
                            <div class="small">@b.Motivo</div>
                            @if (Model.PuedeEliminar)
                            {
                                <form asp-action="EliminarBloqueo" method="post" class="mt-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                    <input type="hidden" name="id" value="@b.Id" />
                                    <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="sedeId" value="@Model.SedeId" />
                                    <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
                                    <input type="hidden" name="estado" value="@Model.Estado" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash3"></i> Quitar bloqueo</button>
                                </form>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

<div class="modal fade" id="reservaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-fullscreen-sm-down modal-dialog-scrollable">
        <div class="modal-content sc-modal-content">
            @* Firma: Codex - 19/04/2026 | Cabecera visual homologada para el modal principal de reservas. *@
            <div class="modal-header sc-modal-header">
                <div class="sc-modal-title-wrap">
                    <h5 class="modal-title sc-modal-title" id="reservaModalTitulo">Nueva reserva</h5>
                    <p class="sc-modal-subtitle">Completa los datos principales de la reserva y valida la disponibilidad antes de confirmar.</p>
                </div>
                <button type="button" class="btn-close sc-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="reservaModalForm" asp-action="GuardarReservaModal" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body sc-modal-body">
                    <input type="hidden" id="modalReservaId" name="Id" value="0" />
                    <input type="hidden" id="modalNegocioId" name="NegocioId" value="@Model.NegocioId" />
                    <div id="reservaModalError" class="alert alert-danger d-none py-2"></div>
                    <div id="reservaModalDisponibilidad" class="alert d-none py-2"></div>
                    <div id="reservaModalAccionConflicto" class="mb-2 d-none">
                        <button type="button" id="btnVerReservaConflicto" class="btn btn-sm btn-outline-warning">
                            Ver reserva en conflicto
                        </button>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Espacio</label>
                            <select class="form-select" id="modalEspacioDeportivoId" name="EspacioDeportivoId" required>
                                <option value="">Selecciona...</option>
                                @foreach (var e in Model.EspaciosFiltro)
                                {
                                    <option value="@e.Value">@e.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Cliente</label>
                            <div class="input-group mb-1">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control form-control-sm" id="modalClienteBuscar" placeholder="Escribe cliente/equipo/doc y presiona Enter..." autocomplete="off" />
                                <button type="button" class="btn btn-sm btn-outline-primary" id="modalBtnNuevoCliente" title="Nuevo cliente rapido">+</button>
                            </div>
                            <input type="hidden" id="modalClienteId" name="ClienteId" />
                            <div id="modalClienteResultadosWrap" class="d-none">
