                            <select class="form-select" id="modalHoraFin" name="HoraFin" required>
                                @foreach (var hora in horasMediaHora)
                                {
                                    <option value="@hora.ToString("HH\\:mm")">@hora.ToString("HH\\:mm")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 d-none" id="modalEstadoWrap">
                            <label class="form-label">Estado</label>
                            <select class="form-select" id="modalEstado" name="Estado" required>
                                <option value="1">Pendiente</option>
                                <option value="2">Confirmada</option>
                                <option value="4">Pagada</option>
                                <option value="5">Cancelada</option>
                                <option value="6">No Asistio</option>
                            </select>
                        </div>
                        <div class="col-md-6">
