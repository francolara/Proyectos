                                    <option value="">Sin resultados</option>
                                </select>
                            </div>
                            <div class="row g-2 mt-1">
                                <div class="col-md-5">
                                    <label class="form-label small mb-1">Numero</label>
                                    <input type="text" class="form-control form-control-sm" id="modalClienteNumero" value="-" readonly />
                                </div>
                                <div class="col-md-7">
                                    <label class="form-label small mb-1">Correo</label>
                                    <input type="text" class="form-control form-control-sm" id="modalClienteCorreo" value="-" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha</label>
                            <input type="date" class="form-control" id="modalFecha" name="Fecha" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Hora inicio</label>
                            <select class="form-select" id="modalHoraInicio" name="HoraInicio" required>
                                @foreach (var hora in horasMediaHora)
                                {
                                    <option value="@hora.ToString("HH\\:mm")">@hora.ToString("HH\\:mm")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
