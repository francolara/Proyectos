            function pintarDrawerReserva(data) {
                if (!data) return;
                reservaDrawerIdActual = data.id;
                if (drawerReservaIdEl) drawerReservaIdEl.textContent = `#${data.id ?? '-'}`;
                if (drawerFechaEl) drawerFechaEl.textContent = data.fecha || '-';
                if (drawerHorarioEl) drawerHorarioEl.textContent = `${data.horaInicio || '--:--'} - ${data.horaFin || '--:--'}`;
                if (drawerEspacioEl) drawerEspacioEl.textContent = obtenerTextoComboPorValor(document.getElementById('modalEspacioDeportivoId'), data.espacioDeportivoId);
                if (drawerClienteEl) drawerClienteEl.textContent = obtenerTextoComboPorValor(document.getElementById('modalClienteId'), data.clienteId);
                if (drawerTotalEl) drawerTotalEl.textContent = Number(data.total ?? 0).toFixed(2);
                if (drawerAdelantoEl) drawerAdelantoEl.textContent = Number(data.adelanto ?? 0).toFixed(2);
                if (drawerEstadoBadgeEl) {
                    const cls = claseEstadoDrawer(data.estado);
                    drawerEstadoBadgeEl.className = `sc-drawer-state-badge ${cls}`.trim();
                    drawerEstadoBadgeEl.textContent = textoEstadoPorCodigo(data.estado);
                }
            }

            async function abrirDrawerReserva(reservaId) {
                if (!reservaDrawer || !reservaId) return;
                limpiarErrorDrawer();
                try {
                    const url = `${getReservaModalUrl}?negocioId=${encodeURIComponent(negocioId)}&id=${encodeURIComponent(reservaId)}`;
                    const r = await fetch(url, { cache: 'no-store' });
                    const payload = await r.json();
                    if (!r.ok || !payload?.ok) throw new Error(payload?.mensaje || 'No se pudo cargar la reserva.');
                    pintarDrawerReserva(payload);
                    reservaDrawer.show();
                } catch (err) {
                    mostrarErrorDrawer(err?.message || 'No se pudo cargar la reserva.');
                }
            }

            async function cambiarEstadoDesdeDrawer(nuevoEstado) {
                if (!puedeEditarReserva || !reservaDrawerIdActual) return;
                limpiarErrorDrawer();
                try {
                    const r = await fetch(cambiarEstadoRapidoUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            negocioId: negocioId,
                            reservaId: reservaDrawerIdActual,
                            nuevoEstado: Number(nuevoEstado)
                        })
                    });
                    const payload = await r.json();
                    if (!r.ok || !payload?.ok) throw new Error(payload?.mensaje || 'No se pudo actualizar el estado.');

                    await abrirDrawerReserva(reservaDrawerIdActual);
                    if (calendar) {
                        calendar.refetchEvents();
                        limpiarCacheResumenDia();
                        const fechaRef = drawerFechaEl?.textContent || hoyIso;
                        void renderDisponibilidadDia(new Date(`${fechaRef}T00:00:00`));
                        void renderPendientesConfirmarDia(new Date(`${fechaRef}T00:00:00`));
                    }
                } catch (err) {
                    mostrarErrorDrawer(err?.message || 'No se pudo actualizar el estado.');
                }
            }

