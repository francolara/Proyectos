        </div>
    </section>

    <section class="table-card sc-bloqueo-form-card mb-4">
        <div class="sc-reservas-list-head">
            <div>
                <h2 class="section-title"><i class="bi bi-shield-lock me-1"></i>Bloquear horario</h2>
                <p class="mb-0 text-muted small">Registra cortes por mantenimiento, torneo o eventos internos para evitar sobre-reserva.</p>
            </div>
            <div class="sc-reservas-metrics">
                <div class="sc-reservas-metric">
                    <span>Bloqueos en rango</span>
                    <strong>@totalBloqueos</strong>
                </div>
            </div>
        </div>
        <div class="sc-bloqueo-form-body">
            @if (Model.PuedeEditar)
            {
                <form asp-action="CrearBloqueo" method="post" class="row g-2 align-items-end sc-bloqueo-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="NegocioId" value="@Model.NegocioId" />
                    <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="sedeId" value="@Model.SedeId" />
                    <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
                    <input type="hidden" name="estado" value="@Model.Estado" />
                    <div class="col-md-3">
                        <label class="form-label">Espacio</label>
                        <select name="EspacioDeportivoId" class="form-select" required>
                            @foreach (var e in Model.BloqueoForm.Espacios)
                            {
                                if (Model.EspacioDeportivoId?.ToString() == e.Value)
                                {
                                    <option value="@e.Value" selected="selected">@e.Text</option>
                                }
                                else
                                {
                                    <option value="@e.Value">@e.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Fecha</label>
                        <input type="date" class="form-control" name="Fecha" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Inicio</label>
                        <input type="time" class="form-control" name="HoraInicio" value="08:00" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Fin</label>
                        <input type="time" class="form-control" name="HoraFin" value="09:00" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Motivo</label>
                        <input type="text" class="form-control" name="Motivo" maxlength="250" required />
                    </div>
                    <div class="col-md-1 d-grid">
                        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-lock"></i> Bloquear</button>
                    </div>
                </form>
            }
            else
            {
                <p class="text-muted mb-0">No tienes permisos para crear bloqueos.</p>
            }
        </div>
    </section>
}
else
{
    <section class="content-card mb-3">
        <h2 class="section-title"><i class="bi bi-funnel"></i> Seleccion requerida para panel operativo</h2>
        <div class="empty-state mb-0">
            <i class="bi bi-info-circle"></i>
            <span>Para mostrar <strong>Agenda operativa</strong>, <strong>Disponibilidad por dia</strong>, <strong>Bloquear horario</strong> y <strong>Bloqueos activos</strong>, selecciona primero una <strong>Sede</strong> y un <strong>Espacio</strong> en los filtros superiores.</span>
        </div>
    </section>
}

<section class="table-card sc-reservas-list-card mb-3">
    <div class="sc-reservas-list-head">
        <div>
            <h2 class="section-title"><i class="bi bi-list-check me-1"></i>Listado general de reservas</h2>
            <p class="mb-0 text-muted small">Consulta backend con filtro independiente de rango y estados multiples.</p>
        </div>
        <div class="sc-reservas-metrics">
            <div class="sc-reservas-metric">
                <span>Registros</span>
                <strong>@Model.Reservas.Count</strong>
            </div>
            <div class="sc-reservas-metric">
                <span>Monto total</span>
                <strong>S/ @totalMontoReservas.ToString("N2")</strong>
            </div>
        </div>
    </div>
    <form method="get" asp-action="Index" class="sc-listado-filtro-form">
        <input type="hidden" name="negocioId" value="@Model.NegocioId" />
        <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="sedeId" value="@Model.SedeId" />
        <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
        <input type="hidden" name="estado" value="@Model.Estado" />
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">Desde (listado)</label>
                <input type="date" class="form-control" name="listadoDesde" value="@Model.ListadoFechaDesde.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Hasta (listado)</label>
                <input type="date" class="form-control" name="listadoHasta" value="@Model.ListadoFechaHasta.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-7">
                <label class="form-label d-block mb-1">Estados (puedes elegir varios)</label>
                <div class="sc-listado-estados-grid">
                    @foreach (var estadoItem in estadosListadoCatalogo)
                    {
                        var estadoValor = int.Parse(estadoItem.Value);
                        var checkedAttr = Model.EstadosListadoSeleccionados.Contains(estadoValor) ? "checked" : null;
                        <label class="sc-estado-check">
                            <input type="checkbox" name="estadosListado" value="@estadoItem.Value" @checkedAttr />
                            <span>@estadoItem.Text</span>
                        </label>
                    }
                </div>
            </div>
            <div class="col-md-1 d-grid">
                <button type="submit" class="btn btn-outline-primary">Aplicar</button>
            </div>
        </div>
    </form>
    @if (Model.Reservas.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-calendar-x"></i>
            <span>No hay reservas registradas con los filtros seleccionados.</span>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table id="tablaReservasDetallada" class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Cliente</th>
                        <th>Sede</th>
                        <th>Espacio</th>
                        <th>Fecha</th>
                        <th>Horario</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Reservas)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Cliente</td>
                            <td>@item.Sede</td>
                            <td>@item.Espacio</td>
                            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@item.HoraInicio.ToString("HH\\:mm") - @item.HoraFin.ToString("HH\\:mm")</td>
                            <td>S/ @item.Total.ToString("N2")</td>
                            <td>
                                @{
                                    var estadoTexto = item.Estado switch
                                    {
                                        "1" => "Pendiente",
                                        "2" => "Confirmada",
                                        "3" => "En uso",
                                        "4" => "Finalizada",
                                        "5" => "Cancelada",
                                        "6" => "No asistio",
                                        _ => item.Estado
                                    };
                                }
                                @estadoTexto
                            </td>
                            <td class="text-end">
                                @if (Model.PuedeEditar)
                                {
                                    <a class="btn btn-sm sc-action-btn sc-action-edit" asp-action="Edit" asp-route-negocioId="@Model.NegocioId" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    @if (item.Estado == "1" || item.Estado == "2")
                                    {
                                        <form asp-action="CambiarEstadoTabla" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="nuevoEstado" value="3" />
                                            <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="sedeId" value="@Model.SedeId" />
                                            <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
                                            <input type="hidden" name="estado" value="@Model.Estado" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">Check-in</button>
                                        </form>
                                        <form asp-action="CambiarEstadoTabla" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="nuevoEstado" value="6" />
                                            <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="sedeId" value="@Model.SedeId" />
                                            <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
                                            <input type="hidden" name="estado" value="@Model.Estado" />
                                            <button type="submit" class="btn btn-sm btn-outline-dark">No show</button>
                                        </form>
                                    }
                                    else if (item.Estado == "3")
                                    {
                                        <form asp-action="CambiarEstadoTabla" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="nuevoEstado" value="4" />
                                            <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="sedeId" value="@Model.SedeId" />
                                            <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
                                            <input type="hidden" name="estado" value="@Model.Estado" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Check-out</button>
                                        </form>
                                    }
                                }
                                @if (Model.PuedeEliminar)
                                {
                                    <form asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm sc-action-btn sc-action-delete">
                                            <i class="bi bi-trash3"></i> Cancelar
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (mostrarPanelOperativo)
{
    <section class="table-card sc-bloqueos-card mb-4">
        <div class="sc-reservas-list-head">
            <div>
                <h2 class="section-title"><i class="bi bi-ban me-1"></i>Bloqueos activos</h2>
                <p class="mb-0 text-muted small">Listado de franjas bloqueadas en el periodo filtrado para la sede y espacio seleccionados.</p>
            </div>
            <div class="sc-reservas-metrics">
                <div class="sc-reservas-metric">
                    <span>Total bloqueos</span>
                    <strong>@totalBloqueos</strong>
                </div>
            </div>
        </div>
        <div class="sc-bloqueos-body">
            @if (Model.Bloqueos.Count == 0)
            {
                <div class="empty-state mb-0">
                    <i class="bi bi-check2-circle"></i>
                    <span>No hay bloqueos en el rango seleccionado.</span>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var b in Model.Bloqueos)
                    {
                        <div class="sc-bloqueo-item">
                            <div class="small text-muted"><i class="bi bi-calendar-event"></i> @b.Fecha.ToString("dd/MM/yyyy") @b.HoraInicio.ToString("HH\\:mm") - @b.HoraFin.ToString("HH\\:mm")</div>
                            <div class="fw-semibold"><i class="bi bi-geo-alt"></i> @b.Sede - @b.Espacio</div>
                            <div class="small">@b.Motivo</div>
                            @if (Model.PuedeEliminar)
                            {
                                <form asp-action="EliminarBloqueo" method="post" class="mt-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                    <input type="hidden" name="id" value="@b.Id" />
                                    <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="sedeId" value="@Model.SedeId" />
                                    <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
                                    <input type="hidden" name="estado" value="@Model.Estado" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash3"></i> Quitar bloqueo</button>
                                </form>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

<div class="offcanvas offcanvas-end sc-reserva-drawer" tabindex="-1" id="reservaDrawer" aria-labelledby="reservaDrawerTitle">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="reservaDrawerTitle">Detalle de reserva</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body">
        <div id="reservaDrawerError" class="alert alert-danger py-2 d-none"></div>
        <dl class="sc-drawer-kv">
            <dt>Reserva</dt><dd id="drawerReservaId">-</dd>
            <dt>Estado</dt><dd><span id="drawerEstadoBadge" class="sc-drawer-state-badge">-</span></dd>
            <dt>Fecha</dt><dd id="drawerFecha">-</dd>
            <dt>Horario</dt><dd id="drawerHorario">-</dd>
            <dt>Espacio</dt><dd id="drawerEspacio">-</dd>
            <dt>Cliente</dt><dd id="drawerCliente">-</dd>
            <dt>Total</dt><dd id="drawerTotal">-</dd>
            <dt>Adelanto</dt><dd id="drawerAdelanto">-</dd>
        </dl>

        @if (Model.PuedeEditar)
        {
            <div class="mb-3">
                <div class="small text-muted mb-2">Acciones rápidas</div>
                <div class="sc-drawer-actions">
                    <button type="button" class="btn btn-outline-warning" data-drawer-estado="1">Pendiente</button>
                    <button type="button" class="btn btn-outline-success" data-drawer-estado="2">Confirmar</button>
                    <button type="button" class="btn btn-outline-primary" data-drawer-estado="3">En uso</button>
                    <button type="button" class="btn btn-outline-info" data-drawer-estado="4">Finalizar</button>
                    <button type="button" class="btn btn-outline-danger" data-drawer-estado="5">Cancelar</button>
                    <button type="button" class="btn btn-outline-secondary" data-drawer-estado="6">No show</button>
                </div>
            </div>
        }

        <div class="d-grid gap-2">
            <button type="button" id="btnDrawerEditarCompleto" class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i> Editar completo
            </button>
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cerrar</button>
        </div>
    </div>
</div>

<div class="modal fade" id="reservaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reservaModalTitulo">Nueva reserva</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="reservaModalForm" asp-action="GuardarReservaModal" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="modalReservaId" name="Id" value="0" />
                    <input type="hidden" id="modalNegocioId" name="NegocioId" value="@Model.NegocioId" />
                    <div id="reservaModalError" class="alert alert-danger d-none py-2"></div>
                    <div id="reservaModalDisponibilidad" class="alert d-none py-2"></div>
                    <div id="reservaModalAccionConflicto" class="mb-2 d-none">
                        <button type="button" id="btnVerReservaConflicto" class="btn btn-sm btn-outline-warning">
                            Ver reserva en conflicto
                        </button>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Espacio</label>
                            <select class="form-select" id="modalEspacioDeportivoId" name="EspacioDeportivoId" required>
                                <option value="">Selecciona...</option>
                                @foreach (var e in Model.EspaciosFiltro)
                                {
                                    <option value="@e.Value">@e.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Cliente</label>
                            <select class="form-select" id="modalClienteId" name="ClienteId" required>
                                <option value="">Selecciona...</option>
                                @foreach (var c in Model.ClientesFiltro)
                                {
                                    <option value="@c.Value">@c.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha</label>
                            <input type="date" class="form-control" id="modalFecha" name="Fecha" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Hora inicio</label>
                            <input type="time" class="form-control" id="modalHoraInicio" name="HoraInicio" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Hora fin</label>
                            <input type="time" class="form-control" id="modalHoraFin" name="HoraFin" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Estado</label>
                            <select class="form-select" id="modalEstado" name="Estado" required>
                                <option value="1">Pendiente</option>
                                <option value="2">Confirmada</option>
                                <option value="3">En uso</option>
                                <option value="4">Finalizada</option>
                                <option value="5">Cancelada</option>
                                <option value="6">No asistio</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Total</label>
                            <input type="number" min="0" step="0.01" class="form-control" id="modalTotal" name="Total" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Adelanto</label>
                            <input type="number" min="0" step="0.01" class="form-control" id="modalAdelanto" name="Adelanto" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="btnGuardarReservaModal">
                        <i class="bi bi-check2-circle me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

