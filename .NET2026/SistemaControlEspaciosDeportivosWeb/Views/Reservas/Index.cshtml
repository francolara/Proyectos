<!-- Firma: Codex - 28/03/2026 | Ajustes visuales de acciones y calendario backend; tooltip y etiquetas visibles de estado/motivo en franjas bloqueadas; fix horario drag/drop, color bloqueado tomado del backend, eliminacion de texto duplicado en NO_ATENCION/BLOQUEO, cabecera del calendario en dos filas obligatorias y estilos centralizados en site.css. -->
<!-- Firma: Codex - 30/03/2026 | Calendario backend-driven: disponibilidad y pendientes por dia consultan BD via endpoint diario; panel operativo condicionado a sede+espacio; persistencia de filtros; nueva seccion "Pendiente de confirmar por dia"; listado general con filtro propio de rango y estados multiples (backend); refuerzo visual Fase 1 aplicado tambien por JS para evitar cache/orden de CSS, incluyendo toolbar, botones, grilla, columna horaria y fines de semana. -->
<!-- Firma: Codex - 31/03/2026 | Fase 2/3 del calendario: leyenda interactiva por estado, modos visuales (compacto/contraste), grilla operativa con cabecera y eje horario sticky, realce de columna por hover, drawer de detalle y ajuste robusto del eje horario (ancho fijo en colgroup/frame/cushion/shrink, titulo sin corte y horas centradas/legibles, re-aplicado tras filtrar/refetch). -->
<!-- Firma: Codex - 01/04/2026 | Reservas: cabecera con rango largo centrado, modo opcional Bloqueos HC, KPI operativo diario, vista por espacios, historial de cambios en drawer, validacion visual de solape en modal, acciones masivas (confirmar/no-show/recordatorio) backend-driven y estandar visual unificado para botones de acciones en listado (editar/check-in/no-show/cancelar). -->
@model SistemaControlEspaciosDeportivosWeb.ViewModels.ReservasIndexViewModel
<!-- Firma: Codex - 27/03/2026 | Calendario en espanol, bloqueos por sede, gestion por modal, bloqueo de fechas pasadas y rediseno visual SaaS del calendario -->
@{
    ViewData["Title"] = "Reservas";
    var sedeSeleccionadaTexto = Model.SedesFiltro.FirstOrDefault(x => x.Value == Model.SedeId?.ToString())?.Text ?? "Todas las sedes";
    var espacioSeleccionadoTexto = Model.EspaciosFiltro.FirstOrDefault(x => x.Value == Model.EspacioDeportivoId?.ToString())?.Text ?? "Todos los espacios";
    var mostrarPanelOperativo = Model.SedeId.HasValue && Model.EspacioDeportivoId.HasValue;
    var totalMontoReservas = Model.Reservas.Sum(x => x.Total);
    var totalBloqueos = Model.Bloqueos.Count;
    var diasRango = (Model.FechaHasta.DayNumber - Model.FechaDesde.DayNumber) + 1;
    var habilitarFiltroEspacio = Model.SedeId.HasValue;
    var estadosListadoCatalogo = Model.EstadosFiltro.Where(x => !string.IsNullOrWhiteSpace(x.Value)).ToList();
}

<header class="page-header">
    <div>
        <h1>Reservas y calendario</h1>
        <p class="page-subtitle">@Model.NegocioNombre | Rol: @Model.RolActual</p>
    </div>
    <div class="action-toolbar">
        @if (Model.PuedeCrear)
        {
            <button type="button" class="btn btn-outline-primary" id="btnNuevaReservaModal">
                <i class="bi bi-plus-circle"></i> Reserva manual
            </button>
        }
        <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Panel</a>
    </div>
</header>

@if (TempData["ReservasError"] is string reservasError && !string.IsNullOrWhiteSpace(reservasError))
{
    <div class="alert alert-danger">@reservasError</div>
}

<form method="get" asp-action="Index" class="card card-body shadow-sm mb-3 sc-calendar-filter-card" id="filtrosForm">
    <input type="hidden" name="negocioId" value="@Model.NegocioId" />
    <input id="fechaDesde" type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
    <input id="fechaHasta" type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Sede</label>
            <select id="sedeId" class="form-select" name="sedeId">
                <option value="">Todas</option>
                @foreach (var s in Model.SedesFiltro)
                {
                    if (Model.SedeId?.ToString() == s.Value)
                    {
                        <option value="@s.Value" selected="selected">@s.Text</option>
                    }
                    else
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                }
            </select>
        </div>
        <div id="espacioFiltroCol" class="col-md-4">
            <label class="form-label">Espacio</label>
            <select id="espacioDeportivoId" class="form-select" name="espacioDeportivoId" @(habilitarFiltroEspacio ? "" : "disabled")>
                <option value="">@(habilitarFiltroEspacio ? "Selecciona espacio" : "Selecciona sede primero")</option>
                @foreach (var e in Model.EspaciosFiltro)
                {
                    if (Model.EspacioDeportivoId?.ToString() == e.Value)
                    {
                        <option value="@e.Value" selected="selected">@e.Text</option>
                    }
                    else
                    {
                        <option value="@e.Value">@e.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Estado</label>
            <select id="estado" class="form-select" name="estado">
                @foreach (var est in Model.EstadosFiltro)
                {
                    if (Model.Estado?.ToString() == est.Value)
                    {
                        <option value="@est.Value" selected="selected">@est.Text</option>
                    }
                    else
                    {
                        <option value="@est.Value">@est.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        </div>
    </div>
</form>

@if (mostrarPanelOperativo)
{
    <div class="sc-calendar-legend-card mb-3">
        <div class="sc-calendar-legend-header">
            <h2 class="h6 mb-0"><i class="bi bi-palette2"></i> Estado de reservas</h2>
            <div class="sc-calendar-legend-actions">
                <small class="text-muted me-1">Vista rapida por color para lectura inmediata del calendario.</small>
                <button type="button" class="btn btn-outline-primary btn-sm" id="btnModoCompactoCalendario">Compacto</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnModoContrasteCalendario">Contraste</button>
                <button type="button" class="btn btn-outline-dark btn-sm" id="btnModoBloqueosHCCalendario">Bloqueos HC</button>
            </div>
        </div>
        <div class="sc-calendar-legend-list">
            <button type="button" class="sc-legend-pill is-pendiente" data-legend-estado="pendiente" aria-pressed="true"><i></i>Pendiente</button>
            <button type="button" class="sc-legend-pill is-confirmada" data-legend-estado="confirmada" aria-pressed="true"><i></i>Confirmada</button>
            <button type="button" class="sc-legend-pill is-enuso" data-legend-estado="enuso" aria-pressed="true"><i></i>En uso</button>
            <button type="button" class="sc-legend-pill is-finalizada" data-legend-estado="finalizada" aria-pressed="true"><i></i>Finalizada</button>
            <button type="button" class="sc-legend-pill is-cancelada" data-legend-estado="cancelada" aria-pressed="true"><i></i>Cancelada</button>
            <button type="button" class="sc-legend-pill is-noshow" data-legend-estado="noshow" aria-pressed="true"><i></i>No show</button>
            <button type="button" class="sc-legend-pill is-bloqueada" data-legend-estado="bloqueada" aria-pressed="true"><i></i>Bloqueada / No atencion</button>
        </div>
    </div>

    <section class="table-card sc-calendar-card sc-operativa-card mb-3">
        <div class="sc-reservas-list-head">
            <div>
                <h2 class="section-title"><i class="bi bi-calendar-week me-1"></i>Agenda operativa</h2>
                <p class="mb-0 text-muted small">Haz clic en un dia/hora para ver disponibilidad. Arrastra reservas para mover horario.</p>
            </div>
            <div class="sc-reservas-metrics">
                <div class="sc-reservas-metric">
                    <span>Rango</span>
                    <strong>@diasRango dia(s)</strong>
                </div>
                <div class="sc-reservas-metric">
                    <span>Sede</span>
                    <strong>@sedeSeleccionadaTexto</strong>
                </div>
                <div class="sc-reservas-metric">
                    <span>Espacio</span>
                    <strong>@espacioSeleccionadoTexto</strong>
                </div>
            </div>
        </div>
        <div class="sc-calendar-body">
            <div id="calendarioReservas"></div>
        </div>
    </section>

    <section class="table-card sc-kpi-operativo-card mb-3" id="panelKpiOperativoDia">
        <div class="sc-reservas-list-head">
            <div>
                <h2 class="section-title"><i class="bi bi-speedometer2 me-1"></i>KPI operativo del dia</h2>
                <p class="mb-0 text-muted small">Resumen en tiempo real por fecha seleccionada (backend).</p>
            </div>
        </div>
        <div class="sc-kpi-grid">
            <article class="sc-kpi-item">
                <span>Ocupacion</span>
                <strong id="kpiOcupacionDia">0%</strong>
            </article>
            <article class="sc-kpi-item">
                <span>Slots ocupados</span>
                <strong id="kpiSlotsOcupadosDia">0</strong>
            </article>
            <article class="sc-kpi-item">
                <span>Slots libres</span>
                <strong id="kpiSlotsLibresDia">0</strong>
            </article>
            <article class="sc-kpi-item">
                <span>Reservas activas</span>
                <strong id="kpiReservasActivasDia">0</strong>
            </article>
            <article class="sc-kpi-item">
                <span>Pendientes</span>
                <strong id="kpiPendientesDia">0</strong>
            </article>
            <article class="sc-kpi-item">
                <span>Bloqueos</span>
                <strong id="kpiBloqueosDia">0</strong>
            </article>
        </div>
    </section>

    <section class="table-card sc-recursos-card mb-3" id="panelRecursosDia">
        <div class="sc-reservas-list-head">
            <div>
                <h2 class="section-title"><i class="bi bi-grid-3x3-gap me-1"></i>Vista por espacios (dia)</h2>
                <p class="mb-0 text-muted small">Carga por espacio para la fecha seleccionada en la sede activa.</p>
            </div>
        </div>
        <div id="recursosDiaGrid" class="sc-recursos-grid"></div>
    </section>

    <section class="table-card sc-disponibilidad-card mb-4" id="panelDisponibilidadDia">
        <div class="sc-reservas-list-head">
            <div>
                <h2 class="section-title"><i class="bi bi-clock-history me-1"></i>Disponibilidad por dia</h2>
                <p class="mb-0 text-muted small">La disponibilidad se calcula con los eventos activos del calendario (reservas y bloqueos).</p>
            </div>
            <div class="sc-disponibilidad-date-filter">
                <label for="disponibilidadFechaFiltro" class="form-label mb-1">Filtrar fecha</label>
                <input type="date" id="disponibilidadFechaFiltro" class="form-control form-control-sm" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="sc-disponibilidad-body">
            <div id="disponibilidadMensaje" class="sc-disponibilidad-msg">Aun no has seleccionado una fecha.</div>
            <div id="disponibilidadSlots" class="d-flex flex-wrap gap-2 mt-2"></div>
        </div>
    </section>

    <section class="table-card sc-pendientes-card mb-4" id="panelPendientesDia">
        <div class="sc-reservas-list-head">
            <div>
                <h2 class="section-title"><i class="bi bi-hourglass-split me-1"></i>Pendiente de confirmar por dia</h2>
                <p class="mb-0 text-muted small">Muestra las reservas en estado pendiente para la fecha seleccionada. Haz clic para abrir el detalle en el pop-up.</p>
            </div>
            <div class="sc-disponibilidad-date-filter">
                <label for="pendientesFechaFiltro" class="form-label mb-1">Filtrar fecha</label>
                <input type="date" id="pendientesFechaFiltro" class="form-control form-control-sm" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="sc-disponibilidad-body">
            <div id="pendientesMensaje" class="sc-pendientes-msg">Aun no has seleccionado una fecha.</div>
            <div id="pendientesSlots" class="d-flex flex-wrap gap-2 mt-2"></div>
        </div>
    </section>

    <section class="table-card sc-bloqueo-form-card mb-4">
        <div class="sc-reservas-list-head">
            <div>
                <h2 class="section-title"><i class="bi bi-shield-lock me-1"></i>Bloquear horario</h2>
                <p class="mb-0 text-muted small">Registra cortes por mantenimiento, torneo o eventos internos para evitar sobre-reserva.</p>
            </div>
            <div class="sc-reservas-metrics">
                <div class="sc-reservas-metric">
                    <span>Bloqueos en rango</span>
                    <strong>@totalBloqueos</strong>
                </div>
            </div>
        </div>
        <div class="sc-bloqueo-form-body">
            @if (Model.PuedeEditar)
            {
                <form asp-action="CrearBloqueo" method="post" class="row g-2 align-items-end sc-bloqueo-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="NegocioId" value="@Model.NegocioId" />
                    <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="sedeId" value="@Model.SedeId" />
                    <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
                    <input type="hidden" name="estado" value="@Model.Estado" />
                    <div class="col-md-3">
                        <label class="form-label">Espacio</label>
                        <select name="EspacioDeportivoId" class="form-select" required>
                            @foreach (var e in Model.BloqueoForm.Espacios)
                            {
                                if (Model.EspacioDeportivoId?.ToString() == e.Value)
                                {
                                    <option value="@e.Value" selected="selected">@e.Text</option>
                                }
                                else
                                {
                                    <option value="@e.Value">@e.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Fecha</label>
                        <input type="date" class="form-control" name="Fecha" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Inicio</label>
                        <input type="time" class="form-control" name="HoraInicio" value="08:00" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Fin</label>
                        <input type="time" class="form-control" name="HoraFin" value="09:00" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Motivo</label>
                        <input type="text" class="form-control" name="Motivo" maxlength="250" required />
                    </div>
                    <div class="col-md-1 d-grid">
                        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-lock"></i> Bloquear</button>
                    </div>
                </form>
            }
            else
            {
                <p class="text-muted mb-0">No tienes permisos para crear bloqueos.</p>
            }
        </div>
    </section>
}
else
{
    <section class="content-card mb-3">
        <h2 class="section-title"><i class="bi bi-funnel"></i> Seleccion requerida para panel operativo</h2>
        <div class="empty-state mb-0">
            <i class="bi bi-info-circle"></i>
            <span>Para mostrar <strong>Agenda operativa</strong>, <strong>Disponibilidad por dia</strong>, <strong>Bloquear horario</strong> y <strong>Bloqueos activos</strong>, selecciona primero una <strong>Sede</strong> y un <strong>Espacio</strong> en los filtros superiores.</span>
        </div>
    </section>
}

<section class="table-card sc-reservas-list-card mb-3">
    <div class="sc-reservas-list-head">
        <div>
            <h2 class="section-title"><i class="bi bi-list-check me-1"></i>Listado general de reservas</h2>
            <p class="mb-0 text-muted small">Consulta backend con filtro independiente de rango y estados multiples.</p>
        </div>
        <div class="sc-reservas-metrics">
            <div class="sc-reservas-metric">
                <span>Registros</span>
                <strong>@Model.Reservas.Count</strong>
            </div>
            <div class="sc-reservas-metric">
                <span>Monto total</span>
                <strong>S/ @totalMontoReservas.ToString("N2")</strong>
            </div>
        </div>
    </div>
    @if (Model.PuedeEditar)
    {
        <div class="sc-acciones-masivas mb-3">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button type="button" id="btnSeleccionarPendientes" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-check2-square"></i> Seleccionar pendientes
                </button>
                <button type="button" id="btnMasivoConfirmar" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-check2-circle"></i> Confirmar seleccion
                </button>
                <button type="button" id="btnMasivoNoShow" class="btn btn-outline-dark btn-sm">
                    <i class="bi bi-person-x"></i> Marcar no show
                </button>
                <button type="button" id="btnMasivoRecordatorio" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-send"></i> Enviar recordatorio
                </button>
            </div>
            <small id="accionesMasivasFeedback" class="text-muted">Selecciona reservas en la tabla para aplicar acciones por lote.</small>
        </div>
    }
    <form method="get" asp-action="Index" class="sc-listado-filtro-form">
        <input type="hidden" name="negocioId" value="@Model.NegocioId" />
        <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="sedeId" value="@Model.SedeId" />
        <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
        <input type="hidden" name="estado" value="@Model.Estado" />
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">Desde (listado)</label>
                <input type="date" class="form-control" name="listadoDesde" value="@Model.ListadoFechaDesde.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Hasta (listado)</label>
                <input type="date" class="form-control" name="listadoHasta" value="@Model.ListadoFechaHasta.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-7">
                <label class="form-label d-block mb-1">Estados (puedes elegir varios)</label>
                <div class="sc-listado-estados-grid">
                    @foreach (var estadoItem in estadosListadoCatalogo)
                    {
                        var estadoValor = int.Parse(estadoItem.Value);
                        var checkedAttr = Model.EstadosListadoSeleccionados.Contains(estadoValor) ? "checked" : null;
                        <label class="sc-estado-check">
                            <input type="checkbox" name="estadosListado" value="@estadoItem.Value" @checkedAttr />
                            <span>@estadoItem.Text</span>
                        </label>
                    }
                </div>
            </div>
            <div class="col-md-1 d-grid">
                <button type="submit" class="btn btn-outline-primary">Aplicar</button>
            </div>
        </div>
    </form>
    @if (Model.Reservas.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-calendar-x"></i>
            <span>No hay reservas registradas con los filtros seleccionados.</span>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table id="tablaReservasDetallada" class="table table-sm align-middle">
                <thead>
                    <tr>
                        @if (Model.PuedeEditar)
                        {
                            <th style="width:42px;">
                                <input type="checkbox" id="chkReservasAll" class="form-check-input" />
                            </th>
                        }
                        <th>Id</th>
                        <th>Cliente</th>
                        <th>Sede</th>
                        <th>Espacio</th>
                        <th>Fecha</th>
                        <th>Horario</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Reservas)
                    {
                        <tr>
                            @if (Model.PuedeEditar)
                            {
                                <td>
                                    <input type="checkbox"
                                           class="form-check-input chk-reserva-item"
                                           value="@item.Id"
                                           data-estado="@item.Estado" />
                                </td>
                            }
                            <td>@item.Id</td>
                            <td>@item.Cliente</td>
                            <td>@item.Sede</td>
                            <td>@item.Espacio</td>
                            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@item.HoraInicio.ToString("HH\\:mm") - @item.HoraFin.ToString("HH\\:mm")</td>
                            <td>S/ @item.Total.ToString("N2")</td>
                            <td>
                                @{
                                    var estadoTexto = item.Estado switch
                                    {
                                        "1" => "Pendiente",
                                        "2" => "Confirmada",
                                        "3" => "En uso",
                                        "4" => "Finalizada",
                                        "5" => "Cancelada",
                                        "6" => "No asistio",
                                        _ => item.Estado
                                    };
                                }
                                @estadoTexto
                            </td>
                            <td class="text-end">
                                @if (Model.PuedeEditar)
                                {
                                    <a class="btn btn-sm sc-action-btn sc-action-edit" asp-action="Edit" asp-route-negocioId="@Model.NegocioId" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    @if (item.Estado == "1" || item.Estado == "2")
                                    {
                                        <form asp-action="CambiarEstadoTabla" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="nuevoEstado" value="3" />
                                            <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="sedeId" value="@Model.SedeId" />
                                            <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
                                            <input type="hidden" name="estado" value="@Model.Estado" />
                                            <button type="submit" class="btn btn-sm sc-action-btn sc-action-checkin">
                                                <i class="bi bi-box-arrow-in-right"></i> Check-in
                                            </button>
                                        </form>
                                        <form asp-action="CambiarEstadoTabla" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
