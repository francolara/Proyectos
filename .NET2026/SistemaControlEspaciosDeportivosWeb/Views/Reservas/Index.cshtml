<!-- Firma: Codex - 28/03/2026 | Ajustes visuales de acciones y calendario backend; tooltip y etiquetas visibles de estado/motivo en franjas bloqueadas; fix horario drag/drop y color bloqueado tomado del backend -->
@using System.Text.Json
@model SistemaControlEspaciosDeportivosWeb.ViewModels.ReservasIndexViewModel
<!-- Firma: Codex - 27/03/2026 | Calendario en espanol, bloqueos por sede, gestion por modal, bloqueo de fechas pasadas y rediseno visual SaaS del calendario -->
@{
    ViewData["Title"] = "Reservas";
    var sedeSeleccionadaTexto = Model.SedesFiltro.FirstOrDefault(x => x.Value == Model.SedeId?.ToString())?.Text ?? "Todas las sedes";
    var espacioSeleccionadoTexto = Model.EspaciosFiltro.FirstOrDefault(x => x.Value == Model.EspacioDeportivoId?.ToString())?.Text ?? "Todos los espacios";
}

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.14/index.global.min.css" rel="stylesheet" />

<header class="page-header">
    <div>
        <h1>Reservas y calendario</h1>
        <p class="page-subtitle">@Model.NegocioNombre | Rol: @Model.RolActual</p>
    </div>
    <div class="action-toolbar">
        @if (Model.PuedeCrear)
        {
            <button type="button" class="btn btn-outline-primary" id="btnNuevaReservaModal">
                <i class="bi bi-plus-circle"></i> Reserva manual
            </button>
        }
        <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Panel</a>
    </div>
</header>

@if (TempData["ReservasError"] is string reservasError && !string.IsNullOrWhiteSpace(reservasError))
{
    <div class="alert alert-danger">@reservasError</div>
}

<div class="sc-calendar-legend-card mb-3">
    <div class="sc-calendar-legend-header">
        <h2 class="h6 mb-0"><i class="bi bi-palette2"></i> Estado de reservas</h2>
        <small class="text-muted">Vista rapida por color para lectura inmediata del calendario.</small>
    </div>
    <div class="sc-calendar-legend-list">
        <span class="sc-legend-pill is-pendiente"><i></i>Pendiente</span>
        <span class="sc-legend-pill is-confirmada"><i></i>Confirmada</span>
        <span class="sc-legend-pill is-enuso"><i></i>En uso</span>
        <span class="sc-legend-pill is-finalizada"><i></i>Finalizada</span>
        <span class="sc-legend-pill is-cancelada"><i></i>Cancelada</span>
        <span class="sc-legend-pill is-noshow"><i></i>No show</span>
        <span class="sc-legend-pill is-bloqueada"><i></i>Bloqueada / No atencion</span>
    </div>
</div>

<form method="get" asp-action="Index" class="card card-body shadow-sm mb-3 sc-calendar-filter-card" id="filtrosForm">
    <input type="hidden" name="negocioId" value="@Model.NegocioId" />
    <div class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Desde</label>
            <input id="fechaDesde" type="date" class="form-control" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Hasta</label>
            <input id="fechaHasta" type="date" class="form-control" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Sede</label>
            <select id="sedeId" class="form-select" name="sedeId">
                <option value="">Todas</option>
                @foreach (var s in Model.SedesFiltro)
                {
                    <option value="@s.Value" selected="@(Model.SedeId?.ToString() == s.Value)">@s.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Espacio</label>
            <select id="espacioDeportivoId" class="form-select" name="espacioDeportivoId">
                <option value="">Todos</option>
                @foreach (var e in Model.EspaciosFiltro)
                {
                    <option value="@e.Value" selected="@(Model.EspacioDeportivoId?.ToString() == e.Value)">@e.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Estado</label>
            <select id="estado" class="form-select" name="estado">
                @foreach (var est in Model.EstadosFiltro)
                {
                    <option value="@est.Value" selected="@(Model.Estado?.ToString() == est.Value)">@est.Text</option>
                }
            </select>
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        </div>
    </div>
</form>

<section class="card border-0 shadow-sm mb-3 sc-calendar-card">
    <div class="card-body">
        <div class="sc-calendar-heading">
            <div>
                <h2 class="h6 mb-1">Agenda operativa</h2>
                <p class="mb-0 text-muted small">Haz clic en un dia/hora para ver disponibilidad. Arrastra reservas para mover horario.</p>
            </div>
            <div class="sc-calendar-context-wrap">
                <span class="sc-context-chip"><i class="bi bi-geo-alt"></i><strong>Sede:</strong> @sedeSeleccionadaTexto</span>
                <span class="sc-context-chip"><i class="bi bi-grid-3x3-gap"></i><strong>Espacio:</strong> @espacioSeleccionadoTexto</span>
            </div>
        </div>
        <div id="calendarioReservas"></div>
    </div>
</section>

<section class="card border-0 shadow-sm mb-4" id="panelDisponibilidadDia">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h6 mb-0">Disponibilidad por dia</h2>
            <small class="text-muted">Selecciona fecha en el calendario para ver horas libres.</small>
        </div>
        <div id="disponibilidadMensaje" class="text-muted small">Aun no has seleccionado una fecha.</div>
        <div id="disponibilidadSlots" class="d-flex flex-wrap gap-2 mt-2"></div>
    </div>
</section>

<section class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h6 mb-3">Bloquear horario</h2>
        @if (Model.PuedeEditar)
        {
            <form asp-action="CrearBloqueo" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="NegocioId" value="@Model.NegocioId" />
                <div class="col-md-3">
                    <label class="form-label">Espacio</label>
                    <select name="EspacioDeportivoId" class="form-select" required>
                        @foreach (var e in Model.BloqueoForm.Espacios)
                        {
                            <option value="@e.Value">@e.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Fecha</label>
                    <input type="date" class="form-control" name="Fecha" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Inicio</label>
                    <input type="time" class="form-control" name="HoraInicio" value="08:00" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Fin</label>
                    <input type="time" class="form-control" name="HoraFin" value="09:00" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Motivo</label>
                    <input type="text" class="form-control" name="Motivo" maxlength="250" required />
                </div>
                <div class="col-md-1 d-grid">
                    <button type="submit" class="btn btn-outline-danger">Bloquear</button>
                </div>
            </form>
        }
        else
        {
            <p class="text-muted mb-0">No tienes permisos para crear bloqueos.</p>
        }
    </div>
</section>

<div class="row g-3">
    <div class="col-xl-8">
        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Cliente</th>
                        <th>Sede</th>
                        <th>Espacio</th>
                        <th>Fecha</th>
                        <th>Horario</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Reservas)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Cliente</td>
                            <td>@item.Sede</td>
                            <td>@item.Espacio</td>
                            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@item.HoraInicio.ToString("HH\\:mm") - @item.HoraFin.ToString("HH\\:mm")</td>
                            <td>S/ @item.Total.ToString("N2")</td>
                            <td>
                                @{
                                    var estadoTexto = item.Estado switch
                                    {
                                        "1" => "Pendiente",
                                        "2" => "Confirmada",
                                        "3" => "En uso",
                                        "4" => "Finalizada",
                                        "5" => "Cancelada",
                                        "6" => "No asistio",
                                        _ => item.Estado
                                    };
                                }
                                @estadoTexto
                            </td>
                            <td class="text-end">
                                @if (Model.PuedeEditar)
                                {
                                    <a class="btn btn-sm sc-action-btn sc-action-edit" asp-action="Edit" asp-route-negocioId="@Model.NegocioId" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    @if (item.Estado == "1" || item.Estado == "2")
                                    {
                                        <form asp-action="CambiarEstadoTabla" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="nuevoEstado" value="3" />
                                            <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="sedeId" value="@Model.SedeId" />
                                            <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
                                            <input type="hidden" name="estado" value="@Model.Estado" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">Check-in</button>
                                        </form>
                                        <form asp-action="CambiarEstadoTabla" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="nuevoEstado" value="6" />
                                            <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="sedeId" value="@Model.SedeId" />
                                            <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
                                            <input type="hidden" name="estado" value="@Model.Estado" />
                                            <button type="submit" class="btn btn-sm btn-outline-dark">No show</button>
                                        </form>
                                    }
                                    else if (item.Estado == "3")
                                    {
                                        <form asp-action="CambiarEstadoTabla" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="nuevoEstado" value="4" />
                                            <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="sedeId" value="@Model.SedeId" />
                                            <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
                                            <input type="hidden" name="estado" value="@Model.Estado" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Check-out</button>
                                        </form>
                                    }
                                }
                                @if (Model.PuedeEliminar)
                                {
                                    <form asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm sc-action-btn sc-action-delete">
                                            <i class="bi bi-trash3"></i> Cancelar
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h6 mb-3">Bloqueos activos</h2>
                @if (Model.Bloqueos.Count == 0)
                {
                    <p class="text-muted mb-0">No hay bloqueos en el rango seleccionado.</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var b in Model.Bloqueos)
                        {
                            <div class="border rounded p-2">
                                <div class="small text-muted">@b.Fecha.ToString("dd/MM/yyyy") @b.HoraInicio.ToString("HH\\:mm") - @b.HoraFin.ToString("HH\\:mm")</div>
                                <div class="fw-semibold">@b.Sede - @b.Espacio</div>
                                <div class="small">@b.Motivo</div>
                                @if (Model.PuedeEliminar)
                                {
                                    <form asp-action="EliminarBloqueo" method="post" class="mt-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <input type="hidden" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
                                        <input type="hidden" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
                                        <input type="hidden" name="sedeId" value="@Model.SedeId" />
                                        <input type="hidden" name="espacioDeportivoId" value="@Model.EspacioDeportivoId" />
                                        <input type="hidden" name="estado" value="@Model.Estado" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Quitar bloqueo</button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="reservaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reservaModalTitulo">Nueva reserva</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="reservaModalForm" asp-action="GuardarReservaModal" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="modalReservaId" name="Id" value="0" />
                    <input type="hidden" id="modalNegocioId" name="NegocioId" value="@Model.NegocioId" />
                    <div id="reservaModalError" class="alert alert-danger d-none py-2"></div>
                    <div id="reservaModalDisponibilidad" class="alert d-none py-2"></div>
                    <div id="reservaModalAccionConflicto" class="mb-2 d-none">
                        <button type="button" id="btnVerReservaConflicto" class="btn btn-sm btn-outline-warning">
                            Ver reserva en conflicto
                        </button>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Espacio</label>
                            <select class="form-select" id="modalEspacioDeportivoId" name="EspacioDeportivoId" required>
                                <option value="">Selecciona...</option>
                                @foreach (var e in Model.EspaciosFiltro)
                                {
                                    <option value="@e.Value">@e.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Cliente</label>
                            <select class="form-select" id="modalClienteId" name="ClienteId" required>
                                <option value="">Selecciona...</option>
                                @foreach (var c in Model.ClientesFiltro)
                                {
                                    <option value="@c.Value">@c.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha</label>
                            <input type="date" class="form-control" id="modalFecha" name="Fecha" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Hora inicio</label>
                            <input type="time" class="form-control" id="modalHoraInicio" name="HoraInicio" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Hora fin</label>
                            <input type="time" class="form-control" id="modalHoraFin" name="HoraFin" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Estado</label>
                            <select class="form-select" id="modalEstado" name="Estado" required>
                                <option value="1">Pendiente</option>
                                <option value="2">Confirmada</option>
                                <option value="3">En uso</option>
                                <option value="4">Finalizada</option>
                                <option value="5">Cancelada</option>
                                <option value="6">No asistio</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Total</label>
                            <input type="number" min="0" step="0.01" class="form-control" id="modalTotal" name="Total" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Adelanto</label>
                            <input type="number" min="0" step="0.01" class="form-control" id="modalAdelanto" name="Adelanto" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="btnGuardarReservaModal">
                        <i class="bi bi-check2-circle me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.14/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.14/locales-all.global.min.js"></script>
    <script>
        (() => {
            const negocioId = @Model.NegocioId;
            const calendarioEl = document.getElementById('calendarioReservas');
            const formFiltros = document.getElementById('filtrosForm');
            const disponibilidadMensajeEl = document.getElementById('disponibilidadMensaje');
            const disponibilidadSlotsEl = document.getElementById('disponibilidadSlots');
            const reservaModalEl = document.getElementById('reservaModal');
            const reservaModal = new bootstrap.Modal(reservaModalEl);
            const reservaModalForm = document.getElementById('reservaModalForm');
            const reservaModalTitulo = document.getElementById('reservaModalTitulo');
            const reservaModalError = document.getElementById('reservaModalError');
            const reservaModalDisponibilidad = document.getElementById('reservaModalDisponibilidad');
            const btnGuardarReservaModal = document.getElementById('btnGuardarReservaModal');
            const reservaModalAccionConflicto = document.getElementById('reservaModalAccionConflicto');
            const btnVerReservaConflicto = document.getElementById('btnVerReservaConflicto');
            const getReservaModalUrl = '@Url.Action("ObtenerReservaModal", "Reservas")';
            const guardarReservaModalUrl = '@Url.Action("GuardarReservaModal", "Reservas")';
            const validarDisponibilidadModalUrl = '@Url.Action("ValidarDisponibilidadModal", "Reservas")';
            const btnNuevaReservaModal = document.getElementById('btnNuevaReservaModal');
            const hoyDate = new Date();
            const hoyIso = `${hoyDate.getFullYear()}-${String(hoyDate.getMonth() + 1).padStart(2, '0')}-${String(hoyDate.getDate()).padStart(2, '0')}`;
            const puedeCrearReserva = @Model.PuedeCrear.ToString().ToLowerInvariant();
            let timerValidacion = null;
            let conflictoReservaIdActual = null;
            const calendarioConfig = {
                usaHorarioSede: @Model.CalendarioUsaHorarioSede.ToString().ToLowerInvariant(),
                atiendeLunes: @Model.AtiendeLunes.ToString().ToLowerInvariant(),
                atiendeMartes: @Model.AtiendeMartes.ToString().ToLowerInvariant(),
                atiendeMiercoles: @Model.AtiendeMiercoles.ToString().ToLowerInvariant(),
                atiendeJueves: @Model.AtiendeJueves.ToString().ToLowerInvariant(),
                atiendeViernes: @Model.AtiendeViernes.ToString().ToLowerInvariant(),
                atiendeSabado: @Model.AtiendeSabado.ToString().ToLowerInvariant(),
                atiendeDomingo: @Model.AtiendeDomingo.ToString().ToLowerInvariant(),
                horaApertura: '@Model.HoraApertura.ToString("HH\\:mm")',
                horaCierre: '@Model.HoraCierre.ToString("HH\\:mm")',
                fechasNoLaborables: @Html.Raw(JsonSerializer.Serialize(Model.FechasNoLaborables))
            };
            const fechasNoLaborablesSet = new Set(calendarioConfig.fechasNoLaborables || []);

            function pad2(n) {
                return String(n).padStart(2, '0');
            }

            function formatDateIso(date) {
                return `${date.getFullYear()}-${pad2(date.getMonth() + 1)}-${pad2(date.getDate())}`;
            }

            function esFechaPasadaIso(fechaIso) {
                if (!fechaIso) return false;
                return fechaIso < hoyIso;
            }

            function formatTime(h, m) {
                return `${pad2(h)}:${pad2(m)}`;
            }

            function hexToRgba(hexColor, alpha) {
                const hex = String(hexColor || '').trim().replace('#', '');
                if (hex.length !== 6) return `rgba(100,116,139,${alpha})`;
                const r = parseInt(hex.slice(0, 2), 16);
                const g = parseInt(hex.slice(2, 4), 16);
                const b = parseInt(hex.slice(4, 6), 16);
                if (Number.isNaN(r) || Number.isNaN(g) || Number.isNaN(b)) return `rgba(100,116,139,${alpha})`;
                return `rgba(${r},${g},${b},${alpha})`;
            }

            function toLocalDateTimeString(date) {
                return `${date.getFullYear()}-${pad2(date.getMonth() + 1)}-${pad2(date.getDate())}T${pad2(date.getHours())}:${pad2(date.getMinutes())}:${pad2(date.getSeconds())}`;
            }

            function renderToolbarSubtitle(fechaInicio, fechaFinExclusiva) {
                const toolbarTitle = calendarioEl.querySelector('.fc-toolbar-title');
                if (!toolbarTitle) return;
                const chunk = toolbarTitle.closest('.fc-toolbar-chunk');
                if (!chunk) return;

                let subtitle = chunk.querySelector('.sc-fc-toolbar-subtitle');
                if (!subtitle) {
                    subtitle = document.createElement('div');
                    subtitle.className = 'sc-fc-toolbar-subtitle';
                    chunk.appendChild(subtitle);
                }

                const sedeSelect = document.getElementById('sedeId');
                const espacioSelect = document.getElementById('espacioDeportivoId');
                const sedeTexto = sedeSelect?.selectedOptions?.[0]?.text?.trim() || 'Todas las sedes';
                const espacioTexto = espacioSelect?.selectedOptions?.[0]?.text?.trim() || 'Todos los espacios';

                let rangoTexto = '';
                if (fechaInicio && fechaFinExclusiva) {
                    const fin = new Date(fechaFinExclusiva.getTime() - 1);
                    rangoTexto = `${formatDateIso(fechaInicio)} a ${formatDateIso(fin)}`;
                }

                subtitle.innerHTML = `<span><i class="bi bi-geo-alt"></i> ${sedeTexto}</span><span><i class="bi bi-grid-3x3-gap"></i> ${espacioTexto}</span><span><i class="bi bi-calendar-range"></i> ${rangoTexto}</span>`;
            }

            function classByEstado(estado, tipoEvento) {
                if (tipoEvento === 'BLOQUEO' || tipoEvento === 'NO_ATENCION') return 'is-bloqueada';
                switch (String(estado ?? '')) {
                    case '1': return 'is-pendiente';
                    case '2': return 'is-confirmada';
                    case '3': return 'is-enuso';
                    case '4': return 'is-finalizada';
                    case '5': return 'is-cancelada';
                    case '6': return 'is-noshow';
                    default: return 'is-reservada';
                }
            }

            function colorTextoByEstado(estado, tipoEvento) {
                const clase = classByEstado(estado, tipoEvento);
                switch (clase) {
                    case 'is-pendiente': return '#7c2d12';
                    case 'is-confirmada': return '#166534';
                    case 'is-enuso': return '#1d4ed8';
                    case 'is-finalizada': return '#0f4e63';
                    case 'is-cancelada': return '#991b1b';
                    case 'is-noshow': return '#5b21b6';
                    default: return '#1e3a8a';
                }
            }

            function normalizarEstado(estado) {
                const value = String(estado ?? '').trim().toLowerCase();
                if (value === '1' || value === 'pendiente') return 1;
                if (value === '2' || value === 'confirmada') return 2;
                if (value === '3' || value === 'en uso' || value === 'enuso') return 3;
                if (value === '4' || value === 'finalizada' || value === 'pagado') return 4;
                if (value === '5' || value === 'cancelada') return 5;
                if (value === '6' || value === 'no asistio' || value === 'no show' || value === 'noshow') return 6;
                return 1;
            }

            function limpiarErrorModal() {
                reservaModalError.classList.add('d-none');
                reservaModalError.textContent = '';
            }

            function limpiarDisponibilidadModal() {
                reservaModalDisponibilidad.classList.add('d-none');
                reservaModalDisponibilidad.classList.remove('alert-success', 'alert-warning');
                reservaModalDisponibilidad.textContent = '';
                conflictoReservaIdActual = null;
                reservaModalAccionConflicto.classList.add('d-none');
            }

            function mostrarErrorModal(msg) {
                reservaModalError.textContent = msg || 'No se pudo guardar la reserva.';
                reservaModalError.classList.remove('d-none');
            }

            function mostrarDisponibilidadModal(disponible, mensaje, conflictoTipo, conflictoId) {
                reservaModalDisponibilidad.classList.remove('d-none');
                reservaModalDisponibilidad.classList.toggle('alert-success', disponible);
                reservaModalDisponibilidad.classList.toggle('alert-warning', !disponible);
                reservaModalDisponibilidad.textContent = mensaje;
                btnGuardarReservaModal.disabled = !disponible;

                conflictoReservaIdActual = null;
                reservaModalAccionConflicto.classList.add('d-none');
                if (!disponible && String(conflictoTipo || '').toUpperCase() === 'RESERVA' && conflictoId) {
                    conflictoReservaIdActual = conflictoId;
                    btnVerReservaConflicto.textContent = `Ver reserva #${conflictoId}`;
                    reservaModalAccionConflicto.classList.remove('d-none');
                }
            }

            function setValue(id, value) {
                const el = document.getElementById(id);
                el.value = value ?? '';
            }

            function getFiltroEspacioSeleccionado() {
                return document.getElementById('espacioDeportivoId').value || '';
            }

            function getFiltroSedeSeleccionada() {
                return document.getElementById('sedeId').value || '';
            }

            function validarAperturaReserva(fechaHora) {
                if (!getFiltroSedeSeleccionada()) {
                    return { ok: false, mensaje: 'Selecciona una sede para respetar su horario de atencion.' };
                }
                if (formatDateIso(fechaHora) < hoyIso) {
                    return { ok: false, mensaje: 'No se permiten reservas en fechas pasadas.' };
                }
                if (!sePuedeOperar(fechaHora)) {
                    return { ok: false, mensaje: 'La sede no atiende en ese dia u horario.' };
                }
                return { ok: true, mensaje: '' };
            }

            function abrirModalNuevaReserva(fechaIso, horaInicio, horaFin, espacioId) {
                if (!getFiltroSedeSeleccionada()) {
                    alert('Selecciona una sede antes de crear una reserva.');
                    return;
                }
                limpiarErrorModal();
                limpiarDisponibilidadModal();
                reservaModalTitulo.textContent = 'Nueva reserva';
                setValue('modalReservaId', 0);
                const fechaInicial = fechaIso && !esFechaPasadaIso(fechaIso) ? fechaIso : hoyIso;
                setValue('modalFecha', fechaInicial);
                setValue('modalHoraInicio', horaInicio || '18:00');
                setValue('modalHoraFin', horaFin || '19:00');
                setValue('modalEstado', 1);
                setValue('modalTotal', '0.00');
                setValue('modalAdelanto', '0.00');
                setValue('modalEspacioDeportivoId', espacioId || getFiltroEspacioSeleccionado());
                setValue('modalClienteId', '');
                reservaModal.show();
                validarDisponibilidadModal();
            }

            function abrirModalEditarReserva(reservaId) {
                limpiarErrorModal();
                limpiarDisponibilidadModal();
                fetch(`${getReservaModalUrl}?negocioId=${negocioId}&id=${reservaId}`)
                    .then(async r => {
                        const payload = await r.json();
                        if (!r.ok || !payload.ok) {
                            throw new Error(payload.mensaje || 'No se pudo obtener la reserva.');
                        }
                        return payload;
                    })
                    .then(data => {
                        reservaModalTitulo.textContent = `Editar reserva #${data.id}`;
                        setValue('modalReservaId', data.id);
                        setValue('modalEspacioDeportivoId', data.espacioDeportivoId);
                        setValue('modalClienteId', data.clienteId);
                        setValue('modalFecha', data.fecha);
                        setValue('modalHoraInicio', data.horaInicio);
                        setValue('modalHoraFin', data.horaFin);
                        setValue('modalEstado', data.estado);
                        setValue('modalTotal', data.total ?? '0.00');
                        setValue('modalAdelanto', data.adelanto ?? '0.00');
                        reservaModal.show();
                        validarDisponibilidadModal();
                    })
                    .catch(err => alert(err.message));
            }

            function validarDisponibilidadModal() {
                limpiarErrorModal();
                const reservaId = document.getElementById('modalReservaId').value || '';
                const espacioId = document.getElementById('modalEspacioDeportivoId').value || '';
                const fecha = document.getElementById('modalFecha').value || '';
                const horaInicio = document.getElementById('modalHoraInicio').value || '';
                const horaFin = document.getElementById('modalHoraFin').value || '';

                if (!espacioId || !fecha || !horaInicio || !horaFin) {
                    limpiarDisponibilidadModal();
                    btnGuardarReservaModal.disabled = true;
                    return;
                }
                if (esFechaPasadaIso(fecha)) {
                    mostrarDisponibilidadModal(false, 'No se permite registrar reservas en fechas pasadas.', null, null);
                    return;
                }

                const params = new URLSearchParams();
                params.append('negocioId', negocioId);
                if (reservaId && Number(reservaId) > 0) params.append('reservaId', reservaId);
                params.append('espacioDeportivoId', espacioId);
                params.append('fecha', fecha);
                params.append('horaInicio', horaInicio);
                params.append('horaFin', horaFin);

                fetch(`${validarDisponibilidadModalUrl}?${params.toString()}`)
                    .then(async r => {
                        const payload = await r.json();
                        if (!r.ok || !payload.ok) {
                            throw new Error(payload.mensaje || 'No se pudo validar disponibilidad.');
                        }
                        mostrarDisponibilidadModal(payload.disponible, payload.mensaje, payload.conflictoTipo, payload.conflictoId);
                    })
                    .catch(err => {
                        mostrarDisponibilidadModal(false, err.message, null, null);
                    });
            }

            function validarDisponibilidadModalDebounce() {
                if (timerValidacion) {
                    clearTimeout(timerValidacion);
                }
                timerValidacion = setTimeout(validarDisponibilidadModal, 220);
            }

            function minutosDesdeHora(hhmm) {
                const [h, m] = String(hhmm || '00:00').split(':').map(x => parseInt(x, 10));
                return (h * 60) + m;
            }

            function esDiaAtencion(date) {
                const dow = date.getDay();
                if (dow === 1) return calendarioConfig.atiendeLunes;
                if (dow === 2) return calendarioConfig.atiendeMartes;
                if (dow === 3) return calendarioConfig.atiendeMiercoles;
                if (dow === 4) return calendarioConfig.atiendeJueves;
                if (dow === 5) return calendarioConfig.atiendeViernes;
                if (dow === 6) return calendarioConfig.atiendeSabado;
                return calendarioConfig.atiendeDomingo;
            }

            function estaEnHorario(date) {
                const minuto = (date.getHours() * 60) + date.getMinutes();
                const apertura = minutosDesdeHora(calendarioConfig.horaApertura);
                const cierre = minutosDesdeHora(calendarioConfig.horaCierre);
                return minuto >= apertura && minuto < cierre;
            }

            function esFechaNoLaborable(date) {
                return fechasNoLaborablesSet.has(formatDateIso(date));
            }

            function sePuedeOperar(date) {
                if (!calendarioConfig.usaHorarioSede) return true;
                if (!esDiaAtencion(date)) return false;
                if (esFechaNoLaborable(date)) return false;
                return estaEnHorario(date);
            }

            function nombreDia(dow) {
                switch (dow) {
                    case 0: return 'Domingo';
                    case 1: return 'Lunes';
                    case 2: return 'Martes';
                    case 3: return 'Miercoles';
                    case 4: return 'Jueves';
                    case 5: return 'Viernes';
                    case 6: return 'Sabado';
                    default: return 'Dia';
                }
            }

            function obtenerMotivoNoAtencionPorFecha(fecha) {
                if (!(fecha instanceof Date) || Number.isNaN(fecha.getTime())) {
                    return 'No atencion';
                }
                if (!calendarioConfig.usaHorarioSede) {
                    return 'No atencion';
                }
                if (esFechaNoLaborable(fecha)) {
                    return 'Fecha no laborable';
                }
                if (!esDiaAtencion(fecha)) {
                    return `${nombreDia(fecha.getDay())} no atendido`;
                }
                if (!estaEnHorario(fecha)) {
                    return `Fuera de horario ${calendarioConfig.horaApertura}-${calendarioConfig.horaCierre}`;
                }
                return 'No atencion';
            }

            function obtenerTooltipBloqueo(arg) {
                const tipo = String(arg.event.extendedProps.tipoEvento || '').toUpperCase();
                const motivoApi = arg.event.extendedProps.motivo || arg.event.extendedProps.detalle || arg.event.title;
                if (tipo === 'NO_ATENCION') {
                    return String(motivoApi || obtenerMotivoNoAtencionPorFecha(arg.event.start) || 'No atencion');
                }
                if (tipo === 'BLOQUEO') {
                    return String(motivoApi || 'Horario bloqueado por administracion');
                }
                return '';
            }

            const businessDays = [];
            if (calendarioConfig.atiendeDomingo) businessDays.push(0);
            if (calendarioConfig.atiendeLunes) businessDays.push(1);
            if (calendarioConfig.atiendeMartes) businessDays.push(2);
            if (calendarioConfig.atiendeMiercoles) businessDays.push(3);
            if (calendarioConfig.atiendeJueves) businessDays.push(4);
            if (calendarioConfig.atiendeViernes) businessDays.push(5);
            if (calendarioConfig.atiendeSabado) businessDays.push(6);

            const businessHoursConfig = calendarioConfig.usaHorarioSede
                ? [{
                    daysOfWeek: businessDays,
                    startTime: `${calendarioConfig.horaApertura}:00`,
                    endTime: `${calendarioConfig.horaCierre}:00`
                }]
                : true;

            function hayCruce(inicioMin, finMin, ocupados) {
                for (const tramo of ocupados) {
                    if (inicioMin < tramo.fin && finMin > tramo.inicio) {
                        return true;
                    }
                }
                return false;
            }

            function renderDisponibilidadDia(dateClick) {
                const espacioId = document.getElementById('espacioDeportivoId').value;
                disponibilidadSlotsEl.innerHTML = '';

                if (!getFiltroSedeSeleccionada()) {
                    disponibilidadMensajeEl.textContent = 'Selecciona una sede para ver disponibilidad segun su horario de atencion.';
                    return;
                }

                if (!espacioId) {
                    disponibilidadMensajeEl.textContent = 'Selecciona un espacio en el filtro para ver disponibilidad exacta por dia.';
                    return;
                }

                const fechaIso = formatDateIso(dateClick);
                if (esFechaPasadaIso(fechaIso)) {
                    disponibilidadMensajeEl.textContent = `La fecha ${fechaIso} ya paso. Solo se pueden registrar reservas desde hoy.`;
                    return;
                }
                const eventosDiaEspacio = calendar.getEvents().filter(ev => {
                    const inicio = ev.start;
                    if (!inicio) return false;
                    const mismoDia = formatDateIso(inicio) === fechaIso;
                    const mismoEspacio = String(ev.extendedProps.espacioDeportivoId ?? '') === String(espacioId);
                    return mismoDia && mismoEspacio;
                });

                const ocupados = eventosDiaEspacio.map(ev => {
                    const start = ev.start;
                    const end = ev.end ?? ev.start;
                    return {
                        inicio: (start.getHours() * 60) + start.getMinutes(),
                        fin: (end.getHours() * 60) + end.getMinutes()
                    };
                });

                const inicioDia = 6 * 60;
                const finDia = 24 * 60;
                let slotsLibres = 0;

                for (let minuto = inicioDia; minuto < finDia; minuto += 60) {
                    const fin = minuto + 60;
                    const fechaSlot = new Date(dateClick.getFullYear(), dateClick.getMonth(), dateClick.getDate(), Math.floor(minuto / 60), minuto % 60, 0, 0);
                    if (!sePuedeOperar(fechaSlot)) {
                        continue;
                    }
                    if (hayCruce(minuto, fin, ocupados)) {
                        continue;
                    }

                    const hi = Math.floor(minuto / 60);
                    const mi = minuto % 60;
                    const hf = Math.floor(fin / 60);
                    const mf = fin % 60;

                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'btn btn-sm btn-outline-success';
                    btn.textContent = `${formatTime(hi, mi)} - ${formatTime(hf, mf)}`;
                    btn.addEventListener('click', () => {
                        abrirModalNuevaReserva(fechaIso, formatTime(hi, mi), formatTime(hf, mf), espacioId);
                    });
                    disponibilidadSlotsEl.appendChild(btn);
                    slotsLibres++;
                }

                if (slotsLibres === 0) {
                    disponibilidadMensajeEl.textContent = `No hay horas libres para ${fechaIso} en el espacio seleccionado.`;
                    return;
                }

                disponibilidadMensajeEl.textContent = `Horas disponibles para ${fechaIso}: ${slotsLibres} bloque(s) libre(s).`;
            }

            function armarUrlEventos(info) {
                const sedeId = document.getElementById('sedeId').value;
                const espacioDeportivoId = document.getElementById('espacioDeportivoId').value;
                const estado = document.getElementById('estado').value;
                const params = new URLSearchParams();
                params.append('negocioId', negocioId);
                params.append('start', info.startStr);
                params.append('end', info.endStr);
                params.append('_ts', Date.now().toString());
                if (sedeId) params.append('sedeId', sedeId);
                if (espacioDeportivoId) params.append('espacioDeportivoId', espacioDeportivoId);
                if (estado) params.append('estado', estado);
                return '@Url.Action("CalendarioEventos", "Reservas")' + '?' + params.toString();
            }

            const calendar = new FullCalendar.Calendar(calendarioEl, {
                initialView: 'timeGridWeek',
                locale: 'es',
                firstDay: 1,
                allDaySlot: false,
                dayHeaderFormat: { weekday: 'short', day: '2-digit', month: '2-digit' },
                slotLabelFormat: {
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: false
                },
                slotLabelInterval: '01:00:00',
                slotDuration: '00:30:00',
                slotMinTime: '06:00:00',
                slotMaxTime: '24:00:00',
                nowIndicator: true,
                editable: true,
                selectable: true,
                businessHours: businessHoursConfig,
                selectConstraint: calendarioConfig.usaHorarioSede ? 'businessHours' : undefined,
                height: 'auto',
                expandRows: true,
                buttonText: {
                    today: 'Hoy',
                    week: 'Semana',
                    day: 'Dia',
                    month: 'Mes'
                },
                customButtons: {
                    nuevaReserva: {
                        text: 'Nueva reserva',
                        click: function() {
                            abrirModalNuevaReserva();
                        }
                    }
                },
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: puedeCrearReserva ? 'timeGridWeek,timeGridDay,dayGridMonth nuevaReserva' : 'timeGridWeek,timeGridDay,dayGridMonth'
                },
                eventClassNames: function(arg) {
                    if (arg.event.display === 'background') {
                        return [];
                    }
                    return ['sc-fc-event', classByEstado(arg.event.extendedProps.estado, arg.event.extendedProps.tipoEvento)];
                },
                eventContent: function(arg) {
                    const timeText = arg.timeText ? `<div class="sc-fc-event-time">${arg.timeText}</div>` : '';
                    return { html: `<div class="sc-fc-event-inner"><div class="sc-fc-event-title">${arg.event.title || ''}</div>${timeText}</div>` };
                },
                eventDidMount: function(arg) {
                    if (arg.event.display === 'background') {
                        const tipo = String(arg.event.extendedProps.tipoEvento || '').toUpperCase();
                        if (tipo === 'NO_ATENCION' || tipo === 'BLOQUEO') {
                            const colorBloqueo = String(arg.event.backgroundColor || arg.event.borderColor || '#64748b').trim();
                            arg.el.style.background = `repeating-linear-gradient(-45deg, ${hexToRgba(colorBloqueo, 0.24)}, ${hexToRgba(colorBloqueo, 0.24)} 8px, ${hexToRgba(colorBloqueo, 0.14)} 8px, ${hexToRgba(colorBloqueo, 0.14)} 16px)`;
                            arg.el.style.borderColor = hexToRgba(colorBloqueo, 0.45);
                            const motivoTexto = String(arg.event.title || '').trim();
                            if (motivoTexto) {
                                const motivo = document.createElement('span');
                                motivo.className = 'sc-bg-motivo-inline';
                                motivo.textContent = motivoTexto;
                                arg.el.appendChild(motivo);
                            }
                            const estadoTexto = String(arg.event.extendedProps.estadoTexto || '').trim();
                            if (estadoTexto) {
                                arg.el.setAttribute('data-estado-label', estadoTexto);
                                arg.el.classList.add('sc-bg-estado-label');
                                const badge = document.createElement('span');
                                badge.className = 'sc-bg-estado-inline';
                                badge.textContent = estadoTexto;
                                arg.el.appendChild(badge);
                            }
                            const textoTooltip = obtenerTooltipBloqueo(arg);
                            if (textoTooltip) {
                                arg.el.setAttribute('title', textoTooltip);
                                arg.el.setAttribute('data-bs-toggle', 'tooltip');
                                arg.el.setAttribute('data-bs-placement', 'top');
                                arg.el.setAttribute('data-bs-custom-class', 'sc-tooltip');
                                if (window.bootstrap && bootstrap.Tooltip) {
                                    const tip = new bootstrap.Tooltip(arg.el, {
                                        container: 'body',
                                        trigger: 'hover'
                                    });
                                    arg.el._scTooltip = tip;
                                }
                            }
                        }
                        return;
                    }
                    const estado = arg.event.extendedProps.estado;
                    const tipo = arg.event.extendedProps.tipoEvento;
                    const colorTexto = colorTextoByEstado(estado, tipo);
                    arg.el.style.color = colorTexto;
                    arg.el.style.setProperty('--fc-event-text-color', colorTexto);
                    arg.el.querySelectorAll('.sc-fc-event-title, .sc-fc-event-time, .fc-event-main, .fc-event-title, .fc-event-time').forEach(el => {
                        el.style.color = colorTexto;
                    });
                },
                eventWillUnmount: function(arg) {
                    if (arg.el && arg.el._scTooltip && typeof arg.el._scTooltip.dispose === 'function') {
                        arg.el._scTooltip.dispose();
                    }
                },
                datesSet: function(info) {
                    renderToolbarSubtitle(info.start, info.end);
                },
                events: function(info, success, failure) {
                    fetch(armarUrlEventos(info), { cache: 'no-store' })
                        .then(r => r.json())
                        .then(data => {
                            const eventosApi = data.flatMap(ev => {
                                const tipo = String(ev.tipoEvento || '');
                                const colorEvento = ev.backgroundColor || ev.borderColor || ev.color || '#64748b';
                                const base = { ...ev };
                                delete base.backgroundColor;
                                delete base.borderColor;
                                delete base.textColor;
                                delete base.color;
                                if (tipo === 'NO_ATENCION') {
                                    return [{ ...base, display: 'background', classNames: ['sc-no-atencion-bg'], editable: false, overlap: false, backgroundColor: colorEvento, borderColor: colorEvento }];
                                }
                                if (tipo === 'BLOQUEO') {
                                    return [{ ...base, display: 'background', classNames: ['sc-bloqueo-bg'], editable: false, overlap: false, backgroundColor: colorEvento, borderColor: colorEvento }];
                                }
                                const estadoClase = classByEstado(base.estado, base.tipoEvento);
                                const fondoEstado = {
                                    ...base,
                                    id: `BG-${base.id}`,
                                    title: '',
                                    display: 'background',
                                    editable: false,
                                    overlap: true,
                                    classNames: ['sc-reserva-slot-bg', estadoClase]
                                };
                                base.textColor = colorTextoByEstado(base.estado, base.tipoEvento);
                                return [fondoEstado, base];
                            });
                            success(eventosApi);
                        })
                        .catch(err => failure(err));
                },
                dateClick: function(info) {
                    if (!info.allDay) {
                        const inicio = info.date;
                        const validacion = validarAperturaReserva(inicio);
                        if (!validacion.ok) {
                            alert(validacion.mensaje);
                            return;
                        }
                        const fin = new Date(inicio.getTime() + (60 * 60000));
                        abrirModalNuevaReserva(
                            formatDateIso(inicio),
                            formatTime(inicio.getHours(), inicio.getMinutes()),
                            formatTime(fin.getHours(), fin.getMinutes()),
                            getFiltroEspacioSeleccionado()
                        );
                        return;
                    }
                    renderDisponibilidadDia(info.date);
                },
                select: function(info) {
                    if (!sePuedeOperar(info.start)) {
                        return;
                    }
                    renderDisponibilidadDia(info.start);
                },
                eventDrop: function(info) {
                    if (!info.event.extendedProps.reservaId) {
                        info.revert();
                        return;
                    }

                    fetch('@Url.Action("MoverEvento", "Reservas")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            negocioId: negocioId,
                            reservaId: info.event.extendedProps.reservaId,
                            inicio: toLocalDateTimeString(info.event.start),
                            fin: toLocalDateTimeString(info.event.end ? info.event.end : info.event.start)
                        })
                    })
                    .then(async r => {
                        const payload = await r.json();
                        if (!r.ok || !payload.ok) {
                            throw new Error(payload.mensaje || 'No se pudo mover la reserva.');
                        }
                        calendar.refetchEvents();
                        renderDisponibilidadDia(info.event.start ?? new Date());
                    })
                    .catch(err => {
                        alert(err.message);
                        info.revert();
                    });
                },
                eventResize: function(info) {
                    if (!info.event.extendedProps.reservaId) {
                        info.revert();
                        return;
                    }

                    fetch('@Url.Action("MoverEvento", "Reservas")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            negocioId: negocioId,
                            reservaId: info.event.extendedProps.reservaId,
                            inicio: toLocalDateTimeString(info.event.start),
                            fin: toLocalDateTimeString(info.event.end ? info.event.end : info.event.start)
                        })
                    })
                    .then(async r => {
                        const payload = await r.json();
                        if (!r.ok || !payload.ok) {
                            throw new Error(payload.mensaje || 'No se pudo redimensionar la reserva.');
                        }
                        calendar.refetchEvents();
                        renderDisponibilidadDia(info.event.start ?? new Date());
                    })
                    .catch(err => {
                        alert(err.message);
                        info.revert();
                    });
                },
                eventClick: function(info) {
                    const reservaId = info.event.extendedProps.reservaId;
                    if (!reservaId) {
                        return;
                    }
                    abrirModalEditarReserva(reservaId);
                }
            });

            calendar.render();
            document.getElementById('modalFecha').setAttribute('min', hoyIso);
            renderToolbarSubtitle(calendar.view.currentStart, calendar.view.currentEnd);
            renderDisponibilidadDia(new Date());
            if (btnNuevaReservaModal) {
                btnNuevaReservaModal.addEventListener('click', () => abrirModalNuevaReserva());
            }

            btnVerReservaConflicto.addEventListener('click', () => {
                if (!conflictoReservaIdActual) return;
                abrirModalEditarReserva(conflictoReservaIdActual);
            });

            ['modalEspacioDeportivoId', 'modalFecha', 'modalHoraInicio', 'modalHoraFin']
                .forEach(id => {
                    const el = document.getElementById(id);
                    if (!el) return;
                    el.addEventListener('change', validarDisponibilidadModalDebounce);
                    el.addEventListener('keyup', validarDisponibilidadModalDebounce);
                });

            reservaModalForm.addEventListener('submit', function (e) {
                e.preventDefault();
                limpiarErrorModal();
                if (btnGuardarReservaModal.disabled) {
                    mostrarErrorModal('Debes corregir la disponibilidad antes de guardar.');
                    return;
                }
                const data = new FormData(reservaModalForm);
                fetch(guardarReservaModalUrl, {
                    method: 'POST',
                    body: data
                })
                .then(async r => {
                    const payload = await r.json();
                    if (!r.ok || !payload.ok) {
                        throw new Error(payload.mensaje || 'No se pudo guardar la reserva.');
                    }
                    reservaModal.hide();
                    calendar.refetchEvents();
                    renderDisponibilidadDia(new Date(document.getElementById('modalFecha').value + 'T00:00:00'));
                    setTimeout(() => calendar.refetchEvents(), 250);
                })
                .catch(err => mostrarErrorModal(err.message));
            });

            formFiltros.addEventListener('submit', () => {
                const inicio = document.getElementById('fechaDesde').value;
                if (inicio) {
                    calendar.gotoDate(inicio);
                }
            });

            ['sedeId', 'espacioDeportivoId', 'estado'].forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                el.addEventListener('change', () => {
                    renderToolbarSubtitle(calendar.view.currentStart, calendar.view.currentEnd);
                });
            });
        })();
    </script>
}


