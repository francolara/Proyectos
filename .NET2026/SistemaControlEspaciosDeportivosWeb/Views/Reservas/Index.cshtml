                                    <option value="@fp.Value">@fp.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha de pago</label>
                            <input type="date" class="form-control" id="modalFechaPago" name="FechaPago" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" disabled />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">N° Operación</label>
                            <input type="text" class="form-control" id="modalNumeroOperacion" name="NumeroOperacion" maxlength="50" placeholder="Opcional" autocomplete="off" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Politica de confirmacion</label>
                            <div id="modalPoliticaPagoInfo" class="form-control bg-light" style="height:auto; min-height: 2.4rem;">
