@using SistemaControlEspaciosDeportivosWeb.Models
@model SistemaControlEspaciosDeportivosWeb.ViewModels.ReservaFormViewModel
@{
    ViewData["Title"] = "Nueva reserva";
    var horasMediaHora = Enumerable.Range(0, 48)
        .Select(i => TimeOnly.FromTimeSpan(TimeSpan.FromMinutes(i * 30)))
        .ToList();
}

<div class="admin-page-frame">
    <section class="page-header">
        <div>
            <h1>Nueva reserva</h1>
            <p class="page-subtitle">Programa fecha, horario, cliente y datos economicos de la reserva.</p>
        </div>
        <div class="action-toolbar">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>
        </div>
    </section>

    <form asp-action="Create" method="post" class="sc-form-shell">
        <input type="hidden" asp-for="NegocioId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-0"></div>

        <section class="sc-form-card">
            <div class="sc-form-section">
                <h2 class="sc-form-title"><i class="bi bi-calendar2-check"></i> Datos de la reserva</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="EspacioDeportivoId" class="form-label">Espacio</label>
                        <select asp-for="EspacioDeportivoId" asp-items="Model.Espacios" class="form-select"></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ClienteId" class="form-label">Cliente</label>
                        <select asp-for="ClienteId" asp-items="Model.Clientes" class="form-select"></select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Fecha" class="form-label"></label>
                        <input asp-for="Fecha" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="HoraInicio" class="form-label"></label>
                        <select asp-for="HoraInicio" class="form-select">
                            @foreach (var hora in horasMediaHora)
                            {
                                <option value="@hora.ToString("HH\\:mm")">@hora.ToString("HH\\:mm")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="HoraFin" class="form-label"></label>
                        <select asp-for="HoraFin" class="form-select">
                            @foreach (var hora in horasMediaHora)
                            {
                                <option value="@hora.ToString("HH\\:mm")">@hora.ToString("HH\\:mm")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Estado" class="form-label"></label>
                        <select asp-for="Estado" class="form-select">
                            <option value="1">Pendiente</option>
                            <option value="2">Confirmada</option>
                            <option value="4">Pagada</option>
                            <option value="5">Cancelada</option>
                            <option value="6">No Asistio</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Total" class="form-label"></label>
                        <input asp-for="Total" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Adelanto" class="form-label"></label>
                        <input asp-for="Adelanto" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" id="chkTengoCupon" />
                            <label class="form-check-label" for="chkTengoCupon">Tengo un cupon</label>
                        </div>
                        <label asp-for="CodigoCupon" class="form-label">Codigo cupon</label>
                        <div class="input-group">
                            <input asp-for="CodigoCupon" class="form-control" maxlength="30" />
                            <button type="button" class="btn btn-outline-primary" id="btnValidarCupon">Validar</button>
                        </div>
                        <small id="cuponMensaje" class="text-muted"></small>
                    </div>
                </div>
            </div>
        </section>

        <div class="sc-form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2-circle me-1"></i> Guardar reserva
            </button>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const btn = document.getElementById('btnValidarCupon');
            const msg = document.getElementById('cuponMensaje');
            const codigo = document.getElementById('CodigoCupon');
            const chk = document.getElementById('chkTengoCupon');
            const total = document.getElementById('Total');
            const espacio = document.getElementById('EspacioDeportivoId');
            if (!btn || !msg || !codigo || !chk || !total || !espacio) return;
            const negocioId = @Model.NegocioId;
            function syncCuponUI() {
                const enabled = chk.checked;
                codigo.disabled = !enabled;
                btn.disabled = !enabled;
                if (!enabled) {
                    codigo.value = '';
                    msg.textContent = '';
                    msg.className = 'text-muted';
                }
            }
            chk.addEventListener('change', syncCuponUI);
            syncCuponUI();

            btn.addEventListener('click', async () => {
                msg.className = 'text-muted';
                msg.textContent = '';
                const cod = (codigo.value || '').trim();
                const monto = Number(total.value || '0');
                const espacioId = Number(espacio.value || '0');
                if (!cod) {
                    msg.textContent = 'Ingresa un cupón.';
                    return;
                }
                if (espacioId <= 0 || monto <= 0) {
                    msg.textContent = 'Selecciona espacio y monto válido antes de validar.';
                    return;
                }

                const qs = new URLSearchParams({
                    negocioId: String(negocioId),
                    espacioDeportivoId: String(espacioId),
                    codigoCupon: cod,
                    montoBase: String(monto)
                });
                const r = await fetch('@Url.Action("ValidarCuponReserva", "Reservas")' + '?' + qs.toString(), { cache: 'no-store' });
                if (!r.ok) {
                    msg.className = 'text-danger';
                    msg.textContent = 'No se pudo validar el cupón.';
                    return;
                }
                const data = await r.json();
                if (!data.ok || !data.esValido) {
                    msg.className = 'text-danger';
                    msg.textContent = data.mensaje || 'Cupón inválido.';
                    return;
                }

                total.value = Number(data.montoFinal || monto).toFixed(2);
                codigo.value = data.codigoCupon || cod.toUpperCase();
                msg.className = 'text-success';
                msg.textContent = `${data.mensaje} Nuevo total: ${Number(data.montoFinal).toFixed(2)}`;
            });
        })();
    </script>
}

