@model SistemaControlEspaciosDeportivosWeb.ViewModels.PagoReservaEditViewModel
@{
    ViewData["Title"] = $"Editar pagos reserva {Model.ReservaCodigo}";
    var totalPagos = Model.Pagos?.Count ?? 0;
    var soloLecturaComprobante = Model.TieneComprobanteActivo;
}

<div class="admin-page-frame">
    <section class="page-header">
        <div>
            <h1>Editar pagos de reserva</h1>
            <p class="page-subtitle">@Model.NegocioNombre | Rol: @Model.RolActual</p>
        </div>
        <div class="action-toolbar">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>
        </div>
    </section>

    <section class="kpi-grid mb-3">
        <article class="kpi-card">
            <p class="kpi-card-label">Reserva</p>
            <h3 class="kpi-card-value">@Model.ReservaCodigo</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Total pagos</p>
            <h3 class="kpi-card-value">@totalPagos</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Monto pagado</p>
            <h3 class="kpi-card-value">@Model.MonedaSimbolo @Model.TotalPagado.ToString("N2")</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Saldo pendiente</p>
            <h3 class="kpi-card-value">@Model.MonedaSimbolo @Model.SaldoPendiente.ToString("N2")</h3>
        </article>
    </section>

    <section class="sc-form-card mb-3">
        <div class="sc-form-section">
            <h2 class="sc-form-title"><i class="bi bi-card-list"></i> Datos de la reserva</h2>
            <div class="row g-2">
                <div class="col-md-2"><span class="badge bg-light text-dark border w-100 py-2">Reserva: @Model.ReservaCodigo</span></div>
                <div class="col-md-2"><span class="badge bg-light text-dark border w-100 py-2">Sede: @Model.Sede</span></div>
                <div class="col-md-2"><span class="badge bg-light text-dark border w-100 py-2">Espacio: @Model.Espacio</span></div>
                <div class="col-md-3"><span class="badge bg-light text-dark border w-100 py-2">Cliente: @Model.Cliente</span></div>
                <div class="col-md-2"><span class="badge bg-light text-dark border w-100 py-2">Fecha: @Model.FechaReserva.ToString("dd/MM/yyyy")</span></div>
                <div class="col-md-1"><span class="badge bg-light text-dark border w-100 py-2">@Model.HoraInicioReserva.ToString("HH\\:mm") - @Model.HoraFinReserva.ToString("HH\\:mm")</span></div>
                <div class="col-md-2"><span class="badge bg-light text-dark border w-100 py-2">Monto: @Model.MonedaSimbolo @Model.TotalReserva.ToString("N2")</span></div>
                <div class="col-md-2"><span class="badge bg-light text-dark border w-100 py-2">Saldo: @Model.MonedaSimbolo @Model.SaldoPendiente.ToString("N2")</span></div>
            </div>
        </div>
    </section>

    @if (soloLecturaComprobante)
    {
        <div class="alert alert-warning shadow-sm mb-3">
            <strong>Modo visualizacion:</strong> la reserva ya tiene comprobante emitido. No se pueden agregar ni eliminar pagos.
            @if (!string.IsNullOrWhiteSpace(Model.ReferenciaComprobante))
            {
                <span> Referencia: <strong>@Model.ReferenciaComprobante</strong>.</span>
            }
        </div>
    }

    <form asp-action="Edit" method="post" class="sc-form-shell" id="pagosReservaForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="NegocioId" />
        <input type="hidden" asp-for="ReservaId" />
        <div asp-validation-summary="All" class="alert alert-danger shadow-sm mb-3"></div>

        <section class="table-card mb-3">
            <h2 class="section-title"><i class="bi bi-cash-stack me-1"></i>Pagos registrados</h2>
            @if (Model.Pagos is null || !Model.Pagos.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-info-circle"></i>
                    <span>La reserva no tiene pagos registrados.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th class="text-center"><span class="sc-col-header"><i class="bi bi-hash"></i><small>Pago</small></span></th>
                                <th class="text-center"><span class="sc-col-header"><i class="bi bi-calendar-check"></i><small>Fecha pago</small></span></th>
                                <th class="text-center"><span class="sc-col-header"><i class="bi bi-cash-coin"></i><small>Monto</small></span></th>
                                <th class="text-center"><span class="sc-col-header"><i class="bi bi-wallet2"></i><small>Forma</small></span></th>
                                <th class="text-center"><span class="sc-col-header"><i class="bi bi-upc"></i><small>Nro Operacion</small></span></th>
                                <th class="text-center"><span class="sc-col-header"><i class="bi bi-chat-left-text"></i><small>Observacion</small></span></th>
                                @if (!soloLecturaComprobante)
                                {
                                    <th class="text-center"><span class="sc-col-header"><i class="bi bi-trash"></i><small>Eliminar</small></span></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Pagos.Count; i++)
                            {
                                <tr>
                                    <td class="text-center">
                                        #@Model.Pagos[i].PagoId
                                        <input type="hidden" asp-for="Pagos[i].PagoId" />
                                        <input type="hidden" asp-for="Pagos[i].Monto" />
                                        <input type="hidden" asp-for="Pagos[i].FechaPago" />
                                        <input type="hidden" asp-for="Pagos[i].FormaPagoId" />
                                        <input type="hidden" asp-for="Pagos[i].FormaPagoNombre" />
                                        <input type="hidden" asp-for="Pagos[i].NumeroOperacion" />
                                    </td>
                                    <td class="text-center">@Model.Pagos[i].FechaPago.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">@Model.Pagos[i].Monto.ToString("N2")</td>
                                    <td class="text-center">@Model.Pagos[i].FormaPagoNombre</td>
                                    <td>@(string.IsNullOrWhiteSpace(Model.Pagos[i].NumeroOperacion) ? "-" : Model.Pagos[i].NumeroOperacion)</td>
                                    <td>
                                        <input asp-for="Pagos[i].Observacion" class="form-control form-control-sm" maxlength="300" readonly />
                                    </td>
                                    @if (!soloLecturaComprobante)
                                    {
                                        <td class="text-center">
                                            <input asp-for="Pagos[i].Eliminar"
                                                   class="form-check-input js-eliminar-pago"
                                                   data-pago-id="@Model.Pagos[i].PagoId"
                                                   data-total-pagos="@Model.Pagos.Count"
                                                   type="checkbox" />
                                        </td>
                                    }
                                    else
                                    {
                                        <input type="hidden" asp-for="Pagos[i].Eliminar" value="false" />
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @if (!soloLecturaComprobante)
        {
            <section class="sc-form-card">
                <div class="sc-form-section">
                    <h2 class="sc-form-title"><i class="bi bi-plus-circle"></i> Agregar nuevo pago</h2>
                    <div class="row g-3 align-items-end">
                        <div class="col-md-2">
                            <div class="form-check form-switch">
                                <input asp-for="AgregarNuevoPago" class="form-check-input" id="AgregarNuevoPago" />
                                <label class="form-check-label" for="AgregarNuevoPago">Agregar pago</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="NuevaFechaPago" class="form-label">Fecha pago</label>
                            <input asp-for="NuevaFechaPago" class="form-control" type="date" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="NuevoMonto" class="form-label">Monto</label>
                            <input asp-for="NuevoMonto" class="form-control text-end" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="NuevaFormaPagoId" class="form-label">Forma de pago</label>
                            <select asp-for="NuevaFormaPagoId" asp-items="Model.FormasPago" class="form-select"></select>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="NuevoNumeroOperacion" class="form-label">Nro Operacion</label>
                            <input asp-for="NuevoNumeroOperacion" class="form-control" maxlength="50" />
                        </div>
                        <div class="col-12">
                            <label asp-for="NuevaObservacion" class="form-label">Observacion</label>
                            <input asp-for="NuevaObservacion" class="form-control" maxlength="300" />
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">Puedes editar observacion de pagos existentes y registrar como maximo 1 pago adicional por operacion.</small>
                </div>
            </section>
        }
        else
        {
            <input type="hidden" asp-for="AgregarNuevoPago" value="false" />
        }

        <div class="sc-form-actions">
            @if (!soloLecturaComprobante)
            {
                <button type="submit" class="btn btn-primary btn-grabar">
                    <i class="bi bi-check2-circle me-1"></i> Guardar cambios
                </button>
            }
            <a class="btn btn-outline-secondary btn-cancelar" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById('pagosReservaForm');
            if (!form) return;

            const agregarPago = document.getElementById('AgregarNuevoPago');
            const nuevoMonto = document.getElementById('NuevoMonto');
            const nuevaFormaPagoId = document.getElementById('NuevaFormaPagoId');
            const nuevaFechaPago = document.getElementById('NuevaFechaPago');
            const nuevoNumeroOperacion = document.getElementById('NuevoNumeroOperacion');
            const nuevaObservacion = document.getElementById('NuevaObservacion');

            const marcarIntentoNuevoPago = () => {
                if (!agregarPago) return;
                const hayDatos =
                    (nuevoMonto && (nuevoMonto.value || '').trim() !== '') ||
                    (nuevoNumeroOperacion && (nuevoNumeroOperacion.value || '').trim() !== '') ||
                    (nuevaObservacion && (nuevaObservacion.value || '').trim() !== '');
                if (hayDatos) agregarPago.checked = true;
            };

            [nuevoMonto, nuevaFormaPagoId, nuevaFechaPago, nuevoNumeroOperacion, nuevaObservacion]
                .filter(x => x)
                .forEach(x => {
                    x.addEventListener('input', marcarIntentoNuevoPago);
                    x.addEventListener('change', marcarIntentoNuevoPago);
                });

            const checks = Array.from(form.querySelectorAll('.js-eliminar-pago'));
            checks.forEach((check) => {
                check.addEventListener('change', () => {
                    if (!check.checked) return;
                    const totalPagos = Number(check.getAttribute('data-total-pagos') || '0');
                    const pagoId = check.getAttribute('data-pago-id') || '';
                    const mensaje = totalPagos <= 1
                        ? `Si eliminas el pago #${pagoId}, la reserva quedara sin pagos y se cambiara a estado Cancelada. Deseas continuar?`
                        : `Si eliminas el pago #${pagoId}, la reserva cambiara a estado Confirmada. Deseas continuar?`;
                    if (!window.confirm(mensaje)) {
                        check.checked = false;
                        return;
                    }

                    // Si la accion principal es eliminar, evitamos que el switch
                    // "Agregar pago" quede activo por defecto y bloquee el submit.
                    if (agregarPago) {
                        agregarPago.checked = false;
                    }
                });
            });

            form.addEventListener('submit', (event) => {
                marcarIntentoNuevoPago();
                const seleccionados = checks.filter((x) => x.checked).length;
                if (!seleccionados) return;
                if (!window.confirm('Se eliminaran pagos seleccionados y se actualizara el estado de la reserva segun la regla configurada. Confirmas la accion?')) {
                    event.preventDefault();
                }
            });
        })();
    </script>
}
