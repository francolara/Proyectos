@model SistemaControlEspaciosDeportivosWeb.ViewModels.PagosIndexViewModel
<!-- Firma: Codex - 09/04/2026 | Rediseno integral de listado de pagos por reserva (una fila por reserva), cabecera estandar con iconos, paginacion backend 20x20, accion eliminar por reserva y columna de saldo pendiente con simbolo de moneda. -->
<!-- Firma: Codex - 13/04/2026 | Cabecera del modulo muestra tarjeta informativa de Club/negocio con ID junto al titulo; agrega filtro por fecha (Desde/Hasta) y presets rapidos Hoy/7d/30d/Mes actual en listado. -->

@{
    ViewData["Title"] = "Pagos";
    var montoTotal = Model.Pagos.Sum(x => x.MontoTotal);
    var pagoTotal = Model.Pagos.Sum(x => x.MontoTotal - x.SaldoPendiente);
    var saldoTotal = Model.Pagos.Sum(x => x.SaldoPendiente);
}

<div class="admin-page-frame">
    @if (TempData["PagosError"] is string pagosError && !string.IsNullOrWhiteSpace(pagosError))
    {
        <div class="alert alert-danger">@pagosError</div>
    }
    @if (TempData["PagosOk"] is string pagosOk && !string.IsNullOrWhiteSpace(pagosOk))
    {
        <div class="alert alert-success">@pagosOk</div>
    }

    <section class="page-header">
        <div class="sc-page-title-wrap">
            <div>
                <h1>Pagos</h1>
                <p class="page-subtitle">Control de pagos y saldos por reserva.</p>
            </div>
            <div class="sc-negocio-ref-card" aria-readonly="true">
                <div class="sc-negocio-ref-card-head"><i class="bi bi-building"></i><span>Club / negocio</span></div>
                <div class="sc-negocio-ref-card-name">@Model.NegocioNombre</div>
                <div class="sc-negocio-ref-card-id">ID: @Model.NegocioId</div>
            </div>
        </div>
        <div class="action-toolbar">
            @if (Model.PuedeCrear)
            {
                <a class="btn btn-primary" asp-action="Create" asp-route-negocioId="@Model.NegocioId">
                    <i class="bi bi-plus-circle me-1"></i> Registrar pago
                </a>
            }
            <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Panel
            </a>
        </div>
    </section>

    <section class="kpi-grid mb-3">
        <article class="kpi-card">
            <p class="kpi-card-label">Monto</p>
            <h3 class="kpi-card-value">@Model.MonedaSimbolo @montoTotal.ToString("N2")</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Pago</p>
            <h3 class="kpi-card-value">@Model.MonedaSimbolo @pagoTotal.ToString("N2")</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Saldo</p>
            <h3 class="kpi-card-value">@Model.MonedaSimbolo @saldoTotal.ToString("N2")</h3>
        </article>
    </section>

    <section class="filter-card mb-3">
        <h2 class="section-title">Filtro rapido</h2>
        <form method="get" asp-action="Index">
            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
            <div class="row g-2 align-items-end px-3 pb-3">
                <div class="col-lg-8 col-md-7">
                    <label class="form-label">Buscar por reserva, sede, espacio, cliente, forma o fecha</label>
                    <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Ejemplo: #12, VILLA MARIA, CANCHA 1, BORIS..." />
                </div>
                <div class="col-lg-4 col-md-5">
                    <label class="form-label">Registros visibles</label>
                    <div class="form-control bg-light text-center fw-bold">@Model.TotalRegistros</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Desde</label>
                    <input type="date" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Hasta</label>
                    <input type="date" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label d-block">Seleccion rapida</label>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="preset" value="hoy">Hoy</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="preset" value="7d">7 dias</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="preset" value="30d">30 dias</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="preset" value="mes">Mes actual</button>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-end justify-content-md-end">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search me-1"></i> Buscar
                    </button>
                </div>
            </div>
        </form>
        @if (Model.TotalPaginas > 1)
        {
            <div class="px-3 pb-3 d-flex justify-content-between align-items-center">
                <small class="text-muted">Pagina @Model.Pagina de @Model.TotalPaginas (@Model.TotalRegistros registros)</small>
                <nav aria-label="Paginacion pagos">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Pagina <= 1 ? "disabled" : null)">
                            <a class="page-link" asp-action="Index" asp-route-negocioId="@Model.NegocioId" asp-route-buscar="@Model.Buscar" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a>
                        </li>
                        <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : null)">
                            <a class="page-link" asp-action="Index" asp-route-negocioId="@Model.NegocioId" asp-route-buscar="@Model.Buscar" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </section>

    <section class="table-card">
        <h2 class="section-title">Listado detallado de pagos</h2>
        @if (!Model.Pagos.Any())
        {
            <div class="empty-state">
                <i class="bi bi-info-circle"></i>
                <span>No hay pagos registrados para este negocio.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle" id="tablaPagosDetallada">
                    <thead>
                        <tr>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-credit-card-2-front"></i><small>Reserva</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-geo-alt"></i><small>Sede</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-grid-3x3-gap"></i><small>Espacio</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-person"></i><small>Cliente</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-calendar-event"></i><small>Fecha</small></span></th>
                            <th class="text-start"><span class="sc-col-header"><i class="bi bi-link-45deg"></i><small>Referencia</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-cash-stack"></i><small>Monto (@Model.MonedaSimbolo)</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-credit-card"></i><small>Pago</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-cash-coin"></i><small>Saldo</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-wallet2"></i><small>Forma</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-gear"></i><small>Acciones</small></span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Pagos)
                        {
                            <tr>
                                <td class="text-center"><span class="sc-id-chip">@item.ReservaCodigo</span></td>
                                <td class="text-center"><span class="sc-list-mini-card sc-list-mini-card-center"><i class="bi bi-geo-alt"></i><span>@item.Sede</span></span></td>
                                <td class="text-center"><span class="sc-list-mini-card sc-list-mini-card-center"><i class="bi bi-grid-3x3-gap"></i><span>@item.Espacio</span></span></td>
                                <td><span class="sc-list-mini-card"><i class="bi bi-person"></i><span>@item.Cliente</span></span></td>
                                <td class="text-center"><span class="sc-list-mini-card sc-list-mini-card-center"><i class="bi bi-calendar-event"></i><span>@item.Fecha.ToString("dd/MM/yyyy")</span></span></td>
                                <td class="text-start">
                                    @if (string.IsNullOrWhiteSpace(item.Referencia))
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                    else
                                    {
                                        <span class="sc-list-mini-card"><i class="bi bi-link-45deg"></i><span>@item.Referencia</span></span>
                                    }
                                </td>
                                <td class="text-center"><span class="sc-list-mini-card sc-list-mini-card-center sc-list-mini-card-amount"><i class="bi bi-cash-stack"></i><span>@item.MontoTotal.ToString("N2")</span></span></td>
                                <td class="text-center"><span class="sc-list-mini-card sc-list-mini-card-center sc-list-mini-card-amount"><i class="bi bi-credit-card"></i><span>@(Math.Max(0m, item.MontoTotal - item.SaldoPendiente).ToString("N2"))</span></span></td>
                                <td class="text-center"><span class="sc-list-mini-card sc-list-mini-card-center sc-list-mini-card-amount"><i class="bi bi-cash-coin"></i><span>@item.SaldoPendiente.ToString("N2")</span></span></td>
                                <td class="text-center"><span class="sc-list-mini-card sc-list-mini-card-center"><i class="bi bi-wallet2"></i><span>@item.FormaPagoResumen</span></span></td>
                                <td class="text-end">
                                    @if (Model.EmisionComprobantesElectronicos && item.PagadaCompleta && !item.TieneComprobanteActivo)
                                    {
                                        <a class="btn btn-sm sc-action-btn sc-action-primary"
                                           asp-controller="Comprobantes"
                                           asp-action="Create"
                                           asp-route-negocioId="@Model.NegocioId"
                                           asp-route-reservaId="@item.ReservaId"
                                           asp-route-codigoSunat="03">
                                            <i class="bi bi-receipt"></i> Emitir CPE
                                        </a>
                                    }
                                    @if (Model.EmisionReciboInterno && item.PagadaCompleta && !item.TieneComprobanteActivo)
                                    {
                                        <a class="btn btn-sm sc-action-btn sc-action-neutral"
                                           asp-controller="Comprobantes"
                                           asp-action="Create"
                                           asp-route-negocioId="@Model.NegocioId"
                                           asp-route-reservaId="@item.ReservaId"
                                           asp-route-codigoSunat="RI">
                                            <i class="bi bi-journal-text"></i> Emitir Recibo
                                        </a>
                                    }
                                    @if (Model.PuedeEditar)
                                    {
                                        <a class="btn btn-sm sc-action-btn sc-action-edit" asp-action="Edit" asp-route-negocioId="@Model.NegocioId" asp-route-id="@item.ReservaId">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                    }
                                    @if (Model.PuedeEliminar)
                                    {
                                        <form asp-action="DeleteByReserva" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                            <input type="hidden" name="reservaId" value="@item.ReservaId" />
                                            <button type="submit"
                                                    class="btn btn-sm sc-action-btn sc-action-delete"
                                                    onclick="return confirm('Se eliminarán todos los pagos de la reserva @item.ReservaCodigo y la reserva se cancelará. ¿Deseas continuar?');">
                                                <i class="bi bi-trash3"></i> Eliminar
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
