@model SistemaControlEspaciosDeportivosWeb.ViewModels.PagosIndexViewModel
<!-- Firma: Codex - 28/03/2026 | Mejora visual de botones de accion Editar/Eliminar con estilo premium reusable -->

@{
    ViewData["Title"] = "Pagos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-1">Pagos</h1>
        <p class="text-muted mb-0">@Model.NegocioNombre | Rol: @Model.RolActual</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.PuedeCrear)
        {
            <a class="btn btn-primary" asp-action="Create" asp-route-negocioId="@Model.NegocioId">Registrar pago</a>
        }
        <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Panel</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Reserva</th>
                <th>Fecha</th>
                <th>Monto</th>
                <th>Forma</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Pagos)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>#@item.ReservaId</td>
                    <td>@item.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>S/ @item.Monto.ToString("N2")</td>
                    <td>@item.FormaPago</td>
                    <td class="text-end">
                        @if (Model.PuedeEditar)
                        {
                            <a class="btn btn-sm sc-action-btn sc-action-edit" asp-action="Edit" asp-route-negocioId="@Model.NegocioId" asp-route-id="@item.Id">
                                <i class="bi bi-pencil-square"></i> Editar
                            </a>
                        }
                        @if (Model.PuedeEliminar)
                        {
                            <form asp-action="Delete" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm sc-action-btn sc-action-delete">
                                    <i class="bi bi-trash3"></i> Eliminar
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

