@model SistemaControlEspaciosDeportivosWeb.ViewModels.ComprobantesIndexViewModel
<!-- Firma: Codex - 09/04/2026 | Rediseno de cabecera/listado de comprobantes con estandar de iconos, buscador y paginacion 20x20; accion Ver abre preview web y desde ahi descarga PDF interno (RI) o redirecciona a URL proveedor en tributarios. -->
<!-- Firma: Codex - 10/04/2026 | Listado de comprobantes agrega filtro por tipo de documento configurado para el negocio (maestros), con paginacion conservando filtro. -->
<!-- Firma: Codex - 11/04/2026 | Listado agrega botones Generar NC/ND por fila; solo habilitados para Factura/Boleta aceptadas SUNAT. -->
<!-- Firma: Codex - 11/04/2026 | Listado agrega columna Referencia y bloquea NC/ND + Anular cuando el comprobante ya tiene notas relacionadas; para RI oculta NC/ND. -->
<!-- Firma: Codex - 13/04/2026 | Cabecera del modulo muestra tarjeta informativa de Club/negocio con ID junto al titulo; agrega filtro por fecha de emision (Desde/Hasta) y presets rapidos Hoy/7d/30d/Mes actual. -->
@{
    ViewData["Title"] = "Comprobantes";
    var totalComprobantes = Model.TotalRegistros;
    var totalMonto = Model.Comprobantes.Sum(x => x.Total);
    var pendientes = Model.Comprobantes.Count(x => x.Estado.Contains("Pend", StringComparison.OrdinalIgnoreCase));
    var anulados = Model.Comprobantes.Count(x => x.Estado.Contains("Anul", StringComparison.OrdinalIgnoreCase));

    string estadoClase(string estado)
    {
        if (estado.Contains("Anul", StringComparison.OrdinalIgnoreCase))
            return "bg-danger-subtle text-danger-emphasis border border-danger-subtle";
        if (estado.Contains("Pend", StringComparison.OrdinalIgnoreCase))
            return "bg-warning-subtle text-warning-emphasis border border-warning-subtle";
        return "bg-success-subtle text-success-emphasis border border-success-subtle";
    }
}

<div class="admin-page-frame">
    @if (TempData["ComprobanteError"] is string comprobanteError && !string.IsNullOrWhiteSpace(comprobanteError))
    {
        <div class="alert alert-danger">@comprobanteError</div>
    }
    @if (TempData["ComprobanteOk"] is string comprobanteOk && !string.IsNullOrWhiteSpace(comprobanteOk))
    {
        <div class="alert alert-success">@comprobanteOk</div>
    }
    <section class="page-header">
        <div class="sc-page-title-wrap">
            <div>
                <h1>Comprobantes electronicos</h1>
                <p class="page-subtitle">Gestion y seguimiento de comprobantes emitidos.</p>
            </div>
            <div class="sc-negocio-ref-card" aria-readonly="true">
                <div class="sc-negocio-ref-card-head"><i class="bi bi-building"></i><span>Club / negocio</span></div>
                <div class="sc-negocio-ref-card-name">@Model.NegocioNombre</div>
                <div class="sc-negocio-ref-card-id">ID: @Model.NegocioId</div>
            </div>
        </div>
        <div class="action-toolbar">
            @if (Model.PuedeCrear)
            {
                <a class="btn btn-primary" asp-action="Create" asp-route-negocioId="@Model.NegocioId">
                    <i class="bi bi-plus-circle me-1"></i> Emitir comprobante
                </a>
            }
            <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Panel
            </a>
        </div>
    </section>

    <section class="kpi-grid mb-3">
        <article class="kpi-card">
            <p class="kpi-card-label">Comprobantes</p>
            <h3 class="kpi-card-value">@totalComprobantes</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Monto emitido</p>
            <h3 class="kpi-card-value">S/ @totalMonto.ToString("N2")</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Pendientes</p>
            <h3 class="kpi-card-value">@pendientes</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Anulados</p>
            <h3 class="kpi-card-value">@anulados</h3>
        </article>
    </section>

    <section class="filter-card mb-3">
        <h2 class="section-title">Filtro rapido</h2>
        <form method="get" asp-action="Index">
            <input type="hidden" name="negocioId" value="@Model.NegocioId" />
            <div class="row g-2 align-items-end px-3 pb-3">
                <div class="col-lg-5 col-md-6">
                    <label class="form-label">Buscar por comprobante, reserva, cliente, tipo o estado</label>
                    <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Ejemplo: B001-10, #12, BORIS, Boleta, Pendiente..." />
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="form-label">Tipo de documento</label>
                    <select name="codigoDocumento" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var td in Model.TiposDocumentoFiltro)
                        {
                            if (string.Equals(td.Value, Model.CodigoDocumento, StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@td.Value" selected="selected">@td.Text</option>
                            }
                            else
                            {
                                <option value="@td.Value">@td.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-lg-4 col-md-12">
                    <label class="form-label">Registros visibles</label>
                    <div class="form-control bg-light text-center fw-bold">@Model.TotalRegistros</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Desde</label>
                    <input type="date" name="fechaDesde" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Hasta</label>
                    <input type="date" name="fechaHasta" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label d-block">Seleccion rapida</label>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="preset" value="hoy">Hoy</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="preset" value="7d">7 dias</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="preset" value="30d">30 dias</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary" name="preset" value="mes">Mes actual</button>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-end justify-content-md-end">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search me-1"></i> Buscar
                    </button>
                </div>
            </div>
        </form>
        @if (Model.TotalPaginas > 1)
        {
            <div class="px-3 pb-3 d-flex justify-content-between align-items-center">
                <small class="text-muted">Pagina @Model.Pagina de @Model.TotalPaginas (@Model.TotalRegistros registros)</small>
                <nav aria-label="Paginacion comprobantes">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Pagina <= 1 ? "disabled" : null)">
                            <a class="page-link" asp-action="Index" asp-route-negocioId="@Model.NegocioId" asp-route-buscar="@Model.Buscar" asp-route-codigoDocumento="@Model.CodigoDocumento" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a>
                        </li>
                        <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : null)">
                            <a class="page-link" asp-action="Index" asp-route-negocioId="@Model.NegocioId" asp-route-buscar="@Model.Buscar" asp-route-codigoDocumento="@Model.CodigoDocumento" asp-route-fechaDesde="@Model.FechaDesde.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta.ToString("yyyy-MM-dd")" asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </section>

    <section class="table-card">
        <h2 class="section-title">Listado general de comprobantes</h2>
        @if (!Model.Comprobantes.Any())
        {
            <div class="empty-state">
                <i class="bi bi-info-circle"></i>
                <span>No hay comprobantes registrados para este negocio.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle" id="tablaComprobantesDetallada">
                    <thead>
                        <tr>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-receipt-cutoff"></i><small>Documento</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-person"></i><small>Cliente y fecha</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-link-45deg"></i><small>Referencia</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-cash-stack"></i><small>Estado y total</small></span></th>
                            <th class="text-center"><span class="sc-col-header"><i class="bi bi-gear"></i><small>Acciones</small></span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Comprobantes)
                        {
                            var codigoDoc = (item.CodigoDocumentoComprobante ?? string.Empty).Trim().ToUpperInvariant();
                            var mostrarBotonesNota = codigoDoc is "01" or "03";
                            var puedeGenerarNota = (codigoDoc == "01" || codigoDoc == "03") && item.EstadoCodigo == 3 && !item.TieneNotasRelacionadas;
                            var puedeAnular = !item.TieneNotasRelacionadas;
                            <tr>
                                <td class="text-center">
                                    @{
                                        var serie = item.SerieNumero;
                                        var numero = "";
                                        if (!string.IsNullOrWhiteSpace(item.SerieNumero))
                                        {
                                            var partes = item.SerieNumero.Split('-', 2, StringSplitOptions.TrimEntries);
                                            serie = partes.Length > 0 ? partes[0] : item.SerieNumero;
                                            numero = partes.Length > 1 ? partes[1] : "";
                                        }
                                    }
                                    <div class="comprobante-meta-grid">
                                        <div class="comprobante-meta-item">
                                            <small>Tipo</small>
                                            <div>@item.Tipo</div>
                                        </div>
                                        <div class="comprobante-meta-item">
                                            <small>Serie</small>
                                            <div>@serie</div>
                                        </div>
                                        <div class="comprobante-meta-item">
                                            <small>Numero</small>
                                            <div>@numero</div>
                                        </div>
                                        <div class="comprobante-meta-item">
                                            <small>Nro reserva</small>
                                            <div>#@item.ReservaId</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="comprobante-meta-grid comprobante-meta-grid-2">
                                        <div class="comprobante-meta-item">
                                            <small>Cliente</small>
                                            <div>@item.Cliente</div>
                                        </div>
                                        <div class="comprobante-meta-item">
                                            <small>Fecha</small>
                                            <div>@item.FechaEmision.ToString("dd/MM/yyyy")</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border w-100 py-2">@item.Referencia</span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex flex-wrap justify-content-center gap-1">
                                        <span class="badge @estadoClase(item.Estado) sc-estado-pill">@item.Estado</span>
                                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle sc-estado-pill">S/ @item.Total.ToString("N2")</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex flex-column gap-1 align-items-end">
                                        <div class="d-inline-flex gap-1">
                                            <a class="btn btn-sm sc-action-btn sc-action-primary"
                                               asp-action="Preview"
                                               asp-route-negocioId="@Model.NegocioId"
                                               asp-route-id="@item.Id"
                                               target="_blank"
                                               title="Visualizar comprobante">
                                                <i class="bi bi-eye"></i> Ver
                                            </a>
                                            @if (Model.PuedeCrear && mostrarBotonesNota)
                                            {
                                                if (puedeGenerarNota)
                                                {
                                                    <a class="btn btn-sm sc-action-btn btn-outline-secondary"
                                                       asp-action="CreateNota"
                                                       asp-route-negocioId="@Model.NegocioId"
                                                       asp-route-id="@item.Id"
                                                       asp-route-tipoNota="NC">
                                                        Generar NC
                                                    </a>
                                                    <a class="btn btn-sm sc-action-btn btn-outline-secondary"
                                                       asp-action="CreateNota"
                                                       asp-route-negocioId="@Model.NegocioId"
                                                       asp-route-id="@item.Id"
                                                       asp-route-tipoNota="ND">
                                                        Generar ND
                                                    </a>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm sc-action-btn btn-outline-secondary" disabled>Generar NC</button>
                                                    <button type="button" class="btn btn-sm sc-action-btn btn-outline-secondary" disabled>Generar ND</button>
                                                }
                                            }
                                        </div>
                                        <div class="d-inline-flex gap-1">
                                            @if (Model.PuedeEditar)
                                            {
                                                <a class="btn btn-sm sc-action-btn sc-action-edit" asp-action="Edit" asp-route-negocioId="@Model.NegocioId" asp-route-id="@item.Id">
                                                    <i class="bi bi-pencil-square"></i> Editar
                                                </a>
                                            }
                                            @if (Model.PuedeEliminar)
                                            {
                                                <form asp-action="Delete" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    @if (puedeAnular)
                                                    {
                                                        <button type="submit" class="btn btn-sm sc-action-btn sc-action-delete">
                                                            <i class="bi bi-trash3"></i> Anular
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-sm sc-action-btn sc-action-delete" disabled>
                                                            <i class="bi bi-trash3"></i> Anular
                                                        </button>
                                                    }
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<style>
    .comprobante-meta-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(120px, 1fr));
        gap: .35rem;
    }
    .comprobante-meta-grid-2 {
        grid-template-columns: repeat(2, minmax(160px, 1fr));
    }
    .comprobante-meta-item {
        border: 1px solid #d8e1f3;
        border-radius: .45rem;
        padding: .25rem .4rem;
        background: #f8fbff;
        text-align: center;
    }
    .comprobante-meta-item small {
        display: block;
        font-size: .66rem;
        color: #6b7a96;
        font-weight: 600;
        line-height: 1.1;
        margin-bottom: .1rem;
    }
    .comprobante-meta-item div {
        font-size: .75rem;
        font-weight: 700;
        color: #1f2f48;
        line-height: 1.2;
    }
</style>
