@using SistemaControlEspaciosDeportivosWeb.Models
@model SistemaControlEspaciosDeportivosWeb.ViewModels.ComprobanteFormViewModel

@{
    ViewData["Title"] = "Editar comprobante";
}

<h1 class="h4 mb-3">Editar comprobante electronico</h1>

<form asp-action="Edit" method="post" class="card card-body shadow-sm">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="NegocioId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-5">
            <label asp-for="ReservaId" class="form-label">Reserva</label>
            <select asp-for="ReservaId" asp-items="Model.Reservas" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="TipoComprobante" class="form-label"></label>
            <select asp-for="TipoComprobante" asp-items="Html.GetEnumSelectList<TipoComprobante>()" class="form-select"></select>
        </div>
        <div class="col-md-2">
            <label asp-for="Serie" class="form-label"></label>
            <input asp-for="Serie" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="Numero" class="form-label"></label>
            <input asp-for="Numero" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="FechaEmision" class="form-label"></label>
            <input asp-for="FechaEmision" class="form-control" type="datetime-local" />
        </div>
        <div class="col-md-2">
            <label asp-for="TipoMoneda" class="form-label"></label>
            <select asp-for="TipoMoneda" asp-items="Html.GetEnumSelectList<TipoMoneda>()" class="form-select"></select>
        </div>
        <div class="col-md-2">
            <label asp-for="SubTotal" class="form-label"></label>
            <input asp-for="SubTotal" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="Igv" class="form-label"></label>
            <input asp-for="Igv" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="Total" class="form-label"></label>
            <input asp-for="Total" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Estado" class="form-label"></label>
            <select asp-for="Estado" asp-items="Html.GetEnumSelectList<EstadoComprobanteElectronico>()" class="form-select"></select>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

