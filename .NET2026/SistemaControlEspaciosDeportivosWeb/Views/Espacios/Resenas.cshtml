@model SistemaControlEspaciosDeportivosWeb.ViewModels.EspaciosResenasIndexViewModel
@{
    ViewData["Title"] = "Resenas del espacio";
    var totalResenas = Model.TotalRegistros;
    var totalActivas = Model.TotalVisibles;
    var totalOcultas = Model.TotalOcultas;
    var totalRespondidas = Model.TotalRespondidas;
    var paginaAnterior = Model.Pagina > 1 ? Model.Pagina - 1 : 1;
    var paginaSiguiente = Model.Pagina < Model.TotalPaginas ? Model.Pagina + 1 : Model.TotalPaginas;
}

@* Firma: FRANCO LARA - 11/06/2026 | Panel administrativo para responder resenas del espacio y ocultarlas de la vista publica sin eliminarlas. *@
@* Firma: FRANCO LARA - 11/06/2026 | Gestion de resenas pagina de 4 en 4, mantiene contexto al guardar y marca visualmente la cabecera de cada tarjeta. *@

<div class="admin-page-frame">
    @if (TempData["EspaciosError"] is string espaciosError && !string.IsNullOrWhiteSpace(espaciosError))
    {
        <div class="alert alert-danger">@espaciosError</div>
    }
    @if (TempData["EspaciosOk"] is string espaciosOk && !string.IsNullOrWhiteSpace(espaciosOk))
    {
        <div class="alert alert-success">@espaciosOk</div>
    }

    <section class="page-header">
        <div class="sc-page-title-wrap">
            <div>
                <h1>Resenas del espacio</h1>
                <p class="page-subtitle">Responde comentarios de clientes y controla si siguen visibles en la reserva publica.</p>
            </div>
            <div class="sc-negocio-ref-card" aria-readonly="true">
                <div class="sc-negocio-ref-card-head"><i class="bi bi-grid-3x3-gap"></i><span>Espacio</span></div>
                <div class="sc-negocio-ref-card-name">@Model.EspacioNombre</div>
                <div class="sc-negocio-ref-card-id">@Model.SedeNombre</div>
            </div>
        </div>
        <div class="action-toolbar">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Volver a espacios
            </a>
        </div>
    </section>

    <section class="kpi-grid mb-3">
        <article class="kpi-card">
            <p class="kpi-card-label">Total resenas</p>
            <h3 class="kpi-card-value">@totalResenas</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Visibles</p>
            <h3 class="kpi-card-value">@totalActivas</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Ocultas</p>
            <h3 class="kpi-card-value">@totalOcultas</h3>
        </article>
        <article class="kpi-card">
            <p class="kpi-card-label">Respondidas</p>
            <h3 class="kpi-card-value">@totalRespondidas</h3>
        </article>
    </section>

    <section class="table-card">
        <h2 class="section-title"><i class="bi bi-chat-quote me-1"></i>Gestion de resenas</h2>
        @if (totalResenas == 0)
        {
            <div class="empty-state">
                <i class="bi bi-info-circle"></i>
                <span>Este espacio todavia no tiene resenas registradas.</span>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var item in Model.Resenas)
                {
                    <article class="border rounded-4 overflow-hidden shadow-sm @(item.Activo ? "bg-white" : "bg-light")">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 px-3 py-3 border-bottom border-2 @(item.Activo ? "bg-primary-subtle border-primary-subtle" : "bg-secondary-subtle border-secondary-subtle")">
                            <div>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <strong>@item.AliasPublico</strong>
                                    <span class="badge @(item.Activo ? "bg-success-subtle text-success-emphasis border border-success-subtle" : "bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle")">
                                        @(item.Activo ? "Visible" : "Oculta")
                                    </span>
                                </div>
                                <div class="small text-muted mt-1">
                                    Reserva #@item.ReservaId | @item.ReservaFecha.ToString("dd/MM/yyyy") | @item.HoraInicio.ToString("HH\\:mm") - @item.HoraFin.ToString("HH\\:mm")
                                </div>
                            </div>
                            <div class="small text-muted">
                                Registrada el @item.FechaCreacion.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="p-3">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Comentario del cliente</label>
                                <div class="form-control bg-light" style="min-height: 96px;">@item.Comentario</div>
                            </div>

                            <form asp-action="ResenaGuardar" method="post" class="row g-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="NegocioId" value="@Model.NegocioId" />
                                <input type="hidden" name="EspacioDeportivoId" value="@Model.EspacioDeportivoId" />
                                <input type="hidden" name="ResenaId" value="@item.ResenaId" />
                                <input type="hidden" name="Pagina" value="@Model.Pagina" />

                                <div class="col-12">
                                    <label class="form-label fw-semibold" for="respuesta_@item.ResenaId">Respuesta del negocio</label>
                                    <textarea id="respuesta_@item.ResenaId" name="Respuesta" class="form-control" rows="4" maxlength="800" placeholder="Escribe una respuesta publica para esta resena.">@item.Respuesta</textarea>
                                    <small class="text-muted">La respuesta se mostrara debajo de la resena en la reserva publica mientras la resena permanezca visible.</small>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" id="activo_@item.ResenaId" name="Activo" value="true" @(item.Activo ? "checked" : null) />
                                        <input type="hidden" name="Activo" value="false" />
                                        <label class="form-check-label" for="activo_@item.ResenaId">Mostrar en la vista publica</label>
                                    </div>
                                </div>

                                <div class="col-md-6 text-md-end">
                                    <button type="submit" class="btn btn-primary btn-grabar">
                                        <i class="bi bi-save me-1"></i> Guardar gestion
                                    </button>
                                </div>
                            </form>
                        </div>
                    </article>
                }
            </div>

            @if (Model.TotalPaginas > 1)
            {
                <div class="d-flex flex-column align-items-center justify-content-center gap-2 mt-3 text-center">
                    <small class="sc-pagination-meta">Pagina @Model.Pagina de @Model.TotalPaginas (@Model.TotalRegistros resenas)</small>
                    <nav class="sc-pagination-nav" aria-label="Paginacion de resenas">
                        <a class="sc-page-link @(Model.Pagina <= 1 ? "is-disabled" : null)"
                           asp-action="Resenas"
                           asp-route-negocioId="@Model.NegocioId"
                           asp-route-id="@Model.EspacioDeportivoId"
                           asp-route-pagina="@paginaAnterior">Anterior</a>
                        @for (var p = 1; p <= Model.TotalPaginas; p++)
                        {
                            <a class="sc-page-link @(p == Model.Pagina ? "is-active" : null)"
                               asp-action="Resenas"
                               asp-route-negocioId="@Model.NegocioId"
                               asp-route-id="@Model.EspacioDeportivoId"
                               asp-route-pagina="@p">@p</a>
                        }
                        <a class="sc-page-link @(Model.Pagina >= Model.TotalPaginas ? "is-disabled" : null)"
                           asp-action="Resenas"
                           asp-route-negocioId="@Model.NegocioId"
                           asp-route-id="@Model.EspacioDeportivoId"
                           asp-route-pagina="@paginaSiguiente">Siguiente</a>
                    </nav>
                </div>
            }
        }
    </section>
</div>
