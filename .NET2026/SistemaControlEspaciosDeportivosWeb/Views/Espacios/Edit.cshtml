@using SistemaControlEspaciosDeportivosWeb.Models
@using System.Text.Json
@model SistemaControlEspaciosDeportivosWeb.ViewModels.EspacioFormViewModel
@{
    ViewData["Title"] = "Editar espacio";
    var monedaEtiqueta = string.IsNullOrWhiteSpace(Model.MonedaEtiqueta) ? "-" : Model.MonedaEtiqueta;
    var horasMediaHora = Enumerable.Range(0, 48)
        .Select(i => TimeOnly.FromTimeSpan(TimeSpan.FromMinutes(i * 30)))
        .ToList();
    var horasCierre = horasMediaHora
        .Where(h => h >= new TimeOnly(0, 30))
        .ToList();
    horasCierre.Add(new TimeOnly(23, 59));
    var galeriaEspacio = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.FotoPrincipalUrl))
    {
        galeriaEspacio.Add(Model.FotoPrincipalUrl);
    }
    if (Model.FotosUrls?.Count > 0)
    {
        galeriaEspacio.AddRange(Model.FotosUrls.Where(x => !string.IsNullOrWhiteSpace(x)));
    }
}
@* Firma: FRANCO LARA - 20/05/2026 | En tarifas de espacios muestra 24:00 en hora fin y guarda internamente 23:59 para cierre de jornada. *@
@* Firma: FRANCO LARA - 06/06/2026 | Agrega configuracion visual de espacios compartidos con carga dinamica por sede. *@
@* Firma: FRANCO LARA - 08/06/2026 | Reemplaza la seleccion multiple por checkboxes, separa relaciones operativas entre bloqueo directo y espacios compuestos, y agrega galeria de fotos para espacios deportivos. *@

<div class="admin-page-frame">
    <section class="page-header">
        <div>
            <h1>Editar espacio deportivo</h1>
            <p class="page-subtitle">Actualiza configuracion, tipo de deporte y atributos del espacio.</p>
        </div>
        <div class="action-toolbar">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>
        </div>
    </section>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="sc-form-shell">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="NegocioId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-0"></div>
        @if (TempData["EspaciosError"] is string espaciosError && !string.IsNullOrWhiteSpace(espaciosError))
        {
            <div class="alert alert-warning shadow-sm mb-0">@espaciosError</div>
        }

        <section class="sc-form-card">
            <div class="sc-form-section">
                <h2 class="sc-form-title"><i class="bi bi-grid-1x2"></i> Datos del espacio</h2>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label asp-for="SedeId" class="form-label">Sede</label>
                        <select asp-for="SedeId" asp-items="Model.Sedes" class="form-select"></select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="TipoDeporteId" class="form-label">Deporte</label>
                        <select asp-for="TipoDeporteId" asp-items="Model.TiposDeporte" class="form-select"></select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="TipoSueloId" class="form-label">Tipo de suelo</label>
                        <select asp-for="TipoSueloId" asp-items="Model.TiposSuelo" class="form-select"></select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Estado" class="form-label"></label>
                        <select asp-for="Estado" asp-items="Html.GetEnumSelectList<EstadoEspacioDeportivo>()" class="form-select"></select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Codigo" class="form-label"></label>
                        <input asp-for="Codigo" class="form-control" placeholder="Ejemplo: 001" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ejemplo: 6x6 Cancha 1" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Capacidad" class="form-label"></label>
                        <input asp-for="Capacidad" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="sc-check-chip">
                            <input asp-for="TieneIluminacion" class="form-check-input mt-0" />
                            <span>Tiene iluminacion</span>
                        </label>
                    </div>
                    <div class="col-md-6">
                        <label class="sc-check-chip">
                            <input asp-for="Techada" class="form-check-input mt-0" />
                            <span>Espacio techado</span>
                        </label>
                    </div>
                    <div class="col-md-6">
                        <label class="sc-check-chip">
                            <input asp-for="AdministracionPrivada" class="form-check-input mt-0" />
                            <span>Administracion privada (no mostrar en portal publico)</span>
                        </label>
                    </div>
                    <div class="col-12">
                        <label class="sc-check-chip">
                            <input asp-for="TieneEspaciosCompartidos" class="form-check-input mt-0" id="TieneEspaciosCompartidos" />
                            <span>Configurar relaciones operativas de este espacio</span>
                        </label>
                    </div>
                    <div class="col-12 d-none" id="bloqueEspaciosCompartidos">
                        <div class="row g-3">
                            <div class="col-lg-6">
                                <label asp-for="EspaciosBloqueoDirectoIds" class="form-label">Bloqueo directo</label>
                                <div id="EspaciosBloqueoDirectoIds" class="border rounded-3 bg-white p-2 sc-check-list" style="max-height: 220px; overflow-y: auto;">
                                    @foreach (var espacio in Model.EspaciosCompartibles)
                                    {
                                        var espacioId = int.TryParse(espacio.Value, out var idRelacionado) ? idRelacionado : 0;
                                        var checkedRelacionado = Model.EspaciosBloqueoDirectoIds.Contains(espacioId);
                                        <label class="sc-check-list-item">
                                            <input class="form-check-input m-0" type="checkbox" name="EspaciosBloqueoDirectoIds" value="@espacio.Value" @(checkedRelacionado ? "checked" : null) />
                                            <span class="small">@espacio.Text</span>
                                        </label>
                                    }
                                </div>
                                <span asp-validation-for="EspaciosBloqueoDirectoIds" class="text-danger"></span>
                                <div class="form-text">Si uno se reserva o bloquea, el otro tambien queda bloqueado. Ejemplo: voley sobre una cancha de futbol 6.</div>
                            </div>
                            <div class="col-lg-6">
                                <label asp-for="EspaciosComponentesIds" class="form-label">Este espacio se compone de</label>
                                <div id="EspaciosComponentesIds" class="border rounded-3 bg-white p-2 sc-check-list" style="max-height: 220px; overflow-y: auto;">
                                    @foreach (var espacio in Model.EspaciosCompartibles)
                                    {
                                        var espacioId = int.TryParse(espacio.Value, out var idRelacionado) ? idRelacionado : 0;
                                        var checkedRelacionado = Model.EspaciosComponentesIds.Contains(espacioId);
                                        <label class="sc-check-list-item">
                                            <input class="form-check-input m-0" type="checkbox" name="EspaciosComponentesIds" value="@espacio.Value" @(checkedRelacionado ? "checked" : null) />
                                            <span class="small">@espacio.Text</span>
                                        </label>
                                    }
                                </div>
                                <span asp-validation-for="EspaciosComponentesIds" class="text-danger"></span>
                                <div class="form-text">Usalo cuando este espacio grande se arma con otros espacios. Ejemplo: Futbol 11 compuesto por dos canchas de futbol 6.</div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <section class="sc-form-card">
            <div class="sc-form-section">
                <h2 class="sc-form-title"><i class="bi bi-cash-coin"></i> Tarifas por dia y rango horario</h2>
                <div class="d-flex justify-content-end mb-2">
                    <span class="badge text-bg-light border">Moneda: @monedaEtiqueta</span>
                </div>
                @if (!Model.PuedeEditarTarifas)
                {
                    <div class="alert alert-warning mb-3">
                        Debes configurar la moneda del club en <strong>Configuracion</strong> para registrar precios.
                    </div>
                }
                <div class="card border-0 bg-light-subtle mb-3">
                    <div class="card-body">
                        <div class="row g-2 align-items-end">
                            <div class="col-lg-3 col-md-6">
                                <label class="form-label">Bloque de dias</label>
                                <select id="bloqueDiasPreset" class="form-select form-select-sm" @(Model.PuedeEditarTarifas ? null : "disabled")>
                                    <option value="lv">Lunes a Viernes</option>
                                    <option value="sd">Sabado y Domingo</option>
                                    <option value="todos">Todos los dias</option>
                                    <option value="personalizado">Personalizado</option>
                                </select>
                            </div>
                            <div class="col-lg-2 col-md-6">
                                <label class="form-label">Hora inicio</label>
                                <select id="bloqueHoraInicio" class="form-select form-select-sm" @(Model.PuedeEditarTarifas ? null : "disabled")>
                                    @foreach (var hora in horasMediaHora)
                                    {
                                        var valor = hora.ToString("HH\\:mm");
                                        if (valor == "09:00")
                                        {
                                            <option value="@valor" selected="selected">@valor</option>
                                        }
                                        else
                                        {
                                            <option value="@valor">@valor</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-lg-2 col-md-6">
                                <label class="form-label">Hora fin</label>
                                <select id="bloqueHoraFin" class="form-select form-select-sm" @(Model.PuedeEditarTarifas ? null : "disabled")>
                                    @foreach (var hora in horasMediaHora)
                                    {
                                        var valor = hora.ToString("HH\\:mm");
                                        if (valor == "10:00")
                                        {
                                            <option value="@valor" selected="selected">@valor</option>
                                        }
                                        else
                                        {
                                            <option value="@valor">@valor</option>
                                        }
                                    }
                                    <option value="23:59">24:00</option>
                                </select>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <label class="form-label">Precio</label>
                                <div class="input-group input-group-sm">
                                    <input id="bloquePrecio" type="text" inputmode="decimal" autocomplete="off" class="form-control text-end" value="0.01" @(Model.PuedeEditarTarifas ? null : "disabled") />
                                    <span class="input-group-text">@monedaEtiqueta</span>
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-12 d-grid">
                    <button type="button" id="btnAgregarBloque" class="btn btn-primary btn-sm btn-accion-filtro" @(Model.PuedeEditarTarifas ? null : "disabled")>
                                    <i class="bi bi-magic me-1"></i> Agregar bloque
                                </button>
                            </div>
                        </div>
                        <div id="bloqueDiasPersonalizado" class="mt-3 d-none">
                            <label class="form-label mb-2">Selecciona dias</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var dia in Model.TarifaDiasSemana)
                                {
                                    <label class="sc-check-chip py-1 px-2">
                                        <input type="checkbox" class="form-check-input mt-0 js-dia-custom" value="@dia.Value" />
                                        <span>@dia.Text</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div id="tarifasErrorBox" class="alert alert-danger d-none mb-3 py-2"></div>
                <input type="hidden" asp-for="TarifasJson" id="tarifasJson" />
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-2" id="tablaTarifasEspacio">
                        <thead>
                            <tr>
                                <th>Dia</th>
                                <th>Hora inicio</th>
                                <th>Hora fin</th>
                                <th class="text-end">Precio</th>
                                <th class="text-end">Accion</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                    <button type="button" class="btn btn-outline-primary btn-sm btn-accion-filtro" id="btnAgregarTarifa" @(Model.PuedeEditarTarifas ? null : "disabled")>
                    <i class="bi bi-plus-circle"></i> Agregar rango
                </button>
                <div class="form-text mt-2">Puedes registrar varios rangos por dia. Evita superponer horarios del mismo dia.</div>

                <hr class="my-4" />
                <h2 class="sc-form-title"><i class="bi bi-calendar-event"></i> Configurar tarifa por feriado</h2>
                <div class="card border-0 bg-light-subtle mb-3">
                    <div class="card-body">
                        <div class="row g-2 align-items-end">
                            <div class="col-lg-3 col-md-6">
                                <label class="form-label">Hora inicio</label>
                                <select id="feriadoHoraInicio" class="form-select form-select-sm" @(Model.PuedeEditarTarifas ? null : "disabled")>
                                    @foreach (var hora in horasMediaHora)
                                    {
                                        var valor = hora.ToString("HH\\:mm");
                                        if (valor == "09:00")
                                        {
                                            <option value="@valor" selected="selected">@valor</option>
                                        }
                                        else
                                        {
                                            <option value="@valor">@valor</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <label class="form-label">Hora fin</label>
                                <select id="feriadoHoraFin" class="form-select form-select-sm" @(Model.PuedeEditarTarifas ? null : "disabled")>
                                    @foreach (var hora in horasMediaHora)
                                    {
                                        var valor = hora.ToString("HH\\:mm");
                                        if (valor == "10:00")
                                        {
                                            <option value="@valor" selected="selected">@valor</option>
                                        }
                                        else
                                        {
                                            <option value="@valor">@valor</option>
                                        }
                                    }
                                    <option value="23:59">24:00</option>
                                </select>
                            </div>
                            <div class="col-lg-4 col-md-6">
                                <label class="form-label">Precio feriado</label>
                                <div class="input-group input-group-sm">
                                    <input id="feriadoPrecio" type="text" inputmode="decimal" autocomplete="off" class="form-control text-end" value="0.01" @(Model.PuedeEditarTarifas ? null : "disabled") />
                                    <span class="input-group-text">@monedaEtiqueta</span>
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-12 d-grid">
                                <button type="button" id="btnAgregarTarifaFeriado" class="btn btn-primary btn-sm btn-accion-filtro" @(Model.PuedeEditarTarifas ? null : "disabled")>
                                    <i class="bi bi-plus-circle me-1"></i> Agregar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="tarifasFeriadoErrorBox" class="alert alert-danger d-none mb-3 py-2"></div>
                <input type="hidden" asp-for="TarifasFeriadoJson" id="tarifasFeriadoJson" />
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-2" id="tablaTarifasFeriadoEspacio">
                        <thead>
                            <tr>
                                <th>Hora inicio</th>
                                <th>Hora fin</th>
                                <th class="text-end">Precio</th>
                                <th class="text-end">Accion</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="form-text mt-2">Estas tarifas aplican a cualquier fecha registrada como feriado.</div>
            </div>
        </section>

        <section class="sc-form-card">
            <div class="sc-form-section">
                <h2 class="sc-form-title"><i class="bi bi-clock-history"></i> Configurar horario por espacio deportivo</h2>
                <label class="sc-check-chip mb-3">
                    <input asp-for="ConfigurarHorarioPorEspacio" class="form-check-input mt-0" id="ConfigurarHorarioPorEspacio" />
                    <span>Habilitar horario de atencion propio para este espacio</span>
                </label>
                <div id="bloqueHorarioEspacio" class="row g-3 d-none">
                    <div class="col-md-12">
                        <div class="sc-days-row">
                            <label class="sc-day-chip"><input asp-for="AtiendeLunes" class="form-check-input mt-0" /> <span>Lunes</span></label>
                            <label class="sc-day-chip"><input asp-for="AtiendeMartes" class="form-check-input mt-0" /> <span>Martes</span></label>
                            <label class="sc-day-chip"><input asp-for="AtiendeMiercoles" class="form-check-input mt-0" /> <span>Miercoles</span></label>
                            <label class="sc-day-chip"><input asp-for="AtiendeJueves" class="form-check-input mt-0" /> <span>Jueves</span></label>
                            <label class="sc-day-chip"><input asp-for="AtiendeViernes" class="form-check-input mt-0" /> <span>Viernes</span></label>
                            <label class="sc-day-chip"><input asp-for="AtiendeSabado" class="form-check-input mt-0" /> <span>Sabado</span></label>
                            <label class="sc-day-chip"><input asp-for="AtiendeDomingo" class="form-check-input mt-0" /> <span>Domingo</span></label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="HoraApertura" class="form-label">Hora apertura</label>
                        <select asp-for="HoraApertura" class="form-select">
                            @foreach (var hora in horasMediaHora)
                            {
                                <option value="@hora.ToString("HH\\:mm")">@hora.ToString("HH\\:mm")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="HoraCierre" class="form-label">Hora cierre</label>
                        <select asp-for="HoraCierre" class="form-select">
                            @foreach (var hora in horasCierre)
                            {
                                var etiquetaHora = hora == new TimeOnly(23, 59)
                                    ? "24:00"
                                    : hora.ToString("HH\\:mm");
                                <option value="@hora.ToString("HH\\:mm")">@etiquetaHora</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </section>

        <section class="sc-form-card">
            <div class="sc-form-section">
                <h2 class="sc-form-title"><i class="bi bi-images"></i> Fotos del espacio deportivo</h2>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="ImagenesArchivos" class="form-label">Agregar imagenes (maximo 3 en total, de 1 en 1)</label>
                        <input asp-for="ImagenesArchivos" id="imagenesArchivosInput" type="file" class="form-control" multiple accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                        <span asp-validation-for="ImagenesArchivos" class="text-danger"></span>
                        <div class="form-text">
                            Puedes mantener imagenes actuales y agregar nuevas.
                            Si eliminas la principal, se asignara la siguiente disponible.
                            Formato de entrada permitido: JPG/JPEG/PNG.
                            Salida automatica estandar: WebP, 1200x900 (4:3), maximo 400KB.
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Resumen actual</label>
                        <div class="border rounded-3 p-2 bg-light-subtle small text-secondary">
                            <div><strong>Principal:</strong> @(string.IsNullOrWhiteSpace(Model.FotoPrincipalUrl) ? "Sin definir" : "Disponible")</div>
                            <div><strong>Alternativas:</strong> @(Model.FotosUrls?.Count ?? 0)</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <input asp-for="FotoPrincipalUrl" type="hidden" />
                        <input asp-for="FotosUrlsCsv" type="hidden" />
                        <div id="fotosEliminarContainer"></div>
                        <span asp-validation-for="FotoPrincipalUrl" class="text-danger d-block"></span>
                        <span asp-validation-for="FotosUrlsCsv" class="text-danger d-block"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Imagenes actuales</label>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:70px;">Orden</th>
                                        <th style="width:130px;">Vista</th>
                                        <th>Archivo</th>
                                        <th style="width:160px;">Rol</th>
                                        <th style="width:170px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="imagenesActualesBody">
                                    <tr>
                                        <td colspan="5" class="text-muted small">No hay imagenes registradas.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Nuevas imagenes seleccionadas</label>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:70px;">Orden</th>
                                        <th>Archivo</th>
                                        <th style="width:160px;">Rol</th>
                                        <th style="width:140px;">Tamano</th>
                                        <th style="width:170px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="imagenesSeleccionadasBody">
                                    <tr>
                                        <td colspan="5" class="text-muted small">Aun no has seleccionado archivos.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="sc-form-actions">
            <button type="submit" class="btn btn-primary btn-grabar">
                <i class="bi bi-check2-circle me-1"></i> Guardar cambios
            </button>
            <a class="btn btn-outline-secondary btn-cancelar" asp-action="Index" asp-route-negocioId="@Model.NegocioId">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const chkHorarioEspacio = document.getElementById('ConfigurarHorarioPorEspacio');
            const bloqueHorarioEspacio = document.getElementById('bloqueHorarioEspacio');
            const chkCompartidos = document.getElementById('TieneEspaciosCompartidos');
            const bloqueCompartidos = document.getElementById('bloqueEspaciosCompartidos');
            const listaDirectos = document.getElementById('EspaciosBloqueoDirectoIds');
            const listaComponentes = document.getElementById('EspaciosComponentesIds');
            const sedeSelect = document.getElementById('SedeId');
            const compartidosUrlBase = '@Url.Action("ObtenerEspaciosCompartibles", "Espacios")';
            const seleccionInicialDirectos = @Html.Raw(JsonSerializer.Serialize(Model.EspaciosBloqueoDirectoIds));
            const seleccionInicialComponentes = @Html.Raw(JsonSerializer.Serialize(Model.EspaciosComponentesIds));
            function toggleHorarioEspacio() {
                if (!chkHorarioEspacio || !bloqueHorarioEspacio) return;
                bloqueHorarioEspacio.classList.toggle('d-none', !chkHorarioEspacio.checked);
            }
            function toggleCompartidos() {
                if (!chkCompartidos || !bloqueCompartidos) return;
                bloqueCompartidos.classList.toggle('d-none', !chkCompartidos.checked);
                if (!chkCompartidos.checked) {
                    [listaDirectos, listaComponentes].forEach(lista => {
                        lista?.querySelectorAll('input[type="checkbox"]').forEach(chk => chk.checked = false);
                    });
                }
            }
            function renderChecklist(lista, items, seleccionados, inputName, emptyText) {
                if (!lista) return;
                lista.innerHTML = '';
                if (items.length === 0) {
                    lista.innerHTML = `<div class="small text-muted px-2 py-1">${emptyText}</div>`;
                    return;
                }

                items.forEach(item => {
                    const label = document.createElement('label');
                    label.className = 'sc-check-list-item';

                    const checkbox = document.createElement('input');
                    checkbox.type = 'checkbox';
                    checkbox.name = inputName;
                    checkbox.value = item.value;
                    checkbox.className = 'form-check-input m-0';
                    checkbox.checked = seleccionados.has(Number(item.value));

                    const texto = document.createElement('span');
                    texto.className = 'small';
                    texto.textContent = item.text;

                    label.appendChild(checkbox);
                    label.appendChild(texto);
                    lista.appendChild(label);
                });
            }
            async function recargarEspaciosCompartidos(idsDirectos, idsComponentes) {
                if (!sedeSelect || !listaDirectos || !listaComponentes) return;
                const sedeId = Number(sedeSelect.value || '0');
                if (sedeId <= 0) {
                    const mensaje = '<div class="small text-muted px-2 py-1">Selecciona una sede para ver espacios disponibles.</div>';
                    listaDirectos.innerHTML = mensaje;
                    listaComponentes.innerHTML = mensaje;
                    return;
                }

                const params = new URLSearchParams();
                params.append('negocioId', '@Model.NegocioId');
                params.append('sedeId', String(sedeId));
                params.append('espacioActualId', '@Model.Id');
                const respuesta = await fetch(`${compartidosUrlBase}?${params.toString()}`, { cache: 'no-store' });
                const payload = await respuesta.json();
                if (!respuesta.ok || !payload.ok) {
                    const mensaje = '<div class="small text-danger px-2 py-1">No se pudo cargar la lista de espacios relacionados.</div>';
                    listaDirectos.innerHTML = mensaje;
                    listaComponentes.innerHTML = mensaje;
                    return;
                }

                const items = payload.items || [];
                renderChecklist(listaDirectos, items, new Set((idsDirectos || []).map(x => Number(x))), 'EspaciosBloqueoDirectoIds', 'No hay otros espacios activos disponibles en esta sede.');
                renderChecklist(listaComponentes, items, new Set((idsComponentes || []).map(x => Number(x))), 'EspaciosComponentesIds', 'No hay otros espacios activos disponibles en esta sede.');
            }
            if (chkHorarioEspacio) {
                chkHorarioEspacio.addEventListener('change', toggleHorarioEspacio);
                toggleHorarioEspacio();
            }
            if (chkCompartidos) {
                chkCompartidos.addEventListener('change', toggleCompartidos);
                toggleCompartidos();
            }
            if (sedeSelect) {
                sedeSelect.addEventListener('change', async () => {
                    await recargarEspaciosCompartidos([], []);
                });
            }
            void recargarEspaciosCompartidos(seleccionInicialDirectos, seleccionInicialComponentes);

            const tarifasIniciales = @Html.Raw(JsonSerializer.Serialize(Model.Tarifas, new JsonSerializerOptions(JsonSerializerDefaults.Web)));
            const tarifasFeriadoIniciales = @Html.Raw(JsonSerializer.Serialize(Model.TarifasFeriado, new JsonSerializerOptions(JsonSerializerDefaults.Web)));
            const dias = @Html.Raw(JsonSerializer.Serialize(Model.TarifaDiasSemana.Select(d => new { value = d.Value, text = d.Text })));
            const tabla = document.querySelector('#tablaTarifasEspacio tbody');
            const inputJson = document.getElementById('tarifasJson');
            const tablaFeriado = document.querySelector('#tablaTarifasFeriadoEspacio tbody');
            const inputFeriadoJson = document.getElementById('tarifasFeriadoJson');
            const btnAgregar = document.getElementById('btnAgregarTarifa');
            const form = document.querySelector('form.sc-form-shell');
            const monedaEtiqueta = @Html.Raw(JsonSerializer.Serialize(Model.MonedaEtiqueta));
            const puedeEditarTarifas = @Model.PuedeEditarTarifas.ToString().ToLowerInvariant();
            const bloquePreset = document.getElementById('bloqueDiasPreset');
            const bloqueHoraInicio = document.getElementById('bloqueHoraInicio');
            const bloqueHoraFin = document.getElementById('bloqueHoraFin');
            const bloquePrecio = document.getElementById('bloquePrecio');
            const btnAgregarBloque = document.getElementById('btnAgregarBloque');
            const bloqueDiasPersonalizado = document.getElementById('bloqueDiasPersonalizado');
            const errorBox = document.getElementById('tarifasErrorBox');
            const feriadoHoraInicio = document.getElementById('feriadoHoraInicio');
            const feriadoHoraFin = document.getElementById('feriadoHoraFin');
            const feriadoPrecio = document.getElementById('feriadoPrecio');
            const btnAgregarTarifaFeriado = document.getElementById('btnAgregarTarifaFeriado');
            const tarifasFeriadoErrorBox = document.getElementById('tarifasFeriadoErrorBox');

            function mostrarError(msg) {
                errorBox.textContent = msg;
                errorBox.classList.remove('d-none');
            }

            function limpiarError() {
                errorBox.textContent = '';
                errorBox.classList.add('d-none');
            }

            function mostrarErrorFeriado(msg) {
                tarifasFeriadoErrorBox.textContent = msg;
                tarifasFeriadoErrorBox.classList.remove('d-none');
            }

            function limpiarErrorFeriado() {
                tarifasFeriadoErrorBox.textContent = '';
                tarifasFeriadoErrorBox.classList.add('d-none');
            }

            function optionDias(selected) {
                return dias.map(d => `<option value="${d.value}" ${String(selected) === String(d.value) ? 'selected' : ''}>${d.text}</option>`).join('');
            }

            function optionHoras(selected) {
                const horas = Array.from({ length: 48 }, (_, i) => {
                    const total = i * 30;
                    const h = String(Math.floor(total / 60)).padStart(2, '0');
                    const m = String(total % 60).padStart(2, '0');
                    return `${h}:${m}`;
                });
                const valor = String(selected || '').substring(0, 5);
                return horas.map(h => `<option value="${h}" ${h === valor ? 'selected' : ''}>${h}</option>`).join('');
            }

            function optionHorasFin(selected) {
                const horas = Array.from({ length: 48 }, (_, i) => {
                    const total = i * 30;
                    const h = String(Math.floor(total / 60)).padStart(2, '0');
                    const m = String(total % 60).padStart(2, '0');
                    return `${h}:${m}`;
                });
                horas.push('23:59');
                const valor = String(selected || '').substring(0, 5);
                return horas.map(h => {
                    const texto = h === '23:59' ? '24:00' : h;
                    return `<option value="${h}" ${h === valor ? 'selected' : ''}>${texto}</option>`;
                }).join('');
            }

            function normalizarHoraFin(valor) {
                const hora = String(valor || '').substring(0, 5);
                return hora === '24:00' ? '23:59' : hora;
            }

            function nombreDia(valorDia) {
                const encontrado = dias.find(d => Number(d.value) === Number(valorDia));
                return encontrado ? encontrado.text : `Dia ${valorDia}`;
            }

            function limpiarPrecio(valor) {
                const normalizado = (valor || '').replace(',', '.').replace(/[^0-9.]/g, '');
                const partes = normalizado.split('.');
                if (partes.length <= 1) return normalizado;
                return `${partes[0]}.${partes.slice(1).join('').substring(0, 2)}`;
            }

            function parsePrecio(valor) {
                const limpio = limpiarPrecio(valor);
                const numero = Number(limpio);
                return Number.isFinite(numero) ? numero : 0;
            }

            function rangosSeCruzan(inicioA, finA, inicioB, finB) {
                return inicioA < finB && inicioB < finA;
            }

            function filasTarifas() {
                return [...tabla.querySelectorAll('tr')].map(tr => ({
                    diaSemana: Number(tr.querySelector('.js-dia').value),
                    horaInicio: tr.querySelector('.js-hora-inicio').value,
                    horaFin: normalizarHoraFin(tr.querySelector('.js-hora-fin').value),
                    precio: parsePrecio(tr.querySelector('.js-precio').value)
                }));
            }

            function filasTarifasFeriado() {
                return [...tablaFeriado.querySelectorAll('tr')].map(tr => ({
                    horaInicio: tr.querySelector('.js-feriado-hora-inicio').value,
                    horaFin: normalizarHoraFin(tr.querySelector('.js-feriado-hora-fin').value),
                    precio: parsePrecio(tr.querySelector('.js-feriado-precio').value)
                }));
            }

            function validarCrucesCliente() {
                const filas = filasTarifas();
                for (const fila of filas) {
                    if (!fila.horaInicio || !fila.horaFin) {
                        return 'Completa hora inicio y hora fin en todas las tarifas.';
                    }
                    if (fila.horaFin <= fila.horaInicio) {
                        return `La hora fin debe ser mayor que la hora inicio (${nombreDia(fila.diaSemana)}).`;
                    }
                    if (fila.precio <= 0) {
                        return `El precio debe ser mayor que cero (${nombreDia(fila.diaSemana)}).`;
                    }
                }

                const porDia = {};
                for (const fila of filas) {
                    if (!porDia[fila.diaSemana]) porDia[fila.diaSemana] = [];
                    porDia[fila.diaSemana].push(fila);
                }

                for (const dia in porDia) {
                    const ordenadas = porDia[dia].sort((a, b) => a.horaInicio.localeCompare(b.horaInicio));
                    for (let i = 1; i < ordenadas.length; i++) {
                        if (rangosSeCruzan(ordenadas[i - 1].horaInicio, ordenadas[i - 1].horaFin, ordenadas[i].horaInicio, ordenadas[i].horaFin)) {
                            return `Hay cruce de horarios en ${nombreDia(Number(dia))}.`;
                        }
                    }
                }
                return null;
            }

            function validarCrucesFeriado() {
                const filas = filasTarifasFeriado();
                for (const fila of filas) {
                    if (!fila.horaInicio || !fila.horaFin) {
                        return 'Completa hora inicio y hora fin en todas las tarifas por feriado.';
                    }
                    if (fila.horaFin <= fila.horaInicio) {
                        return 'En tarifas por feriado, la hora fin debe ser mayor que la hora inicio.';
                    }
                    if (fila.precio <= 0) {
                        return 'En tarifas por feriado, el precio debe ser mayor que cero.';
                    }
                }

                const ordenadas = filas.sort((a, b) => a.horaInicio.localeCompare(b.horaInicio));
                for (let i = 1; i < ordenadas.length; i++) {
                    if (rangosSeCruzan(ordenadas[i - 1].horaInicio, ordenadas[i - 1].horaFin, ordenadas[i].horaInicio, ordenadas[i].horaFin)) {
                        return 'Hay cruce de horarios en tarifas por feriado.';
                    }
                }
                return null;
            }

            function obtenerDiasBloque() {
                const preset = bloquePreset.value;
                if (preset === 'lv') return [1, 2, 3, 4, 5];
                if (preset === 'sd') return [6, 0];
                if (preset === 'todos') return [1, 2, 3, 4, 5, 6, 0];
                return [...document.querySelectorAll('.js-dia-custom:checked')].map(x => Number(x.value));
            }

            function nuevaFila(tarifa) {
                const horaInicio = (tarifa.horaInicio ?? '08:00').toString().substring(0, 5);
                const horaFin = normalizarHoraFin((tarifa.horaFin ?? '09:00').toString().substring(0, 5));
                const precio = Number(tarifa.precio ?? 0).toFixed(2);
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td><select class="form-select form-select-sm js-dia">${optionDias(tarifa.diaSemana ?? 1)}</select></td>
                    <td><select class="form-select form-select-sm js-hora-inicio">${optionHoras(horaInicio)}</select></td>
                    <td><select class="form-select form-select-sm js-hora-fin">${optionHorasFin(horaFin)}</select></td>
                    <td class="text-end">
                        <div class="input-group input-group-sm">
                            <input type="text" inputmode="decimal" autocomplete="off" class="form-control form-control-sm text-end js-precio" value="${precio}">
                            <span class="input-group-text js-moneda">${monedaEtiqueta || ''}</span>
                        </div>
                    </td>
                    <td class="text-end"><button type="button" class="btn btn-sm sc-action-btn sc-action-delete js-quitar"><i class="bi bi-trash3"></i> Quitar</button></td>`;
                row.querySelector('.js-quitar').addEventListener('click', () => {
                    row.remove();
                    sincronizarJson();
                });
                row.querySelector('.js-precio').addEventListener('input', (e) => {
                    e.target.value = limpiarPrecio(e.target.value);
                    sincronizarJson();
                });
                row.querySelectorAll('select,input').forEach(el => el.addEventListener('change', () => {
                    sincronizarJson();
                    const err = validarCrucesCliente();
                    if (err) mostrarError(err); else limpiarError();
                }));
                tabla.appendChild(row);
            }

            function nuevaFilaFeriado(tarifa) {
                const horaInicio = (tarifa.horaInicio ?? '08:00').toString().substring(0, 5);
                const horaFin = normalizarHoraFin((tarifa.horaFin ?? '09:00').toString().substring(0, 5));
                const precio = Number(tarifa.precio ?? 0).toFixed(2);
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td><select class="form-select form-select-sm js-feriado-hora-inicio">${optionHoras(horaInicio)}</select></td>
                    <td><select class="form-select form-select-sm js-feriado-hora-fin">${optionHorasFin(horaFin)}</select></td>
                    <td class="text-end">
                        <div class="input-group input-group-sm">
                            <input type="text" inputmode="decimal" autocomplete="off" class="form-control form-control-sm text-end js-feriado-precio" value="${precio}">
                            <span class="input-group-text">${monedaEtiqueta || ''}</span>
                        </div>
                    </td>
                    <td class="text-end"><button type="button" class="btn btn-sm sc-action-btn sc-action-delete js-feriado-quitar"><i class="bi bi-trash3"></i> Quitar</button></td>`;
                row.querySelector('.js-feriado-quitar').addEventListener('click', () => {
                    row.remove();
                    sincronizarJsonFeriado();
                });
                row.querySelector('.js-feriado-precio').addEventListener('input', (e) => {
                    e.target.value = limpiarPrecio(e.target.value);
                    sincronizarJsonFeriado();
                });
                row.querySelectorAll('select,input').forEach(el => el.addEventListener('change', () => {
                    sincronizarJsonFeriado();
                    const err = validarCrucesFeriado();
                    if (err) mostrarErrorFeriado(err); else limpiarErrorFeriado();
                }));
                tablaFeriado.appendChild(row);
            }

            function sincronizarJson() {
                if (!puedeEditarTarifas) {
                    inputJson.value = "[]";
                    return;
                }
                const data = [...tabla.querySelectorAll('tr')].map(tr => ({
                    diaSemana: Number(tr.querySelector('.js-dia').value),
                    horaInicio: tr.querySelector('.js-hora-inicio').value,
                    horaFin: normalizarHoraFin(tr.querySelector('.js-hora-fin').value),
                    precio: parsePrecio(tr.querySelector('.js-precio').value)
                }));
                inputJson.value = JSON.stringify(data);
            }

            function sincronizarJsonFeriado() {
                if (!puedeEditarTarifas) {
                    inputFeriadoJson.value = "[]";
                    return;
                }
                const data = [...tablaFeriado.querySelectorAll('tr')].map(tr => ({
                    horaInicio: tr.querySelector('.js-feriado-hora-inicio').value,
                    horaFin: normalizarHoraFin(tr.querySelector('.js-feriado-hora-fin').value),
                    precio: parsePrecio(tr.querySelector('.js-feriado-precio').value)
                }));
                inputFeriadoJson.value = JSON.stringify(data);
            }

            if (bloquePreset) {
                bloquePreset.addEventListener('change', () => {
                    const esPersonalizado = bloquePreset.value === 'personalizado';
                    bloqueDiasPersonalizado.classList.toggle('d-none', !esPersonalizado);
                });
            }

            if (bloquePrecio) {
                bloquePrecio.addEventListener('input', (e) => {
                    e.target.value = limpiarPrecio(e.target.value);
                });
            }
            if (feriadoPrecio) {
                feriadoPrecio.addEventListener('input', (e) => {
                    e.target.value = limpiarPrecio(e.target.value);
                });
            }

            if (btnAgregarBloque) {
                btnAgregarBloque.addEventListener('click', () => {
                    if (!puedeEditarTarifas) return;
                    limpiarError();

                    const diasSeleccionados = obtenerDiasBloque();
                    const horaInicio = bloqueHoraInicio.value;
                    const horaFin = normalizarHoraFin(bloqueHoraFin.value);
                    const precio = parsePrecio(bloquePrecio.value);

                    if (!diasSeleccionados.length) {
                        mostrarError('Selecciona al menos un dia para el bloque.');
                        return;
                    }
                    if (!horaInicio || !horaFin || horaFin <= horaInicio) {
                        mostrarError('La hora fin debe ser mayor que la hora inicio.');
                        return;
                    }
                    if (precio <= 0) {
                        mostrarError('El precio del bloque debe ser mayor que cero.');
                        return;
                    }

                    const actuales = filasTarifas();
                    for (const dia of diasSeleccionados) {
                        const cruza = actuales.some(t =>
                            t.diaSemana === dia &&
                            rangosSeCruzan(horaInicio, horaFin, t.horaInicio, t.horaFin));
                        if (cruza) {
                            mostrarError(`No se puede agregar el bloque porque cruza horarios en ${nombreDia(dia)}.`);
                            return;
                        }
                    }

                    diasSeleccionados.forEach(dia => nuevaFila({ diaSemana: dia, horaInicio, horaFin, precio }));
                    sincronizarJson();
                    const err = validarCrucesCliente();
                    if (err) mostrarError(err); else limpiarError();
                });
            }

            if (btnAgregarTarifaFeriado) {
                btnAgregarTarifaFeriado.addEventListener('click', () => {
                    if (!puedeEditarTarifas) return;
                    limpiarErrorFeriado();

                    const horaInicio = feriadoHoraInicio.value;
                    const horaFin = normalizarHoraFin(feriadoHoraFin.value);
                    const precio = parsePrecio(feriadoPrecio.value);

                    if (!horaInicio || !horaFin || horaFin <= horaInicio) {
                        mostrarErrorFeriado('En tarifas por feriado, la hora fin debe ser mayor que la hora inicio.');
                        return;
                    }
                    if (precio <= 0) {
                        mostrarErrorFeriado('En tarifas por feriado, el precio debe ser mayor que cero.');
                        return;
                    }

                    const actuales = filasTarifasFeriado();
                    const cruza = actuales.some(t => rangosSeCruzan(horaInicio, horaFin, t.horaInicio, t.horaFin));
                    if (cruza) {
                        mostrarErrorFeriado('No se puede agregar porque cruza horarios en tarifas por feriado.');
                        return;
                    }

                    nuevaFilaFeriado({ horaInicio, horaFin, precio });
                    sincronizarJsonFeriado();
                    const err = validarCrucesFeriado();
                    if (err) mostrarErrorFeriado(err); else limpiarErrorFeriado();
                });
            }

            btnAgregar.addEventListener('click', () => {
                if (!puedeEditarTarifas) return;
                nuevaFila({ diaSemana: 1, horaInicio: '08:00', horaFin: '09:00', precio: 0.01 });
                sincronizarJson();
            });

            if (puedeEditarTarifas) {
                (tarifasIniciales && tarifasIniciales.length ? tarifasIniciales : [{ diaSemana: 1, horaInicio: '08:00', horaFin: '09:00', precio: 0.01 }])
                    .forEach(nuevaFila);
                (tarifasFeriadoIniciales && tarifasFeriadoIniciales.length ? tarifasFeriadoIniciales : [])
                    .forEach(nuevaFilaFeriado);
            }
            sincronizarJson();
            sincronizarJsonFeriado();

            form.addEventListener('submit', (e) => {
                sincronizarJson();
                sincronizarJsonFeriado();
                const err = validarCrucesCliente();
                const errFeriado = validarCrucesFeriado();
                if (err || errFeriado) {
                    e.preventDefault();
                    if (err) mostrarError(err); else limpiarError();
                    if (errFeriado) mostrarErrorFeriado(errFeriado); else limpiarErrorFeriado();
                } else {
                    limpiarError();
                    limpiarErrorFeriado();
                }
            });
        })();
    </script>
    <script>
        (() => {
            const input = document.getElementById('imagenesArchivosInput');
            const bodyActuales = document.getElementById('imagenesActualesBody');
            const bodySeleccionadas = document.getElementById('imagenesSeleccionadasBody');
            const fotoPrincipalInput = document.getElementById('FotoPrincipalUrl');
            const fotosCsvInput = document.getElementById('FotosUrlsCsv');
            const eliminarContainer = document.getElementById('fotosEliminarContainer');
            if (!input || !bodyActuales || !bodySeleccionadas || !fotoPrincipalInput || !fotosCsvInput || !eliminarContainer) return;

            const MAX_IMAGENES = 3;
            const previewUrl = '@Url.Action("VerImagen", "Espacios")';
            let actuales = @Html.Raw(JsonSerializer.Serialize(galeriaEspacio));
            let selectedFiles = [];
            let eliminadas = [];

            function fileKey(file) {
                return `${file.name}__${file.size}__${file.lastModified}`;
            }

            function formatBytes(bytes) {
                if (!bytes || bytes <= 0) return '0 KB';
                const kb = bytes / 1024;
                if (kb < 1024) return `${kb.toFixed(1)} KB`;
                return `${(kb / 1024).toFixed(2)} MB`;
            }

            function syncInputFiles() {
                const dt = new DataTransfer();
                selectedFiles.forEach(file => dt.items.add(file));
                input.files = dt.files;
            }

            function syncHiddenState() {
                fotoPrincipalInput.value = actuales[0] || '';
                fotosCsvInput.value = actuales.slice(1).join(',');
                eliminarContainer.innerHTML = '';
                eliminadas.forEach(url => {
                    const hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'FotosEliminarUrls';
                    hidden.value = url;
                    eliminarContainer.appendChild(hidden);
                });
            }

            function moveActual(index, offset) {
                const target = index + offset;
                if (target < 0 || target >= actuales.length) return;
                const tmp = actuales[index];
                actuales[index] = actuales[target];
                actuales[target] = tmp;
                syncHiddenState();
                renderActuales();
            }

            function removeActual(index) {
                const [url] = actuales.splice(index, 1);
                if (url) eliminadas.push(url);
                syncHiddenState();
                renderActuales();
            }

            function moveSelected(index, offset) {
                const target = index + offset;
                if (target < 0 || target >= selectedFiles.length) return;
                const tmp = selectedFiles[index];
                selectedFiles[index] = selectedFiles[target];
                selectedFiles[target] = tmp;
                syncInputFiles();
                renderSeleccionadas();
            }

            function removeSelected(index) {
                selectedFiles.splice(index, 1);
                syncInputFiles();
                renderSeleccionadas();
            }

            function renderActuales() {
                if (actuales.length === 0) {
                    bodyActuales.innerHTML = '<tr><td colspan="5" class="text-muted small">No hay imagenes registradas.</td></tr>';
                    return;
                }

                bodyActuales.innerHTML = '';
                actuales.forEach((url, index) => {
                    const rol = index === 0 ? 'Principal' : `Alternativa ${index}`;
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>${index + 1}</td>
                        <td>
                            <a class="btn btn-sm btn-outline-secondary" href="${previewUrl}?url=${encodeURIComponent(url)}" target="_blank" rel="noopener noreferrer">Ver imagen</a>
                        </td>
                        <td class="text-break small">${url}</td>
                        <td><span class="badge ${index === 0 ? 'text-bg-primary' : 'text-bg-secondary'}">${rol}</span></td>
                        <td class="d-flex gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="up" data-index="${index}" ${index === 0 ? 'disabled' : ''}>↑</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="down" data-index="${index}" ${index === actuales.length - 1 ? 'disabled' : ''}>↓</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-action="remove" data-index="${index}">Quitar</button>
                        </td>
                    `;
                    bodyActuales.appendChild(tr);
                });
            }

            function renderSeleccionadas() {
                if (selectedFiles.length === 0) {
                    bodySeleccionadas.innerHTML = '<tr><td colspan="5" class="text-muted small">Aun no has seleccionado archivos.</td></tr>';
                    return;
                }

                bodySeleccionadas.innerHTML = '';
                selectedFiles.forEach((file, index) => {
                    const ordenFinal = actuales.length + index;
                    const rol = ordenFinal === 0 ? 'Principal' : `Alternativa ${ordenFinal}`;
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>${index + 1}</td>
                        <td class="text-truncate" style="max-width:420px;" title="${file.name}">${file.name}</td>
                        <td><span class="badge ${ordenFinal === 0 ? 'text-bg-primary' : 'text-bg-secondary'}">${rol}</span></td>
                        <td>${formatBytes(file.size)}</td>
                        <td class="d-flex gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="up" data-index="${index}" ${index === 0 ? 'disabled' : ''}>↑</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="down" data-index="${index}" ${index === selectedFiles.length - 1 ? 'disabled' : ''}>↓</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-action="remove" data-index="${index}">Quitar</button>
                        </td>
                    `;
                    bodySeleccionadas.appendChild(tr);
                });
            }

            bodyActuales.addEventListener('click', (e) => {
                const btn = e.target.closest('button[data-action]');
                if (!btn) return;
                const action = btn.getAttribute('data-action');
                const index = Number(btn.getAttribute('data-index'));
                if (!Number.isInteger(index)) return;
                if (action === 'up') moveActual(index, -1);
                if (action === 'down') moveActual(index, 1);
                if (action === 'remove') removeActual(index);
            });

            bodySeleccionadas.addEventListener('click', (e) => {
                const btn = e.target.closest('button[data-action]');
                if (!btn) return;
                const action = btn.getAttribute('data-action');
                const index = Number(btn.getAttribute('data-index'));
                if (!Number.isInteger(index)) return;
                if (action === 'up') moveSelected(index, -1);
                if (action === 'down') moveSelected(index, 1);
                if (action === 'remove') removeSelected(index);
            });

            input.addEventListener('change', () => {
                const incoming = Array.from(input.files || []);
                if (incoming.length === 0) return;

                const disponibles = Math.max(0, MAX_IMAGENES - actuales.length - selectedFiles.length);
                let agregadas = 0;
                let duplicadas = 0;
                let porLimite = 0;

                for (const file of incoming) {
                    if (selectedFiles.some(x => fileKey(x) === fileKey(file))) {
                        duplicadas++;
                        continue;
                    }
                    if (agregadas >= disponibles) {
                        porLimite++;
                        continue;
                    }
                    selectedFiles.push(file);
                    agregadas++;
                }

                if (porLimite > 0) {
                    input.setCustomValidity(`Solo puedes tener ${MAX_IMAGENES} imagenes en total por espacio deportivo.`);
                    input.reportValidity();
                } else if (duplicadas > 0 && agregadas === 0) {
                    input.setCustomValidity('Ese archivo ya fue agregado.');
                    input.reportValidity();
                } else {
                    input.setCustomValidity('');
                }

                syncInputFiles();
                renderSeleccionadas();
            });

            syncHiddenState();
            renderActuales();
            renderSeleccionadas();
        })();
    </script>
}

