@model SistemaControlEspaciosDeportivosWeb.ViewModels.ConfiguracionClubViewModel
@{
    ViewData["Title"] = "Configuracion";
}

<header class="page-header">
    <div>
        <h1>Configuración del Complejo Deportivo</h1>
        <p class="page-subtitle">Edita los datos principales del negocio y la moneda de trabajo.</p>
    </div>
    <div class="action-toolbar">
        <a class="btn btn-outline-secondary" asp-controller="Panel" asp-action="Index" asp-route-negocioId="@Model.NegocioId">
            <i class="bi bi-arrow-left"></i> Volver al panel
        </a>
    </div>
</header>

@if (TempData["ConfiguracionOk"] is string mensajeOk && !string.IsNullOrWhiteSpace(mensajeOk))
{
    <div class="alert alert-success">@mensajeOk</div>
}
@if (TempData["ConfiguracionError"] is string mensajeError && !string.IsNullOrWhiteSpace(mensajeError))
{
    <div class="alert alert-danger">@mensajeError</div>
}

<form asp-action="Index" method="post" class="sc-form-shell" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="NegocioId" />
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="LogoUrl" />
    <div asp-validation-summary="All" class="alert alert-danger shadow-sm mb-0"></div>

    <section class="sc-form-card">
        <div class="sc-form-section">
            <h2 class="sc-form-title"><i class="bi bi-building"></i> Datos del complejo deportivo</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="NombreComercial" class="form-label">Nombre comercial</label>
                    <input asp-for="NombreComercial" class="form-control" maxlength="200" required />
                </div>
                <div class="col-md-4">
                    <label asp-for="RazonSocial" class="form-label">Razon social</label>
                    <input asp-for="RazonSocial" class="form-control" maxlength="200" />
                </div>
                <div class="col-md-3">
                    <label asp-for="TipoDocumento" class="form-label">Tipo de documento</label>
                    <select asp-for="TipoDocumento" asp-items="Model.TiposDocumento" class="form-select"></select>
                    <span asp-validation-for="TipoDocumento" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="NumeroDocumento" class="form-label">Numero documento</label>
                    <input asp-for="NumeroDocumento" class="form-control" maxlength="20" />
                    <span asp-validation-for="NumeroDocumento" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="DireccionFiscal" class="form-label">Direccion fiscal</label>
                    <input asp-for="DireccionFiscal" class="form-control" maxlength="250" />
                    <span asp-validation-for="DireccionFiscal" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CodigoDepartamento" class="form-label">Departamento</label>
                    <select asp-for="CodigoDepartamento" asp-items="Model.DepartamentosUbigeo" class="form-select" id="CodigoDepartamento">
                        <option value="">Selecciona departamento</option>
                    </select>
                    <span asp-validation-for="CodigoDepartamento" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CodigoProvincia" class="form-label">Provincia</label>
                    <select asp-for="CodigoProvincia" asp-items="Model.ProvinciasUbigeo" class="form-select" id="CodigoProvincia">
                        <option value="">Selecciona provincia</option>
                    </select>
                    <span asp-validation-for="CodigoProvincia" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CodigoUbigeo" class="form-label">Distrito</label>
                    <select asp-for="CodigoUbigeo" asp-items="Model.DistritosUbigeo" class="form-select" id="CodigoUbigeo">
                        <option value="">Selecciona distrito</option>
                    </select>
                    <span asp-validation-for="CodigoUbigeo" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="sc-check-chip">
                        <input asp-for="EmisionComprobantesElectronicos" class="form-check-input mt-0" />
                        <span>Emision de comprobantes electronicos</span>
                    </label>
                    <span asp-validation-for="EmisionComprobantesElectronicos" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="sc-check-chip">
                        <input asp-for="EnviarComprobanteAutomatico" class="form-check-input mt-0" />
                        <span>Enviar comprobante automatico</span>
                    </label>
                </div>
                <div class="col-md-4">
                    <label class="sc-check-chip">
                        <input asp-for="EmisionReciboInterno" class="form-check-input mt-0" />
                        <span>Emision de recibo interno</span>
                    </label>
                    <span asp-validation-for="EmisionReciboInterno" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label class="form-label d-flex align-items-center gap-2">
                        <i class="bi bi-image"></i>
                        <span>Logo del complejo deportivo</span>
                    </label>
                    <div class="row g-3 align-items-start">
                        <div class="col-lg-4 col-md-5">
                            @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
                            {
                                <img id="logoClubPreview"
                                     src="@Url.Action("VerImagen", "Sedes", new { url = Model.LogoUrl })"
                                     alt="Logo del complejo deportivo"
                                     class="img-fluid rounded-3 border"
                                     style="max-width: 220px; aspect-ratio: 1 / 1; object-fit: contain; background: #fff;" />
                            }
                            else
                            {
                                <div id="logoClubPreviewVacio"
                                     class="d-flex align-items-center justify-content-center rounded-3 border text-muted"
                                     style="max-width: 220px; aspect-ratio: 1 / 1; background: #f8fafc;">
                                    Sin logo
                                </div>
                            }
                        </div>
                        <div class="col-lg-8 col-md-7">
                            <input asp-for="LogoArchivo" type="file" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                            <div class="form-text">Formatos permitidos: JPG o PNG. Se optimiza y guarda como WebP.</div>
                            <span asp-validation-for="LogoArchivo" class="text-danger"></span>
                            <div class="form-check mt-2">
                                <input asp-for="QuitarLogo" class="form-check-input" type="checkbox" />
                                <label asp-for="QuitarLogo" class="form-check-label">Quitar logo actual</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="sc-form-section mt-3">
            <h2 class="sc-form-title"><i class="bi bi-sliders"></i> Configuracion de Atributos</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="PoliticaConfirmacionPago" class="form-label">Confirmar reserva requiere pago</label>
                    <select asp-for="PoliticaConfirmacionPago" asp-items="Model.PoliticasConfirmacionPago" class="form-select" id="PoliticaConfirmacionPago"></select>
                    <span asp-validation-for="PoliticaConfirmacionPago" class="text-danger"></span>
                </div>
                <div class="col-md-6" id="rowPorcentajeAdelantoMinimo">
                    <label asp-for="PorcentajeAdelantoMinimo" class="form-label">Porcentaje minimo de adelanto (%)</label>
                    <input asp-for="PorcentajeAdelantoMinimo"
                           value="@(Model.PorcentajeAdelantoMinimo.HasValue ? Math.Truncate(Model.PorcentajeAdelantoMinimo.Value).ToString() : string.Empty)"
                           class="form-control text-end"
                           id="PorcentajeAdelantoMinimo"
                           type="text"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           maxlength="3"
                           autocomplete="off" />
                    <span asp-validation-for="PorcentajeAdelantoMinimo" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MonedaId" class="form-label">Moneda de trabajo</label>
                    <select asp-for="MonedaId" asp-items="Model.Monedas" class="form-select"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="PorcentajeIgv" class="form-label">IGV (%)</label>
                    <input asp-for="PorcentajeIgv" class="form-control text-center" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="3" id="PorcentajeIgv" />
                    <span asp-validation-for="PorcentajeIgv" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="sc-check-chip">
                        <input asp-for="PermitirModificarPrecioReserva" class="form-check-input mt-0" />
                        <span>Permitir modificar un precio en el registro de reserva</span>
                    </label>
                </div>
                <div class="col-md-6">
                    <label class="sc-check-chip">
                        <input asp-for="CancelacionAutomaticaNoConfirmada" class="form-check-input mt-0" id="CancelacionAutomaticaNoConfirmada" />
                        <span>Cancelacion de reserva por tiempo no confirmado</span>
                    </label>
                </div>
                <div class="col-md-6" id="rowMinutosCancelacionNoConfirmada">
                    <label asp-for="MinutosCancelacionNoConfirmada" class="form-label">Tiempo maximo sin confirmar (minutos)</label>
                    <input asp-for="MinutosCancelacionNoConfirmada"
                           class="form-control text-end"
                           type="text"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           maxlength="4"
                           id="MinutosCancelacionNoConfirmada" />
                    <span asp-validation-for="MinutosCancelacionNoConfirmada" class="text-danger"></span>
                </div>
            </div>
        </div>
    </section>

    <div class="sc-form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check2-circle me-1"></i> Guardar configuracion
        </button>
    </div>
</form>

<section class="table-card mt-3">
    <h2 class="section-title"><i class="bi bi-receipt me-1"></i>Series por documento</h2>
    <div class="row g-3 px-3 pb-3">
        <div class="col-md-4" id="panelSeriesTributarias">
            <form asp-action="GuardarSerieDocumento" method="post" class="row g-2 js-form-serie-documento">
                @Html.AntiForgeryToken()
                <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                <input type="hidden" name="emisionComprobantesElectronicos" class="js-emision-cpe-hidden" value="@(Model.EmisionComprobantesElectronicos ? "true" : "false")" />
                <input type="hidden" name="enviarComprobanteAutomatico" class="js-enviar-cpe-auto-hidden" value="@(Model.EnviarComprobanteAutomatico ? "true" : "false")" />
                <input type="hidden" name="emisionReciboInterno" class="js-emision-recibo-hidden" value="@(Model.EmisionReciboInterno ? "true" : "false")" />
                <div class="col-12">
                    <label class="form-label">Documento tributario</label>
                    <select name="codigoSunat" class="form-select" required>
                        <option value="">Selecciona documento</option>
                        @foreach (var item in Model.TiposDocumentoComprobanteTributarios)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-8">
                    <label class="form-label">Serie (4)</label>
                    <input type="text" name="serie" maxlength="4" class="form-control text-uppercase" required />
                </div>
                <div class="col-4 d-grid align-items-end">
                    <button type="submit" class="btn btn-outline-primary"><i class="bi bi-plus-circle me-1"></i>Agregar</button>
                </div>
            </form>
        </div>
        <div class="col-md-4" id="panelSeriesNoTributarias">
            <form asp-action="GuardarSerieDocumento" method="post" class="row g-2 js-form-serie-documento">
                @Html.AntiForgeryToken()
                <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                <input type="hidden" name="emisionComprobantesElectronicos" class="js-emision-cpe-hidden" value="@(Model.EmisionComprobantesElectronicos ? "true" : "false")" />
                <input type="hidden" name="enviarComprobanteAutomatico" class="js-enviar-cpe-auto-hidden" value="@(Model.EnviarComprobanteAutomatico ? "true" : "false")" />
                <input type="hidden" name="emisionReciboInterno" class="js-emision-recibo-hidden" value="@(Model.EmisionReciboInterno ? "true" : "false")" />
                <div class="col-12">
                    <label class="form-label">Documento no tributario</label>
                    <select name="codigoSunat" class="form-select" required>
                        <option value="">Selecciona documento</option>
                        @foreach (var item in Model.TiposDocumentoComprobanteNoTributarios)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-8">
                    <label class="form-label">Serie (4)</label>
                    <input type="text" name="serie" maxlength="4" class="form-control text-uppercase" required />
                </div>
                <div class="col-4 d-grid align-items-end">
                    <button type="submit" class="btn btn-outline-primary"><i class="bi bi-plus-circle me-1"></i>Agregar</button>
                </div>
            </form>
        </div>
    </div>
    <div class="table-responsive px-3 pb-3">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Documento</th>
                    <th>Codigo</th>
                    <th>Serie</th>
                    <th>Clase</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.SeriesDocumentoComprobante.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">Aun no hay series configuradas.</td></tr>
                }
                else
                {
                    @foreach (var item in Model.SeriesDocumentoComprobante)
                    {
                        <tr>
                            <td>@item.NombreDocumento</td>
                            <td>@item.CodigoSunat</td>
                            <td>@item.Serie</td>
                            <td>
                                <span class="badge @(item.Tributario ? "bg-info-subtle text-info-emphasis border border-info-subtle" : "bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle")">
                                    @(item.Tributario ? "Tributario" : "No tributario")
                                </span>
                            </td>
                            <td>
                                <span class="badge @(item.Activo ? "bg-success-subtle text-success-emphasis border border-success-subtle" : "bg-danger-subtle text-danger-emphasis border border-danger-subtle")">
                                    @(item.Activo ? "Activa" : "Inactiva")
                                </span>
                            </td>
                            <td class="text-end">
                                <form asp-action="EliminarSerieDocumento" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="negocioId" value="@Model.NegocioId" />
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="emisionComprobantesElectronicos" class="js-emision-cpe-hidden" value="@(Model.EmisionComprobantesElectronicos ? "true" : "false")" />
                                    <input type="hidden" name="enviarComprobanteAutomatico" class="js-enviar-cpe-auto-hidden" value="@(Model.EnviarComprobanteAutomatico ? "true" : "false")" />
                                    <input type="hidden" name="emisionReciboInterno" class="js-emision-recibo-hidden" value="@(Model.EmisionReciboInterno ? "true" : "false")" />
                                    <button type="submit" class="btn btn-sm sc-action-btn sc-action-delete"><i class="bi bi-trash3"></i>Inactivar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const direccion = document.getElementById('DireccionFiscal');
            const dep = document.getElementById('CodigoDepartamento');
            const prov = document.getElementById('CodigoProvincia');
            const dist = document.getElementById('CodigoUbigeo');
            const politicaPago = document.getElementById('PoliticaConfirmacionPago');
            const rowPorcentaje = document.getElementById('rowPorcentajeAdelantoMinimo');
            const porcentaje = document.getElementById('PorcentajeAdelantoMinimo');
            const chkCpe = document.getElementById('EmisionComprobantesElectronicos');
            const chkEnviarComprobanteAutomatico = document.getElementById('EnviarComprobanteAutomatico');
            const chkRecibo = document.getElementById('EmisionReciboInterno');
            const chkCancelacionAuto = document.getElementById('CancelacionAutomaticaNoConfirmada');
            const rowMinCancelacionAuto = document.getElementById('rowMinutosCancelacionNoConfirmada');
            const minCancelacionAuto = document.getElementById('MinutosCancelacionNoConfirmada');
            const tipoDocumento = document.getElementById('TipoDocumento');
            const logoArchivo = document.getElementById('LogoArchivo');
            const quitarLogo = document.getElementById('QuitarLogo');
            const formsSeries = Array.from(document.querySelectorAll('.js-form-serie-documento'));
            const hiddenCpe = Array.from(document.querySelectorAll('.js-emision-cpe-hidden'));
            const hiddenEnviarAuto = Array.from(document.querySelectorAll('.js-enviar-cpe-auto-hidden'));
            const hiddenRecibo = Array.from(document.querySelectorAll('.js-emision-recibo-hidden'));
            const panelSeriesTrib = document.getElementById('panelSeriesTributarias');
            const panelSeriesNoTrib = document.getElementById('panelSeriesNoTributarias');
            if (!direccion || !dep || !prov || !dist || !politicaPago || !rowPorcentaje || !porcentaje) return;

            const urlProv = '@Url.Action("UbigeoProvincias", "Configuracion")';
            const urlDist = '@Url.Action("UbigeoDistritos", "Configuracion")';

            function toggleRequired() {
                const required = (direccion.value || '').trim().length > 0 || !!(chkCpe && chkCpe.checked);
                dep.required = required;
                prov.required = required;
                dist.required = required;
            }

            function togglePoliticaPago() {
                const requiereAdelanto = (politicaPago.value || '') === '1';
                rowPorcentaje.style.display = requiereAdelanto ? '' : 'none';
                porcentaje.required = requiereAdelanto;
                if (!requiereAdelanto) porcentaje.value = '';
            }

            function toggleCancelacionAuto() {
                if (!chkCancelacionAuto || !rowMinCancelacionAuto || !minCancelacionAuto) return;
                const activo = chkCancelacionAuto.checked;
                rowMinCancelacionAuto.style.display = activo ? '' : 'none';
                minCancelacionAuto.required = activo;
                if (!activo) minCancelacionAuto.value = '';
            }

            function toggleSeccionesEmision() {
                if (panelSeriesTrib && chkCpe) panelSeriesTrib.style.display = chkCpe.checked ? '' : 'none';
                if (panelSeriesNoTrib && chkRecibo) panelSeriesNoTrib.style.display = chkRecibo.checked ? '' : 'none';
            }

            function aplicarReglasCpe() {
                const activo = !!(chkCpe && chkCpe.checked);
                if (tipoDocumento) {
                    if (activo) {
                        tipoDocumento.value = '6';
                    }
                    tipoDocumento.required = activo;
                }
                if (igv) igv.required = activo;
                if (direccion) direccion.required = activo;
                toggleRequired();
            }

            function syncHiddenEmisionEnFormsSeries() {
                const cpe = chkCpe && chkCpe.checked ? 'true' : 'false';
                const recibo = chkRecibo && chkRecibo.checked ? 'true' : 'false';
                hiddenCpe.forEach(i => i.value = cpe);
                hiddenRecibo.forEach(i => i.value = recibo);
            }

            function limpiarCheckQuitarLogoConNuevoArchivo() {
                if (!logoArchivo || !quitarLogo) return;
                if ((logoArchivo.files || []).length > 0) quitarLogo.checked = false;
            }

            function normalizarPorcentajeEntero() {
                const raw = (porcentaje.value || '').trim();
                if (!raw) {
                    porcentaje.value = '';
                    return;
                }
                const normalizado = raw.replace(',', '.');
                let numero = Number.parseFloat(normalizado);
                if (!Number.isFinite(numero)) {
                    const soloDigitos = raw.replace(/\D/g, '');
                    if (!soloDigitos) {
                        porcentaje.value = '';
                        return;
                    }
                    numero = Number.parseInt(soloDigitos, 10);
                }
                let entero = Math.trunc(numero);
                if (!Number.isFinite(entero)) {
                    porcentaje.value = '';
                    return;
                }

                if (entero < 1) entero = 1;
                if (entero > 100) entero = 100;
                porcentaje.value = String(entero);
            }

            async function cargarSelect(select, url, emptyText, selectedValue) {
                select.innerHTML = `<option value="">${emptyText}</option>`;
                if (!url) return;
                const resp = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!resp.ok) return;
                const data = await resp.json();
                (data || []).forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item.value;
                    opt.textContent = item.text;
                    if (selectedValue && selectedValue === item.value) opt.selected = true;
                    select.appendChild(opt);
                });
            }

            dep.addEventListener('change', async () => {
                await cargarSelect(prov, dep.value ? `${urlProv}?codigoDepartamento=${encodeURIComponent(dep.value)}` : '', 'Selecciona provincia', '');
                await cargarSelect(dist, '', 'Selecciona distrito', '');
            });

            prov.addEventListener('change', async () => {
                await cargarSelect(dist, prov.value ? `${urlDist}?codigoProvincia=${encodeURIComponent(prov.value)}` : '', 'Selecciona distrito', '');
            });

            direccion.addEventListener('input', toggleRequired);
            politicaPago.addEventListener('change', togglePoliticaPago);
            porcentaje.addEventListener('keydown', (evt) => {
                const tecla = evt.key;
                if (tecla === '.' || tecla === ',' || tecla === 'e' || tecla === 'E' || tecla === '-' || tecla === '+') {
                    evt.preventDefault();
                }
            });
            porcentaje.addEventListener('input', normalizarPorcentajeEntero);
            porcentaje.addEventListener('blur', normalizarPorcentajeEntero);
            if (chkCpe) chkCpe.addEventListener('change', toggleSeccionesEmision);
            if (chkRecibo) chkRecibo.addEventListener('change', toggleSeccionesEmision);
            if (chkCpe) chkCpe.addEventListener('change', syncHiddenEmisionEnFormsSeries);
            if (chkRecibo) chkRecibo.addEventListener('change', syncHiddenEmisionEnFormsSeries);
            if (chkCpe) chkCpe.addEventListener('change', aplicarReglasCpe);
            if (chkCancelacionAuto) chkCancelacionAuto.addEventListener('change', toggleCancelacionAuto);
            formsSeries.forEach(f => f.addEventListener('submit', syncHiddenEmisionEnFormsSeries));
            if (logoArchivo) logoArchivo.addEventListener('change', limpiarCheckQuitarLogoConNuevoArchivo);
            const igv = document.getElementById('PorcentajeIgv');
            if (igv) {
                const normalizarIgv = () => {
                    const raw = (igv.value || '').trim().replace(/\D/g, '');
                    if (!raw) {
                        igv.value = '';
                        return;
                    }
                    let entero = Number.parseInt(raw, 10);
                    if (!Number.isFinite(entero)) entero = 0;
                    if (entero < 0) entero = 0;
                    if (entero > 100) entero = 100;
                    igv.value = String(entero);
                };
                igv.addEventListener('keydown', (evt) => {
                    const tecla = evt.key;
                    if (tecla === '.' || tecla === ',' || tecla === 'e' || tecla === 'E' || tecla === '-' || tecla === '+') {
                        evt.preventDefault();
                    }
                });
                igv.addEventListener('input', normalizarIgv);
                igv.addEventListener('blur', normalizarIgv);
            }
            if (minCancelacionAuto) {
                const normalizarMinutosAuto = () => {
                    const raw = (minCancelacionAuto.value || '').trim().replace(/\D/g, '');
                    if (!raw) {
                        minCancelacionAuto.value = '';
                        return;
                    }
                    let entero = Number.parseInt(raw, 10);
                    if (!Number.isFinite(entero)) entero = 0;
                    if (entero < 5) entero = 5;
                    if (entero > 1440) entero = 1440;
                    minCancelacionAuto.value = String(entero);
                };
                minCancelacionAuto.addEventListener('keydown', (evt) => {
                    const tecla = evt.key;
                    if (tecla === '.' || tecla === ',' || tecla === 'e' || tecla === 'E' || tecla === '-' || tecla === '+') {
                        evt.preventDefault();
                    }
                });
                minCancelacionAuto.addEventListener('input', normalizarMinutosAuto);
                minCancelacionAuto.addEventListener('blur', normalizarMinutosAuto);
            }
            toggleRequired();
            togglePoliticaPago();
            toggleCancelacionAuto();
            normalizarPorcentajeEntero();
            toggleSeccionesEmision();
            syncHiddenEmisionEnFormsSeries();
            aplicarReglasCpe();
        })();
    </script>
}


