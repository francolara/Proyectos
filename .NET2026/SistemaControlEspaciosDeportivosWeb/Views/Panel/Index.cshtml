                                        <td class="text-end">@Model.MonedaSimbolo @item.Cobrado.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">No hay espacios con actividad en el rango.</td>
                                </tr>
                            }
