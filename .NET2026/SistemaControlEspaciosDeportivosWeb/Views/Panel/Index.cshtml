                    </div>
                    <table class="sc-report-print-table">
                        <thead>
                            <tr>
                                <th>Sede</th>
                                <th>Espacio</th>
                                <th class="text-end">Reservas</th>
                                <th class="text-end">Reservado</th>
                                <th class="text-end">Cobrado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopEspacios.Any())
                            {
                                @foreach (var item in Model.TopEspacios.Take(8))
