@model SistemaControlEspaciosDeportivosWeb.ViewModels.PanelDashboardViewModel
<!-- Firma: Codex - 27/03/2026 -->
@{
    ViewData["Title"] = "Panel administrativo";
    ViewData["AdminShell"] = true;
    ViewData["AdminNegocioId"] = Model.NegocioSeleccionadoId;
}

<section>
        <header class="sc-admin-topbar">
            <div class="sc-admin-topbar-head">
                <h1>Panel administrativo</h1>
                <p>Resumen general del negocio</p>
            </div>

            <div class="sc-admin-topbar-actions">
                <form asp-action="Index" method="get" class="sc-admin-switcher">
                    <label for="negocioIdSelect">Club / negocio</label>
                    <div class="sc-admin-switcher-controls">
                        <select id="negocioIdSelect" name="negocioId" class="form-select">
                            @foreach (var negocio in Model.Negocios)
                            {
                                <option value="@negocio.NegocioId" selected="@(negocio.NegocioId == Model.NegocioSeleccionadoId)">
                                    @negocio.NombreNegocio (@negocio.Rol)
                                </option>
                            }
                        </select>
                        <button type="submit" class="btn btn-primary">Cambiar</button>
                    </div>
                </form>
                <div class="sc-admin-userbox">
                    <i class="bi bi-person-circle"></i>
                    <div>
                        <strong>@(User.Identity?.Name ?? "Usuario")</strong>
                        <span>Rol: @Model.RolActual</span>
                    </div>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary">Cerrar sesion</button>
                    </form>
                </div>
            </div>
        </header>

        <div class="sc-admin-content">
            @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
            {
                <div class="alert alert-warning sc-admin-alert">@Model.Mensaje</div>
            }

            <section class="sc-kpi-grid-primary">
                <article class="sc-kpi-card sc-kpi-emerald">
                    <div class="sc-kpi-icon"><i class="bi bi-cash-coin"></i></div>
                    <p>Ingresos hoy</p>
                    <h2>S/ @Model.IngresosHoy.ToString("N2")</h2>
                </article>
                <article class="sc-kpi-card sc-kpi-indigo">
                    <div class="sc-kpi-icon"><i class="bi bi-calendar-event"></i></div>
                    <p>Reservas hoy</p>
                    <h2>@Model.ReservasHoy</h2>
                </article>
                <article class="sc-kpi-card sc-kpi-cyan">
                    <div class="sc-kpi-icon"><i class="bi bi-pie-chart"></i></div>
                    <p>Ocupacion hoy</p>
                    <h2>@Model.OcupacionHoyPct.ToString("N2")%</h2>
                </article>
                <article class="sc-kpi-card sc-kpi-amber">
                    <div class="sc-kpi-icon"><i class="bi bi-graph-up"></i></div>
                    <p>Ticket promedio</p>
                    <h2>S/ @Model.TicketPromedioMes.ToString("N2")</h2>
                </article>
            </section>

            <section class="sc-kpi-grid-secondary">
                <article class="sc-mini-kpi">
                    <i class="bi bi-person-x"></i>
                    <div>
                        <p>No Asistio del mes</p>
                        <strong>@Model.NoShowMes</strong>
                    </div>
                </article>
                <article class="sc-mini-kpi">
                    <i class="bi bi-grid"></i>
                    <div>
                        <p>Espacios activos</p>
                        <strong>@Model.TotalEspacios</strong>
                    </div>
                </article>
                <article class="sc-mini-kpi">
                    <i class="bi bi-people-fill"></i>
                    <div>
                        <p>Clientes registrados</p>
                        <strong>--</strong>
                    </div>
                </article>
                <article class="sc-mini-kpi">
                    <i class="bi bi-hourglass-split"></i>
                    <div>
                        <p>Pendientes por confirmar</p>
                        <strong>--</strong>
                    </div>
                </article>
            </section>

            <section class="sc-activity-section">
                <div class="sc-section-head">
                    <h3>Actividad reciente</h3>
                    <p>Resumen rapido de eventos clave del negocio.</p>
                </div>
                <div class="sc-activity-list">
                    <article class="sc-activity-item">
                        <span class="dot dot-warning"></span>
                        <div>
                            <h5>Solicitudes pendientes</h5>
                            <p>Revisa el modulo de solicitudes para confirmar reservas publicas.</p>
                        </div>
                    </article>
                    <article class="sc-activity-item">
                        <span class="dot dot-success"></span>
                        <div>
                            <h5>Pagos del dia</h5>
                            <p>Ingresos acumulados hoy: <strong>S/ @Model.IngresosHoy.ToString("N2")</strong>.</p>
                        </div>
                    </article>
                    <article class="sc-activity-item">
                        <span class="dot dot-info"></span>
                        <div>
                            <h5>Ocupacion operativa</h5>
                            <p>Ocupacion actual del dia: <strong>@Model.OcupacionHoyPct.ToString("N2")%</strong>.</p>
                        </div>
                    </article>
                </div>
            </section>
        </div>
    </section>
