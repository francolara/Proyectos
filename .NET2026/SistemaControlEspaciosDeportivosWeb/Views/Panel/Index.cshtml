                                <th class="text-end">Cobrado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (topIngresosImpresion.Any())
                            {
                                @foreach (var item in topIngresosImpresion)
                                {
                                    <tr>
                                        <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td class="text-end">@Model.MonedaSimbolo @item.Valor.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2">Sin datos de cobro para el rango elegido.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </article>

                <article class="sc-report-print-panel">
