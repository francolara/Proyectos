@model SistemaControlEspaciosDeportivosWeb.ViewModels.PanelDashboardViewModel
@{
    ViewData["Title"] = "Panel administrativo";
    ViewData["AdminShell"] = true;
    ViewData["AdminNegocioId"] = Model.NegocioSeleccionadoId;

    var ocupacion = Math.Max(0m, Math.Min(100m, Model.OcupacionHoyPct));
    var saludOperativa = 100m;
    saludOperativa -= Math.Min(45m, Model.NoShowMes * 3m);
    saludOperativa -= ocupacion < 20m ? 20m : 0m;
    saludOperativa = Math.Max(5m, Math.Min(100m, saludOperativa));

    string SaludTexto(decimal valor) => valor >= 80m ? "Estable" : valor >= 55m ? "Atencion" : "Critico";
    string SaludClase(decimal valor) => valor >= 80m ? "sc-dash-badge-ok" : valor >= 55m ? "sc-dash-badge-warn" : "sc-dash-badge-danger";

    var maxIngreso = Model.SerieIngresosPorDia.Any() ? Math.Max(1m, Model.SerieIngresosPorDia.Max(x => x.Valor)) : 1m;
    var maxReserva = Model.SerieReservasPorDia.Any() ? Math.Max(1m, Model.SerieReservasPorDia.Max(x => x.Valor)) : 1m;
    var topMax = Model.TopEspacios.Any() ? Math.Max(1m, Model.TopEspacios.Max(x => x.Reservado)) : 1m;
    var negocioActual = Model.Negocios.FirstOrDefault(x => x.NegocioId == Model.NegocioSeleccionadoId);
    var negocioActualTexto = negocioActual is null
        ? $"Negocio #{Model.NegocioSeleccionadoId}"
        : $"{negocioActual.NombreNegocio} ({negocioActual.Rol})";
    var puedeCrearReserva = Model.Modulos.Any(x => string.Equals(x.ModuloCodigo, "RESERVAS", StringComparison.OrdinalIgnoreCase) && x.PuedeCrear);

    var acciones = new List<(string Label, string Icon, string Href)>
    {
        ("Nueva reserva", "bi-calendar-plus", Url.Action("Index", "Reservas", new { negocioId = Model.NegocioSeleccionadoId, abrirModal = "nueva" }) ?? "#"),
        ("Registrar pago", "bi-cash-coin", Url.Action("Create", "Pagos", new { negocioId = Model.NegocioSeleccionadoId }) ?? "#"),
        ("Emitir comprobante", "bi-receipt", Model.EsPlanBasico
            ? Url.Action("Index", "MiSuscripcion", new { negocioId = Model.NegocioSeleccionadoId }) ?? "#"
            : Url.Action("Create", "Comprobantes", new { negocioId = Model.NegocioSeleccionadoId }) ?? "#"),
        ("Ver reportes", "bi-bar-chart", Url.Action("Index", "Reportes", new { negocioId = Model.NegocioSeleccionadoId }) ?? "#")
    };

    (string Css, string Texto) Variacion(decimal actual, decimal anterior)
    {
        if (anterior <= 0m)
        {
            return actual > 0m
                ? ("sc-dash-var-up", "Nuevo")
                : ("sc-dash-var-flat", "Sin cambio");
        }

        var pct = ((actual - anterior) / anterior) * 100m;
        var etiqueta = $"{pct:+0.##;-0.##;0}%";
        return pct switch
        {
            > 0.01m => ("sc-dash-var-up", etiqueta),
            < -0.01m => ("sc-dash-var-down", etiqueta),
            _ => ("sc-dash-var-flat", etiqueta)
        };
    }

    var varIngresos = Variacion(Model.IngresosPeriodo, Model.IngresosPeriodoAnterior);
    var varReservas = Variacion(Model.ReservasPeriodo, Model.ReservasPeriodoAnterior);
    var varReservado = Variacion(Model.MontoReservadoPeriodo, Model.MontoReservadoPeriodoAnterior);
    var varOcupacion = Variacion(Model.OcupacionHoyPct, Model.OcupacionDiaAnteriorPct);
    var horasMediaHora = Enumerable.Range(0, 48)
        .Select(i => TimeOnly.MinValue.AddMinutes(i * 30))
        .ToList();
}

<section class="sc-dash-shell">
    <header class="sc-admin-topbar sc-dash-topbar">
        <div class="sc-admin-topbar-head">
            <div class="sc-dash-title-wrap">
                <div>
                    <h1>Dashboard ejecutivo</h1>
                    <p>Lectura separada de operacion y cobranza con filtros globales en tiempo real.</p>
                </div>
                <div class="sc-dash-negocio-card sc-dash-negocio-card-inline sc-dash-negocio-card--focus" aria-readonly="true">
                    <div class="sc-dash-negocio-card-focus-avatar" aria-hidden="true">
                        <i class="bi bi-building"></i>
                    </div>
                    <div class="sc-dash-negocio-card-focus-body">
                        <div class="sc-dash-negocio-card-head">
                            <span>Complejo deportivo</span>
                        </div>
                        <div class="sc-dash-negocio-card-name">@negocioActualTexto</div>
                        <div class="sc-dash-negocio-card-focus-note">
                            <span class="sc-dash-negocio-card-focus-idchip">ID #@Model.NegocioSeleccionadoId</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </header>

    <div class="sc-admin-content">
        @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
        {
            <div class="alert alert-warning sc-admin-alert">@Model.Mensaje</div>
        }

        <section class="sc-dash-filter-card">
            <form asp-action="Index" method="get" class="sc-dash-filter-grid">
                <input type="hidden" name="negocioId" value="@Model.NegocioSeleccionadoId" />
                <div>
                    <label for="sedeId">Sede</label>
                    <select id="sedeId" name="sedeId" class="form-select">
                        @foreach (var sede in Model.SedesFiltro)
                        {
                            <option value="@sede.Value" selected="@sede.Selected">@sede.Text</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="fechaDesde">Fecha desde</label>
                    <input id="fechaDesde" name="fechaDesde" type="date" class="form-control" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" />
                </div>
                <div>
                    <label for="fechaHasta">Fecha hasta</label>
                    <input id="fechaHasta" name="fechaHasta" type="date" class="form-control" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" />
                </div>
                <div class="sc-dash-filter-actions">
                    <button type="submit" class="btn btn-primary btn-accion-filtro">Aplicar</button>
                </div>
            </form>
        </section>

        <section class="sc-dash-actions">
            @for (var i = 0; i < acciones.Count; i++)
            {
                var accion = acciones[i];
                var esNuevaReserva = i == 0;
                <a href="@accion.Href"
                   class="sc-dash-action-link @(esNuevaReserva && !puedeCrearReserva ? "disabled" : string.Empty)"
                   data-accion-nueva-reserva="@(esNuevaReserva ? "1" : "0")">
                    <i class="bi @accion.Icon"></i>
                    <span>@accion.Label</span>
                </a>
            }
        </section>

        <h2 class="section-title mb-2"><i class="bi bi-cash-coin me-1 text-primary"></i>Vista comercial</h2>
        <section class="sc-dash-kpis">
            <article class="sc-dash-kpi-card">
                <div class="sc-dash-kpi-head">
                    <div class="sc-dash-kpi-label">Cobrado del periodo</div>
                    <span class="sc-dash-var @varIngresos.Css">@varIngresos.Texto</span>
                </div>
                <div class="sc-dash-kpi-value">@Model.MonedaSimbolo @Model.IngresosPeriodo.ToString("N2")</div>
                <div class="sc-dash-kpi-foot">Previo: @Model.MonedaSimbolo @Model.IngresosPeriodoAnterior.ToString("N2")</div>
            </article>
            <article class="sc-dash-kpi-card">
                <div class="sc-dash-kpi-head">
                    <div class="sc-dash-kpi-label">Reservas del periodo</div>
                    <span class="sc-dash-var @varReservas.Css">@varReservas.Texto</span>
                </div>
                <div class="sc-dash-kpi-value">@Model.ReservasPeriodo</div>
                <div class="sc-dash-kpi-foot">Previo: @Model.ReservasPeriodoAnterior</div>
            </article>
            <article class="sc-dash-kpi-card">
                <div class="sc-dash-kpi-head">
                    <div class="sc-dash-kpi-label">Reservado del periodo</div>
                    <span class="sc-dash-var @varReservado.Css">@varReservado.Texto</span>
                </div>
                <div class="sc-dash-kpi-value">@Model.MonedaSimbolo @Model.MontoReservadoPeriodo.ToString("N2")</div>
                <div class="sc-dash-kpi-foot">Previo: @Model.MonedaSimbolo @Model.MontoReservadoPeriodoAnterior.ToString("N2")</div>
            </article>
            <article class="sc-dash-kpi-card">
                <div class="sc-dash-kpi-head">
                    <div class="sc-dash-kpi-label">Ticket de cobranza</div>
                </div>
                <div class="sc-dash-kpi-value">@Model.MonedaSimbolo @Model.TicketPromedioPeriodo.ToString("N2")</div>
                <div class="sc-dash-kpi-foot">Pagos: @Model.PagosPeriodo | Reservas cobradas: @Model.ReservasCobradasPeriodo</div>
            </article>
            <article class="sc-dash-kpi-card">
                <div class="sc-dash-kpi-head">
                    <div class="sc-dash-kpi-label">Ocupacion del dia</div>
                    <span class="sc-dash-var @varOcupacion.Css">@varOcupacion.Texto</span>
                </div>
                <div class="sc-dash-kpi-value">@Model.OcupacionHoyPct.ToString("N2")%</div>
                <div class="sc-dash-progress">
                    <span style="width:@ocupacion.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                </div>
            </article>
        </section>

        <h2 class="section-title mb-2 mt-3"><i class="bi bi-clipboard2-pulse me-1 text-primary"></i>Lectura operativa</h2>
        <section class="sc-dash-grid">
            <article class="sc-dash-panel">
                <div class="sc-dash-panel-head">
                    <h3><i class="bi bi-graph-up-arrow me-1"></i>Cobros por fecha de pago</h3>
                    <p>Cada barra representa monto cobrado por fecha real de pago.</p>
                </div>
                @if (Model.SerieIngresosPorDia.Any())
                {
                    <div class="sc-dash-bars">
                        @foreach (var item in Model.SerieIngresosPorDia.OrderBy(x => x.Fecha))
                        {
                            var height = Math.Max(8m, Math.Round((item.Valor / maxIngreso) * 100m, 2));
                            <div class="sc-dash-bar-col" title="@($"{item.Fecha:dd/MM}: {Model.MonedaSimbolo} {item.Valor:N2}")">
                                <div class="sc-dash-bar-track">
                                    <div class="sc-dash-bar-fill" style="height:@height.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                                <small>@item.Fecha.ToString("dd/MM")</small>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted">Sin datos para el rango elegido.</div>
                }
            </article>

            <article class="sc-dash-panel">
                <div class="sc-dash-panel-head">
                    <h3><i class="bi bi-calendar-check me-1"></i>Reservas por fecha de juego</h3>
                    <p>Conteo diario de reservas para evaluar demanda operativa.</p>
                </div>
                @if (Model.SerieReservasPorDia.Any())
                {
                    <div class="sc-dash-line-list">
                        @foreach (var item in Model.SerieReservasPorDia.OrderBy(x => x.Fecha))
                        {
                            var width = Math.Max(4m, Math.Round((item.Valor / maxReserva) * 100m, 2));
                            <div class="sc-dash-line-item">
                                <span>@item.Fecha.ToString("dd/MM")</span>
                                <div class="sc-dash-line-track">
                                    <div class="sc-dash-line-fill" style="width:@width.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                                <strong>@item.Valor.ToString("N0")</strong>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted">Sin datos para el rango elegido.</div>
                }
            </article>
        </section>

        <section class="sc-dash-grid">
            <article class="sc-dash-panel">
                <div class="sc-dash-panel-head">
                    <h3><i class="bi bi-trophy me-1"></i>Top espacios por demanda</h3>
                    <p>Ranking operativo con referencia de reservado y cobrado asociado.</p>
                </div>
                @if (Model.TopEspacios.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle sc-dash-table">
                            <thead>
                            <tr>
                                <th>Sede</th>
                                <th>Espacio</th>
                                <th class="text-end">Reservas</th>
                                <th class="text-end">Horas</th>
                                <th class="text-end">Reservado</th>
                                <th class="text-end">Cobrado asociado</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model.TopEspacios)
                            {
                                var width = Math.Max(5m, Math.Round((item.Reservado / topMax) * 100m, 2));
                                <tr>
                                    <td>@item.Sede</td>
                                    <td>
                                        <div>@item.Espacio</div>
                                        <div class="sc-dash-mini-progress"><span style="width:@width.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                                    </td>
                                    <td class="text-end">@item.Reservas</td>
                                    <td class="text-end">@item.Horas.ToString("N2")</td>
                                    <td class="text-end">@Model.MonedaSimbolo @item.Reservado.ToString("N2")</td>
                                    <td class="text-end">@Model.MonedaSimbolo @item.Cobrado.ToString("N2")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted">No hay espacios con actividad en el rango.</div>
                }
            </article>

            <article class="sc-dash-panel">
                <div class="sc-dash-panel-head">
                    <h3><i class="bi bi-heart-pulse me-1"></i>Salud operativa</h3>
                    <p>Variables clave para el turno actual.</p>
                </div>
                <div class="sc-dash-health-list">
                    <div class="sc-dash-health-item">
                        <span>Salud general</span>
                        <strong><span class="sc-dash-badge @SaludClase(saludOperativa)">@SaludTexto(saludOperativa) (@saludOperativa.ToString("N0")%)</span></strong>
                    </div>
                    <div class="sc-dash-health-item">
                        <span>No-show del mes</span>
                        <strong>@Model.NoShowMes</strong>
                    </div>
                    <div class="sc-dash-health-item">
                        <span>Sedes activas</span>
                        <strong>@Model.TotalSedes</strong>
                    </div>
                    <div class="sc-dash-health-item">
                        <span>Espacios activos</span>
                        <strong>@Model.TotalEspacios</strong>
                    </div>
                    <div class="sc-dash-health-item">
                        <span>Ingresos hoy</span>
                        <strong>@Model.MonedaSimbolo @Model.IngresosHoy.ToString("N2")</strong>
                    </div>
                </div>
            </article>
        </section>

        <section class="sc-dash-grid">
            <article class="sc-dash-panel">
                <div class="sc-dash-panel-head">
                    <h3><i class="bi bi-hourglass-split me-1"></i>Reservas por confirmar (proximas 48h)</h3>
                    <p>Acciones inmediatas para no perder ocupacion.</p>
                </div>
                @if (Model.ReservasPendientesConfirmacion.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle sc-dash-table">
                            <thead>
                            <tr>
                                <th>Reserva</th>
                                <th>Cliente</th>
                                <th>Sede / Espacio</th>
                                <th>Horario</th>
                                <th>Estado</th>
                                <th class="text-end">Accion</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model.ReservasPendientesConfirmacion)
                            {
                                <tr>
                                    <td>@item.ReservaCodigo</td>
                                    <td>@item.Cliente</td>
                                    <td>@item.Sede / @item.Espacio</td>
                                    <td>@item.Fecha.ToString("dd/MM") @item.HoraInicio.ToString("HH\\:mm") - @item.HoraFin.ToString("HH\\:mm")</td>
                                    <td>@item.Estado</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", "Reservas", new { negocioId = Model.NegocioSeleccionadoId, abrirModal = "editar", reservaId = item.ReservaId })">Ver</a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted">No hay reservas pendientes para las proximas 48 horas.</div>
                }
            </article>

            <article class="sc-dash-panel">
                <div class="sc-dash-panel-head">
                    <h3><i class="bi bi-cash-coin me-1"></i>Reservas con saldo pendiente</h3>
                    <p>Prioriza cobranza y cierre de caja.</p>
                </div>
                @if (Model.ReservasConSaldoPendiente.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle sc-dash-table">
                            <thead>
                            <tr>
                                <th>Reserva</th>
                                <th>Cliente</th>
                                <th>Fecha</th>
                                <th class="text-end">Monto</th>
                                <th class="text-end">Saldo</th>
                                <th class="text-end">Accion</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model.ReservasConSaldoPendiente)
                            {
                                <tr>
                                    <td>@item.ReservaCodigo</td>
                                    <td>@item.Cliente</td>
                                    <td>@item.Fecha.ToString("dd/MM")</td>
                                    <td class="text-end">@Model.MonedaSimbolo @item.MontoTotal.ToString("N2")</td>
                                    <td class="text-end">@Model.MonedaSimbolo @item.SaldoPendiente.ToString("N2")</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-cobrar" href="@Url.Action("Edit", "Pagos", new { id = item.ReservaId, negocioId = Model.NegocioSeleccionadoId })">
                                            <i class="bi bi-cash-coin me-1"></i>Cobrar
                                        </a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted">No hay saldos pendientes dentro del rango.</div>
                }
            </article>
        </section>

        <div class="modal fade" id="dashboardReservaModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content sc-modal-content">
                    <div class="modal-header sc-modal-header">
                        <div class="sc-modal-title-wrap">
                            <h5 class="modal-title sc-modal-title">Nueva reserva</h5>
                            <p class="sc-modal-subtitle">Registra una reserva manual sin salir del panel operativo del negocio.</p>
                        </div>
                        <button type="button" class="btn-close sc-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <form id="dashboardReservaForm" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-body sc-modal-body">
                            <input type="hidden" name="Id" value="0" />
                            <input type="hidden" name="NegocioId" value="@Model.NegocioSeleccionadoId" />
                            <input type="hidden" id="dashModalClienteId" name="ClienteId" value="" />
                            <div id="dashModalError" class="alert alert-danger d-none py-2"></div>
                            <div id="dashModalDisponibilidad" class="alert d-none py-2"></div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="dashModalEspacioId">Espacio</label>
                                    <select class="form-select" id="dashModalEspacioId" name="EspacioDeportivoId" required>
                                        <option value="">Cargando...</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="dashModalClienteBuscar">Cliente</label>
                                    <input type="text" class="form-control" id="dashModalClienteBuscar" placeholder="Escribe y presiona Enter..." autocomplete="off" />
                                    <select class="form-select mt-2" id="dashModalClienteResultados" size="5" aria-label="Resultados de clientes">
                                        <option value="">Sin resultados</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="dashModalFecha">Fecha</label>
                                    <input type="date" class="form-control" id="dashModalFecha" name="Fecha" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="dashModalHoraInicio">Hora inicio</label>
                                    <select class="form-select" id="dashModalHoraInicio" name="HoraInicio" required>
                                        @foreach (var hora in horasMediaHora)
                                        {
                                            <option value="@hora.ToString("HH\\:mm")" selected="@(hora == new TimeOnly(18, 0) ? "selected" : null)">@hora.ToString("HH\\:mm")</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="dashModalHoraFin">Hora fin</label>
                                    <select class="form-select" id="dashModalHoraFin" name="HoraFin" required>
                                        @foreach (var hora in horasMediaHora)
                                        {
                                            <option value="@hora.ToString("HH\\:mm")" selected="@(hora == new TimeOnly(19, 0) ? "selected" : null)">@hora.ToString("HH\\:mm")</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="dashModalTotal">Precio de espacio (@Model.MonedaSimbolo)</label>
                                    <input type="number" min="0.01" step="0.01" class="form-control" id="dashModalTotal" name="Total" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="dashModalComentario">Comentario</label>
                                    <input type="text" class="form-control" id="dashModalComentario" name="Comentario" maxlength="500" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary btn-grabar" id="dashModalGuardarBtn">Guardar reserva</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const puedeCrearReserva = @puedeCrearReserva.ToString().ToLowerInvariant();
            const negocioId = @Model.NegocioSeleccionadoId;
            const hoyIso = new Date().toISOString().slice(0, 10);
            const sedeFiltroEl = document.getElementById('sedeId');
            const nuevaReservaLink = document.querySelector('[data-accion-nueva-reserva="1"]');
            const modalEl = document.getElementById('dashboardReservaModal');
            const formEl = document.getElementById('dashboardReservaForm');
            const errorEl = document.getElementById('dashModalError');
            const disponibilidadEl = document.getElementById('dashModalDisponibilidad');
            const espacioEl = document.getElementById('dashModalEspacioId');
            const clienteBuscarEl = document.getElementById('dashModalClienteBuscar');
            const clienteResultadosEl = document.getElementById('dashModalClienteResultados');
            const clienteIdEl = document.getElementById('dashModalClienteId');
            const fechaEl = document.getElementById('dashModalFecha');
            const horaInicioEl = document.getElementById('dashModalHoraInicio');
            const horaFinEl = document.getElementById('dashModalHoraFin');
            const totalEl = document.getElementById('dashModalTotal');
            const guardarBtn = document.getElementById('dashModalGuardarBtn');
            const modal = modalEl ? new bootstrap.Modal(modalEl) : null;

            const urlEspacios = '@Url.Action("ObtenerEspaciosReserva", "Panel")';
            const urlClientes = '@Url.Action("ObtenerClientesFiltro", "Reservas")';
            const urlCotizar = '@Url.Action("CotizarReserva", "Reservas")';
            const urlValidar = '@Url.Action("ValidarDisponibilidadModal", "Reservas")';
            const urlGuardar = '@Url.Action("GuardarReservaModal", "Reservas")';

            function limpiarMensajes() {
                if (!errorEl || !disponibilidadEl) return;
                errorEl.classList.add('d-none');
                errorEl.textContent = '';
                disponibilidadEl.classList.add('d-none');
                disponibilidadEl.classList.remove('alert-success', 'alert-warning');
                disponibilidadEl.textContent = '';
            }

            function mostrarError(msg) {
                if (!errorEl) return;
                errorEl.textContent = msg || 'No se pudo guardar la reserva.';
                errorEl.classList.remove('d-none');
            }

            function mostrarDisponibilidad(disponible, mensaje) {
                if (!disponibilidadEl) return;
                disponibilidadEl.classList.remove('d-none');
                disponibilidadEl.classList.toggle('alert-success', !!disponible);
                disponibilidadEl.classList.toggle('alert-warning', !disponible);
                disponibilidadEl.textContent = mensaje || (disponible ? 'Horario disponible.' : 'Horario no disponible.');
                if (guardarBtn) guardarBtn.disabled = !disponible;
            }

            async function cargarEspacios() {
                if (!espacioEl) return;
                const params = new URLSearchParams();
                params.append('negocioId', String(negocioId));
                const sedeId = (sedeFiltroEl?.value || '').trim();
                if (sedeId) params.append('sedeId', sedeId);
                const r = await fetch(`${urlEspacios}?${params.toString()}`, { cache: 'no-store' });
                const payload = await r.json();
                if (!r.ok || !payload.ok) {
                    throw new Error(payload.mensaje || 'No se pudieron cargar los espacios.');
                }

                espacioEl.innerHTML = '<option value="">Selecciona espacio</option>';
                (payload.items || []).forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = String(item.value ?? '');
                    opt.textContent = String(item.text ?? '');
                    espacioEl.appendChild(opt);
                });
            }

            async function buscarClientes() {
                const filtro = String(clienteBuscarEl?.value || '').trim();
                if (filtro.length < 2) {
                    mostrarError('Escribe al menos 2 caracteres para buscar cliente.');
                    return;
                }
                limpiarMensajes();
                const params = new URLSearchParams();
                params.append('negocioId', String(negocioId));
                params.append('buscar', filtro);
                const r = await fetch(`${urlClientes}?${params.toString()}`, { cache: 'no-store' });
                const payload = await r.json();
                if (!r.ok || !payload.ok) {
                    throw new Error(payload.mensaje || 'No se pudo buscar clientes.');
                }

                clienteResultadosEl.innerHTML = '';
                (payload.items || []).forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = String(item.value ?? '');
                    opt.textContent = String(item.text ?? '');
                    clienteResultadosEl.appendChild(opt);
                });
                if (!clienteResultadosEl.options.length) {
                    clienteResultadosEl.innerHTML = '<option value="">Sin resultados</option>';
                }
            }

            async function cotizar() {
                const espacioId = espacioEl?.value || '';
                const fecha = fechaEl?.value || '';
                const horaInicio = horaInicioEl?.value || '';
                const horaFin = horaFinEl?.value || '';
                if (!espacioId || !fecha || !horaInicio || !horaFin) return;

                const params = new URLSearchParams();
                params.append('negocioId', String(negocioId));
                params.append('espacioDeportivoId', espacioId);
                params.append('fecha', fecha);
                params.append('horaInicio', horaInicio);
                params.append('horaFin', horaFin);
                const r = await fetch(`${urlCotizar}?${params.toString()}`, { cache: 'no-store' });
                const payload = await r.json();
                if (!r.ok || !payload.ok) {
                    throw new Error(payload.mensaje || 'No se pudo cotizar la reserva.');
                }
                if (totalEl && (!totalEl.value || Number(totalEl.value) <= 0)) {
                    totalEl.value = Number(payload.precioFinal || 0).toFixed(2);
                }
            }

            async function validarDisponibilidad() {
                const espacioId = espacioEl?.value || '';
                const fecha = fechaEl?.value || '';
                const horaInicio = horaInicioEl?.value || '';
                const horaFin = horaFinEl?.value || '';
                if (!espacioId || !fecha || !horaInicio || !horaFin) return;

                const params = new URLSearchParams();
                params.append('negocioId', String(negocioId));
                params.append('espacioDeportivoId', espacioId);
                params.append('fecha', fecha);
                params.append('horaInicio', horaInicio);
                params.append('horaFin', horaFin);
                const r = await fetch(`${urlValidar}?${params.toString()}`, { cache: 'no-store' });
                const payload = await r.json();
                if (!r.ok || !payload.ok) {
                    throw new Error(payload.mensaje || 'No se pudo validar disponibilidad.');
                }
                mostrarDisponibilidad(!!payload.disponible, payload.mensaje || '');
            }

            async function abrirModalNuevaReserva() {
                if (!puedeCrearReserva) {
                    alert('No tienes permiso para crear reservas.');
                    return;
                }

                limpiarMensajes();
                clienteIdEl.value = '';
                clienteBuscarEl.value = '';
                clienteResultadosEl.innerHTML = '<option value="">Sin resultados</option>';
                fechaEl.value = hoyIso;
                fechaEl.min = hoyIso;
                totalEl.value = '';
                if (guardarBtn) guardarBtn.disabled = false;
                await cargarEspacios();
                modal?.show();
            }

            if (nuevaReservaLink && (nuevaReservaLink.getAttribute('href') || '#') === '#') {
                nuevaReservaLink.addEventListener('click', async (e) => {
                    e.preventDefault();
                    try {
                        await abrirModalNuevaReserva();
                    } catch (err) {
                        mostrarError(err?.message || 'No se pudo abrir el formulario de reserva.');
                    }
                });
            }

            if (sedeFiltroEl) {
                sedeFiltroEl.addEventListener('change', () => {
                    if (modalEl?.classList.contains('show')) {
                        cargarEspacios().catch(err => mostrarError(err?.message));
                    }
                });
            }

            if (clienteBuscarEl) {
                clienteBuscarEl.addEventListener('keydown', (e) => {
                    if (e.key !== 'Enter') return;
                    e.preventDefault();
                    buscarClientes().catch(err => mostrarError(err?.message));
                });
            }

            if (clienteResultadosEl) {
                clienteResultadosEl.addEventListener('change', () => {
                    const selected = clienteResultadosEl.selectedOptions?.[0];
                    if (!selected?.value) return;
                    clienteIdEl.value = selected.value;
                    clienteBuscarEl.value = selected.text || '';
                });
            }

            [espacioEl, fechaEl, horaInicioEl, horaFinEl].forEach(el => {
                if (!el) return;
                el.addEventListener('change', () => {
                    limpiarMensajes();
                    cotizar().catch(err => mostrarError(err?.message));
                    validarDisponibilidad().catch(err => mostrarError(err?.message));
                });
            });

            if (formEl) {
                formEl.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    try {
                        limpiarMensajes();
                        if (!clienteIdEl.value) {
                            mostrarError('Selecciona un cliente de la lista.');
                            return;
                        }

                        const data = new FormData(formEl);
                        const r = await fetch(urlGuardar, { method: 'POST', body: data });
                        const payload = await r.json();
                        if (!r.ok || !payload.ok) {
                            throw new Error(payload.mensaje || 'No se pudo guardar la reserva.');
                        }

                        modal?.hide();
                        window.location.reload();
                    } catch (err) {
                        mostrarError(err?.message || 'No se pudo guardar la reserva.');
                    }
                });
            }
        })();
    </script>
}
