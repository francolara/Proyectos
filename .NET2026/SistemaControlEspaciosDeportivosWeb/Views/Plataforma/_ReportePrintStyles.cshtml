@* Firma: FRANCO LARA - 21/07/2026 | Estilos compartidos para reportes HTML imprimibles del Super Admin. *@
<style>
    :root {
        --report-ink: #172033;
        --report-muted: #64748b;
        --report-line: #d9e2ee;
        --report-soft: #f3f6fa;
        --report-navy: #123a63;
        --report-blue: #1d67b1;
        --report-green: #177a55;
        --report-red: #b42318;
        --report-amber: #a45b08;
    }

    * { box-sizing: border-box; }
    html, body { margin: 0; background: #e8edf4; color: var(--report-ink); font-family: "Segoe UI", Tahoma, sans-serif; font-size: 12px; }
    .print-toolbar { position: sticky; top: 0; z-index: 20; display: flex; justify-content: flex-end; gap: 10px; padding: 12px 24px; background: #101d31; box-shadow: 0 8px 24px rgba(16, 29, 49, .2); }
    .print-toolbar button { border: 0; border-radius: 7px; padding: 9px 16px; background: var(--report-blue); color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
    .print-toolbar button.secondary { background: #fff; color: #243654; }
    .report-document { width: min(1180px, calc(100% - 32px)); margin: 24px auto; background: #fff; box-shadow: 0 18px 54px rgba(28, 42, 66, .18); }
    .report-page { padding: 14mm; }
    .report-header { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: start; padding-bottom: 14px; border-bottom: 3px solid var(--report-navy); }
    .report-eyebrow, .section-kicker { display: block; color: var(--report-blue); font-size: 9px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
    h1 { margin: 4px 0 0; color: var(--report-navy); font-size: 25px; line-height: 1.12; }
    .report-header p { margin: 6px 0 0; color: var(--report-muted); }
    .report-issue { min-width: 220px; padding: 11px 14px; border: 1px solid #bfd0e4; background: var(--report-soft); }
    .report-issue span { display: block; color: var(--report-muted); font-size: 9px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .report-issue strong { display: block; margin: 3px 0 8px; color: var(--report-navy); }
    .metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 9px; margin: 16px 0; }
    .metric { min-height: 72px; padding: 10px; border: 1px solid var(--report-line); border-top: 3px solid var(--report-blue); background: linear-gradient(180deg, #fff, #f7f9fc); }
    .metric.green { border-top-color: var(--report-green); }
    .metric.amber { border-top-color: var(--report-amber); }
    .metric.red { border-top-color: var(--report-red); }
    .metric span { display: block; color: var(--report-muted); font-size: 9px; font-weight: 800; text-transform: uppercase; }
    .metric strong { display: block; margin: 6px 0 2px; color: var(--report-navy); font-size: 17px; }
    .metric small { color: var(--report-muted); }
    .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin: 20px 0 9px; padding-bottom: 8px; border-bottom: 2px solid var(--report-navy); }
    .section-heading h2 { margin: 3px 0 0; color: var(--report-navy); font-size: 17px; }
    .section-heading p { margin: 0; color: var(--report-muted); text-align: right; }
    .info-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--report-line); }
    .info-item { min-height: 58px; padding: 9px 11px; border-right: 1px solid var(--report-line); border-bottom: 1px solid var(--report-line); }
    .info-item span { display: block; color: var(--report-muted); font-size: 9px; font-weight: 700; text-transform: uppercase; }
    .info-item strong { display: block; margin-top: 4px; color: var(--report-navy); }
    table { width: 100%; border-collapse: collapse; }
    thead { display: table-header-group; }
    tr { break-inside: avoid; page-break-inside: avoid; }
    th, td { padding: 6px 7px; border-bottom: 1px solid var(--report-line); vertical-align: top; }
    thead th { background: var(--report-navy); color: #fff; font-size: 8px; letter-spacing: .035em; text-align: left; text-transform: uppercase; }
    tbody tr:nth-child(even) { background: #f7f9fc; }
    td { font-size: 9px; }
    .text-end { text-align: right; }
    .text-center { text-align: center; }
    .nowrap { white-space: nowrap; }
    .muted { color: var(--report-muted); }
    .strong { color: var(--report-navy); font-weight: 700; }
    .status { display: inline-block; padding: 2px 6px; border-radius: 999px; background: #e8eef7; color: var(--report-navy); font-size: 8px; font-weight: 800; }
    .status.ok { background: #dcfce7; color: #166534; }
    .status.warn { background: #fef3c7; color: #92400e; }
    .status.bad { background: #fee2e2; color: #991b1b; }
    .empty { padding: 28px; border: 1px dashed #b8c6d8; color: var(--report-muted); text-align: center; }
    .report-footer { display: flex; justify-content: space-between; margin-top: 12px; padding-top: 8px; border-top: 1px solid var(--report-line); color: var(--report-muted); font-size: 8px; }
    .page-break { break-before: page; page-break-before: always; }

    @@page { size: A4 landscape; margin: 9mm; }
    @@media (max-width: 760px) {
        .report-document { width: 100%; margin: 0; }
        .report-page { padding: 20px; }
        .report-header { grid-template-columns: 1fr; }
        .metrics, .info-grid { grid-template-columns: 1fr 1fr; }
        .report-issue { min-width: 0; }
    }
    @@media print {
        html, body { background: #fff; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
        .print-toolbar { display: none !important; }
        .report-document { width: auto; margin: 0; box-shadow: none; }
        .report-page { padding: 0; }
        .metric, .info-grid, .info-item { break-inside: avoid; page-break-inside: avoid; }
    }
</style>
