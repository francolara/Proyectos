@model SistemaControlEspaciosDeportivosWeb.ViewModels.PlataformaPortalConfigViewModel
@{
    ViewData["Title"] = "Portal web";
}
@* Firma: FRANCO LARA - 09/05/2026 | Ajuste de etiquetas en Super Admin para reemplazar Club/Negocio por Complejo deportivo. *@
<div class="page-header-card mb-3">
    <div class="page-header-main">
        <h1 class="page-title">Configuracion del portal web</h1>
        <p class="page-subtitle">Administra el bloque CTA verde y la barra final de contacto/redes del Home.</p>
    </div>
</div>

@if (TempData["PortalWebOk"] is string ok && !string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success">@ok</div>
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<form asp-controller="Plataforma" asp-action="PortalWebGuardar" method="post" novalidate class="table-card sc-reservas-list-card p-3">
    @Html.AntiForgeryToken()

    <h2 class="section-title mb-3 platform-card-title"><span class="platform-card-icon"><i class="bi bi-grid-3x3-gap"></i></span><span class="platform-card-title-text">Seccion beneficios (6 tarjetas fijas)</span></h2>
    <div class="row g-3 mb-4">
        <div class="col-lg-7">
            <label class="form-label">Titulo global de beneficios</label>
            <input asp-for="BeneficiosTitulo" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-5">
            <label class="form-label">Subtitulo global de beneficios</label>
            <input asp-for="BeneficiosSubtitulo" class="form-control" maxlength="500" />
        </div>

        <div class="col-lg-4">
            <label class="form-label">Tarjeta 1 titulo</label>
            <input asp-for="Beneficio1Titulo" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-8">
            <label class="form-label">Tarjeta 1 detalle</label>
            <input asp-for="Beneficio1Detalle" class="form-control" maxlength="500" />
        </div>

        <div class="col-lg-4">
            <label class="form-label">Tarjeta 2 titulo</label>
            <input asp-for="Beneficio2Titulo" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-8">
            <label class="form-label">Tarjeta 2 detalle</label>
            <input asp-for="Beneficio2Detalle" class="form-control" maxlength="500" />
        </div>

        <div class="col-lg-4">
            <label class="form-label">Tarjeta 3 titulo</label>
            <input asp-for="Beneficio3Titulo" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-8">
            <label class="form-label">Tarjeta 3 detalle</label>
            <input asp-for="Beneficio3Detalle" class="form-control" maxlength="500" />
        </div>

        <div class="col-lg-4">
            <label class="form-label">Tarjeta 4 titulo</label>
            <input asp-for="Beneficio4Titulo" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-8">
            <label class="form-label">Tarjeta 4 detalle</label>
            <input asp-for="Beneficio4Detalle" class="form-control" maxlength="500" />
        </div>

        <div class="col-lg-4">
            <label class="form-label">Tarjeta 5 titulo</label>
            <input asp-for="Beneficio5Titulo" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-8">
            <label class="form-label">Tarjeta 5 detalle</label>
            <input asp-for="Beneficio5Detalle" class="form-control" maxlength="500" />
        </div>

        <div class="col-lg-4">
            <label class="form-label">Tarjeta 6 titulo</label>
            <input asp-for="Beneficio6Titulo" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-8">
            <label class="form-label">Tarjeta 6 detalle</label>
            <input asp-for="Beneficio6Detalle" class="form-control" maxlength="500" />
        </div>
    </div>

    <h2 class="section-title mb-3 platform-card-title"><span class="platform-card-icon"><i class="bi bi-megaphone"></i></span><span class="platform-card-title-text">Bloque CTA</span></h2>
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <label class="form-label">Titulo CTA</label>
            <input asp-for="CtaTitulo" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-4">
            <label class="form-label">Texto boton complejo deportivo</label>
            <input asp-for="CtaBotonClubTexto" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-8">
            <label class="form-label">Subtitulo CTA</label>
            <input asp-for="CtaSubtitulo" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-4">
            <label class="form-label">URL boton complejo deportivo</label>
            <input asp-for="CtaBotonClubUrl" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-6">
            <label class="form-label">Texto boton usuario</label>
            <input asp-for="CtaBotonUsuarioTexto" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-6">
            <label class="form-label">URL boton usuario</label>
            <input asp-for="CtaBotonUsuarioUrl" class="form-control" maxlength="500" />
        </div>
    </div>

    <h2 class="section-title mb-3 platform-card-title"><span class="platform-card-icon"><i class="bi bi-layout-text-window-reverse"></i></span><span class="platform-card-title-text">Barra final del portal</span></h2>
    <div class="row g-3">
        <div class="col-lg-4">
            <label class="form-label">Marca / titulo</label>
            <input asp-for="MarcaTitulo" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-8">
            <label class="form-label">Descripcion de marca</label>
            <input asp-for="MarcaDescripcion" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-6">
            <label class="form-label">Correo de contacto</label>
            <input asp-for="ContactoEmail" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-6">
            <label class="form-label">Telefono de contacto</label>
            <input asp-for="ContactoTelefono" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-4">
            <label class="form-label">Facebook URL</label>
            <input asp-for="SiguenosFacebookUrl" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-4">
            <label class="form-label">Instagram URL</label>
            <input asp-for="SiguenosInstagramUrl" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-4">
            <label class="form-label">WhatsApp URL</label>
            <input asp-for="SiguenosWhatsappUrl" class="form-control" maxlength="500" />
        </div>
    </div>

    <h2 class="section-title mt-4 mb-3 platform-card-title"><span class="platform-card-icon"><i class="bi bi-bell"></i></span><span class="platform-card-title-text">Notificaciones</span></h2>
    <div class="row g-3">
        <div class="col-lg-6">
            <label class="form-label">Correo de notificacion 1</label>
            <input asp-for="NotificacionCorreo1" class="form-control" maxlength="500" />
        </div>
        <div class="col-lg-6">
            <label class="form-label">Correo de notificacion 2</label>
            <input asp-for="NotificacionCorreo2" class="form-control" maxlength="500" />
        </div>
    </div>

    <div class="d-flex justify-content-end mt-4">
        <button type="submit" class="btn btn-primary btn-grabar px-4">
            <i class="bi bi-save me-1"></i>Guardar configuracion
        </button>
    </div>
</form>

