                                                    <label class="form-label">Motivo de suspension</label>
                                                    <select name="motivo" class="form-select" required>
                                                        <option value="">Seleccionar motivo</option>
                                                        <option value="FALTA_PAGO">Falta de pago</option>
                                                        <option value="SOLICITUD_CLIENTE">Solicitud del cliente</option>
                                                        <option value="INCUMPLIMIENTO">Incumplimiento</option>
                                                        <option value="MANTENIMIENTO_ADMINISTRATIVO">Mantenimiento administrativo</option>
                                                        <option value="OTRO">Otro</option>
                                                    </select>
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label">Observacion</label>
                                                    <textarea name="observacion" maxlength="500" rows="3" class="form-control" placeholder="Detalle de la suspension"></textarea>
                                                </div>
                                                <div class="col-12 platform-negocio-form-actions">
                                                    <button type="button" class="btn btn-outline-secondary btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-danger"><i class="bi bi-pause-circle me-1"></i>Suspender servicio</button>
                                                </div>
                                            </form>
                                        }
                                        else
                                        {
                                            <div class="alert alert-info mb-0">Este complejo no tiene una prueba o contrato activo para suspender. Primero debes regularizar su vigencia desde Gestion de contrato.</div>
                                        }

                                        @if (item.Activo)
