                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="negocioId" value="@item.NegocioId" />
                                                <input type="hidden" name="buscar" value="@Model.Buscar" />
                                                <input type="hidden" name="estadoContrato" value="@Model.EstadoContrato" />
                                                <input type="hidden" name="pagina" value="@Model.Pagina" />
