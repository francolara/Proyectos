                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Periodicidad</label>
                                                    <select name="tipoCobroObjetivo" class="form-select js-periodicidad" data-periodicidad-actual="@item.TipoCobro">
                                                        <option value="MENSUAL" selected="@(item.TipoCobro == "MENSUAL" ? "selected" : null)">Mensual</option>
                                                        <option value="TRIMESTRAL" selected="@(item.TipoCobro == "TRIMESTRAL" ? "selected" : null)">Trimestral</option>
                                                        <option value="SEMESTRAL" selected="@(item.TipoCobro == "SEMESTRAL" ? "selected" : null)">Semestral</option>
                                                        <option value="ANUAL" selected="@(item.TipoCobro == "ANUAL" ? "selected" : null)">Anual</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label">Inicio objetivo</label>
                                                    <input type="date" name="fechaInicioPlanObjetivo" class="form-control" value="@fechaInicioObjetivoDefault.ToString("yyyy-MM-dd")" />
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label">Dias de gracia</label>
                                                    <input type="number" min="0" max="30" name="diasGraciaObjetivo" value="@item.DiasGracia" class="form-control" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Sedes permitidas</label>
                                                    <input type="number" min="1" name="sedesPermitidasObjetivo" value="@item.SedesPermitidas" class="form-control js-limite-sedes" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Espacios permitidos</label>
                                                    <input type="number" min="1" name="espaciosPermitidosObjetivo" value="@item.EspaciosPermitidos" class="form-control js-limite-espacios" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Usuarios permitidos</label>
                                                    <input type="number" min="1" name="usuariosPermitidosObjetivo" value="@item.UsuariosPermitidos" class="form-control js-limite-usuarios" />
                                                </div>
                                                <div class="col-12 platform-negocio-form-actions">
                                                    <button type="button" class="btn btn-outline-secondary btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-primary btn-grabar">Guardar cobro</button>
                                                </div>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="RegistrarPagoSuscripcionNegocio" method="post" class="row g-2 border rounded-3 p-3 bg-light-subtle js-cobro-suscripcion-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="negocioId" value="@item.NegocioId" />
                                                <input type="hidden" name="buscar" value="@Model.Buscar" />
                                                <input type="hidden" name="estadoContrato" value="@Model.EstadoContrato" />
                                                <input type="hidden" name="pagina" value="@Model.Pagina" />
                                                <input type="hidden" name="accionAplicacion" value="ACTIVACION_CONTRATO" />
                                                <div class="col-12">
                                                    <div class="fw-semibold text-primary">Registrar cobro para activar contrato</div>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Monto</label>
                                                    <input type="number" min="0.01" step="0.01" name="monto" value="49.90" class="form-control js-monto-plan" />
                                                </div>
                                                <div class="col-md-8">
                                                    <label class="form-label">Tipo de pago</label>
                                                    <select name="tipoPago" class="form-select">
                                                        <option value="TRANSFERENCIA">Transferencia</option>
                                                        <option value="EFECTIVO">Efectivo</option>
                                                        <option value="YAPE">Yape</option>
                                                        <option value="PLIN">Plin</option>
                                                        <option value="LINK_PAGO">Link de pago</option>
                                                        <option value="PASARELA">Pasarela</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Fecha de pago</label>
                                                    <input type="datetime-local" name="fechaPago" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Fecha de vencimiento</label>
                                                    <input type="date" name="fechaVencimiento" class="form-control" value="@DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd")" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Periodicidad</label>
                                                    <select name="tipoCobroObjetivo" class="form-select js-periodicidad">
                                                        <option value="MENSUAL">Mensual</option>
                                                        <option value="TRIMESTRAL">Trimestral</option>
                                                        <option value="SEMESTRAL">Semestral</option>
                                                        <option value="ANUAL">Anual</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Plan comercial</label>
                                                    <select name="planComercialObjetivo" class="form-select js-plan-comercial">
                                                        <option value="ESENCIAL" data-precio="49.90" data-sedes="1" data-espacios="5" data-usuarios="2">Esencial</option>
                                                        <option value="PRO" data-precio="99.90" data-sedes="3" data-espacios="12" data-usuarios="3">Pro</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Inicio objetivo</label>
                                                    <input type="date" name="fechaInicioPlanObjetivo" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Dias de gracia</label>
                                                    <input type="number" min="0" max="30" name="diasGraciaObjetivo" value="@item.DiasGracia" class="form-control" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Operacion / voucher</label>
                                                    <input type="text" name="operacionNumero" class="form-control" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Entidad financiera</label>
                                                    <input type="text" name="entidadFinanciera" class="form-control" />
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label">Referencia externa / pasarela</label>
                                                    <input type="text" name="referenciaExterna" class="form-control" />
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label">Observacion</label>
                                                    <input type="text" name="observacion" class="form-control" placeholder="Observacion del cobro (opcional)" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Sedes permitidas</label>
                                                    <input type="number" min="1" name="sedesPermitidasObjetivo" value="1" class="form-control js-limite-sedes" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Espacios permitidos</label>
                                                    <input type="number" min="1" name="espaciosPermitidosObjetivo" value="5" class="form-control js-limite-espacios" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Usuarios permitidos</label>
                                                    <input type="number" min="1" name="usuariosPermitidosObjetivo" value="2" class="form-control js-limite-usuarios" />
                                                </div>
                                                <div class="col-12 platform-negocio-form-actions">
                                                    <button type="button" class="btn btn-outline-secondary btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-primary btn-grabar">Guardar cobro comercial</button>
                                                </div>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                                <div class="modal fade platform-negocio-modal" id="@modalGestionId" tabindex="-1" aria-labelledby="@(modalGestionId)Label" aria-hidden="true">
                                    <div class="modal-dialog modal-xl modal-dialog-scrollable">
                                        <div class="modal-content sc-modal-content">
                                            <div class="modal-header sc-modal-header">
                                                <div class="sc-modal-title-wrap">
                                                    <h5 class="modal-title sc-modal-title" id="@(modalGestionId)Label">Historial comercial</h5>
                                                    <p class="sc-modal-subtitle">Revisa movimientos, cobros y conciliacion aplicada de @item.NombreComercial.</p>
                                                </div>
                                                <button type="button" class="btn-close sc-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                            </div>
                                            <div class="modal-body sc-modal-body">
                                                <div class="row g-2 mb-3">
                                                    <div class="col-6 col-lg-3">
                                                        <div class="border rounded-3 p-2 bg-light-subtle h-100">
                                                            <div class="small text-muted">Movimientos</div>
                                                            <div class="fw-bold fs-5">@item.HistorialComercial.Count</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-6 col-lg-3">
                                                        <div class="border rounded-3 p-2 bg-light-subtle h-100">
                                                            <div class="small text-muted">Cobros pagados</div>
                                                            <div class="fw-bold fs-5 text-success">@totalPagosPagados</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-6 col-lg-3">
                                                        <div class="border rounded-3 p-2 bg-light-subtle h-100">
                                                            <div class="small text-muted">Cobros pendientes</div>
                                                            <div class="fw-bold fs-5 text-warning">@totalPagosPendientes</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-6 col-lg-3">
                                                        <div class="border rounded-3 p-2 bg-light-subtle h-100">
                                                            <div class="small text-muted">No aplicados</div>
                                                            <div class="fw-bold fs-5 text-primary">@totalPagosNoAplicados</div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="row g-2 mb-3">
                                                    <div class="col-12">
                                                        <label class="form-label small mb-1">Buscar en movimientos y cobros</label>
                                                        <input type="text" class="form-control form-control-sm js-gestion-search" placeholder="Operacion, referencia, tipo de pago, nota, movimiento..." />
                                                    </div>
                                                </div>

                                                <div class="row g-3">
                                                    <div class="col-lg-5">
                                                        <div class="border rounded-3 p-3 h-100">
                                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                                <h6 class="mb-0 text-primary">Historial comercial</h6>
                                                                <span class="badge text-bg-light border js-mov-filter-count">@item.HistorialComercial.Count registro(s)</span>
                                                            </div>
                                                            @if (item.HistorialComercial.Count == 0)
                                                            {
                                                                <div class="small text-muted">Aun no existen movimientos comerciales registrados.</div>
                                                            }
                                                            else
                                                            {
                                                                <div class="d-flex flex-column gap-2">
                                                                    @foreach (var mov in item.HistorialComercial)
                                                                    {
                                                                        var movSearch = string.Join(" ",
                                                                            mov.TipoMovimientoNombre ?? string.Empty,
                                                                             mov.TipoCobroAnterior ?? string.Empty,
                                                                             mov.TipoCobroNuevo ?? string.Empty,
                                                                             mov.PlanComercialAnterior ?? string.Empty,
                                                                             mov.PlanComercialNuevo ?? string.Empty,
                                                                            mov.Observacion ?? string.Empty,
                                                                            mov.UsuarioCreacion ?? string.Empty,
                                                                            mov.FechaCreacion.ToString("dd/MM/yyyy HH:mm"));
                                                                        <div class="border rounded-3 p-2 bg-white js-mov-item" data-search="@movSearch.ToLowerInvariant()">
                                                                            <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                                                                <span class="badge text-bg-light border">@mov.TipoMovimientoNombre</span>
                                                                                <small class="text-muted">@mov.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
                                                                            </div>
                                                                            <div class="small mt-1">
                                                                                @if (mov.FechaInicioReferencia.HasValue || mov.FechaFinReferencia.HasValue)
                                                                                {
                                                                                    <div>Vigencia: @(mov.FechaInicioReferencia?.ToString("dd/MM/yyyy") ?? "-") - @(mov.FechaFinReferencia?.ToString("dd/MM/yyyy") ?? "-")</div>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(mov.TipoCobroNuevo))
                                                                                {
                                                                                    <div>Periodicidad: @(string.IsNullOrWhiteSpace(mov.TipoCobroAnterior) ? "-" : mov.TipoCobroAnterior) -> @mov.TipoCobroNuevo</div>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(mov.PlanComercialNuevo))
                                                                                {
                                                                                    <div>Plan comercial: @(string.IsNullOrWhiteSpace(mov.PlanComercialAnterior) ? "-" : mov.PlanComercialAnterior) -> @mov.PlanComercialNuevo</div>
                                                                                }
                                                                                @if (mov.SedesPermitidasNuevo.HasValue || mov.EspaciosPermitidosNuevo.HasValue || mov.UsuariosPermitidosNuevo.HasValue)
                                                                                {
                                                                                    <div>Limites aplicados: @mov.SedesPermitidasNuevo sede(s), @mov.EspaciosPermitidosNuevo espacio(s), @mov.UsuariosPermitidosNuevo usuario(s)</div>
                                                                                }
                                                                                @if (mov.DiasExtra > 0)
                                                                                {
                                                                                    <div>Dias extra: @mov.DiasExtra</div>
                                                                                }
                                                                                @if (mov.DiasGracia > 0)
                                                                                {
                                                                                    <div>Dias de gracia acumulados: @mov.DiasGracia</div>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(mov.Observacion))
                                                                                {
                                                                                    <div>Nota: @mov.Observacion</div>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-7">
                                                        <div class="border rounded-3 p-3 h-100">
                                                            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2">
                                                                <div>
                                                                    <h6 class="mb-0 text-success">Historial de cobros</h6>
                                                                    <div class="small text-muted">Filtros rapidos por estado del cobro y conciliacion.</div>
                                                                </div>
                                                                <span class="badge text-bg-light border js-cobro-filter-count">@item.HistorialCobros.Count registro(s)</span>
                                                            </div>

                                                            <div class="d-flex flex-wrap gap-2 mb-3">
                                                                <button type="button" class="btn btn-sm btn-primary js-cobro-filter active" data-filter="all">Todos</button>
                                                                <button type="button" class="btn btn-sm btn-outline-success js-cobro-filter" data-filter="paid">Pagados</button>
                                                                <button type="button" class="btn btn-sm btn-outline-warning js-cobro-filter" data-filter="pending">Pendientes</button>
                                                                <button type="button" class="btn btn-sm btn-outline-info js-cobro-filter" data-filter="applied">Aplicados</button>
                                                                <button type="button" class="btn btn-sm btn-outline-secondary js-cobro-filter" data-filter="unapplied">No aplicados</button>
                                                            </div>

                                                            @if (item.HistorialCobros.Count == 0)
                                                            {
                                                                <div class="small text-muted">Aun no existen cobros registrados para este complejo deportivo.</div>
                                                            }
                                                            else
                                                            {
                                                                <div class="d-flex flex-column gap-2">
                                                                    @foreach (var pago in item.HistorialCobros)
                                                                    {
                                                                        var estadoPagoCss = pago.EstadoPago == "PAGADO" ? "success" : pago.EstadoPago == "PENDIENTE" ? "warning" : pago.EstadoPago == "OBSERVADO" ? "secondary" : "danger";
                                                                        var estadoAplicacion = pago.AplicadoSuscripcion ? "applied" : (pago.AplicarAlConfirmar ? "unapplied" : "none");
                                                                        var pagoSearch = string.Join(" ",
                                                                            pago.TipoPago ?? string.Empty,
                                                                            pago.EstadoPago ?? string.Empty,
                                                                            pago.OperacionNumero ?? string.Empty,
                                                                            pago.EntidadFinanciera ?? string.Empty,
                                                                            pago.ReferenciaExterna ?? string.Empty,
                                                                             pago.AccionAplicacion ?? string.Empty,
                                                                             pago.TipoCobroObjetivo ?? string.Empty,
                                                                             pago.PlanComercialObjetivo ?? string.Empty,
                                                                            pago.Observacion ?? string.Empty,
                                                                            pago.UsuarioCreacion ?? string.Empty,
                                                                            pago.FechaPago.ToString("dd/MM/yyyy HH:mm"));
                                                                        <div class="border rounded-3 p-2 bg-white js-cobro-item"
                                                                             data-estado="@((pago.EstadoPago ?? string.Empty).ToLowerInvariant())"
                                                                             data-aplicacion="@estadoAplicacion"
                                                                             data-search="@pagoSearch.ToLowerInvariant()">
                                                                            <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                                                                <div class="d-flex flex-wrap gap-2">
                                                                                    <span class="badge text-bg-light border">@pago.TipoPago</span>
                                                                                    <span class="badge text-bg-@estadoPagoCss">@pago.EstadoPago</span>
                                                                                    @if (pago.AplicadoSuscripcion)
                                                                                    {
                                                                                        <span class="badge text-bg-info">Aplicado</span>
                                                                                    }
                                                                                    else if (pago.AplicarAlConfirmar)
                                                                                    {
                                                                                        <span class="badge text-bg-secondary">No aplicado</span>
                                                                                    }
                                                                                </div>
                                                                                <small class="text-muted">@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</small>
                                                                            </div>
                                                                            <div class="small mt-2">
                                                                                <div>Monto: @(pago.Moneda == "PEN" ? "S/" : pago.Moneda) @pago.Monto.ToString("0.00")</div>
                                                                                @if (pago.FechaVencimiento.HasValue)
                                                                                {
                                                                                    <div>Vencimiento: @pago.FechaVencimiento.Value.ToString("dd/MM/yyyy")</div>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(pago.OperacionNumero))
                                                                                {
                                                                                    <div>Operacion: @pago.OperacionNumero</div>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(pago.EntidadFinanciera))
                                                                                {
                                                                                    <div>Entidad: @pago.EntidadFinanciera</div>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(pago.ReferenciaExterna))
                                                                                {
                                                                                    <div>Referencia: @pago.ReferenciaExterna</div>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(pago.TipoMovimientoRelacionado))
                                                                                {
                                                                                    <div>Relacionado a: @pago.TipoMovimientoRelacionado</div>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(pago.AccionAplicacion))
                                                                                {
                                                                                    <div>Accion aplicada: @pago.AccionAplicacion</div>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(pago.TipoCobroObjetivo))
                                                                                {
                                                                                    <div>Periodicidad: @pago.TipoCobroObjetivo</div>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(pago.PlanComercialObjetivo))
                                                                                {
                                                                                    <div>Plan comercial: @pago.PlanComercialObjetivo</div>
                                                                                    <div>Limites: @pago.SedesPermitidasObjetivo sede(s), @pago.EspaciosPermitidosObjetivo espacio(s), @pago.UsuariosPermitidosObjetivo usuario(s)</div>
                                                                                }
                                                                                @if (pago.FechaInicioPlanObjetivo.HasValue)
                                                                                {
                                                                                    <div>Inicio objetivo: @pago.FechaInicioPlanObjetivo.Value.ToString("dd/MM/yyyy")</div>
                                                                                }
                                                                                @if (pago.DiasGraciaObjetivo.HasValue)
                                                                                {
                                                                                    <div>Gracia objetivo: @pago.DiasGraciaObjetivo.Value dia(s)</div>
                                                                                }
                                                                                @if (pago.FechaAplicacion.HasValue)
                                                                                {
                                                                                    <div>Aplicado el: @pago.FechaAplicacion.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(pago.Observacion))
                                                                                {
                                                                                    <div>Nota: @pago.Observacion</div>
                                                                                }
                                                                            </div>
                                                                            @if (pago.EstadoPago == "PENDIENTE" && pago.AplicarAlConfirmar && !pago.AplicadoSuscripcion)
                                                                            {
                                                                                <form asp-action="ConfirmarPagoSuscripcionNegocio" method="post" class="mt-2">
                                                                                    @Html.AntiForgeryToken()
                                                                                    <input type="hidden" name="negocioId" value="@item.NegocioId" />
                                                                                    <input type="hidden" name="pagoId" value="@pago.Id" />
                                                                                    <input type="hidden" name="buscar" value="@Model.Buscar" />
                                                                                    <input type="hidden" name="estadoContrato" value="@Model.EstadoContrato" />
                                                                                    <input type="hidden" name="pagina" value="@Model.Pagina" />
                                                                                    <button type="submit" class="btn btn-sm btn-primary btn-grabar">Confirmar y aplicar</button>
                                                                                </form>
                                                                            }
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-outline-secondary btn-cancelar" data-bs-dismiss="modal">Cerrar</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                        </div>
            }
        }
    </div>
    @if (Model.TotalPaginas > 1)
    {
        <div class="px-3 py-3 d-flex justify-content-between align-items-center">
            <small class="text-muted">Pagina @Model.Pagina de @Model.TotalPaginas (@Model.TotalRegistros complejos deportivos)</small>
            <nav aria-label="Paginacion complejos deportivos plataforma">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Pagina <= 1 ? "disabled" : null)">
                        <a class="page-link" asp-action="Negocios" asp-route-buscar="@Model.Buscar" asp-route-estadoContrato="@Model.EstadoContrato" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a>
                    </li>
                    <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : null)">
                        <a class="page-link" asp-action="Negocios" asp-route-buscar="@Model.Buscar" asp-route-estadoContrato="@Model.EstadoContrato" asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</section>

@section Scripts
{
    <script>
        (function () {
            function addMonths(isoDate, months) {
                const parts = (isoDate || '').split('-');
                if (parts.length !== 3) return '';
                const year = parseInt(parts[0], 10);
                const month = parseInt(parts[1], 10) - 1;
                const day = parseInt(parts[2], 10);
                if (Number.isNaN(year) || Number.isNaN(month) || Number.isNaN(day)) return '';

                const base = new Date(year, month, day);
                if (Number.isNaN(base.getTime())) return '';

                const result = new Date(base);
                result.setMonth(result.getMonth() + months);

                const yyyy = result.getFullYear();
                const mm = String(result.getMonth() + 1).padStart(2, '0');
                const dd = String(result.getDate()).padStart(2, '0');
                return `${yyyy}-${mm}-${dd}`;
            }

            function addYears(isoDate, years) {
                const parts = (isoDate || '').split('-');
                if (parts.length !== 3) return '';
                const year = parseInt(parts[0], 10);
                const month = parseInt(parts[1], 10) - 1;
                const day = parseInt(parts[2], 10);
                if (Number.isNaN(year) || Number.isNaN(month) || Number.isNaN(day)) return '';

                const result = new Date(year + years, month, day);
                const yyyy = result.getFullYear();
                const mm = String(result.getMonth() + 1).padStart(2, '0');
                const dd = String(result.getDate()).padStart(2, '0');
                return `${yyyy}-${mm}-${dd}`;
            }

            function calcularFechaFin(tipoCobro, fechaDesde) {
                switch ((tipoCobro || 'MENSUAL').toUpperCase()) {
                    case 'TRIMESTRAL':
                        return addMonths(fechaDesde, 3);
                    case 'SEMESTRAL':
                        return addMonths(fechaDesde, 6);
                    case 'ANUAL':
                        return addYears(fechaDesde, 1);
                    default:
                        return addMonths(fechaDesde, 1);
                }
            }

            document.querySelectorAll('.js-contrato-form').forEach(function (form) {
                const tipoCobro = form.querySelector('.js-tipo-cobro');
                const fechaDesde = form.querySelector('.js-fecha-desde');
                const fechaHasta = form.querySelector('.js-fecha-hasta');
                if (!tipoCobro || !fechaDesde || !fechaHasta) return;

                function actualizarFechaFin() {
                    fechaHasta.value = calcularFechaFin(tipoCobro.value, fechaDesde.value);
                }

                actualizarFechaFin();
                tipoCobro.addEventListener('change', actualizarFechaFin);
                fechaDesde.addEventListener('change', actualizarFechaFin);
            });

            document.querySelectorAll('.js-cobro-suscripcion-form').forEach(function (form) {
                const accionSelect = form.querySelector('.js-accion-aplicacion');
                const planSelect = form.querySelector('.js-plan-comercial');
                const periodicidad = form.querySelector('.js-periodicidad');
                const monto = form.querySelector('.js-monto-plan');
                const sedes = form.querySelector('.js-limite-sedes');
                const espacios = form.querySelector('.js-limite-espacios');
                const usuarios = form.querySelector('.js-limite-usuarios');
                if (!planSelect) return;

                planSelect.addEventListener('change', function () {
                    const option = planSelect.options[planSelect.selectedIndex];
                    if (monto) monto.value = option.dataset.precio || monto.value;
                    if (sedes) sedes.value = option.dataset.sedes || sedes.value;
                    if (espacios) espacios.value = option.dataset.espacios || espacios.value;
                    if (usuarios) usuarios.value = option.dataset.usuarios || usuarios.value;

                    if (accionSelect && planSelect.dataset.planActual
                        && planSelect.value !== planSelect.dataset.planActual) {
                        accionSelect.value = 'CAMBIO_PLAN';
                    }
                });

                if (accionSelect && periodicidad && periodicidad.dataset.periodicidadActual) {
                    periodicidad.addEventListener('change', function () {
                        if (periodicidad.value !== periodicidad.dataset.periodicidadActual) {
                            accionSelect.value = 'CAMBIO_PLAN';
                        }
                    });
                }
            });

            document.querySelectorAll('.platform-negocio-modal').forEach(function (modal) {
                if (modal.parentElement !== document.body) {
                    document.body.appendChild(modal);
                }
            });

            document.querySelectorAll('.modal').forEach(function (modal) {
                const buttons = modal.querySelectorAll('.js-cobro-filter');
                const items = modal.querySelectorAll('.js-cobro-item');
                const movItems = modal.querySelectorAll('.js-mov-item');
                const counter = modal.querySelector('.js-cobro-filter-count');
                const movCounter = modal.querySelector('.js-mov-filter-count');
                const searchInput = modal.querySelector('.js-gestion-search');
                if ((!buttons.length && !movItems.length) || !counter) return;

                function textoCoincide(item, query) {
                    if (!query) return true;
                    return (item.dataset.search || '').indexOf(query) >= 0;
                }

                function aplicarFiltroMovimientos(query) {
                    if (!movItems.length || !movCounter) return;
                    let visibles = 0;
                    movItems.forEach(function (item) {
                        const mostrar = textoCoincide(item, query);
                        item.classList.toggle('d-none', !mostrar);
                        if (mostrar) visibles++;
                    });
                    movCounter.textContent = `${visibles} registro(s)`;
                }

                function aplicarFiltro(filter) {
                    const query = ((searchInput && searchInput.value) || '').trim().toLowerCase();
                    let visibles = 0;
                    items.forEach(function (item) {
                        const estado = (item.dataset.estado || '').toLowerCase();
                        const aplicacion = (item.dataset.aplicacion || '').toLowerCase();
                        const mostrar =
                            textoCoincide(item, query)
                            && (
                                filter === 'all'
                                || (filter === 'paid' && estado === 'pagado')
                                || (filter === 'pending' && estado === 'pendiente')
                                || (filter === 'applied' && aplicacion === 'applied')
                                || (filter === 'unapplied' && aplicacion === 'unapplied')
                            );

                        item.classList.toggle('d-none', !mostrar);
                        if (mostrar) visibles++;
                    });

                    counter.textContent = `${visibles} registro(s)`;
                    aplicarFiltroMovimientos(query);
                }

                buttons.forEach(function (button) {
                    button.addEventListener('click', function () {
                        buttons.forEach(function (btn) {
                            btn.classList.remove('active', 'btn-primary');
                            if (btn.dataset.filter === 'all') {
                                btn.classList.add('btn-outline-primary');
                            }
                        });

                        button.classList.add('active');
                        if (button.classList.contains('btn-outline-primary')) {
                            button.classList.remove('btn-outline-primary');
                            button.classList.add('btn-primary');
                        }

                        aplicarFiltro(button.dataset.filter || 'all');
                    });
                });

                if (searchInput) {
                    searchInput.addEventListener('input', function () {
                        const activeButton = modal.querySelector('.js-cobro-filter.active');
                        aplicarFiltro((activeButton && activeButton.dataset.filter) || 'all');
                    });
                }

                aplicarFiltro('all');
            });
        })();
    </script>
}

