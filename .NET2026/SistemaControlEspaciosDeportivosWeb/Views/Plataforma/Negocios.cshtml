                                                    <select name="planComercialObjetivo" class="form-select js-plan-comercial" data-plan-actual="@item.PlanComercial">
                                                        <option value="ESENCIAL" data-precio="49.90" data-sedes="1" data-espacios="5" data-usuarios="2" selected="@(item.PlanComercial != "PRO" ? "selected" : null)">Esencial</option>
                                                        <option value="PRO" data-precio="99.90" data-sedes="3" data-espacios="12" data-usuarios="3" selected="@(item.PlanComercial == "PRO" ? "selected" : null)">Pro</option>
