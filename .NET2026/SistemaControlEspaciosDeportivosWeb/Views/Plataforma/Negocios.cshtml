@model SistemaControlEspaciosDeportivosWeb.ViewModels.PlataformaNegociosAdminViewModel
@{
    ViewData["Title"] = "Complejo deportivo";
}
@* Firma: FRANCO LARA - 09/05/2026 | Ajuste de etiquetas en Super Admin para reemplazar Club/Negocio por Complejo deportivo. *@
@* Firma: FRANCO LARA - 10/06/2026 | Agrega conciliacion de cobros comerciales con acciones diferidas y reorganiza la gestion comercial del super admin con resumen por negocio y modales por accion. *@
<div class="page-header-card mb-3">
    <div class="page-header-main">
        <h1 class="page-title">Complejos deportivos registrados</h1>
        <p class="page-subtitle">Administra limites operativos por complejo deportivo: sedes, espacios y usuarios permitidos.</p>
    </div>
</div>

@if (TempData["PortalWebOk"] is string ok && !string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["PortalWebError"] is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger">@err</div>
}

<style>
    .platform-negocio-action-btn {
        min-width: 140px;
    }

    .platform-negocio-summary-badges {
        row-gap: .5rem;
    }

    .platform-negocio-modal .modal-dialog {
        --bs-modal-width: 980px;
    }

    .platform-negocio-modal .modal-footer,
    .platform-negocio-form-actions {
        position: sticky;
        bottom: 0;
        z-index: 3;
        padding-top: .85rem;
        padding-bottom: .2rem;
        margin-top: 1rem;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.92) 0%, #ffffff 28%);
        border-top: 1px solid rgba(148, 163, 184, 0.22);
        backdrop-filter: blur(10px);
    }

    .platform-negocio-form-actions {
        display: flex;
        justify-content: flex-end;
        gap: .75rem;
    }
</style>

<section class="table-card sc-reservas-list-card p-3 mb-3">
    <form asp-action="Negocios" method="get" class="row g-2 align-items-end">
        <div class="col-md-5 col-lg-4">
            <label class="form-label">Buscar complejo deportivo</label>
            <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Nombre comercial" />
        </div>
        <div class="col-md-4 col-lg-3">
            <label class="form-label">Estado comercial</label>
            <select class="form-select" name="estadoContrato">
                <option value="todos" selected="@(Model.EstadoContrato == "todos" ? "selected" : null)">Todos</option>
                <option value="con-contrato" selected="@(Model.EstadoContrato == "con-contrato" ? "selected" : null)">Con contrato</option>
                <option value="sin-contrato" selected="@(Model.EstadoContrato == "sin-contrato" ? "selected" : null)">Sin contrato</option>
                <option value="prueba-por-vencer" selected="@(Model.EstadoContrato == "prueba-por-vencer" ? "selected" : null)">Prueba por vencer</option>
            </select>
        </div>
        <div class="col-md-3 col-lg-2 d-grid">
            <button type="submit" class="btn btn-primary btn-accion-filtro"><i class="bi bi-search me-1"></i>Buscar</button>
        </div>
        <div class="col-md-3 col-lg-2 d-grid">
            <a asp-action="Negocios" class="btn btn-outline-secondary btn-cancelar">Limpiar</a>
        </div>
    </form>
</section>

<section class="table-card sc-reservas-list-card p-0 overflow-hidden">
    <div class="table-card-header d-flex justify-content-between align-items-center">
        <h2 class="table-card-title platform-card-title"><span class="platform-card-icon"><i class="bi bi-diagram-3"></i></span><span class="platform-card-title-text">Complejos deportivos listados</span></h2>
        <span class="badge text-bg-light border">Pagina @Model.Pagina de @Model.TotalPaginas</span>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>
                        <span class="sc-col-header">
                            <i class="bi bi-buildings"></i>
                            <small>Complejo deportivo</small>
                        </span>
                    </th>
                    <th>
                        <span class="sc-col-header">
                            <i class="bi bi-activity"></i>
                            <small>Estado</small>
                        </span>
                    </th>
                    <th class="text-center">
                        <span class="sc-col-header">
                            <i class="bi bi-sliders2"></i>
                            <small>Limites</small>
                        </span>
                    </th>
                    <th>
                        <span class="sc-col-header">
                            <i class="bi bi-journal-check"></i>
                            <small>Suscripcion</small>
                        </span>
                    </th>
                    <th class="text-end">
                        <span class="sc-col-header">
                            <i class="bi bi-tools"></i>
                            <small>Accion</small>
                        </span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Negocios.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No se encontraron complejos deportivos.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Negocios)
                    {
                        var modalLimitesId = $"limitesNegocioModal{item.NegocioId}";
                        var modalContratoId = $"contratoNegocioModal{item.NegocioId}";
                        var modalCobroId = $"cobroNegocioModal{item.NegocioId}";
                        var modalGestionId = $"gestionComercialModal{item.NegocioId}";
                        var tieneContratoActivo = !item.EsPrueba
                            && !string.IsNullOrWhiteSpace(item.TipoCobro)
                            && item.FechaFinPlan.HasValue;
                        var contratoEnGracia = tieneContratoActivo
                            && item.FechaFinPlan.HasValue
                            && item.FechaFinGracia.HasValue
                            && item.FechaFinPlan.Value.Date < DateTime.Today.Date
                            && item.FechaFinGracia.Value.Date >= DateTime.Today.Date;
                        var fechaInicioObjetivoDefault = item.FechaFinPlan.HasValue && item.FechaFinPlan.Value.Date >= DateTime.Today.Date
                            ? DateOnly.FromDateTime(item.FechaFinPlan.Value.Date)
                            : DateOnly.FromDateTime(DateTime.Today);
                        var pruebaPorVencer = item.EsPrueba
                            && item.FechaFinPrueba.HasValue
                            && item.FechaFinPrueba.Value.Date >= DateTime.Today.Date
                            && item.FechaFinPrueba.Value.Date <= DateTime.Today.AddDays(7).Date;
                        var totalPagosPagados = item.HistorialCobros.Count(p => p.EstadoPago == "PAGADO");
                        var totalPagosPendientes = item.HistorialCobros.Count(p => p.EstadoPago == "PENDIENTE");
                        var totalPagosAplicados = item.HistorialCobros.Count(p => p.AplicadoSuscripcion);
                        var totalPagosNoAplicados = item.HistorialCobros.Count(p => p.AplicarAlConfirmar && !p.AplicadoSuscripcion);
                        <tr>
                            <td>
                                <strong>@item.NombreComercial</strong>
                                <div class="text-muted small">ID: @item.NegocioId</div>
                            </td>
                            <td>
                                @if (item.Activo)
                                {
                                    <span class="badge text-bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap justify-content-center gap-2">
                                    <span class="badge text-bg-light border">Sedes: @item.SedesPermitidas</span>
                                    <span class="badge text-bg-light border">Espacios: @item.EspaciosPermitidos</span>
                                    <span class="badge text-bg-light border">Usuarios: @item.UsuariosPermitidos</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    <span class="badge text-bg-@(item.EstadoSuscripcion is 1 or 2 ? "success" : item.EstadoSuscripcion == 3 ? "danger" : "secondary")">@item.EstadoSuscripcionNombre</span>
                                    @if (pruebaPorVencer)
                                    {
                                        <span class="badge text-bg-warning text-dark">Prueba por vencer</span>
                                    }
                                    @if (contratoEnGracia)
                                    {
                                        <span class="badge text-bg-warning text-dark">En gracia</span>
                                    }
                                    else if (tieneContratoActivo)
                                    {
                                        <span class="badge text-bg-info">Contrato activo</span>
                                    }
                                </div>

                                @if (item.EsPrueba && item.FechaFinPrueba.HasValue)
                                {
                                    <div class="small text-muted">Prueba hasta: @item.FechaFinPrueba.Value.ToString("dd/MM/yyyy")</div>
                                }
                                else if (!item.EsPrueba && item.FechaFinPlan.HasValue)
                                {
                                    <div class="small text-muted">Plan: @item.TipoCobro | @item.FechaInicioPlan?.ToString("dd/MM/yyyy") - @item.FechaFinPlan?.ToString("dd/MM/yyyy")</div>
                                    <div class="small text-muted">Gracia: @item.DiasGracia dias | hasta @item.FechaFinGracia?.ToString("dd/MM/yyyy")</div>
                                }
                                else if (!item.EsPrueba)
                                {
                                    <div class="small text-muted">Sin contrato activo.</div>
                                }

                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <span class="badge text-bg-light border">Cobrado: S/ @item.MontoTotalCobrado.ToString("0.00")</span>
                                    <span class="badge text-bg-light border">Cobros: @item.CantidadCobrosRegistrados</span>
                                    <span class="badge text-bg-light border">Mov.: @item.HistorialComercial.Count</span>
                                </div>
                            </td>
                            <td class="text-end">
                                <div class="d-flex flex-column align-items-end gap-2">
                                    <button type="button" class="btn btn-sm btn-primary btn-grabar platform-negocio-action-btn" data-bs-toggle="modal" data-bs-target="#@modalLimitesId">
                                        <i class="bi bi-sliders2 me-1"></i>Limites
                                    </button>
                                    <button type="button" class="btn btn-sm btn-primary btn-grabar platform-negocio-action-btn" data-bs-toggle="modal" data-bs-target="#@modalContratoId">
                                        <i class="bi bi-journal-check me-1"></i>Contrato
                                    </button>
                                    <button type="button" class="btn btn-sm btn-primary btn-grabar platform-negocio-action-btn" data-bs-toggle="modal" data-bs-target="#@modalCobroId">
                                        <i class="bi bi-cash-coin me-1"></i>Cobros
                                    </button>
                                    <button type="button" class="btn btn-sm btn-primary btn-grabar platform-negocio-action-btn" data-bs-toggle="modal" data-bs-target="#@modalGestionId">
                                        <i class="bi bi-collection me-1"></i>Historial
                                    </button>
                                    <span class="text-muted small">ID @item.NegocioId</span>
                                </div>
                            </td>
                        </tr>
                        <tr class="d-none">
                            <td colspan="5">
                        <div class="modal fade platform-negocio-modal" id="@modalLimitesId" tabindex="-1" aria-labelledby="@(modalLimitesId)Label" aria-hidden="true">
                            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                                <div class="modal-content sc-modal-content">
                                    <div class="modal-header sc-modal-header">
                                        <div class="sc-modal-title-wrap">
                                            <h5 class="modal-title sc-modal-title" id="@(modalLimitesId)Label">Limites operativos</h5>
                                            <p class="sc-modal-subtitle">Actualiza sedes, espacios y usuarios permitidos de @item.NombreComercial.</p>
                                        </div>
                                        <button type="button" class="btn-close sc-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                    </div>
                                    <div class="modal-body sc-modal-body">
                                        <form asp-action="GuardarLimitesNegocio" method="post" class="row g-3">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="negocioId" value="@item.NegocioId" />
                                            <input type="hidden" name="buscar" value="@Model.Buscar" />
                                            <input type="hidden" name="estadoContrato" value="@Model.EstadoContrato" />
                                            <input type="hidden" name="pagina" value="@Model.Pagina" />
                                            <div class="col-md-4">
                                                <label class="form-label">Sedes permitidas</label>
                                                <input type="number" min="1" max="999" name="sedesPermitidas" value="@item.SedesPermitidas" class="form-control" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Espacios permitidos</label>
                                                <input type="number" min="1" max="9999" name="espaciosPermitidos" value="@item.EspaciosPermitidos" class="form-control" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Usuarios permitidos</label>
                                                <input type="number" min="1" max="999" name="usuariosPermitidos" value="@item.UsuariosPermitidos" class="form-control" />
                                            </div>
                                            <div class="col-12 platform-negocio-form-actions">
                                                <button type="button" class="btn btn-outline-secondary btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                                                <button type="submit" class="btn btn-primary btn-grabar"><i class="bi bi-save me-1"></i>Guardar limites</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade platform-negocio-modal" id="@modalContratoId" tabindex="-1" aria-labelledby="@(modalContratoId)Label" aria-hidden="true">
                            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                                <div class="modal-content sc-modal-content">
                                    <div class="modal-header sc-modal-header">
                                        <div class="sc-modal-title-wrap">
                                            <h5 class="modal-title sc-modal-title" id="@(modalContratoId)Label">Gestion de contrato</h5>
                                            <p class="sc-modal-subtitle">Administra prueba, activacion, renovacion, cambio de plan y dias de gracia de @item.NombreComercial.</p>
                                        </div>
                                        <button type="button" class="btn-close sc-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                    </div>
                                    <div class="modal-body sc-modal-body">
                                        @* Firma: FRANCO LARA - 10/06/2026 | Reorganiza la administracion comercial del superadmin en modales por accion. *@
                                        @if (item.EsPrueba)
                                        {
                                            <form asp-action="ExtenderPruebaNegocio" method="post" class="row g-2 border rounded-3 p-3 bg-light-subtle">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="negocioId" value="@item.NegocioId" />
                                                <input type="hidden" name="buscar" value="@Model.Buscar" />
                                                <input type="hidden" name="estadoContrato" value="@Model.EstadoContrato" />
                                                <input type="hidden" name="pagina" value="@Model.Pagina" />
                                                <div class="col-12">
                                                    <div class="fw-semibold text-primary">Gestion de prueba</div>
                                                    <div class="small text-muted">Prueba actual hasta @item.FechaFinPrueba?.ToString("dd/MM/yyyy")</div>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Dias extra</label>
                                                    <input type="number" min="1" max="60" name="diasExtra" value="7" class="form-control" />
                                                </div>
                                                <div class="col-md-8">
                                                    <label class="form-label">Observacion</label>
                                                    <input type="text" name="observacion" class="form-control" placeholder="Motivo de extension (opcional)" />
                                                </div>
                                                <div class="col-12 platform-negocio-form-actions">
                                                    <button type="button" class="btn btn-outline-secondary btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-primary btn-grabar">Extender prueba</button>
                                                </div>
                                            </form>
                                        }
                                        else if (tieneContratoActivo)
                                        {
                                            <div class="row g-3">
                                                <div class="col-lg-4">
                                                    <div class="border rounded-3 p-3 bg-light-subtle h-100">
                                                        <div class="fw-semibold text-primary mb-2">Acciones rapidas</div>
                                                        <div class="small text-muted mb-3">Plan actual: @item.TipoCobro</div>
                                                        <div class="d-grid gap-2">
                                                            <form asp-action="RenovarContratoNegocio" method="post">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="negocioId" value="@item.NegocioId" />
                                                                <input type="hidden" name="buscar" value="@Model.Buscar" />
                                                                <input type="hidden" name="estadoContrato" value="@Model.EstadoContrato" />
                                                                <input type="hidden" name="pagina" value="@Model.Pagina" />
                                                                <button type="submit" class="btn btn-primary btn-grabar w-100">Renovar suscripcion</button>
                                                            </form>
                                                            <form asp-action="FinalizarContratoNegocio" method="post" onsubmit="return confirm('Se dara fin al contrato actual del complejo deportivo. Deseas continuar?');">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="negocioId" value="@item.NegocioId" />
                                                                <input type="hidden" name="buscar" value="@Model.Buscar" />
                                                                <input type="hidden" name="estadoContrato" value="@Model.EstadoContrato" />
                                                                <input type="hidden" name="pagina" value="@Model.Pagina" />
                                                                <button type="submit" class="btn btn-outline-secondary btn-cancelar w-100">Dar fin al contrato</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-8">
                                                    <form asp-action="CambiarPlanNegocio" method="post" class="row g-2 border rounded-3 p-3 js-contrato-form bg-light-subtle h-100">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="negocioId" value="@item.NegocioId" />
                                                        <input type="hidden" name="buscar" value="@Model.Buscar" />
                                                        <input type="hidden" name="estadoContrato" value="@Model.EstadoContrato" />
                                                        <input type="hidden" name="pagina" value="@Model.Pagina" />
                                                        <div class="col-12">
                                                            <div class="fw-semibold text-primary">Cambiar plan</div>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label">Tipo de plan</label>
                                                            <select name="tipoCobro" class="form-select js-tipo-cobro">
                                                                <option value="MENSUAL" selected="@(item.TipoCobro == "MENSUAL" ? "selected" : null)">Mensual</option>
                                                                <option value="TRIMESTRAL" selected="@(item.TipoCobro == "TRIMESTRAL" ? "selected" : null)">Trimestral</option>
                                                                <option value="SEMESTRAL" selected="@(item.TipoCobro == "SEMESTRAL" ? "selected" : null)">Semestral</option>
                                                                <option value="ANUAL" selected="@(item.TipoCobro == "ANUAL" ? "selected" : null)">Anual</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="form-label">Fecha desde</label>
                                                            <input type="date" name="fechaDesde" class="form-control js-fecha-desde" value="@(item.FechaInicioPlan?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" />
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="form-label">Fecha hasta</label>
                                                            <input type="date" name="fechaHasta" class="form-control js-fecha-hasta" value="@(item.FechaFinPlan?.ToString("yyyy-MM-dd") ?? DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd"))" readonly />
                                                        </div>
                                                        <div class="col-12">
                                                            <small class="text-muted">La fecha fin se calcula automaticamente segun el tipo de cobro y la fecha de inicio.</small>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label">Dias de gracia</label>
                                                            <input type="number" min="0" max="30" name="diasGracia" value="@item.DiasGracia" class="form-control" />
                                                        </div>
                                                        <div class="col-md-8">
                                                            <label class="form-label">Observacion</label>
                                                            <input type="text" name="observacion" class="form-control" placeholder="Motivo del cambio (opcional)" />
                                                        </div>
                                                        <div class="col-12 platform-negocio-form-actions">
                                                            <button type="button" class="btn btn-outline-secondary btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                                                            <button type="submit" class="btn btn-primary btn-grabar">Guardar cambio de plan</button>
                                                        </div>
                                                    </form>
                                                </div>
                                                <div class="col-12">
                                                    <form asp-action="AplicarGraciaNegocio" method="post" class="row g-2 border rounded-3 p-3 bg-light-subtle">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="negocioId" value="@item.NegocioId" />
                                                        <input type="hidden" name="buscar" value="@Model.Buscar" />
                                                        <input type="hidden" name="estadoContrato" value="@Model.EstadoContrato" />
                                                        <input type="hidden" name="pagina" value="@Model.Pagina" />
                                                        <div class="col-12">
                                                            <div class="fw-semibold text-primary">Dar gracia manual</div>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label">Dias extra</label>
                                                            <input type="number" min="1" max="60" name="diasExtra" value="5" class="form-control" />
                                                        </div>
                                                        <div class="col-md-8">
                                                            <label class="form-label">Observacion</label>
                                                            <input type="text" name="observacion" class="form-control" placeholder="Motivo de gracia (opcional)" />
                                                        </div>
                                                        <div class="col-12 platform-negocio-form-actions">
                                                            <button type="button" class="btn btn-outline-secondary btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                                                            <button type="submit" class="btn btn-primary btn-grabar">Aplicar gracia manual</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <form asp-action="ActivarContratoNegocio" method="post" class="row g-2 js-contrato-form border rounded-3 p-3 bg-light-subtle">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="negocioId" value="@item.NegocioId" />
                                                <input type="hidden" name="buscar" value="@Model.Buscar" />
                                                <input type="hidden" name="estadoContrato" value="@Model.EstadoContrato" />
                                                <input type="hidden" name="pagina" value="@Model.Pagina" />
                                                <div class="col-12">
                                                    <div class="fw-semibold text-primary">Activar contrato</div>
                                                    <div class="small text-muted">Usa este formulario si el complejo ya no esta en prueba y no tiene contrato activo.</div>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Tipo de plan</label>
                                                    <select name="tipoCobro" class="form-select js-tipo-cobro">
                                                        <option value="MENSUAL">Mensual</option>
                                                        <option value="TRIMESTRAL">Trimestral</option>
                                                        <option value="SEMESTRAL">Semestral</option>
                                                        <option value="ANUAL">Anual</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Fecha desde</label>
                                                    <input type="date" name="fechaDesde" class="form-control js-fecha-desde" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Fecha hasta</label>
                                                    <input type="date" name="fechaHasta" class="form-control js-fecha-hasta" value="@DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd")" readonly />
                                                </div>
