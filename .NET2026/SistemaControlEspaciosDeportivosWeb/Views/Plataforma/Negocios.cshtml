                                                                                {
                                                                                    <div>Inicio objetivo: @pago.FechaInicioPlanObjetivo.Value.ToString("dd/MM/yyyy")</div>
                                                                                }
                                                                                @if (pago.DiasGraciaObjetivo.HasValue)
                                                                                {
                                                                                    <div>Gracia objetivo: @pago.DiasGraciaObjetivo.Value dia(s)</div>
                                                                                }
                                                                                @if (pago.FechaAplicacion.HasValue)
                                                                                {
                                                                                    <div>Aplicado el: @pago.FechaAplicacion.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(pago.Observacion))
                                                                                {
                                                                                    <div>Nota: @pago.Observacion</div>
                                                                                }
                                                                            </div>
                                                                            @if (pago.EstadoPago == "PENDIENTE" && pago.AplicarAlConfirmar && !pago.AplicadoSuscripcion)
                                                                            {
                                                                                <form asp-action="ConfirmarPagoSuscripcionNegocio" method="post" class="mt-2">
                                                                                    @Html.AntiForgeryToken()
                                                                                    <input type="hidden" name="negocioId" value="@item.NegocioId" />
                                                                                    <input type="hidden" name="pagoId" value="@pago.Id" />
                                                                                    <input type="hidden" name="buscar" value="@Model.Buscar" />
                                                                                    <input type="hidden" name="estadoContrato" value="@Model.EstadoContrato" />
                                                                                    <input type="hidden" name="pagina" value="@Model.Pagina" />
                                                                                    <button type="submit" class="btn btn-sm btn-primary btn-grabar">Confirmar y aplicar</button>
                                                                                </form>
                                                                            }
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-outline-secondary btn-cancelar" data-bs-dismiss="modal">Cerrar</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPaginas > 1)
    {
        <div class="px-3 py-3 d-flex justify-content-between align-items-center">
            <small class="text-muted">Pagina @Model.Pagina de @Model.TotalPaginas (@Model.TotalRegistros complejos deportivos)</small>
            <nav aria-label="Paginacion complejos deportivos plataforma">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Pagina <= 1 ? "disabled" : null)">
                        <a class="page-link" asp-action="Negocios" asp-route-buscar="@Model.Buscar" asp-route-estadoContrato="@Model.EstadoContrato" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a>
                    </li>
                    <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : null)">
                        <a class="page-link" asp-action="Negocios" asp-route-buscar="@Model.Buscar" asp-route-estadoContrato="@Model.EstadoContrato" asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</section>

@section Scripts
{
    <script>
        (function () {
            function addMonths(isoDate, months) {
                const parts = (isoDate || '').split('-');
                if (parts.length !== 3) return '';
                const year = parseInt(parts[0], 10);
                const month = parseInt(parts[1], 10) - 1;
                const day = parseInt(parts[2], 10);
                if (Number.isNaN(year) || Number.isNaN(month) || Number.isNaN(day)) return '';

                const base = new Date(year, month, day);
                if (Number.isNaN(base.getTime())) return '';

                const result = new Date(base);
                result.setMonth(result.getMonth() + months);

                const yyyy = result.getFullYear();
                const mm = String(result.getMonth() + 1).padStart(2, '0');
                const dd = String(result.getDate()).padStart(2, '0');
                return `${yyyy}-${mm}-${dd}`;
            }

            function addYears(isoDate, years) {
                const parts = (isoDate || '').split('-');
                if (parts.length !== 3) return '';
                const year = parseInt(parts[0], 10);
                const month = parseInt(parts[1], 10) - 1;
                const day = parseInt(parts[2], 10);
                if (Number.isNaN(year) || Number.isNaN(month) || Number.isNaN(day)) return '';

                const result = new Date(year + years, month, day);
                const yyyy = result.getFullYear();
                const mm = String(result.getMonth() + 1).padStart(2, '0');
                const dd = String(result.getDate()).padStart(2, '0');
                return `${yyyy}-${mm}-${dd}`;
            }

            function calcularFechaFin(tipoCobro, fechaDesde) {
                switch ((tipoCobro || 'MENSUAL').toUpperCase()) {
                    case 'TRIMESTRAL':
                        return addMonths(fechaDesde, 3);
                    case 'SEMESTRAL':
                        return addMonths(fechaDesde, 6);
                    case 'ANUAL':
                        return addYears(fechaDesde, 1);
                    default:
                        return addMonths(fechaDesde, 1);
                }
            }

            document.querySelectorAll('.js-contrato-form').forEach(function (form) {
                const tipoCobro = form.querySelector('.js-tipo-cobro');
                const fechaDesde = form.querySelector('.js-fecha-desde');
                const fechaHasta = form.querySelector('.js-fecha-hasta');
                if (!tipoCobro || !fechaDesde || !fechaHasta) return;

                function actualizarFechaFin() {
                    fechaHasta.value = calcularFechaFin(tipoCobro.value, fechaDesde.value);
                }

                actualizarFechaFin();
                tipoCobro.addEventListener('change', actualizarFechaFin);
                fechaDesde.addEventListener('change', actualizarFechaFin);
            });

            document.querySelectorAll('.js-cobro-suscripcion-form').forEach(function (form) {
                const accionSelect = form.querySelector('.js-accion-aplicacion');
                const planFields = form.querySelectorAll('.js-accion-plan');
                if (!accionSelect || !planFields.length) return;

                function togglePlanFields() {
                    const requierePlan = accionSelect.value === 'CAMBIO_PLAN';
                    planFields.forEach(function (field) {
                        field.style.display = requierePlan ? '' : 'none';
                    });
                }

                togglePlanFields();
                accionSelect.addEventListener('change', togglePlanFields);
            });

            document.querySelectorAll('.platform-negocio-modal').forEach(function (modal) {
                if (modal.parentElement !== document.body) {
                    document.body.appendChild(modal);
                }
            });

            document.querySelectorAll('.modal').forEach(function (modal) {
                const buttons = modal.querySelectorAll('.js-cobro-filter');
                const items = modal.querySelectorAll('.js-cobro-item');
                const movItems = modal.querySelectorAll('.js-mov-item');
                const counter = modal.querySelector('.js-cobro-filter-count');
                const movCounter = modal.querySelector('.js-mov-filter-count');
                const searchInput = modal.querySelector('.js-gestion-search');
                if ((!buttons.length && !movItems.length) || !counter) return;

                function textoCoincide(item, query) {
                    if (!query) return true;
                    return (item.dataset.search || '').indexOf(query) >= 0;
                }

                function aplicarFiltroMovimientos(query) {
                    if (!movItems.length || !movCounter) return;
                    let visibles = 0;
                    movItems.forEach(function (item) {
                        const mostrar = textoCoincide(item, query);
                        item.classList.toggle('d-none', !mostrar);
                        if (mostrar) visibles++;
                    });
                    movCounter.textContent = `${visibles} registro(s)`;
                }

                function aplicarFiltro(filter) {
                    const query = ((searchInput && searchInput.value) || '').trim().toLowerCase();
                    let visibles = 0;
                    items.forEach(function (item) {
                        const estado = (item.dataset.estado || '').toLowerCase();
                        const aplicacion = (item.dataset.aplicacion || '').toLowerCase();
                        const mostrar =
                            textoCoincide(item, query)
                            && (
                                filter === 'all'
                                || (filter === 'paid' && estado === 'pagado')
                                || (filter === 'pending' && estado === 'pendiente')
                                || (filter === 'applied' && aplicacion === 'applied')
                                || (filter === 'unapplied' && aplicacion === 'unapplied')
                            );

                        item.classList.toggle('d-none', !mostrar);
                        if (mostrar) visibles++;
                    });

                    counter.textContent = `${visibles} registro(s)`;
                    aplicarFiltroMovimientos(query);
                }

                buttons.forEach(function (button) {
                    button.addEventListener('click', function () {
                        buttons.forEach(function (btn) {
                            btn.classList.remove('active', 'btn-primary');
                            if (btn.dataset.filter === 'all') {
                                btn.classList.add('btn-outline-primary');
                            }
                        });

                        button.classList.add('active');
                        if (button.classList.contains('btn-outline-primary')) {
                            button.classList.remove('btn-outline-primary');
                            button.classList.add('btn-primary');
                        }

                        aplicarFiltro(button.dataset.filter || 'all');
                    });
                });

                if (searchInput) {
                    searchInput.addEventListener('input', function () {
                        const activeButton = modal.querySelector('.js-cobro-filter.active');
                        aplicarFiltro((activeButton && activeButton.dataset.filter) || 'all');
                    });
                }

                aplicarFiltro('all');
            });
        })();
    </script>
}

