@model SistemaControlEspaciosDeportivosWeb.ViewModels.PlataformaNegociosAdminViewModel
@{
    ViewData["Title"] = "Complejo deportivo";
}
@* Firma: FRANCO LARA - 09/05/2026 | Ajuste de etiquetas en Super Admin para reemplazar Club/Negocio por Complejo deportivo. *@
@* Firma: FRANCO LARA - 10/06/2026 | Agrega conciliacion de cobros comerciales con acciones diferidas y reorganiza la gestion comercial del super admin con resumen por negocio y modales por accion. *@
@* Firma: FRANCO LARA - 20/07/2026 | Corrige el contraste del historial comercial y de los pies de los modales de limites, contratos y cobros en modo oscuro. *@
@* Firma: FRANCO LARA - 21/07/2026 | Muestra el plan comercial vigente, permite aplicarlo con sus limites al guardar cada cobro y agrega reportes HTML imprimibles por complejo y consolidado. *@
@* Firma: FRANCO LARA - 01/09/2026 | Integra suspension manual/automatica, baja logica definitiva y reactivaciones auditadas del complejo y su servicio. *@
@* Firma: FRANCO LARA - 03/09/2026 | Rediseña el listado como resumen por complejo, concentra sus opciones en un detalle horizontal y adopta la paleta administrativa compartida. *@
<div class="page-header-card mb-3">
    <div class="page-header-main">
        <h1 class="page-title">Complejos deportivos registrados</h1>
        <p class="page-subtitle">Administra el servicio, la suscripcion y los limites operativos de cada complejo deportivo.</p>
    </div>
</div>

@if (TempData["PortalWebOk"] is string ok && !string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["PortalWebError"] is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger">@err</div>
}
@if (ViewData["SuspensionesAutomaticas"] is int suspensionesAutomaticas && suspensionesAutomaticas > 0)
{
    <div class="alert alert-warning">
        <i class="bi bi-pause-circle me-1"></i>
        Se suspendieron automaticamente <strong>@suspensionesAutomaticas</strong> complejo(s) cuya prueba o contrato ya vencieron.
    </div>
}

<style>
    .platform-negocio-action-btn {
        min-width: 0;
    }

    .platform-negocio-summary-badges {
        row-gap: .5rem;
    }

    .platform-negocio-modal .modal-dialog {
        --bs-modal-width: 980px;
    }

    .platform-negocio-modal .modal-footer,
    .platform-negocio-form-actions {
        position: sticky;
        bottom: 0;
        z-index: 3;
        padding-top: .85rem;
        padding-bottom: .2rem;
        margin-top: 1rem;
        background: color-mix(in srgb, var(--sc-admin-card-bg) 92%, transparent);
        border-top: 1px solid var(--sc-admin-border);
        backdrop-filter: blur(10px);
    }

    .platform-negocio-form-actions {
        display: flex;
        justify-content: flex-end;
        gap: .75rem;
    }

    html[data-theme="dark"] .platform-negocio-modal .modal-body {
        background: var(--sc-admin-card-bg);
        color: var(--sc-admin-text);
    }

    html[data-theme="dark"] .platform-negocio-modal .modal-footer,
    html[data-theme="dark"] .platform-negocio-modal .platform-negocio-form-actions {
        background: color-mix(in srgb, var(--sc-admin-card-bg) 92%, transparent);
        border-color: var(--sc-admin-border);
    }

    html[data-theme="dark"] .platform-negocio-modal .bg-light-subtle,
    html[data-theme="dark"] .platform-negocio-modal .js-mov-item,
    html[data-theme="dark"] .platform-negocio-modal .js-cobro-item {
        background-color: var(--sc-admin-card-bg) !important;
        color: var(--sc-admin-text);
    }

    html[data-theme="dark"] .platform-negocio-modal .border {
        border-color: var(--sc-admin-border) !important;
    }

    html[data-theme="dark"] .platform-negocio-modal .text-bg-light {
        background-color: color-mix(in srgb, var(--sc-admin-card-bg) 86%, var(--sc-admin-page-bg)) !important;
        color: var(--sc-admin-text) !important;
    }

    .platform-negocio-stack {
        display: grid;
        gap: .85rem;
        padding: 1rem;
    }

    .platform-negocio-card {
        overflow: hidden;
        border: 1px solid var(--sc-admin-border);
        border-radius: 1rem;
        background: var(--sc-admin-card-bg);
        transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
    }

    .platform-negocio-card:hover {
        border-color: color-mix(in srgb, var(--sc-admin-primary) 34%, var(--sc-admin-border));
        box-shadow: 0 .7rem 1.8rem color-mix(in srgb, var(--sc-admin-text) 8%, transparent);
        transform: translateY(-1px);
    }

    .platform-negocio-summary {
        display: grid;
        grid-template-columns: minmax(230px, 1.15fr) minmax(210px, .9fr) minmax(280px, 1.25fr) auto;
        gap: 1.25rem;
        align-items: center;
        padding: 1rem 1.1rem;
    }

    .platform-negocio-name {
        display: flex;
        gap: .75rem;
        align-items: flex-start;
    }

    .platform-negocio-avatar {
        display: grid;
        flex: 0 0 2.35rem;
        width: 2.35rem;
        height: 2.35rem;
        place-items: center;
        border-radius: .7rem;
        color: var(--sc-admin-on-color);
        background: var(--sc-admin-heading-bg);
    }

    .platform-negocio-label {
        display: block;
        margin-bottom: .32rem;
        color: var(--sc-admin-muted);
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .platform-negocio-metric-line {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem .85rem;
        color: var(--sc-admin-muted);
        font-size: .78rem;
    }

    .platform-negocio-detail-toggle {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        white-space: nowrap;
    }

    .platform-negocio-detail-toggle .bi-chevron-down {
        transition: transform .2s ease;
    }

    .platform-negocio-detail-toggle:not(.collapsed) .bi-chevron-down {
        transform: rotate(180deg);
    }

    .platform-negocio-detail-toggle.collapsed .platform-negocio-detail-label-expanded,
    .platform-negocio-detail-toggle:not(.collapsed) .platform-negocio-detail-label-collapsed {
        display: none;
    }

    .platform-negocio-detail-panel {
        border-top: 1px solid var(--sc-admin-border);
        background: color-mix(in srgb, var(--sc-admin-page-bg) 74%, var(--sc-admin-card-bg));
    }

    .platform-negocio-tabs {
        display: flex;
        gap: .35rem;
        overflow-x: auto;
        padding: .8rem 1rem;
        scrollbar-width: thin;
    }

    .platform-negocio-tab {
        display: inline-flex;
        align-items: center;
        gap: .42rem;
        flex: 0 0 auto;
        padding: .55rem .82rem;
        border: 0;
        border-radius: .65rem;
        color: var(--sc-admin-text);
        background: transparent;
        font-size: .8rem;
        font-weight: 700;
        text-decoration: none;
        transition: color .18s ease, background-color .18s ease, transform .18s ease;
    }

    .platform-negocio-tab:hover,
    .platform-negocio-tab:focus-visible {
        color: var(--sc-admin-primary);
        background: color-mix(in srgb, var(--sc-admin-primary) 10%, transparent);
        transform: translateY(-1px);
    }

    .platform-negocio-tab-danger {
        color: #b42318;
    }

    .platform-negocio-modal-host {
        display: none;
    }

    html[data-theme="dark"] .platform-negocio-card {
        border-color: var(--sc-admin-border);
        background: var(--sc-admin-card-bg);
    }

    html[data-theme="dark"] .platform-negocio-label,
    html[data-theme="dark"] .platform-negocio-metric-line {
        color: var(--sc-admin-muted);
    }

    html[data-theme="dark"] .platform-negocio-detail-panel {
        border-color: var(--sc-admin-border);
        background: color-mix(in srgb, var(--sc-admin-page-bg) 72%, var(--sc-admin-card-bg));
    }

    html[data-theme="dark"] .platform-negocio-tab {
        color: var(--sc-admin-text);
    }

    html[data-theme="dark"] .platform-negocio-tab:hover,
    html[data-theme="dark"] .platform-negocio-tab:focus-visible {
        color: var(--sc-admin-on-color);
        background: color-mix(in srgb, var(--sc-admin-primary) 28%, transparent);
    }

    html[data-theme="dark"] .platform-negocio-tab-danger {
        color: #fda4af;
    }

    @@media (max-width: 1200px) {
        .platform-negocio-summary {
            grid-template-columns: minmax(220px, 1fr) minmax(210px, .9fr) minmax(250px, 1fr);
        }

        .platform-negocio-summary-action {
            grid-column: 1 / -1;
            justify-self: end;
        }
    }

    @@media (max-width: 767.98px) {
        .platform-negocio-summary {
            grid-template-columns: 1fr;
            gap: .9rem;
        }

        .platform-negocio-summary-action {
            grid-column: auto;
            justify-self: stretch;
        }

        .platform-negocio-detail-toggle {
            justify-content: center;
            width: 100%;
        }
    }
</style>

<section class="table-card sc-reservas-list-card p-3 mb-3">
    <form asp-action="Negocios" method="get" class="row g-2 align-items-end">
        <div class="col-md-5 col-lg-4">
            <label class="form-label">Buscar complejo deportivo</label>
            <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Nombre comercial" />
        </div>
        <div class="col-md-4 col-lg-3">
            <label class="form-label">Estado comercial</label>
            <select class="form-select" name="estadoContrato">
                <option value="todos" selected="@(Model.EstadoContrato == "todos" ? "selected" : null)">Todos</option>
                <option value="con-contrato" selected="@(Model.EstadoContrato == "con-contrato" ? "selected" : null)">Con contrato</option>
                <option value="sin-contrato" selected="@(Model.EstadoContrato == "sin-contrato" ? "selected" : null)">Sin contrato</option>
                <option value="prueba-por-vencer" selected="@(Model.EstadoContrato == "prueba-por-vencer" ? "selected" : null)">Prueba por vencer</option>
                <option value="suspendidos" selected="@(Model.EstadoContrato == "suspendidos" ? "selected" : null)">Suspendidos</option>
                <option value="dados-de-baja" selected="@(Model.EstadoContrato == "dados-de-baja" ? "selected" : null)">Dados de baja</option>
            </select>
        </div>
        <div class="col-md-3 col-lg-2 d-grid">
            <button type="submit" class="btn btn-primary btn-accion-filtro"><i class="bi bi-search me-1"></i>Buscar</button>
        </div>
        <div class="col-md-3 col-lg-1 d-grid">
            <a asp-action="Negocios" class="btn btn-outline-secondary btn-cancelar">Limpiar</a>
        </div>
        <div class="col-md-3 col-lg-2 d-grid">
            <a asp-action="ReporteNegocios"
               asp-route-buscar="@Model.Buscar"
               asp-route-estadoContrato="@Model.EstadoContrato"
               target="_blank"
               rel="noopener"
               class="btn btn-outline-primary">
                <i class="bi bi-printer me-1"></i>Reporte
            </a>
        </div>
    </form>
</section>

<section class="table-card sc-reservas-list-card p-0 overflow-hidden">
    <div class="table-card-header d-flex justify-content-between align-items-center">
        <h2 class="table-card-title platform-card-title"><span class="platform-card-icon"><i class="bi bi-diagram-3"></i></span><span class="platform-card-title-text">Complejos deportivos listados</span></h2>
        <span class="badge text-bg-light border">Pagina @Model.Pagina de @Model.TotalPaginas</span>
    </div>
    <div class="platform-negocio-stack">
        @if (Model.Negocios.Count == 0)
        {
            <div class="text-center text-muted py-4">No se encontraron complejos deportivos.</div>
        }
        else
        {
            foreach (var item in Model.Negocios)
            {
                        var modalLimitesId = $"limitesNegocioModal{item.NegocioId}";
                        var modalServicioId = $"servicioNegocioModal{item.NegocioId}";
                        var modalContratoId = $"contratoNegocioModal{item.NegocioId}";
                        var modalCobroId = $"cobroNegocioModal{item.NegocioId}";
                        var modalGestionId = $"gestionComercialModal{item.NegocioId}";
                        var detalleNegocioId = $"detalleNegocio{item.NegocioId}";
                        var tieneContratoActivo = item.EstadoSuscripcion == 2
                            && !item.EsPrueba
                            && !string.IsNullOrWhiteSpace(item.TipoCobro)
                            && item.FechaFinPlan.HasValue;
                        var contratoEnGracia = tieneContratoActivo
                            && item.FechaFinPlan.HasValue
                            && item.FechaFinGracia.HasValue
                            && item.FechaFinPlan.Value.Date < DateTime.Today.Date
                            && item.FechaFinGracia.Value.Date >= DateTime.Today.Date;
                        var fechaInicioObjetivoDefault = item.FechaFinPlan.HasValue && item.FechaFinPlan.Value.Date >= DateTime.Today.Date
                            ? DateOnly.FromDateTime(item.FechaFinPlan.Value.Date)
                            : DateOnly.FromDateTime(DateTime.Today);
                        var pruebaPorVencer = item.Activo
                            && item.EstadoSuscripcion == 1
                            && item.EsPrueba
                            && item.FechaFinPrueba.HasValue
                            && item.FechaFinPrueba.Value.Date >= DateTime.Today.Date
                            && item.FechaFinPrueba.Value.Date <= DateTime.Today.AddDays(7).Date;
                        var totalPagosPagados = item.HistorialCobros.Count(p => p.EstadoPago == "PAGADO");
                        var totalPagosPendientes = item.HistorialCobros.Count(p => p.EstadoPago == "PENDIENTE");
                        var totalPagosAplicados = item.HistorialCobros.Count(p => p.AplicadoSuscripcion);
                        var totalPagosNoAplicados = item.HistorialCobros.Count(p => p.AplicarAlConfirmar && !p.AplicadoSuscripcion);
                        <article class="platform-negocio-card">
                            <div class="platform-negocio-summary">
                                <section class="platform-negocio-name">
                                    <span class="platform-negocio-avatar" aria-hidden="true"><i class="bi bi-buildings"></i></span>
                                    <div>
                                        <span class="platform-negocio-label">Complejo deportivo</span>
                                        <strong>@item.NombreComercial</strong>
                                        <div class="text-muted small">ID @item.NegocioId</div>
                                        <div class="d-flex flex-wrap gap-1 mt-2">
                                            @if (item.Activo)
                                            {
                                                <span class="badge text-bg-success">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-dark">Baja definitiva</span>
                                            }
                                    <span class="badge text-bg-@(item.EstadoSuscripcion is 1 or 2 ? "success" : item.EstadoSuscripcion == 3 ? "danger" : item.EstadoSuscripcion == 4 ? "warning text-dark" : "secondary")">@item.EstadoSuscripcionNombre</span>
                                    @if (pruebaPorVencer)
                                    {
                                        <span class="badge text-bg-warning text-dark">Prueba por vencer</span>
                                    }
                                    @if (contratoEnGracia)
                                    {
                                        <span class="badge text-bg-warning text-dark">En gracia</span>
                                    }
                                    else if (tieneContratoActivo)
                                    {
                                        <span class="badge text-bg-info">Contrato activo</span>
                                    }
                                        </div>
                                    </div>
                                </section>

                                <section>
                                    <span class="platform-negocio-label">Capacidad del plan</span>
                                    <strong>@SistemaControlEspaciosDeportivosWeb.Services.PlanComercialCatalog.Obtener(item.PlanComercial).Nombre</strong>
                                    <div class="platform-negocio-metric-line mt-2">
                                        <span><i class="bi bi-geo-alt me-1"></i>@item.SedesPermitidas sedes</span>
                                        <span><i class="bi bi-grid me-1"></i>@item.EspaciosPermitidos espacios</span>
                                        <span><i class="bi bi-people me-1"></i>@item.UsuariosPermitidos usuarios</span>
                                    </div>
                                </section>

                                <section>
                                    <span class="platform-negocio-label">Suscripcion y actividad</span>
                                    @if (item.EsPrueba && item.FechaFinPrueba.HasValue)
                                    {
                                        <div class="small">Prueba hasta @item.FechaFinPrueba.Value.ToString("dd/MM/yyyy")</div>
                                    }
                                    else if (!item.EsPrueba && item.FechaFinPlan.HasValue)
                                    {
                                        <div class="small">@item.TipoCobro · @item.FechaInicioPlan?.ToString("dd/MM/yyyy") al @item.FechaFinPlan?.ToString("dd/MM/yyyy")</div>
                                        <div class="small text-muted">Gracia: @item.DiasGracia dias · hasta @item.FechaFinGracia?.ToString("dd/MM/yyyy")</div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">Sin contrato activo.</div>
                                    }
                                    <div class="platform-negocio-metric-line mt-2">
                                        <span>Cobrado: <strong>S/ @item.MontoTotalCobrado.ToString("0.00")</strong></span>
                                        <span>Cobros: <strong>@item.CantidadCobrosRegistrados</strong></span>
                                        <span>Movimientos: <strong>@item.HistorialComercial.Count</strong></span>
                                    </div>
                                </section>

                                <section class="platform-negocio-summary-action">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary platform-negocio-detail-toggle collapsed"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#@detalleNegocioId"
                                            aria-expanded="false"
                                            aria-controls="@detalleNegocioId">
                                        <span class="platform-negocio-detail-label-collapsed">Ver detalle</span>
                                        <span class="platform-negocio-detail-label-expanded">Ocultar detalle</span>
                                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                    </button>
                                </section>
                            </div>

                            <div class="collapse platform-negocio-detail-panel" id="@detalleNegocioId">
                                <div class="platform-negocio-tabs" role="toolbar" aria-label="Opciones de @item.NombreComercial">
                                    <button type="button" class="platform-negocio-tab platform-negocio-tab-danger" data-bs-toggle="modal" data-bs-target="#@modalServicioId">
                                        <i class="bi bi-power"></i><span>@(!item.Activo ? "Reactivar complejo" : item.EstadoSuscripcion == 4 ? "Reactivar servicio" : "Servicio")</span>
                                    </button>
                                    @if (item.Activo)
                                    {
                                        <button type="button" class="platform-negocio-tab" data-bs-toggle="modal" data-bs-target="#@modalLimitesId"><i class="bi bi-sliders2"></i><span>Limites</span></button>
                                        <button type="button" class="platform-negocio-tab" data-bs-toggle="modal" data-bs-target="#@modalContratoId"><i class="bi bi-journal-check"></i><span>Contrato</span></button>
                                        <button type="button" class="platform-negocio-tab" data-bs-toggle="modal" data-bs-target="#@modalCobroId"><i class="bi bi-cash-coin"></i><span>Cobros</span></button>
                                    }
                                    <button type="button" class="platform-negocio-tab" data-bs-toggle="modal" data-bs-target="#@modalGestionId"><i class="bi bi-clock-history"></i><span>Historial</span></button>
                                    <a asp-action="ReporteNegocio" asp-route-negocioId="@item.NegocioId" target="_blank" rel="noopener" class="platform-negocio-tab"><i class="bi bi-printer"></i><span>Reporte</span></a>
                                </div>
                            </div>
                        </article>
                        <div class="platform-negocio-modal-host">
                        <div class="modal fade platform-negocio-modal" id="@modalServicioId" tabindex="-1" aria-labelledby="@(modalServicioId)Label" aria-hidden="true">
                            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                                <div class="modal-content sc-modal-content">
                                    <div class="modal-header sc-modal-header">
                                        <div class="sc-modal-title-wrap">
                                            <h5 class="modal-title sc-modal-title" id="@(modalServicioId)Label">Gestion del servicio</h5>
                                            <p class="sc-modal-subtitle">Suspende o reactiva la operacion de @item.NombreComercial sin eliminar su informacion.</p>
                                        </div>
                                        <button type="button" class="btn-close sc-modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                    </div>
                                    <div class="modal-body sc-modal-body">
                                        <div class="border rounded-3 p-3 mb-3 bg-light-subtle">
                                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                                <strong>Estado actual:</strong>
                                                @if (!item.Activo)
                                                {
                                                    <span class="badge text-bg-dark">Baja definitiva</span>
                                                }
                                                <span class="badge text-bg-@(item.EstadoSuscripcion == 4 ? "warning text-dark" : item.EstadoSuscripcion is 1 or 2 ? "success" : "secondary")">@item.EstadoSuscripcionNombre</span>
                                                <span class="badge text-bg-light border">@(item.EsPrueba ? "Prueba" : SistemaControlEspaciosDeportivosWeb.Services.PlanComercialCatalog.Obtener(item.PlanComercial).Nombre)</span>
                                            </div>
                                            @if (!item.Activo)
                                            {
                                                <p class="small text-muted mb-0">La baja bloquea completamente el acceso y la visibilidad publica, pero conserva todos los datos e historial.</p>
                                            }
                                            else
                                            {
                                                <p class="small text-muted mb-0">Al suspender, el complejo deja de aparecer en el portal publico y solo conserva acceso a Dashboard y Mi suscripcion. Sus datos, plan y vigencia se mantienen.</p>
                                            }
                                        </div>

                                        @if (!item.Activo)
                                        {
                                            var ultimaBaja = item.HistorialComercial
                                                .Where(x => string.Equals(x.TipoMovimiento, "BAJA_COMPLEJO", StringComparison.OrdinalIgnoreCase))
                                                .OrderByDescending(x => x.FechaCreacion)
                                                .FirstOrDefault();
                                            <div class="alert alert-danger">
                                                <strong>El complejo se encuentra dado de baja.</strong>
                                                @if (ultimaBaja is not null)
                                                {
                                                    <div class="small mt-1">@ultimaBaja.FechaCreacion.ToString("dd/MM/yyyy HH:mm") · @ultimaBaja.Observacion</div>
                                                }
                                            </div>
                                            <form asp-action="ReactivarComplejoNegocio" method="post" class="row g-3" onsubmit="return confirm('Se reactivara el complejo, pero su servicio permanecera suspendido. Deseas continuar?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="negocioId" value="@item.NegocioId" />
                                                <input type="hidden" name="buscar" value="@Model.Buscar" />
                                                <input type="hidden" name="estadoContrato" value="@Model.EstadoContrato" />
                                                <input type="hidden" name="pagina" value="@Model.Pagina" />
                                                <div class="col-12">
                                                    <label class="form-label">Observacion de reactivacion</label>
                                                    <textarea name="observacion" maxlength="500" rows="3" class="form-control" placeholder="Motivo o autorizacion para recuperar el complejo"></textarea>
                                                </div>
                                                <div class="col-12 platform-negocio-form-actions">
                                                    <button type="button" class="btn btn-outline-secondary btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-success btn-grabar"><i class="bi bi-building-check me-1"></i>Reactivar complejo</button>
                                                </div>
                                            </form>
                                        }
                                        else if (item.EstadoSuscripcion == 4)
                                        {
                                            var ultimaSuspension = item.HistorialComercial
                                                .Where(x => x.TipoMovimiento.StartsWith("SUSPENSION", StringComparison.OrdinalIgnoreCase))
                                                .OrderByDescending(x => x.FechaCreacion)
                                                .FirstOrDefault();
                                            @if (ultimaSuspension is not null)
                                            {
                                                <div class="alert alert-warning">
                                                    <div><strong>Suspension:</strong> @ultimaSuspension.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</div>
                                                    <div class="small">@ultimaSuspension.Observacion</div>
                                                </div>
                                            }
                                            <form asp-action="ReactivarServicioNegocio" method="post" class="row g-3" onsubmit="return confirm('Se reactivara el servicio del complejo deportivo. Deseas continuar?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="negocioId" value="@item.NegocioId" />
