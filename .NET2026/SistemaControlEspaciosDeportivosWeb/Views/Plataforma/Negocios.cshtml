                                                            }
                                                            else
                                                            {
                                                                <div class="d-flex flex-column gap-2">
                                                                    @foreach (var mov in item.HistorialComercial)
                                                                    {
                                                                        var movSearch = string.Join(" ",
                                                                            mov.TipoMovimientoNombre ?? string.Empty,
                                                                            mov.TipoCobroAnterior ?? string.Empty,
                                                                            mov.TipoCobroNuevo ?? string.Empty,
                                                                            mov.Observacion ?? string.Empty,
                                                                            mov.UsuarioCreacion ?? string.Empty,
                                                                            mov.FechaCreacion.ToString("dd/MM/yyyy HH:mm"));
                                                                        <div class="border rounded-3 p-2 bg-white js-mov-item" data-search="@movSearch.ToLowerInvariant()">
                                                                            <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                                                                <span class="badge text-bg-light border">@mov.TipoMovimientoNombre</span>
                                                                                <small class="text-muted">@mov.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
                                                                            </div>
                                                                            <div class="small mt-1">
                                                                                @if (mov.FechaInicioReferencia.HasValue || mov.FechaFinReferencia.HasValue)
                                                                                {
                                                                                    <div>Vigencia: @(mov.FechaInicioReferencia?.ToString("dd/MM/yyyy") ?? "-") - @(mov.FechaFinReferencia?.ToString("dd/MM/yyyy") ?? "-")</div>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(mov.TipoCobroNuevo))
                                                                                {
                                                                                    <div>Plan: @(string.IsNullOrWhiteSpace(mov.TipoCobroAnterior) ? "-" : mov.TipoCobroAnterior) -> @mov.TipoCobroNuevo</div>
                                                                                }
                                                                                @if (mov.DiasExtra > 0)
                                                                                {
                                                                                    <div>Dias extra: @mov.DiasExtra</div>
                                                                                }
                                                                                @if (mov.DiasGracia > 0)
                                                                                {
                                                                                    <div>Dias de gracia acumulados: @mov.DiasGracia</div>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(mov.Observacion))
                                                                                {
                                                                                    <div>Nota: @mov.Observacion</div>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-7">
                                                        <div class="border rounded-3 p-3 h-100">
                                                            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2">
                                                                <div>
                                                                    <h6 class="mb-0 text-success">Historial de cobros</h6>
                                                                    <div class="small text-muted">Filtros rapidos por estado del cobro y conciliacion.</div>
                                                                </div>
                                                                <span class="badge text-bg-light border js-cobro-filter-count">@item.HistorialCobros.Count registro(s)</span>
                                                            </div>

                                                            <div class="d-flex flex-wrap gap-2 mb-3">
                                                                <button type="button" class="btn btn-sm btn-primary js-cobro-filter active" data-filter="all">Todos</button>
                                                                <button type="button" class="btn btn-sm btn-outline-success js-cobro-filter" data-filter="paid">Pagados</button>
                                                                <button type="button" class="btn btn-sm btn-outline-warning js-cobro-filter" data-filter="pending">Pendientes</button>
                                                                <button type="button" class="btn btn-sm btn-outline-info js-cobro-filter" data-filter="applied">Aplicados</button>
                                                                <button type="button" class="btn btn-sm btn-outline-secondary js-cobro-filter" data-filter="unapplied">No aplicados</button>
                                                            </div>

                                                            @if (item.HistorialCobros.Count == 0)
                                                            {
                                                                <div class="small text-muted">Aun no existen cobros registrados para este complejo deportivo.</div>
                                                            }
                                                            else
                                                            {
                                                                <div class="d-flex flex-column gap-2">
                                                                    @foreach (var pago in item.HistorialCobros)
                                                                    {
                                                                        var estadoPagoCss = pago.EstadoPago == "PAGADO" ? "success" : pago.EstadoPago == "PENDIENTE" ? "warning" : pago.EstadoPago == "OBSERVADO" ? "secondary" : "danger";
                                                                        var estadoAplicacion = pago.AplicadoSuscripcion ? "applied" : (pago.AplicarAlConfirmar ? "unapplied" : "none");
                                                                        var pagoSearch = string.Join(" ",
                                                                            pago.TipoPago ?? string.Empty,
                                                                            pago.EstadoPago ?? string.Empty,
                                                                            pago.OperacionNumero ?? string.Empty,
                                                                            pago.EntidadFinanciera ?? string.Empty,
                                                                            pago.ReferenciaExterna ?? string.Empty,
                                                                            pago.AccionAplicacion ?? string.Empty,
                                                                            pago.TipoCobroObjetivo ?? string.Empty,
                                                                            pago.Observacion ?? string.Empty,
                                                                            pago.UsuarioCreacion ?? string.Empty,
                                                                            pago.FechaPago.ToString("dd/MM/yyyy HH:mm"));
                                                                        <div class="border rounded-3 p-2 bg-white js-cobro-item"
                                                                             data-estado="@((pago.EstadoPago ?? string.Empty).ToLowerInvariant())"
                                                                             data-aplicacion="@estadoAplicacion"
                                                                             data-search="@pagoSearch.ToLowerInvariant()">
                                                                            <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                                                                <div class="d-flex flex-wrap gap-2">
                                                                                    <span class="badge text-bg-light border">@pago.TipoPago</span>
                                                                                    <span class="badge text-bg-@estadoPagoCss">@pago.EstadoPago</span>
                                                                                    @if (pago.AplicadoSuscripcion)
                                                                                    {
                                                                                        <span class="badge text-bg-info">Aplicado</span>
                                                                                    }
                                                                                    else if (pago.AplicarAlConfirmar)
                                                                                    {
                                                                                        <span class="badge text-bg-secondary">No aplicado</span>
                                                                                    }
                                                                                </div>
                                                                                <small class="text-muted">@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</small>
                                                                            </div>
