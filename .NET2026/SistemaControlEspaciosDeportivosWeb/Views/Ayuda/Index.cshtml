@model SistemaControlEspaciosDeportivosWeb.ViewModels.Ayuda.AyudaIndexViewModel
@* Firma: FRANCO LARA - 07/09/2026 | Rediseña la ayuda como catalogo operativo por categorias y modulos, con busqueda contextual y FAQ actualizado. *@
@{
    ViewData["Title"] = "Ayuda operativa";
    ViewData["AdminShell"] = true;
    ViewData["AdminNegocioId"] = Model.Base.NegocioId;
}

<section class="admin-page-frame sport-help-page" data-sport-help-root
         data-help-default-category="@Model.CategoriaSeleccionadaClave"
         data-help-default-module="@Model.ModuloSeleccionadoClave">
    <header class="sport-help-hero">
        <div class="sport-help-hero-copy">
            <span class="sport-help-kicker">Operación</span>
            <h1><i class="bi bi-question-circle" aria-hidden="true"></i> Ayuda operativa</h1>
            <p>Guía organizada para administrar el complejo deportivo y resolver las tareas diarias del panel.</p>
        </div>
        <div class="sport-help-status" aria-live="polite">
            <span>Módulo activo</span>
            <strong data-help-active-module>@Model.ModuloSeleccionadoTitulo</strong>
            <small>@Model.TotalPreguntas preguntas disponibles</small>
            <small>Categoría: <b data-help-active-category>@Model.CategoriaSeleccionadaClave</b></small>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.ModuloSolicitado))
    {
        <div class="sport-help-context">
            <i class="bi bi-compass" aria-hidden="true"></i>
            <div><strong>Ayuda contextual activada</strong><span>El catálogo se abrió en <b>@Model.ModuloSeleccionadoTitulo</b>.</span></div>
        </div>
    }

    <div class="sport-help-layout">
        <aside class="sport-help-sidebar" aria-label="Categorías de ayuda">
            @foreach (var categoria in Model.Categorias)
            {
                var categoriaActiva = categoria.Clave == Model.CategoriaSeleccionadaClave;
                <button type="button" class="sport-help-category @(categoriaActiva ? "is-active" : string.Empty)"
                        data-help-category-tab="@categoria.Clave" aria-pressed="@(categoriaActiva ? "true" : "false")">
                    <span class="sport-help-category-icon"><i class="bi @categoria.Icono" aria-hidden="true"></i></span>
                    <span><strong>@categoria.Titulo</strong><small>@categoria.Modulos.Count módulos</small></span>
                </button>
            }
        </aside>

        <div class="sport-help-content">
            <div class="sport-help-search-card">
                <label for="sportHelpSearch">Buscar en el módulo visible</label>
                <div class="sport-help-search-control">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input id="sportHelpSearch" type="search" class="form-control"
                           placeholder="Buscar por reserva, pago, espacio, comprobante..."
                           autocomplete="off" data-help-search />
                </div>
                <small data-help-search-state>Mostrando todas las preguntas del módulo visible.</small>
            </div>

            @foreach (var categoria in Model.Categorias)
            {
                <section class="sport-help-category-panel @(categoria.Clave == Model.CategoriaSeleccionadaClave ? "is-active" : string.Empty)"
                         data-help-category-panel="@categoria.Clave">
                    <div class="sport-help-section">
                        <header class="sport-help-section-header">
                            <span><i class="bi @categoria.Icono" aria-hidden="true"></i></span>
                            <div><small>Categoría</small><h2>@categoria.Titulo</h2></div>
                            <p>@categoria.Descripcion</p>
                        </header>
                        <div class="sport-help-modules" role="tablist" aria-label="Módulos de @categoria.Titulo">
                            @foreach (var modulo in categoria.Modulos)
                            {
                                var activo = modulo.Clave == Model.ModuloSeleccionadoClave;
                                <button type="button" class="sport-help-module-tab @(activo ? "is-active" : string.Empty)"
                                        data-help-module-tab="@modulo.Clave" data-help-module-title="@modulo.Titulo"
                                        role="tab" aria-selected="@(activo ? "true" : "false")">
                                    <i class="bi @modulo.Icono" aria-hidden="true"></i>
                                    <span>@modulo.Titulo</span><small>@modulo.Preguntas.Count FAQ</small>
                                </button>
                            }
                        </div>
                    </div>

                    @foreach (var modulo in categoria.Modulos)
                    {
                        var activo = modulo.Clave == Model.ModuloSeleccionadoClave;
                        var accordionId = $"sport-help-{modulo.Clave.ToLowerInvariant()}";
                        <article class="sport-help-section sport-help-module-panel @(activo ? "is-active" : string.Empty)"
                                 data-help-module-panel="@modulo.Clave" data-help-module-title="@modulo.Titulo">
                            <header class="sport-help-section-header sport-help-module-header">
                                <span><i class="bi @modulo.Icono" aria-hidden="true"></i></span>
                                <div><small>Módulo</small><h2>@modulo.Titulo</h2></div>
                                <p>@modulo.Resumen</p>
                            </header>
                            <div class="accordion sport-help-accordion" id="@accordionId">
                                @{ var indice = 0; }
                                @foreach (var pregunta in modulo.Preguntas)
                                {
                                    var abierta = activo && indice == 0;
                                    <div class="accordion-item sport-help-question" data-help-question
                                         data-help-search-text="@($"{pregunta.Pregunta} {pregunta.Respuesta}".ToLowerInvariant())">
                                        <h3 class="accordion-header">
                                            <button class="accordion-button @(abierta ? string.Empty : "collapsed")" type="button"
                                                    data-bs-toggle="collapse" data-bs-target="#@pregunta.Id"
                                                    aria-expanded="@(abierta ? "true" : "false")" aria-controls="@pregunta.Id">
                                                @pregunta.Pregunta
                                            </button>
                                        </h3>
                                        <div id="@pregunta.Id" class="accordion-collapse collapse @(abierta ? "show" : string.Empty)"
                                             data-bs-parent="#@accordionId">
                                            <div class="accordion-body">@pregunta.Respuesta</div>
                                        </div>
                                    </div>
                                    indice++;
                                }
                            </div>
                            <div class="sport-help-empty" data-help-empty hidden>
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <strong>No encontramos coincidencias</strong>
                                <span>Prueba con una palabra más corta o revisa otro módulo.</span>
                            </div>
                        </article>
                    }
                </section>
            }
        </div>
    </div>
</section>

@section Scripts {
<script>
(() => {
    const root = document.querySelector("[data-sport-help-root]");
    if (!root) return;

    const categoryButtons = [...root.querySelectorAll("[data-help-category-tab]")];
    const categoryPanels = [...root.querySelectorAll("[data-help-category-panel]")];
    const moduleButtons = [...root.querySelectorAll("[data-help-module-tab]")];
    const modulePanels = [...root.querySelectorAll("[data-help-module-panel]")];
    const searchInput = root.querySelector("[data-help-search]");
    const searchState = root.querySelector("[data-help-search-state]");
    const activeModuleLabel = root.querySelector("[data-help-active-module]");
    const activeCategoryLabel = root.querySelector("[data-help-active-category]");

    const visibleModulePanel = () => modulePanels.find(panel => panel.classList.contains("is-active") &&
        panel.closest("[data-help-category-panel]")?.classList.contains("is-active"));

    const filterQuestions = () => {
        const panel = visibleModulePanel();
        if (!panel) return;
        const term = (searchInput?.value || "").trim().toLocaleLowerCase("es");
        const questions = [...panel.querySelectorAll("[data-help-question]")];
        let visible = 0;
        questions.forEach(question => {
            const matches = !term || (question.dataset.helpSearchText || "").includes(term);
            question.hidden = !matches;
            if (matches) visible++;
        });
        const empty = panel.querySelector("[data-help-empty]");
        if (empty) empty.hidden = visible > 0;
        if (searchState) searchState.textContent = !term
            ? `Mostrando las ${questions.length} preguntas del módulo visible.`
            : `${visible} resultado${visible === 1 ? "" : "s"} para “${searchInput.value.trim()}”.`;
    };

    const updateUrl = moduleKey => {
        const url = new URL(window.location.href);
        url.searchParams.set("modulo", moduleKey);
        window.history.replaceState({}, "", url);
    };

    const activateModule = (moduleKey, updateHistory = true) => {
        modulePanels.forEach(panel => panel.classList.toggle("is-active", panel.dataset.helpModulePanel === moduleKey));
        moduleButtons.forEach(button => {
            const active = button.dataset.helpModuleTab === moduleKey &&
                button.closest("[data-help-category-panel]")?.classList.contains("is-active");
            button.classList.toggle("is-active", active);
            button.setAttribute("aria-selected", active ? "true" : "false");
        });
        const button = moduleButtons.find(item => item.dataset.helpModuleTab === moduleKey && item.classList.contains("is-active"));
        if (activeModuleLabel) activeModuleLabel.textContent = button?.dataset.helpModuleTitle || moduleKey;
        if (searchInput) searchInput.value = "";
        filterQuestions();
        if (updateHistory) updateUrl(moduleKey);
    };

    const activateCategory = (categoryKey, preferredModule, updateHistory = true) => {
        categoryButtons.forEach(button => {
            const active = button.dataset.helpCategoryTab === categoryKey;
            button.classList.toggle("is-active", active);
            button.setAttribute("aria-pressed", active ? "true" : "false");
        });
        categoryPanels.forEach(panel => panel.classList.toggle("is-active", panel.dataset.helpCategoryPanel === categoryKey));
        if (activeCategoryLabel) activeCategoryLabel.textContent = categoryKey;
        const panel = categoryPanels.find(item => item.dataset.helpCategoryPanel === categoryKey);
        const buttons = panel ? [...panel.querySelectorAll("[data-help-module-tab]")] : [];
        const moduleKey = buttons.some(button => button.dataset.helpModuleTab === preferredModule)
            ? preferredModule : buttons[0]?.dataset.helpModuleTab;
        if (moduleKey) activateModule(moduleKey, updateHistory);
    };

    categoryButtons.forEach(button => button.addEventListener("click", () =>
        activateCategory(button.dataset.helpCategoryTab || "", null)));
    moduleButtons.forEach(button => button.addEventListener("click", () => {
        const category = button.closest("[data-help-category-panel]")?.dataset.helpCategoryPanel || "";
        activateCategory(category, button.dataset.helpModuleTab || "");
    }));
    searchInput?.addEventListener("input", filterQuestions);
    activateCategory(root.dataset.helpDefaultCategory || "GENERAL", root.dataset.helpDefaultModule || "DASHBOARD", false);
})();
</script>
}
