@model SistemaControlEspaciosDeportivosWeb.ViewModels.ModuloBaseViewModel
@* Firma: FRANCO LARA - 29/09/2026 | Integra el mapa operativo interactivo dentro del panel administrativo con el permiso de Ayuda. *@
@{
    ViewData["Title"] = "Mapa operativo";
    ViewData["AdminShell"] = true;
    ViewData["AdminNegocioId"] = Model.NegocioId;
    var contenidoMapaUrl = Url.Action("ContenidoMapaOperativo", "Ayuda", new { negocioId = Model.NegocioId });
}

<section class="admin-page-frame sport-map-page">
    <header class="sport-map-hero">
        <div>
            <span class="sport-help-kicker">Ayuda operativa</span>
            <h1><i class="bi bi-diagram-3" aria-hidden="true"></i> Mapa operativo</h1>
            <p>Explore cómo se conectan los módulos, datos, validaciones y acciones del panel administrativo.</p>
        </div>
        <a class="btn btn-outline-light sport-map-back-link"
           asp-action="Index" asp-controller="Ayuda" asp-route-negocioId="@Model.NegocioId">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Volver a ayuda
        </a>
    </header>

    <section class="sport-map-frame-card" aria-label="Mapa operativo interactivo">
        <iframe class="sport-map-frame"
                data-sport-map-frame
                src="@contenidoMapaUrl"
                title="Mapa operativo interactivo"
                loading="eager"
                referrerpolicy="same-origin"></iframe>
    </section>
</section>

@section Scripts {
<script>
(() => {
    const frame = document.querySelector('[data-sport-map-frame]');
    if (!frame) return;

    const ajustarAltura = () => {
        const documento = frame.contentDocument;
        if (!documento) return;

        const altura = Math.max(
            documento.documentElement.scrollHeight,
            documento.body?.scrollHeight || 0,
            760);

        frame.style.height = `${altura}px`;
    };

    frame.addEventListener('load', () => {
        ajustarAltura();
        window.setTimeout(ajustarAltura, 150);
        window.setTimeout(ajustarAltura, 700);

        const documento = frame.contentDocument;
        if (documento?.documentElement && 'ResizeObserver' in window) {
            new ResizeObserver(ajustarAltura).observe(documento.documentElement);
        }
    });

    window.addEventListener('resize', ajustarAltura);
})();
</script>
}
