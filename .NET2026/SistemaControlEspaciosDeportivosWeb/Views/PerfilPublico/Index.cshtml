@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const dep = document.getElementById('CodigoDepartamento');
            const prov = document.getElementById('CodigoProvincia');
            const dist = document.getElementById('CodigoUbigeo');
            const depEquipo = document.getElementById('CodigoDepartamentoEquipo');
            const provEquipo = document.getElementById('CodigoProvinciaEquipo');
            const distEquipo = document.getElementById('CodigoUbigeoEquipo');

            function renderOptions(select, rows, emptyText) {
                if (!select) return;
                select.innerHTML = '';
                const first = document.createElement('option');
                first.value = '';
                first.textContent = emptyText;
                select.appendChild(first);
                (rows || []).forEach(x => {
                    const opt = document.createElement('option');
                    opt.value = x.value || '';
                    opt.textContent = x.text || '';
                    select.appendChild(opt);
                });
            }

            async function enlazarUbigeo(depSelect, provSelect, distSelect) {
                if (!depSelect || !provSelect || !distSelect) return;

                depSelect.addEventListener('change', async () => {
                    const codigo = (depSelect.value || '').trim();
                    renderOptions(provSelect, [], 'Selecciona');
                    renderOptions(distSelect, [], 'Selecciona');
                    if (codigo.length !== 2) return;
                    const resp = await fetch(`@Url.Action("UbigeoProvincias", "Home")?codigoDepartamento=${encodeURIComponent(codigo)}`, { cache: 'no-store' });
                    if (!resp.ok) return;
                    renderOptions(provSelect, await resp.json(), 'Selecciona');
                });

                provSelect.addEventListener('change', async () => {
                    const codigo = (provSelect.value || '').trim();
                    renderOptions(distSelect, [], 'Selecciona');
                    if (codigo.length !== 4) return;
                    const resp = await fetch(`@Url.Action("UbigeoDistritos", "Home")?codigoProvincia=${encodeURIComponent(codigo)}`, { cache: 'no-store' });
                    if (!resp.ok) return;
                    renderOptions(distSelect, await resp.json(), 'Selecciona');
                });
            }

            enlazarUbigeo(dep, prov, dist);
            enlazarUbigeo(depEquipo, provEquipo, distEquipo);

            const reservaList = document.getElementById('profileReservaList');
            const sortSelect = document.getElementById('reservasSort');
            const filterButtons = Array.from(document.querySelectorAll('.profile-filter-chip'));

            if (reservaList) {
                const rows = Array.from(reservaList.querySelectorAll('.profile-reserva-row'));
                let activeFilter = 'all';

                const aplicarFiltro = () => {
                    rows.forEach(row => {
                        const status = (row.getAttribute('data-status') || '').toLowerCase();
                        const visible = activeFilter === 'all' || status === activeFilter;
                        row.hidden = !visible;
                    });
                };

                const aplicarOrden = () => {
                    const order = sortSelect?.value === 'asc' ? 'asc' : 'desc';
                    rows.sort((a, b) => {
                        const da = new Date(a.getAttribute('data-start') || '');
                        const db = new Date(b.getAttribute('data-start') || '');
                        return order === 'asc' ? da - db : db - da;
                    });
                    rows.forEach(row => reservaList.appendChild(row));
                };

                const actualizarChips = () => {
                    filterButtons.forEach(btn => {
                        btn.classList.toggle('is-active', (btn.getAttribute('data-filter') || '') === activeFilter);
                    });
                };

                filterButtons.forEach(btn => {
                    btn.addEventListener('click', () => {
                        activeFilter = (btn.getAttribute('data-filter') || 'all').toLowerCase();
                        actualizarChips();
                        aplicarFiltro();
                    });
                });

                sortSelect?.addEventListener('change', aplicarOrden);

                reservaList.addEventListener('click', event => {
                    const target = event.target;
                    if (!(target instanceof Element)) return;
                    const toggle = target.closest('.profile-reserva-toggle');
                    if (!toggle) return;
                    const targetId = toggle.getAttribute('data-target');
                    if (!targetId) return;
                    const detail = document.getElementById(targetId);
                    if (!detail) return;
                    const isHidden = detail.hasAttribute('hidden');
                    if (isHidden) {
                        detail.removeAttribute('hidden');
                        toggle.textContent = 'Ocultar detalle';
                    } else {
                        detail.setAttribute('hidden', 'hidden');
                        toggle.textContent = 'Ver detalle';
                    }
                });

                aplicarOrden();
                aplicarFiltro();
            }
        })();
    </script>
}

