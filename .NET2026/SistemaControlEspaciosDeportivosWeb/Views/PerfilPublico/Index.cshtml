@model SistemaControlEspaciosDeportivosWeb.ViewModels.PerfilPublicoIndexViewModel
@{
    ViewData["Title"] = "Perfil";
    var tab = (ViewData["Tab"]?.ToString() ?? "datos").ToLowerInvariant();
    var tabDatos = tab == "datos";
    var tabReservas = tab == "reservas";
}
<!-- Firma: Codex - 16/04/2026 | Panel de perfil para usuario publico con tabs Datos personales, Mis reservas y Retar a un equipo (proximamente). -->
<!-- Firma: Codex - 17/04/2026 | Header de perfil simplificado y rediseno profesional de historial de reservas en mini tarjetas con accesos de contacto/redes/mapa de sede. -->
<!-- Firma: Codex - 18/04/2026 | Perfil publico incorpora configuracion de desafios, bloque visible de informacion del equipo, ubigeo propio del equipo, telefonos con codigo de pais estandar, WhatsApp operativo del equipo y acceso directo al modulo independiente de Desafios. -->

<div class="container py-4">
    <header class="page-header">
        <div>
            <h1>Mi perfil</h1>
            <p class="page-subtitle">Gestiona tus datos personales, la configuracion de desafios y la informacion publica de tu equipo.</p>
            @if (Model.Perfil.BuscarDesafios)
            {
                <span class="profile-availability-badge">
                    <i class="bi bi-lightning-charge-fill"></i>Disponible para desafios
                </span>
            }
        </div>
        <div class="action-toolbar">
            <a class="auth-nav-mini auth-nav-mini-outline" asp-controller="Cuenta" asp-action="CambiarContrasena">
                <i class="bi bi-key me-1"></i>Cambiar contrasena
            </a>
        </div>
    </header>

    @if (TempData["PerfilPublicoOk"] is string ok && !string.IsNullOrWhiteSpace(ok))
    {
        <div class="alert alert-success">@ok</div>
    }

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link @(tabDatos ? "active" : null)" asp-action="Index" asp-route-tab="datos">Datos personales</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(tabReservas ? "active" : null)" asp-action="Index" asp-route-tab="reservas">Mis reservas</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Desafios" asp-action="Index">Desafios</a>
        </li>
    </ul>

    @if (tabDatos)
    {
        <form asp-action="GuardarDatos" method="post" class="content-card p-3">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Perfil.Id" />
            <input type="hidden" asp-for="Perfil.UsuarioId" />

            <section class="profile-form-section">
                <div class="section-heading">
                    <span class="section-chip"><i class="bi bi-person-badge"></i>Perfil base</span>
                    <h2>Datos personales</h2>
                    <p>Informacion principal del usuario para reservas y visualizacion publica del perfil.</p>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Tipo de documento</label>
                        <select asp-for="Perfil.TipoDocumento" asp-items="Model.Perfil.TiposDocumento" class="form-select"></select>
                        <span asp-validation-for="Perfil.TipoDocumento" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Numero de documento</label>
                        <input asp-for="Perfil.NumeroDocumento" class="form-control" maxlength="20" />
                        <span asp-validation-for="Perfil.NumeroDocumento" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fecha de nacimiento</label>
                        <input asp-for="Perfil.FechaNacimiento" type="date" class="form-control" />
                        <span asp-validation-for="Perfil.FechaNacimiento" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Nombres</label>
                        <input asp-for="Perfil.Nombres" class="form-control" maxlength="120" />
                        <span asp-validation-for="Perfil.Nombres" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Apellidos</label>
                        <input asp-for="Perfil.Apellidos" class="form-control" maxlength="120" />
                        <span asp-validation-for="Perfil.Apellidos" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Telefono</label>
                        <input asp-for="Perfil.Telefono" type="hidden" />
                        <div class="input-group">
                            <select asp-for="Perfil.TelefonoCodigoPais" asp-items="Model.Perfil.CodigosPais" class="form-select" style="max-width: 180px;"></select>
                            <input asp-for="Perfil.TelefonoNumeroLocal" class="form-control" inputmode="numeric" placeholder="999999999" />
                        </div>
                        <span asp-validation-for="Perfil.TelefonoCodigoPais" class="text-danger"></span>
                        <span asp-validation-for="Perfil.TelefonoNumeroLocal" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Correo</label>
                        <input asp-for="Perfil.Correo" class="form-control" maxlength="200" />
                        <span asp-validation-for="Perfil.Correo" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Departamento</label>
                        <select asp-for="Perfil.CodigoDepartamento" asp-items="Model.Perfil.DepartamentosUbigeo" class="form-select" id="CodigoDepartamento">
                            <option value="">Selecciona</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Provincia</label>
                        <select asp-for="Perfil.CodigoProvincia" asp-items="Model.Perfil.ProvinciasUbigeo" class="form-select" id="CodigoProvincia">
                            <option value="">Selecciona</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Distrito</label>
                        <select asp-for="Perfil.CodigoUbigeo" asp-items="Model.Perfil.DistritosUbigeo" class="form-select" id="CodigoUbigeo">
                            <option value="">Selecciona</option>
                        </select>
                        <span asp-validation-for="Perfil.CodigoUbigeo" class="text-danger"></span>
                    </div>
                </div>
            </section>

            <section class="profile-form-section profile-form-section-highlight">
                <div class="section-heading">
                    <span class="section-chip"><i class="bi bi-trophy"></i>Configuracion de desafios</span>
                    <h2>Configuracion de desafios</h2>
                    <p>Estos datos alimentan el modulo Desafios para que otros equipos te encuentren y te reten.</p>
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="challenge-switch">
                            <input asp-for="Perfil.BuscarDesafios" class="form-check-input" type="checkbox" />
                            <div>
                                <label asp-for="Perfil.BuscarDesafios" class="form-check-label fw-semibold">Buscar desafios</label>
                                <div class="text-muted small">Permitir que otros equipos me encuentren y me desafien.</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Deporte</label>
                        <select asp-for="Perfil.IdDeporteDesafio" asp-items="Model.Perfil.DeportesDesafio" class="form-select">
                            <option value="">Selecciona</option>
                        </select>
                        <span asp-validation-for="Perfil.IdDeporteDesafio" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nivel</label>
                        <select asp-for="Perfil.IdNivelDesafio" asp-items="Model.Perfil.NivelesDesafio" class="form-select">
                            <option value="">Selecciona</option>
                        </select>
                        <span asp-validation-for="Perfil.IdNivelDesafio" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nombre de equipo</label>
                        <input asp-for="Perfil.NombreEquipo" class="form-control" maxlength="120" />
                        <span asp-validation-for="Perfil.NombreEquipo" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Observacion</label>
                        <textarea asp-for="Perfil.ObservacionDesafio" class="form-control" rows="3" maxlength="500" placeholder="Solo amistosos, jugamos futbol 7, disponible fines de semana..."></textarea>
                        <span asp-validation-for="Perfil.ObservacionDesafio" class="text-danger"></span>
                    </div>
                </div>
            </section>

            <section class="profile-form-section">
                <div class="section-heading">
                    <span class="section-chip"><i class="bi bi-people"></i>Informacion del equipo</span>
                    <h2>Informacion del equipo</h2>
                    <p>Descripcion general del equipo, separada de las especificaciones puntuales del desafio.</p>
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Detalle del equipo</label>
                        <textarea asp-for="Perfil.DetalleEquipo" class="form-control" rows="4" maxlength="1000" placeholder="Equipo con 5 anos jugando torneos locales, grupo de amigos nivel intermedio, juego recreativo..."></textarea>
                        <span asp-validation-for="Perfil.DetalleEquipo" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Departamento del equipo</label>
                        <select asp-for="Perfil.CodigoDepartamentoEquipo" asp-items="Model.Perfil.DepartamentosUbigeoEquipo" class="form-select" id="CodigoDepartamentoEquipo">
                            <option value="">Selecciona</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Provincia del equipo</label>
                        <select asp-for="Perfil.CodigoProvinciaEquipo" asp-items="Model.Perfil.ProvinciasUbigeoEquipo" class="form-select" id="CodigoProvinciaEquipo">
                            <option value="">Selecciona</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Distrito del equipo</label>
                        <select asp-for="Perfil.CodigoUbigeoEquipo" asp-items="Model.Perfil.DistritosUbigeoEquipo" class="form-select" id="CodigoUbigeoEquipo">
                            <option value="">Selecciona</option>
                        </select>
                        <span asp-validation-for="Perfil.CodigoUbigeoEquipo" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">WhatsApp del equipo</label>
                        <input asp-for="Perfil.WhatsappEquipo" type="hidden" />
                        <div class="input-group">
                            <select asp-for="Perfil.WhatsappCodigoPais" asp-items="Model.Perfil.CodigosPais" class="form-select" style="max-width: 180px;"></select>
                            <input asp-for="Perfil.WhatsappNumeroLocal" class="form-control" inputmode="numeric" placeholder="999999999" />
                        </div>
                        <span asp-validation-for="Perfil.WhatsappCodigoPais" class="text-danger"></span>
                        <span asp-validation-for="Perfil.WhatsappNumeroLocal" class="text-danger"></span>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Perfil.DetalleEquipo))
                {
                    <div class="team-preview-card mt-3">
                        <div class="team-preview-kicker">Vista publica del equipo</div>
                        <p class="mb-0">@Model.Perfil.DetalleEquipo</p>
                    </div>
                }
            </section>

            <div class="mt-3 d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>Guardar perfil publico
                </button>
            </div>
        </form>
    }

    @if (tabReservas)
    {
        <section class="table-card profile-reservas-card">
            <h2 class="section-title"><i class="bi bi-calendar2-check me-1"></i>Historial de reservas</h2>
            @if (Model.Reservas.Count == 0)
            {
                <div class="p-3 text-center text-muted">Aun no tienes reservas registradas.</div>
            }
            else
            {
                <div class="profile-reservas-grid p-3">
                    @foreach (var item in Model.Reservas)
                    {
                        var estadoClase = item.EstadoTexto switch
                        {
                            "Reservada" => "is-reservada",
                            "Confirmada" => "is-confirmada",
                            "Pagada" => "is-pagada",
                            "Completada" => "is-completada",
                            "Cancelada" => "is-cancelada",
                            "No Show" => "is-noshow",
                            _ => "is-default"
                        };
                        var waNumero = (item.SedeWhatsapp ?? item.SedeTelefono ?? string.Empty).Replace(" ", string.Empty).Replace("+", string.Empty);
                        var waUrl = string.IsNullOrWhiteSpace(waNumero) ? null : $"https://wa.me/{waNumero}";

                        <article class="profile-reserva-item">
                            <header class="profile-reserva-head">
                                <div>
                                    <p class="profile-kicker mb-1"><i class="bi bi-hash"></i>Reserva</p>
                                    <h3 class="profile-reserva-codigo mb-0">R-@item.ReservaId.ToString("D6")</h3>
                                </div>
                                <span class="profile-estado-chip @estadoClase">@item.EstadoTexto</span>
                            </header>

                            <div class="profile-reserva-body">
                                <div class="profile-mini">
                                    <span><i class="bi bi-calendar-event"></i>Fecha</span>
                                    <strong>@item.Fecha.ToString("dd/MM/yyyy")</strong>
                                </div>
                                <div class="profile-mini">
                                    <span><i class="bi bi-clock-history"></i>Horario</span>
                                    <strong>@item.HoraInicio.ToString("HH\\:mm") - @item.HoraFin.ToString("HH\\:mm")</strong>
                                </div>
                                <div class="profile-mini">
                                    <span><i class="bi bi-building"></i>Negocio</span>
                                    <strong>@item.NegocioNombre</strong>
                                </div>
                                <div class="profile-mini">
                                    <span><i class="bi bi-geo-alt"></i>Sede / espacio</span>
                                    <strong>@item.SedeNombre / @item.EspacioNombre</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.SedeDireccion))
                                    {
                                        <small>@item.SedeDireccion</small>
                                    }
                                </div>
                                <div class="profile-mini">
                                    <span><i class="bi bi-cash-coin"></i>Precio</span>
                                    <strong>Total: S/ @item.Total.ToString("0.00")</strong>
                                    <small>Saldo: S/ @item.SaldoPendiente.ToString("0.00")</small>
                                </div>
                                <div class="profile-mini">
                                    <span><i class="bi bi-telephone"></i>Contacto sede</span>
                                    <strong>@(string.IsNullOrWhiteSpace(item.SedeTelefono) ? "-" : item.SedeTelefono)</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.SedeWhatsapp))
                                    {
                                        <small>WhatsApp: @item.SedeWhatsapp</small>
                                    }
                                </div>
                            </div>

                            <footer class="profile-reserva-foot">
                                <span class="profile-kicker"><i class="bi bi-share"></i>Canales de la sede</span>
                                <div class="profile-icon-links">
                                    @if (!string.IsNullOrWhiteSpace(item.SedeMapaUrl))
                                    {
                                        <a class="profile-icon-btn" href="@item.SedeMapaUrl" target="_blank" rel="noopener noreferrer" title="Ver mapa">
                                            <i class="bi bi-map"></i>
                                        </a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(waUrl))
                                    {
                                        <a class="profile-icon-btn is-whatsapp" href="@waUrl" target="_blank" rel="noopener noreferrer" title="WhatsApp">
                                            <i class="bi bi-whatsapp"></i>
                                        </a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.SedeFacebookUrl))
                                    {
                                        <a class="profile-icon-btn" href="@item.SedeFacebookUrl" target="_blank" rel="noopener noreferrer" title="Facebook">
                                            <i class="bi bi-facebook"></i>
                                        </a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.SedeInstagramUrl))
                                    {
                                        <a class="profile-icon-btn" href="@item.SedeInstagramUrl" target="_blank" rel="noopener noreferrer" title="Instagram">
                                            <i class="bi bi-instagram"></i>
                                        </a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.SedeTwitterUrl))
                                    {
                                        <a class="profile-icon-btn" href="@item.SedeTwitterUrl" target="_blank" rel="noopener noreferrer" title="X/Twitter">
                                            <i class="bi bi-twitter-x"></i>
                                        </a>
                                    }
                                </div>
                            </footer>
                        </article>
                    }
                </div>
            }
        </section>
    }
</div>

@section Styles {
    <style>
        .profile-availability-badge {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            margin-top: .55rem;
            border-radius: 999px;
            background: linear-gradient(135deg, #e7fff2 0%, #d8fff0 100%);
            border: 1px solid #7ce0aa;
            color: #0e6a3f;
            font-weight: 800;
            padding: .4rem .8rem;
            font-size: .8rem;
        }
        .profile-form-section {
            border: 1px solid #d8e3f5;
            border-radius: 18px;
            padding: 1rem;
            background: #fff;
            margin-bottom: 1rem;
        }
        .profile-form-section-highlight {
            background: linear-gradient(180deg, #f7fbff 0%, #eef7ff 100%);
            border-color: #bdd8ff;
        }
        .section-heading {
            margin-bottom: 1rem;
        }
        .section-heading h2 {
            font-size: 1.05rem;
            font-weight: 800;
            color: #12366f;
            margin-bottom: .25rem;
        }
        .section-heading p {
            margin: 0;
            color: #5b6f92;
            font-size: .92rem;
        }
        .section-chip {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            border-radius: 999px;
            padding: .3rem .7rem;
            background: #eaf2ff;
            color: #1c4fa4;
            font-size: .72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
            margin-bottom: .55rem;
        }
        .challenge-switch {
            display: flex;
            align-items: flex-start;
            gap: .8rem;
            padding: .9rem 1rem;
            border: 1px solid #cce0ff;
            border-radius: 14px;
            background: rgba(255,255,255,.8);
        }
        .challenge-switch .form-check-input {
            margin-top: .15rem;
        }
        .team-preview-card {
            border-radius: 16px;
            padding: 1rem;
            background: linear-gradient(135deg, #0d2d62 0%, #1550a8 100%);
            color: #fff;
            box-shadow: 0 16px 30px rgba(13, 45, 98, .18);
        }
        .team-preview-kicker {
            text-transform: uppercase;
            letter-spacing: .05em;
            font-size: .73rem;
            font-weight: 800;
            opacity: .82;
            margin-bottom: .45rem;
        }
        .profile-reservas-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: .95rem;
        }
        .profile-reserva-item {
            border: 1px solid #dbe5f6;
            border-radius: 14px;
            background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
            box-shadow: 0 10px 22px rgba(15, 23, 42, .06);
            padding: .9rem;
            display: flex;
            flex-direction: column;
            gap: .8rem;
        }
        .profile-reserva-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: .5rem;
        }
        .profile-kicker {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            color: #4b5f87;
            text-transform: uppercase;
            letter-spacing: .04em;
            font-size: .68rem;
            font-weight: 700;
        }
        .profile-reserva-codigo {
            font-size: 1.08rem;
            color: #0d2d62;
            font-weight: 800;
        }
        .profile-estado-chip {
            border-radius: 999px;
            font-size: .75rem;
            font-weight: 700;
            padding: .24rem .6rem;
            border: 1px solid transparent;
            white-space: nowrap;
        }
        .profile-estado-chip.is-reservada { background: #fff4dc; border-color: #f9cb74; color: #8a5100; }
        .profile-estado-chip.is-confirmada { background: #eaf2ff; border-color: #aac6ff; color: #1b4ea0; }
        .profile-estado-chip.is-pagada,
        .profile-estado-chip.is-completada { background: #ebf8ee; border-color: #99ddb0; color: #1f6d3c; }
        .profile-estado-chip.is-cancelada,
        .profile-estado-chip.is-noshow { background: #feecec; border-color: #f2aaaa; color: #a42d2d; }
        .profile-estado-chip.is-default { background: #eef2f8; border-color: #ccd6e8; color: #3f567c; }
        .profile-reserva-body {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .65rem;
        }
        .profile-mini {
            border: 1px solid #d9e4f7;
            border-radius: 10px;
            background: #ffffff;
            padding: .48rem .58rem;
            display: flex;
            flex-direction: column;
            gap: .18rem;
        }
        .profile-mini span {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            font-size: .72rem;
            color: #4b618d;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .03em;
        }
        .profile-mini strong {
            font-size: .9rem;
            color: #0f2f64;
            font-weight: 700;
            line-height: 1.2;
        }
        .profile-mini small {
            font-size: .78rem;
            color: #5c6e91;
            line-height: 1.25;
        }
        .profile-reserva-foot {
            border-top: 1px dashed #cbdaef;
            padding-top: .55rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .6rem;
        }
        .profile-icon-links {
            display: inline-flex;
            gap: .45rem;
            flex-wrap: wrap;
        }
        .profile-icon-btn {
            width: 2rem;
            height: 2rem;
            border-radius: 999px;
            border: 1px solid #b7ccf4;
            color: #1f4fad;
            background: #eff5ff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: .18s ease;
        }
        .profile-icon-btn:hover {
            background: #1f4fad;
            color: #fff;
            border-color: #1f4fad;
            transform: translateY(-1px);
        }
        .profile-icon-btn.is-whatsapp {
            color: #16a34a;
            border-color: #6ee7b7;
            background: #ecfdf3;
        }
        .profile-icon-btn.is-whatsapp:hover {
            background: #16a34a;
            border-color: #16a34a;
            color: #fff;
        }
        @@media (max-width: 767px) {
            .profile-reserva-body { grid-template-columns: 1fr; }
            .profile-reserva-foot { align-items: flex-start; flex-direction: column; }
        }
    </style>
}

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const dep = document.getElementById('CodigoDepartamento');
            const prov = document.getElementById('CodigoProvincia');
            const dist = document.getElementById('CodigoUbigeo');
            const depEquipo = document.getElementById('CodigoDepartamentoEquipo');
            const provEquipo = document.getElementById('CodigoProvinciaEquipo');
            const distEquipo = document.getElementById('CodigoUbigeoEquipo');

            function renderOptions(select, rows, emptyText) {
                if (!select) return;
                select.innerHTML = '';
                const first = document.createElement('option');
                first.value = '';
                first.textContent = emptyText;
                select.appendChild(first);
                (rows || []).forEach(x => {
                    const opt = document.createElement('option');
                    opt.value = x.value || '';
                    opt.textContent = x.text || '';
                    select.appendChild(opt);
                });
            }

            async function enlazarUbigeo(depSelect, provSelect, distSelect) {
                if (!depSelect || !provSelect || !distSelect) return;

                depSelect.addEventListener('change', async () => {
                    const codigo = (depSelect.value || '').trim();
                    renderOptions(provSelect, [], 'Selecciona');
                    renderOptions(distSelect, [], 'Selecciona');
                    if (codigo.length !== 2) return;
                    const resp = await fetch(`@Url.Action("UbigeoProvincias", "Home")?codigoDepartamento=${encodeURIComponent(codigo)}`, { cache: 'no-store' });
                    if (!resp.ok) return;
                    renderOptions(provSelect, await resp.json(), 'Selecciona');
                });

                provSelect.addEventListener('change', async () => {
                    const codigo = (provSelect.value || '').trim();
                    renderOptions(distSelect, [], 'Selecciona');
                    if (codigo.length !== 4) return;
                    const resp = await fetch(`@Url.Action("UbigeoDistritos", "Home")?codigoProvincia=${encodeURIComponent(codigo)}`, { cache: 'no-store' });
                    if (!resp.ok) return;
                    renderOptions(distSelect, await resp.json(), 'Selecciona');
                });
            }

            enlazarUbigeo(dep, prov, dist);
            enlazarUbigeo(depEquipo, provEquipo, distEquipo);
        })();
    </script>
}
