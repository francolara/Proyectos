@page
@model SistemaControlEspaciosDeportivosWeb.Areas.Identity.Pages.Account.ForgotPasswordModel
@* Firma: FRANCO LARA - 15/07/2026 | Recuperacion de contrasena agrega captcha manual de respaldo cuando Turnstile falla o no queda disponible. *@
@* Firma: FRANCO LARA - 21/07/2026 | Informa y bloquea la recuperacion cuando el envio global de correos esta deshabilitado. *@
@* Firma: FRANCO LARA - 13/09/2026 | Aclara el uso del captcha manual sin atribuirlo siempre a un fallo de Turnstile. *@
@* Firma: FRANCO LARA - 09/10/2026 | Muestra un aviso emergente cuando la proteccion contra intentos repetidos bloquea la recuperacion de contrasena y conserva las redirecciones posteriores. *@
@{
    ViewData["Title"] = "Recuperar contrasena";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="auth-shell auth-shell-centered">
    <section class="auth-panel auth-panel-centered">
        <div class="auth-card auth-card-centered">
            <div class="auth-status-badge auth-status-badge-success">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1>Recuperar contrasena</h1>
            @if (!Model.CorreosHabilitados)
            {
                <p class="auth-subtitle">La recuperacion por correo esta deshabilitada por la configuracion actual.</p>
                <div class="auth-foot-links auth-foot-links-pro">
                    <a asp-page="./Login">Volver a iniciar sesion</a>
                </div>
            }
            else
            {
                <p class="auth-subtitle">Ingresa tu correo y te enviaremos instrucciones para continuar.</p>
                <p class="auth-note">Si el correo coincide con una cuenta valida, recibiras un enlace para actualizar tu contrasena.</p>

                <form method="post" id="forgotPasswordForm">
                    <input type="hidden" asp-for="UsarCaptchaManual" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Correo electronico</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    @if (Model.MostrarTurnstile && !Model.MostrarCaptchaManual)
                    {
                        <div class="mb-3">
                            <div class="cf-turnstile" data-sitekey="@Model.TurnstileSiteKey"></div>
                        </div>
                    }
                    @if (Model.MostrarCaptchaManual)
                    {
                        <div class="auth-manual-captcha mb-3">
                            <label asp-for="CaptchaManual" class="form-label">Captcha manual de respaldo</label>
                            <div class="auth-manual-captcha-code" aria-label="Codigo captcha">@Model.CaptchaManualCodigo</div>
                            <input asp-for="CaptchaManual" class="form-control mt-2" autocomplete="off" spellcheck="false" placeholder="Escribe el codigo mostrado" />
                            <span asp-validation-for="CaptchaManual" class="text-danger"></span>
                            <div class="form-text">Ingresa el codigo mostrado para continuar con la validacion de seguridad.</div>
                        </div>
                    }
                    <button type="submit" class="w-100 btn btn-primary auth-cta">Enviar instrucciones</button>
                    <div class="auth-foot-links auth-foot-links-pro">
                        <a asp-page="./Login">Volver a iniciar sesion</a>
                    </div>
                </form>
            }
        </div>
    </section>
</section>

<div class="modal fade" id="forgotPasswordRateLimitModal" tabindex="-1" aria-labelledby="forgotPasswordRateLimitModalTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-body p-4 text-center">
                <div class="text-warning fs-1 mb-2" aria-hidden="true"><i class="bi bi-clock-history"></i></div>
                <h2 class="h4 mb-3" id="forgotPasswordRateLimitModalTitulo">Espera un momento</h2>
                <p class="mb-0">Por seguridad, hemos limitado temporalmente las solicitudes de recuperacion desde esta conexión. Espera unos minutos antes de intentarlo nuevamente.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center pt-0 pb-4">
                <button type="button" class="btn btn-primary px-4" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.MostrarTurnstile && !Model.MostrarCaptchaManual)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById('forgotPasswordForm');
            if (!form) return;

            form.addEventListener('submit', async (event) => {
                if (!form.checkValidity()) return;

                event.preventDefault();
                const submitButton = event.submitter;
                const buttons = form.querySelectorAll('button[type="submit"]');
                buttons.forEach(button => { button.disabled = true; });

                try {
                    const response = await fetch(submitButton?.formAction || form.action, {
                        method: 'POST',
                        body: new FormData(form)
                    });

                    if (response.status === 429) {
                        const modal = document.getElementById('forgotPasswordRateLimitModal');
                        if (modal && window.bootstrap) {
                            bootstrap.Modal.getOrCreateInstance(modal).show();
                        }
                        return;
                    }

                    if (response.redirected) {
                        window.location.assign(response.url);
                        return;
                    }

                    const html = await response.text();
                    document.open();
                    document.write(html);
                    document.close();
                } catch {
                    form.submit();
                } finally {
                    buttons.forEach(button => { button.disabled = false; });
                }
            });
        })();
    </script>
}
