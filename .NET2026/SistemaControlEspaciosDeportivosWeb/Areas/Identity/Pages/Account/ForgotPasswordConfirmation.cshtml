@page
@{
    ViewData["Title"] = "Correo enviado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- Firma: Codex - 25/04/2026 | Confirmacion neutra redisenada con composicion centrada y consistente con el flujo de seguridad. -->
<section class="auth-shell auth-shell-centered">
    <section class="auth-panel auth-panel-centered">
        <div class="auth-card auth-card-centered">
            <div class="auth-status-badge auth-status-badge-success">
                <i class="bi bi-envelope-check-fill"></i>
            </div>
            <h1>Revisa tu correo</h1>
            <p class="auth-subtitle">Si el correo existe en nuestro sistema, te enviamos instrucciones para continuar.</p>
            <p class="auth-note">Revisa tambien Spam o Promociones. El enlace de recuperacion tiene tiempo limitado por seguridad.</p>
            <div class="auth-foot-links auth-foot-links-pro">
                <a asp-page="./Login">Volver a iniciar sesion</a>
            </div>
        </div>
    </section>
</section>
