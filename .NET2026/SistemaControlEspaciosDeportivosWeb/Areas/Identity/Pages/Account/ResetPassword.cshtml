@page
@model SistemaControlEspaciosDeportivosWeb.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Restablecer contrasena";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="auth-shell auth-shell-centered">
    <section class="auth-panel auth-panel-centered">
        <div class="auth-card auth-card-centered">
            <div class="auth-status-badge auth-status-badge-success">
                <i class="bi bi-key-fill"></i>
            </div>
            <h1>Restablecer contrasena</h1>
            <p class="auth-subtitle">Define una nueva contrasena para tu cuenta.</p>
            <p class="auth-note">Usa una contrasena robusta combinando letras mayusculas, minusculas, numeros y simbolos.</p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>
                <input asp-for="Input.Code" type="hidden" />
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Correo electronico</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Nueva contrasena</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar contrasena</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-primary auth-cta">Guardar nueva contrasena</button>
            </form>
        </div>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

