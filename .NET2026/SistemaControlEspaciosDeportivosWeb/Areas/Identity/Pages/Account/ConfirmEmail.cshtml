@page
@model SistemaControlEspaciosDeportivosWeb.Areas.Identity.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "Confirmar correo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- Firma: Codex - 25/04/2026 | Resultado de confirmacion de correo redisenado con tarjeta centrada y estilo profesional coherente con el flujo de recuperacion. -->
<section class="auth-shell auth-shell-centered">
    <section class="auth-panel auth-panel-centered">
        <div class="auth-card auth-card-centered">
            <div class="auth-status-badge @(Model.IsSuccess ? "auth-status-badge-success" : "auth-status-badge-error")">
                <i class="bi @(Model.IsSuccess ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")"></i>
            </div>
            <h1>Confirmacion de correo</h1>
            <p class="auth-subtitle">@Model.StatusMessage</p>
            <p class="auth-note">Por seguridad, este enlace solo debe usarse una vez. Si tienes problemas para ingresar, solicita un nuevo correo de confirmacion.</p>
            @if (Model.IsSuccess)
            {
                <a class="w-100 btn btn-primary auth-cta" href="@Model.LoginUrl">Iniciar sesion</a>
            }
            else
            {
                <a class="w-100 btn btn-outline-primary auth-cta" href="@Model.LoginUrl">Volver al login</a>
            }
        </div>
    </section>
</section>
