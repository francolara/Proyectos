@page
@{
    ViewData["Title"] = "Contrasena restablecida";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="auth-shell auth-shell-centered">
    <section class="auth-panel auth-panel-centered">
        <div class="auth-card auth-card-centered">
            <div class="auth-status-badge auth-status-badge-success">
                <i class="bi bi-check2-circle"></i>
            </div>
            <h1>Contrasena actualizada</h1>
            <p class="auth-subtitle">Tu contrasena fue restablecida correctamente.</p>
            <p class="auth-note">Ya puedes acceder con tu nueva contrasena desde cualquier dispositivo.</p>
            <div class="auth-foot-links auth-foot-links-pro">
                <a asp-page="./Login">Iniciar sesion</a>
            </div>
        </div>
    </section>
</section>

