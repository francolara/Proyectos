@page
@* Firma: FRANCO LARA - 19/11/2026 | Presenta un aviso de acceso en español con ayuda y contacto de soporte. *@
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@{
    ViewData["Title"] = "Acceso restringido";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="auth-shell auth-shell-centered">
    <div class="auth-panel auth-panel-centered">
        <div class="auth-card auth-card-centered">
            <div class="auth-status-badge bg-primary-subtle text-primary-emphasis"><i class="bi bi-shield-lock" aria-hidden="true"></i></div>
            <h1>@ViewData["Title"]</h1>
            <p class="auth-subtitle">Tu cuenta no tiene permiso para abrir esta página.</p>
            <p class="auth-note">Si necesitas acceso, comunícate con el administrador de tu complejo o con nuestro equipo de soporte.</p>
            <partial name="~/Views/Shared/_ContactoSoporteAcceso.cshtml" />
            <div class="mt-4">
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index" asp-area="">Ir al inicio</a>
            </div>
        </div>
    </div>
</section>
