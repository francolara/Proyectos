@page
@model SistemaControlEspaciosDeportivosWeb.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Iniciar sesion";
}
<!-- Firma: Codex - 13/04/2026 | Doble ingreso sin duplicar cuenta: Cliente u Operador, con validacion de acceso a negocio para panel. -->

<div class="row justify-content-center">
    <div class="col-lg-5">
        <section class="card border-0 shadow-sm">
            <div class="card-body">
                <h1 class="h3 mb-2">Iniciar sesion</h1>
                <p class="text-muted mb-3">Ingresa con tu cuenta del sistema.</p>
                <div class="btn-group w-100 mb-3" role="group" aria-label="Modo de acceso">
                    <a class="btn @(Model.Modo == "cliente" ? "btn-primary" : "btn-outline-primary")"
                       asp-page="./Login"
                       asp-route-modo="cliente"
                       asp-route-returnUrl="@Model.ReturnUrl">Ingreso cliente</a>
                    <a class="btn @(Model.Modo == "operador" ? "btn-primary" : "btn-outline-primary")"
                       asp-page="./Login"
                       asp-route-modo="operador"
                       asp-route-returnUrl="@Model.ReturnUrl">Ingreso operador</a>
                </div>
                <form id="account" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="Modo" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Correo</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Contrasena</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label">Recordarme</label>
                    </div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-primary">
                        @(Model.Modo == "operador" ? "Ingresar al panel operador" : "Iniciar sesion")
                    </button>
                    <div class="mt-3 d-flex flex-column gap-2">
                        <a id="forgot-password" asp-page="./ForgotPassword">Olvidaste tu contrasena?</a>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Registrarte como nuevo usuario</a>
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Reenviar confirmacion de correo</a>
                    </div>
                </form>
            </div>
        </section>
    </div>
    <div class="col-lg-5 mt-3 mt-lg-0">
        <section class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">Iniciar con otro servicio</h2>
                @if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <p class="mb-0">No hay proveedores externos configurados.</p>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-flex flex-wrap gap-2">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name" title="Iniciar sesion con @provider.DisplayName">@provider.DisplayName</button>
                        }
                    </form>
                }
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
