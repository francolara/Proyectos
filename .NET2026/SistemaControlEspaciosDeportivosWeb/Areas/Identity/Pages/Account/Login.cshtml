@page
@model SistemaControlEspaciosDeportivosWeb.Areas.Identity.Pages.Account.LoginModel
@inject Microsoft.Extensions.Options.IOptions<SistemaControlEspaciosDeportivosWeb.Services.SedeImagenStorageSettings> SedeImagenStorageOptions
@{
    ViewData["Title"] = "Iniciar sesion";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var bannerArchivo = !string.IsNullOrWhiteSpace(Model.BannerLateral?.ImagenUrlMobile)
        ? Model.BannerLateral!.ImagenUrlMobile
        : Model.BannerLateral?.ImagenUrl;
    // Antes: URL proxy por backend (mas latencia).
    // var bannerUrl = !string.IsNullOrWhiteSpace(bannerArchivo)
    //     ? Url.Action("VerImagen", "Sedes", new { url = bannerArchivo })
    //     : null;
    var bannerUrl = !string.IsNullOrWhiteSpace(bannerArchivo)
        ? bannerArchivo
        : null;
    bannerUrl = SistemaControlEspaciosDeportivosWeb.Services.SedeImagenUrlHelper.NormalizarUrlPublica(
        bannerUrl,
        SedeImagenStorageOptions.Value.PublicBaseUrl,
        SedeImagenStorageOptions.Value.BucketName);
    var visualTitulo = Model.BannerLateral?.Titulo?.Trim();
    var visualSubtitulo = Model.BannerLateral?.Subtitulo?.Trim();
    var visualDescripcion = Model.BannerLateral?.Descripcion?.Trim();
    var visualItems = string.IsNullOrWhiteSpace(visualDescripcion)
        ? Array.Empty<string>()
        : visualDescripcion
            .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToArray();
}
<section class="auth-shell">
    <aside class="auth-visual @(string.IsNullOrWhiteSpace(bannerUrl) ? string.Empty : "auth-visual-has-banner")" style="@(string.IsNullOrWhiteSpace(bannerUrl) ? string.Empty : $"background-image:url('{bannerUrl}');")">
        @if (string.IsNullOrWhiteSpace(bannerUrl))
        {
        <div class="auth-visual-content">
            @if (!string.IsNullOrWhiteSpace(visualSubtitulo))
            {
                <p class="auth-visual-tag">@visualSubtitulo</p>
            }
            @if (!string.IsNullOrWhiteSpace(visualTitulo))
            {
                <h2>@visualTitulo</h2>
            }
            @if (visualItems.Length > 0)
            {
                <ul class="auth-visual-list">
                    @foreach (var item in visualItems)
                    {
                        <li>@item</li>
                    }
                </ul>
            }
        </div>
        }
    </aside>

    <section class="auth-panel">
        <div class="auth-card">
            <h1>Iniciar sesion</h1>
            <p class="auth-subtitle">Ingresa tus credenciales para acceder a tu cuenta.</p>

            <form id="account" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                @* Firma: Franco Lara - 21/05/2026 | Mensaje amigable cuando logout falla por sesion/token expirado y se redirige a login. *@
                @if (string.Equals(Request.Query["sessionExpired"], "1", StringComparison.Ordinal))
                {
                    <div class="alert alert-warning py-2 px-3 mb-3" role="alert">
                        Tu sesion anterior expiro por inactividad. Inicia sesion nuevamente.
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                {
                    <div class="alert alert-success py-2 px-3 mb-3" role="alert">
                        @Model.SuccessMessage
                    </div>
                }
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Correo electronico</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label asp-for="Input.Password" class="form-label">Contrasena</label>
                    <div class="input-group">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" id="loginPassword" />
                        <button class="btn btn-outline-secondary" type="button" id="toggleLoginPassword" aria-label="Mostrar u ocultar contrasena">👁</button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check mb-0">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label">Recordarme</label>
                    </div>
                    <a asp-page="./ForgotPassword" class="auth-link">Olvidaste tu contrasena?</a>
                </div>
                @if (Model.MostrarTurnstile)
                {
                    <div class="mb-3">
                        <div class="cf-turnstile" data-sitekey="@Model.TurnstileSiteKey"></div>
                    </div>
                }

                <button id="login-submit" type="submit" class="w-100 btn btn-primary auth-cta">Iniciar sesion</button>
                <button asp-page-handler="ResendConfirmation" type="submit" class="w-100 btn btn-outline-primary auth-cta mt-2">Reenviar confirmacion</button>
                @if (Model.ExternalLogins.Count > 0)
                {
                    <div class="mt-3">
                        @foreach (var provider in Model.ExternalLogins)
                        {
                            <button type="submit"
                                    class="w-100 btn btn-outline-dark auth-cta mt-2"
                                    asp-page-handler="ExternalLogin"
                                    asp-route-provider="@provider.Name"
                                    asp-route-returnUrl="@Model.ReturnUrl"
                                    asp-route-flow="login">
                                <span class="d-inline-flex align-items-center justify-content-center gap-2">
                                    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google" width="18" height="18" />
                                    <span>Continuar con @provider.DisplayName</span>
                                </span>
                            </button>
                        }
                    </div>
                }

                <div class="auth-foot-links auth-foot-links-pro">
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">¿No tienes una cuenta? <strong>Regístrate</strong></a>
                    <a asp-controller="Home" asp-action="Index">← Volver al inicio</a>
                </div>
            </form>
        </div>
    </section>
</section>

@section Scripts {
    @if (Model.MostrarTurnstile)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const loginForm = document.getElementById('account');
            const loginSubmit = document.getElementById('login-submit');
            const passwordInput = document.getElementById('loginPassword');
            const toggleButton = document.getElementById('toggleLoginPassword');

            let isSubmitting = false;

            if (loginForm) {
                loginForm.addEventListener('submit', (event) => {
                    if (isSubmitting) {
                        event.preventDefault();
                        return;
                    }

                    isSubmitting = true;

                    const submitButtons = loginForm.querySelectorAll('button[type="submit"]');
                    submitButtons.forEach((button) => {
                        button.disabled = true;
                        button.setAttribute('aria-disabled', 'true');
                    });

                    if (loginSubmit) {
                        loginSubmit.textContent = 'Ingresando...';
                    }
                });
            }

            if (!passwordInput || !toggleButton) return;

            toggleButton.addEventListener('click', () => {
                const show = passwordInput.type === 'password';
                passwordInput.type = show ? 'text' : 'password';
                toggleButton.textContent = show ? '🙈' : '👁';
            });
        })();
    </script>
}
