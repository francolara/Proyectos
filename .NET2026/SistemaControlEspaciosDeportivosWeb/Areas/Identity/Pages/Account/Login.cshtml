@page
@model SistemaControlEspaciosDeportivosWeb.Areas.Identity.Pages.Account.LoginModel
@inject Microsoft.Extensions.Options.IOptions<SistemaControlEspaciosDeportivosWeb.Services.SedeImagenStorageSettings> SedeImagenStorageOptions
@{
    ViewData["Title"] = "Iniciar sesion";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var bannerArchivo = !string.IsNullOrWhiteSpace(Model.BannerLateral?.ImagenUrlMobile)
        ? Model.BannerLateral!.ImagenUrlMobile
        : Model.BannerLateral?.ImagenUrl;
    // Antes: URL proxy por backend (mas latencia).
    // var bannerUrl = !string.IsNullOrWhiteSpace(bannerArchivo)
    //     ? Url.Action("VerImagen", "Sedes", new { url = bannerArchivo })
    //     : null;
    var bannerUrl = !string.IsNullOrWhiteSpace(bannerArchivo)
        ? bannerArchivo
        : null;
    bannerUrl = SistemaControlEspaciosDeportivosWeb.Services.SedeImagenUrlHelper.NormalizarUrlPublica(
        bannerUrl,
        SedeImagenStorageOptions.Value.PublicBaseUrl,
        SedeImagenStorageOptions.Value.BucketName);
}
<section class="auth-shell">
    <aside class="auth-visual" style="@(string.IsNullOrWhiteSpace(bannerUrl) ? string.Empty : $"background-image:linear-gradient(165deg,rgba(3,15,35,.84),rgba(7,24,58,.70)),url('{bannerUrl}');")">
        <div class="auth-visual-content">
            <p class="auth-visual-tag">SportCenter</p>
            <h2>@(string.IsNullOrWhiteSpace(Model.BannerLateral?.Titulo) ? "Gestiona tu club sin fricciones" : Model.BannerLateral!.Titulo)</h2>
            <ul class="auth-visual-list">
                <li>Recibe reservas las 24/7.</li>
                <li>Controla horarios y disponibilidad.</li>
                <li>Visualiza reportes operativos.</li>
            </ul>
        </div>
    </aside>

    <section class="auth-panel">
        <div class="auth-card">
            <h1>Iniciar sesion</h1>
            <p class="auth-subtitle">Ingresa tus credenciales para acceder a tu cuenta.</p>

            <form id="account" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                {
                    <div class="alert alert-success py-2 px-3 mb-3" role="alert">
                        @Model.SuccessMessage
                    </div>
                }
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Correo electronico</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label asp-for="Input.Password" class="form-label">Contrasena</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check mb-0">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label">Recordarme</label>
                    </div>
                    <a asp-page="./ForgotPassword" class="auth-link">Olvidaste tu contrasena?</a>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-primary auth-cta">Iniciar sesion</button>
                <button asp-page-handler="ResendConfirmation" type="submit" class="w-100 btn btn-outline-primary auth-cta mt-2">Reenviar confirmacion</button>

                <div class="auth-foot-links auth-foot-links-pro">
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Â¿No tienes una cuenta? <strong>RegÃ­strate</strong></a>
                    <a asp-controller="Home" asp-action="Index">â† Volver al inicio</a>
                </div>
            </form>
        </div>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

