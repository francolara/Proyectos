#!/usr/bin/env bash
# Ejecuta el endpoint interno de cancelacion y no contiene ni registra secretos.
set -u -o pipefail

readonly SECRET_FILE='/srv/fralse/secrets/zona-deportiva-jobs-token'
readonly ENDPOINT='http://127.0.0.1:5101/jobs/reservas/autocancelar-no-confirmadas'
readonly TZ_NAME='America/Lima'

log_result() {
    local status="$1"
    local http_status="$2"
    local duration_ms="$3"
    local timestamp
    timestamp="$(TZ="$TZ_NAME" date '+%Y-%m-%dT%H:%M:%S%z')"
    printf 'fecha=%s duracion_ms=%s http=%s estado=%s\n' "$timestamp" "$duration_ms" "$http_status" "$status"
}

start_ms="$(date +%s%3N)"

exec 9>/run/zona-deportiva-autocancel.lock
if ! /usr/bin/flock -n 9; then
    end_ms="$(date +%s%3N)"
    log_result 'omitido_ya_en_ejecucion' '000' "$((end_ms - start_ms))"
    exit 0
fi

if [[ ! -r "$SECRET_FILE" ]]; then
    end_ms="$(date +%s%3N)"
    log_result 'error_secret_no_legible' '000' "$((end_ms - start_ms))"
    exit 1
fi

token="$(<"$SECRET_FILE")"
if [[ -z "$token" ]]; then
    end_ms="$(date +%s%3N)"
    log_result 'error_secret_vacio' '000' "$((end_ms - start_ms))"
    exit 1
fi

set +e
http_status="$(printf 'X-Jobs-Token: %s\r\n' "$token" | /usr/bin/curl \
    --request POST \
    --header @- \
    --silent \
    --show-error \
    --output /dev/null \
    --write-out '%{http_code}' \
    --connect-timeout 10 \
    --max-time 110 \
    "$ENDPOINT")"
curl_exit=$?
set -e
unset token

end_ms="$(date +%s%3N)"
duration_ms="$((end_ms - start_ms))"

if [[ "$curl_exit" -ne 0 ]]; then
    log_result 'error_curl' "${http_status:-000}" "$duration_ms"
    exit "$curl_exit"
fi

if [[ "$http_status" -ge 200 && "$http_status" -lt 300 ]]; then
    log_result 'ok' "$http_status" "$duration_ms"
    exit 0
fi

log_result 'error_http' "$http_status" "$duration_ms"
exit 1
