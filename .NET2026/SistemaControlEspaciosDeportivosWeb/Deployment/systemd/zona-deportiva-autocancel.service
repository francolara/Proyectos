[Unit]
Description=Cancelacion automatica de reservas no confirmadas - Zona Deportiva
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=TZ=America/Lima
TimeoutStartSec=2min
ExecStart=/usr/local/sbin/zona-deportiva-autocancel
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zona-deportiva-autocancel
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run
