# Configuración de HYT. No colocar claves reales en este archivo de ejemplo.
# Bucket privado que creará el administrador en Cloudflare R2.
CloudflareR2__BucketName=hyt-documentos
CloudflareR2__AccountId=
CloudflareR2__AccessKeyId=
CloudflareR2__SecretAccessKey=

# Turnstile del acceso HYT. Reemplazar localhost por el dominio de la aplicación.
CloudflareTurnstile__Enabled=true
CloudflareTurnstile__SiteKey=
CloudflareTurnstile__SecretKey=
CloudflareTurnstile__AllowedHostnames__0=localhost