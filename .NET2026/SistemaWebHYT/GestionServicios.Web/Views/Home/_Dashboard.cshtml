@using System.Text.Json
@using GestionServicios.Web.ViewModels.Reporting
@model DashboardModel
@* Firma: FRANCO LARA - 03/11/2026 | Panel HYT con métricas, curvas, columnas, dona y detalle accesible por moneda. *@
@* Firma: FRANCO LARA - 05/11/2026 | Filtros cliente/tienda, primeros eventos, agrupación temporal y bandeja de pendientes histórica; Acciones presentadas como botones HYT. *@
@{var data=Model.Data;var budgets=data.GetProperty("VerPresupuestos").GetBoolean();var orders=data.GetProperty("VerOC").GetBoolean();long Count(string key)=>data.GetProperty(key).GetInt64();}
<link rel="stylesheet" href="~/hyt-dashboard.css" asp-append-version="true" />
<header class="hyt-page-header"><div><h1>Resumen de gestión</h1><p>Documentos registrados del @Model.From.ToString("dd/MM/yyyy") al @Model.To.ToString("dd/MM/yyyy"), con su estado actual.</p></div>@if(budgets||orders){<a class="hyt-button-secondary" asp-controller="Reports" asp-action="Index" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-client="@Model.Client" asp-route-store="@Model.Store">Consultar reportes</a>}</header>
<form class="hyt-filters" asp-controller="Home" asp-action="Index" method="get"><partial name="_DatePicker" model="@(new DatePickerModel("from","Desde",Model.From))" /><partial name="_DatePicker" model="@(new DatePickerModel("to","Hasta",Model.To))" /><div class="hyt-field"><label for="dashboard-client">Cliente (nombre)</label><input id="dashboard-client" type="search" name="client" value="@Model.Client" maxlength="200" /></div><div class="hyt-field"><label for="dashboard-store">Tienda (nombre)</label><input id="dashboard-store" type="search" name="store" value="@Model.Store" maxlength="200" /></div><button class="hyt-button-primary" type="submit">Actualizar panel</button></form>
<p class="hyt-master-trace">Consulta actualizada: @PeruDate.Display(new DateTimeOffset(DateTime.SpecifyKind(data.GetProperty("ActualizadoUTC").GetDateTime(),DateTimeKind.Utc))). Los filtros comerciales buscan en el nombre guardado en cada documento.</p>
@if(!budgets&&!orders){<p class="hyt-panel hyt-master-trace">Tu perfil no tiene acceso a las fuentes de presupuestos u OC de este panel.</p>}
<section class="hyt-dashboard-metrics" aria-label="Indicadores del período">
@if(budgets){<article><h2>Presupuestos</h2><strong>@Count("Presupuestos")</strong><a class="hyt-button-secondary hyt-action-button" asp-controller="Budget" asp-action="Index" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-client="@Model.Client" asp-route-store="@Model.Store">Ver listado</a></article>}
@if(orders)
{
<article><h2>OC del cliente</h2><strong>@Count("Ordenes")</strong><a class="hyt-button-secondary hyt-action-button" asp-controller="Followup" asp-action="Index" asp-route-kind="oc-cliente" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-client="@Model.Client" asp-route-store="@Model.Store">Ver listado</a></article>
<article><h2>Sin confirmar</h2><strong>@Count("SinConfirmar")</strong><a class="hyt-button-secondary hyt-action-button" asp-controller="Reports" asp-action="Index" asp-route-kind="OC_PENDIENTES_FACTURA" asp-route-situation="SIN_CONFIRMAR" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-client="@Model.Client" asp-route-store="@Model.Store">Revisar OC</a></article>
<article><h2>Confirmadas sin marcar</h2><strong>@Count("ConfirmadasSinMarcar")</strong><a class="hyt-button-secondary hyt-action-button" asp-controller="Reports" asp-action="Index" asp-route-kind="OC_PENDIENTES_FACTURA" asp-route-situation="CONFIRMADAS" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-client="@Model.Client" asp-route-store="@Model.Store">Revisar pendientes</a></article>
<article><h2>Marcadas Facturado</h2><strong>@Count("Facturadas")</strong><a class="hyt-button-secondary hyt-action-button" asp-controller="Reports" asp-action="Index" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-client="@Model.Client" asp-route-store="@Model.Store" asp-route-kind="OC_COMPLETADAS" asp-route-situation="FACTURADAS">Ver referencias vigentes</a></article>
<article><h2>Listas para marcar</h2><strong>@Count("ListasParaMarcar")</strong><span>Trabajo terminado, guía aceptada y confirmación vigente.</span><a class="hyt-button-secondary hyt-action-button" asp-controller="Reports" asp-action="Index" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-client="@Model.Client" asp-route-store="@Model.Store" asp-route-kind="OC_PENDIENTES_FACTURA" asp-route-situation="LISTAS">Revisar listas para marcar</a></article>
}
</section>
@if(budgets||orders)
{
<section class="hyt-panel hyt-dashboard-chart"><header><h2>Registros en el tiempo</h2><p>Fecha de registro en Perú. Confirmaciones y marcados cuentan la primera incorporación al sistema por OC, aunque su OC sea anterior al período; las correcciones y los retiros posteriores no agregan eventos.</p></header><div class="hyt-chart-controls">@if(budgets){<label><input type="checkbox" data-chart-series="Presupuestos" checked /> Presupuestos</label>}@if(orders){<label><input type="checkbox" data-chart-series="Ordenes" checked /> OC del cliente</label><label><input type="checkbox" data-chart-series="Confirmaciones" /> Primera confirmación</label><label><input type="checkbox" data-chart-series="Marcados" /> Primer marcado</label>}<label>Agrupar por<select data-chart-group><option value="day">Día</option><option value="week">Semana</option><option value="month">Mes</option></select></label></div>
<svg data-chart="trend" viewBox="0 0 760 270" role="img" aria-label="Curvas de registros de presupuestos y OC"></svg><p data-chart-note></p><output data-chart-readout aria-live="polite">Selecciona un punto para consultar su fecha y cantidad.</output><a class="hyt-button-secondary hyt-action-button" data-chart-link hidden></a></section>
<div class="hyt-dashboard-charts">
<section class="hyt-panel hyt-dashboard-chart"><h2>Estados de @(budgets?"presupuestos":"OC")</h2><svg data-chart="states" viewBox="0 0 760 300" role="img" aria-label="Columnas de cantidad por estado"></svg></section>
@if(orders){<section class="hyt-panel hyt-dashboard-chart"><h2>Seguimiento de OC activas</h2><svg data-chart="donut" viewBox="0 0 360 260" role="img" aria-label="Distribución de OC sin confirmar, confirmadas sin marcado y facturadas"></svg><ul data-donut-legend></ul><p>Las confirmadas sin marcar pueden tener trabajo o guía pendientes.</p></section>}
</div>
<section class="hyt-panel hyt-dashboard-chart"><h2>Importes por moneda</h2><p>Valor de las revisiones de presupuesto y de las revisiones vinculadas a OC. Se excluyen cancelados. Los dos documentos representan vistas del mismo servicio y no se suman entre sí.</p>
<div class="hyt-dashboard-money">@foreach(var source in new[]{(Key:"ImportesPresupuesto",Label:"Presupuestos"),(Key:"ImportesOC",Label:"OC del cliente")})
{
@if((source.Key=="ImportesPresupuesto"&&budgets)||(source.Key=="ImportesOC"&&orders))
{<div><h3>@source.Label</h3>@foreach(var amount in data.GetProperty(source.Key).EnumerateArray()){<p><strong>@amount.GetProperty("CodigoMoneda").GetString() @ReportingDates.Number(amount.GetProperty("Importe").ValueKind==JsonValueKind.Null?null:amount.GetProperty("Importe").GetDecimal())</strong> · @amount.GetProperty("Cantidad").GetInt64() documentos</p>@if(amount.TryGetProperty("PreciosPendientes",out var pending)&&pending.GetInt64()>0){<p>@pending.GetInt64() documentos con precios pendientes; su importe no se considera cero.</p>}}@if(data.GetProperty(source.Key).GetArrayLength()==0){<p>Sin importes en este período.</p>}</div>}
}
</div></section>
<details class="hyt-panel hyt-dashboard-chart"><summary>Consultar cifras de los gráficos</summary><div class="hyt-table-wrap"><table class="hyt-table"><thead><tr><th>Fuente</th><th>Estado / fecha</th><th>Presupuestos / OC</th><th>Primera confirmación / marcado</th></tr></thead><tbody>
@foreach(var source in new[]{(Key:"EstadosPresupuesto",Label:"Presupuestos"),(Key:"EstadosOC",Label:"OC")}){@foreach(var row in data.GetProperty(source.Key).EnumerateArray()){<tr><td>@source.Label</td><td>@row.GetProperty("Estado").GetString()</td><td>@row.GetProperty("Cantidad").GetInt64()</td><td>—</td></tr>}}
@foreach(var day in data.GetProperty("Movimientos").EnumerateArray()){<tr><td>Presupuestos / OC</td><td>@day.GetProperty("Fecha").GetString()</td><td>@day.GetProperty("Presupuestos").GetInt64() / @day.GetProperty("Ordenes").GetInt64()</td><td>@day.GetProperty("Confirmaciones").GetInt64() / @day.GetProperty("Marcados").GetInt64()</td></tr>}
</tbody></table></div></details>
}
@if(data.GetProperty("VerPendientes").GetBoolean())
{
<section class="hyt-panel hyt-dashboard-chart"><h2>Expedientes por completar</h2><p>@Count("PendientesPeriodo") registrados en el período · @Count("TotalPendientes") acumulados hasta @Model.To.ToString("dd/MM/yyyy"), incluidos los anteriores al período. Los filtros de cliente y tienda se conservan. Una fila puede tener varios pendientes.</p>
<div class="hyt-table-wrap"><table class="hyt-table"><thead><tr><th>Presupuesto</th><th>Cliente / tienda</th><th>Registro</th><th>Antigüedad al consultar</th><th>Pendientes</th><th>Acción</th></tr></thead><tbody>
@foreach(var row in data.GetProperty("Pendientes").EnumerateArray())
{<tr><td>@row.GetProperty("Numero").GetString()</td><td>@row.GetProperty("ClienteNombre").GetString() / @row.GetProperty("TiendaNombre").GetString()</td><td>@PeruDate.Display(new DateTimeOffset(DateTime.SpecifyKind(row.GetProperty("FechaRegistro").GetDateTime(),DateTimeKind.Utc)))</td><td>@row.GetProperty("DiasPendiente").GetInt32() días</td><td>@if(row.GetProperty("SinOC").GetBoolean()){<span>Sin OC. </span>}@if(row.GetProperty("SinGuia").GetBoolean()){<span>Sin guía. </span>}@if(row.GetProperty("EmergenciaPorRegularizar").GetBoolean()){<span>Emergencia por regularizar.</span>}</td><td><a class="hyt-button-secondary hyt-action-button" asp-controller="Budget" asp-action="Details" asp-route-id="@row.GetProperty("Id").GetInt64()" asp-route-returnUrl="@(Context.Request.Path+Context.Request.QueryString)">Abrir expediente</a></td></tr>}
@if(data.GetProperty("Pendientes").GetArrayLength()==0){<tr><td colspan="6">Sin expedientes pendientes en esta página.</td></tr>}
</tbody></table></div><nav class="hyt-pagination" aria-label="Páginas de pendientes">
@if(Model.QueuePage>1){<a class="hyt-button-secondary hyt-action-button" asp-action="Index" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-client="@Model.Client" asp-route-store="@Model.Store" asp-route-queuePage="@(Model.QueuePage-1)">Anterior</a>}
<span>Página @Model.QueuePage · 20 por página</span>
@if((long)Model.QueuePage*20<Count("TotalPendientes")){<a class="hyt-button-secondary hyt-action-button" asp-action="Index" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-client="@Model.Client" asp-route-store="@Model.Store" asp-route-queuePage="@(Model.QueuePage+1)">Siguiente</a>}
</nav></section>
}
<script type="application/json" id="hyt-dashboard-data">@Html.Raw(JsonSerializer.Serialize(new{from=Model.From.ToString("yyyy-MM-dd"),to=Model.To.ToString("yyyy-MM-dd"),client=Model.Client,store=Model.Store,data=Model.Data}))</script>