@* Firma: FRANCO LARA - 06/11/2026 | Estados comerciales en el detalle accesible del panel. Guía registrada sin aceptación adicional. Panel centrado en estados vigentes y pendientes documentales; accesos al reporte integral. Series legibles Confirmación del cliente y Facturado con registros vigentes, sin denominaciones de primeros eventos. *@
@using System.Text.Json
@using GestionServicios.Web.Security
@using GestionServicios.Web.ViewModels.Reporting
@model DashboardModel
@* Firma: FRANCO LARA - 03/11/2026 | Panel HYT con métricas, curvas, columnas, dona y detalle accesible por moneda. *@
@* Firma: FRANCO LARA - 05/11/2026 | Filtros cliente/tienda, primeros eventos, agrupación temporal y bandeja de pendientes histórica; Acciones presentadas como botones HYT. *@
@{var data=Model.Data;var budgets=data.GetProperty("VerPresupuestos").GetBoolean();var orders=data.GetProperty("VerOC").GetBoolean();long Count(string key)=>data.GetProperty(key).GetInt64();}
<link rel="stylesheet" href="~/hyt-dashboard.css" asp-append-version="true" />
<header class="hyt-page-header"><div><h1>Resumen de gestión</h1><p>Documentos registrados del @Model.From.ToString("dd/MM/yyyy") al @Model.To.ToString("dd/MM/yyyy"), con su estado actual.</p></div>@if(budgets||orders){<a class="hyt-button-secondary" asp-controller="Reports" asp-action="Index" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" >Consultar reportes</a>}</header>
<form class="hyt-filters" asp-controller="Home" asp-action="Index" method="get"><partial name="_DatePicker" model="@(new DatePickerModel("from","Desde",Model.From))" /><partial name="_DatePicker" model="@(new DatePickerModel("to","Hasta",Model.To))" /><button class="hyt-button-primary" type="submit">Actualizar panel</button></form>
<p class="hyt-master-trace">Consulta actualizada: @PeruDate.Display(new DateTimeOffset(DateTime.SpecifyKind(data.GetProperty("ActualizadoUTC").GetDateTime(),DateTimeKind.Utc))). Los estados muestran la situación actual; los pendientes corresponden al período consultado.</p>
@if(!budgets&&!orders){<p class="hyt-panel hyt-master-trace">Tu perfil no tiene acceso a las fuentes de presupuestos u OC de este panel.</p>}
<section class="hyt-operational-flow" aria-label="Flujo vigente"><strong>Presupuesto</strong><span>→ OC del cliente / Guía</span><span>Confirmación de OC → Trabajo completado</span><span>Guía + confirmación → Facturado</span><small>Guía y ejecución son fichas documentales; no requieren cambiar estados por separado.</small></section>
@if(budgets||orders){<section class="hyt-panel hyt-dashboard-chart"><header class="hyt-dashboard-section-heading"><h2>Estados actuales</h2><span>Presupuestos: @Count("Presupuestos") · OC: @Count("Ordenes")</span></header>
@foreach(var source in new[]{(Kind:"PRESUPUESTO",Key:"EstadosPresupuesto",Label:"Presupuestos",Visible:budgets),(Kind:"OC_CLIENTE",Key:"EstadosOC",Label:"Orden de Compra - Cliente",Visible:orders)}){
@if(source.Visible){<h3>@source.Label</h3><div class="hyt-dashboard-states">@foreach(var state in ReportDisplay.States(source.Kind)){var matching=data.GetProperty(source.Key).EnumerateArray().Where(row=>row.GetProperty("Estado").GetString()==state.Key);var count=matching.Sum(row=>row.GetProperty("Cantidad").GetInt64());<a class="hyt-internal-code" href="@("/Reportes?kind="+source.Kind+"&state="+state.Key+"&from="+Model.From.ToString("yyyy-MM-dd")+"&to="+Model.To.ToString("yyyy-MM-dd"))"><span>@state.Value</span><output>@count</output></a>}</div>}
}</section>}
<section class="hyt-dashboard-metrics" aria-label="Pendientes del período">
@if(budgets){
@if(User.HasClaim(AccessService.PermissionClaim,"OC_CLIENTE.CONSULTAR")){<article><h2>Pendiente de OC del cliente</h2><strong>@Count("PresupuestosSinOC")</strong><a class="hyt-button-secondary" href="@("/Reportes?kind=PRESUPUESTO&pendingOrder=true&from="+Model.From.ToString("yyyy-MM-dd")+"&to="+Model.To.ToString("yyyy-MM-dd"))">Revisar presupuestos</a></article>}
@if(User.HasClaim(AccessService.PermissionClaim,"GUIAS.CONSULTAR")){<article><h2>Pendiente de guía</h2><strong>@Count("PresupuestosSinGuia")</strong><a class="hyt-button-secondary" href="@("/Reportes?kind=PRESUPUESTO&pendingGuide=true&from="+Model.From.ToString("yyyy-MM-dd")+"&to="+Model.To.ToString("yyyy-MM-dd"))">Revisar guías pendientes</a></article>}
}
@if(orders){
@if(User.HasClaim(AccessService.PermissionClaim,"CONFIRMACIONES.CONSULTAR")){<article><h2>Pendiente de confirmación del cliente</h2><strong>@Count("SinConfirmar")</strong><a class="hyt-button-secondary" href="@("/Reportes?kind=OC_CLIENTE&pendingConfirmation=true&from="+Model.From.ToString("yyyy-MM-dd")+"&to="+Model.To.ToString("yyyy-MM-dd"))">Revisar OC</a></article>}
@if(User.HasClaim(AccessService.PermissionClaim,"FACTURADO.CONSULTAR")){<article><h2>Pendiente de facturar</h2><strong>@Count("PendientesFacturar")</strong><a class="hyt-button-secondary" href="@("/Reportes?kind=OC_CLIENTE&pendingInvoice=true&from="+Model.From.ToString("yyyy-MM-dd")+"&to="+Model.To.ToString("yyyy-MM-dd"))">Revisar pendientes</a></article>}
<article><h2>Listas para marcar Facturado</h2><strong>@Count("ListasParaMarcar")</strong><span>Trabajo completado, guía registrada y confirmación vigente.</span></article>
<article><h2>Marcadas Facturado</h2><strong>@Count("Facturadas")</strong><span>Referencias vigentes de comprobantes externos.</span></article>
}
</section>
@if(budgets||orders)
{
<section class="hyt-panel hyt-dashboard-chart"><header><h2>Registros en el tiempo</h2><p>Cantidad de registros por fecha en Perú. Confirmación del cliente y Facturado consideran registros vigentes; los estados actuales se consultan en las tarjetas del panel.</p></header><div class="hyt-chart-controls">@if(budgets){<label><input type="checkbox" data-chart-series="Presupuestos" checked /> Presupuestos</label>}@if(orders){<label><input type="checkbox" data-chart-series="Ordenes" checked /> OC del cliente</label><label><input type="checkbox" data-chart-series="Confirmaciones" /> Confirmación del cliente</label><label><input type="checkbox" data-chart-series="Marcados" /> Facturado</label>}<label>Agrupar por<select data-chart-group><option value="day">Día</option><option value="week">Semana</option><option value="month">Mes</option></select></label></div>
<svg data-chart="trend" viewBox="0 0 760 270" role="img" aria-label="Curvas de registros de presupuestos y OC"></svg><p data-chart-note></p><output data-chart-readout aria-live="polite">Selecciona un punto para consultar su fecha y cantidad.</output><a class="hyt-button-secondary hyt-action-button" data-chart-link hidden></a></section>
<div class="hyt-dashboard-charts">
@if(budgets){<section class="hyt-panel hyt-dashboard-chart"><h2>Estados de presupuestos</h2><svg data-chart="states" data-state-source="PRESUPUESTO" viewBox="0 0 760 300" role="img" aria-label="Columnas de presupuestos por estado"></svg></section>}
@if(orders){<section class="hyt-panel hyt-dashboard-chart"><h2>Estados de OC del cliente</h2><svg data-chart="states-oc" data-state-source="OC_CLIENTE" viewBox="0 0 760 300" role="img" aria-label="Columnas de OC por estado"></svg></section>}
@if(orders){<section class="hyt-panel hyt-dashboard-chart"><h2>Documentación de OC para facturar</h2><svg data-chart="donut" viewBox="0 0 360 260" role="img" aria-label="Distribución de OC sin confirmar, confirmadas sin marcado y facturadas"></svg><ul data-donut-legend></ul><p>Las confirmadas sin marcar pueden tener trabajo o guía pendientes.</p></section>}
</div>
<section class="hyt-panel hyt-dashboard-chart"><h2>Importes por moneda</h2><p>Valor de las revisiones de presupuesto y de las revisiones vinculadas a OC. Se excluyen cancelados. Los dos documentos representan vistas del mismo servicio y no se suman entre sí.</p>
<div class="hyt-dashboard-money">@foreach(var source in new[]{(Key:"ImportesPresupuesto",Label:"Presupuestos"),(Key:"ImportesOC",Label:"OC del cliente")})
{
@if((source.Key=="ImportesPresupuesto"&&budgets)||(source.Key=="ImportesOC"&&orders))
{<div><h3>@source.Label</h3>@foreach(var amount in data.GetProperty(source.Key).EnumerateArray()){<p><strong>@amount.GetProperty("CodigoMoneda").GetString() @ReportingDates.Number(amount.GetProperty("Importe").ValueKind==JsonValueKind.Null?null:amount.GetProperty("Importe").GetDecimal())</strong> · @amount.GetProperty("Cantidad").GetInt64() documentos</p>@if(amount.TryGetProperty("PreciosPendientes",out var pending)&&pending.GetInt64()>0){<p>@pending.GetInt64() documentos con precios pendientes; su importe no se considera cero.</p>}}@if(data.GetProperty(source.Key).GetArrayLength()==0){<p>Sin importes en este período.</p>}</div>}
}
</div></section>
<details class="hyt-panel hyt-dashboard-chart"><summary>Consultar cifras de los gráficos</summary><div class="hyt-table-wrap"><table class="hyt-table"><thead><tr><th>Fuente</th><th>Estado / fecha</th><th>Presupuestos / OC</th><th>Confirmación del cliente / Facturado</th></tr></thead><tbody>
@foreach(var source in new[]{(Key:"EstadosPresupuesto",Label:"Presupuestos"),(Key:"EstadosOC",Label:"OC")}){@foreach(var row in data.GetProperty(source.Key).EnumerateArray()){<tr><td>@source.Label</td><td>@(source.Key=="EstadosPresupuesto"?GestionServicios.Web.ViewModels.Budgets.BudgetStates.Label(row.GetProperty("Estado").GetString()!):ReportDisplay.State(row.GetProperty("Estado").GetString()!))</td><td>@row.GetProperty("Cantidad").GetInt64()</td><td>—</td></tr>}}
@foreach(var day in data.GetProperty("Movimientos").EnumerateArray()){<tr><td>Presupuestos / OC</td><td>@day.GetProperty("Fecha").GetString()</td><td>@day.GetProperty("Presupuestos").GetInt64() / @day.GetProperty("Ordenes").GetInt64()</td><td>@day.GetProperty("Confirmaciones").GetInt64() / @day.GetProperty("Marcados").GetInt64()</td></tr>}
</tbody></table></div></details>
}
@if(data.GetProperty("VerPendientes").GetBoolean())
{
<section class="hyt-panel hyt-dashboard-chart"><h2>Expedientes por completar</h2><p>@Count("PendientesPeriodo") registrados en el período · @Count("TotalPendientes") acumulados hasta @Model.To.ToString("dd/MM/yyyy"), incluidos los anteriores al período. Una fila puede tener varios pendientes.</p>
<div class="hyt-table-wrap"><table class="hyt-table"><thead><tr><th>Presupuesto</th><th>Cliente / tienda</th><th>Registro</th><th>Antigüedad al consultar</th><th>Pendientes</th><th>Acción</th></tr></thead><tbody>
@foreach(var row in data.GetProperty("Pendientes").EnumerateArray())
{<tr><td>@row.GetProperty("Numero").GetString()</td><td>@row.GetProperty("ClienteNombre").GetString() / @row.GetProperty("TiendaNombre").GetString()</td><td>@PeruDate.Display(new DateTimeOffset(DateTime.SpecifyKind(row.GetProperty("FechaRegistro").GetDateTime(),DateTimeKind.Utc)))</td><td>@row.GetProperty("DiasPendiente").GetInt32() días</td><td>@if(row.GetProperty("SinOC").GetBoolean()){<span>Sin OC. </span>}@if(row.GetProperty("SinGuia").GetBoolean()){<span>Sin guía. </span>}@if(row.GetProperty("EmergenciaPorRegularizar").GetBoolean()){<span>Emergencia sin aceptación.</span>}</td><td><a class="hyt-button-secondary hyt-action-button" asp-controller="Budget" asp-action="Details" asp-route-id="@row.GetProperty("Id").GetInt64()" asp-route-returnUrl="@(Context.Request.Path+Context.Request.QueryString)">Abrir expediente</a></td></tr>}
@if(data.GetProperty("Pendientes").GetArrayLength()==0){<tr><td colspan="6">Sin expedientes pendientes en esta página.</td></tr>}
</tbody></table></div><nav class="hyt-pagination" aria-label="Páginas de pendientes">
@if(Model.QueuePage>1){<a class="hyt-button-secondary hyt-action-button" asp-action="Index" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"  asp-route-queuePage="@(Model.QueuePage-1)">Anterior</a>}
<span>Página @Model.QueuePage · 20 por página</span>
@if((long)Model.QueuePage*20<Count("TotalPendientes")){<a class="hyt-button-secondary hyt-action-button" asp-action="Index" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"  asp-route-queuePage="@(Model.QueuePage+1)">Siguiente</a>}
</nav></section>
}
<script type="application/json" id="hyt-dashboard-data">@Html.Raw(JsonSerializer.Serialize(new{from=Model.From.ToString("yyyy-MM-dd"),to=Model.To.ToString("yyyy-MM-dd"),client=Model.Client,store=Model.Store,data=Model.Data}))</script>
