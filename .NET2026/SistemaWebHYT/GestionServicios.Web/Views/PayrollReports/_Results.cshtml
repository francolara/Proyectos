@model GestionServicios.Web.Controllers.PayrollReportPage
@* Firma: FRANCO LARA - 10/11/2026 | Grilla compartida por la vista previa y la impresión de los tres tipos de reporte. *@
<section class="hyt-report-summary">
    <h2>@Model.Title</h2>
    <p>@Model.FilterSummary</p>
    <p><strong>@Model.Count registros</strong>
        @if (Model.Filter.Kind == "personal") { <span> · @(Model.Report!.Cerrado ? "Mes cerrado" : "Mes abierto")</span> }
    </p>
</section>
<div class="hyt-panel hyt-table-wrap" tabindex="0" role="region" aria-label="Resultados de @Model.Title">
    @if (Model.Filter.Kind == "personal")
    {
        <table class="hyt-table hyt-payroll-report-table">
            <thead><tr><th scope="col">Trabajador</th><th scope="col">Tipo</th><th scope="col">Moneda</th>
                <th scope="col" class="hyt-money">Saldo anterior</th><th scope="col" class="hyt-money">Devengado</th>
                <th scope="col" class="hyt-money">Adelantos</th><th scope="col" class="hyt-money">Descuentos</th>
                <th scope="col" class="hyt-money">Pagado</th><th scope="col" class="hyt-money">Saldo final</th></tr></thead>
            <tbody>
                @if (Model.Count == 0) { <tr><td colspan="9" class="hyt-grid-message">No hay movimientos ni saldos de personal para los filtros seleccionados.</td></tr> }
                @foreach (var row in Model.Report!.Personal)
                {
                    <tr><td>
                        @if (Model.IsPrint) { @row.NombreCompleto }
                        else
                        {
                            <a asp-controller="PersonalPayments" asp-action="Index" asp-route-id="@row.TrabajadorId"
                               asp-route-month="@Model.Filter.Month">@row.NombreCompleto</a>
                        }
                    </td><td>@(row.TipoTrabajador == "PLANILLA" ? "En planilla" : "Externo")</td><td>@row.MonedaCodigo</td>
                        <td class="hyt-money">@row.SaldoAnterior.ToString("N2")</td><td class="hyt-money">@row.Devengado.ToString("N2")</td>
                        <td class="hyt-money">@row.Adelantado.ToString("N2")</td><td class="hyt-money">@row.Descontado.ToString("N2")</td>
                        <td class="hyt-money">@row.Pagado.ToString("N2")</td><td class="hyt-money">@row.Saldo.ToString("N2")</td></tr>
                }
            </tbody>
        </table>
    }
    else if (Model.Filter.Kind == "proveedores")
    {
        <table class="hyt-table hyt-payroll-report-table">
            <thead><tr><th scope="col">Proveedor</th><th scope="col" class="hyt-numeric">Presupuesto</th><th scope="col">Moneda</th>
                <th scope="col" class="hyt-money">Costo</th><th scope="col" class="hyt-money">Pagado en el mes</th>
                <th scope="col" class="hyt-money">Pagado acumulado</th><th scope="col" class="hyt-money">Pendiente</th></tr></thead>
            <tbody>
                @if (Model.Count == 0) { <tr><td colspan="7" class="hyt-grid-message">No hay pagos ni costos pendientes para los filtros seleccionados.</td></tr> }
                @foreach (var row in Model.Report!.Proveedores)
                {
                    <tr><td>@row.RazonSocial</td><td class="hyt-numeric">@row.NumeroInterno</td><td>@row.MonedaCodigo</td>
                        <td class="hyt-money">@row.Costo.ToString("N2")</td><td class="hyt-money">@row.PagadoMes.ToString("N2")</td>
                        <td class="hyt-money">@row.PagadoAcumulado.ToString("N2")</td><td class="hyt-money">@row.Pendiente.ToString("N2")</td></tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <table class="hyt-table hyt-payroll-report-table">
            <thead><tr><th scope="col">Régimen</th><th scope="col">Entidad</th><th scope="col" class="hyt-money">Importe (S/)</th>
                <th scope="col" class="hyt-numeric">Vencimiento</th><th scope="col">Estado</th>
                <th scope="col" class="hyt-numeric">Fecha de pago</th><th scope="col" class="hyt-numeric">N.º de operación</th></tr></thead>
            <tbody>
                @if (Model.Count == 0) { <tr><td colspan="7" class="hyt-grid-message">No hay obligaciones para los filtros seleccionados.</td></tr> }
                @foreach (var row in Model.Obligations)
                {
                    <tr><td>@row.Tipo</td><td>@row.Entidad</td><td class="hyt-money">@row.Importe.ToString("N2")</td>
                        <td class="hyt-numeric">@row.Vencimiento.ToString("dd/MM/yyyy")</td>
                        <td>@(row.Estado switch { "PAGADA" => "Pagada", "VENCIDA" => "Pendiente · Vencida", _ => "Pendiente" })</td>
                        <td class="hyt-numeric">@(row.FechaPago?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="hyt-numeric">@(row.ReferenciaPago ?? "—")</td></tr>
                }
            </tbody>
        </table>
    }
</div>
