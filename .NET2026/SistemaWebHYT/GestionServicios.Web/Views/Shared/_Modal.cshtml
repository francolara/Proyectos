@model ModalModel
@* Firma: FRANCO LARA - 03/11/2026 | Popup MVC compartido con foco nativo, cierre y cuerpo parcial. *@
<dialog id="@Model.Id" class="hyt-modal" aria-labelledby="@(Model.Id + "_title")" data-hyt-modal><header class="hyt-modal-header"><div><h2 id="@(Model.Id + "_title")">@Model.Title</h2>@if (Model.Subtitle is not null) { <p>@Model.Subtitle</p> }</div><button class="hyt-modal-close" type="button" data-hyt-close aria-label="Cerrar ventana">×</button></header><div class="hyt-modal-body">@if (Model.ContentPartial is not null) { @await Html.PartialAsync(Model.ContentPartial, Model.Content) }</div><footer class="hyt-modal-footer"><button class="hyt-button-secondary" type="button" data-hyt-close>Cancelar</button></footer></dialog>
