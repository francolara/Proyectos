@* Firma: FRANCO LARA - 07/11/2026 | Acceso al cambio de contraseña desde la cabecera y control común de visibilidad. *@
@* Firma: FRANCO LARA - 06/11/2026 | Botón de cerrar sesión rojo con icono. *@
@using GestionServicios.Web.Navigation
@using GestionServicios.Web.Security
@* Firma: FRANCO LARA - 03/11/2026 | Layout MVC HYT, menú por permisos, popup documental y presentación adaptable. *@
@* Firma: FRANCO LARA - 05/11/2026 | Indicador común para consultas, navegación y envíos, visible sobre ventanas; Temas persistentes, selector en menú y ancho por tipo de vista. *@
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><script src="~/hyt-theme-switch.js" asp-append-version="true"></script><title>@ViewData["Title"] | HYT</title><link rel="stylesheet" href="~/hyt-theme.css" asp-append-version="true" /><link rel="stylesheet" href="~/hyt-components.css" asp-append-version="true" /><link rel="stylesheet" href="~/hyt-loading.css" asp-append-version="true" /><link rel="stylesheet" href="~/hyt-interface.css" asp-append-version="true" /><script src="~/hyt-loading.js" asp-append-version="true" defer></script></head>
<body><a class="skip-link" href="#contenido">Ir al contenido</a><div class="hyt-app-shell">
<aside class="hyt-sidebar"><a class="hyt-brand" asp-controller="Home" asp-action="Index" aria-label="HYT, inicio"><img src="~/images/logo-hyt.png" alt="HYT Servicios Generales E.I.R.L." /></a>
<button type="button" class="hyt-theme-toggle" data-hyt-theme-toggle aria-label="Modo oscuro" aria-pressed="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"/></svg><span data-hyt-theme-label>Modo oscuro</span></button><button type="button" class="hyt-menu-toggle" aria-expanded="false" aria-controls="hyt-navigation" data-hyt-menu>Menú de navegación</button>
<nav id="hyt-navigation" aria-label="Navegación principal">@if (!User.HasClaim(AccessService.MandatoryPasswordClaim, "true")) { <a class="hyt-nav-link @(Context.Request.Path == "/" ? "active" : "")" asp-controller="Home" asp-action="Index">Inicio</a> }
@foreach (var group in HytMenu.Items.Where(item => User.HasClaim(AccessService.PermissionClaim, item.Permission) || item.Code == "usuarios" && User.HasClaim(AccessService.PermissionClaim, "PERFILES.CONSULTAR")).GroupBy(item => item.Group))
{ <p class="hyt-nav-group">@group.Key</p>@foreach (var item in group) { <a class="hyt-nav-link @(Context.Request.Path.Equals("/modulo/" + item.Code) ? "active" : "")" href="@Url.Action("Index", "Module", new { code = item.Code })">@item.Label</a> } }
</nav><span class="hyt-sidebar-company">H Y T Servicios Generales E.I.R.L.</span></aside>
<div class="hyt-main-shell"><header class="hyt-topbar"><span>Gestión de servicios</span><div>@if (User.Identity?.IsAuthenticated == true) { <span class="hyt-user-name">@User.Identity.Name</span><a class="hyt-button-secondary" href="/Cuenta/CambiarClave">Cambiar contraseña</a><a class="hyt-button-primary hyt-logout-button" asp-controller="Access" asp-action="Logout"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 17v4H3V3h7v4M8 12h13m-4-4 4 4-4 4"/></svg><span>Cerrar sesión</span></a> }</div></header><main id="contenido" class="hyt-workspace @(ViewData["Wide"] is true ? "hyt-workspace-wide" : null)">@if (TempData["PasswordChanged"] is true) { <p role="status">Contraseña actualizada.</p> }@RenderBody()</main><footer class="hyt-footer">HYT · Seguimiento de servicios y documentos</footer></div></div>
<dialog id="document-dialog" class="hyt-modal" aria-labelledby="document-dialog-title"><header class="hyt-modal-header"><h2 id="document-dialog-title">Registro documental</h2><button type="button" class="hyt-modal-close" data-hyt-close aria-label="Cerrar ventana">×</button></header><div class="hyt-modal-body" data-document-body></div></dialog>
<script type="module" src="~/hyt-documents.js" asp-append-version="true"></script><script type="module" src="~/hyt-ui.js" asp-append-version="true"></script><script src="~/hyt-dates.js" asp-append-version="true" defer></script><script src="~/hyt-password.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
