@using GestionServicios.Application.Maintenance
@using System.Globalization
@model (string Id,string Target,string? LabelTarget,IReadOnlyList<CatalogOption> Options)
@* Firma: FRANCO LARA - 17/11/2026 | Diálogo compartido de detracciones para comprobantes y materiales. *@
<dialog id="@Model.Id" class="hyt-modal" aria-labelledby="@(Model.Id+"-title")"
        data-payroll-catalog data-target="@Model.Target" data-label-target="@Model.LabelTarget">
    <header class="hyt-modal-header">
        <h2 id="@(Model.Id+"-title")">Ayuda de detracciones</h2>
        <button type="button" class="hyt-modal-close" data-hyt-close aria-label="Cerrar ayuda">×</button>
    </header>
    <div class="hyt-modal-body">
        <div class="hyt-field"><label for="@(Model.Id+"-search")">Buscar por código o nombre</label>
            <input id="@(Model.Id+"-search")" type="search" data-catalog-search autofocus />
        </div>
        <div class="hyt-table-wrap" tabindex="0" role="region" aria-label="Códigos de detracción">
            <table class="hyt-table">
                <thead><tr><th>Código</th><th>Nombre</th><th>Porcentaje</th><th>Acción</th></tr></thead>
                <tbody>
                @foreach(var option in Model.Options)
                {
                    var name=option.Label.StartsWith(option.Code+" · ") ? option.Label[(option.Code.Length+3)..] : option.Label;
                    <tr data-catalog-row>
                        <td>@option.Code</td><td>@name</td><td>@(option.Percentage?.ToString("0.####")+"%")</td>
                        <td><button type="button" class="hyt-button-secondary" data-catalog-select="@option.Code"
                            data-catalog-label="@($"{option.Code} · {name}")" data-withholding-rate="@option.Percentage?.ToString(CultureInfo.InvariantCulture)">Seleccionar</button></td>
                    </tr>
                }
                <tr data-catalog-empty hidden><td colspan="4" class="hyt-grid-message">No se encontraron códigos.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</dialog>
