@model DatePickerModel
@* Firma: FRANCO LARA - 03/11/2026 | Campo MVC nativo mejorado con calendario de FralseCont y colores HYT. *@
<div class="hyt-date-field"><label for="@Model.Id">@Model.Label</label><input id="@Model.Id" name="@Model.Name" type="date" value="@Model.Value?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" min="@Model.Min?.ToString("yyyy-MM-dd")" max="@Model.Max?.ToString("yyyy-MM-dd")" readonly="@Model.ReadOnly" required="@Model.Required" class="form-control" /></div>
