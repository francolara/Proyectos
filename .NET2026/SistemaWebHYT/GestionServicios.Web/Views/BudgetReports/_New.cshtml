@using GestionServicios.Web.ViewModels.Budgets
@model BudgetPrintModel
@* Firma: FRANCO LARA - 03/11/2026 | Formato nuevo de once columnas con referencias SAP y moneda real. *@
<section class="report-metadata"><dl><dt>Cliente</dt><dd>@Model.Text("ClienteNombre")</dd><dt>Dirección</dt><dd>@Model.Text("ClienteDireccion")</dd><dt>Tienda</dt><dd>@Model.Text("TiendaCodigo") @Model.Text("TiendaNombre")</dd><dt>Fecha</dt><dd>@BudgetPrintModel.Date(Model.Text("FechaEmision"))</dd><dt>Trimestre</dt><dd>@Model.Text("Trimestre")</dd><dt>Zona</dt><dd>@Model.Text("ZonaTexto")</dd><dt>Precios válidos</dt><dd>@Model.Text("VigenciaTexto")</dd><dt>Proveedor</dt><dd>@Model.CompanyText("RazonSocial")</dd><dt>Código SAP</dt><dd>@Model.Text("CodigoSAPProveedor")</dd><dt>Contrato marco</dt><dd>@Model.Text("ContratoMarco")</dd><dt>Especialidad</dt><dd>@Model.Text("Especialidad")</dd><dt>N° cotización</dt><dd>@Model.Text("NumeroCotizacionCliente")</dd><dt>Fecha de ejecución</dt><dd>@BudgetPrintModel.Date(Model.Text("FechaEjecucion"))</dd></dl></section>
<p class="report-work">@Model.Text("DescripcionTrabajo")</p>
<table class="report-detail report-new-table"><colgroup><col style="width:7%" /><col style="width:7%" /><col style="width:7%" /><col style="width:7%" /><col style="width:7%" /><col style="width:9%" /><col style="width:23%" /><col style="width:6%" /><col style="width:6%" /><col style="width:10%" /><col style="width:11%" /></colgroup><thead><tr><th>Tienda</th><th>Centro SAP FICO</th><th>N° neces.</th><th>Tipo serv.</th><th><abbr title="Posición">Pos.</abbr></th><th>Material SAP</th><th>Descripción</th><th><abbr title="Unidad">Und.</abbr></th><th>Cant.</th><th>Precio @Model.Currency @Model.PriceTax</th><th>Subtotal @Model.PriceTax</th></tr></thead>
@if(Model.Groups.Count==0){<tbody><tr><td colspan="11">El borrador todavía no contiene partidas.</td></tr></tbody>}
@foreach(var group in Model.Groups){<tbody>@if(!string.IsNullOrWhiteSpace(group.Name)){<tr class="report-group"><th colspan="10">@group.Name</th><td class="report-number">@BudgetPrintModel.Money(Model.GroupAmount(group))</td></tr>}
@foreach(var line in group.Lines){<tr><td>@(string.IsNullOrWhiteSpace(Model.Text("TiendaCodigo"))?Model.Text("TiendaNombre"):Model.Text("TiendaCodigo"))</td><td>@BudgetPrintModel.Value(line,"CentroSAPFICO")</td><td>@BudgetPrintModel.Value(line,"NumeroNecesidad")</td><td>@BudgetPrintModel.Value(line,"TipoServicio")</td><td>@BudgetPrintModel.Value(line,"Posicion")</td><td>@BudgetPrintModel.Value(line,"CodigoMaterialSAP")</td><td class="report-description">@BudgetPrintModel.Value(line,"Descripcion")</td><td>@BudgetPrintModel.Value(line,"Unidad")</td><td class="report-number">@BudgetPrintModel.Money(BudgetPrintModel.Amount(line,"Cantidad"))</td><td class="report-number">@BudgetPrintModel.Money(BudgetPrintModel.Amount(line,"PrecioUnitario"))</td><td class="report-number">@BudgetPrintModel.Money(Model.LineAmount(line))</td></tr>}
</tbody>}
</table>
