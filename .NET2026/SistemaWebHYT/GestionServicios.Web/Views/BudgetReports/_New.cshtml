@* Firma: FRANCO LARA - 10/11/2026 | Imprime el número del presupuesto como cotización y retira las filas de relleno. *@
@using GestionServicios.Web.ViewModels.Budgets
@model BudgetPrintModel
@* Firma: FRANCO LARA - 03/11/2026 | Formato nuevo de once columnas con referencias SAP y moneda real. *@
@* Firma: FRANCO LARA - 06/11/2026 | Plantilla del PDF HYT: cabecera compacta, detalle rojo, subtotal amarillo, firma, subtítulo centrado y posición desde código interno. Fecha 40 % menor, espacio para número completo y sin descripción del trabajo. Tienda 25 % menor y espacio transferido a Centro SAP FICO. *@
@{ var lines=Model.Record.Data.GetProperty("Partidas").EnumerateArray().ToArray();var notes=Model.Text("Consideraciones"); }
<main class="report-document new-document">
<header class="new-brand"><img src="@Model.Logo" alt="HYT Servicios Generales" /><div><h1>@Model.CompanyText("RazonSocial")</h1><strong>RUC @Model.CompanyText("Ruc")</strong></div></header>
<p class="new-services">@Model.Subtitle</p>
<table class="new-client"><colgroup><col style="width:13%"/><col style="width:64.5%"/><col style="width:13.2%"/><col style="width:9.3%"/></colgroup><tbody><tr><th>CLIENTE</th><td>@Model.Text("ClienteNombre")</td><th>PPTO N°</th><th>FECHA</th></tr><tr><th>DIRECCION</th><td>@Model.Text("ClienteDireccion")</td><td>@Model.Record.Text("NumeroInterno")</td><td>@BudgetPrintModel.Date(Model.Text("FechaEmision"))</td></tr></tbody></table>
<table class="new-zone"><tbody><tr><th>TRIMESTRE</th><td>@Model.Text("Trimestre")</td></tr><tr><th>Seleccionar zonas</th><td>Precios válidos</td></tr><tr><th class="new-zone-name">@Model.Text("ZonaTexto")</th><td>@Model.Text("VigenciaTexto")</td></tr></tbody></table>
<table class="new-supplier"><tbody><tr><th>NOMBRE:</th><td>@Model.CompanyText("RazonSocial")</td></tr><tr><th>CODIGO SAP</th><td>@Model.Text("CodigoSAPProveedor")</td></tr><tr><th>CONTRATO MARCO</th><td>@Model.Text("ContratoMarco")</td></tr><tr><th>ESPECIALIDAD</th><td>@Model.Text("Especialidad")</td></tr><tr><th>N° COTIZACION</th><td>@Model.Record.Text("NumeroInterno")</td></tr><tr><th>FECHA DE EJECUCION</th><td>@(string.IsNullOrWhiteSpace(Model.Text("FechaEjecucion"))?"":BudgetPrintModel.Date(Model.Text("FechaEjecucion")))</td></tr></tbody></table>
<table class="report-detail report-new-table"><colgroup><col style="width:9.75%"/><col style="width:10.25%"/><col style="width:7.5%"/><col style="width:6.5%"/><col style="width:6%"/><col style="width:8%"/><col style="width:24%"/><col style="width:5%"/><col style="width:7%"/><col style="width:7%"/><col style="width:9%"/></colgroup><thead><tr><th>TIENDA</th><th>CENTRO SAP FICO</th><th>N° NECESIDAD</th><th>TIPO DE SERVICIO</th><th>POSICION</th><th>CODIGO MATERIAL SAP</th><th>DESCRIPCION</th><th>UNIDAD</th><th>CANT</th><th>PRECIO (@Model.Currency)</th><th>SUBTOTAL</th></tr></thead>
@foreach(var group in Model.Groups){<tbody><tr class="new-group"><td colspan="10">@group.Name</td><td class="report-number">@Model.Symbol @BudgetPrintModel.Money(Model.GroupAmount(group))</td></tr>
@foreach(var line in group.Lines){<tr><td>@(string.IsNullOrWhiteSpace(Model.Text("TiendaCodigo"))?Model.Text("TiendaNombre"):Model.Text("TiendaCodigo"))</td><td>@BudgetPrintModel.Value(line,"CentroSAPFICO")</td><td>@BudgetPrintModel.Value(line,"NumeroNecesidad")</td><td>@BudgetPrintModel.Value(line,"TipoServicio")</td><td>@BudgetPrintModel.Value(line,"CodigoInterno")</td><td>@BudgetPrintModel.Value(line,"CodigoMaterialSAP")</td><td class="report-description">@BudgetPrintModel.Value(line,"Descripcion")</td><td>@BudgetPrintModel.Value(line,"Unidad")</td><td class="report-number">@BudgetPrintModel.Money(BudgetPrintModel.Amount(line,"Cantidad"))</td><td class="report-number">@Model.Symbol @BudgetPrintModel.Money(BudgetPrintModel.Amount(line,"PrecioUnitario"))</td><td class="report-number">@Model.Symbol @BudgetPrintModel.Money(Model.LineAmount(line))</td></tr>}
</tbody>}
@if(lines.Length==0){<tbody><tr class="new-group"><td colspan="10"></td><td class="report-number">@Model.Symbol @Model.Total("Subtotal")</td></tr><tr><td colspan="11">El registrado todavía no contiene partidas.</td></tr></tbody>}
</table>
<table class="new-totals" aria-label="Resumen de importes"><tbody><tr><th>SUBTOTAL</th><td>@Model.Symbol @Model.Total("Subtotal")</td></tr><tr><th>IGV @((BudgetPrintModel.Amount(Model.Revision,"TasaIGVAplicada")!.Value*100).ToString("0.##",System.Globalization.CultureInfo.GetCultureInfo("es-PE")))%</th><td>@Model.Symbol @Model.Total("Impuesto")</td></tr><tr><th>TOTAL</th><td>@Model.Symbol @Model.Total("Total")</td></tr></tbody></table>
<section class="new-notes"><h3>Consideraciones:</h3><p class="report-multiline">@notes</p></section>
<section class="new-signature">
@if(!notes.Contains("Sin otro particular",StringComparison.OrdinalIgnoreCase)){<p>Sin otro particular quedamos a su disposición.</p>}
@if(!notes.Contains("Muy atentamente",StringComparison.OrdinalIgnoreCase)){<p>Muy atentamente,</p>}
<strong>@(string.IsNullOrWhiteSpace(Model.Text("Firmante"))?Model.CompanyText("NombreFirmante"):Model.Text("Firmante"))</strong><p class="new-signature-role">@(string.IsNullOrWhiteSpace(Model.Text("CargoFirmante"))?Model.CompanyText("CargoFirmante"):Model.Text("CargoFirmante"))</p>
@if(Model.Signature is not null){<img class="report-signature-image" src="@Model.Signature" alt="Firma autorizada para presupuesto" />}
</section></main>
