@* Firma: FRANCO LARA - 07/11/2026 | Descarga visible solo con el permiso correspondiente. *@
@{ViewData["Wide"]=true;}
@using GestionServicios.Web.ViewModels.Budgets
@model BudgetPrintHistory
@* Firma: FRANCO LARA - 03/11/2026 | Historial de formatos y contenido HTML conservado, veinte por página. *@
@* Firma: FRANCO LARA - 05/11/2026 | Listado al ancho disponible y acciones uniformes; Acciones presentadas como botones HYT. *@
@{ViewData["Title"]="Impresiones del presupuesto";var pages=Model.Data.Total/20+(Model.Data.Total%20==0?0:1);var budgetId=Model.Record.Data.GetProperty("PresupuestoId").GetInt64();var revisionId=Model.Record.Revision.GetProperty("RevisionId").GetInt64();}
<header class="hyt-page-header"><div><h1>Impresiones conservadas</h1><p>@Model.Record.Text("NumeroInterno") · Revisión @GestionServicios.Application.Budgets.BudgetRecord.Text(Model.Record.Revision,"NumeroRevision")</p></div><a class="hyt-button-secondary" asp-controller="Budget" asp-action="Details" asp-route-id="@budgetId" asp-route-revisionId="@revisionId">Volver al presupuesto</a></header>
<section class="hyt-panel"><div class="hyt-table-wrap" tabindex="0"><table class="hyt-table"><thead><tr><th>Registro</th><th>Formato</th><th>Versión del formato</th><th>Generado</th><th>Usuario</th><th>Acciones</th></tr></thead><tbody>
@if(Model.Data.Rows.Count==0){<tr><td colspan="6">Esta revisión todavía no tiene impresiones conservadas.</td></tr>}
@foreach(var entry in Model.Data.Rows){<tr><td>@entry.Id</td><td>@entry.Format</td><td>@entry.TemplateVersion</td><td>@PeruDate.Display(entry.CreatedAt)</td><td>@entry.User</td><td><a class="hyt-button-secondary hyt-action-button" asp-action="Document" asp-route-id="@entry.Id" target="_blank" rel="noopener">Ver HTML</a> @if(User.HasClaim(GestionServicios.Web.Security.AccessService.PermissionClaim,"PRESUPUESTOS.DESCARGAR")) { <a class="hyt-button-secondary hyt-action-button" asp-action="Document" asp-route-id="@entry.Id" asp-route-download="true">Descargar HTML</a> }</td></tr>}
</tbody></table></div><footer class="hyt-pagination"><span>@Model.Data.Total registros · Página @(pages==0?0:Model.Data.Page) de @pages · 20 por página</span><nav>@if(Model.Data.Page>1){<a class="hyt-button-secondary hyt-action-button" asp-action="Index" asp-route-budgetId="@budgetId" asp-route-revisionId="@revisionId" asp-route-page="@(Model.Data.Page-1)">Anterior</a>}@if(Model.Data.Page<pages){<a class="hyt-button-secondary hyt-action-button" asp-action="Index" asp-route-budgetId="@budgetId" asp-route-revisionId="@revisionId" asp-route-page="@(Model.Data.Page+1)">Siguiente</a>}</nav></footer></section>
