@model GestionServicios.Web.ViewModels.Maintenance.MaintenanceFormModel
@* Firma: FRANCO LARA - 03/11/2026 | Ficha MVC, referencias por popup, zonas múltiples e historial paginado. *@
@* Firma: FRANCO LARA - 05/11/2026 | Campos reutilizados y tarifas administradas desde la ficha, conservando cambios del material y lista de enlaces por cliente. Combos dependientes de ubigeo para direcciones. *@
<partial name="_FormContent" model="Model" />
@if(Model.MaterialTariffs is not null){<section id="material-tariffs" data-material-tariffs="@Model.MaterialTariffs.MaterialId"><div data-material-price-list><partial name="_MaterialTariffs" model="Model.MaterialTariffs" /></div><p data-material-price-status role="status"></p></section><dialog id="material-price-dialog" class="hyt-modal hyt-material-price-dialog" aria-labelledby="material-price-title"><header class="hyt-modal-header"><h2 id="material-price-title">Agregar tarifario</h2><button type="button" data-material-price-close class="hyt-modal-close" aria-label="Cerrar tarifas">×</button></header><iframe title="Tarifario del material" data-material-price-frame></iframe></dialog>}
@if(Model.Entity.Key=="materiales"&&!Model.Input.Id.HasValue){<p>Guarda el material para agregar o actualizar su tarifario desde esta misma ficha.</p>}
@section Scripts { <script src="~/hyt-ubigeo.js" asp-append-version="true" defer></script><script src="~/hyt-client-links.js" asp-append-version="true" defer></script><script type="module" src="~/hyt-maintenance.js" asp-append-version="true"></script><script type="module" src="~/hyt-material-tariffs.js" asp-append-version="true"></script> }
