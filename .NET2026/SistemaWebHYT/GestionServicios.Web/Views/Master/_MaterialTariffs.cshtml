@* Firma: FRANCO LARA - 06/11/2026 | Botones Ver y Editar con ancho uniforme. *@
@using System.Text.Json
@using System.Globalization
@model GestionServicios.Web.ViewModels.Maintenance.MaterialTariffsModel
@* Firma: FRANCO LARA - 05/11/2026 | Tarifarios del material simplificados: IGV, PEN/USD, estado, fechas y responsables por registro. *@
@{string Text(JsonElement row,string key)=>row.TryGetProperty(key,out var value)&&value.ValueKind!=JsonValueKind.Null?value.ToString():"—";string Money(JsonElement row,string key)=>row.GetProperty(key).ValueKind==JsonValueKind.Null?"Sin precio":row.GetProperty(key).GetDecimal().ToString("N2",CultureInfo.GetCultureInfo("es-PE"));string Date(JsonElement row,string key)=>row.GetProperty(key).ValueKind==JsonValueKind.Null?"Sin actualizaciones":PeruDate.Display(new DateTimeOffset(DateTime.SpecifyKind(row.GetProperty(key).GetDateTime(),DateTimeKind.Utc)));}
<section class="hyt-panel hyt-material-tariffs" data-price-page="@Model.Data.Page"><header class="hyt-page-header"><div><h2>Tarifarios del material</h2><p>@Model.MaterialLabel</p></div></header>
@if(Model.CanEdit){<div class="hyt-grid-actions"><a class="hyt-button-primary" data-material-price-open asp-controller="MaterialTariff" asp-action="New" asp-route-materialId="@Model.MaterialId">Agregar tarifario</a></div>}
<div class="hyt-table-wrap" tabindex="0" role="region" aria-label="Tarifarios del material"><table class="hyt-table"><thead><tr><th>Tipo de IGV</th><th>Precio en soles</th><th>Precio en dólares</th><th>Estado</th><th>Fecha de registro</th><th>Usuario de registro</th><th>Fecha de actualización</th><th>Usuario de actualización</th><th>Acciones</th></tr></thead><tbody>
@foreach(var row in Model.Data.Rows)
{
    var editable=row.TryGetProperty("Editable",out var value)?value.GetBoolean():Text(row,"Estado")=="BORRADOR";
    <tr><td>@(Text(row,"CodigoTipoIGV")=="CON_IGV"?"CON IGV":"SIN IGV")</td><td>S/ @Money(row,"PrecioPEN")</td><td>@Money(row,"PrecioUSD")</td><td>@(row.GetProperty("Activo").GetBoolean()?"Activo":"Inactivo")</td><td>@Date(row,"FechaRegistro")</td><td>@Text(row,"UsuarioRegistro")</td><td>@Date(row,"FechaActualizacion")</td><td>@Text(row,"UsuarioActualizacion")</td><td><div class="hyt-price-row-actions"><a class="hyt-button-secondary hyt-action-button hyt-record-action" data-material-price-open asp-controller="MaterialTariff" asp-action="Details" asp-route-materialId="@Model.MaterialId" asp-route-id="@row.GetProperty("Id").GetInt64()">Ver</a>@if(Model.CanEdit&&editable){<a class="hyt-button-secondary hyt-action-button hyt-record-action" data-material-price-open asp-controller="MaterialTariff" asp-action="Edit" asp-route-materialId="@Model.MaterialId" asp-route-id="@row.GetProperty("Id").GetInt64()">Editar</a>}</div></td></tr>
}
@if(Model.Data.Rows.Count==0){<tr><td colspan="9">Este material todavía no tiene tarifarios.</td></tr>}
</tbody></table></div><footer class="hyt-pagination"><span>@Model.Data.Total registros · Página @Model.Data.Page · 20 por página</span><nav aria-label="Páginas de tarifarios">@if(Model.Data.Page>1){<a class="hyt-button-secondary" data-material-price-page="@(Model.Data.Page-1)" asp-controller="Master" asp-action="MaterialTariffs" asp-route-entity="materiales" asp-route-id="@Model.MaterialId" asp-route-page="@(Model.Data.Page-1)">Anterior</a>}@if((long)Model.Data.Page*20<Model.Data.Total){<a class="hyt-button-secondary" data-material-price-page="@(Model.Data.Page+1)" asp-controller="Master" asp-action="MaterialTariffs" asp-route-entity="materiales" asp-route-id="@Model.MaterialId" asp-route-page="@(Model.Data.Page+1)">Siguiente</a>}</nav></footer></section>
