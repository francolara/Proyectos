@model GestionServicios.Web.ViewModels.Maintenance.MaterialTariffFormModel
@{ViewData["Title"]=Model.ReadOnly?"Ver tarifario":Model.Input.Id.HasValue?"Editar tarifario":"Agregar tarifario";var input=Model.Input;}
@* Firma: FRANCO LARA - 05/11/2026 | Registro unificado de tarifarios con selección de material y trazabilidad propia. *@
<header class="hyt-page-header"><div><h1>@ViewData["Title"]</h1></div><a class="hyt-button-secondary" asp-action="IndexGlobal">Volver al listado</a></header>
<form asp-action="SaveGlobal" method="post" class="hyt-panel hyt-master-form" data-hyt-save>
<input type="hidden" name="Id" value="@input.Id"/><input type="hidden" name="RowVersion" value="@input.RowVersion"/>
<div asp-validation-summary="All" class="hyt-validation" role="alert"></div>
<div class="hyt-field"><label>Material / servicio *</label><div class="hyt-reference" data-reference="MaterialId" data-lookup="materiales"><input name="selectedMaterialId" type="hidden" value="@(Model.MaterialId>0?Model.MaterialId.ToString():"")"/><span data-reference-label>@(Model.MaterialLabel.Length>0?Model.MaterialLabel:"Sin seleccionar")</span>
@if(!Model.ReadOnly&&!input.Id.HasValue){<button type="button" class="hyt-button-secondary" data-open-lookup>Buscar</button><button type="button" class="hyt-button-secondary" data-clear-reference>Limpiar</button>}</div></div>
<fieldset disabled="@Model.ReadOnly" class="hyt-budget-fieldset"><div class="hyt-master-fields">
<div class="hyt-field"><label for="tariff-tax">Tipo de IGV *</label><select id="tariff-tax" name="TaxCode" required><option value="SIN_IGV" selected="@(input.TaxCode=="SIN_IGV")">SIN IGV</option><option value="CON_IGV" selected="@(input.TaxCode=="CON_IGV")">CON IGV</option></select></div>
<div class="hyt-field"><label for="tariff-state">Estado *</label><select id="tariff-state" name="Active"><option value="true" selected="@input.Active">Activo</option><option value="false" selected="@(!input.Active)">Inactivo</option></select></div>
<div class="hyt-field"><label for="tariff-pen">Precio en soles (S/)</label><input id="tariff-pen" name="PricePEN" value="@input.PricePEN" inputmode="decimal" maxlength="16"/><small>Ingresa un precio en soles o dólares. Hasta dos decimales.</small></div>
<div class="hyt-field"><label for="tariff-usd">Precio en dólares ($)</label><input id="tariff-usd" name="PriceUSD" value="@input.PriceUSD" inputmode="decimal" maxlength="16"/><small>Opcional. Hasta dos decimales.</small></div>
</div></fieldset>
<div class="hyt-form-actions">@if(!Model.ReadOnly){<button class="hyt-button-primary" type="submit">Guardar tarifario</button>}<a class="hyt-button-secondary" asp-action="IndexGlobal">Cancelar</a></div></form>
@if(Model.Record is not null){<partial name="_TraceSummary" model="@(TraceSummary.From(Model.Record.Text))"/>}
<dialog id="master-lookup" class="hyt-modal" aria-labelledby="lookup-title"><header class="hyt-modal-header"><h2 id="lookup-title">Seleccionar registro</h2><button type="button" class="hyt-modal-close" data-close-lookup aria-label="Cerrar ayuda">×</button></header><div class="hyt-modal-body"><form data-lookup-search class="hyt-filters"><label>Buscar por código o descripción<input name="search" maxlength="200" type="search" /></label><button class="hyt-button-secondary">Buscar</button></form><p data-lookup-status role="status"></p><div class="hyt-table-wrap"><table class="hyt-table"><thead><tr><th data-lookup-code-heading>Código interno</th><th>Descripción</th><th>Información</th><th>Seleccionar</th></tr></thead><tbody data-lookup-rows></tbody></table></div><footer class="hyt-pagination"><button type="button" data-lookup-prev class="hyt-button-secondary">Anterior</button><span data-lookup-page></span><button type="button" data-lookup-next class="hyt-button-secondary">Siguiente</button></footer></div><footer class="hyt-modal-footer"><button type="button" class="hyt-button-primary" data-close-lookup>Listo</button></footer></dialog>
@section Scripts{<script type="module" src="~/hyt-maintenance.js" asp-append-version="true"></script>}
