@model GestionServicios.Application.Budgets.BudgetPage
@* Firma: FRANCO LARA - 09/11/2026 | Resultados paginados para elegir el presupuesto de un ajuste. *@
<div class="hyt-panel hyt-table-wrap" tabindex="0" role="region" aria-label="Resultados de presupuestos">
    <table class="hyt-table hyt-align-budget-lookup">
        <thead>
            <tr><th scope="col">Presupuesto</th><th scope="col">Descripción</th><th scope="col">Cliente</th><th scope="col">Acciones</th></tr>
        </thead>
        <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="4" class="hyt-grid-message">No se encontraron presupuestos.</td></tr>
            }
            @foreach (var budget in Model.Rows)
            {
                <tr>
                    <td>@budget.Number</td><td>@budget.Description</td><td>@budget.ClientName</td>
                    <td><button type="button" class="hyt-button-secondary" data-plan-budget-number="@budget.Number"
                                aria-label="Seleccionar presupuesto @budget.Number">Seleccionar</button></td>
                </tr>
            }
        </tbody>
    </table>
</div>
<nav class="hyt-pagination" aria-label="Páginas de presupuestos">
    @if (Model.Page > 1)
    {
        <button type="button" class="hyt-button-secondary" data-plan-budget-page="@(Model.Page - 1)">Anterior</button>
    }
    <span>Página @Model.Page</span>
    @if (Model.Total > (long)Model.Page * 20)
    {
        <button type="button" class="hyt-button-secondary" data-plan-budget-page="@(Model.Page + 1)">Siguiente</button>
    }
</nav>
