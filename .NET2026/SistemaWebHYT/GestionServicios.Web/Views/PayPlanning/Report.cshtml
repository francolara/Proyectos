@model GestionServicios.Application.Payroll.PayPlan
@* Firma: FRANCO LARA - 09/11/2026 | Reporte de planilla con el formato corporativo de Presupuestos. Identifica el pago confirmado. *@
@* Firma: FRANCO LARA - 10/11/2026 | Presenta abonos y cargos e identifica la primera o segunda quincena en la planificación impresa. *@
@* Firma: FRANCO LARA - 11/11/2026 | Imprime abonos y cargos debajo del trabajador, con fecha, concepto o descripción e importe. Agrega la tarjeta de planificación, correlativo, cargo y colores de abonos y cargos. *@
@{
    Layout = "_ReportPrintLayout";
    ViewData["Title"] = "Planificación de Planilla";
    ViewData["ReportSubtitle"] = "Reporte de gestión · Planificación de Planilla";
    ViewData["ReportFooter"] = "HYT · Planificación guardada del período indicado. Importes en soles.";
    var label = Model.Frecuencia switch { "SEMANAL" => "Semana de pago", "QUINCENAL" => Model.Desde.Day == 1 ? "Primera quincena" : "Segunda quincena", _ => "Mes de pago" };
    var identityColumns = Model.VerCuenta ? 7 : 4;
}
<section class="hyt-report-pay-card" aria-labelledby="report-pay-plan-heading">
    <h2 id="report-pay-plan-heading">Planificación de Planilla</h2>
    <p>N.º de planificación <strong class="hyt-report-pay-number">@Model.PlanId?.ToString("D6")</strong></p>
    <p><strong>@label</strong> · @Model.Desde.ToString("dd/MM/yyyy") al @Model.Hasta.ToString("dd/MM/yyyy")</p>
    <p><strong class="hyt-report-pay-status">@(Model.FechaPago.HasValue ? "PAGADA" : "PENDIENTE")</strong> ·
        @Model.Filas.Length @(Model.Filas.Length == 1 ? "trabajador incluido" : "trabajadores incluidos")</p>
    @if (Model.FechaPago is DateOnly paid)
    {
        <p><strong>Pagada y cerrada</strong> · @paid.ToString("dd/MM/yyyy") · Operación @Model.ReferenciaPago</p>
    }
</section>
<div class="hyt-report-table-region" tabindex="0" role="region" aria-label="Detalle de la planificación">
    <table class="hyt-report-table hyt-report-pay-plan">
        <thead>
            <tr><th scope="col" class="hyt-report-count hyt-report-pay-item">N.º Ítem</th>
                <th scope="col" class="hyt-report-pay-worker">Trabajador</th><th scope="col">Cargo</th><th scope="col">Tipo</th>
                @if (Model.VerCuenta) { <th scope="col">Banco</th><th scope="col" class="hyt-report-count">N.º de cuenta</th><th scope="col" class="hyt-report-count">CCI</th> }
                <th scope="col" class="hyt-report-money">Sueldo base (S/)</th><th scope="col" class="hyt-report-money">Abonos (S/)</th>
                <th scope="col" class="hyt-report-money">Cargos (S/)</th><th scope="col" class="hyt-report-money">Neto a pagar (S/)</th></tr>
        </thead>
        <tbody>
        @if (Model.Filas.Length == 0)
        {
            <tr><td colspan="@(identityColumns + 4)">Sin trabajadores en el período seleccionado.</td></tr>
        }
        @for (var index = 0; index < Model.Filas.Length; index++)
        {
            var row = Model.Filas[index];
            <tr>
                <td class="hyt-report-count">@(index + 1)</td>
                <th scope="row"><strong>@row.Nombre</strong></th><td>@(row.Cargo ?? "—")</td><td>@(row.Tipo == "PLANILLA" ? "En planilla" : "Externo")</td>
                @if (Model.VerCuenta) { <td>@(row.Banco ?? "—")</td><td class="hyt-report-count">@(row.Cuenta ?? "—")</td><td class="hyt-report-count">@(row.Cci ?? "—")</td> }
                <td class="hyt-report-money">@row.Base.ToString("N2")</td>
                <td class="hyt-report-money hyt-report-pay-credit">@row.ImporteExtra.ToString("N2")</td>
                <td class="hyt-report-money hyt-report-pay-charge">@row.Descuento.ToString("N2")</td>
                <td class="hyt-report-money">@row.Neto.ToString("N2")</td>
            </tr>
            @foreach (var adjustment in row.Ajustes ?? [])
            {
                var charge = adjustment.Tipo == "DESCUENTO";
                <tr class="hyt-report-pay-adjustment">
                    <td></td>
                    <td class="@(charge ? "hyt-report-pay-charge" : "hyt-report-pay-credit")">@(charge ? "Cargo" : "Abono")</td>
                    <td>@(adjustment.Fecha?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td colspan="@(identityColumns - 2)">
                        @(adjustment.Concepto ?? (adjustment.Tipo == "EXTRA" ? "Horas extra" : "—"))
                        @if (!string.IsNullOrWhiteSpace(adjustment.Presupuesto))
                        { <small>Presupuesto @adjustment.Presupuesto</small> }
                    </td>
                    <td class="hyt-report-money hyt-report-pay-credit">@(charge ? "" : adjustment.Importe.ToString("N2"))</td>
                    <td class="hyt-report-money hyt-report-pay-charge">@(charge ? adjustment.Importe.ToString("N2") : "")</td>
                    <td></td>
                </tr>
            }
        }
        </tbody>
        <tfoot><tr><th colspan="@identityColumns">Totales</th>
            <td class="hyt-report-money">@Model.Filas.Sum(row => row.Base).ToString("N2")</td>
            <td class="hyt-report-money">@Model.Filas.Sum(row => row.ImporteExtra).ToString("N2")</td>
            <td class="hyt-report-money">@Model.Filas.Sum(row => row.Descuento).ToString("N2")</td>
            <td class="hyt-report-money">@Model.Filas.Sum(row => row.Neto).ToString("N2")</td></tr></tfoot>
    </table>
</div>
