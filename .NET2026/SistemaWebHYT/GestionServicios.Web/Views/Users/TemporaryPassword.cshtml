@using GestionServicios.Web.ViewModels.Security
@model TemporaryPasswordModel
@{ ViewData["Title"] = "Contraseña temporal guardada"; }
<header class="hyt-page-header"><div><h1>Contraseña temporal guardada</h1><p>@Model.Email</p></div></header>
<section class="hyt-panel hyt-master-form">
    <p>Comparte estos datos con el usuario. Deberá cambiar la contraseña en su siguiente ingreso.</p>
    <div class="hyt-field" data-security-password>
        <label for="temporary-password">Contraseña temporal</label>
        <div class="hyt-password-control">
            <input id="temporary-password" type="password" value="@Model.Password" readonly autocomplete="off" />
            <partial name="_PasswordToggle" model="@("temporary-password")" />
        </div>
        <div class="hyt-master-related"><button class="hyt-button-secondary" type="button" data-security-copy>Copiar</button><span role="status"></span></div>
    </div>
    <a class="hyt-button-primary" asp-action="Index">Volver al listado</a>
</section>
@section Scripts { <script src="~/hyt-security.js" asp-append-version="true" defer></script> }
