@* Firma: FRANCO LARA - 07/11/2026 | Administración de acceso y trazabilidad HYT, con icono de visibilidad de contraseña temporal. *@
@model string
<div class="hyt-field" data-security-password>
    <label for="temporary-password">Contraseña temporal</label>
    <div class="hyt-password-control">
        <input id="temporary-password" name="TemporaryPassword" type="password" value="@Model" required minlength="12" maxlength="128" autocomplete="new-password" />
        <partial name="_PasswordToggle" model="@("temporary-password")" />
    </div>
    <small>Usa al menos 12 caracteres. El usuario deberá cambiarla al ingresar.</small>
    <div class="hyt-master-related"><button class="hyt-button-secondary" type="button" data-security-copy>Copiar</button><span role="status"></span></div>
</div>
