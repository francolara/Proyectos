@using GestionServicios.Web.ViewModels.Budgets
@model BudgetLineModel
@* Firma: FRANCO LARA - 03/11/2026 | Partida de presupuesto con códigos, precio y precisión de dos decimales. *@
@* Firma: FRANCO LARA - 05/11/2026 | Detalle con material, tarifa del material, necesidad, ayuda de servicio, unidad, cantidad y precio neto editable. *@
@* Firma: FRANCO LARA - 06/11/2026 | Ayudas compactas con lupa, necesidad reducida y eliminación con icono. Servicio por nombre, SAP visible y anchos reducidos de unidad/cantidad/precio. *@
@{var line=Model.Line;var prefix="Draft.Partidas["+Model.Index+"].";var element="budget-line-"+Model.Index+"-";}
<tr data-budget-line>
<td class="hyt-col-item"><span data-line-number></span>
@foreach(var hidden in new (string,string?)[]{("PartidaId",line.PartidaId?.ToString()),("PartidaTarifarioId",line.PartidaTarifarioId?.ToString()),("MaterialId",line.MaterialId?.ToString()),("Grupo",line.Grupo),("Posicion",line.Posicion),("CodigoInterno",line.CodigoInterno),("CentroSAPFICO",line.CentroSAPFICO),("ZonasTexto",line.ZonasTexto),("OrigenPrecio","MANUAL"),("CodigoMonedaOrigen",line.CodigoMonedaOrigen),("CodigoTipoIGVOrigen","SIN_IGV"),("MotivoPrecioManual","Precio neto del detalle del presupuesto")}){<input type="hidden" name="@(prefix+hidden.Item1)" value="@hidden.Item2"/>}
</td>
<td class="hyt-budget-description hyt-col-material"><div class="hyt-detail-reference"><button type="button" class="hyt-button-secondary hyt-detail-icon" data-line-material title="Buscar material" aria-label="Buscar material"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button><small data-line-material-code class="hyt-sr-only">@line.CodigoInterno</small><label class="hyt-sr-only" for="@(element+"description")">Descripción del material</label><textarea id="@(element+"description")" name="@(prefix+"Descripcion")" rows="1" maxlength="1500" title="@line.Descripcion">@line.Descripcion</textarea></div></td>
<td class="hyt-col-sap"><label class="hyt-sr-only" for="@(element+"sap")">Código Material SAP</label><input id="@(element+"sap")" name="@(prefix+"CodigoMaterialSAP")" value="@line.CodigoMaterialSAP" title="@line.CodigoMaterialSAP" maxlength="60" readonly/></td>
<td class="hyt-col-tariff"><button type="button" class="hyt-button-secondary hyt-detail-icon" data-replace-tariff title="Buscar tarifa" aria-label="Buscar tarifa"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button><small data-line-tariff-label class="hyt-sr-only">@(line.PartidaTarifarioId.HasValue?"Tarifa seleccionada":"Sin tarifa")</small></td>
<td class="hyt-col-need"><label class="hyt-sr-only" for="@(element+"need")">Número de necesidad</label><input id="@(element+"need")" name="@(prefix+"NumeroNecesidad")" value="@line.NumeroNecesidad" maxlength="60"/></td>
<td class="hyt-col-service"><div class="hyt-detail-reference"><button type="button" class="hyt-button-secondary hyt-detail-icon" data-line-service title="Buscar tipo de servicio" aria-label="Buscar tipo de servicio"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button><label class="hyt-sr-only" for="@(element+"service")">Tipo de servicio</label><input id="@(element+"service")" name="@(prefix+"TipoServicio")" value="@line.TipoServicio" title="@line.TipoServicio" maxlength="150" readonly/></div></td>
<td class="hyt-col-unit"><label class="hyt-sr-only" for="@(element+"unit")">Unidad de medida</label><input id="@(element+"unit")" name="@(prefix+"Unidad")" value="@line.Unidad" maxlength="30" readonly/></td>
<td class="hyt-col-quantity"><label class="hyt-sr-only" for="@(element+"qty")">Cantidad</label><input id="@(element+"qty")" name="@(prefix+"Cantidad")" value="@line.Cantidad" inputmode="decimal" required/></td>
<td class="hyt-col-price"><label class="hyt-sr-only" for="@(element+"price")">Precio sin IGV</label><input id="@(element+"price")" name="@(prefix+"PrecioManual")" value="@line.PrecioManual" inputmode="decimal" data-origin-price/></td>
<td class="hyt-col-subtotal"><span data-line-total>@(Model.Total??"—")</span></td><td class="hyt-col-action"><button type="button" class="hyt-button-secondary hyt-detail-icon" data-remove-line title="Quitar" aria-label="Quitar"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7"/></svg></button></td>
</tr>
