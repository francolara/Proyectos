@model GestionServicios.Web.Controllers.PensionRatesPage
@* Firma: FRANCO LARA - 10/11/2026 | Mantenimiento de porcentajes estimados por entidad previsional. *@
@{
    ViewData["Title"] = "Porcentajes AFP y ONP";
}
<header class="hyt-page-header">
    <div><h1>@ViewData["Title"]</h1><p>Porcentajes para estimar nuevas obligaciones.</p></div>
    <a asp-action="Index" asp-route-month="@Model.Month" class="hyt-button-secondary">Volver a obligaciones</a>
</header>
@if (TempData["ObligationMessage"] is string message) { <p role="status">@message</p> }
@if (TempData["ObligationError"] is string error) { <p role="alert">@error</p> }
<div class="hyt-panel hyt-table-wrap" tabindex="0" role="region" aria-label="Porcentajes previsionales">
    <table class="hyt-table">
        <thead><tr><th scope="col">Entidad</th><th scope="col">Régimen</th><th scope="col" class="hyt-numeric">Porcentaje (%)</th><th scope="col">Acción</th></tr></thead>
        <tbody>
        @for (var index = 0; index < Model.Rates.Count; index++)
        {
            var rate = Model.Rates[index];
            var formId = $"rate-{index}";
            <tr>
                <th scope="row">@rate.Entidad</th><td>@rate.Regimen</td>
                <td class="hyt-numeric"><input form="@formId" name="Rate" inputmode="decimal"
                    class="hyt-numeric" value="@rate.Porcentaje.ToString("0.####")" aria-label="Porcentaje de @rate.Entidad" required /></td>
                <td><form id="@formId" asp-action="SaveRate" asp-route-month="@Model.Month" method="post">
                    <input type="hidden" name="Entity" value="@rate.Entidad" />
                    <button type="submit" class="hyt-button-secondary">Guardar</button>
                </form></td>
            </tr>
        }
        </tbody>
    </table>
</div>
<p>El porcentaje inicial de AFP corresponde al aporte al fondo. Configura el porcentaje de estimación según corresponda.</p>
