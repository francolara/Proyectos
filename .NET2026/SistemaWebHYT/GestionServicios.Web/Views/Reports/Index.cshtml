@* Firma: FRANCO LARA - 07/11/2026 | Acciones visibles según los permisos del perfil. *@
@* Firma: FRANCO LARA - 03/11/2026 | Reporte HTML con totales por moneda. *@
@* Firma: FRANCO LARA - 05/11/2026 | Listado al ancho disponible y acciones HYT. *@
@* Firma: FRANCO LARA - 06/11/2026 | Dos reportes integrales, estados y pendientes con búsqueda única; impresión completa horizontal con filtros. *@
@using GestionServicios.Application.Reporting
@using GestionServicios.Web.ViewModels.Reporting
@using GestionServicios.Web.Security
@using GestionServicios.Web.ViewModels.Budgets
@model ReportModel
@{ViewData["Wide"]=true;ViewData["Title"]="Reportes";var f=Model.Filters??new ReportFilter();var budget=Model.Kind=="PRESUPUESTO";var query=ReportDisplay.Query(Model);}
<link rel="stylesheet" href="~/hyt-reports.css" asp-append-version="true" />
<div class="hyt-report">
<header class="hyt-page-header"><div><h1>Reportes</h1><p>Consulta el expediente completo y sus documentos relacionados.</p></div>@if (User.HasClaim(GestionServicios.Web.Security.AccessService.PermissionClaim, "REPORTES.IMPRIMIR")) { <a class="hyt-button-primary" href="@("/Reportes/Imprimir?"+ReportDisplay.QueryString(Model))" target="_blank" rel="noopener">Imprimir reporte completo</a> }</header>
<form action="/Reportes" method="get" class="hyt-filters" data-report-filters>
<div class="hyt-field"><label for="report-kind">Reporte</label><select id="report-kind" name="kind">@foreach(var option in ReportKinds.All){if(User.HasClaim(AccessService.PermissionClaim,option.Key=="PRESUPUESTO"?"PRESUPUESTOS.CONSULTAR":"OC_CLIENTE.CONSULTAR")){<option value="@option.Key" selected="@(option.Key==Model.Kind)">@option.Value</option>}}</select></div>
<div class="hyt-field"><label for="report-search">Buscar</label><input id="report-search" name="search" value="@f.Search" maxlength="200" placeholder="Número, cliente, tienda o referencia" /></div>
<partial name="_DatePicker" model="@(new DatePickerModel("from","Desde",Model.From))" /><partial name="_DatePicker" model="@(new DatePickerModel("to","Hasta",Model.To))" />
<div class="hyt-field"><label for="report-state">Estado de @(budget?"presupuesto":"OC cliente")</label><select id="report-state" name="state"><option value="">Todos</option>@foreach(var option in ReportDisplay.States(Model.Kind)){<option value="@option.Key" selected="@(option.Key==f.State)">@option.Value</option>}</select></div>
<div class="hyt-field"><label for="report-type">Tipo de atención</label><select id="report-type" name="type"><option value="">Todos</option><option value="INVITACION" selected="@(f.Type=="INVITACION")">Invitación</option><option value="EMERGENCIA" selected="@(f.Type=="EMERGENCIA")">Emergencia</option></select></div>
<div class="hyt-filter-checks">
@if(User.HasClaim(AccessService.PermissionClaim,"GUIAS.CONSULTAR")){<label><input type="checkbox" name="pendingGuide" value="true" checked="@f.PendingGuide" />Pendiente de guía</label>}
@if(budget&&User.HasClaim(AccessService.PermissionClaim,"OC_CLIENTE.CONSULTAR")){<label><input type="checkbox" name="pendingOrder" value="true" checked="@f.PendingOrder" />Pendiente de OC del cliente</label>}
@if(!budget&&User.HasClaim(AccessService.PermissionClaim,"CONFIRMACIONES.CONSULTAR")){<label><input type="checkbox" name="pendingConfirmation" value="true" checked="@f.PendingConfirmation" />Pendiente de confirmación del cliente</label>}
@if(!budget&&User.HasClaim(AccessService.PermissionClaim,"FACTURADO.CONSULTAR")){<label><input type="checkbox" name="pendingInvoice" value="true" checked="@f.PendingInvoice" />Pendiente de facturar</label>}
</div><div class="hyt-filters-actions"><button type="submit" class="hyt-button-primary">Consultar</button><a class="hyt-button-secondary" href="/Reportes?kind=@Model.Kind">Restablecer</a></div>
</form>
<partial name="_Results" model="Model" />
<nav class="hyt-pagination" aria-label="Páginas del reporte"><span>@Model.Data.Total registros · Página @Model.Data.Page · 20 por página</span><div>@if(Model.Data.Page>1){<a class="hyt-button-secondary" href="@("/Reportes?"+ReportDisplay.QueryString(Model,Model.Data.Page-1))">Anterior</a>}@if((long)Model.Data.Page*20<Model.Data.Total){<a class="hyt-button-secondary" href="@("/Reportes?"+ReportDisplay.QueryString(Model,Model.Data.Page+1))">Siguiente</a>}</div></nav>
</div>
@section Scripts{<script src="~/hyt-reports.js" asp-append-version="true" defer></script>}
