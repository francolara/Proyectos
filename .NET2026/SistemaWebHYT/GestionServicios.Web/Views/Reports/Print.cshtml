@* Firma: FRANCO LARA - 06/11/2026 | HTML autónomo horizontal de todos los resultados, logo HYT y filtros aplicados. *@
@using GestionServicios.Web.ViewModels.Reporting
@using GestionServicios.Application.Reporting
@model ReportModel
@* Firma: FRANCO LARA - 09/11/2026 | Reutiliza la plantilla corporativa de impresión. *@
@{
    Layout = "_ReportPrintLayout";
    var title = ReportKinds.All[Model.Kind];
    ViewData["Title"] = title;
    ViewData["ReportSubtitle"] = $"Reporte de gestión · {title}";
    ViewData["ReportFooter"] = "HYT · Todos los resultados de los filtros indicados. Importes separados por moneda.";
}
<partial name="_Results" model="Model" />
