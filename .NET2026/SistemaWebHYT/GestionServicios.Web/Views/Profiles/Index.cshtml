@using GestionServicios.Web.Security
@using GestionServicios.Web.ViewModels.Security
@model ProfileListModel
@{
    ViewData["Title"] = "Perfiles de acceso";
    ViewData["Wide"] = true;
    var canEdit = User.HasClaim(AccessService.PermissionClaim, "PERFILES.EDITAR");
}
<header class="hyt-page-header"><div><h1>Perfiles de acceso</h1><p>Define qué puede consultar o hacer cada grupo de usuarios.</p></div>
@if (canEdit) { <a class="hyt-button-primary" asp-action="New">Nuevo perfil</a> }</header>
<partial name="_SecurityNav" />
<form class="hyt-filters" method="get" asp-action="Index">
    <div class="hyt-field"><label for="search">Buscar por nombre</label><input type="search" id="search" name="search" maxlength="200" value="@Model.Search" /></div>
    <button class="hyt-button-primary" type="submit">Consultar</button><a class="hyt-button-secondary" asp-action="Index">Restablecer</a>
</form>
<div class="hyt-table-wrap" tabindex="0" role="region" aria-label="Perfiles de acceso">
    <table class="hyt-table"><thead><tr><th>Perfil</th><th>Usuarios asignados</th><th>Última actualización</th><th class="hyt-actions-column">Acciones</th></tr></thead><tbody>
    @if (Model.Data.Rows.Count == 0) { <tr><td colspan="4">No se encontraron perfiles.</td></tr> }
    @foreach (var row in Model.Data.Rows)
    {
        var id = row.Text("Id");
        <tr><td>@row.Text("Name")</td><td>@row.Text("Usuarios")</td><td>@row.Date("FechaActualizacion", "Sin actualizaciones")</td>
        <td class="hyt-actions-column"><div class="hyt-grid-actions">
            <a class="hyt-button-secondary" asp-action="Detail" asp-route-id="@id">Ver</a>
            @if (canEdit) {
                <a class="hyt-button-secondary" asp-action="Edit" asp-route-id="@id">Editar</a>
                <a class="hyt-button-secondary" asp-action="Duplicate" asp-route-id="@id">Duplicar</a>
            }
        </div></td></tr>
    }
    </tbody></table>
    <partial name="_SecurityPagination" model="Model.Data" />
</div>
